<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Livo Admin' %> | Livo Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&amp;family=Poppins:wght@500;600&amp;display=swap');
        
        :root {
            --primary: #3b82f6;
        }
        
        body {
            font-family: 'Inter', system_ui, sans-serif;
        }
        
        .font-display {
            font-family: 'Poppins', 'Inter', sans-serif;
        }

        .admin-sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link {
            transition: all 0.2s ease;
        }
        
        .nav-link:hover {
            background-color: #f1e7ff;
            color: #3b82f6;
        }
        
        .nav-link.active {
            background-color: #3b82f6;
            color: white;
            box-shadow: 0 10px 15px -3px rgb(59 130 246 / 0.3);
        }

        .stat-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }

        .modern-table {
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05);
        }

        .section-header {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.025em;
        }

        .glass {
            background: rgba(255,255,255, 0.95);
            backdrop-filter: blur(20px);
        }

        .modal {
            animation: modalPop 0.2s ease forwards;
        }

        @keyframes modalPop {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .sidebar-item {
            border-radius: 12px;
            margin: 2px 8px;
        }

        .data-table th {
            background: #f8fafc;
            font-weight: 600;
            color: #475569;
        }

        .badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-slate-50">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <div class="w-72 bg-white border-r border-slate-200 flex flex-col admin-sidebar" id="sidebar">
            <!-- Logo -->
            <div class="px-6 py-6 border-b border-slate-100">
                <div class="flex items-center gap-x-3">
                    <div class="w-11 h-11 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg">
                        <i class="fa-solid fa-chart-line text-white text-3xl"></i>
                    </div>
                    <div>
                        <span class="font-display text-3xl font-bold tracking-tighter text-slate-900">Livo</span>
                        <span class="font-display text-3xl font-bold tracking-tighter bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Admin</span>
                    </div>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 px-3 py-6 overflow-y-auto">
                <div class="px-3 mb-2 text-xs font-semibold tracking-widest text-slate-400">MAIN</div>
                
                <a href="/admin/dashboard" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'dashboard' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-home w-5"></i>
                    <span class="font-medium">Dashboard</span>
                </a>
                
                <a href="/admin/users" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'users' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-users w-5"></i>
                    <span class="font-medium">User Management</span>
                </a>
                
                <a href="/admin/bets" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'bets' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-ticket w-5"></i>
                    <span class="font-medium">Bets Management</span>
                </a>
                
                <a href="/admin/deposits" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'deposits' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-arrow-down w-5"></i>
                    <span class="font-medium">Deposits</span>
                </a>
                
                <a href="/admin/withdrawals" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'withdrawals' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-arrow-up w-5"></i>
                    <span class="font-medium">Withdrawals</span>
                </a>
                
                <a href="/admin/support" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'support' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-headset w-5"></i>
                    <span class="font-medium">Support Tickets</span>
                </a>
                
                <a href="/admin/transactions" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'transactions' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-exchange-alt w-5"></i>
                    <span class="font-medium">Transactions</span>
                </a>
                
                <a href="/admin/reports" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'reports' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-chart-bar w-5"></i>
                    <span class="font-medium">Reports &amp; Analytics</span>
                </a>

                <div class="px-3 mt-6 mb-2 text-xs font-semibold tracking-widest text-slate-400">SYSTEM</div>
                
                <a href="/admin/settings" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-slate-700 hover:bg-slate-100 <%= currentPage === 'settings' ? 'active bg-blue-600 text-white' : '' %>">
                    <i class="fa-solid fa-cog w-5"></i>
                    <span class="font-medium">Settings</span>
                </a>
            </div>

            <!-- Admin Profile -->
            <div class="p-4 border-t border-slate-100 bg-slate-50">
                <div class="flex items-center gap-x-3">
                    <img src="https://i.pravatar.cc/36?img=28" class="w-9 h-9 rounded-full ring-2 ring-white" alt="Admin">
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-sm text-slate-800">Admin User</p>
                        <p class="text-xs text-slate-500">Super Admin</p>
                    </div>
                    <button onclick="logout()" class="text-slate-400 hover:text-red-500 p-2">
                        <i class="fa-solid fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Navbar -->
            <div class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shadow-sm">
                <div class="flex items-center gap-x-4">
                    <!-- Mobile Menu -->
                    <button onclick="toggleSidebar()" class="lg:hidden text-slate-500 hover:text-slate-700 p-2">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    
                    <div>
                        <h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900"><%= title || 'Dashboard' %></h1>
                        <p class="text-xs text-slate-500 -mt-0.5">Livo Betting Platform • Admin Panel</p>
                    </div>
                </div>

                <div class="flex items-center gap-x-4">
                    <!-- Search -->
                    <div class="hidden md:flex items-center bg-slate-100 rounded-3xl px-4 py-2 w-72">
                        <i class="fa-solid fa-search text-slate-400 mr-3"></i>
                        <input type="text" placeholder="Search users, bets, transactions..." class="bg-transparent border-none outline-none text-sm flex-1 placeholder:text-slate-400">
                    </div>

                    <!-- Notifications -->
                    <div class="relative">
                        <button class="p-2.5 hover:bg-slate-100 rounded-2xl text-slate-600 hover:text-slate-900 transition-colors">
                            <i class="fa-solid fa-bell text-xl"></i>
                        </button>
                        <span class="absolute top-1 right-1.5 w-5 h-5 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full">12</span>
                    </div>

                    <!-- Admin Profile -->
                    <div class="flex items-center gap-x-2 pl-3 border-l border-slate-200">
                        <div class="text-right hidden md:block">
                            <p class="text-sm font-semibold">Admin</p>
                            <p class="text-[10px] text-emerald-600 font-medium">Online</p>
                        </div>
                        <img src="https://i.pravatar.cc/36?img=28" class="w-9 h-9 rounded-2xl ring-2 ring-offset-2 ring-blue-100" alt="Admin Avatar">
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="flex-1 overflow-auto p-6 bg-slate-50">
                <%- body %>
            </div>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('hidden');
            sidebar.classList.toggle('lg:block');
        }
        
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                window.location.href = '/admin/logout';
            }
        }
        
        // Tailwind script
        function initializeTailwind() {
            document.documentElement.style.setProperty('--accent', '#3b82f6');
        }
        
        window.onload = function() {
            initializeTailwind();
        }
        
        // Keyboard shortcut for search focus
        document.addEventListener('keydown', function(e) {
            if (e.key === '/' && document.activeElement.tagName === 'BODY') {
                e.preventDefault();
                const searchInput = document.querySelector('input[placeholder*="Search"]');
                if (searchInput) searchInput.focus();
            }
        });
    </script>
</body>
</html>
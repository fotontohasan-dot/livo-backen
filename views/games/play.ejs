<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<style>
    body { background:#0a0a0a; color:#fff; margin-bottom:70px; }
    .game-container { padding:15px; max-width:800px; margin:0 auto; }
    .game-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; background:#141414; padding:12px 15px; border-radius:12px; border:1px solid rgba(230,0,0,0.2); }
    .game-title { font-size:18px; font-weight:800; color:#ffd700; }
    .balance-box { background:rgba(0,0,0,0.5); padding:5px 15px; border-radius:20px; font-weight:700; color:#ffd700; display:flex; align-items:center; gap:5px; border:1px solid rgba(255,215,0,0.3); }
    .game-canvas-area { width:100%; aspect-ratio:16/9; background:#000; border-radius:12px; position:relative; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; border:2px solid rgba(230,0,0,0.4); box-shadow:0 0 20px rgba(230,0,0,0.15); }
    .bet-controls { margin-top:15px; background:#141414; padding:15px; border-radius:12px; display:flex; flex-direction:column; gap:12px; border:1px solid rgba(255,255,255,0.07); }
    .bet-input-group { display:flex; gap:10px; align-items:center; }
    .bet-input-group label { white-space:nowrap; font-size:14px; color:#888; }
    .bet-input-group input { flex:1; background:#1e1e1e; border:1px solid #333; color:white; padding:10px; border-radius:8px; outline:none; font-size:15px; }
    .bet-btn { background:linear-gradient(90deg,#e60000,#ff1a1a); color:white; border:none; padding:13px; border-radius:8px; font-weight:700; cursor:pointer; font-size:15px; transition:.2s; }
    .bet-btn:disabled { opacity:0.5; cursor:not-allowed; }
    .quick-bet { display:flex; gap:8px; }
    .quick-btn { padding:6px 12px; background:#1e1e1e; border:1px solid #333; color:#888; border-radius:6px; cursor:pointer; font-size:12px; }
    .quick-btn:hover { border-color:#e60000; color:#e60000; }
</style>

<div class="game-container">
    <div class="game-header">
        <div class="game-title">🎮 <%= gameDisplayName %></div>
        <div class="balance-box">🪙 <span id="userBalance"><%= coins %></span></div>
    </div>

    <div id="gameCanvas" class="game-canvas-area">
        <div id="gameUI">
            <div style="text-align:center;padding:40px;">
                <div style="font-size:40px;">🎮</div>
                <p style="color:#888;margin-top:10px;">গেম লোড হচ্ছে...</p>
            </div>
        </div>
    </div>

    <div class="bet-controls">
        <div class="quick-bet">
            <button class="quick-btn" onclick="setBet(10)">১০</button>
            <button class="quick-btn" onclick="setBet(50)">৫০</button>
            <button class="quick-btn" onclick="setBet(100)">১০০</button>
            <button class="quick-btn" onclick="setBet(500)">৫০০</button>
            <button class="quick-btn" onclick="setBet(1000)">১০০০</button>
        </div>
        <div class="bet-input-group">
            <label>বাজি:</label>
            <input type="number" id="betAmount" value="10" min="10" step="10">
        </div>
        <button id="mainGameBtn" class="bet-btn">খেলুন</button>
    </div>
</div>

<%- include('../partials/bottom-nav', { activePage: 'home' }) %>

<script>
    const gameSlug = '<%= gameSlug %>';
    let currentBalance = <%= coins %>;

    function setBet(amount) { document.getElementById('betAmount').value = amount; }

    async function placeBet(amount, selection=null) {
        try {
            const response = await fetch('/games/play', {
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({ gameSlug, amount, selection })
            });
            const data = await response.json();
            if (data.success) { updateBalance(data.newBalance); return data; }
            else { alert(data.message); return false; }
        } catch(err) { console.error('Play error:',err); return false; }
    }

    async function recordWin(multiplier) {
        try {
            const response = await fetch('/games/cashout', {
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({ gameSlug, multiplier })
            });
            const data = await response.json();
            if (data.success) { updateBalance(data.newBalance); return data; }
            else { alert(data.message); return false; }
        } catch(err) { console.error('Win error:',err); return false; }
    }

    function updateBalance(newBalance) {
        currentBalance = newBalance;
        document.getElementById('userBalance').innerText = newBalance;
    }
</script>


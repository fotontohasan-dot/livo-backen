<script>
document.getElementById('gameUI').innerHTML = `
  <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#0a0a0a,#001a0a);">
    <div style="position:relative;width:200px;height:200px;">
      <canvas id="spinCanvas" width="200" height="200"></canvas>
      <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);font-size:24px;color:#e60000;">▼</div>
    </div>
    <div id="spinStatus" style="font-size:16px;color:#ffd700;font-weight:700;">স্পিন করুন!</div>
  </div>
`;
const prizes=[{label:'2x',multiplier:2,color:'#e60000'},{label:'LOSE',multiplier:0,color:'#1e1e1e'},{label:'3x',multiplier:3,color:'#7c3aed'},{label:'LOSE',multiplier:0,color:'#1e1e1e'},{label:'5x',multiplier:5,color:'#ffd700'},{label:'LOSE',multiplier:0,color:'#1e1e1e'},{label:'1.5x',multiplier:1.5,color:'#10b981'},{label:'LOSE',multiplier:0,color:'#1e1e1e'}];
const canvas=document.getElementById('spinCanvas');
const ctx=canvas.getContext('2d');
let currentAngle=0;let spinning=false;
function drawWheel(angle){
  const cx=100,cy=100,r=95,sliceAngle=(2*Math.PI)/prizes.length;
  ctx.clearRect(0,0,200,200);
  prizes.forEach((prize,i)=>{
    const start=angle+i*sliceAngle;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,start,start+sliceAngle);ctx.closePath();
    ctx.fillStyle=prize.color;ctx.fill();ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.stroke();
    ctx.save();ctx.translate(cx,cy);ctx.rotate(start+sliceAngle/2);ctx.textAlign='right';ctx.fillStyle='#fff';ctx.font='bold 13px Arial';ctx.fillText(prize.label,r-10,5);ctx.restore();
  });
}
drawWheel(0);
document.getElementById('mainGameBtn').addEventListener('click',async()=>{
  if(spinning)return;
  const amount=parseInt(document.getElementById('betAmount').value);
  if(isNaN(amount)||amount<10){alert('ন্যূনতম বাজি ১০ কয়েন');return;}
  const data=await placeBet(amount,'spin');
  if(!data)return;
  spinning=true;document.getElementById('mainGameBtn').disabled=true;document.getElementById('spinStatus').innerText='স্পিন হচ্ছে...';
  const totalRotation=(5+Math.random()*5)*2*Math.PI;const duration=3000;const start=Date.now();
  function animate(){
    const elapsed=Date.now()-start;const progress=Math.min(elapsed/duration,1);const ease=1-Math.pow(1-progress,3);
    currentAngle=ease*totalRotation;drawWheel(currentAngle);
    if(progress<1){requestAnimationFrame(animate);}
    else{
      if(data.winAmount>0){document.getElementById('spinStatus').innerText=`🎉 জিতেছেন! +${data.winAmount} কয়েন`;document.getElementById('spinStatus').style.color='#10b981';}
      else{document.getElementById('spinStatus').innerText=`😢 হেরেছেন! -${amount} কয়েন`;document.getElementById('spinStatus').style.color='#e60000';}
      spinning=false;
      setTimeout(()=>{document.getElementById('spinStatus').innerText='স্পিন করুন!';document.getElementById('spinStatus').style.color='#ffd700';document.getElementById('mainGameBtn').disabled=false;},2500);
    }
  }
  requestAnimationFrame(animate);
});
</script>

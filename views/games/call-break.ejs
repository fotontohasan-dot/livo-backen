<script>
document.getElementById('gameUI').innerHTML = `
  <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(circle,#1a1a2e,#16213e);padding:15px;">
    <div style="font-size:60px;">♠️</div>
    <div id="g_status" style="color:#ffd700;font-weight:700;font-size:15px;">Call Break - কল দিন ও জিতুন!</div>
    <div id="g_result" style="font-size:30px;font-weight:900;color:#fff;min-height:40px;"></div>
  </div>
`;
(function(){
  document.getElementById('mainGameBtn').innerText = 'কল দিন';
  document.getElementById('mainGameBtn').addEventListener('click',async()=>{
    const amount=parseInt(document.getElementById('betAmount').value);
    if(isNaN(amount)||amount<10){alert('ন্যূনতম বাজি ১০');return;}
    document.getElementById('mainGameBtn').disabled=true;
    document.getElementById('g_result').innerText='🃏';
    document.getElementById('g_status').innerText='তাসের লড়াই চলছে...';
    const data=await placeBet(amount);
    if(!data){document.getElementById('mainGameBtn').disabled=false;return;}
    setTimeout(()=>{
      if(data.winAmount>0){
        document.getElementById('g_status').innerText='🏆 কল সফল! +'+data.winAmount+' কয়েন';
        document.getElementById('g_status').style.color='#10b981';
        document.getElementById('g_result').innerText='Spade Ace';
      } else {
        document.getElementById('g_status').innerText='কল ব্রেক হয়েছে';
        document.getElementById('g_status').style.color='#e60000';
        document.getElementById('g_result').innerText='Broke';
      }
      setTimeout(()=>{
        document.getElementById('g_status').innerText='Call Break - কল দিন ও জিতুন!';
        document.getElementById('g_status').style.color='#ffd700';
        document.getElementById('g_result').innerText='';
        document.getElementById('mainGameBtn').disabled=false;
      },2500);
    },1500);
  });
})();
</script>

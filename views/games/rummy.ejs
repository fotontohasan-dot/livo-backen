<script>
document.getElementById('gameUI').innerHTML = `
  <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(circle,#004020,#001a0a);padding:15px;">
    <div style="font-size:60px;">🃏</div>
    <div id="g_status" style="color:#ffd700;font-weight:700;font-size:15px;">Indian Rummy - মেলান ও জিতুন!</div>
    <div id="g_result" style="font-size:30px;font-weight:900;color:#fff;min-height:40px;"></div>
  </div>
`;
(function(){
  document.getElementById('mainGameBtn').innerText = 'খেলুন';
  document.getElementById('mainGameBtn').addEventListener('click',async()=>{
    const amount=parseInt(document.getElementById('betAmount').value);
    if(isNaN(amount)||amount<10){alert('ন্যূনতম বাজি ১০');return;}
    document.getElementById('mainGameBtn').disabled=true;
    document.getElementById('g_result').innerText='🎴🎴🎴';
    document.getElementById('g_status').innerText='সিকোয়েন্স মেলানো হচ্ছে...';
    const data=await placeBet(amount);
    if(!data){document.getElementById('mainGameBtn').disabled=false;return;}
    setTimeout(()=>{
      if(data.winAmount>0){
        document.getElementById('g_status').innerText='🎊 রানিং সিকোয়েন্স! +'+data.winAmount+' কয়েন';
        document.getElementById('g_status').style.color='#10b981';
        document.getElementById('g_result').innerText='Sequence';
      } else {
        document.getElementById('g_status').innerText='মেলানো সম্ভব হয়নি';
        document.getElementById('g_status').style.color='#e60000';
        document.getElementById('g_result').innerText='No Set';
      }
      setTimeout(()=>{
        document.getElementById('g_status').innerText='Indian Rummy - মেলান ও জিতুন!';
        document.getElementById('g_status').style.color='#ffd700';
        document.getElementById('g_result').innerText='';
        document.getElementById('mainGameBtn').disabled=false;
      },2500);
    },1500);
  });
})();
</script>

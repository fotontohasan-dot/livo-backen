<style nonce="<%= cspNonce %>">
    #rouletteGame {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #064e3b;
    }
    .wheel-container {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 5px solid #ffd700;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .wheel {
        width: 100%;
        height: 100%;
        transition: transform 4s cubic-bezier(0.1, 0, 0.1, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
    .pointer {
        position: absolute;
        top: -10px;
        width: 20px;
        height: 20px;
        background: #ef4444;
        clip-path: polygon(50% 100%, 0 0, 100% 0);
        z-index: 10;
    }
    .betting-board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }
    .bet-option {
        padding: 5px 10px;
        background: #059669;
        border: 1px solid #fff;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
    }
    .bet-option.active {
        background: #ffd700;
        color: #000;
    }
</style>

<script src="/js/games/roulette.js"></script>




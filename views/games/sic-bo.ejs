<script>
document.getElementById('gameUI').innerHTML = `
  <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:linear-gradient(180deg,#0a0a0a,#00001a);padding:15px;">
    <div style="font-size:50px;">🎲</div>
    <div id="g_status" style="color:#ffd700;font-weight:700;font-size:15px;">Sic Bo - বাজি ধরুন!</div>
    <div id="g_result" style="font-size:30px;font-weight:900;color:#fff;min-height:40px;"></div>
    <div id="g_btns"></div>
  </div>
`;
(function(){
  let sel=null;
  const opts = [['A','2x'],['B','2x'],['C','3x']];
  const btnsDiv = document.getElementById('g_btns');
  btnsDiv.style.cssText='display:flex;gap:10px;';
  opts.forEach(([label,mult])=>{
    const btn=document.createElement('button');
    btn.innerText=label+' ('+mult+')';
    btn.style.cssText='padding:10px 18px;background:#1e1e1e;color:#fff;border:2px solid #333;border-radius:8px;cursor:pointer;font-weight:700;';
    btn.onclick=()=>{sel=label;btnsDiv.querySelectorAll('button').forEach(b=>b.style.borderColor='#333');btn.style.borderColor='#ffd700';document.getElementById('g_status').innerText=label+' সিলেক্ট করা হয়েছে';};
    btnsDiv.appendChild(btn);
  });
  document.getElementById('mainGameBtn').addEventListener('click',async()=>{
    if(!sel){alert('একটি অপশন বেছে নিন!');return;}
    const amount=parseInt(document.getElementById('betAmount').value);
    if(isNaN(amount)||amount<10){alert('ন্যূনতম বাজি ১০');return;}
    document.getElementById('mainGameBtn').disabled=true;
    document.getElementById('g_result').innerText='⏳';
    const data=await placeBet(amount,sel);
    if(!data){document.getElementById('mainGameBtn').disabled=false;return;}
    setTimeout(()=>{
      if(data.winAmount>0){document.getElementById('g_status').innerText='🎉 জিতেছেন! +'+data.winAmount+' কয়েন';document.getElementById('g_status').style.color='#10b981';document.getElementById('g_result').innerText='✅';}
      else{document.getElementById('g_status').innerText='😢 হেরেছেন! -'+amount+' কয়েন';document.getElementById('g_status').style.color='#e60000';document.getElementById('g_result').innerText='❌';}
      sel=null;btnsDiv.querySelectorAll('button').forEach(b=>b.style.borderColor='#333');
      setTimeout(()=>{document.getElementById('g_status').innerText='Sic Bo - বাজি ধরুন!';document.getElementById('g_status').style.color='#ffd700';document.getElementById('g_result').innerText='';document.getElementById('mainGameBtn').disabled=false;},2500);
    },1500);
  });
})();
</script>

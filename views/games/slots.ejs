<style>
    #slotsGame {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #000;
    }
    .slot-machine {
        display: flex;
        gap: 10px;
        background: #333;
        padding: 20px;
        border-radius: 15px;
        border: 4px solid #ffd700;
        margin-bottom: 20px;
    }
    .reel {

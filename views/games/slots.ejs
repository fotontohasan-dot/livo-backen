        justify-content: center;
        font-size: 40px;
        color: #000;
        overflow: hidden;
    }
    .spinning {
        animation: spin 0.1s infinite linear;
    }
    @keyframes spin {
        0% { transform: translateY(-10px); }
        100% { transform: translateY(10px); }
    }
    #slotResult {
        font-weight: bold;
        color: var(--accent-color);

<script>
document.getElementById('gameUI').innerHTML = `
  <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(circle,#8B4513,#1a0f0a);padding:15px;">
    <div style="font-size:60px;">はじ</div>
    <div id="g_status" style="color:#ffd700;font-weight:700;font-size:15px;">Fan Tan - ঐতিহ্যবাহী খেলা!</div>
    <div id="g_result" style="font-size:30px;font-weight:900;color:#fff;min-height:40px;"></div>
  </div>
`;
(function(){
  document.getElementById('mainGameBtn').innerText = 'বেট করুন';
  document.getElementById('mainGameBtn').addEventListener('click',async()=>{
    const amount=parseInt(document.getElementById('betAmount').value);
    if(isNaN(amount)||amount<10){alert('ন্যূনতম বাজি ১০');return;}
    document.getElementById('mainGameBtn').disabled=true;
    document.getElementById('g_result').innerText='🐚';
    document.getElementById('g_status').innerText='পুঁতি গণনা করা হচ্ছে...';
    const data=await placeBet(amount);
    if(!data){document.getElementById('mainGameBtn').disabled=false;return;}
    setTimeout(()=>{
      if(data.winAmount>0){
        document.getElementById('g_status').innerText='✅ সঠিক গণনা! +'+data.winAmount+' কয়েন';
        document.getElementById('g_status').style.color='#10b981';
        document.getElementById('g_result').innerText='3 Beads';
      } else {
        document.getElementById('g_status').innerText='ভুল অনুমান';
        document.getElementById('g_status').style.color='#e60000';
        document.getElementById('g_result').innerText='1 Bead';
      }
      setTimeout(()=>{
        document.getElementById('g_status').innerText='Fan Tan - ঐতিহ্যবাহী খেলা!';
        document.getElementById('g_status').style.color='#ffd700';
        document.getElementById('g_result').innerText='';
        document.getElementById('mainGameBtn').disabled=false;
      },2500);
    },1500);
  });
})();
</script>

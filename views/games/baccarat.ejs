<%
// LIVO-04: আগে এই ভিউতে বাজি বাছার কোনো কন্ট্রোলই ছিল না এবং শেয়ার্ড হেল্পারটা
// `placeBet(amount)` — একটাই আর্গুমেন্ট দিয়ে ডাকা হতো, অথচ play.ejs-এর সংজ্ঞা
// `placeBet(amount, selection = null)`। ফলে সার্ভারে সবসময় selection: null যেত,
// `outcome === selection` কখনো সত্য হতো না, আর UI দিয়ে খেলা ব্যাকারাটের RTP ছিল
// ঠিক ০.০০০০ (৪০ রাউন্ডে ০ জয় — মাপা হয়েছে)।
//
// এখন তিনটা বাজি (Player/Banker/Tie) বাছা যায় এবং বাছাইটা সার্ভারে পাঠানো হয়।
// বাছাই শুধুই UX — সার্ভার নিজেই ফলাফল, পেআউট ও ব্যালেন্স নির্ধারণ করে; এই
// স্ক্রিপ্ট কোনো আর্থিক মান পাঠায় না।
%>
<style nonce="<%= cspNonce %>">
    #baccaratGame {
        width: 100%; height: 100%;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        background: #064e3b; padding: 10px; box-sizing: border-box;
    }
    .bc-cards { display: flex; gap: 16px; margin: 10px 0 6px; }
    .bc-seat { display: flex; flex-direction: column; align-items: center; color: #fff; font-size: 12px; }
    .bc-card {
        width: 58px; height: 84px; background: #fff; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 34px; color: #000; margin-bottom: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,.5);
    }
    #bcStatus { color: #ffd700; font-weight: 700; font-size: 14px; text-align: center; }
    #bcResult { color: #fff; font-size: 13px; text-align: center; margin-top: 6px; min-height: 34px; line-height: 1.5; }
    #bcResult.win  { color: #10b981; font-weight: 700; }
    #bcResult.lose { color: #ef4444; font-weight: 700; }
    #bcResult.err  { color: #fbbf24; }

    /* বাজি বাছাই — মোবাইলে সহজে ট্যাপ করার মতো বড় টার্গেট, কোনো horizontal overflow নয় */
    .bc-picker { margin-top: 12px; }
    .bc-picker-label { font-size: 13px; color: #888; margin-bottom: 8px; }
    .bc-options { display: flex; gap: 8px; flex-wrap: wrap; }
    .bc-opt {
        flex: 1 1 0; min-width: 88px; min-height: 46px;
        background: #1e1e1e; border: 2px solid #333; color: #ddd;
        border-radius: 10px; padding: 10px 8px; font-size: 14px; font-weight: 700;
        cursor: pointer; transition: .15s; text-align: center;
    }
    .bc-opt:hover:not(:disabled) { border-color: #ffd700; color: #ffd700; }
    .bc-opt:focus-visible { outline: 3px solid #60a5fa; outline-offset: 2px; }
    .bc-opt[aria-checked="true"] { background: #ffd700; border-color: #ffd700; color: #111; }
    .bc-opt:disabled { opacity: .5; cursor: not-allowed; }
    .bc-odds { display: block; font-size: 11px; font-weight: 500; opacity: .75; margin-top: 2px; }
</style>

<div class="bc-picker">
    <div class="bc-picker-label" id="bcPickerLabel"><%= t('baccarat_choose_bet') %></div>
    <div class="bc-options" role="radiogroup" aria-labelledby="bcPickerLabel">
        <button type="button" class="bc-opt" role="radio" aria-checked="false" data-selection="Player">
            <%= t('baccarat_player') %><span class="bc-odds">1.95x</span>
        </button>
        <button type="button" class="bc-opt" role="radio" aria-checked="false" data-selection="Banker">
            <%= t('baccarat_banker') %><span class="bc-odds">1.95x</span>
        </button>
        <button type="button" class="bc-opt" role="radio" aria-checked="false" data-selection="Tie">
            <%= t('baccarat_tie') %><span class="bc-odds">8x</span>
        </button>
    </div>
</div>

<script type="application/json" id="games-baccaratConfig"><%- jsonScriptSafe({
  chooseFirst: t('baccarat_choose_first'), placing: t('baccarat_placing'),
  dealing: t('baccarat_dealing'), yourBet: t('baccarat_your_bet'),
  result: t('baccarat_result'), win: t('baccarat_win'), loss: t('baccarat_loss'),
  payout: t('baccarat_payout'), deal: t('baccarat_deal'),
  failed: t('baccarat_request_failed'), invalidAmount: t('common_enter_valid_amount'),
  chooseBet: t('baccarat_choose_bet'),
  labels: { Player: t('baccarat_player'), Banker: t('baccarat_banker'), Tie: t('baccarat_tie') }
}) %></script>
<script src="/js/views/games-baccarat.js"></script>

<style>
    #baccaratGame {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #064e3b;
    }
    .cards-box { display: flex; gap: 20px; margin-top: 20px; }
    .player-section { display: flex; flex-direction: column; align-items: center; color: #fff; }
    .card-display {
        width: 80px; height: 120px; background: #fff; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 40px; color: #000; margin-bottom: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
</style>

<script>
(function(){
    document.getElementById('gameUI').innerHTML = `
        <div id="baccaratGame">
            <div id="bcStatus" style="color: #ffd700; font-weight: bold;">বাজি ধরুন!</div>
            <div class="cards-box">
                <div class="player-section">
                    <div id="bcDealerCard" class="card-display">🂠</div>
                    <span>ব্যাংকার</span>
                </div>
                <div class="player-section">
                    <div id="bcPlayerCard" class="card-display">🂠</div>
                    <span>প্লেয়ার</span>
                </div>
            </div>
        </div>
    `;

    const bcStatus = document.getElementById('bcStatus');
    const bcPlayBtn = document.getElementById('mainGameBtn');
    const bcpCard = document.getElementById('bcPlayerCard');
    const bcdCard = document.getElementById('bcDealerCard');

    async function playBC() {
        const amount = parseInt(document.getElementById('betAmount').value);
        if (isNaN(amount) || amount < 1) { alert('সর্বনিম্ন ১ কয়েন বাজি ধরুন'); return; }

        const data = await placeBet(amount);
        if (!data || !data.success) return;

        bcPlayBtn.disabled = true;
        bcStatus.innerText = 'কার্ড ডিল হচ্ছে...';
        bcStatus.style.color = '#ffd700';
        bcpCard.innerText = '🂠';
        bcdCard.innerText = '🂠';

        setTimeout(() => {
            bcpCard.innerText = '🂢';
            bcdCard.innerText = '🂣';

            if (data.winAmount > 0) {
                bcStatus.innerText = `আপনি জিতেছেন! +${data.winAmount}`;
                bcStatus.style.color = '#10b981';
            } else {
                bcStatus.innerText = 'আপনি হেরেছেন!';
                bcStatus.style.color = '#ef4444';
            }
            bcPlayBtn.disabled = false;
        }, 1500);
    }

    bcPlayBtn.innerText = 'ডিল';
    bcPlayBtn.onclick = playBC;
})();
</script>

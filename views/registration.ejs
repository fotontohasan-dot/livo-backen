<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--darker);">
  <div style="width:100%;max-width:420px;padding:1rem;">
    <div class="card">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;">🚀 Create Account</div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <div style="background:#00d4aa10;border:1px solid #00d4aa30;border-radius:8px;padding:.75rem;margin-bottom:1rem;font-size:.85rem;color:var(--primary);">
          🎁 Get 500 welcome coins on registration!
        </div>
        <div class="form-group">
          <label class="form-label">Username</label>
          <input type="text" class="form-input" placeholder="Choose a username" id="username">
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" class="form-input" placeholder="your@email.com" id="remail">
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" class="form-input" placeholder="••••••••" id="rpassword">
        </div>
        <button onclick="submitReg()" class="btn btn-primary" style="width:100%;justify-content:center;">Create Account 🚀</button>
        <p style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.9rem;">
          Already have an account? <a href="/login" style="color:var(--primary)">Login</a>
        </p>
      </div>
    </div>
  </div>
</div>
<script>
function submitReg() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = '/register';
  [['username','username'],['email','remail'],['password','rpassword']].forEach(([n,id]) => {
    const i = document.createElement('input');
    i.name = n; i.value = document.getElementById(id).value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
</script>
</body></html>

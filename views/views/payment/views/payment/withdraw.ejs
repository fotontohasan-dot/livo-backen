<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>উইথড্র - LIVO</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #0f0b1f; color: white; }
        .header { background: linear-gradient(90deg, #6b00ff, #ff00aa); padding: 15px; text-align: center; }
        .logo { font-size: 24px; font-weight: bold; color: #ffd700; }
        .container { max-width: 500px; margin: 30px auto; padding: 20px; }
        .card { background: #1a1433; border-radius: 15px; padding: 25px; }
        .balance-box { background: linear-gradient(135deg, #6b00ff, #ff00aa); border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 20px; }
        .balance-box p { font-size: 13px; opacity: 0.8; }
        .balance-box h3 { font-size: 32px; font-weight: bold; color: #ffd700; }
        h2 { color: #ffd700; margin-bottom: 20px; font-size: 20px; }
        .alert { padding: 12px; border-radius: 8px; margin-bottom: 15px; font-size: 14px; }
        .alert-success { background: #0d4a2a; color: #00ff88; }
        .alert-error { background: #4a0d0d; color: #ff4444; }
        .form-group { margin-bottom: 18px; }
        label { display: block; color: #ffccff; margin-bottom: 8px; font-size: 14px; }
        select, input {
            width: 100%; padding: 12px; border-radius: 8px;
            border: 1px solid #3a2a5a; background: #0f0b1f;
            color: white; font-size: 15px;
        }
        .btn {
            width: 100%; padding: 14px; border-radius: 10px; border: none;
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            color: white; font-size: 16px; font-weight: bold; cursor: pointer;
        }
        .nav-bottom {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: #1a1433; display: flex; justify-content: space-around;
            padding: 12px 0; border-top: 1px solid #3a2a5a;
        }
        .nav-bottom a { color: #aaa; text-decoration: none; text-align: center; font-size: 12px; }
        .nav-bottom a span { display: block; font-size: 20px; }
        .pb { padding-bottom: 80px; }
    </style>
</head>
<body>
<div class="header">
    <div class="logo">💸 উইথড্র</div>
</div>

<div class="container pb">
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success">✅ <%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="alert alert-error">❌ <%= error[0] %></div>
    <% } %>

    <div class="balance-box">
        <p>আপনার বর্তমান ব্যালেন্স</p>
        <h3>🪙 <%= coins %> কয়েন</h3>
    </div>

    <div class="card">
        <h2>💸 টাকা তুলুন</h2>
        <form method="POST" action="/payment/withdraw">
            <div class="form-group">
                <label>পেমেন্ট মেথড</label>
                <select name="method" required>
                    <option value="">-- বেছে নিন --</option>
                    <option value="bkash">📱 bKash</option>
                    <option value="nagad">💸 Nagad</option>
                    <option value="rocket">🚀 Rocket</option>
                    <option value="visa">💳 Visa Card</option>
                    <option value="mastercard">💳 Mastercard</option>
                    <option value="bank">🏦 Bank Transfer</option>
                </select>
            </div>

            <div class="form-group">
                <label>পরিমাণ (কয়েন)</label>
                <input type="number" name="amount" placeholder="সর্বনিম্ন ২০০ কয়েন" min="200" max="<%= coins %>" required>
            </div>

            <div class="form-group">
                <label>আপনার Account নম্বর</label>
                <input type="text" name="account_number" placeholder="যে নম্বরে টাকা পাবেন" required>
            </div>

            <button type="submit" class="btn">💸 উইথড্র রিকোয়েস্ট পাঠান</button>
        </form>
    </div>
</div>

<div class="nav-bottom">
    <a href="/"><span>🏠</span>হোম</a>
    <a href="/payment/deposit"><span>💰</span>ডিপোজিট</a>
    <a href="/payment/withdraw"><span>💸</span>উইথড্র</a>
    <a href="/payment/history"><span>📋</span>ইতিহাস</a>
    <a href="/profile"><span>👤</span>প্রোফাইল</a>
</div>
</body>
</html>

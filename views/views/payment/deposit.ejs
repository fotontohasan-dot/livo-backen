<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ডপোজিট - LIVO</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #0f0b1f; color: white; }
        .header { background: linear-gradient(90deg, #6b00ff, #ff00aa); padding: 15px; text-align: center; }
        .logo { font-size: 24px; font-weight: bold; color: #ffd700; }
        .container { max-width: 500px; margin: 30px auto; padding: 20px; }
        .card { background: #1a1433; border-radius: 15px; padding: 25px; }
        h2 { color: #ffd700; margin-bottom: 20px; font-size: 20px; }
        .alert { padding: 12px; border-radius: 8px; margin-bottom: 15px; font-size: 14px; }
        .alert-success { background: #0d4a2a; color: #00ff88; }
        .alert-error { background: #4a0d0d; color: #ff4444; }
        .form-group { margin-bottom: 18px; }
        label { display: block; color: #ffccff; margin-bottom: 8px; font-size: 14px; }
        select, input { 
            width: 100%; padding: 12px; border-radius: 8px; 
            border: 1px solid #3a2a5a; background: #0f0b1f; 
            color: white; font-size: 15px; 
        }
        .methods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }
        .method-btn {
            padding: 12px; border-radius: 10px; border: 2px solid #3a2a5a;
            background: #0f0b1f; color: white; cursor: pointer; text-align: center; font-size: 13px;
        }
        .method-btn.active { border-color: #6b00ff; background: #1a0050; }
        .method-btn .icon { font-size: 24px; display: block; margin-bottom: 4px; }
        .info-box { background: #0f0b1f; border-radius: 10px; padding: 15px; margin-bottom: 18px; border: 1px solid #3a2a5a; }
        .info-box p { font-size: 13px; color: #aaa; margin-bottom: 5px; }
        .info-box .number { font-size: 18px; color: #ffd700; font-weight: bold; }
        .btn { 
            width: 100%; padding: 14px; border-radius: 10px; border: none;
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            color: white; font-size: 16px; font-weight: bold; cursor: pointer;
        }
        .nav-bottom {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: #1a1433; display: flex; justify-content: space-around;
            padding: 12px 0; border-top: 1px solid #3a2a5a;
        }
        .nav-bottom a { color: #aaa; text-decoration: none; text-align: center; font-size: 12px; }
        .nav-bottom a span { display: block; font-size: 20px; }
        .pb { padding-bottom: 80px; }
    </style>
</head>
<body>
<div class="header">
    <div class="logo">💰 ডিপোজিট</div>
</div>

<div class="container pb">
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success">✅ <%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="alert alert-error">❌ <%= error[0] %></div>
    <% } %>

    <div class="card">
        <h2>💳 টাকা জমা দিন</h2>

        <form method="POST" action="/payment/deposit">
            <div class="form-group">
                <label>পেমেন্ট মেথড বেছে নিন</label>
                <div class="methods">
                    <div class="method-btn active" onclick="selectMethod('bkash', this)">
                        <span class="icon">📱</span>bKash
                    </div>
                    <div class="method-btn" onclick="selectMethod('nagad', this)">
                        <span class="icon">💸</span>Nagad
                    </div>
                    <div class="method-btn" onclick="selectMethod('rocket', this)">
                        <span class="icon">🚀</span>Rocket
                    </div>
                    <div class="method-btn" onclick="selectMethod('visa', this)">
                        <span class="icon">💳</span>Visa
                    </div>
                    <div class="method-btn" onclick="selectMethod('mastercard', this)">
                        <span class="icon">💳</span>Master
                    </div>
                    <div class="method-btn" onclick="selectMethod('bank', this)">
                        <span class="icon">🏦</span>Bank
                    </div>
                </div>
                <input type="hidden" name="method" id="methodInput" value="bkash">
            </div>

            <div class="info-box" id="paymentInfo">
                <p>আমাদের bKash নম্বরে পাঠান:</p>
                <div class="number">01XXXXXXXXX</div>
                <p style="margin-top:8px; color:#ff9900;">⚠️ Send Money করন, Payment নয়</p>
            </div>

            <div class="form-group">
                <label>পরিমাণ (টাকা)</label>
                <input type="number" name="amount" placeholder="সরনিম্ন ১০০ টাকা" min="100" required>
            </div>

            <div class="form-group">
                <label>Transaction ID</label>
                <input type="text" name="transaction_id" placeholder="যেমন: 8N7A6B5C4D" required>
            </div>

            <div class="form-group">
                <label>আপনার নম্বর / Account</label>
                <input type="text" name="account_number" placeholder="য নম্বর থেকে পাঠিয়েছেন" required>
            </div>

            <button type="submit" class="btn">✅ ডিপোজিট রিকোয়েস্ট পাঠান</button>

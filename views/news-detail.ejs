<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz103-1 { width: 100%; max-height: 400px; object-fit: cover; }
  .dz103-2 { display: flex; gap: 1rem; font-size: .8rem; color: var(--muted); margin-bottom: 1.5rem; }
  .dz103-3 { line-height: 1.8; color: var(--text); }
  .dz103-4 { padding: 0; }
  .dz103-5 { padding: 1rem; color: var(--muted); font-size: .9rem; }
  .dz103-6 { display: block; padding: .75rem 1rem; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--text); }
  .dz103-7 { font-size: .75rem; color: var(--muted); margin-top: 3px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im104-1 { font-size: 1.6rem; font-weight: 800; margin-bottom: .75rem; }
  .im104-2 { font-size: .85rem; font-weight: 600; }
</style>

<%- include('partials/navbar') %>
<div class="container page">
  <div class="layout-main">
    <div>
      <div class="card">
        <% if(article.image) { %>
          <img class="dz103-1" src="<%= article.image %>" alt="">
        <% } %>
        <div class="card-body">
          <h1 class="im104-1"><%= article.title %></h1>
          <div class="dz103-2">
            <span>📝 <%= article.author %></span>
            <span>👁️ <%= article.views %> views</span>
            <span>📅 <%= new Date(article.created_at).toLocaleDateString() %></span>
            <span>⚽ <%= article.sport %></span>
          </div>
          <div class="dz103-3">
            <%- escapeHtml(article.content).replace(/\n/g,'<br>') %>
          </div>
        </div>
      </div>
    </div>
    <div>
      <div class="card">
        <div class="card-header">📰 Related News</div>
        <div class="card-body dz103-4">
          <% if(related.length === 0) { %>
            <p class="dz103-5">No related news</p>
          <% } %>
          <% related.forEach(r => { %>
            <a class="dz103-6" href="/news/<%= r.id %>">
              <div class="im104-2"><%= r.title %></div>
              <div class="dz103-7">
                <%= new Date(r.created_at).toLocaleDateString() %>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
</body></html>

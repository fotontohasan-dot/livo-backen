<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Livo</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background: #f4f4f4;
        }
        h2 {
            color: #333;
            text-align: center;
        }
        input, button {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 16px;
            box-sizing: border-box;
        }
        button {
            background: #28a745;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 18px;
        }
        button:hover {
            background: #218838;
        }
    </style>
</head>
<body>
    <h2>🏏 নতুন ম্যাচ যগ করুন</h2>
    <form action="/admin/add-match" method="POST">
        <input type="text" name="teamA" placeholder="টিম A নাম" required>
        <input type="text" name="teamB" placeholder="টিম B নাম" required>
        <input type="number" step="0.01" name="oddsA" placeholder="অডস A" required>
        <input type="number" step="0.01" name="oddsB" placeholder="অডস B" required>
        <button type="submit">✅ ম্যাচ যোগ করুন</button>
    </form>
</body>
</html>

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.help_center_title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style nonce="<%= cspNonce %>">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Nikosh', 'SolaimanLipi', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0A1C14 0%, #006A4E 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .header {
            background: linear-gradient(90deg, #0A1C14 0%, #006A4E 50%, #0A1C14 100%);
            color: white;
            padding: 20px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 28px;
            margin-bottom: 5px;
        }

        .header p {
            font-size: 16px;
            opacity: 0.9;
        }

        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #D4A72C, #D62828);
        }

        .main-content {
            display: flex;
            flex: 1;
            height: 500px;
        }

        .sidebar {
            width: 280px;
            background-color: #008F5A;
            color: white;
            padding: 20px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .logo {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo h2 {
            font-size: 22px;
            margin-top: 10px;
        }

        .category-list {
            list-style: none;
            margin-top: 20px;
        }

        .category-list li {
            margin-bottom: 10px;
        }

        .category-list a {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: white;
            text-decoration: none;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            transition: background-color 0.3s;
        }

        .category-list a:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .category-list i {
            margin-right: 10px;
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .live-agent {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 30px 20px;
            text-align: center;
            color: #333;
            background-color: #f9f9f9;
        }

        .live-agent > i {
            font-size: 42px;
            color: #008F5A;
        }

        .live-agent-button {
            background-color: #008F5A;
            color: white;
            border-radius: 20px;
            padding: 12px 24px;
            font-weight: bold;
            text-decoration: none;
        }

        .live-agent-button:hover {
            background-color: #0A3D2C;
        }

        @media (max-width: 768px) {
            .main-content {
                flex-direction: column;
                height: auto;
            }

            .sidebar {
                width: 100%;
                padding: 15px;
            }

            .category-list {
                display: flex;
                overflow-x: auto;
                gap: 10px;
            }

            .category-list li {
                white-space: nowrap;
                margin-bottom: 0;
            }
        }
    </style>

<!-- ==================== CSRF টোকেন ==================== -->
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
<script src="/js/csrf-inject.js?v=<%= locals.assetVersion || 'dev' %>"></script>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><%= t.help_center_title %></h1>
            <p><%= t.help_center_subtitle %></p>
        </div>

        <div class="main-content">
            <div class="sidebar">
                <div class="logo">
                    <h2><%= t.quick_help %></h2>
                </div>
                <h3><%= t.category %></h3>
                <ul class="category-list">
                    <li><a href="/chat?category=deposit"><i class="fas fa-wallet"></i> <%= t.deposit_issue %></a></li>
                    <li><a href="/chat?category=withdraw"><i class="fas fa-money-bill-wave"></i> <%= t.withdraw_issue %></a></li>
                    <li><a href="/chat"><i class="fas fa-right-to-bracket"></i> <%= t.login_issue %></a></li>
                    <li><a href="/chat"><i class="fas fa-id-card"></i> <%= t.kyc_verification_title %></a></li>
                    <li><a href="/chat"><i class="fas fa-gift"></i> <%= t.bonus_issue %></a></li>
                    <li><a href="/chat"><i class="fas fa-ticket-alt"></i> <%= t.ticket_issue %></a></li>
                    <li><a href="/chat"><i class="fas fa-futbol"></i> <%= t.football_issue %></a></li>
                </ul>
            </div>

            <div class="live-agent">
                <i class="fas fa-headset"></i>
                <p><%= t.contact_live_agent %></p>
                <a href="/chat" class="live-agent-button"><%= t('chat_talk_to_live_agent') %></a>
            </div>
        </div>
    </div>

</body>
</html>

<!DOCTYPE html>
<html lang="bn">
<body>
    <h2>ম্যাচ যোগ করুন</h2>
    <form action="/admin/add-match" method="POST">
        <input type="text" name="teamA" placeholder="টিম A" required><br>
        <input type="text" name="teamB" placeholder="টিম B" required><br>
        <input type="number" step="0.01" name="oddsA" placeholder="অডস A" required><br>
        <input type="number" step="0.01" name="oddsB" placeholder="অডস B" required><br>
        <button type="submit">সেভ করুন</button>
    </form>
</body>
</html>

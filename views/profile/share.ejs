<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">📤 শেয়ার করে বোনাস</h1>
  </div>

  <div style="background:linear-gradient(135deg,#ec4899,#db2777);border-radius:16px;padding:24px;margin-bottom:16px;text-align:center;">
    <div style="font-size:44px;margin-bottom:6px;">📤</div>
    <div style="color:#fff;font-size:16px;font-weight:bold;">শেয়ার করুন, বোনাস নিন</div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:4px;">
      প্রতিদিন শেয়ার করে <strong><%= share ? share.bonus : 20 %> কয়েন</strong> পান
    </div>
  </div>

  <% const shareUrl = baseUrl + (user && user.referral_code ? '/register?ref=' + user.referral_code : '/'); %>

  <!-- শেয়ার বাটন -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px;">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">যেখানে শেয়ার করবেন</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
      <a href="https://wa.me/?text=<%= encodeURIComponent('Livo-তে খেলুন আর জিতুন! ' + shareUrl) %>" target="_blank"
         style="background:#25D366;color:#0B3B1E;text-decoration:none;text-align:center;padding:12px;border-radius:10px;font-weight:bold;font-size:13px;">
        WhatsApp
      </a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>" target="_blank"
         style="background:#1773E9;color:#fff;text-decoration:none;text-align:center;padding:12px;border-radius:10px;font-weight:bold;font-size:13px;">
        Facebook
      </a>
      <a href="https://t.me/share/url?url=<%= encodeURIComponent(shareUrl) %>&text=<%= encodeURIComponent('Livo-তে খেলুন আর জিতুন!') %>" target="_blank"
         style="background:#007DBC;color:#fff;text-decoration:none;text-align:center;padding:12px;border-radius:10px;font-weight:bold;font-size:13px;">
        Telegram
      </a>
      <button data-copy-link
         style="background:#475569;color:#fff;border:none;text-align:center;padding:12px;border-radius:10px;font-weight:bold;font-size:13px;cursor:pointer;">
        লিংক কপি
      </button>
    </div>
    <input type="text" id="shareLink" value="<%= shareUrl %>" readonly
           style="width:100%;background:#1e1e1e;border:1px solid #333;color:#94a3b8;padding:10px;border-radius:8px;margin-top:12px;font-size:12px;">
  </div>

  <!-- বোনাস ক্লেইম -->
  <div style="background:rgba(245,158,11,0.1);border:1px solid var(--gold,#f59e0b);border-radius:16px;padding:20px;text-align:center;">
    <% if (share && share.claimed) { %>
      <div style="color:#10b981;font-size:14px;font-weight:bold;">✅ আজকের শেয়ার বোনাস নেওয়া হয়েছে</div>
      <div style="color:var(--text-muted);font-size:12px;margin-top:4px;">আগামীকাল আবার আসুন</div>
    <% } else { %>
      <div style="color:var(--text-main);font-size:13px;margin-bottom:12px;">উপরে শেয়ার করার পর নিচের বাটনে বোনাস নিন</div>
      <form action="/profile/share/claim" method="POST" style="margin:0;">
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-weight:700;">
          🎁 শেয়ার বোনাস নিন (<%= share ? share.bonus : 20 %> কয়েন)
        </button>
      </form>
    <% } %>
  </div>

  <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
    আপনার রেফারেল লিংক শেয়ার করুন — বন্ধু জয়েন করলে রেফারেল বোনাসও পাবেন!
  </p>

</div>

<script src="/js/views/profile-share.js"></script>
<%- include('../partials/bottom-nav') %>
</body></html>

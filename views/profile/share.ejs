<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz61-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz61-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz61-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz61-4 { background: linear-gradient(135deg,#ec4899,#db2777); border-radius: 16px; padding: 24px; margin-bottom: 16px; text-align: center; }
  .dz61-5 { color: #fff; font-size: 16px; font-weight: bold; }
  .dz61-6 { color: rgba(255,255,255,0.9); font-size: 13px; margin-top: 4px; }
  .dz61-7 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
  .dz61-8 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz61-9 { background: #25D366; color: #0B3B1E; text-decoration: none; text-align: center; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 13px; }
  .dz61-10 { background: #1773E9; color: #fff; text-decoration: none; text-align: center; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 13px; }
  .dz61-11 { background: #007DBC; color: #fff; text-decoration: none; text-align: center; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 13px; }
  .dz61-12 { background: #475569; color: #fff; border: none; text-align: center; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 13px; cursor: pointer; }
  .dz61-13 { width: 100%; background: #1e1e1e; border: 1px solid #333; color: #94a3b8; padding: 10px; border-radius: 8px; margin-top: 12px; font-size: 12px; }
  .dz61-14 { background: rgba(245,158,11,0.1); border: 1px solid var(--gold,#f59e0b); border-radius: 16px; padding: 20px; text-align: center; }
  .dz61-15 { color: #10b981; font-size: 14px; font-weight: bold; }
  .dz61-16 { color: var(--text-muted); font-size: 12px; margin-top: 4px; }
  .dz61-17 { color: var(--text-main); font-size: 13px; margin-bottom: 12px; }
  .dz61-18 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im62-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im62-2 { font-size: 44px; margin-bottom: 6px; }
  .im62-3 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .im62-4 { margin: 0; }
  .im62-5 { width: 100%; justify-content: center; font-weight: 700; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz61-1">
  <%- include('../partials/flash') %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <div role="alert" class="data-load-error">
      <%= t.common_stats_load_failed %>
    </div>
  <% } %>

  <div class="im62-1">
    <a class="dz61-2" href="/profile">←</a>
    <h1 class="dz61-3">📤 <%= t('shr_title') %></h1>
  </div>

  <div class="dz61-4">
    <div class="im62-2">📤</div>
    <div class="dz61-5"><%= t('shr_heading') %></div>
    <div class="dz61-6">
      প্রতিদিন <%= t('prof_share') %> করে <strong><%= share ? share.bonus : 20 %> কয়েন</strong> পান
    </div>
  </div>

  <% const shareUrl = baseUrl + (user && user.referral_code ? '/register?ref=' + user.referral_code : '/'); %>

  <!-- শেয়ার বাটন -->
  <div class="dz61-7">
    <div class="dz61-8"><%= t('shr_where') %></div>
    <div class="im62-3">
      <a class="dz61-9" href="https://wa.me/?text=<%= encodeURIComponent(t("shr_message") + ' ' + shareUrl) %>" target="_blank">
        WhatsApp
      </a>
      <a class="dz61-10" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>" target="_blank">
        Facebook
      </a>
      <a class="dz61-11" href="https://t.me/share/url?url=<%= encodeURIComponent(shareUrl) %>&text=<%= encodeURIComponent(t("shr_message")) %>" target="_blank">
        Telegram
      </a>
      <button class="dz61-12" data-copy-link>
        <%= t('shr_copy_link') %>
      </button>
    </div>
    <input class="dz61-13" type="text" id="shareLink" value="<%= shareUrl %>" readonly>
  </div>

  <!-- বোনাস ক্লেইম -->
  <div class="dz61-14">
    <% if (share && share.claimed) { %>
      <div class="dz61-15">✅ <%= t('shr_claimed') %></div>
      <div class="dz61-16"><%= t('shr_come_back') %></div>
    <% } else { %>
      <div class="dz61-17"><%= t('shr_after_share') %></div>
      <form class="im62-4" action="/profile/share/claim" method="POST">
        <button type="submit" class="btn btn-primary im62-5">
          🎁 <%= t('prof_share') %> বোনাস নিন (<%= share ? share.bonus : 20 %> কয়েন)
        </button>
      </form>
    <% } %>
  </div>

  <p class="dz61-18">
    <%= t('shr_footer') %>
  </p>

</div>

<script src="/js/views/profile-share.js"></script>
<%- include('../partials/bottom-nav') %>
</body></html>

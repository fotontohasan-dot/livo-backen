<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">📅 <%= t('per_title') %></h1>
  </div>

  <!-- সাপ্তাহিক ক্যাশব্যাক -->
  <div style="background:linear-gradient(135deg,#0B7EB2,#026598);border-radius:16px;padding:20px;margin-bottom:16px;">
    <div style="color:#fff;font-size:16px;font-weight:bold;margin-bottom:4px;">🗓️ <%= t('per_weekly_cashback') %></div>
    <div style="color:rgba(255,255,255,0.9);font-size:12px;margin-bottom:14px;"><%= t('per_weekly_desc') %></div>

    <% if (weekly) { %>
      <div style="background:rgba(0,0,0,0.2);border-radius:10px;padding:12px;margin-bottom:12px;">
        <div style="display:flex;justify-content:space-between;padding:4px 0;">
          <span style="color:rgba(255,255,255,0.85);font-size:13px;"><%= t('per_net_loss_7d') %></span>
          <span style="color:#fff;font-size:13px;font-weight:bold;"><%= Number(weekly.netLoss).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:4px 0;">
          <span style="color:rgba(255,255,255,0.85);font-size:13px;"><%= t('per_cashback_10') %></span>
          <span style="color:#fff;font-size:15px;font-weight:bold;"><%= t('per_coins').replace('{value}', Number(weekly.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
        </div>
      </div>
      <% if (weekly.claimed) { %>
        <div style="text-align:center;color:#d1fae5;font-size:13px;font-weight:bold;">✅ <%= t('per_weekly_claimed') %></div>
      <% } else if (weekly.available) { %>
        <form action="/profile/periodic/weekly" method="POST" style="margin:0;">
          <button type="submit" style="width:100%;background:#fff;color:#0284c7;border:none;border-radius:10px;padding:12px;font-weight:bold;font-size:14px;cursor:pointer;">
            🗓️ <%= t('per_weekly_claim') %>
          </button>
        </form>
      <% } else { %>
        <div style="text-align:center;color:rgba(255,255,255,0.85);font-size:12px;"><%= t('per_weekly_none') %></div>
      <% } %>
    <% } else { %>
      <div style="color:rgba(255,255,255,0.85);font-size:13px;text-align:center;"><%= t('per_load_error') %></div>
    <% } %>
  </div>

  <!-- মাসিক রিওয়ার্ড -->
  <div style="background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:16px;padding:20px;margin-bottom:16px;">
    <div style="color:#fff;font-size:16px;font-weight:bold;margin-bottom:4px;">📆 <%= t('per_monthly_reward') %></div>
    <div style="color:rgba(255,255,255,0.9);font-size:12px;margin-bottom:14px;"><%= t('per_monthly_desc') %></div>

    <% if (monthly) { %>
      <div style="background:rgba(0,0,0,0.2);border-radius:10px;padding:12px;margin-bottom:12px;">
        <div style="display:flex;justify-content:space-between;padding:4px 0;">
          <span style="color:rgba(255,255,255,0.85);font-size:13px;"><%= t('per_monthly_total_bet') %></span>
          <span style="color:#fff;font-size:13px;font-weight:bold;"><%= Number(monthly.turnover).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:4px 0;">
          <span style="color:rgba(255,255,255,0.85);font-size:13px;"><%= t('per_bonus_due') %></span>
          <span style="color:#fff;font-size:15px;font-weight:bold;"><%= t('per_coins').replace('{value}', Number(monthly.bonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
        </div>
      </div>

      <% if (monthly.claimed) { %>
        <div style="text-align:center;color:#ddd6fe;font-size:13px;font-weight:bold;">✅ <%= t('per_monthly_claimed') %></div>
      <% } else if (monthly.available) { %>
        <form action="/profile/periodic/monthly" method="POST" style="margin:0;">
          <button type="submit" style="width:100%;background:#fff;color:#5b21b6;border:none;border-radius:10px;padding:12px;font-weight:bold;font-size:14px;cursor:pointer;">
            📆 <%= t('per_monthly_claim') %>
          </button>
        </form>
      <% } else { %>
        <div style="text-align:center;color:rgba(255,255,255,0.85);font-size:12px;"><%= t('per_monthly_none') %></div>
      <% } %>

      <!-- টিয়ার তালিকা -->
      <div style="margin-top:14px;border-top:1px solid rgba(255,255,255,0.15);padding-top:12px;">
        <% monthly.tiers.forEach(tier => { %>
          <div style="display:flex;justify-content:space-between;padding:5px 0;font-size:12px;">
            <span style="color:rgba(255,255,255,0.8);"><%= t('per_tier_bet').replace('{value}', Number(tier.min).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
            <span style="color:#fde68a;font-weight:bold;"><%= t('per_coins').replace('{value}', tier.bonus) %></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="color:rgba(255,255,255,0.85);font-size:13px;text-align:center;"><%= t('per_load_error') %></div>
    <% } %>
  </div>

  <p style="font-size:.75rem;color:var(--text-muted);text-align:center;line-height:1.6;">
    <%= t('per_footer') %>
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

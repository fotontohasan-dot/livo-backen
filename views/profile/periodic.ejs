<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz55-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz55-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz55-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz55-4 { background: linear-gradient(135deg,#0B7EB2,#026598); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
  .dz55-5 { color: #fff; font-size: 16px; font-weight: bold; margin-bottom: 4px; }
  .dz55-6 { color: rgba(255,255,255,0.9); font-size: 12px; margin-bottom: 14px; }
  .dz55-7 { background: rgba(0,0,0,0.2); border-radius: 10px; padding: 12px; margin-bottom: 12px; }
  .dz55-8 { display: flex; justify-content: space-between; padding: 4px 0; }
  .dz55-9 { color: rgba(255,255,255,0.85); font-size: 13px; }
  .dz55-10 { color: #fff; font-size: 13px; font-weight: bold; }
  .dz55-11 { color: #fff; font-size: 15px; font-weight: bold; }
  .dz55-12 { text-align: center; color: #d1fae5; font-size: 13px; font-weight: bold; }
  .dz55-13 { width: 100%; background: #fff; color: #0284c7; border: none; border-radius: 10px; padding: 12px; font-weight: bold; font-size: 14px; cursor: pointer; }
  .dz55-14 { text-align: center; color: rgba(255,255,255,0.85); font-size: 12px; }
  .dz55-15 { color: rgba(255,255,255,0.85); font-size: 13px; text-align: center; }
  .dz55-16 { background: linear-gradient(135deg,#7c3aed,#5b21b6); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
  .dz55-17 { text-align: center; color: #ddd6fe; font-size: 13px; font-weight: bold; }
  .dz55-18 { width: 100%; background: #fff; color: #5b21b6; border: none; border-radius: 10px; padding: 12px; font-weight: bold; font-size: 14px; cursor: pointer; }
  .dz55-19 { margin-top: 14px; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 12px; }
  .dz55-20 { display: flex; justify-content: space-between; padding: 5px 0; font-size: 12px; }
  .dz55-21 { color: rgba(255,255,255,0.8); }
  .dz55-22 { color: #fde68a; font-weight: bold; }
  .dz55-23 { font-size: .75rem; color: var(--text-muted); text-align: center; line-height: 1.6; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im56-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im56-2 { margin: 0; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz55-1">
  <%- include('../partials/flash') %>

  <div class="im56-1">
    <a class="dz55-2" href="/profile">←</a>
    <h1 class="dz55-3">📅 <%= t('per_title') %></h1>
  </div>

  <!-- সাপ্তাহিক ক্যাশব্যাক -->
  <div class="dz55-4">
    <div class="dz55-5">🗓️ <%= t('per_weekly_cashback') %></div>
    <div class="dz55-6"><%= t('per_weekly_desc') %></div>

    <% if (weekly) { %>
      <div class="dz55-7">
        <div class="dz55-8">
          <span class="dz55-9"><%= t('per_net_loss_7d') %></span>
          <span class="dz55-10"><%= Number(weekly.netLoss).toLocaleString('bn-BD') %></span>
        </div>
        <div class="dz55-8">
          <span class="dz55-9"><%= t('per_cashback_10') %></span>
          <span class="dz55-11"><%= Number(weekly.amount).toLocaleString('bn-BD') %> কয়েন</span>
        </div>
      </div>
      <% if (weekly.claimed) { %>
        <div class="dz55-12">✅ <%= t('per_weekly_claimed') %></div>
      <% } else if (weekly.available) { %>
        <form class="im56-2" action="/profile/periodic/weekly" method="POST">
          <button class="dz55-13" type="submit">
            🗓️ <%= t('per_weekly_claim') %>
          </button>
        </form>
      <% } else { %>
        <div class="dz55-14">এই সপ্তাহে <%= t('cb_title') %> পাওয়ার মতো যথেষ্ট লস হয়নি।</div>
      <% } %>
    <% } else { %>
      <div class="dz55-15"><%= t('per_load_error') %></div>
    <% } %>
  </div>

  <!-- মাসিক রিওয়ার্ড -->
  <div class="dz55-16">
    <div class="dz55-5">📆 <%= t('per_monthly_reward') %></div>
    <div class="dz55-6"><%= t('per_monthly_desc') %></div>

    <% if (monthly) { %>
      <div class="dz55-7">
        <div class="dz55-8">
          <span class="dz55-9"><%= t('per_monthly_total_bet') %></span>
          <span class="dz55-10"><%= Number(monthly.turnover).toLocaleString('bn-BD') %></span>
        </div>
        <div class="dz55-8">
          <span class="dz55-9"><%= t('per_bonus_due') %></span>
          <span class="dz55-11"><%= Number(monthly.bonus).toLocaleString('bn-BD') %> কয়েন</span>
        </div>
      </div>

      <% if (monthly.claimed) { %>
        <div class="dz55-17">✅ <%= t('per_monthly_claimed') %></div>
      <% } else if (monthly.available) { %>
        <form class="im56-2" action="/profile/periodic/monthly" method="POST">
          <button class="dz55-18" type="submit">
            📆 <%= t('per_monthly_claim') %>
          </button>
        </form>
      <% } else { %>
        <div class="dz55-14"><%= t('per_monthly_none') %></div>
      <% } %>

      <!-- টিয়ার তালিকা -->
      <div class="dz55-19">
        <%# লুপ ভ্যারিয়েবলের নাম `t` ছিল, যা অনুবাদক t()-কে ঢেকে দিত %>
        <% monthly.tiers.forEach(tier => { %>
          <div class="dz55-20">
            <span class="dz55-21"><%= t('per_tier_bet').replace('{value}', Number(tier.min).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
            <span class="dz55-22"><%= t('per_coins').replace('{value}', tier.bonus) %></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="dz55-15"><%= t('per_load_error') %></div>
    <% } %>
  </div>

  <p class="dz55-23">
    <%= t('per_footer') %>
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

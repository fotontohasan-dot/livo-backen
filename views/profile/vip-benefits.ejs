<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile/vip" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;"><%= benefits.icon %> <%= t('vipb_title').replace('{name}', benefits.name) %></h1>
  </div>

  <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:16px;padding:24px;margin-bottom:16px;text-align:center;">
    <div style="font-size:44px;margin-bottom:4px;"><%= benefits.icon %></div>
    <div style="color:#fff;font-size:22px;font-weight:900;"><%= benefits.name %></div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:2px;"><%= t('vipb_level').replace('{value}', benefits.level) %></div>
    <% if (vip && vip.level === benefits.level) { %>
      <div style="margin-top:8px;background:rgba(0,0,0,0.2);display:inline-block;padding:4px 12px;border-radius:20px;color:#fff;font-size:11px;font-weight:700;">✅ <%= t('vipb_current') %></div>
    <% } %>
  </div>

  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;margin-bottom:16px;">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:14px;">🎁 <%= t('vipb_benefits_heading') %></div>

    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:var(--text-muted);font-size:13px;">💰 <%= t('vipb_cashback') %></span>
      <span style="color:#10b981;font-weight:bold;font-size:13px;">+<%= benefits.cashbackPercent %>%</span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:var(--text-muted);font-size:13px;">🏧 <%= t('vipb_withdraw_limit') %></span>
      <span style="color:var(--text-main);font-weight:bold;font-size:13px;"><%= benefits.withdrawalLimit > 0 ? t('vipb_coins_per_day').replace('{value}', Number(benefits.withdrawalLimit).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) : t('vipb_unlimited') %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:var(--text-muted);font-size:13px;">💳 <%= t('vipb_deposit_bonus') %></span>
      <span style="color:var(--text-main);font-weight:bold;font-size:13px;">+<%= benefits.depositBonusPercent %>%</span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:var(--text-muted);font-size:13px;">🎂 <%= t('vipb_birthday_bonus') %></span>
      <span style="color:var(--text-main);font-weight:bold;font-size:13px;"><%= t('vipb_coins').replace('{value}', Number(benefits.birthdayBonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:var(--text-muted);font-size:13px;">☎️ <%= t('vipb_priority_support') %></span>
      <span style="color:<%= benefits.prioritySupport ? '#10b981' : 'var(--text-muted)' %>;font-weight:bold;font-size:13px;"><%= benefits.prioritySupport ? '✅ ' + t('vipb_yes') : '❌ ' + t('vipb_no') %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:10px 0;">
      <span style="color:var(--text-muted);font-size:13px;">🎉 <%= t('vipb_exclusive_events') %></span>
      <span style="color:var(--text-main);font-weight:bold;font-size:12px;text-align:right;max-width:60%;"><%= benefits.exclusiveEvents || t('vipb_no') %></span>
    </div>
  </div>

  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:14px;">🎁 <%= t('vipb_schedule_heading') %></div>
    <div style="display:flex;justify-content:space-between;padding:8px 0;">
      <span style="color:var(--text-muted);font-size:13px;">🔓 <%= t('vipb_upgrade_bonus') %></span>
      <span style="color:#f59e0b;font-weight:bold;font-size:13px;"><%= Number(benefits.upgradeBonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:8px 0;">
      <span style="color:var(--text-muted);font-size:13px;">☀️ <%= t('vipb_daily_bonus') %></span>
      <span style="color:#f59e0b;font-weight:bold;font-size:13px;"><%= Number(benefits.dailyBonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:8px 0;">
      <span style="color:var(--text-muted);font-size:13px;">📅 <%= t('vipb_weekly_bonus') %></span>
      <span style="color:#f59e0b;font-weight:bold;font-size:13px;"><%= Number(benefits.weeklyBonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:8px 0;">
      <span style="color:var(--text-muted);font-size:13px;">🗓️ <%= t('vipb_monthly_bonus') %></span>
      <span style="color:#f59e0b;font-weight:bold;font-size:13px;"><%= Number(benefits.monthlyBonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></span>
    </div>
  </div>

  <p style="font-size:.72rem;color:var(--text-muted);text-align:center;margin-top:1rem;">
    <%= t('vipb_min_turnover').replace('{value}', Number(benefits.minTurnover).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
  </p>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

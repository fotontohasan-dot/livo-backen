<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz70-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz70-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz70-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz70-4 { background: linear-gradient(135deg,#f59e0b,#d97706); border-radius: 16px; padding: 24px; margin-bottom: 16px; text-align: center; }
  .dz70-5 { color: #fff; font-size: 22px; font-weight: 900; }
  .dz70-6 { color: rgba(255,255,255,0.9); font-size: 13px; margin-top: 2px; }
  .dz70-7 { margin-top: 8px; background: rgba(0,0,0,0.2); display: inline-block; padding: 4px 12px; border-radius: 20px; color: #fff; font-size: 11px; font-weight: 700; }
  .dz70-8 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .dz70-9 { color: var(--text-main); font-weight: bold; margin-bottom: 14px; }
  .dz70-10 { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .dz70-11 { color: var(--text-muted); font-size: 13px; }
  .dz70-12 { color: #10b981; font-weight: bold; font-size: 13px; }
  .dz70-13 { color: var(--text-main); font-weight: bold; font-size: 13px; }
  .dz70-14 { display: flex; justify-content: space-between; padding: 10px 0; }
  .dz70-15 { color: var(--text-main); font-weight: bold; font-size: 12px; text-align: right; max-width: 60%; }
  .dz70-16 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz70-17 { display: flex; justify-content: space-between; padding: 8px 0; }
  .dz70-18 { color: #f59e0b; font-weight: bold; font-size: 13px; }
  .dz70-19 { font-size: .72rem; color: var(--text-muted); text-align: center; margin-top: 1rem; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im71-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im71-2 { font-size: 44px; margin-bottom: 4px; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz70-1">
  <%- include('../partials/flash') %>

  <div class="im71-1">
    <a class="dz70-2" href="/profile/vip">←</a>
    <h1 class="dz70-3"><%= benefits.icon %> <%= benefits.name %> বেনিফিটস</h1>
  </div>

  <div class="dz70-4">
    <div class="im71-2"><%= benefits.icon %></div>
    <div class="dz70-5"><%= benefits.name %></div>
    <div class="dz70-6">VIP <%= t('loy_level') %> <%= benefits.level %></div>
    <% if (vip && vip.level === benefits.level) { %>
      <div class="dz70-7">✅ <%= t('vipb_current') %></div>
    <% } %>
  </div>

  <div class="dz70-8">
    <div class="dz70-9">🎁 <%= t('vipb_benefits_heading') %></div>

    <div class="dz70-10">
      <span class="dz70-11">💰 <%= t('vipb_cashback') %></span>
      <span class="dz70-12">+<%= benefits.cashbackPercent %>%</span>
    </div>
    <div class="dz70-10">
      <span class="dz70-11">🏧 <%= t('vipb_withdraw_limit') %></span>
      <span class="dz70-13"><%= benefits.withdrawalLimit > 0 ? Number(benefits.withdrawalLimit).toLocaleString('bn-BD') + ' কয়েন/দিন' : t("vipb_unlimited") %></span>
    </div>
    <div class="dz70-10">
      <span class="dz70-11">💳 <%= t('vipb_deposit_bonus') %></span>
      <span class="dz70-13">+<%= benefits.depositBonusPercent %>%</span>
    </div>
    <div class="dz70-10">
      <span class="dz70-11">🎂 <%= t('vipb_birthday_bonus') %></span>
      <span class="dz70-13"><%= Number(benefits.birthdayBonus).toLocaleString('bn-BD') %> কয়েন</span>
    </div>
    <div class="dz70-10">
      <span class="dz70-11">☎️ <%= t('vipb_priority_support') %></span>
      <span style="color:<%= benefits.prioritySupport ? '#10b981' : 'var(--text-muted)' %>;font-weight:bold;font-size:13px;"><%= benefits.prioritySupport ? '✅ ' + t("vipb_yes") : '❌ ' + t("vipb_no") %></span>
    </div>
    <div class="dz70-14">
      <span class="dz70-11">🎉 <%= t('vipb_exclusive_events') %></span>
      <span class="dz70-15"><%= benefits.exclusiveEvents || t("vipb_no") %></span>
    </div>
  </div>

  <div class="dz70-16">
    <div class="dz70-9">🎁 <%= t('vipb_schedule_heading') %></div>
    <div class="dz70-17">
      <span class="dz70-11">🔓 <%= t('vipb_upgrade_bonus') %></span>
      <span class="dz70-18"><%= Number(benefits.upgradeBonus).toLocaleString('bn-BD') %></span>
    </div>
    <div class="dz70-17">
      <span class="dz70-11">☀️ <%= t('vipb_daily_bonus') %></span>
      <span class="dz70-18"><%= Number(benefits.dailyBonus).toLocaleString('bn-BD') %></span>
    </div>
    <div class="dz70-17">
      <span class="dz70-11">📅 <%= t('vipb_weekly_bonus') %></span>
      <span class="dz70-18"><%= Number(benefits.weeklyBonus).toLocaleString('bn-BD') %></span>
    </div>
    <div class="dz70-17">
      <span class="dz70-11">🗓️ <%= t('vipb_monthly_bonus') %></span>
      <span class="dz70-18"><%= Number(benefits.monthlyBonus).toLocaleString('bn-BD') %></span>
    </div>
  </div>

  <p class="dz70-19">
    ন্যূনতম টার্নওভার প্রয়োজন: <%= Number(benefits.minTurnover).toLocaleString('bn-BD') %>
  </p>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

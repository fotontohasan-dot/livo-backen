<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Safety Score + Checklist — সাইটের নিজস্ব থিম টোকেন (--bg-card, --border-glass,
     --gold, --text-main, --text-muted, --green, --red) দিয়েই, নতুন কোনো রঙ
     হার্ডকোড না করে। */
  .sc-score-card { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 20px; padding: 20px; display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .sc-gauge { width: 92px; height: 92px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); }
  .sc-gauge-inner { width: 72px; height: 72px; border-radius: 50%; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; color: var(--text-main); }
  .sc-gauge-inner span { font-size: 12px; font-weight: 700; margin-left: 2px; }
  .sc-score-body { flex: 1; min-width: 0; }
  .sc-score-title { display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 800; color: var(--text-main); flex-wrap: wrap; }
  .sc-score-title .lvl-low { color: var(--red) !important; }
  .sc-score-title .lvl-medium { color: var(--gold) !important; }
  .sc-score-title .lvl-high { color: var(--green) !important; }
  .sc-bolt.is-on.lvl-low { color: var(--red) !important; }
  .sc-bolt.is-on.lvl-medium { color: var(--gold) !important; }
  .sc-bolt.is-on.lvl-high { color: var(--green) !important; }
  .sc-bolt.is-off { color: rgba(255,255,255,0.15) !important; }
  .sc-score-meta { color: var(--text-muted); font-size: 12.5px; margin-top: 6px; line-height: 1.6; }
  .sc-warning-banner { color: var(--red) !important; font-weight: 800; font-size: 14px; text-align: center; padding: 4px 10px 16px; line-height: 1.6; }
  .sc-checklist { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 20px; overflow: hidden; margin-bottom: 20px; }
  .sc-check-row { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-bottom: 1px solid var(--border-glass); text-decoration: none; }
  .sc-check-row:last-child { border-bottom: none; }
  .sc-check-icon { font-size: 22px; width: 32px; text-align: center; flex-shrink: 0; color: var(--text-muted); }
  .sc-check-icon.is-ok { color: var(--green) !important; }
  .sc-check-body { flex: 1; min-width: 0; }
  .sc-check-title { display: flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 800; color: var(--text-main); }
  .sc-check-badge.is-bad { color: var(--red) !important; }
  .sc-check-badge.is-ok { color: var(--green) !important; }
  .sc-check-sub { color: var(--text-muted); font-size: 12.5px; margin-top: 3px; }
  .sc-check-chevron { color: var(--text-muted); font-size: 14px; flex-shrink: 0; }
</style>

<div class="container" style="padding: 16px; padding-bottom: 100px;">
  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
    <a href="/profile" style="color: #fff; text-decoration: none; width: 40px; height: 40px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
      <i class="fas fa-chevron-left"></i>
    </a>
    <h1 style="color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= t.security_settings_title %></h1>
  </div>

  <%- include('../partials/flash') %>

  <% if (!isDetailView) { %>
  <!-- ==================== Safety Score + Checklist (শুধু হাব পেজে: /profile/security) ==================== -->
  <style nonce="<%= cspNonce %>">#sc-gauge-fill { background: conic-gradient(var(--gold) <%= safetyScore %>%, rgba(255,255,255,0.08) 0); }</style>
  <div class="sc-score-card">
    <div id="sc-gauge-fill" class="sc-gauge">
      <div class="sc-gauge-inner"><%= safetyScore %><span>%</span></div>
    </div>
    <div class="sc-score-body">
      <div class="sc-score-title">
        Safety Score: <span class="lvl-<%= safetyLevel %>"><%= safetyLevel === 'high' ? 'High' : (safetyLevel === 'medium' ? 'Medium' : 'Low') %></span>
        <% var scBoltsOn = Math.round(safetyScore / 20); %>
        <% for (var b = 1; b <= 5; b++) { %>
          <i class="fas fa-bolt sc-bolt <%= b <= scBoltsOn ? ('is-on lvl-' + safetyLevel) : 'is-off' %>"></i>
        <% } %>
      </div>
      <div class="sc-score-meta">
        Last Login IP: <%= (lastLogin && lastLogin.ip) ? lastLogin.ip : '—' %><br>
        Last Login Time: <%= (lastLogin && lastLogin.created_at) ? new Date(lastLogin.created_at).toLocaleString() : '—' %>
      </div>
    </div>
  </div>

  <% if (safetyScore < 80) { %>
    <div class="sc-warning-banner">Your account security level is <%= safetyLevel %>, improve your security info</div>
  <% } %>

  <div class="sc-checklist">
    <% checklist.forEach(function(it) { %>
      <a href="/profile/security/<%= it.target %>" class="sc-check-row">
        <i class="fas <%= it.icon %> sc-check-icon <%= it.ok ? 'is-ok' : '' %>"></i>
        <div class="sc-check-body">
          <div class="sc-check-title">
            <%= it.label %>
            <i class="fas <%= it.ok ? 'fa-circle-check' : 'fa-circle-exclamation' %> sc-check-badge <%= it.ok ? 'is-ok' : 'is-bad' %>"></i>
          </div>
          <div class="sc-check-sub"><%= it.sub %></div>
        </div>
        <i class="fas fa-chevron-right sc-check-chevron"></i>
      </a>
    <% }) %>
    <a href="/logout" class="sc-check-row">
      <i class="fas fa-power-off sc-check-icon"></i>
      <div class="sc-check-body">
        <div class="sc-check-title">Log Out</div>
        <div class="sc-check-sub">Log out securely</div>
      </div>
      <i class="fas fa-chevron-right sc-check-chevron"></i>
    </a>
  </div>

  <% } %>

  <% if (isDetailView) { %>
  <% if (activeTab === 'personal') { %>
  <!-- Personal Information — একক পেজ -->
  <div id="tab-personal" class="sec-content">
    <div style="background: var(--bg-card); border-radius: 20px; padding: 25px; border: 1px solid var(--border-glass); margin-bottom: 20px;">
      <h3 style="color: var(--gold); font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-id-card"></i> <%= t.personal_info %>
      </h3>
      <form action="/profile/update-personal" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.username_fixed %></label>
          <input type="text" value="<%= user.username %>" disabled style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px 15px; color: rgba(255,255,255,0.5); font-size: 14px;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.email %></label>
          <input type="email" value="<%= user.email %>" disabled style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px 15px; color: rgba(255,255,255,0.5); font-size: 14px;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.full_name %></label>
          <input type="text" name="full_name" value="<%= user.full_name || '' %>" placeholder="<%= t.full_name_placeholder %>" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none; border-color: <%= user.full_name ? 'var(--border-glass)' : 'rgba(245, 158, 11, 0.3)' %>;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.phone %></label>
          <input type="text" name="phone" value="<%= user.phone || '' %>" placeholder="01XXXXXXXXX" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 10px; border-radius: 12px; padding: 14px; font-weight: 800;"><%= t.update_info %></button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (activeTab === 'bank') { %>
  <!-- Bank / Wallet — একক পেজ -->
  <div id="tab-bank" class="sec-content">
    <div style="background: var(--bg-card); border-radius: 20px; padding: 25px; border: 1px solid var(--border-glass); margin-bottom: 20px;">
      <h3 style="color: var(--gold); font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-credit-card"></i> <%= t.bank_cards_wallets %>
      </h3>
      <% if (bankCards && bankCards.length > 0) { %>
        <% bankCards.forEach(card => { %>
          <div style="background: rgba(255,255,255,0.03); border-radius: 12px; padding: 15px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <div style="color: #fff; font-size: 14px; font-weight: 600;"><%= card.bank_name %></div>
              <div style="color: var(--text-muted); font-size: 12px;"><%= card.account_number %></div>
            </div>
            <form action="/profile/delete-bank-card/<%= card.id %>" method="POST" onsubmit="return confirm('<%= t.delete_card_confirm %>')">
              <button type="submit" style="background: rgba(239, 68, 68, 0.1); border: none; width: 32px; height: 32px; border-radius: 8px; color: #ef4444; cursor: pointer;">
                <i class="fas fa-trash-alt"></i>
              </button>
            </form>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; padding: 40px 20px; background: rgba(255,255,255,0.02); border-radius: 16px; margin-bottom: 25px; border: 1px dashed var(--border-glass);">
          <i class="fas fa-university" style="font-size: 40px; color: var(--text-muted); margin-bottom: 15px;"></i>
          <p style="color: var(--text-muted); font-size: 13px;"><%= t.no_cards_msg %></p>
        </div>
      <% } %>

      <!-- Add Card Form -->
      <div style="border-top: 1px solid var(--border-glass); padding-top: 25px;">
        <h4 style="color: #fff; font-size: 14px; margin-bottom: 15px;"><%= t.add_new_card %></h4>
        <form action="/profile/add-bank-card" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
          <select name="bank_name" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
            <option value="" style="background: #121212;"><%= t.select_payment_method %></option>
            <option value="bKash" style="background: #121212;">bKash</option>
            <option value="Nagad" style="background: #121212;">Nagad</option>
            <option value="Rocket" style="background: #121212;">Rocket</option>
            <option value="Bank Account" style="background: #121212;">Local Bank</option>
          </select>
          <input type="text" name="account_number" placeholder="<%= t.account_number_placeholder_alt %>" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
          <input type="text" name="holder_name" placeholder="<%= t.holder_name_placeholder %>" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
          <button type="submit" class="btn btn-secondary" style="margin-top: 5px; border-radius: 12px; padding: 14px; font-weight: 800; background: var(--grad-gold); color: #000;"><%= t.add_card_btn %></button>
        </form>
      </div>
    </div>
  </div>
  <% } %>

  <% if (activeTab === 'login-password') { %>
  <!-- লগইন পাসওয়ার্ড পরিবর্তন — একক পেজ। লগইন পাসওয়ার্ড সবসময়ই সেট করা
       থাকে (অ্যাকাউন্ট খোলার সময় থেকেই), তাই এখানে সবসময় ৩টা ফিল্ড। -->
  <div id="tab-login-password" class="sec-content">
    <div style="background: var(--bg-card); border-radius: 20px; padding: 25px; border: 1px solid var(--border-glass); margin-bottom: 20px;">
      <h3 style="color: var(--gold); font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-lock"></i> <%= t.change_password_title %>
      </h3>
      <form action="/profile/change-password" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.current_password %></label>
          <input type="password" name="currentPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.new_password %></label>
          <input type="password" name="newPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;"><%= t.confirm_new_password %></label>
          <input type="password" name="confirmPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 10px; border-radius: 12px; padding: 14px; font-weight: 800;"><%= t.change_password_btn %></button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (activeTab === 'transaction-password') { %>
  <!-- ট্রানজেকশন (ফান্ডস) পাসওয়ার্ড — একক পেজ, লগইন পাসওয়ার্ড থেকে সম্পূর্ণ
       আলাদা। এখনো সেট করা না থাকলে (user.transaction_password খালি) শুধু
       ২টা ফিল্ড (নতুন + নিশ্চিত করুন) — বর্তমান পাসওয়ার্ড চাওয়া হয় না, কারণ
       তখনও কিছু সেট করাই নেই। আগে থেকে সেট থাকলে ৩টা ফিল্ড (বর্তমান + নতুন +
       নিশ্চিত করুন), যাচাই ছাড়া বদলানো যায় না। -->
  <% var hasTxnPwd = !!user.transaction_password; %>
  <div id="tab-transaction-password" class="sec-content">
    <div style="background: var(--bg-card); border-radius: 20px; padding: 25px; border: 1px solid var(--border-glass); margin-bottom: 20px;">
      <h3 style="color: var(--gold); font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-shield-halved"></i> <%= hasTxnPwd ? 'ট্রানজেকশন পাসওয়ার্ড পরিবর্তন করুন' : 'ট্রানজেকশন পাসওয়ার্ড সেট করুন' %>
      </h3>
      <form action="/profile/set-transaction-password" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <% if (hasTxnPwd) { %>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;">বর্তমান ট্রানজেকশন পাসওয়ার্ড</label>
          <input type="password" name="currentPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <% } %>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;">নতুন ট্রানজেকশন পাসওয়ার্ড</label>
          <input type="password" name="newPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <div>
          <label style="color: var(--text-muted); font-size: 12px; display: block; margin-bottom: 8px;">নতুন ট্রানজেকশন পাসওয়ার্ড নিশ্চিত করুন</label>
          <input type="password" name="confirmPassword" required style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: #fff; font-size: 14px; outline: none;">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 10px; border-radius: 12px; padding: 14px; font-weight: 800;"><%= hasTxnPwd ? 'পাসওয়ার্ড পরিবর্তন করুন' : 'পাসওয়ার্ড সেট করুন' %></button>
      </form>
    </div>
  </div>
  <% } %>
  <% } %>

</div>

<%- include('../partials/navbar') %>

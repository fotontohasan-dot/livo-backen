        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmNewPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn dz71-25"><%= t.reset_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Devices Tab -->
  <div id="tab-devices" class="sec-content <%= activeTab === 'devices' ? 'active-tab' : '' %>">
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-mobile-screen-button"></i> <%= t.active_devices_title %>
      </h3>
      <p class="dz71-13"><%= t.active_devices_subtitle %></p>

      <% if (activeSessions && activeSessions.length) { %>
        <% activeSessions.forEach(function(d) { %>
          <div class="sc-device <%= d.is_current ? 'is-current' : '' %>">
            <div class="im72-8">
              <div class="im72-9">
                <div class="im72-10">
                  <span class="ix71-23"><i class="fas <%= d.device_type === 'Mobile' ? 'fa-mobile-screen' : (d.device_type === 'Tablet' ? 'fa-tablet-screen-button' : 'fa-desktop') %>"></i> <%= d.device_name %></span>
                  <% if (d.is_current) { %><span class="ix71-24"><%= t.current_device_badge %></span><% } %>
                  <% if (d.is_new_device) { %><span class="ix71-25"><%= t.new_device_badge %></span><% } %>
                </div>
                <div class="dz71-18"><%= d.ip %></div>
                <div class="dz71-26"><%= t.device_last_active %>: <%= new Date(d.last_activity).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
              </div>
              <% if (!d.is_current) { %>
                <form method="POST" action="/profile/devices/<%= d.id %>/logout" data-confirm="<%= t.logout_device_confirm %>">
                  <button class="dz71-27" type="submit"><%= t.logout_this_device %></button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz71-28"><%= t.no_active_devices %></div>
      <% } %>

      <% if (activeSessions && activeSessions.filter(function(d){return !d.is_current}).length > 0) { %>
        <form class="dz71-29" method="POST" action="/profile/devices/logout-all-others" data-confirm="<%= t.logout_all_confirm %>">
          <button class="dz71-30" type="submit"><i class="fas fa-right-from-bracket"></i> <%= t.logout_all_other_devices %></button>
        </form>
      <% } %>
    </div>

    <div class="ix71-7">
      <div class="im72-11">
        <h3 class="ix71-26">
          <i class="fas fa-clock-rotate-left"></i> <%= t.recent_login_activity %>
        </h3>
        <a class="ix71-27" href="/profile/login-history"><%= t.view_full_login_history %> <i class="fas fa-chevron-right"></i></a>
      </div>
      <% if (recentLogins && recentLogins.length) { %>
        <% recentLogins.forEach(function(l) { %>
          <div class="ix71-28">
            <div>
              <div class="dz71-31"><%= l.browser %> · <%= l.os %> <% if (l.is_new_device) { %><span class="ix71-29">• <%= t.new_device_badge %></span><% } %></div>
              <div class="dz71-2"><%= l.ip %></div>
            </div>
            <div class="dz71-32"><%= new Date(l.created_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz71-33"><%= t.no_login_history %></div>
      <% } %>
    </div>

    <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
    <div class="ix71-7">
      <h3 class="ix71-30">
        <i class="fas fa-list-check"></i> <%= t('sec_recent_activity') %>
      </h3>
      <% recentActivity.forEach(function(a) {
        let icon = 'fa-circle-info', label = t('sec_activity_generic');
        if (a.kind === 'login') { icon = 'fa-right-to-bracket'; label = t('sec_activity_login'); }
        else if (a.kind === 'deposit') { icon = 'fa-plus-circle'; label = t('sec_activity_deposit'); }
        else if (a.kind === 'withdraw') { icon = 'fa-hand-holding-usd'; label = t('sec_activity_withdraw'); }
        else if (a.kind === 'vip_upgrade') { icon = 'fa-crown'; label = t('sec_activity_vip_upgrade'); }
        else if (a.kind === 'reward_claim') { icon = 'fa-gift'; label = t('sec_activity_reward_claim'); }
      %>
      <div class="ix71-31">
        <span class="ix71-32"><i class="fas <%= icon %>"></i></span>
        <span class="ix71-33"><%= label %><% if (a.amount) { %> — ৳<%= Number(a.amount).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %><% } %></span>
        <span class="ix71-34"><%= new Date(a.created_at).toLocaleDateString(lang === 'bn' ? 'bn-BD' : 'en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

</div>



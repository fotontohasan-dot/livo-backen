<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* এই সাতটা ঘোষণা আগে ইনলাইন `style="..."`-এ ছিল, কারণ প্রতিটাতে একটা
     শর্তনির্ভর রঙ ছিল (it.ok, pinStatus.configured, d.is_current)। শর্তটা রঙের বদলে ক্লাসের নামে
     সরিয়ে দিলে ঘোষণাগুলো স্থির হয়ে যায় এবং পুরোপুরি CSS-এ রাখা যায় —
     style-src-attr ছাড়াই। */
  .sc-card { cursor: pointer; background: rgba(255,255,255,0.03); border-radius: 14px; padding: 12px; border: 1px solid var(--border-glass); display: flex; gap: 10px; align-items: flex-start; }
  .sc-card.is-ok { border-color: rgba(16,185,129,0.25); }
  .sc-card.is-bad { border-color: rgba(239,68,68,0.3); }
  .sc-card-icon { font-size: 16px; margin-top: 2px; }
  .sc-card-badge { font-size: 10px; }
  .sc-card-icon.is-ok, .sc-card-badge.is-ok { color: #10b981; }
  .sc-card-icon.is-bad, .sc-card-badge.is-bad { color: #ef4444; }
  .sc-input { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: var(--text-main); font-size: 14px; outline: none; }
  .sc-input.needs-attention { border-color: rgba(245,158,11,0.3); }
  .sc-pin-state { font-weight: 700; font-size: 14px; }
  .sc-pin-state.is-ok { color: #10b981; }
  .sc-pin-state.is-bad { color: #ef4444; }
  .sc-pin-icon { font-size: 30px; flex-shrink: 0; }
  .sc-pin-icon.is-ok { color: #10b981; }
  .sc-pin-icon.is-idle { color: var(--text-muted); }
  .sc-device { background: rgba(255,255,255,0.03); border-radius: 14px; padding: 15px; margin-bottom: 12px; border: 1px solid var(--border-glass); }
  .sc-device.is-current { border-color: rgba(16,185,129,0.3); }

  /* ==================== Safety Score card + Checklist — fixed light surface, স্ক্রিনশট অনুযায়ী ==================== */
  /* সাইটের ডার্ক-গ্রিন থিম টোকেন (--bg-card, --border-glass, --text-main ইত্যাদি)
     ব্যবহার করে — আগে এই কার্ডগুলো #fff হার্ডকোড করা ছিল, যেটা সাইটের বাকি
     অংশের সাথে না মিলে আলাদা "সাদা" প্যাচের মতো দেখাচ্ছিল। */
  .sc-score-card { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 20px; padding: 20px; display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .sc-gauge { width: 92px; height: 92px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: conic-gradient(var(--text-accent) calc(var(--sc-pct) * 1%), rgba(255,255,255,0.08) 0); }
  .sc-gauge-inner { width: 72px; height: 72px; border-radius: 50%; background: var(--bg-surface-elevated); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; color: var(--text-main); }
  .sc-gauge-inner span { font-size: 12px; font-weight: 700; margin-left: 2px; }
  .sc-score-body { flex: 1; min-width: 0; }
  .sc-score-title { display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 800; color: var(--text-main); flex-wrap: wrap; }
  .sc-score-title .lvl-low { color: var(--red-text); }
  .sc-score-title .lvl-medium { color: var(--warning); }
  .sc-score-title .lvl-high { color: var(--green); }
  .sc-bolt { font-size: 13px; }
  .sc-bolt.is-on.lvl-low { color: var(--red-text); }
  .sc-bolt.is-on.lvl-medium { color: var(--warning); }
  .sc-bolt.is-on.lvl-high { color: var(--green); }
  .sc-bolt.is-off { color: rgba(255,255,255,0.15); }
  .sc-score-meta { color: var(--text-muted); font-size: 12.5px; margin-top: 6px; line-height: 1.6; }
  .sc-warning-banner { color: var(--red-text); font-weight: 800; font-size: 14px; text-align: center; padding: 4px 10px 16px; line-height: 1.6; }
  .sc-checklist { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 20px; overflow: hidden; margin-bottom: 20px; }
  .sc-check-row { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-bottom: 1px solid var(--border-glass); text-decoration: none; }
  .sc-check-row:last-child { border-bottom: none; }
  .sc-check-icon { font-size: 22px; width: 32px; text-align: center; flex-shrink: 0; color: var(--text-muted); }
  .sc-check-icon.is-ok { color: var(--green); }
  .sc-check-body { flex: 1; min-width: 0; }
  .sc-check-title { display: flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 800; color: var(--text-main); }
  .sc-check-badge { font-size: 13px; }
  .sc-check-badge.is-bad { color: var(--red-text); }
  .sc-check-badge.is-ok { color: var(--green); }
  .sc-check-sub { color: var(--text-muted); font-size: 12.5px; margin-top: 3px; }
  .sc-check-chevron { color: var(--text-muted); font-size: 14px; flex-shrink: 0; }
</style>

<div class="container ix71-1">
  <div class="im72-1">
    <a class="ix71-2" href="/profile">
      <i class="fas fa-chevron-left"></i>
    </a>
    <h1 class="ix71-3"><%= t.security_center %></h1>
  </div>

  <%- include('../partials/flash') %>

  <!-- ==================== Safety Score + Checklist — নিরাপত্তা শতাংশ ও উন্নতির তালিকা ==================== -->
  <%
    var scScore = (typeof safetyScore === 'number') ? safetyScore : 0;
    var scLevel = safetyLevel || 'low';
    var scLevelLabel = scLevel === 'high' ? t('sec_safety_high') : (scLevel === 'medium' ? t('sec_safety_medium') : t('sec_safety_low'));
    var scBoltsOn = Math.round(scScore / 20);
    var scChecklist = [
      {
        icon: 'fa-user', ok: !!personalInfoComplete,
        label: t('sec_personal_info_title'),
        sub: personalInfoComplete ? t('sec_personal_info_complete') : t('sec_personal_info_incomplete'),
        kind: 'tab', target: 'personal'
      },
      {
        icon: 'fa-coins', ok: !!hasCryptoWallet,
        label: t('sec_add_crypto_wallet'),
        sub: hasCryptoWallet ? t('sec_crypto_wallet_added') : t('sec_add_crypto_wallet_desc'),
        kind: 'link', target: '/profile/cards'
      },
      {
        icon: 'fa-wallet', ok: !!hasEwallet,
        label: t('sec_bind_ewallet'),
        sub: hasEwallet ? t('sec_ewallet_added') : t('sec_bind_ewallet_desc'),
        kind: 'link', target: '/profile/cards'
      },
      {
        icon: 'fa-lock', ok: !!passwordChangedAt,
        label: t('sec_change_login_password'),
        sub: t('sec_password_mix_hint'),
        kind: 'tab', target: 'security'
      },
      {
        icon: 'fa-shield-halved', ok: !!(pinStatus && pinStatus.configured),
        label: t('sec_transaction_password'),
        sub: (pinStatus && pinStatus.configured) ? t('sec_transaction_password_set') : t('sec_transaction_password_desc'),
        kind: 'tab', target: 'security'
      }
    ];
  %>
  <style nonce="<%= cspNonce %>">
    /* স্কোর অনুযায়ী গেজের পূরণ — শতাংশ প্রতি রিকোয়েস্টে বদলায় বলে ক্লাসে না রেখে
       এই ছোট nonce ব্লকে; ইনলাইন style="..." অ্যাট্রিবিউট নয়, তাই CSP ratchet অক্ষত থাকে। */
    #sc-gauge-fill { background: conic-gradient(var(--text-accent) <%= scScore %>%, rgba(255,255,255,0.08) 0); }
  </style>
  <div class="sc-score-card">
    <div id="sc-gauge-fill" class="sc-gauge">
      <div class="sc-gauge-inner"><%= scScore %><span>%</span></div>
    </div>
    <div class="sc-score-body">
      <div class="sc-score-title">
        <%= t('sec_safety_score') %>: <span class="lvl-<%= scLevel %>"><%= scLevelLabel %></span>
        <% for (var b = 1; b <= 5; b++) { %>
          <i class="fas fa-bolt sc-bolt <%= b <= scBoltsOn ? ('is-on lvl-' + scLevel) : 'is-off' %>"></i>
        <% } %>
      </div>
      <div class="sc-score-meta">
        <%= t('sec_last_login_ip') %>: <%= (lastLogin && lastLogin.ip) ? lastLogin.ip : '—' %><br>
        <%= t('sec_last_login_time') %>: <%= (lastLogin && lastLogin.created_at) ? new Date(lastLogin.created_at).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') : '—' %>
      </div>
    </div>
  </div>

  <% if (scScore < 80) { %>
    <div class="sc-warning-banner"><%= t('sec_improve_warning') %></div>
  <% } %>

  <div class="sc-checklist">
    <% scChecklist.forEach(function(it) { %>
      <% if (it.kind === 'tab') { %>
        <a href="/profile/security/<%= it.target %>" class="sc-check-row">
      <% } else { %>
        <a href="<%= it.target %>" class="sc-check-row">
      <% } %>
        <i class="fas <%= it.icon %> sc-check-icon <%= it.ok ? 'is-ok' : '' %>"></i>
        <div class="sc-check-body">
          <div class="sc-check-title">
            <%= it.label %>
            <i class="fas <%= it.ok ? 'fa-circle-check' : 'fa-circle-exclamation' %> sc-check-badge <%= it.ok ? 'is-ok' : 'is-bad' %>"></i>
          </div>
          <div class="sc-check-sub"><%= it.sub %></div>
        </div>
        <i class="fas fa-chevron-right sc-check-chevron"></i>
      </a>
    <% }) %>
    <a href="/logout" class="sc-check-row">
      <i class="fas fa-power-off sc-check-icon"></i>
      <div class="sc-check-body">
        <div class="sc-check-title"><%= t('sec_logout_title') %></div>
        <div class="sc-check-sub"><%= t('sec_logout_desc') %></div>
      </div>
      <i class="fas fa-chevron-right sc-check-chevron"></i>
    </a>
  </div>

  <!-- Tab Buttons — এখন আসল লিংক, প্রতিটা আলাদা পেজে ফুল নেভিগেশন (URL বদলায়, ব্রাউজার ব্যাক কাজ করে) -->
  <div class="ix71-6">
    <a href="/profile/security/personal" id="btn-personal" class="sec-tab dz71-3 <%= activeTab === 'personal' ? 'active' : '' %>"><%= t.personal_info %></a>
    <a href="/profile/security/bank" id="btn-bank" class="sec-tab dz71-3 <%= activeTab === 'bank' ? 'active' : '' %>"><%= t.menu_withdraw %></a>
    <a href="/profile/security/security" id="btn-security" class="sec-tab dz71-3 <%= activeTab === 'security' ? 'active' : '' %>"><%= t.security %></a>
    <a href="/profile/security/devices" id="btn-devices" class="sec-tab dz71-3 <%= activeTab === 'devices' ? 'active' : '' %>"><%= t.devices_tab %></a>
  </div>

  <!-- Personal Information Tab -->
  <div id="tab-personal" class="sec-content <%= activeTab === 'personal' ? 'active-tab' : '' %>">
    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-id-card"></i> <%= t.personal_info %>
      </h3>
      <form class="im72-4" action="/profile/update-personal" method="POST">
        <div>
          <label class="ix71-9"><%= t.username_fixed %></label>
          <input class="dz71-4" type="text" value="<%= user.username %>" disabled>
        </div>
        <div>
          <label class="ix71-9"><%= t.email %></label>
          <input class="dz71-4" type="email" value="<%= user.email %>" disabled>
        </div>
        <div>
          <label class="ix71-9"><%= t.full_name %></label>
          <input type="text" name="full_name" value="<%= user.full_name || '' %>" placeholder="<%= t.full_name_placeholder %>" class="sc-input <%= user.full_name ? '' : 'needs-attention' %>">
        </div>
        <div>
          <label class="ix71-9"><%= t.phone %></label>
          <input class="dz71-5" type="text" name="phone" value="<%= user.phone || '' %>" placeholder="01XXXXXXXXX">
        </div>
        <button type="submit" class="btn btn-primary ix71-10"><%= t.update_info %></button>
      </form>
    </div>
  </div>

  <!-- Bank Card Tab -->
  <div id="tab-bank" class="sec-content <%= activeTab === 'bank' ? 'active-tab' : '' %>">
    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-credit-card"></i> <%= t.bank_cards_wallets %>
      </h3>
      <% if (bankCards && bankCards.length > 0) { %>
        <% bankCards.forEach(card => { %>
          <div class="ix71-11">
            <div>
              <div class="dz71-7"><%= card.bank_name %></div>
              <div class="dz71-8"><%= card.account_number %></div>
            </div>
            <form action="/profile/delete-bank-card/<%= card.id %>" method="POST" data-confirm="<%= t.delete_card_confirm %>">
              <button class="dz71-9" type="submit">
                <i class="fas fa-trash-alt"></i>
              </button>
            </form>
          </div>
        <% }) %>
      <% } else if (typeof loadError !== 'undefined' && loadError) { %>
        <div role="alert" class="data-load-error-box">
          <i class="fas fa-triangle-exclamation"></i>
          <p><%= t.cards_load_error %></p>
        </div>
      <% } else { %>
        <div class="ix71-12">
          <i class="fas fa-university dz71-10"></i>
          <p class="dz71-11"><%= t.no_cards_msg %></p>
        </div>
      <% } %>

      <!-- Add Card Form -->
      <div class="ix71-13">
        <h4 class="ix71-14"><%= t.add_new_card %></h4>
        <form class="im72-5" action="/profile/add-bank-card" method="POST">
          <select class="ix71-15" name="bank_name" required>
            <option class="ix71-16" value=""><%= t.select_payment_method %></option>
            <option class="ix71-16" value="bKash">bKash</option>
            <option class="ix71-16" value="Nagad">Nagad</option>
            <option class="ix71-16" value="Rocket">Rocket</option>
            <option class="ix71-16" value="Bank Account">Local Bank</option>
          </select>
          <input class="dz71-5" type="text" name="account_number" placeholder="<%= t.account_number_placeholder_alt %>" required>
          <input class="dz71-5" type="text" name="holder_name" placeholder="<%= t.holder_name_placeholder %>" required>
          <button type="submit" class="btn btn-secondary dz71-12"><%= t.add_card_btn %></button>
        </form>
      </div>
    </div>
  </div>

  <!-- Security Tab -->
  <div id="tab-security" class="sec-content <%= activeTab === 'security' ? 'active-tab' : '' %>">

    <!-- ==================== Email Verification কার্ড ==================== -->
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-envelope-circle-check"></i> <%= t('sec_email_verification') %>
      </h3>
      <p class="dz71-13"><%= t('sec_verify_email_desc') %></p>

      <div class="ix71-18">
        <div class="im72-3">
          <div class="dz71-14"><%= user.email || t('sec_no_email_on_account') %></div>
          <% if (!emailStatus || !emailStatus.hasEmail) { %>
            <div class="dz71-15"><i class="fas fa-circle-minus"></i> <%= t('sec_not_applicable') %></div>
          <% } else if (emailStatus.verified) { %>
            <div class="dz71-16"><i class="fas fa-circle-check"></i> <%= t('sec_verified') %></div>
          <% } else { %>
            <div class="dz71-17"><i class="fas fa-circle-xmark"></i> <%= t('sec_not_verified') %></div>
          <% } %>
        </div>
        <% if (emailStatus && emailStatus.hasEmail && !emailStatus.verified) { %>
          <form method="POST" action="/resend-verification">
            <button type="submit" class="btn btn-primary ix71-19"><%= t('sec_resend') %></button>
          </form>
        <% } %>
      </div>

      <% if (!emailStatus || !emailStatus.hasEmail) { %>
        <form method="POST" action="/profile/add-email" class="ix71-21">
          <input type="email" name="email" class="dz71-4 ix71-22" placeholder="<%= t('profile_add_email_placeholder') %>"
                 autocomplete="email" required>
          <button type="submit" class="btn btn-primary"><%= t('profile_add_email_btn') %></button>
        </form>
      <% } %>
    </div>

    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-lock"></i> <%= t.change_password_title %>
      </h3>
      <form class="im72-4" action="/profile/change-password" method="POST">
        <div>
          <label class="ix71-9"><%= t.current_password %></label>
          <input class="ix71-15" type="password" name="currentPassword" required>
        </div>
        <div>
          <label class="ix71-9"><%= t.new_password %></label>
          <input class="ix71-15" type="password" name="newPassword" required>
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_password %></label>
          <input class="ix71-15" type="password" name="confirmPassword" required>
        </div>
        <button type="submit" class="btn btn-primary ix71-10"><%= t.change_password_btn %></button>
      </form>
    </div>

    <!-- ==================== Withdraw PIN কার্ড ==================== -->
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-shield-alt"></i> <%= t.withdraw_pin_title %>
      </h3>
      <p class="dz71-13"><%= t.withdraw_pin_subtitle %></p>

      <!-- Status -->
      <div class="ix71-20">
        <div>
          <div class="dz71-14"><%= t.withdraw_pin_status %></div>
          <div class="sc-pin-state <%= (pinStatus && pinStatus.configured) ? 'is-ok' : 'is-bad' %>">
            <i class="fas <%= (pinStatus && pinStatus.configured) ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i>
            <%= (pinStatus && pinStatus.configured) ? t.pin_configured : t.pin_not_configured %>
          </div>
          <div class="dz71-18">
            <%= t.pin_last_changed %>:
            <%= (pinStatus && pinStatus.updatedAt) ? new Date(pinStatus.updatedAt).toLocaleString('en-US', { year:'numeric', month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }) : t.pin_never_changed %>
          </div>
          <% if (pinStatus && pinStatus.locked) { %>
            <div class="dz71-19">
              <i class="fas fa-lock"></i> <%= t.pin_locked_msg %>
              (<%= Math.max(1, Math.ceil((pinStatus.remainingMs || 0) / 60000)) %> <%= t('sec_min_left') %>)
            </div>
          <% } %>
        </div>
        <i class="fas fa-shield-halved sc-pin-icon <%= (pinStatus && pinStatus.configured) ? 'is-ok' : 'is-idle' %>"></i>
      </div>

      <!-- Action Buttons -->
      <div class="im72-6">
        <% if (!(pinStatus && pinStatus.configured)) { %>
          <button type="button" data-pin-form="create" id="pinToggleBtn-create" class="btn btn-primary dz71-20"><%= t.create_pin_btn %></button>
        <% } else { %>
          <button type="button" data-pin-form="change" id="pinToggleBtn-change" class="btn btn-primary dz71-20"><%= t.change_pin_btn %></button>
          <button type="button" data-pin-form="reset" id="pinToggleBtn-reset" class="btn btn-secondary dz71-21"><%= t.reset_pin_btn %></button>
        <% } %>
      </div>

      <p class="dz71-22"><i class="fas fa-circle-info"></i> <%= t.pin_rules_hint %></p>

      <!-- Create PIN Form -->
      <form class="dz71-23" id="pinFormcreate" action="/profile/withdraw-pin/create" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>
          <input class="ix71-21" type="password" name="pin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn ix71-22"><%= t.create_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>

      <!-- Change PIN Form -->
      <form class="dz71-23" id="pinFormchange" action="/profile/withdraw-pin/change" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.current_pin %></label>
          <input class="ix71-21" type="password" name="currentPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>
          <input class="ix71-21" type="password" name="newPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmNewPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn ix71-22"><%= t.change_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>

      <!-- Reset PIN Form (PIN ভুলে গেলে — অ্যাকাউন্ট পাসওয়ার্ড দিয়ে যাচাই) -->
      <form class="dz71-23" id="pinFormreset" action="/profile/withdraw-pin/reset" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.account_password %></label>
          <input class="ix71-15" type="password" name="accountPassword" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>

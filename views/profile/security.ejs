<%- include('../partials/head') %>

<div class="container ix71-1">
  <div class="im72-1">
    <a class="ix71-2" href="/profile">
      <i class="fas fa-chevron-left"></i>
    </a>
    <h1 class="ix71-3"><%= t.security_center %></h1>
  </div>

  <%- include('../partials/flash') %>

  <!-- ==================== Security Center Overview — ৬টি নিরাপত্তা আইটেমের স্ট্যাটাস একনজরে ==================== -->
  <%
    var scActiveOtherCount = (activeSessions || []).filter(function(d){ return !d.is_current; }).length;
    var scItems = [
      {
        icon: 'fa-envelope-circle-check',
        label: t('sec_email_verification'),
        ok: !emailStatus || !emailStatus.hasEmail || emailStatus.verified,
        sub: (!emailStatus || !emailStatus.hasEmail) ? t('sec_not_applicable')
             : (emailStatus.verified ? t('sec_verified') : t('sec_not_verified')),
        tab: 'security'
      },
      {
        icon: 'fa-key',
        label: t('sec_password'),
        ok: true,
        sub: passwordChangedAt ? (t('sec_last_changed') + new Date(passwordChangedAt).toLocaleDateString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) : t('asec_never_changed'),
        tab: 'security'
      },
      {
        icon: 'fa-shield-halved',
        label: t.withdraw_pin_title,
        ok: !!(pinStatus && pinStatus.configured) && !(pinStatus && pinStatus.locked),
        sub: (pinStatus && pinStatus.locked) ? t('sec_temporarily_locked') : ((pinStatus && pinStatus.configured) ? t.pin_configured : t.pin_not_configured),
        tab: 'security'
      },
      {
        icon: 'fa-mobile-screen-button',
        label: t.active_devices_title,
        ok: true,
        sub: (activeSessions ? activeSessions.length : 0) + t('sec_devices_active'),
        tab: 'devices'
      },
      {
        icon: 'fa-right-from-bracket',
        label: t('sec_other_sessions'),
        ok: scActiveOtherCount === 0,
        sub: scActiveOtherCount > 0 ? (scActiveOtherCount + t('sec_other_sessions_active')) : t('sec_this_device_only'),
        tab: 'devices'
      },
      {
        icon: 'fa-clock-rotate-left',
        label: t.recent_login_activity,
        ok: true,
        sub: (recentLogins ? recentLogins.length : 0) + t('sec_recent_logins_count'),
        tab: 'devices'
      }
    ];
  %>
  <div class="ix71-4">
    <h3 class="ix71-5">
      <i class="fas fa-shield-halved"></i> <%= t('sec_overview') %>
    </h3>
    <div class="im72-2">
      <% scItems.forEach(function(it) { %>
        <div data-switch-tab="<%= it.tab %>" style="cursor:pointer; background: rgba(255,255,255,0.03); border-radius: 14px; padding: 12px; border: 1px solid <%= it.ok ? 'rgba(16,185,129,0.25)' : 'rgba(239,68,68,0.3)' %>; display:flex; gap:10px; align-items:flex-start;">
          <i class="fas <%= it.icon %>" style="font-size:16px; margin-top:2px; color: <%= it.ok ? '#10b981' : '#ef4444' %>;"></i>
          <div class="im72-3">
            <div class="dz71-1">
              <%= it.label %>
              <i class="fas <%= it.ok ? 'fa-circle-check' : 'fa-triangle-exclamation' %>" style="font-size:10px; color: <%= it.ok ? '#10b981' : '#ef4444' %>;"></i>
            </div>
            <div class="dz71-2"><%= it.sub %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Tab Buttons -->
  <div class="ix71-6">
    <button data-switch-tab="personal" id="btn-personal" class="sec-tab active dz71-3"><%= t.personal_info %></button>
    <button data-switch-tab="bank" id="btn-bank" class="sec-tab dz71-3"><%= t.menu_withdraw %></button>
    <button data-switch-tab="security" id="btn-security" class="sec-tab dz71-3"><%= t.security %></button>
    <button data-switch-tab="devices" id="btn-devices" class="sec-tab dz71-3"><%= t.devices_tab %></button>
  </div>

  <!-- Personal Information Tab -->
  <div id="tab-personal" class="sec-content">
    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-id-card"></i> <%= t.personal_info %>
      </h3>
      <form class="im72-4" action="/profile/update-personal" method="POST">
        <div>
          <label class="ix71-9"><%= t.username_fixed %></label>
          <input class="dz71-4" type="text" value="<%= user.username %>" disabled>
        </div>
        <div>
          <label class="ix71-9"><%= t.email %></label>
          <input class="dz71-4" type="email" value="<%= user.email %>" disabled>
        </div>
        <div>
          <label class="ix71-9"><%= t.full_name %></label>
          <input type="text" name="full_name" value="<%= user.full_name || '' %>" placeholder="<%= t.full_name_placeholder %>" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color:var(--text-main); font-size: 14px; outline: none; border-color: <%= user.full_name ? 'var(--border-glass)' : 'rgba(245, 158, 11, 0.3)' %>;">
        </div>
        <div>
          <label class="ix71-9"><%= t.phone %></label>
          <input class="dz71-5" type="text" name="phone" value="<%= user.phone || '' %>" placeholder="01XXXXXXXXX">
        </div>
        <button type="submit" class="btn btn-primary ix71-10"><%= t.update_info %></button>
      </form>
    </div>
  </div>

  <!-- Bank Card Tab -->
  <div id="tab-bank" class="sec-content dz71-6">
    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-credit-card"></i> <%= t.bank_cards_wallets %>
      </h3>
      <% if (bankCards && bankCards.length > 0) { %>
        <% bankCards.forEach(card => { %>
          <div class="ix71-11">
            <div>
              <div class="dz71-7"><%= card.bank_name %></div>
              <div class="dz71-8"><%= card.account_number %></div>
            </div>
            <form action="/profile/delete-bank-card/<%= card.id %>" method="POST" data-confirm="<%= t.delete_card_confirm %>">
              <button class="dz71-9" type="submit">
                <i class="fas fa-trash-alt"></i>
              </button>
            </form>
          </div>
        <% }) %>
      <% } else if (typeof loadError !== 'undefined' && loadError) { %>
        <div role="alert" class="data-load-error-box">
          <i class="fas fa-triangle-exclamation"></i>
          <p><%= t.cards_load_error %></p>
        </div>
      <% } else { %>
        <div class="ix71-12">
          <i class="fas fa-university dz71-10"></i>
          <p class="dz71-11"><%= t.no_cards_msg %></p>
        </div>
      <% } %>

      <!-- Add Card Form -->
      <div class="ix71-13">
        <h4 class="ix71-14"><%= t.add_new_card %></h4>
        <form class="im72-5" action="/profile/add-bank-card" method="POST">
          <select class="ix71-15" name="bank_name" required>
            <option class="ix71-16" value=""><%= t.select_payment_method %></option>
            <option class="ix71-16" value="bKash">bKash</option>
            <option class="ix71-16" value="Nagad">Nagad</option>
            <option class="ix71-16" value="Rocket">Rocket</option>
            <option class="ix71-16" value="Bank Account">Local Bank</option>
          </select>
          <input class="dz71-5" type="text" name="account_number" placeholder="<%= t.account_number_placeholder_alt %>" required>
          <input class="dz71-5" type="text" name="holder_name" placeholder="<%= t.holder_name_placeholder %>" required>
          <button type="submit" class="btn btn-secondary dz71-12"><%= t.add_card_btn %></button>
        </form>
      </div>
    </div>
  </div>

  <!-- Security Tab -->
  <div id="tab-security" class="sec-content dz71-6">

    <!-- ==================== Email Verification কার্ড ==================== -->
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-envelope-circle-check"></i> <%= t('sec_email_verification') %>
      </h3>
      <p class="dz71-13"><%= t('sec_verify_email_desc') %></p>

      <div class="ix71-18">
        <div class="im72-3">
          <div class="dz71-14"><%= user.email || t('sec_no_email_on_account') %></div>
          <% if (!emailStatus || !emailStatus.hasEmail) { %>
            <div class="dz71-15"><i class="fas fa-circle-minus"></i> <%= t('sec_not_applicable') %></div>
          <% } else if (emailStatus.verified) { %>
            <div class="dz71-16"><i class="fas fa-circle-check"></i> <%= t('sec_verified') %></div>
          <% } else { %>
            <div class="dz71-17"><i class="fas fa-circle-xmark"></i> <%= t('sec_not_verified') %></div>
          <% } %>
        </div>
        <% if (emailStatus && emailStatus.hasEmail && !emailStatus.verified) { %>
          <form method="POST" action="/resend-verification">
            <button type="submit" class="btn btn-primary ix71-19"><%= t('sec_resend') %></button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="ix71-7">
      <h3 class="ix71-8">
        <i class="fas fa-lock"></i> <%= t.change_password_title %>
      </h3>
      <form class="im72-4" action="/profile/change-password" method="POST">
        <div>
          <label class="ix71-9"><%= t.current_password %></label>
          <input class="ix71-15" type="password" name="currentPassword" required>
        </div>
        <div>
          <label class="ix71-9"><%= t.new_password %></label>
          <input class="ix71-15" type="password" name="newPassword" required>
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_password %></label>
          <input class="ix71-15" type="password" name="confirmPassword" required>
        </div>
        <button type="submit" class="btn btn-primary ix71-10"><%= t.change_password_btn %></button>
      </form>
    </div>

    <!-- ==================== Withdraw PIN কার্ড ==================== -->
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-shield-alt"></i> <%= t.withdraw_pin_title %>
      </h3>
      <p class="dz71-13"><%= t.withdraw_pin_subtitle %></p>

      <!-- Status -->
      <div class="ix71-20">
        <div>
          <div class="dz71-14"><%= t.withdraw_pin_status %></div>
          <div style="font-weight:700; font-size: 14px; color: <%= (pinStatus && pinStatus.configured) ? '#10b981' : '#ef4444' %>;">
            <i class="fas <%= (pinStatus && pinStatus.configured) ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i>
            <%= (pinStatus && pinStatus.configured) ? t.pin_configured : t.pin_not_configured %>
          </div>
          <div class="dz71-18">
            <%= t.pin_last_changed %>:
            <%= (pinStatus && pinStatus.updatedAt) ? new Date(pinStatus.updatedAt).toLocaleString('en-US', { year:'numeric', month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }) : t.pin_never_changed %>
          </div>
          <% if (pinStatus && pinStatus.locked) { %>
            <div class="dz71-19">
              <i class="fas fa-lock"></i> <%= t.pin_locked_msg %>
              (<%= Math.max(1, Math.ceil((pinStatus.remainingMs || 0) / 60000)) %> <%= t('sec_min_left') %>)
            </div>
          <% } %>
        </div>
        <i class="fas fa-shield-halved" style="font-size:30px; flex-shrink:0; color: <%= (pinStatus && pinStatus.configured) ? '#10b981' : 'var(--text-muted)' %>;"></i>
      </div>

      <!-- Action Buttons -->
      <div class="im72-6">
        <% if (!(pinStatus && pinStatus.configured)) { %>
          <button type="button" data-pin-form="create" id="pinToggleBtn-create" class="btn btn-primary dz71-20"><%= t.create_pin_btn %></button>
        <% } else { %>
          <button type="button" data-pin-form="change" id="pinToggleBtn-change" class="btn btn-primary dz71-20"><%= t.change_pin_btn %></button>
          <button type="button" data-pin-form="reset" id="pinToggleBtn-reset" class="btn btn-secondary dz71-21"><%= t.reset_pin_btn %></button>
        <% } %>
      </div>

      <p class="dz71-22"><i class="fas fa-circle-info"></i> <%= t.pin_rules_hint %></p>

      <!-- Create PIN Form -->
      <form class="dz71-23" id="pinFormcreate" action="/profile/withdraw-pin/create" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>
          <input class="ix71-21" type="password" name="pin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn ix71-22"><%= t.create_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>

      <!-- Change PIN Form -->
      <form class="dz71-23" id="pinFormchange" action="/profile/withdraw-pin/change" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.current_pin %></label>
          <input class="ix71-21" type="password" name="currentPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>
          <input class="ix71-21" type="password" name="newPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmNewPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn ix71-22"><%= t.change_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>

      <!-- Reset PIN Form (PIN ভুলে গেলে — অ্যাকাউন্ট পাসওয়ার্ড দিয়ে যাচাই) -->
      <form class="dz71-23" id="pinFormreset" action="/profile/withdraw-pin/reset" method="POST" data-pin-submit>
        <div>
          <label class="ix71-9"><%= t.account_password %></label>
          <input class="ix71-15" type="password" name="accountPassword" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.new_pin %></label>
          <input class="ix71-21" type="password" name="newPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div>
          <label class="ix71-9"><%= t.confirm_new_pin %></label>
          <input class="ix71-21" type="password" name="confirmNewPin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
        </div>
        <div class="im72-7">
          <button type="submit" class="btn btn-primary pin-submit-btn dz71-25"><%= t.reset_pin_btn %></button>
          <button class="dz71-24" type="button" data-pin-cancel><%= t.cancel_btn %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Devices Tab -->
  <div id="tab-devices" class="sec-content dz71-6">
    <div class="ix71-7">
      <h3 class="ix71-17">
        <i class="fas fa-mobile-screen-button"></i> <%= t.active_devices_title %>
      </h3>
      <p class="dz71-13"><%= t.active_devices_subtitle %></p>

      <% if (activeSessions && activeSessions.length) { %>
        <% activeSessions.forEach(function(d) { %>
          <div style="background: rgba(255,255,255,0.03); border-radius: 14px; padding: 15px; margin-bottom: 12px; border: 1px solid <%= d.is_current ? 'rgba(16,185,129,0.3)' : 'var(--border-glass)' %>;">
            <div class="im72-8">
              <div class="im72-9">
                <div class="im72-10">
                  <span class="ix71-23"><i class="fas <%= d.device_type === 'Mobile' ? 'fa-mobile-screen' : (d.device_type === 'Tablet' ? 'fa-tablet-screen-button' : 'fa-desktop') %>"></i> <%= d.device_name %></span>
                  <% if (d.is_current) { %><span class="ix71-24"><%= t.current_device_badge %></span><% } %>
                  <% if (d.is_new_device) { %><span class="ix71-25"><%= t.new_device_badge %></span><% } %>
                </div>
                <div class="dz71-18"><%= d.ip %></div>
                <div class="dz71-26"><%= t.device_last_active %>: <%= new Date(d.last_activity).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
              </div>
              <% if (!d.is_current) { %>
                <form method="POST" action="/profile/devices/<%= d.id %>/logout" data-confirm="<%= t.logout_device_confirm %>">
                  <button class="dz71-27" type="submit"><%= t.logout_this_device %></button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz71-28"><%= t.no_active_devices %></div>
      <% } %>

      <% if (activeSessions && activeSessions.filter(function(d){return !d.is_current}).length > 0) { %>
        <form class="dz71-29" method="POST" action="/profile/devices/logout-all-others" data-confirm="<%= t.logout_all_confirm %>">
          <button class="dz71-30" type="submit"><i class="fas fa-right-from-bracket"></i> <%= t.logout_all_other_devices %></button>
        </form>
      <% } %>
    </div>

    <div class="ix71-7">
      <div class="im72-11">
        <h3 class="ix71-26">
          <i class="fas fa-clock-rotate-left"></i> <%= t.recent_login_activity %>
        </h3>
        <a class="ix71-27" href="/profile/login-history"><%= t.view_full_login_history %> <i class="fas fa-chevron-right"></i></a>
      </div>
      <% if (recentLogins && recentLogins.length) { %>
        <% recentLogins.forEach(function(l) { %>
          <div class="ix71-28">
            <div>
              <div class="dz71-31"><%= l.browser %> · <%= l.os %> <% if (l.is_new_device) { %><span class="ix71-29">• <%= t.new_device_badge %></span><% } %></div>
              <div class="dz71-2"><%= l.ip %></div>
            </div>
            <div class="dz71-32"><%= new Date(l.created_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz71-33"><%= t.no_login_history %></div>
      <% } %>
    </div>

    <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
    <div class="ix71-7">
      <h3 class="ix71-30">
        <i class="fas fa-list-check"></i> <%= t('sec_recent_activity') %>
      </h3>
      <% recentActivity.forEach(function(a) {
        let icon = 'fa-circle-info', label = t('sec_activity_generic');
        if (a.kind === 'login') { icon = 'fa-right-to-bracket'; label = t('sec_activity_login'); }
        else if (a.kind === 'deposit') { icon = 'fa-plus-circle'; label = t('sec_activity_deposit'); }
        else if (a.kind === 'withdraw') { icon = 'fa-hand-holding-usd'; label = t('sec_activity_withdraw'); }
        else if (a.kind === 'vip_upgrade') { icon = 'fa-crown'; label = t('sec_activity_vip_upgrade'); }
        else if (a.kind === 'reward_claim') { icon = 'fa-gift'; label = t('sec_activity_reward_claim'); }
      %>
      <div class="ix71-31">
        <span class="ix71-32"><i class="fas <%= icon %>"></i></span>
        <span class="ix71-33"><%= label %><% if (a.amount) { %> — ৳<%= Number(a.amount).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %><% } %></span>
        <span class="ix71-34"><%= new Date(a.created_at).toLocaleDateString(lang === 'bn' ? 'bn-BD' : 'en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

</div>


<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz71-1 { color: var(--text-main); font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
  .dz71-2 { color: var(--text-muted); font-size: 11px; margin-top: 3px; }
  .dz71-3 { flex: 1; padding: 10px; border-radius: 8px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.3s; }
  .dz71-4 { width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px 15px; color: var(--text-muted); font-size: 14px; }
  .dz71-5 { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px 15px; color: var(--text-main); font-size: 14px; outline: none; }
  .dz71-6 { display: none; }
  .dz71-7 { color: var(--text-main); font-size: 14px; font-weight: 600; }
  .dz71-8 { color: var(--text-muted); font-size: 12px; }
  .dz71-9 { background: rgba(239, 68, 68, 0.1); border: none; width: 32px; height: 32px; border-radius: 8px; color: #ef4444; cursor: pointer; }
  .dz71-10 { font-size: 40px; color: var(--text-muted); margin-bottom: 15px; }
  .dz71-11 { color: var(--text-muted); font-size: 13px; }
  .dz71-12 { margin-top: 5px; border-radius: 12px; padding: 14px; font-weight: 800; background: var(--grad-gold); color: #000; }
  .dz71-13 { color: var(--text-muted); font-size: 12px; margin-bottom: 18px; }
  .dz71-14 { color: var(--text-muted); font-size: 12px; margin-bottom: 4px; }
  .dz71-15 { font-weight: 700; font-size: 14px; color: var(--text-muted); }
  .dz71-16 { font-weight: 700; font-size: 14px; color: #10b981; }
  .dz71-17 { font-weight: 700; font-size: 14px; color: #ef4444; }
  .dz71-18 { color: var(--text-muted); font-size: 11px; margin-top: 6px; }
  .dz71-19 { color: #ef4444; font-size: 11px; margin-top: 6px; font-weight: 700; }
  .dz71-20 { flex: 1; min-width: 130px; border-radius: 12px; padding: 12px; font-weight: 800; }
  .dz71-21 { flex: 1; min-width: 130px; border-radius: 12px; padding: 12px; font-weight: 800; background: var(--grad-gold); color: #000; }
  .dz71-22 { color: var(--text-muted); font-size: 11px; margin-bottom: 15px; }

<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold">👥 বন্ধুদের আমন্ত্রণ</h1>
  </div>

  <!-- Referral Card -->
  <div style="background:linear-gradient(135deg,#10b981,#06b6d4);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center">
    <div style="font-size:40px;margin-bottom:8px">🎁</div>
    <div style="color:#fff;font-size:16px;font-weight:bold;margin-bottom:4px">প্রতি রেফারেলে ১০০ কয়েন!</div>
    <div style="color:rgba(255,255,255,0.8);font-size:13px">বন্ধুকে আমন্ত্রণ জানান এবং কয়েন অর্জন করুন</div>
  </div>

  <!-- Referral Code -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px">
    <div style="color:#94a3b8;font-size:13px;margin-bottom:8px">আপনার রেফারেল কোড</div>
    <div style="display:flex;gap:8px;align-items:center">
      <div id="ref-code" style="flex:1;background:rgba(255,255,255,0.1);border-radius:8px;padding:12px;color:#f59e0b;font-size:18px;font-weight:bold;letter-spacing:2px;text-align:center">
        <%= user.referral_code || 'N/A' %>
      </div>
      <button onclick="copyCode()" style="background:#8b5cf6;color:#fff;border:none;border-radius:8px;padding:12px 16px;cursor:pointer;font-size:14px">কপি</button>
    </div>
  </div>

  <!-- Referral Link -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px">
    <div style="color:#94a3b8;font-size:13px;margin-bottom:8px">আপনার রেফারেল লিংক</div>
    <div style="display:flex;gap:8px;align-items:center">
      <div style="flex:1;background:rgba(255,255,255,0.1);border-radius:8px;padding:10px;color:#fff;font-size:12px;word-break:break-all" id="ref-link">
        <%= baseUrl %>/register?ref=<%= user.referral_code %>
      </div>
      <button onclick="shareLink()" style="background:#10b981;color:#fff;border:none;border-radius:8px;padding:12px 16px;cursor:pointer;font-size:14px">শেয়ার</button>
    </div>
  </div>

  <!-- Stats -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px">
    <div style="color:#fff;font-weight:bold;margin-bottom:12px">📊 রেফারেল পরিসংখ্যান</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;text-align:center">
        <div style="color:#f59e0b;font-size:24px;font-weight:bold"><%= referralCount || 0 %></div>
        <div style="color:#94a3b8;font-size:12px;margin-top:4px">মোট রেফারেল</div>
      </div>
      <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;text-align:center">
        <div style="color:#10b981;font-size:24px;font-weight:bold"><%= (referralCount || 0) * 100 %></div>
        <div style="color:#94a3b8;font-size:12px;margin-top:4px">অর্জিত কয়েন</div>
      </div>
    </div>
  </div>
</div>

<script>
function copyCode() {
  const code = '<%= user.referral_code %>';
  navigator.clipboard.writeText(code).then(() => {
    alert('কোড কপি হয়েছে!');
  });
}

function shareLink() {
  const link = '<%= baseUrl %>/register?ref=<%= user.referral_code %>';
  if (navigator.share) {
    navigator.share({ title: '<%= siteName %> তে যোগ দিন!', url: link });
  } else {
    navigator.clipboard.writeText(link).then(() => {
      alert('লিংক কপি হয়েছে!');
    });
  }
}
</script>
<%- include('../partials/navbar') %>

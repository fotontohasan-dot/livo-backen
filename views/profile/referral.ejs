<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz76-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz76-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz76-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz76-4 { background: linear-gradient(135deg,#10b981,#06b6d4); border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: center; }
  .dz76-5 { color: var(--text-main); font-size: 16px; font-weight: bold; margin-bottom: 4px; }
  .dz76-6 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz76-7 { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 14px; text-align: center; }
  .dz76-8 { color: #f59e0b; font-size: 22px; font-weight: bold; }
  .dz76-9 { color: var(--text-muted); font-size: 11px; margin-top: 4px; }
  .dz76-10 { color: #10b981; font-size: 22px; font-weight: bold; }
  .dz76-11 { color: var(--text-accent); font-size: 22px; font-weight: bold; }
  .dz76-12 { background: rgba(245,158,11,0.1); border: 1px solid #f59e0b; border-radius: 12px; padding: 14px; margin-bottom: 16px; text-align: center; }
  .dz76-13 { color: var(--text-main); font-size: 13px; }
  .dz76-14 { color: #f59e0b; font-size: 24px; font-weight: bold; margin-top: 4px; }
  .dz76-15 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 14px; }
  .dz76-16 { color: var(--text-muted); font-size: 13px; margin-bottom: 8px; }
  .dz76-17 { flex: 1; background: rgba(255,255,255,0.1); border-radius: 8px; padding: 12px; color: #f59e0b; font-size: 18px; font-weight: bold; letter-spacing: 2px; text-align: center; }
  .dz76-18 { background: var(--grad-primary); color: #fff; border: none; border-radius: 8px; padding: 12px 16px; cursor: pointer; }
  .dz76-19 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .dz76-20 { flex: 1; background: rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; color: var(--text-main); font-size: 12px; word-break: break-all; }
  .dz76-21 { background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 12px 16px; cursor: pointer; }
  .dz76-22 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz76-23 { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz76-24 { color: var(--text-muted); font-size: 10px; }
  .dz76-25 { color: #10b981; font-size: 11px; }
  .dz76-26 { color: #f59e0b; font-size: 11px; }
  .dz76-27 { color: var(--text-muted); font-size: 11px; }
  .dz76-28 { color: var(--text-muted); font-size: 13px; text-align: center; padding: 10px; }
  .dz76-29 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz76-30 { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz76-31 { color: var(--text-main); font-size: 12px; }
  .dz76-32 { color: #10b981; font-size: 14px; font-weight: bold; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im77-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im77-2 { font-size: 40px; margin-bottom: 8px; }
  .im77-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px; }
  .im77-4 { display: flex; gap: 8px; align-items: center; }
  /* রেফারেল নিয়ম সেকশন */
  .rf-card { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .rf-title { color: var(--text-main); font-weight: bold; font-size: 15px; margin-bottom: 12px; }
  .rf-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
  .rf-table th { color: var(--text-muted); font-size: 11px; font-weight: normal; text-align: left; padding: 6px 4px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .rf-table td { color: var(--text-main); font-size: 13px; padding: 10px 4px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .rf-table td.rf-amt { color: #10b981; font-weight: bold; text-align: right; }
  .rf-table th.rf-amt { text-align: right; }
  .rf-rate { color: #f59e0b; font-size: 26px; font-weight: bold; text-align: center; }
  .rf-note { color: var(--text-muted); font-size: 12px; line-height: 1.6; margin-top: 8px; }
  .rf-list { color: var(--text-main); font-size: 12px; line-height: 1.7; margin: 8px 0 0; padding-left: 18px; }
  .rf-ex { background: rgba(245,158,11,0.1); border: 1px dashed #f59e0b; border-radius: 10px; padding: 10px; color: var(--text-main); font-size: 12px; line-height: 1.6; margin-top: 10px; }
</style>

<%- include('../partials/navbar') %>
<% const numLoc = locals.lang === 'en' ? 'en-US' : 'bn-BD'; const fmtN = (n) => Number(n).toLocaleString(numLoc); const ns = stats.nextStep || null; const refLink = share ? share.link : null; %>
<div class="container dz76-1">
  <%- include('../partials/flash') %>

  <div class="im77-1">
    <a class="dz76-2" href="/profile">←</a>
    <h1 class="dz76-3"><%= t.invite_friends_title %></h1>
  </div>

  <!-- ব্যানার: একটাই সরল বাক্য -->
  <div class="dz76-4">
    <div class="im77-2">🎁</div>
    <div class="dz76-5"><%= t.refer_and_earn %></div>
    <div class="dz76-6"><%= t('ref_tagline') %></div>
  </div>

  <!-- ফানেল: ক্লিক → সাইন-আপ → ডিপোজিট -->
  <div class="im77-3" id="ref-funnel">
    <div class="dz76-7">
      <div class="dz76-8" id="ref-funnel-clicks"><%= fmtN(funnel.clicks) %></div>
      <div class="dz76-9"><%= t('ref_funnel_clicks') %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-10" id="ref-funnel-signups"><%= fmtN(funnel.signups) %></div>
      <div class="dz76-9"><%= t('ref_funnel_signups') %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-11" id="ref-funnel-deposits"><%= fmtN(funnel.deposits) %></div>
      <div class="dz76-9"><%= t('ref_funnel_deposits') %></div>
    </div>
  </div>

  <!-- পরিসংখ্যান -->
  <div class="rf1-grid4">
    <div class="dz76-7">
      <div class="dz76-8" id="ref-total"><%= fmtN(stats.totalReferrals) %></div>
      <div class="dz76-9"><%= t.total_referrals %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-10" id="ref-success"><%= fmtN(stats.successfulReferrals) %></div>
      <div class="dz76-9"><%= t.successful_referrals %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-8" id="ref-pending"><%= fmtN(stats.pendingReferrals || 0) %></div>
      <div class="dz76-9"><%= t('ref_pending_label') %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-11" id="ref-earnings"><%= fmtN(stats.totalEarnings) %></div>
      <div class="dz76-9"><%= t.total_earnings %></div>
    </div>
  </div>

  <!-- পরের ধাপ -->
  <% if (ns) { %>
  <div class="dz76-12" id="ref-next-step" data-state="<%= ns.state %>">
    <div class="dz76-13"><%= t('ref_next_title') %></div>
    <div class="dz76-9">
      <% if (ns.state === 'max') { %>
        <%= t('ref_next_max').replace('{bonus}', fmtN(ns.bonus)) %>
      <% } else if (ns.state === 'up') { %>
        <%= t('ref_next_up').replace('{need}', fmtN(ns.needDeposit)).replace('{bonus}', fmtN(ns.bonus)) %>
      <% } else { %>
        <%= t('ref_next_first').replace('{need}', fmtN(ns.needDeposit)).replace('{bonus}', fmtN(ns.bonus)) %>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- পরের বোনাস তথ্য -->
  <div class="dz76-12">
    <div class="dz76-13"><%= t.next_referral_reward %></div>
    <div class="dz76-14">বন্ধুর ডিপোজিট অনুযায়ী ৳<%= ((stats.bonusBands || [])[0] || {amount:0}).amount %> – ৳<%= ((stats.bonusBands || []).slice(-1)[0] || {amount:0}).amount %></div>
    <div class="dz76-9"><%= t.referral_condition %></div>
    <div class="dz76-9"><%= t('ref_first_deposit_info') %></div>
  </div>

  <!-- রেফারেল নিয়ম -->
  <div class="rf-card">
    <div class="rf-title">🎁 প্রথম ডিপোজিট রেফার বোনাস</div>
    <table class="rf-table">
      <thead><tr><th>বন্ধুর প্রথম ডিপোজিট</th><th class="rf-amt">আপনার বোনাস</th></tr></thead>
      <tbody>
        <% (stats.bonusBands || []).forEach(function (band, i, arr) { var next = arr[i + 1]; %>
        <tr>
          <td>৳<%= band.min.toLocaleString('bn-BD') %><%= next ? ' – ৳' + (next.min - 1).toLocaleString('bn-BD') : ' বা তার বেশি' %></td>
          <td class="rf-amt">৳<%= band.amount.toLocaleString('bn-BD') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="rf-note">রেফার করা বন্ধু অ্যাকাউন্ট খুলে প্রথমবার ডিপোজিট করলে বোনাস পাবেন। সাইন-আপ করলেই বোনাস হয় না।</div>
  </div>

  <div class="rf-card">
    <div class="rf-title">💸 ডিপোজিট হারের কমিশন</div>
    <div class="rf-rate"><%= Number(stats.lossCommissionPercent).toLocaleString('bn-BD') %>%</div>
    <div class="rf-note">বন্ধু যে টাকা ডিপোজিট করেছে তা সম্পূর্ণ হেরে গেলে, সেই ডিপোজিটের ০.৮% আপনি কমিশন পাবেন।</div>
    <ul class="rf-list">
      <li>প্রতিটি আলাদা বাজির হার-জিতের হিসাব হয় না।</li>
      <li>মাঝখানে বন্ধু কত জিতেছে বা কত টাকা বানিয়েছে, তা ধরা হয় না।</li>
      <li>শুধু ডিপোজিট করা টাকা শেষ পর্যন্ত পুরোপুরি হারলে কমিশন হয়।</li>
      <li>বন্ধু জিতলে বা শুধু বাজি ধরলে কোনো কমিশন নেই।</li>
    </ul>
    <div class="rf-ex">উদাহরণ: বন্ধু ৳৫০০ ডিপোজিট করে শেষ পর্যন্ত সবটাই হারালে আপনি পাবেন ৳৫০০ × ০.৮% = ৳৪। মাঝে সে ৳২০,০০০ জিতে পরে সব হারালেও হিসাব একই।</div>
  </div>

  <!-- রেফারেল কোড -->
  <div class="dz76-15">
    <div class="dz76-16"><%= t.your_referral_code %></div>
    <div class="im77-4">
      <div class="dz76-17" id="ref-code">
        <%= user.referral_code || 'N/A' %>
      </div>
      <button class="dz76-18" data-referral-action="copy"><%= t.copy_short %></button>
    </div>
  </div>

  <!-- রেফারেল লিংক -->
  <div class="dz76-19">
    <div class="dz76-16"><%= t.your_referral_link %></div>
    <div class="im77-4">
      <div class="dz76-20" id="ref-link"><%= refLink || 'N/A' %></div>
      <button class="dz76-18" data-referral-action="copy"><%= t.copy_short %></button>
    </div>
    <% if (share) { %>
    <div class="dz76-9"><%= t('ref_share_via') %></div>
    <div class="rf1-share">
      <a class="rf1-sbtn" id="ref-share-whatsapp" href="<%= share.whatsapp %>" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="rf1-sbtn" id="ref-share-telegram" href="<%= share.telegram %>" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="rf1-sbtn" id="ref-share-facebook" href="<%= share.facebook %>" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a class="rf1-sbtn" id="ref-share-messenger" href="<%= share.messenger %>" rel="noopener noreferrer">Messenger</a>
    </div>
    <button class="dz76-21" data-referral-action="share"><%= t.share %></button>
    <% } %>
  </div>

  <!-- আমার টিম -->
  <div class="dz76-19">
    <div class="dz76-22"><%= t.my_team %></div>
    <% if (stats.team && stats.team.length > 0) { %>
      <% stats.team.forEach(member => { %>
        <div class="dz76-23">
          <div>
            <div class="dz76-13"><%= member.username %></div>
            <div class="dz76-24"><%= new Date(member.created_at).toLocaleDateString(numLoc) %></div>
          </div>
          <div>
            <% if (member.signup_bonus_paid && !member.bonus_held) { %>
              <span class="dz76-25"><%= t('ref_status_bonus_received') %></span>
            <% } else { %>
              <span class="dz76-27"><%= t('ref_status_pending') %></span>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="dz76-28"><%= t.no_referrals_yet %></div>
    <% } %>
  </div>

  <!-- আয়ের হিস্ট্রি -->
  <div class="dz76-29">
    <div class="dz76-22"><%= t.earnings_history %></div>
    <% if (stats.history && stats.history.length > 0) { %>
      <% stats.history.forEach(h => { %>
        <div class="dz76-30">
          <div>
            <div class="dz76-31">
              <%= (h.reason === 'signup' || h.reason === 'first_deposit') ? '🎁 ' + t('ref_signup_bonus') : (h.reason === 'loss_commission' ? '💸 ডিপোজিট-হার কমিশন' : '💸 ' + t('ref_commission').replace('{level}', h.level)) %>
            </div>
            <div class="dz76-24">
              <%= h.from_username || t('ref_user') %> · <%= new Date(h.created_at).toLocaleDateString(numLoc) %>
            </div>
          </div>
          <div class="dz76-32">+<%= fmtN(h.amount) %></div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="dz76-28"><%= t.no_earnings_yet %></div>
    <% } %>
  </div>
</div>

<script type="application/json" id="profile-referralConfig"><%- jsonScriptSafe({ referralCode: user.referral_code, baseUrl: baseUrl, link: refLink }) %></script>
<script src="/js/views/profile-referral.js"></script>
</body></html>

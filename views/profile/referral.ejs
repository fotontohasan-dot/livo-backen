<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz76-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz76-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz76-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz76-4 { background: linear-gradient(135deg,#10b981,#06b6d4); border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: center; }
  .dz76-5 { color: var(--text-main); font-size: 16px; font-weight: bold; margin-bottom: 4px; }
  .dz76-6 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz76-7 { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 14px; text-align: center; }
  .dz76-8 { color: #f59e0b; font-size: 22px; font-weight: bold; }
  .dz76-9 { color: var(--text-muted); font-size: 11px; margin-top: 4px; }
  .dz76-10 { color: #10b981; font-size: 22px; font-weight: bold; }
  .dz76-11 { color: var(--text-accent); font-size: 22px; font-weight: bold; }
  .dz76-12 { background: rgba(245,158,11,0.1); border: 1px solid #f59e0b; border-radius: 12px; padding: 14px; margin-bottom: 16px; text-align: center; }
  .dz76-13 { color: var(--text-main); font-size: 13px; }
  .dz76-14 { color: #f59e0b; font-size: 24px; font-weight: bold; margin-top: 4px; }
  .dz76-15 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 14px; }
  .dz76-16 { color: var(--text-muted); font-size: 13px; margin-bottom: 8px; }
  .dz76-17 { flex: 1; background: rgba(255,255,255,0.1); border-radius: 8px; padding: 12px; color: #f59e0b; font-size: 18px; font-weight: bold; letter-spacing: 2px; text-align: center; }
  .dz76-18 { background: var(--grad-primary); color: #fff; border: none; border-radius: 8px; padding: 12px 16px; cursor: pointer; }
  .dz76-19 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .dz76-20 { flex: 1; background: rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; color: var(--text-main); font-size: 12px; word-break: break-all; }
  .dz76-21 { background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 12px 16px; cursor: pointer; }
  .dz76-22 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz76-23 { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz76-24 { color: var(--text-muted); font-size: 10px; }
  .dz76-25 { color: #10b981; font-size: 11px; }
  .dz76-26 { color: #f59e0b; font-size: 11px; }
  .dz76-27 { color: var(--text-muted); font-size: 11px; }
  .dz76-28 { color: var(--text-muted); font-size: 13px; text-align: center; padding: 10px; }
  .dz76-29 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz76-30 { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz76-31 { color: var(--text-main); font-size: 12px; }
  .dz76-32 { color: #10b981; font-size: 14px; font-weight: bold; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im77-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im77-2 { font-size: 40px; margin-bottom: 8px; }
  .im77-3 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
  .rf-pending { color: #f59e0b; font-size: 22px; font-weight: bold; }
  .rf-sentence { color: var(--text-main); font-size: 13px; line-height: 1.5; margin-bottom: 8px; }
  .rf-funnel { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .rf-step { flex: 1; text-align: center; background: rgba(255,255,255,0.05); border-radius: 12px; padding: 12px 6px; }
  .rf-arrow { color: var(--text-muted); font-size: 16px; }
  .rf-share-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
  .rf-share-btn { display: block; text-align: center; text-decoration: none; color: #fff; border-radius: 8px; padding: 10px 6px; font-size: 13px; font-weight: bold; }
  .rf-wa { background: #25d366; }
  .rf-tg { background: #229ed9; }
  .rf-fb { background: #1877f2; }
  .rf-ms { background: #a334fa; }
  .rf-copy { background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 12px 16px; cursor: pointer; }
  .im77-4 { display: flex; gap: 8px; align-items: center; }
</style>

<%- include('../partials/navbar') %>
<% const numLoc = locals.lang === 'en' ? 'en-US' : 'bn-BD'; const fmtN = (n) => Number(n).toLocaleString(numLoc); const fx = stats.funnel || { clicks: 0, signups: 0, deposits: 0 }; %>
<div class="container dz76-1">
  <%- include('../partials/flash') %>

  <div class="im77-1">
    <a class="dz76-2" href="/profile">←</a>
    <h1 class="dz76-3"><%= t.invite_friends_title %></h1>
  </div>

  <!-- ব্যানার -->
  <div class="dz76-4">
    <div class="im77-2">🎁</div>
    <div class="dz76-5"><%= t.refer_and_earn %></div>
    <div class="dz76-6">
      <%= t('ref_tagline') %>
    </div>
  </div>

  <!-- পরিসংখ্যান -->
  <div class="im77-3">
    <div class="dz76-7">
      <div class="dz76-8"><%= fmtN(stats.totalReferrals) %></div>
      <div class="dz76-9"><%= t.total_referrals %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-10"><%= fmtN(stats.successfulReferrals) %></div>
      <div class="dz76-9"><%= t.successful_referrals %></div>
    </div>
    <div class="dz76-7">
      <div class="rf-pending"><%= fmtN(stats.pendingReferrals || 0) %></div>
      <div class="dz76-9"><%= t('ref_pending_label') %></div>
    </div>
    <div class="dz76-7">
      <div class="dz76-11"><%= fmtN(stats.totalEarnings) %></div>
      <div class="dz76-9"><%= t.total_earnings %></div>
    </div>
  </div>

  <!-- বোনাস তথ্য: ধাপ-ছক (slab) বা পুরোনো ক্রমিক টিয়ার -->
  <% const prog = stats.program || null; %>
  <div class="dz76-12">
    <% if (prog && prog.mode === 'slab') { %>
      <div class="dz76-13"><%= t('ref_slab_title') %></div>
      <% prog.slabs.forEach(sl => { %>
        <div class="dz76-23">
          <div class="dz76-9"><%= sl.max === null ? t('ref_slab_plus').replace('{from}', fmtN(sl.min)) : t('ref_slab_range').replace('{from}', fmtN(sl.min)).replace('{to}', fmtN(sl.max)) %></div>
          <div class="dz76-14"><%= fmtN(sl.amount) %> <%= t('ref_taka') %></div>
        </div>
      <% }) %>
      <div class="dz76-9"><%= t('ref_condition_min').replace('{min}', fmtN(prog.minDeposit)) %></div>
      <div class="dz76-9"><%= t('ref_turnover_note').replace('{s}', fmtN(prog.turnover.sports)).replace('{c}', fmtN(prog.turnover.casino)) %></div>
    <% } else { %>
      <div class="dz76-13"><%= t.next_referral_reward %></div>
      <div class="dz76-14"><%= stats.nextBonus === null || stats.nextBonus === undefined ? '' : fmtN(stats.nextBonus) + ' ' + t('ref_taka') %></div>
      <% if (prog) { %>
        <div class="dz76-9"><%= t('ref_condition_min').replace('{min}', fmtN(prog.minDeposit)) %></div>
        <div class="dz76-9"><%= t('ref_turnover_note').replace('{s}', fmtN(prog.turnover.sports)).replace('{c}', fmtN(prog.turnover.casino)) %></div>
      <% } %>
    <% } %>
    <div class="dz76-9"><%= t('ref_first_deposit_info') %></div>
    <div class="dz76-9"><%= t('ref_friend_note') %></div>
  </div>

  <!-- পরের ধাপ -->
  <% const ns = stats.nextStep || null; %>
  <% if (ns) { %>
  <div class="dz76-19">
    <div class="dz76-22"><%= t('ref_next_step_title') %></div>
    <% if (ns.kind === 'first') { %>
      <div class="rf-sentence"><%= t('ref_next_first').replace('{min}', fmtN(ns.min)).replace('{amount}', fmtN(ns.amount)) %></div>
    <% } else if (ns.kind === 'up') { %>
      <div class="rf-sentence"><%= t('ref_next_up').replace('{dep}', fmtN(ns.deposit)).replace('{delta}', fmtN(ns.delta)).replace('{min}', fmtN(ns.min)).replace('{amount}', fmtN(ns.amount)) %></div>
    <% } else { %>
      <div class="rf-sentence"><%= t('ref_next_top') %></div>
    <% } %>
  </div>
  <% } %>

  <!-- কমিশন (সরল বাক্য) -->
  <% const cp = stats.commissionPercents || [2.5, 1.5, 0.8]; %>
  <div class="dz76-19">
    <div class="rf-sentence"><%= t('ref_commission_simple').replace('{r1}', cp[0]).replace('{r2}', cp[1]).replace('{r3}', cp[2]) %></div>
  </div>

  <!-- ক্লিক → সাইন-আপ → ডিপোজিট -->
  <div class="dz76-19">
    <div class="dz76-22"><%= t('ref_funnel_title') %></div>
    <div class="rf-funnel">
      <div class="rf-step"><div class="dz76-8"><%= fmtN(fx.clicks) %></div><div class="dz76-9"><%= t('ref_funnel_clicks') %></div></div>
      <div class="rf-arrow">→</div>
      <div class="rf-step"><div class="dz76-8"><%= fmtN(fx.signups) %></div><div class="dz76-9"><%= t('ref_funnel_signups') %></div></div>
      <div class="rf-arrow">→</div>
      <div class="rf-step"><div class="dz76-10"><%= fmtN(fx.deposits) %></div><div class="dz76-9"><%= t('ref_funnel_deposits') %></div></div>
    </div>
  </div>

  <!-- রেফারেল কোড -->
  <div class="dz76-15">
    <div class="dz76-16"><%= t.your_referral_code %></div>
    <div class="im77-4">
      <div class="dz76-17" id="ref-code">
        <%= referralCode || 'N/A' %>
      </div>
      <button class="dz76-18" data-referral-action="copy"><%= t.copy_short %></button>
    </div>
  </div>

  <!-- রেফারেল লিংক -->
  <div class="dz76-19">
    <div class="dz76-16"><%= t.your_referral_link %></div>
    <div class="im77-4">
      <div class="dz76-20" id="ref-link"><%= refLink %></div>
      <button class="rf-copy" data-referral-action="copy-link"><%= t.copy_short %></button>
    </div>
    <% if (shareLinks) { %>
    <div class="rf-share-row">
      <a class="rf-share-btn rf-wa" href="<%= shareLinks.whatsapp %>" target="_blank" rel="noopener noreferrer"><%= t('ref_share_whatsapp') %></a>
      <a class="rf-share-btn rf-tg" href="<%= shareLinks.telegram %>" target="_blank" rel="noopener noreferrer"><%= t('ref_share_telegram') %></a>
      <a class="rf-share-btn rf-fb" href="<%= shareLinks.facebook %>" target="_blank" rel="noopener noreferrer"><%= t('ref_share_facebook') %></a>
      <a class="rf-share-btn rf-ms" href="<%= shareLinks.messenger %>" rel="noopener noreferrer"><%= t('ref_share_messenger') %></a>
    </div>
    <% } %>
    <div class="im77-4 rf-share-row">
      <button class="dz76-21" data-referral-action="share"><%= t.share %></button>
    </div>
  </div>

  <!-- আমার টিম -->
  <div class="dz76-19">
    <div class="dz76-22"><%= t.my_team %></div>
    <% if (stats.team && stats.team.length > 0) { %>
      <% stats.team.forEach(member => { %>
        <div class="dz76-23">
          <div>
            <div class="dz76-13"><%= member.username %></div>
            <div class="dz76-24"><%= new Date(member.created_at).toLocaleDateString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
          </div>
          <div>
            <% if (member.signup_bonus_paid) { %>
              <span class="dz76-25"><%= t('ref_status_bonus_received') %></span>
            <% } else { %>
              <span class="dz76-27"><%= t('ref_status_pending') %></span>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="dz76-28"><%= t.no_referrals_yet %></div>
    <% } %>
  </div>

  <!-- আয়ের হিস্ট্রি -->
  <div class="dz76-29">
    <div class="dz76-22"><%= t.earnings_history %></div>
    <% if (stats.history && stats.history.length > 0) { %>
      <% stats.history.forEach(h => { %>
        <div class="dz76-30">
          <div>
            <div class="dz76-31">
              <%= (h.reason === 'signup' || h.reason === 'first_deposit') ? '🎁 ' + t('ref_signup_bonus') : '💸 ' + t('ref_commission').replace('{level}', h.level) %>
            </div>
            <div class="dz76-24">
              <%= h.from_username || t('ref_user') %> · <%= new Date(h.created_at).toLocaleDateString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %>
            </div>
          </div>
          <div class="dz76-32">+<%= fmtN(h.amount) %></div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="dz76-28"><%= t.no_earnings_yet %></div>
    <% } %>
  </div>
</div>

<script type="application/json" id="profile-referralConfig"><%- jsonScriptSafe({ referralCode: referralCode, baseUrl: baseUrl, refLink: refLink, msgCodeCopied: t('ref_msg_code_copied'), msgLinkCopied: t('ref_msg_link_copied'), shareTitle: t('ref_share_title'), shareText: t('ref_share_message') }) %></script>
<script src="/js/views/profile-referral.js"></script>
</body></html>

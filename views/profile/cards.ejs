<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold">💳 আমার কার্ড</h1>
  </div>

  <% if (cards && cards.length > 0) { %>
    <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px">
      <% cards.forEach(c => { %>
        <div style="background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:16px;padding:20px;border:1px solid rgba(245,158,11,0.3)">
          <div style="color:var(--gold);font-size:13px;margin-bottom:6px"><%= c.bank_name %></div>
          <div style="color:#fff;font-size:18px;font-weight:bold;letter-spacing:2px;margin-bottom:6px"><%= c.account_number %></div>
          <div style="color:var(--text-muted);font-size:13px"><%= c.holder_name %></div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div style="text-align:center;padding:40px;color:var(--text-muted)">
      <div style="font-size:48px;margin-bottom:12px">💳</div>
      <div>কোনো কার্ড যোগ করা হয়নি</div>
    </div>
  <% } %>

  <div style="background:var(--bg-card);border-radius:16px;padding:20px;border:1px solid var(--border-glass)">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:16px">নতুন কার্ড যোগ করুন</div>
    <form action="/profile/cards/add" method="POST" style="display:flex;flex-direction:column;gap:12px">
      <div>
        <label style="color:var(--text-muted);font-size:13px;display:block;margin-bottom:6px">ব্যাংক/মাধ্যমের নাম</label>
        <input type="text" name="bank_name" required placeholder="যেমন: বিকাশ, নগদ, ব্যাংক"
          style="width:100%;background:rgba(255,255,255,0.08);border:1px solid var(--border-glass);border-radius:8px;padding:10px 14px;color:var(--text-main);font-size:16px;outline:none">
      </div>
      <div>
        <label style="color:var(--text-muted);font-size:13px;display:block;margin-bottom:6px">অ্যাকাউন্ট/নাম্বার</label>
        <input type="text" name="account_number" required
          style="width:100%;background:rgba(255,255,255,0.08);border:1px solid var(--border-glass);border-radius:8px;padding:10px 14px;color:var(--text-main);font-size:16px;outline:none">
      </div>
      <div>
        <label style="color:var(--text-muted);font-size:13px;display:block;margin-bottom:6px">হোল্ডার নাম</label>
        <input type="text" name="holder_name" required
          style="width:100%;background:rgba(255,255,255,0.08);border:1px solid var(--border-glass);border-radius:8px;padding:10px 14px;color:var(--text-main);font-size:16px;outline:none">
      </div>
      <button type="submit" style="background:var(--grad-gold);color:#000;border:none;border-radius:8px;padding:12px;font-size:16px;font-weight:bold;cursor:pointer">
        কার্ড যোগ করুন
      </button>
    </form>
  </div>
</div>
<%- include('../partials/navbar') %>

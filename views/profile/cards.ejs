<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body { background-color: var(--bg-dark) !important; color: var(--text-main) !important; font-family: 'Hind Siliguri', sans-serif; }
  .cd-wrap { max-width: 480px; margin: 0 auto; padding-bottom: 110px; }
  .cd-topbar { background: #000; color: #fff; padding: 14px 16px; display: flex; align-items: center; gap: 14px; position: sticky; top: 0; z-index: 50; }
  .cd-topbar a { color: #fff; text-decoration: none; }
  .cd-topbar h1 { font-size: 16px; font-weight: 700; margin: 0; }

  .cd-section { padding: 18px 16px 0; }
  .cd-count { font-size: 13px; font-weight: 600; margin-bottom: 14px; }
  .cd-count b { color: #e61e26; }

  .cd-item { background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 18px; padding: 16px; display: flex; align-items: center; gap: 14px; margin-bottom: 12px; position: relative; overflow: hidden; }
  .cd-item .ic { width: 48px; height: 48px; border-radius: 14px; background: rgba(230,30,38,0.12); color: #e61e26; display: flex; align-items: center; justify-content: center; font-size: 20px; }
  .cd-item h3 { font-size: 16px; margin: 0 0 2px; }
  .cd-item p { color: var(--text-muted); font-family: monospace; font-size: 13px; margin: 0; letter-spacing: 1px; }
  .cd-item .del { color: #e61e26; background: none; border: none; font-size: 18px; margin-left: auto; }

  .cd-empty { text-align: center; padding: 40px 20px; color: var(--text-muted); }
  .cd-empty .icon-circle { width: 110px; height: 110px; border-radius: 50%; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
  .cd-empty h3 { color: var(--text-main); font-size: 18px; margin-bottom: 6px; }
  .cd-load-error { text-align: center; padding: 40px; color: #f87171; }
  .cd-load-error-icon { font-size: 48px; margin-bottom: 12px; }

  .fab-container { position: fixed; bottom: 100px; left: 0; right: 0; display: flex; justify-content: center; z-index: 50; pointer-events: none; }
  .fab-btn { width: 58px; height: 58px; border-radius: 50%; background: #e61e26; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; border: none; box-shadow: 0 8px 22px rgba(230,30,38,0.4); pointer-events: auto; }

  .overlay { opacity: 0; visibility: hidden; transition: all 0.3s ease; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; }
  .overlay.active { opacity: 1; visibility: visible; }
  .bottom-sheet { transform: translateY(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); position: fixed; bottom: 0; left: 0; right: 0; max-width: 480px; margin: 0 auto; background: var(--bg-surface); border-radius: 28px 28px 0 0; z-index: 101; border-top: 1px solid var(--border-glass); }
  .bottom-sheet.active { transform: translateY(0); }
  .sheet-inner { padding: 26px; }
  .sheet-handle { width: 44px; height: 5px; background: var(--border-glass); border-radius: 10px; margin: 0 auto 20px; }
  .sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .sheet-head h2 { font-size: 20px; margin: 0; }
  .sheet-head p { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin: 2px 0 0; }
  .sheet-head button { width: 38px; height: 38px; border-radius: 50%; border: none; background: var(--bg-dark); color: var(--text-muted); }

  .kind-toggle { display: flex; gap: 8px; margin-bottom: 18px; }
  .kind-btn { flex: 1; text-align: center; padding: 10px; border-radius: 12px; border: 2px solid var(--border-glass); font-weight: 700; cursor: pointer; color: var(--text-muted); }
  .kind-btn.active { border-color: #e61e26; color: #e61e26; }

  .sheet-field { margin-bottom: 16px; }
  .sheet-field label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }
  .sheet-field select, .sheet-field input { width: 100%; padding: 14px; border-radius: 16px; border: 2px solid var(--border-glass); background: var(--bg-dark); color: var(--text-main); font-weight: 700; }
  .sheet-field select:focus, .sheet-field input:focus { outline: none; border-color: #e61e26; }
  .sheet-submit { width: 100%; padding: 15px; border: none; border-radius: 16px; background: #e61e26; color: #fff; font-weight: 800; font-size: 16px; }
</style>

<div class="cd-wrap">
  <div class="cd-topbar">
    <a href="/profile"><i class="fas fa-chevron-left"></i></a>
    <h1><%= t.cw_title %></h1>
  </div>

  <%- include('../partials/flash') %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <%# লোড ব্যর্থ হলে গণনা বা "খালি" — কোনোটাই দেখানো যাবে না, দুটোই এমন দাবি
        যা আমরা জানি না। EJS মন্তব্য ইচ্ছাকৃত: HTML মন্তব্য আউটপুটে থেকে যেত। %>
    <div class="cd-section">
      <div id="cardsLoadError" role="alert" class="cd-load-error">
        <div class="cd-load-error-icon">⚠️</div>
        <div><%= t.common_cards_load_failed %></div>
      </div>
    </div>
  <% } else { %>
  <div class="cd-section">
    <div class="cd-count"><%= t.cw_ewallet_count %> <b><%= cards ? cards.length : 0 %></b></div>
    <% if (cards && cards.length > 0) { %>
      <% cards.forEach(function(c){ %>
        <div class="cd-item">
          <div class="ic"><i class="fas fa-wallet"></i></div>
          <div><h3><%= c.bank_name %></h3><p><%= c.account_number %></p></div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="cd-empty">
        <div class="icon-circle"><i class="fas fa-wallet" style="font-size:36px; opacity:0.25;"></i></div>
        <h3><%= t.cw_empty_ewallet %></h3>
      </div>
    <% } %>
  </div>

  <div class="cd-section">
    <div class="cd-count"><%= t.cw_crypto_count %> <b><%= cryptoCards ? cryptoCards.length : 0 %></b></div>
    <% if (cryptoCards && cryptoCards.length > 0) { %>
      <% cryptoCards.forEach(function(c){ %>
        <div class="cd-item">
          <div class="ic"><i class="fab fa-bitcoin"></i></div>
          <div><h3><%= c.bank_name %></h3><p><%= c.account_number %></p></div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="cd-empty">
        <div class="icon-circle"><i class="fab fa-bitcoin" style="font-size:36px; opacity:0.25;"></i></div>
        <h3><%= t.cw_empty_wallets %></h3>
      </div>
    <% } %>
  </div>
  <% } %>
</div>

<div class="fab-container">
  <button id="fabAddBtn" class="fab-btn"><i class="fas fa-plus"></i></button>
</div>

<div id="modalOverlay" class="overlay"></div>
<div id="bottomSheet" class="bottom-sheet">
  <div class="sheet-inner">
    <div class="sheet-handle"></div>
    <div class="sheet-head">
      <div><h2><%= t.cw_add_new %></h2><p>Add New Wallet</p></div>
      <button id="closeSheetBtn"><i class="fas fa-times"></i></button>
    </div>

    <form action="/profile/cards/add" method="POST">
      <div class="kind-toggle">
        <div class="kind-btn active" id="kindEwallet"><%= t.cw_ewallet %></div>
        <div class="kind-btn" id="kindCrypto"><%= t.cw_crypto %></div>
      </div>
      <input type="hidden" name="wallet_kind" id="walletKindInput" value="ewallet">

      <div class="sheet-field" id="ewalletTypeField">
        <label><%= t.cw_wallet_type %></label>
        <select name="bank_name" required>
          <option value="" disabled selected><%= t.cw_select_ewallet %></option>
          <option value="bKash">bKash</option>
          <option value="Nagad">Nagad</option>
          <option value="Rocket">Rocket</option>
          <option value="Upay">Upay</option>
          <option value="Bank Account">Bank Account</option>
        </select>
      </div>

      <div class="sheet-field">
        <label><%= t.cw_account_label %></label>
        <input type="text" name="account_number" placeholder="<%= t.cw_account_placeholder %>" required>
      </div>

      <div class="sheet-field">
        <label><%= t.cw_password_label %></label>
        <input type="password" name="holder_name" placeholder="<%= t.cw_password_placeholder %>" required>
      </div>

      <button type="submit" class="sheet-submit"><%= t.cw_confirm_wallet %></button>
    </form>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function toggleModal(show) {
    var modal = document.getElementById('bottomSheet');
    var overlay = document.getElementById('modalOverlay');
    if (!modal || !overlay) return;
    modal.classList.toggle('active', show);
    overlay.classList.toggle('active', show);
    document.body.style.overflow = show ? 'hidden' : '';
  }
  function setKind(kind) {
    document.getElementById('walletKindInput').value = kind;
    document.getElementById('kindEwallet').classList.toggle('active', kind === 'ewallet');
    document.getElementById('kindCrypto').classList.toggle('active', kind === 'crypto');
    var sel = document.querySelector('#ewalletTypeField select');
    if (kind === 'crypto') {
      sel.innerHTML = '<option value="USDT (TRC20)">USDT (TRC20)</option><option value="USDT (BEP20)">USDT (BEP20)</option><option value="Bitcoin">Bitcoin</option>';
    } else {
      sel.innerHTML = '<option value="" disabled selected><%= t.cw_select_ewallet %></option><option value="bKash">bKash</option><option value="Nagad">Nagad</option><option value="Rocket">Rocket</option><option value="Upay">Upay</option><option value="Bank Account">Bank Account</option>';
    }
  }

  document.addEventListener('DOMContentLoaded', function(){
    var fabBtn = document.getElementById('fabAddBtn');
    if (fabBtn) fabBtn.addEventListener('click', function(){ toggleModal(true); });

    var overlay = document.getElementById('modalOverlay');
    if (overlay) overlay.addEventListener('click', function(){ toggleModal(false); });

    var closeBtn = document.getElementById('closeSheetBtn');
    if (closeBtn) closeBtn.addEventListener('click', function(){ toggleModal(false); });

    var kindEwallet = document.getElementById('kindEwallet');
    if (kindEwallet) kindEwallet.addEventListener('click', function(){ setKind('ewallet'); });

    var kindCrypto = document.getElementById('kindCrypto');
    if (kindCrypto) kindCrypto.addEventListener('click', function(){ setKind('crypto'); });

    document.querySelectorAll('.card-delete-form').forEach(function(f){
      f.addEventListener('submit', function(e){
        if (!confirm('<%= t.cw_are_you_sure %>')) e.preventDefault();
      });
    });
  });
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

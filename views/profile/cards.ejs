<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: #f3f4f6 !important;
    color: #1f2937 !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }

  .bottom-sheet {
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bottom-sheet.active {
    transform: translateY(0);
  }
  .overlay {
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  .overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .fab-container {
    position: fixed;
    bottom: 100px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 50;
    pointer-events: none;
  }
  .fab-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #e61e26;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 8px 25px rgba(230, 30, 38, 0.4);
    pointer-events: auto;
    transition: all 0.3s ease;
  }
  .fab-btn:active {
    transform: scale(0.9) rotate(90deg);
  }

  .card-item {
    transition: all 0.3s ease;
  }

  .delete-btn {
    color: #e61e26;
    font-size: 20px;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .delete-btn:hover {
    opacity: 1;
  }
</style>

<div class="min-h-screen pb-32">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-4 flex items-center gap-4 sticky top-0 z-50 shadow-md">
    <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
    <h1 class="text-lg font-bold">আমার কার্ড / ই-ওয়ালেট</h1>
  </div>

  <div class="p-4 max-w-[480px] mx-auto">
    <%- include('../partials/flash') %>

    <div class="mb-6">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-gray-400 text-sm font-bold uppercase tracking-wider">সংরক্ষিত ওয়ালেট</h2>
            <p class="text-[13px] font-bold">ই-ওয়ালেট যোগ করা হয়েছে: <span class="red-theme-text font-black"><%= cards ? cards.length : 0 %></span></p>
        </div>

        <% if (cards && cards.length > 0) { %>
            <div class="grid gap-4">
                <% cards.forEach(c => { %>
                    <div class="card-item bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex items-center gap-5 relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-2 h-full red-theme-bg opacity-10"></div>
                        <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center red-theme-text text-2xl shadow-inner">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="font-black text-gray-800 text-lg leading-tight mb-1"><%= c.bank_name %></h3>
                            <p class="text-gray-500 font-mono text-sm tracking-widest"><%= c.account_number %></p>
                            <div class="flex items-center gap-2 mt-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                <span class="text-gray-400 text-[11px] font-bold uppercase tracking-tighter"><%= c.holder_name %></span>
                            </div>
                        </div>
                        <form action="/profile/cards/delete/<%= c.id %>" method="POST" data-confirm="আপনি কি নিশ্চিত?">
                            <button type="submit" class="delete-btn">
                                <i class="far fa-times-circle"></i>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="flex flex-col items-center justify-center py-24 text-center">
                <div class="relative mb-8">
                    <div class="w-40 h-40 bg-white rounded-full flex items-center justify-center shadow-xl shadow-gray-200/50">
                        <i class="fas fa-credit-card text-7xl text-gray-100"></i>
                    </div>
                    <div class="absolute -bottom-2 -right-2 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg border border-gray-50">
                        <i class="fas fa-plus text-gray-300"></i>
                    </div>
                </div>
                <h3 class="text-gray-800 font-black text-2xl mb-2">খালি ই-ওয়ালেট</h3>
                <p class="text-[15px] text-gray-400 px-10 leading-relaxed">টাকা উত্তোলনের জন্য আপনার bKash, Nagad অথবা ব্যাংক অ্যাকাউন্ট যোগ করুন।</p>
            </div>
        <% } %>
    </div>
  </div>
</div>

<!-- Floating Plus Button -->
<div class="fab-container">
    <button class="fab-btn">
        <i class="fas fa-plus"></i>
    </button>
</div>

<!-- Bottom Sheet Modal -->
<div id="modalOverlay" class="overlay fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[100]"></div>
<div id="bottomSheet" class="bottom-sheet fixed bottom-0 left-0 right-0 max-w-[480px] mx-auto bg-white rounded-t-[40px] z-[101] shadow-2xl border-t border-gray-50">
    <div class="p-8 pb-12">
        <!-- Handle -->
        <div class="w-12 h-1.5 bg-gray-100 rounded-full mx-auto mb-8"></div>

        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-black text-gray-800 tracking-tight">নতুন যোগ করুন</h2>
                <p class="text-gray-400 text-xs font-bold mt-1 uppercase tracking-widest">Add New E-Wallet</p>
            </div>
            <button data-cards-close class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-full text-gray-400 hover:text-red-500 transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <form action="/profile/cards/add" method="POST" class="space-y-6">
            <div>
                <label class="block text-gray-500 text-[13px] font-bold mb-2 ml-1 uppercase tracking-wider">ওয়ালেট টাইপ</label>
                <div class="relative">
                    <select name="bank_name" class="w-full p-4 border-2 border-gray-50 rounded-2xl focus:outline-none focus:border-red-500 bg-gray-50 font-bold appearance-none text-gray-700" required>
                        <option value="" disabled selected>E-wallet সিলেক্ট করুন</option>
                        <option value="bKash">bKash</option>
                        <option value="Nagad">Nagad</option>
                        <option value="Rocket">Rocket</option>
                        <option value="Upay">Upay</option>
                        <option value="Bank Account">Bank Account</option>
                    </select>
                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-gray-500 text-[13px] font-bold mb-2 ml-1 uppercase tracking-wider">অ্যাকাউন্ট/নাম্বার</label>
                <input type="text" name="account_number" placeholder="আপনার নম্বর বা অ্যাকাউন্ট লিখুন" class="w-full p-4 border-2 border-gray-50 rounded-2xl focus:outline-none focus:border-red-500 bg-gray-50 font-bold text-gray-700" required>
            </div>

            <div>
                <label class="block text-gray-500 text-[13px] font-bold mb-2 ml-1 uppercase tracking-wider">পাসওয়ার্ড</label>
<input type="password" name="holder_name" placeholder="আপনার পাসওয়ার্ড লিখুন" class="w-full p-4 border-2 border-gray-50 rounded-2xl focus:outline-none focus:border-red-500 bg-gray-50 font-bold text-gray-700" required>

            </div>

            <div class="pt-4">
                <button type="submit" class="w-full red-theme-bg text-white py-4 rounded-2xl font-bold text-lg shadow-lg hover:shadow-red-500/30 transition-all active:scale-95">
                    ওয়ালেট নিশ্চিত করুন
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/views/profile-cards.js"></script>


<%- include('../partials/bottom-nav') %>
</body></html>

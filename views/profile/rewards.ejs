<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container page" style="max-width:600px;margin:0 auto;padding:15px;">
  <%- include('../partials/flash') %>

  <h1 style="font-size:1.4rem;font-weight:800;margin-bottom:1rem;text-align:center;color: var(--text-accent);">
    <%= t.daily_reward_title %>
  </h1>

  <!-- ==================== অ্যাচিভমেন্ট প্রিভিউ ==================== -->
  <% if (typeof badgesPreview !== 'undefined' && badgesPreview.totalCount > 0) { %>
  <div class="card" style="margin-bottom:1rem;">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
      <span><%= t.achievements_label %> (<%= badgesPreview.earnedCount %>/<%= badgesPreview.totalCount %>)</span>
      <a href="/profile/badges" style="color: var(--text-accent);font-size:11.5px;font-weight:700;text-decoration:none;"><%= t.view_all_arrow %></a>
    </div>
    <div class="card-body" style="padding:.9rem;">
      <% if (badgesPreview.earned.length > 0) { %>
      <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;-webkit-overflow-scrolling:touch;">
        <% badgesPreview.earned.forEach(function(b) { %>
        <div title="<%= b.desc %>" style="flex:0 0 auto;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;align-items:center;gap:6px;min-width:72px;">
          <span style="font-size:22px;"><%= b.icon %></span>
          <span style="font-size:10px;color:var(--text-main);font-weight:700;text-align:center;line-height:1.3;"><%= b.name %></span>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div style="text-align:center;color:var(--muted);font-size:12.5px;padding:14px 0;"><%= t.no_badges_yet %></div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ==================== রেফারেল সামারি ==================== -->
  <% if (typeof referralSummary !== 'undefined' && referralSummary) { %>
  <a href="/profile/referral" style="text-decoration:none;display:block;margin-bottom:1rem;">
    <div class="card" style="background:linear-gradient(135deg,#4B75C6,#2B48A7);border:none;">
      <div class="card-body" style="padding:1rem 1.1rem;display:flex;align-items:center;gap:14px;">
        <div style="font-size:26px;">👥</div>
        <div style="flex:1;min-width:0;">
          <div style="color:#fff;font-weight:800;font-size:14px;"><%= t.referral_program %></div>
          <div style="color:rgba(255,255,255,0.85);font-size:11.5px;margin-top:2px;"><%= referralSummary.totalInvites %> <%= t.invited_total_commission %> <%= Number(referralSummary.totalCommission).toLocaleString('bn-BD') %><%= t.taka %></div>
        </div>
        <div style="color:#fff;font-size:13px;font-weight:700;background:rgba(255,255,255,0.2);padding:6px 12px;border-radius:16px;white-space:nowrap;"><%= t.details_arrow %></div>
      </div>
    </div>
  </a>
  <% } %>

  <% if (reward) { %>
    <!-- আজকের টার্নওভার -->
    <div class="card" style="margin-bottom:1rem;">
      <div class="card-body" style="text-align:center;padding:1.2rem;">
        <div style="font-size:.8rem;color:var(--muted);"><%= t.todays_sports_turnover %></div>
        <div style="font-size:2rem;font-weight:900;color: var(--text-accent);margin:.3rem 0;">
          <%= Number(reward.turnover).toLocaleString('bn-BD') %>
        </div>

        <% 
          // পরের টিয়ারের দিকে প্রোগ্রেস হিসাব
          let pct = 100;
          let nextText = 'সর্বোচ্চ টিয়ার অর্জিত!';
          if (reward.nextTier) {
            const target = Number(reward.nextTier.min_turnover);
            pct = Math.min(100, Math.floor((reward.turnover / target) * 100));
            nextText = `পরের টিয়ার: ${Number(target).toLocaleString('bn-BD')} (বোনাস ${reward.nextTier.bonus_amount})`;
          }
        %>

        <!-- প্রোগ্রেস বার (১ থেকে ১০০ পর্যন্ত অ্যানিমেটেড) -->
        <div style="position:relative;background:rgba(255,255,255,0.1);border-radius:20px;height:16px;overflow:hidden;margin:.6rem 0;">
          <div id="turnoverProgressFill" data-target="<%= pct %>" style="width:0%;height:100%;background:var(--grad-gold,linear-gradient(90deg,#f59e0b,#fbbf24));transition:width 1s ease-out;"></div>
        </div>
        <div style="font-size:.78rem;font-weight:800;color: var(--text-accent);"><span id="turnoverProgressPct">0</span>%</div>
        <div style="font-size:.78rem;color:var(--muted);margin-top:2px;"><%= nextText %></div>
      </div>
    </div>

    <!-- বর্তমান প্রাপ্য বোনাস + ক্লেইম -->
    <div class="card" style="margin-bottom:1rem;border:1px solid var(--gold);">
      <div class="card-body" style="text-align:center;padding:1.2rem;">
        <% if (reward.currentTier) { %>
          <div style="font-size:.85rem;color:var(--text-main);"><%= t.your_current_bonus %></div>
          <div style="font-size:1.8rem;font-weight:900;color:#10b981;margin:.3rem 0;">
            <%= reward.currentTier.bonus_amount %><%= t.coins %></div>
          <% if (reward.claimed) { %>
            <button class="btn" style="width:100%;background:rgba(255,255,255,0.1);color:var(--muted);cursor:not-allowed;" disabled>
              <%= t.reward_claimed_today %> (<%= reward.claimedAmount %> <%= t.coins %>)
            </button>
          <% } else { %>
            <form action="/profile/rewards/claim" method="POST">
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-weight:700;">
                <%= t.claim_reward %>
              </button>
            </form>
          <% } %>
        <% } else { %>
          <div style="font-size:.9rem;color:var(--muted);">
            <%= t.bet_more_for_reward %><br>
            <%= t.min_tier_label %> <%= reward.tiers.length ? Number(reward.tiers[0].min_turnover).toLocaleString('bn-BD') : '5,000' %><%= t.turnover %></div>
        <% } %>
      </div>
    </div>

    <!-- ==================== বোনাস (৩টি ফিচার) ==================== -->
    <div class="card" style="margin-bottom:1rem;">
      <div class="card-header"><%= t.bonus_ticket %></div>
      <div class="card-body" style="padding:.9rem;">
        <div style="display:flex;flex-direction:column;gap:12px;">

          <!-- লাকি হুইল -->
          <a href="/profile/wheel" style="text-decoration:none;display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,#C92034,#CE465C);border-radius:16px;padding:12px 14px;">
            <div style="font-size:26px;">🎡</div>
            <div style="flex:1;min-width:0;">
              <div style="color:#fff;font-weight:800;font-size:14px;"><%= t.lucky_wheel %></div>
              <div style="color:rgba(255,255,255,0.85);font-size:11.5px;margin-top:1px;"><%= t.spin_daily_win_coins %></div>
            </div>
            <div style="color:#fff;font-size:13px;font-weight:700;background:rgba(255,255,255,0.2);padding:6px 12px;border-radius:16px;white-space:nowrap;"><%= t.spin %></div>
          </a>

          <!-- সোনার ডিম -->
          <div id="goldenEggCard" style="background:linear-gradient(135deg,#C51B26,#C5532C);border-radius:16px;padding:12px 14px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="font-size:26px;">🥚</div>
              <div style="flex:1;min-width:0;">
                <div style="color:#fff;font-weight:800;font-size:14px;"><%= t.golden_egg %></div>
                <div id="goldenEggStatus" style="color:rgba(255,255,255,0.85);font-size:11.5px;margin-top:1px;"><%= t.loading_dots %></div>
              </div>
              <button id="goldenEggBtn" type="button" style="color:#ff2331;font-size:13px;font-weight:700;background:#fff;border:none;padding:6px 12px;border-radius:16px;white-space:nowrap;cursor:pointer;" disabled><%= t.crack_egg %></button>
            </div>
            <div id="goldenEggGrid" style="display:none;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px;"></div>
            <div id="goldenEggResult" style="display:none;color:#fff;font-weight:700;font-size:13px;text-align:center;margin-top:10px;"></div>
          </div>

          <!-- রেড কার্ড -->
          <div id="redCardCard" style="display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,#BE28A2,#C2479A);border-radius:16px;padding:12px 14px;">
            <div style="font-size:26px;">🧧</div>
            <div style="flex:1;min-width:0;">
              <div style="color:#fff;font-weight:800;font-size:14px;"><%= t.red_card %></div>
              <div id="redCardStatus" style="color:rgba(255,255,255,0.85);font-size:11.5px;margin-top:1px;"><%= t.loading_dots %></div>
            </div>
            <button id="redCardBtn" type="button" style="color:#c81aa0;font-size:13px;font-weight:700;background:#fff;border:none;padding:6px 12px;border-radius:16px;white-space:nowrap;cursor:pointer;" disabled><%= t.open %></button>
          </div>

        </div>
        <div style="font-size:.72rem;color:var(--muted);text-align:center;margin-top:10px;"><%= t.unlock_egg_card_notice %></div>
      </div>
    </div>

    <!-- টিয়ার তালিকা (আলাদা রাখা হয়েছে) -->
    <div class="card">
      <div class="card-header"><%= t.tier_list %></div>
      <div class="card-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid var(--border-glass);">
              <th style="padding:.7rem;text-align:left;font-size:.8rem;color:var(--muted);"><%= t.daily_turnover %></th>
              <th style="padding:.7rem;text-align:right;font-size:.8rem;color:var(--muted);"><%= t.bonus_label %></th>
            </tr>
          </thead>
          <tbody>
            <% reward.tiers.forEach(t => { 
              const reached = reward.turnover >= Number(t.min_turnover);
            %>
              <tr style="border-bottom:1px solid var(--border-glass);">
                <td style="padding:.7rem;font-size:.9rem;color:<%= reached ? '#10b981' : 'var(--text-main)' %>;">
                  <%= reached ? '✅ ' : '' %><%= Number(t.min_turnover).toLocaleString('bn-BD') %>+
                </td>
                <td style="padding:.7rem;text-align:right;font-weight:700;color: var(--text-accent);">
                  <%= t.bonus_amount %><%= t.taka %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <p style="font-size:.75rem;color:var(--muted);text-align:center;margin-top:1rem;line-height:1.6;">
      <%= t.turnover_resets_midnight %><br>
      <%= t.sports_only_once_daily %>
    </p>

  <% } else { %>
    <div class="card"><div class="card-body" style="text-align:center;padding:2rem;color:var(--muted);">
      <%= t.reward_load_failed %>
    </div></div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>

<% if (reward) { %>
<script src="/js/views/profile-rewards.js"></script>
<% } %>

</body></html>

<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold">🏆 পুরস্কার সেন্টার</h1>
  </div>

  <!-- User Card -->
  <div style="background:linear-gradient(135deg,#f59e0b,#ef4444);border-radius:16px;padding:20px;margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;color:#fff">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div style="color:#fff;font-weight:bold"><%= user.username %></div>
        <div style="color:rgba(255,255,255,0.8);font-size:13px">🪙 <%= user.coins %> কয়েন</div>
      </div>
    </div>
    <div style="margin-top:12px;background:rgba(255,255,255,0.2);border-radius:8px;height:8px">
      <div style="background:#fff;border-radius:8px;height:8px;width:0%"></div>
    </div>
    <div style="color:rgba(255,255,255,0.8);font-size:12px;margin-top:4px;text-align:right">VIP0 → VIP1</div>
  </div>

  <!-- Reward Cards -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
    <a href="/profile/referral" style="text-decoration:none;background:linear-gradient(135deg,#10b981,#06b6d4);border-radius:16px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:8px">
      <div style="font-size:32px">🎁</div>
      <div style="color:#fff;font-weight:bold">দাবি করা</div>
      <div style="background:rgba(255,255,255,0.2);color:#fff;font-size:12px;padding:2px 8px;border-radius:20px">রেফারেল বোনাস</div>
    </a>

    <a href="/coins" style="text-decoration:none;background:linear-gradient(135deg,#f59e0b,#fbbf24);border-radius:16px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:8px">
      <div style="font-size:32px">💰</div>
      <div style="color:#fff;font-weight:bold">কয়েন তহবিল</div>
      <div style="background:rgba(255,255,255,0.2);color:#fff;font-size:12px;padding:2px 8px;border-radius:20px">🪙 <%= user.coins %></div>
    </a>

    <a href="/profile/missions" style="text-decoration:none;background:linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:16px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:8px">
      <div style="font-size:32px">🎯</div>
      <div style="color:#fff;font-weight:bold">মিশন</div>
      <div style="background:rgba(255,255,255,0.2);color:#fff;font-size:12px;padding:2px 8px;border-radius:20px">পয়েন্ট অর্জন করুন</div>
    </a>

    <a href="/profile/referral" style="text-decoration:none;background:linear-gradient(135deg,#ec4899,#f43f5e);border-radius:16px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:8px">
      <div style="font-size:32px">👥</div>
      <div style="color:#fff;font-weight:bold">বন্ধু আমন্ত্রণ</div>
      <div style="background:rgba(255,255,255,0.2);color:#fff;font-size:12px;padding:2px 8px;border-radius:20px">১০০ কয়েন/রেফারেল</div>
    </a>
  </div>
</div>
<%- include('../partials/navbar') %>

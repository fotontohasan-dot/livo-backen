<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz64-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz64-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz64-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz64-4 { background: linear-gradient(135deg,#10b981,#059669); border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: center; }
  .dz64-5 { color: var(--text-main); font-size: 16px; font-weight: bold; margin-bottom: 4px; }
  .dz64-6 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz64-7 { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.3); border-radius: 14px; padding: 16px; margin-bottom: 16px; }
  .dz64-8 { color: #f59e0b; font-weight: bold; font-size: 13px; margin-bottom: 8px; }
  .dz64-9 { color: var(--text-muted); font-size: 12px; line-height: 1.7; }
  .dz64-10 { background: rgba(16,185,129,0.1); border: 1px solid #10b981; border-radius: 14px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
  .dz64-11 { color: var(--text-muted); font-size: 11px; margin-top: 2px; }
  .dz64-12 { margin: 0; }
  .dz64-13 { background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 8px 18px; font-size: 13px; font-weight: bold; cursor: pointer; }
  .dz64-14 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 30px; text-align: center; color: var(--text-muted); margin-bottom: 16px; }
  .dz64-15 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz64-16 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz64-17 { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz64-18 { color: var(--text-muted); font-size: 13px; }
  .dz64-19 { color: var(--text-muted); font-size: 11px; }
  .dz64-20 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im65-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im65-2 { font-size: 40px; margin-bottom: 8px; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz64-1">
  <%- include('../partials/flash') %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <div role="alert" class="data-load-error">
      <%= t.common_stats_load_failed %>
    </div>
  <% } %>

  <div class="im65-1">
    <a class="dz64-2" href="/profile">←</a>
    <h1 class="dz64-3">🎁 <%= t('fb_title') %></h1>
  </div>

  <div class="dz64-4">
    <div class="im65-2">🎁</div>
    <div class="dz64-5"><%= t('fb_coins') %></div>
    <div class="dz64-6"><%= t('fb_sub') %></div>
  </div>

  <!-- কনভার্সন রুলস -->
  <div class="dz64-7">
    <div class="dz64-8">📋 <%= t('fb_rules_heading') %></div>
    <div class="dz64-9">
      • <%= t('fb_rule_1') %><br>
      • <%= t('fb_rule_2') %><br>
      • <%= t('fb_rule_3') %><br>
      • <%= t('fb_rule_4') %>
    </div>
  </div>

  <% 
    const active = (freebets || []).filter(f => f.status === 'active');
    const used = (freebets || []).filter(f => f.status !== 'active');
  %>

  <% if (active.length > 0) { %>
    <% active.forEach(f => { %>
      <div class="dz64-10">
        <div>
          <div class="dz64-3">🎁 <%= t('fb_amount_coins').replace('{value}', f.amount) %></div>
          <div class="dz64-11"><%= new Date(f.created_at).toLocaleDateString('bn-BD') %></div>
        </div>
        <form class="dz64-12" action="/profile/freebet/claim/<%= f.id %>" method="POST">
          <button class="dz64-13" type="submit">
            <%= t('fb_claim') %>
          </button>
        </form>
      </div>
    <% }) %>
  <% } else { %>
    <div class="dz64-14">
      <%= t('fb_none') %><br><%= t('fb_none_sub') %>
    </div>
  <% } %>

  <% if (used.length > 0) { %>
    <div class="dz64-15">
      <div class="dz64-16">📜 <%= t('fb_used_heading') %></div>
      <% used.forEach(f => { %>
        <div class="dz64-17">
          <div class="dz64-18"><%= t('fb_amount_coins').replace('{value}', f.amount) %></div>
          <span class="dz64-19">✅ <%= t('fb_used') %></span>
        </div>
      <% }) %>
    </div>
  <% } %>

  <p class="dz64-20">
    <%= t('fb_info_1') %><br>
    <%= t('fb_info_2') %>
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

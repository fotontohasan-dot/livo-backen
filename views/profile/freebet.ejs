<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">🎁 ফ্রি বেট</h1>
  </div>

  <div style="background:linear-gradient(135deg,#10b981,#059669);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
    <div style="font-size:40px;margin-bottom:8px;">🎁</div>
    <div style="color:var(--text-main);font-size:16px;font-weight:bold;margin-bottom:4px;">ফ্রি বেট কয়েন</div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;">ক্লেইম করে বোনাস কয়েন পান, খেলে উপভোগ করুন</div>
  </div>

  <!-- কনভার্সন রুলস -->
  <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.3);border-radius:14px;padding:16px;margin-bottom:16px;">
    <div style="color:#f59e0b;font-weight:bold;font-size:13px;margin-bottom:8px;">📋 কনভার্সন রুলস</div>
    <div style="color:#e2e8f0;font-size:12px;line-height:1.7;">
      • ক্লেইম করলে সাথে সাথে কয়েন ব্যালেন্সে যোগ হয়<br>
      • উত্তোলনের আগে টার্নওভার শর্ত পূরণ করতে হবে<br>
      • স্পোর্টস বেটিং: বোনাসের ৫x টার্নওভার<br>
      • ক্যাসিনো গেম: বোনাসের ৩৫x টার্নওভার
    </div>
  </div>

  <% 
    const active = (freebets || []).filter(f => f.status === 'active');
    const used = (freebets || []).filter(f => f.status !== 'active');
  %>

  <% if (active.length > 0) { %>
    <% active.forEach(f => { %>
      <div style="background:rgba(16,185,129,0.1);border:1px solid #10b981;border-radius:14px;padding:16px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div style="color:var(--text-main);font-size:18px;font-weight:bold;">🎁 <%= f.amount %> কয়েন</div>
          <div style="color:var(--text-muted);font-size:11px;margin-top:2px;"><%= new Date(f.created_at).toLocaleDateString('bn-BD') %></div>
        </div>
        <form action="/profile/freebet/claim/<%= f.id %>" method="POST" style="margin:0;">
          <button type="submit" style="background:#10b981;color:#fff;border:none;border-radius:8px;padding:8px 18px;font-size:13px;font-weight:bold;cursor:pointer;">
            ক্লেইম
          </button>
        </form>
      </div>
    <% }) %>
  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color: var(--text-muted);margin-bottom:16px;">
      এখন কোনো ফ বেট নেই।<br>মিশন সম্পন্ন করুন ব অফারের জন্য অপেক্ষা করুন!
    </div>
  <% } %>

  <% if (used.length > 0) { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">📜 ব্যবহৃত ফ্রি বেট</div>
      <% used.forEach(f => { %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
          <div style="color:var(--text-muted);font-size:13px;"><%= f.amount %> কয়েন</div>
          <span style="color:var(--text-muted);font-size:11px;">✅ ব্যবহৃত</span>
        </div>
      <% }) %>
    </div>
  <% } %>

  <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
    ফ্রি বেট ক্লেইম করলে বোনাস কয়েন ব্যালেন যোগ হয়।<br>
    উত্তোলনর আগে টার্নওভার পূরণ করতে হবে (স্পর্টস ৫x / ক্যাসিন ৩৫x)।
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz81-1 { padding: 16px; padding-bottom: 100px; text-align: center; }
  .dz81-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz81-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz81-4 { background: rgba(255,255,255,0.05); border-radius: 20px; padding: 40px 20px; border: 1px solid rgba(255,255,255,0.1); margin-top: 20px; }
  .dz81-5 { color: var(--text-main); font-size: 18px; font-weight: bold; margin-bottom: 8px; }
  .dz81-6 { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; }
  .dz81-7 { display: block; background: linear-gradient(90deg,#f59e0b,#fbbf24); opacity: 0.6; color: #000; padding: 14px; border-radius: 12px; font-weight: bold; margin-bottom: 12px; cursor: not-allowed; }
  .dz81-8 { color: var(--text-muted); font-size: 12px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im82-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; text-align: left; }
  .im82-2 { font-size: 64px; margin-bottom: 20px; }
</style>

<div class="container dz81-1">
  <div class="im82-1">
    <a class="dz81-2" href="/profile">←</a>
    <h1 class="dz81-3">📱 অ্যাপ ডাউনলোড করুন</h1>
  </div>

  <div class="dz81-4">
    <div class="im82-2">📲</div>
    <div class="dz81-5">LIVO মোবাইল অ্যাপ</div>
    <div class="dz81-6">দ্রুত এবং সহজ অ্যাক্সেসের জন্য অ্যাপ ব্যবহার করুন</div>

    <div class="dz81-7" aria-disabled="true">
      📥 Android এর জন্য ডাউনলোড করুন
    </div>
    <div class="dz81-8">শীঘ্রই আসছে...</div>
  </div>
</div>
<%- include('../partials/navbar') %>

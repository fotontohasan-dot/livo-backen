<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px;text-align:center">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;text-align:left">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold">📱 <%= t('app_title') %></h1>
  </div>

  <div style="background:rgba(255,255,255,0.05);border-radius:20px;padding:40px 20px;border:1px solid rgba(255,255,255,0.1);margin-top:20px">
    <div style="font-size:64px;margin-bottom:20px">📲</div>
    <div style="color:var(--text-main);font-size:18px;font-weight:bold;margin-bottom:8px"><%= t('app_name') %></div>
    <div style="color:var(--text-muted);font-size:14px;margin-bottom:24px"><%= t('app_desc') %></div>

    <div aria-disabled="true" style="display:block;background:linear-gradient(90deg,#f59e0b,#fbbf24);opacity:0.6;color:#000;padding:14px;border-radius:12px;font-weight:bold;margin-bottom:12px;cursor:not-allowed">
      📥 <%= t('app_download_android') %>
    </div>
    <div style="color:var(--text-muted);font-size:12px"><%= t('app_coming_soon') %></div>
  </div>
</div>
<%- include('../partials/navbar') %>

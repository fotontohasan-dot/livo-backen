<%- include('../partials/head') %>

<div style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto">
  <h1 style="color:var(--gold);font-size:22px;font-weight:800;margin-bottom:16px">💬 সাপোর্ট চ্যাট</h1>

  <div id="chat-container" style="background:rgba(255,255,255,0.03);border:1px solid var(--border-glass);border-radius:16px;display:flex;flex-direction:column;height:70vh">
    <div id="messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px"></div>

    <div style="padding:12px;border-top:1px solid var(--border-glass)">
      <div id="file-preview" style="display:none;margin-bottom:8px">
        <img id="preview-img" style="display:none;max-height:100px;border-radius:8px;margin-bottom:4px"/>
        <span id="preview-name" style="font-size:12px;color:var(--text-muted)"></span>
        <button onclick="clearFile()" style="color:#ef4444;font-size:12px;margin-left:8px;background:none;border:none;cursor:pointer">✕ বাতিল</button>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <label style="background:rgba(255,255,255,0.08);color:#fff;padding:10px 12px;border-radius:8px;cursor:pointer;font-size:18px">
          📎
          <input type="file" id="file-input" style="display:none" accept="image/*,video/*">
        </label>
        <input type="text" id="message-input"
          style="flex:1;background:rgba(255,255,255,0.08);border:1px solid var(--border-glass);border-radius:8px;padding:10px 14px;color:#fff;font-size:14px;outline:none"
          placeholder="আপনার মেসেজ লিখুন...">
        <button id="send-button"
          style="background:var(--grad-gold);color:#000;padding:10px 16px;border-radius:8px;border:none;font-weight:bold;cursor:pointer;font-size:14px">
          পাঠান
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const userId = <%= user.id %>;
  const messagesDiv = document.getElementById('messages');
  const messageInput = document.getElementById('message-input');
  const sendButton = document.getElementById('send-button');
  const fileInput = document.getElementById('file-input');
  const filePreview = document.getElementById('file-preview');
  const previewImg = document.getElementById('preview-img');
  const previewName = document.getElementById('preview-name');

  let selectedFile = null;
  let selectedFileType = null;

  socket.emit('join', userId);

  window.sendQuickMessage = async function(text) {
    messageInput.value = text;
    await sendMessage();
  };

  function showWelcome() {
    const welcomeDiv = document.createElement('div');
    welcomeDiv.innerHTML = `
      <div style="background:#fff;color:#000;border-radius:16px;overflow:hidden;border:1px solid #e5e7eb;margin-bottom:8px">
        <div style="padding:14px;background:#f9fafb;display:flex;align-items:center;gap:12px;border-bottom:1px solid #e5e7eb">
          <div style="width:40px;height:40px;border-radius:50%;background:var(--grad-gold);display:flex;align-items:center;justify-content:center;color:#000;font-weight:800;font-size:18px">L</div>
          <div>
            <div style="font-weight:800;color:#111">Livo Support</div>
            <div style="font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:1px">24/7 অনলাইন গ্রাহক পরিষেবা</div>
          </div>
        </div>
        <div style="padding:16px">
          <p style="font-size:13px;color:#374151;line-height:1.6;margin-bottom:16px">
            আমাদের Livo ওয়েবসাইটে আপনাকে স্বাগতম। যদি আপনার সাহায্যের প্রয়োজন হয়, তাহলে কেবল এই বার্তার উত্তর দিন এবং আমরা যেকোনো সময় আপনাকে সহায়তা করার জন্য অনলাইনে থাকব।
          </p>
          <div style="display:flex;flex-direction:column;gap:8px">
            <button onclick="sendQuickMessage('💰 জমা সমস্যা')" style="width:100%;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;text-align:center">💰 জমা সমস্যা</button>
            <button onclick="sendQuickMessage('💸 প্রত্যাহারের সমস্যা')" style="width:100%;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;text-align:center">💸 প্রত্যাহারের সমস্যা</button>
            <button onclick="sendQuickMessage('👤 অ্যাকাউন্ট প্রশ্ন')" style="width:100%;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;text-align:center">👤 অ্যাকাউন্ট প্রশ্ন</button>
            <button onclick="sendQuickMessage('❓ সম্পর্কে প্রশ্ন')" style="width:100%;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;text-align:center">❓ সম্পর্কে প্রশ্ন</button>
            <button onclick="sendQuickMessage('⚽ বিশ্বকাপ ইভেন্ট')" style="width:100%;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;font-size:13px;font-weight:600;color:#374151;cursor:pointer;text-align:center">⚽ বিশ্বকাপ ইভেন্ট</button>
          </div>
        </div>
      </div>
    `;
    messagesDiv.appendChild(welcomeDiv);
  }

  fetch('/chat/history')
    .then(res => res.json())
    .then(messages => {
      showWelcome();
      if (Array.isArray(messages)) {
        messages.forEach(msg => appendMessage(msg.message, msg.is_admin, msg.created_at, msg.file_url, msg.file_type));
        scrollToBottom();
      }
    });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files[0];
    if (!file) return;
    selectedFile = file;
    selectedFileType = file.type.startsWith('video') ? 'video' : 'image';
    filePreview.style.display = 'block';
    previewName.textContent = file.name;
    if (selectedFileType === 'image') {
      previewImg.style.display = 'block';
      previewImg.src = URL.createObjectURL(file);
    } else {
      previewImg.style.display = 'none';
    }
  });

  function clearFile() {
    selectedFile = null;
    selectedFileType = null;
    fileInput.value = '';
    filePreview.style.display = 'none';
    previewImg.style.display = 'none';
    previewName.textContent = '';
  }

  function appendMessage(text, isAdmin, timestamp, fileUrl, fileType) {
    const div = document.createElement('div');
    div.style.cssText = `display:flex;justify-content:${isAdmin ? 'flex-start' : 'flex-end'}`;

    const inner = document.createElement('div');
    inner.style.cssText = `max-width:80%;border-radius:12px;padding:10px 14px;${isAdmin ? 'background:rgba(255,255,255,0.1);color:#fff' : 'background:var(--grad-gold);color:#000'}`;

    if (fileUrl) {
      if (fileType === 'image') {
        const img = document.createElement('img');
        img.src = fileUrl;
        img.style.cssText = 'max-width:100%;border-radius:8px;margin-bottom:4px;cursor:pointer';
        img.onclick = () => window.open(fileUrl, '_blank');
        inner.appendChild(img);
      } else if (fileType === 'video') {
        const video = document.createElement('video');
        video.src = fileUrl;
        video.controls = true;
        video.style.cssText = 'max-width:100%;border-radius:8px;margin-bottom:4px';
        inner.appendChild(video);
      }
    }

    if (text) {
      const p = document.createElement('p');
      p.style.cssText = 'font-size:14px;margin:0';
      p.textContent = text;
      inner.appendChild(p);
    }

    const time = document.createElement('span');
    time.style.cssText = 'font-size:10px;opacity:0.6;display:block;margin-top:4px';
    time.textContent = new Date(timestamp).toLocaleTimeString('bn-BD');
    inner.appendChild(time);

    div.appendChild(inner);
    messagesDiv.appendChild(div);
  }

  function scrollToBottom() {
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }

  async function sendMessage() {
    const text = messageInput.value.trim();
    if (!text && !selectedFile) return;

    let fileUrl = null;
    let fileType = null;

    if (selectedFile) {
      const formData = new FormData();
      formData.append('file', selectedFile);
      try {
        const res = await fetch('/chat/upload', { method: 'POST', body: formData });
        const data = await res.json();
        fileUrl = data.url;
        fileType = selectedFileType;
      } catch (e) {
        alert('ফাইল আপলোড ব্যর্থ হয়েছে');
        return;
      }
    }

    socket.emit('send_message', {
      senderId: userId,
      receiverId: null,
      message: text,
      isAdmin: false,
      fileUrl,
      fileType
    });

    appendMessage(text, false, new Date(), fileUrl, fileType);
    messageInput.value = '';
    clearFile();
    scrollToBottom();
  }

  sendButton.addEventListener('click', sendMessage);
  messageInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
  });

  socket.on('new_message', (data) => {
    if (data.isAdmin) {
      appendMessage(data.message, true, data.createdAt, data.fileUrl, data.fileType);
      scrollToBottom();
    }
  });
</script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

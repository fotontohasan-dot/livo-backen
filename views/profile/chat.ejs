<%- include('../partials/head') %>

<div style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto">
  <h1 style="color: var(--text-accent);font-size:22px;font-weight:800;margin-bottom:16px">💬 <%= t.chat_support %></h1>

  <!-- ==================== দ্রুত সাহায্য (help-center পেজের সেম কালার/ডিজাইন) ==================== -->
  <div style="background:linear-gradient(135deg,#1a2a6c 0%,#2a5298 100%);border-radius:16px;padding:18px 16px 16px;margin-bottom:14px;position:relative;overflow:hidden">
    <div style="position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,#ff8a00,#e52e71)"></div>
    <div style="color:#fff;font-weight:800;font-size:18px;margin-bottom:12px"><%= t('chat_quick_help') %></div>
    <div style="color:rgba(255,255,255,0.85);font-size:12px;font-weight:700;margin-bottom:8px;letter-spacing:.3px"><%= t('chat_category') %></div>
    <div id="quick-category-row" style="display:flex;gap:8px;overflow-x:auto;padding-bottom:2px;-webkit-overflow-scrolling:touch">
      <button data-quick-msg="<%= t('chat_deposit_issue') %>" class="qc-chip">💳 <%= t('chat_deposit_issue') %></button>
      <button data-quick-msg="<%= t('chat_withdraw_issue') %>" class="qc-chip">💵 <%= t('chat_withdraw_issue') %></button>
      <button data-quick-msg="<%= t('chat_bonus_issue') %>" class="qc-chip">🎁 <%= t('chat_bonus_issue') %></button>
      <button data-quick-msg="<%= t('chat_login_issue') %>" class="qc-chip">🔑 <%= t('chat_login_issue') %></button>
      <button data-quick-msg="<%= t('chat_kyc_issue') %>" class="qc-chip">🪪 <%= t('chat_kyc_issue') %></button>
      <button data-quick-msg="<%= t('chat_ticket_issue') %>" class="qc-chip">🎫 <%= t('chat_ticket_issue') %></button>
      <button data-quick-msg="<%= t('chat_football_issue') %>" class="qc-chip">⚽ <%= t('chat_football_issue') %></button>
    </div>
  </div>
  <style nonce="<%= cspNonce %>">
    .qc-chip{
      flex:0 0 auto; white-space:nowrap; background:rgba(255,255,255,0.12); color:#fff;
      border:1px solid rgba(255,255,255,0.25); border-radius:10px; padding:10px 14px;
      font-size:13px; font-weight:600; cursor:pointer; transition:background-color .2s;
    }
    .qc-chip:hover{ background:rgba(255,255,255,0.22); }
  </style>

  <div style="display:flex;gap:8px;margin-bottom:12px">
    <button id="mode-bot" data-chat-mode="bot" style="flex:1;padding:8px;border-radius:8px;border:1px solid var(--border-glass);background:var(--grad-gold);color:#000;font-weight:bold;cursor:pointer;font-size:13px">🤖 <%= t('chat_mode_bot') %></button>
    <button id="mode-agent" data-chat-mode="agent" style="flex:1;padding:8px;border-radius:8px;border:1px solid var(--border-glass);background:rgba(255,255,255,0.08);color:var(--text-main);font-weight:bold;cursor:pointer;font-size:13px">👤 <%= t('chat_mode_agent') %></button>
  </div>

  <div id="chat-container" style="background:rgba(255,255,255,0.03);border:1px solid var(--border-glass);border-radius:16px;display:flex;flex-direction:column;height:70vh">
    <div id="messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px"></div>

    <div style="padding:12px;border-top:1px solid var(--border-glass)">
      <div id="file-preview" style="display:none;margin-bottom:8px">
        <img id="preview-img" alt="<%= t('attachment_preview') %>" style="display:none;max-height:100px;border-radius:8px;margin-bottom:4px"/>
        <span id="preview-name" style="font-size:12px;color:var(--text-muted)"></span>
        <button data-clear-file style="color:#ef4444;font-size:12px;margin-left:8px;background:none;border:none;cursor:pointer">✕ <%= t.cancel %></button>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <label style="background:rgba(255,255,255,0.08);color:var(--text-main);padding:10px 12px;border-radius:8px;cursor:pointer;font-size:18px">
          📎
          <input type="file" id="file-input" style="display:none" accept="image/*,video/*">
        </label>
        <input type="text" id="message-input"
          style="flex:1;background:rgba(255,255,255,0.08);border:1px solid var(--border-glass);border-radius:8px;padding:10px 14px;color:var(--text-main);font-size:14px;outline:none"
          placeholder="<%= t.message_placeholder %>">
        <button id="send-button"
          style="background:var(--grad-gold);color:#000;padding:10px 16px;border-radius:8px;border:none;font-weight:bold;cursor:pointer;font-size:14px">
          <%= t.send %>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/content-filter.js"></script>
<%# সার্ভার-সাইড মান executable স্ক্রিপ্টে নয়, একটা JSON ডেটা ব্লকে যায় —
    ওটা ব্রাউজার চালায় না, তাই CSP-তে ইনলাইন স্ক্রিপ্টের ছাড় লাগে না। %>
<script type="application/json" id="chatConfig"><%- jsonScriptSafe({
  userId: user.id,
  siteName: siteName,
  t: {
    support_service: t.support_service,
    welcome_support: t.welcome_support,
    q_deposit: t.q_deposit,
    q_withdraw: t.q_withdraw,
    q_account: t.q_account,
    q_about: t.q_about,
    q_event: t.q_event,
    upload_fail: t.upload_fail
  }
}) %></script>
<script src="/js/profile-chat.js"></script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

<%- include('../partials/head') %>
<div class="container mx-auto p-4 mb-20 max-w-2xl">
    <h1 class="text-2xl font-bold mb-4 text-yellow-500">সাপোর্ট চ্যাট</h1>

    <div id="chat-container" class="bg-gray-900 border border-gray-800 rounded-lg flex flex-col" style="height:70vh">
        <div id="messages" class="flex-grow overflow-y-auto p-4 space-y-4"></div>

        <div class="p-4 border-t border-gray-800">
            <div id="file-preview" class="hidden mb-2">
                <img id="preview-img" class="hidden max-h-32 rounded mb-1"/>
                <span id="preview-name" class="text-xs text-gray-400"></span>
                <button onclick="clearFile()" class="text-red-400 text-xs ml-2">✕ বাতিল</button>
            </div>
            <div class="flex gap-2">
                <label class="bg-gray-700 text-white px-3 py-2 rounded cursor-pointer">
                    📎
                    <input type="file" id="file-input" class="hidden" accept="image/*,video/*">
                </label>
                <input type="text" id="message-input" class="flex-grow bg-gray-800 text-white rounded px-3 py-2 outline-none focus:ring-1 focus:ring-yellow-500" placeholder="আপনার মেসেজ লিখুন...">
                <button id="send-button" class="bg-yellow-500 text-black px-4 py-2 rounded font-bold">পাঠান</button>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const userId = <%= user.id %>;
    const messagesDiv = document.getElementById('messages');
    const messageInput = document.getElementById('message-input');
    const sendButton = document.getElementById('send-button');
    const fileInput = document.getElementById('file-input');
    const filePreview = document.getElementById('file-preview');
    const previewImg = document.getElementById('preview-img');
    const previewName = document.getElementById('preview-name');

    let selectedFile = null;
    let selectedFileType = null;

    socket.emit('join', userId);

    window.sendQuickMessage = async function(text) {
        messageInput.value = text;
        await sendMessage();
    };

    function showWelcome() {
        const welcomeDiv = document.createElement('div');
        welcomeDiv.className = 'mb-6 max-w-[95%] mx-auto';
        welcomeDiv.innerHTML = `
            <div class="bg-white text-black rounded-xl overflow-hidden shadow-lg border border-gray-200">
                <div class="p-4 bg-gray-50 flex items-center gap-3 border-b border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-yellow-500 flex items-center justify-center text-white font-bold text-xl shadow-inner">L</div>
                    <div>
                        <h3 class="font-bold text-gray-800">Livo Support</h3>
                        <p class="text-[10px] text-gray-500 uppercase tracking-wider font-semibold">24/7 অনলাইন গ্রাহক পরিষেবা</p>
                    </div>
                </div>
                <div class="p-4">
                    <p class="text-sm text-gray-700 leading-relaxed mb-5">
                        আমাদের Livo ওয়েবসাইটে আপনাকে স্বাগতম। যদি আপনার সাহায্যের প্রয়োজন হয়, তাহলে কেবল এই বার্তার উত্তর দিন এবং আমরা যেকোনো সময় আপনাকে সহায়তা করার জন্য অনলাইনে থাকব।
                    </p>
                    <div class="grid gap-2">
                        <button onclick="sendQuickMessage('$ জমা সমস্যা $')" class="w-full py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-bold text-gray-700 flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            $ জমা সমস্যা $
                        </button>
                        <button onclick="sendQuickMessage('💦 প্রত্যাহারের সমস্যা 💦')" class="w-full py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-bold text-gray-700 flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            💦 প্রত্যাহারের সমস্যা 💦
                        </button>
                        <button onclick="sendQuickMessage('💧 অ্যাকাউন্ট প্রশ্ন 💧')" class="w-full py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-bold text-gray-700 flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            💧 অ্যাকাউন্ট প্রশ্ন 💧
                        </button>
                        <button onclick="sendQuickMessage('🧧 সম্পর্কে প্রশ্ন ঘটনা 🧧')" class="w-full py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-bold text-gray-700 flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            🧧 সম্পর্কে প্রশ্ন ঘটনা 🧧
                        </button>
                        <button onclick="sendQuickMessage('⚽️ বিশ্বকাপ ইভেন্ট ⚽️')" class="w-full py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm font-bold text-gray-700 flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            ⚽️ বিশ্বকাপ ইভেন্ট ⚽️
                        </button>
                    </div>
                </div>
            </div>
        `;
        messagesDiv.appendChild(welcomeDiv);
    }

    fetch('/chat/history')
        .then(res => res.json())
        .then(messages => {
            showWelcome();
            if (Array.isArray(messages)) {
                messages.forEach(msg => appendMessage(msg.message, msg.is_admin, msg.created_at, msg.file_url, msg.file_type));
                scrollToBottom();
            }
        });

    fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];
        if (!file) return;
        selectedFile = file;
        selectedFileType = file.type.startsWith('video') ? 'video' : 'image';
        filePreview.classList.remove('hidden');
        previewName.textContent = file.name;
        if (selectedFileType === 'image') {
            previewImg.classList.remove('hidden');
            previewImg.src = URL.createObjectURL(file);
        } else {
            previewImg.classList.add('hidden');
        }
    });

    function clearFile() {
        selectedFile = null;
        selectedFileType = null;
        fileInput.value = '';
        filePreview.classList.add('hidden');
        previewImg.classList.add('hidden');
        previewName.textContent = '';
    }

    function appendMessage(text, isAdmin, timestamp, fileUrl, fileType) {
        const div = document.createElement('div');
        div.className = `flex ${isAdmin ? 'justify-start' : 'justify-end'}`;

        const innerDiv = document.createElement('div');
        innerDiv.className = `max-w-[80%] rounded-lg px-3 py-2 ${isAdmin ? 'bg-gray-700 text-white' : 'bg-yellow-500 text-black'}`;

        if (fileUrl) {
            if (fileType === 'image') {
                const img = document.createElement('img');
                img.src = fileUrl;
                img.className = 'max-w-full rounded mb-1 cursor-pointer';
                img.onclick = () => window.open(fileUrl, '_blank');
                innerDiv.appendChild(img);
            } else if (fileType === 'video') {
                const video = document.createElement('video');
                video.src = fileUrl;
                video.controls = true;
                video.className = 'max-w-full rounded mb-1';
                innerDiv.appendChild(video);
            }
        }

        if (text) {
            const textP = document.createElement('p');
            textP.textContent = text;
            innerDiv.appendChild(textP);
        }

        const timeSpan = document.createElement('span');
        timeSpan.className = 'text-[10px] opacity-70 block mt-1';
        timeSpan.textContent = new Date(timestamp).toLocaleTimeString('bn-BD');
        innerDiv.appendChild(timeSpan);
        div.appendChild(innerDiv);
        messagesDiv.appendChild(div);
    }

    function scrollToBottom() {
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    async function sendMessage() {
        const text = messageInput.value.trim();
        if (!text && !selectedFile) return;

        let fileUrl = null;
        let fileType = null;

        if (selectedFile) {
            const formData = new FormData();
            formData.append('file', selectedFile);
            try {
                const res = await fetch('/chat/upload', { method: 'POST', body: formData });
                const data = await res.json();
                fileUrl = data.url;
                fileType = selectedFileType;
            } catch (e) {
                alert('ফাইল আপলোড ব্যর্থ হয়েছে');
                return;
            }
        }

        socket.emit('send_message', {
            senderId: userId,
            receiverId: null,
            message: text,
            isAdmin: false,
            fileUrl,
            fileType
        });

        appendMessage(text, false, new Date(), fileUrl, fileType);
        messageInput.value = '';
        clearFile();
        scrollToBottom();
    }

    sendButton.addEventListener('click', sendMessage);
    messageInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    socket.on('new_message', (data) => {
        if (data.isAdmin) {
            appendMessage(data.message, true, data.createdAt, data.fileUrl, data.fileType);
            scrollToBottom();
        }
    });
</script>
<%- include('../partials/navbar') %>

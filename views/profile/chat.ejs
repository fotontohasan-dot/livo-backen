<%- include('../partials/head') %>

<div class="sc-wrap">
  <h1 class="sc-title">💬 <%= t.chat_support %></h1>

  <!-- ১) চ্যাট শুরুর আগে ক্যাটাগরি মেনু — সব অপশনই লাইভ এজেন্টের কাছে যায় -->
  <section class="sc-card" id="support-menu" hidden>
    <div class="sc-head"><%= t('chat_menu_title') %></div>
    <div class="sc-hint"><%= t('chat_menu_hint') %></div>
    <div class="sc-grid">
      <% Object.keys(supportCategories).forEach(function (key) { var c = supportCategories[key]; %>
      <button type="button" class="sc-option<%= key === 'other' ? ' sc-option-wide' : '' %>" data-category="<%= key %>"><%= c.icon %> <%= t(c.labelKey) %></button>
      <% }) %>
    </div>
    <button type="button" class="sc-link" id="open-chat" hidden><%= t('chat_open_history') %></button>
  </section>

  <!-- ২) ডিপোজিট/উইথড্র সমস্যার তথ্য ফর্ম -->
  <section class="sc-card" id="report-panel" hidden>
    <button type="button" class="sc-link sc-back" data-show-menu><%= t('chat_menu_back') %></button>
    <div class="sc-head" id="report-title"></div>
    <div class="sc-hint"><%= t('chat_report_intro') %></div>
    <button type="button" class="sc-notice" id="new-reply-notice" hidden><%= t('chat_new_reply') %></button>
    <form id="report-form" novalidate>
      <label class="sc-label" for="report-sender"><%= t('chat_report_sender') %> <span data-optional="senderNumber" hidden><%= t('chat_report_optional') %></span></label>
      <input class="sc-input" id="report-sender" name="senderNumber" type="tel" inputmode="tel" maxlength="25" autocomplete="off" placeholder="01XXXXXXXXX">

      <label class="sc-label" for="report-receiver"><%= t('chat_report_receiver') %> <span data-optional="receiverNumber" hidden><%= t('chat_report_optional') %></span></label>
      <input class="sc-input" id="report-receiver" name="receiverNumber" type="tel" inputmode="tel" maxlength="25" autocomplete="off" placeholder="01XXXXXXXXX">

      <label class="sc-label" for="report-trx"><%= t('chat_report_trx') %> <span data-optional="transactionId" hidden><%= t('chat_report_optional') %></span></label>
      <input class="sc-input" id="report-trx" name="transactionId" type="text" maxlength="40" autocomplete="off" autocapitalize="characters">

      <label class="sc-label" for="report-time"><%= t('chat_report_time') %> <span data-optional="occurredAt" hidden><%= t('chat_report_optional') %></span></label>
      <input class="sc-input" id="report-time" name="occurredAt" type="datetime-local">

      <div class="sc-error" id="report-error" role="alert" hidden></div>
      <button type="submit" class="sc-submit" id="report-submit"><%= t('chat_report_submit') %></button>
    </form>
  </section>

  <!-- ৩) লাইভ এজেন্ট চ্যাট -->
  <section id="live-chat-panel" hidden>
    <div class="sc-bar" id="live-agent-panel">
      <span class="sc-agent">👤 <%= t('chat_mode_agent') %></span>
      <span class="sc-status" id="support-status-banner"></span>
      <button type="button" class="sc-menu-btn" data-show-menu><%= t('chat_menu_open') %></button>
    </div>

    <div class="sc-chat" id="chat-container">
      <div class="sc-messages" id="messages"></div>

      <div class="sc-compose">
        <div class="sc-preview" id="file-preview">
          <img class="sc-preview-img" id="preview-img"/>
          <span class="sc-preview-name" id="preview-name"></span>
          <button type="button" class="sc-preview-clear" data-clear-file>✕ <%= t.cancel %></button>
        </div>
        <div class="sc-row">
          <label class="sc-attach">
            📎
            <input class="sc-file" type="file" id="file-input" accept="image/*,video/*">
          </label>
          <input class="sc-text" type="text" id="message-input" placeholder="<%= t.message_placeholder %>">
          <button type="button" class="sc-send" id="send-button"><%= t.send %></button>
        </div>
      </div>
    </div>
  </section>
</div>

<style nonce="<%= cspNonce %>">
  /* ছোট আকারের লাইভ চ্যাট উইজেট */
  .sc-wrap { padding: 10px 12px 90px; max-width: 320px; margin: 0 auto; }
  .sc-wrap [hidden] { display: none !important; }
  .sc-title { color: var(--text-accent); font-size: 17px; font-weight: 800; margin-bottom: 10px; }
  .sc-card { background: var(--grad-primary); border-radius: 14px; padding: 14px 12px; }
  .sc-head { color: #fff; font-weight: 800; font-size: 15px; margin-bottom: 4px; }
  .sc-hint { color: rgba(255,255,255,0.8); font-size: 11.5px; margin-bottom: 10px; line-height: 1.5; }
  .sc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .sc-option { min-height: 34px; background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.25); border-radius: 9px; padding: 6px 8px; font-size: 11.5px; font-weight: 600; cursor: pointer; text-align: left; line-height: 1.4; }
  .sc-option:hover { background: rgba(255,255,255,0.22); }
  .sc-option:disabled { opacity: .6; cursor: wait; }
  .sc-option-wide { grid-column: 1 / -1; text-align: center; }
  .sc-link { display: block; width: 100%; background: none; border: none; color: #fff; font-size: 12px; font-weight: 700; padding: 10px 0 0; cursor: pointer; text-decoration: underline; }
  .sc-back { width: auto; padding: 0 0 8px; text-decoration: none; }
  .sc-notice { display: block; width: 100%; margin-bottom: 8px; padding: 8px; border: none; border-radius: 8px; background: #fff; color: #065f46; font-size: 12px; font-weight: 800; cursor: pointer; }
  .sc-label { display: block; color: #fff; font-size: 12px; font-weight: 700; margin: 0 0 3px; }
  .sc-input { display: block; width: 100%; box-sizing: border-box; background: #fff; color: #111; border: 2px solid transparent; border-radius: 8px; padding: 6px 10px; font-size: 16px; margin-bottom: 8px; outline: none; min-height: 36px; }
  .sc-input:focus { border-color: var(--gold); }
  .sc-input-invalid { border-color: #ef4444; }
  .sc-wrap div.sc-error { background: #fef2f2 !important; color: #b91c1c !important; -webkit-text-fill-color: #b91c1c; border-radius: 8px; padding: 6px 10px; font-size: 12px; font-weight: 700; margin: 0 0 8px; }
  .sc-submit { width: 100%; padding: 9px; border: none; border-radius: 8px; background: var(--grad-gold); color: #000; font-weight: 800; font-size: 13px; cursor: pointer; }
  .sc-submit:disabled { opacity: .6; cursor: wait; }
  .sc-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .sc-agent { color: var(--text-main); font-weight: 800; font-size: 12.5px; white-space: nowrap; }
  .sc-status { flex: 1; text-align: right; font-size: 11px; color: var(--text-muted); }
  .sc-menu-btn { background: rgba(255,255,255,0.08); color: var(--text-main); border: 1px solid var(--border-glass); border-radius: 8px; padding: 5px 9px; font-size: 11.5px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .sc-chat { background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass); border-radius: 14px; display: flex; flex-direction: column; height: calc(100vh - 290px); height: calc(100dvh - 290px); min-height: 240px; max-height: 340px; overflow: hidden; }
  .sc-messages { flex: 1; min-height: 0; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
  .sc-compose { padding: 8px; border-top: 1px solid var(--border-glass); }
  .sc-preview { display: none; margin-bottom: 6px; }
  .sc-preview-img { display: none; max-height: 70px; border-radius: 8px; margin-bottom: 4px; }
  .sc-preview-name { font-size: 11px; color: var(--text-muted); }
  .sc-preview-clear { color: var(--red-text); font-size: 11px; margin-left: 8px; background: none; border: none; cursor: pointer; }
  .sc-row { display: flex; gap: 6px; align-items: center; }
  .sc-attach { background: rgba(255,255,255,0.08); color: var(--text-main); padding: 7px 9px; border-radius: 8px; cursor: pointer; font-size: 15px; }
  .sc-file { display: none; }
  .sc-text { flex: 1; min-width: 0; background: rgba(255,255,255,0.08); border: 1px solid var(--border-glass); border-radius: 8px; padding: 7px 10px; color: var(--text-main); font-size: 13px; outline: none; }
  .sc-send { background: var(--grad-gold); color: #000; padding: 8px 12px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; font-size: 12.5px; }
  /* style.css-এর গ্লোবাল `button { background-color: লাল !important }` সেকেন্ডারি বাটনে প্রযোজ্য নয় */
  .sc-wrap .sc-link { min-height: 0; background-color: transparent !important; border: none; }
  .sc-wrap .sc-menu-btn { min-height: 30px; background-color: rgba(0,0,0,0.25) !important; border-color: rgba(255,255,255,0.25) !important; }
  .sc-wrap .sc-notice { background-color: #fff !important; }
  /* থিমের গ্লোবাল `color/-webkit-text-fill-color: #fff !important` সাদা বক্সের লেখা অদৃশ্য করে দেয় */
  body .sc-wrap #report-form input.sc-input { background-color: #fff !important; color: #111 !important; -webkit-text-fill-color: #111 !important; caret-color: #111; color-scheme: light; }
  body .sc-wrap #report-form input.sc-input::placeholder { color: #9ca3af !important; -webkit-text-fill-color: #9ca3af !important; }
  body .sc-wrap #report-form #report-error { color: #b91c1c !important; -webkit-text-fill-color: #b91c1c !important; }
  body .sc-wrap #report-panel #new-reply-notice { color: #065f46 !important; -webkit-text-fill-color: #065f46 !important; }
  /* লাইট মোডেও পেজের পটভূমি সবুজ থাকে — শিরোনাম ও স্ট্যাটাস সাদা রাখা হয় */
  body.light-mode .sc-wrap .sc-title, body.light-mode .sc-wrap .sc-agent, body.light-mode .sc-wrap .sc-status { color: #fff !important; -webkit-text-fill-color: #fff !important; }
  .sc-wrap .sc-preview-clear { min-height: 0; background-color: transparent !important; }
</style>

<script src="/socket.io/socket.io.js"></script>
  <script src="/js/socket-client.js"></script>
<script src="/js/content-filter.js"></script>
<%# সার্ভার-সাইড মান executable স্ক্রিপ্টে নয়, একটা JSON ডেটা ব্লকে যায় —
    ওটা ব্রাউজার চালায় না, তাই CSP-তে ইনলাইন স্ক্রিপ্টের ছাড় লাগে না। %>
<script type="application/json" id="chatConfig"><%- jsonScriptSafe({
  userId: user.id,
  categories: Object.keys(supportCategories).reduce(function (all, key) {
    var c = supportCategories[key];
    all[key] = { title: c.icon + ' ' + t(c.labelKey), form: !!c.form, required: c.required || [] };
    return all;
  }, {}),
  t: {
    upload_fail: t.upload_fail,
    chat_status_waiting: t.chat_status_waiting,
    chat_status_connected: t.chat_status_connected,
    chat_status_resolved: t.chat_status_resolved,
    chat_report_invalid: t('chat_report_invalid'),
    chat_report_required: t('chat_report_required'),
    chat_report_failed: t('chat_report_failed'),
    chat_report_duplicate: t('chat_report_duplicate')
  }
}) %></script>
<script src="/js/profile-chat.js"></script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

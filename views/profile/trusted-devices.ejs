<%- include('../partials/head') %>

<div class="container" style="padding: 16px; padding-bottom: 100px;">
  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
    <a href="/profile/security" style="color:var(--text-main); text-decoration: none; width: 40px; height: 40px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
      <i class="fas fa-chevron-left"></i>
    </a>
    <h1 style="color:var(--text-main); font-size: 20px; font-weight: 800; letter-spacing: 0.5px;">
      <i class="fas fa-shield-halved" style="color: var(--text-accent);"></i> <%= t.trusted_devices_title %>
    </h1>
  </div>

  <%- include('../partials/flash') %>

  <div style="background: var(--bg-card); border-radius: 20px; padding: 20px; border: 1px solid var(--border-glass); margin-bottom: 16px;">
    <p style="color: var(--text-muted); font-size: 12.5px; margin: 0;"><%= t.trusted_devices_subtitle %></p>
  </div>

  <% if (devices && devices.filter(d => !d.is_current).length > 0) { %>
    <form method="POST" action="/profile/trusted-devices/remove-all-others"
      onsubmit="return confirm('<%= t.remove_all_other_confirm %>')" style="margin-bottom:16px;">
      <button type="submit" style="width:100%; background: rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); color:#ef4444; padding:12px; border-radius:12px; font-size:13px; font-weight:800; cursor:pointer;">
        <i class="fas fa-right-from-bracket"></i> <%= t.remove_all_other_devices %>
      </button>
    </form>
  <% } %>

  <% if (devices && devices.length) { %>
    <% devices.forEach(function(d) { %>
      <div class="trusted-device-card" style="background: var(--bg-card); border-radius: 18px; padding: 18px; margin-bottom: 14px; border: 1px solid <%= d.is_trusted ? 'rgba(16,185,129,0.35)' : 'var(--border-glass)' %>;">

        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom: 10px;">
          <div style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;" id="dev-name-<%= d.id %>">
              <i class="fas <%= d.device_type === 'Mobile' ? 'fa-mobile-screen' : (d.device_type === 'Tablet' ? 'fa-tablet-screen-button' : 'fa-desktop') %>" style="color: var(--text-accent);"></i>
              <span style="color:var(--text-main); font-size:15px; font-weight:800;"><%= d.display_name %></span>
              <% if (d.is_current) { %><span style="background:rgba(16,185,129,0.15); color:var(--green-text); font-size:10px; font-weight:800; padding:2px 8px; border-radius:20px;"><%= t.current_device_badge %></span><% } %>
              <% if (d.is_new_device) { %><span style="background:rgba(245,158,11,0.15); color: var(--text-accent); font-size:10px; font-weight:800; padding:2px 8px; border-radius:20px;"><%= t.new_device_badge %></span><% } %>
            </div>
          </div>
          <span style="flex-shrink:0; background: <%= d.is_trusted ? 'rgba(16,185,129,0.15)' : 'rgba(148,163,184,0.15)' %>; color: <%= d.is_trusted ? '#10b981' : '#94a3b8' %>; font-size:11px; font-weight:800; padding:5px 10px; border-radius:20px; white-space:nowrap;">
            <i class="fas <%= d.is_trusted ? 'fa-shield-check' : 'fa-shield' %>"></i> <%= d.is_trusted ? t.trusted_badge : t.not_trusted_badge %>
          </span>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; font-size:11.5px; color:var(--text-muted); margin-bottom:14px;">
          <div><i class="fas fa-globe" style="width:14px;"></i> <%= t.device_browser_os %>: <span style="color:var(--text-main);"><%= d.browser || '-' %> / <%= d.os || '-' %></span></div>
          <div><i class="fas fa-location-dot" style="width:14px;"></i> <%= t.device_ip_location %>: <span style="color:var(--text-main);"><%= d.ip || '-' %><%= d.location ? ' • ' + d.location : '' %></span></div>
          <div><i class="fas fa-right-to-bracket" style="width:14px;"></i> <%= t.device_logged_in_since %>: <span style="color:var(--text-main);"><%= new Date(d.created_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></span></div>
          <div><i class="fas fa-clock" style="width:14px;"></i> <%= t.device_last_active %>: <span style="color:var(--text-main);"><%= new Date(d.last_activity).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></span></div>
          <% if (d.is_trusted && d.trusted_at) { %>
            <div style="grid-column: 1 / -1;"><i class="fas fa-shield-check" style="width:14px; color:var(--green-text);"></i> <%= t.trusted_since %>: <span style="color:var(--green-text);"><%= new Date(d.trusted_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></span></div>
          <% } %>
        </div>

        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <button type="button" onclick="renameDevicePrompt(<%= d.id %>, '<%= (d.display_name || '').replace(/'/g, "\\'") %>')"
            style="background: rgba(255,255,255,0.06); border:none; color:var(--text-main); padding:8px 12px; border-radius:10px; font-size:11px; font-weight:700; cursor:pointer;">
            <i class="fas fa-pen"></i> <%= t.rename_device %>
          </button>

          <form method="POST" action="/profile/trusted-devices/<%= d.id %>/trust" style="display:inline;">
            <input type="hidden" name="trusted" value="<%= d.is_trusted ? 'false' : 'true' %>">
            <button type="submit" style="background: <%= d.is_trusted ? 'rgba(148,163,184,0.12)' : 'rgba(16,185,129,0.12)' %>; border:none; color: <%= d.is_trusted ? '#94a3b8' : '#10b981' %>; padding:8px 12px; border-radius:10px; font-size:11px; font-weight:700; cursor:pointer;">
              <i class="fas <%= d.is_trusted ? 'fa-shield' : 'fa-shield-check' %>"></i> <%= d.is_trusted ? t.mark_untrusted : t.mark_trusted %>
            </button>
          </form>

          <% if (!d.is_current) { %>
            <form method="POST" action="/profile/trusted-devices/<%= d.id %>/remove" onsubmit="return confirm('<%= t.remove_device_confirm %>')" style="display:inline; margin-left:auto;">
              <button type="submit" style="background: rgba(239,68,68,0.1); border:none; color:#ef4444; padding:8px 12px; border-radius:10px; font-size:11px; font-weight:700; cursor:pointer;">
                <i class="fas fa-trash"></i> <%= t.remove_device %>
              </button>
            </form>
          <% } %>
        </div>

        <!-- ইনলাইন রিনেম ফর্ম (JS দিয়ে টগল হয়, prompt() সাপোর্ট না থাকলে ফলব্যাক) -->
        <form method="POST" action="/profile/trusted-devices/<%= d.id %>/rename" id="rename-form-<%= d.id %>" style="display:none; margin-top:10px; gap:8px;">
          <input type="text" name="label" maxlength="100" placeholder="<%= t.rename_device_prompt %>"
            style="flex:1; background: rgba(255,255,255,0.05); border:1px solid var(--border-glass); color:var(--text-main); padding:8px 12px; border-radius:10px; font-size:12px;">
          <button type="submit" style="background: var(--gold); border:none; color:var(--text-inverse); padding:8px 14px; border-radius:10px; font-size:11px; font-weight:800; cursor:pointer;">✓</button>
        </form>
      </div>
    <% }) %>
  <% } else { %>
    <div style="text-align:center; padding: 40px 0; color: var(--text-muted); font-size: 13px;">
      <i class="fas fa-mobile-screen" style="font-size:32px; display:block; margin-bottom:10px; opacity:0.4;"></i>
      <%= t.no_trusted_devices %>
    </div>
  <% } %>
</div>

<script>
  function renameDevicePrompt(id, currentName) {
    if (typeof window.prompt === 'function') {
      var newName = window.prompt('<%= t.rename_device_prompt %>', currentName || '');
      if (newName && newName.trim()) {
        var form = document.getElementById('rename-form-' + id);
        form.querySelector('input[name="label"]').value = newName.trim();
        form.submit();
      }
      return;
    }
    var form = document.getElementById('rename-form-' + id);
    form.style.display = 'flex';
    form.querySelector('input[name="label"]').focus();
  }
</script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">💸 ক্যাশব্যাক</h1>
  </div>

  <!-- ব্যানার -->
  <div style="background:linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
    <div style="font-size:40px;margin-bottom:8px;">💸</div>
    <div style="color:var(--text-main);font-size:16px;font-weight:bold;margin-bottom:4px;">দৈনিক ক্যাশব্যাক</div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;">
      প্রতিদিন আপনার নিট লোকসানের ৫% পরদিন ফেরত পান
    </div>
  </div>

  <% if (cashback) { %>
    <div style="color:var(--text-muted);font-size:13px;margin-bottom:10px;">গতকালের হিসাব (<%= cashback.yesterday %>)</div>

    <% ['sports','casino','live'].forEach(function(cat) { var c = cashback.byCategory[cat]; %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:16px;margin-bottom:12px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="color:var(--text-main);font-size:14px;font-weight:bold;"><%= c.label %></span>
        <% if (c.claimed) { %>
          <span style="color:#10b981;font-size:12px;">✅ নেওয়া হয়েছে</span>
        <% } %>
      </div>
      <div style="display:flex;justify-content:space-between;padding:4px 0;">
        <span style="color:var(--text-muted);font-size:13px;">নিট লোকসান</span>
        <span style="color:#ef4444;font-size:13px;font-weight:bold;"><%= Number(c.netLoss).toLocaleString('bn-BD') %> কয়েন</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:4px 0;margin-bottom:10px;">
        <span style="color:var(--text-muted);font-size:13px;">ক্যাশব্যাক (৫%)</span>
        <span style="color:#10b981;font-size:13px;font-weight:bold;"><%= Number(c.amount).toLocaleString('bn-BD') %> কয়েন</span>
      </div>
      <% if (c.available) { %>
        <form action="/profile/cashback/claim" method="POST">
          <input type="hidden" name="category" value="<%= cat %>">
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-weight:700;font-size:13px;padding:10px;">
            💸 <%= Number(c.amount).toLocaleString('bn-BD') %> কয়েন ক্লেইম করুন
          </button>
        </form>
      <% } else if (!c.claimed) { %>
        <div style="color:var(--text-muted);font-size:12px;text-align:center;">লোকসান নেই বা সর্বনিম্ন ১০ কয়েনের কম</div>
      <% } %>
    </div>
    <% }); %>

    <!-- সাপ্তাহিক/মাসিক সামারি -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:16px;margin-top:20px;">
      <div style="color:var(--text-main);font-size:14px;font-weight:bold;margin-bottom:10px;">📊 সামারি</div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
        <span style="color:var(--text-muted);font-size:13px;">গত ৭ দিনে মোট ক্যাশব্যাক</span>
        <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= Number(cashback.weekly.cashbackEarned).toLocaleString('bn-BD') %> কয়েন</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;">
        <span style="color:var(--text-muted);font-size:13px;">গত ৩০ দিনে মোট ক্যাশব্যাক</span>
        <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= Number(cashback.monthly.cashbackEarned).toLocaleString('bn-BD') %> কয়েন</span>
      </div>
    </div>

    <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
      ⏰ প্রতিদিন গতকালের লোকসানের উপর ক্যাশব্যাক পাওয়া যায়।<br>
      নিট লোকসান = মোট বাজি − মোট জয়। সর্বনিম্ন ১০ কয়েন লাগবে।
    </p>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color: var(--text-muted);">
      ক্যাশব্যাক তথ্য লোড করা যায়নি। পরে আবার চেষ্টা করুন।
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz56-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz56-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz56-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz56-4 { background: linear-gradient(135deg,#8b5cf6,#6366f1); border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: center; }
  .dz56-5 { color: var(--text-main); font-size: 16px; font-weight: bold; margin-bottom: 4px; }
  .dz56-6 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz56-7 { color: var(--text-muted); font-size: 13px; margin-bottom: 10px; }
  .dz56-8 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 16px; margin-bottom: 12px; }
  .dz56-9 { color: var(--text-main); font-size: 14px; font-weight: bold; }
  .dz56-10 { color: #10b981; font-size: 12px; }
  .dz56-11 { display: flex; justify-content: space-between; padding: 4px 0; }
  .dz56-12 { color: var(--text-muted); font-size: 13px; }
  .dz56-13 { color: #ef4444; font-size: 13px; font-weight: bold; }
  .dz56-14 { display: flex; justify-content: space-between; padding: 4px 0; margin-bottom: 10px; }
  .dz56-15 { color: #10b981; font-size: 13px; font-weight: bold; }
  .dz56-16 { width: 100%; justify-content: center; font-weight: 700; font-size: 13px; padding: 10px; }
  .dz56-17 { color: var(--text-muted); font-size: 12px; text-align: center; }
  .dz56-18 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 16px; margin-top: 20px; }
  .dz56-19 { color: var(--text-main); font-size: 14px; font-weight: bold; margin-bottom: 10px; }
  .dz56-20 { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz56-21 { color: #f59e0b; font-size: 13px; font-weight: bold; }
  .dz56-22 { display: flex; justify-content: space-between; padding: 6px 0; }
  .dz56-23 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  .dz56-24 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 30px; text-align: center; color: var(--text-muted); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im57-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im57-2 { font-size: 40px; margin-bottom: 8px; }
  .im57-3 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz56-1">
  <%- include('../partials/flash') %>

  <div class="im57-1">
    <a class="dz56-2" href="/profile">←</a>
    <h1 class="dz56-3">💸 <%= t('cb_title') %></h1>
  </div>

  <!-- ব্যানার -->
  <div class="dz56-4">
    <div class="im57-2">💸</div>
    <div class="dz56-5"><%= t('cb_daily') %></div>
    <div class="dz56-6">
      <%= t('cb_daily_desc') %>
    </div>
  </div>

  <% if (cashback) { %>
    <div class="dz56-7"><%= t('cb_yesterday').replace('{date}', cashback.yesterday) %></div>

    <% ['sports','casino','live'].forEach(function(cat) { var c = cashback.byCategory[cat]; %>
    <div class="dz56-8">
      <div class="im57-3">
        <span class="dz56-9"><%= c.label %></span>
        <% if (c.claimed) { %>
          <span class="dz56-10">✅ <%= t('cb_claimed') %></span>
        <% } %>
      </div>
      <div class="dz56-11">
        <span class="dz56-12"><%= t('cb_net_loss') %></span>
        <span class="dz56-13"><%= Number(c.netLoss).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %> কয়েন</span>
      </div>
      <div class="dz56-14">
        <span class="dz56-12"><%= t('cb_cashback_5') %></span>
        <span class="dz56-15"><%= Number(c.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %> কয়েন</span>
      </div>
      <% if (c.available) { %>
        <form action="/profile/cashback/claim" method="POST">
          <input type="hidden" name="category" value="<%= cat %>">
          <button type="submit" class="btn btn-primary dz56-16">
            💸 <%= t('cb_claim').replace('{value}', Number(c.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
          </button>
        </form>
      <% } else if (!c.claimed) { %>
        <div class="dz56-17"><%= t('cb_none') %></div>
      <% } %>
    </div>
    <% }); %>

    <!-- সাপ্তাহিক/মাসিক সামারি -->
    <div class="dz56-18">
      <div class="dz56-19">📊 <%= t('cb_summary') %></div>
      <div class="dz56-20">
        <span class="dz56-12"><%= t('cb_weekly_total') %></span>
        <span class="dz56-21"><%= Number(cashback.weekly.cashbackEarned).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %> কয়েন</span>
      </div>
      <div class="dz56-22">
        <span class="dz56-12"><%= t('cb_monthly_total') %></span>
        <span class="dz56-21"><%= Number(cashback.monthly.cashbackEarned).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %> কয়েন</span>
      </div>
    </div>

    <p class="dz56-23">
      ⏰ <%= t('cb_info_daily') %><br>
      <%= t('cb_info_formula') %>
    </p>

  <% } else { %>
    <div class="dz56-24">
      <%= t('cb_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

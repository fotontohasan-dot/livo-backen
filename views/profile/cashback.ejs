<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">💸 <%= t('cb_title') %></h1>
  </div>

  <!-- ব্যানার -->
  <div style="background:linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
    <div style="font-size:40px;margin-bottom:8px;">💸</div>
    <div style="color:var(--text-main);font-size:16px;font-weight:bold;margin-bottom:4px;"><%= t('cb_daily') %></div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;">
      <%= t('cb_daily_desc') %>
    </div>
  </div>

  <% if (cashback) { %>
    <div style="color:var(--text-muted);font-size:13px;margin-bottom:10px;"><%= t('cb_yesterday').replace('{date}', cashback.yesterday) %></div>

    <% ['sports','casino','live'].forEach(function(cat) { var c = cashback.byCategory[cat]; %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:16px;margin-bottom:12px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="color:var(--text-main);font-size:14px;font-weight:bold;"><%= c.label %></span>
        <% if (c.claimed) { %>
          <span style="color:#10b981;font-size:12px;">✅ <%= t('cb_claimed') %></span>
        <% } %>
      </div>
      <div style="display:flex;justify-content:space-between;padding:4px 0;">
        <span style="color:var(--text-muted);font-size:13px;"><%= t('cb_net_loss') %></span>
        <span style="color:#ef4444;font-size:13px;font-weight:bold;"><%= t('cb_coins').replace('{value}', Number(c.netLoss).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:4px 0;margin-bottom:10px;">
        <span style="color:var(--text-muted);font-size:13px;"><%= t('cb_cashback_5') %></span>
        <span style="color:#10b981;font-size:13px;font-weight:bold;"><%= t('cb_coins').replace('{value}', Number(c.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
      </div>
      <% if (c.available) { %>
        <form action="/profile/cashback/claim" method="POST">
          <input type="hidden" name="category" value="<%= cat %>">
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-weight:700;font-size:13px;padding:10px;">
            💸 <%= t('cb_claim').replace('{value}', Number(c.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
          </button>
        </form>
      <% } else if (!c.claimed) { %>
        <div style="color:var(--text-muted);font-size:12px;text-align:center;"><%= t('cb_none') %></div>
      <% } %>
    </div>
    <% }); %>

    <!-- সাপ্তাহিক/মাসিক সামারি -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:16px;margin-top:20px;">
      <div style="color:var(--text-main);font-size:14px;font-weight:bold;margin-bottom:10px;">📊 <%= t('cb_summary') %></div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
        <span style="color:var(--text-muted);font-size:13px;"><%= t('cb_weekly_total') %></span>
        <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= t('cb_coins').replace('{value}', Number(cashback.weekly.cashbackEarned).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;">
        <span style="color:var(--text-muted);font-size:13px;"><%= t('cb_monthly_total') %></span>
        <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= t('cb_coins').replace('{value}', Number(cashback.monthly.cashbackEarned).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %></span>
      </div>
    </div>

    <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
      ⏰ <%= t('cb_info_daily') %><br>
      <%= t('cb_info_formula') %>
    </p>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color: var(--text-muted);">
      <%= t('cb_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

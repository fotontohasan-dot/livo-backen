<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz67-1 { padding: 16px; padding-bottom: 100px; }
  .dz67-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz67-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz67-4 { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 10px; }
  .dz67-5 { white-space: nowrap; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: var(--text-main); text-decoration: none; }
  .dz67-6 { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 10px; color: var(--text-main); font-size: 12px; }
  .dz67-7 { color: var(--text-muted); font-size: 12px; }
  .dz67-8 { background: linear-gradient(90deg,#f59e0b,#fbbf24); border: none; color: #000; padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 800; }
  .dz67-9 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
  .dz67-10 { color: var(--text-muted); font-size: 12px; margin-bottom: 8px; }
  .dz67-11 { color: #f59e0b; font-size: 28px; font-weight: bold; }
  .dz67-12 { color: #10b981; font-size: 22px; font-weight: bold; }
  .dz67-13 { color: #ef4444; }
  .dz67-14 { color: rgba(255,255,255,0.85); font-size: 13px; margin-bottom: 6px; }
  .dz67-15 { color: var(--text-main); font-size: 32px; font-weight: bold; }
  .dz67-16 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 16px; border: 1px solid rgba(255,255,255,0.1); }
  .dz67-17 { color: var(--text-muted); font-size: 11px; margin-bottom: 6px; }
  .dz67-18 { color: #10b981; font-size: 18px; font-weight: bold; }
  .dz67-19 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; margin-top: 16px; border: 1px solid rgba(255,255,255,0.1); }
  .dz67-20 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz67-21 { background: rgba(255,255,255,0.1); border-radius: 10px; height: 12px; overflow: hidden; }
  .dz67-22 { text-align: right; color: #f59e0b; font-size: 14px; margin-top: 6px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im68-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im68-2 { margin-bottom: 16px; }
  .im68-3 { display: flex; gap: 8px; align-items: center; }
  .im68-4 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .im68-5 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
</style>

<div class="container dz67-1">
  <div class="im68-1">
    <a class="dz67-2" href="/profile">←</a>
    <h1 class="dz67-3">💰 প্রফিট এন্ড লস</h1>
  </div>

  <form class="im68-2" method="GET" action="/profile/stats">
    <div class="dz67-4">
      <button type="submit" name="quick" value="today" style="white-space:nowrap; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1); background: <%= filter.quick === 'today' ? 'linear-gradient(90deg,#f59e0b,#fbbf24)' : 'rgba(255,255,255,0.05)' %>; color: <%= filter.quick === 'today' ? '#000' : 'var(--text-main)' %>;">আজ</button>
      <button type="submit" name="quick" value="yesterday" style="white-space:nowrap; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1); background: <%= filter.quick === 'yesterday' ? 'linear-gradient(90deg,#f59e0b,#fbbf24)' : 'rgba(255,255,255,0.05)' %>; color: <%= filter.quick === 'yesterday' ? '#000' : 'var(--text-main)' %>;">গতকাল</button>
      <button type="submit" name="quick" value="7days" style="white-space:nowrap; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1); background: <%= filter.quick === '7days' ? 'linear-gradient(90deg,#f59e0b,#fbbf24)' : 'rgba(255,255,255,0.05)' %>; color: <%= filter.quick === '7days' ? '#000' : 'var(--text-main)' %>;">গত ৭ দিন</button>
      <a class="dz67-5" href="/profile/stats">সব</a>
    </div>
    <div class="im68-3">
      <input class="dz67-6" type="date" name="from" value="<%= filter.from %>">
      <span class="dz67-7">থেকে</span>
      <input class="dz67-6" type="date" name="to" value="<%= filter.to %>">
      <button class="dz67-8" type="submit">ফিল্টার</button>
    </div>
  </form>

  <div class="im68-4">
    <div class="dz67-9">
      <div class="dz67-10">মোট বেট</div>
      <div class="dz67-11"><%= stats.total %></div>
    </div>
    <div class="dz67-9">
      <div class="dz67-10">জয় / হার</div>
      <div class="dz67-12"><%= stats.won %> <span class="dz67-13">/ <%= stats.lost %></span></div>
    </div>
  </div>

  <div style="background: <%= stats.net_profit >= 0 ? 'linear-gradient(135deg,#10b981,#059669)' : 'linear-gradient(135deg,#ef4444,#b91c1c)' %>;border-radius:16px;padding:20px;text-align:center">
    <div class="dz67-14">নেট লাভ/ক্ষতি (সেটেল হওয়া বেট থেকে)</div>
    <div class="dz67-15"><%= stats.net_profit >= 0 ? '+' : '' %>৳<%= stats.net_profit.toLocaleString('bn-BD') %></div>
  </div>

  <div class="im68-5">
    <div class="dz67-16">
      <div class="dz67-17">মোট স্টেক</div>
      <div class="dz67-3">৳<%= stats.total_staked.toLocaleString('bn-BD') %></div>
    </div>
    <div class="dz67-16">
      <div class="dz67-17">মোট জিতেছে</div>
      <div class="dz67-18">৳<%= stats.total_won_amount.toLocaleString('bn-BD') %></div>
    </div>
  </div>

  <% const winRate = stats.total > 0 ? Math.round((stats.won / stats.total) * 100) : 0; %>
  <div class="dz67-19">
    <div class="dz67-20">জয়ের হার</div>
    <div class="dz67-21">
      <div style="background:linear-gradient(90deg,#f59e0b,#fbbf24);height:12px;width:<%= winRate %>%"></div>
    </div>
    <div class="dz67-22"><%= winRate %>%</div>
  </div>
</div>
<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

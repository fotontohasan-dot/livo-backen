<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz57-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz57-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz57-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz57-4 { flex: 1; background: rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; text-align: center; }
  .dz57-5 { color: var(--text-muted); font-size: 11px; }
  .dz57-6 { color: #10b981; font-weight: 900; font-size: 18px; }
  .dz57-7 { color: #f59e0b; font-weight: 900; font-size: 18px; }
  .dz57-8 { color: var(--text-main); font-weight: bold; margin-bottom: 10px; }
  .dz57-9 { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 12px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
  .dz57-10 { color: var(--text-main); font-size: 13px; font-weight: 600; }
  .dz57-11 { color: var(--text-muted); font-size: 11px; margin-top: 2px; }
  .dz57-12 { color: #10b981; font-weight: 800; font-size: 14px; white-space: nowrap; }
  .dz57-13 { text-align: center; color: var(--text-muted); padding: 24px; font-size: 13px; }
  .dz57-14 { color: var(--text-main); font-weight: bold; margin: 20px 0 10px; }
  .dz57-15 { color: #f59e0b; font-weight: 800; font-size: 14px; white-space: nowrap; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im58-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im58-2 { display: flex; gap: 8px; margin-bottom: 16px; }
  .im58-3 { display: flex; gap: 8px; justify-content: center; margin: 12px 0; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz57-1">
  <%- include('../partials/flash') %>

  <div class="im58-1">
    <a class="dz57-2" href="/profile/vip">←</a>
    <h1 class="dz57-3">📜 <%= t('viph_title') %></h1>
  </div>

  <div class="im58-2">
    <div class="dz57-4">
      <div class="dz57-5"><%= t('viph_total_claims') %></div>
      <div class="dz57-6"><%= rewardHistory.total %></div>
    </div>
    <div class="dz57-4">
      <div class="dz57-5"><%= t('viph_total_upgrades') %></div>
      <div class="dz57-7"><%= upgradeHistory.total %></div>
    </div>
  </div>

  <div class="dz57-8">🎁 <%= t('viph_reward_history') %></div>
  <% if (rewardHistory.rows && rewardHistory.rows.length > 0) { %>
    <% rewardHistory.rows.forEach(r => { %>
      <div class="dz57-9">
        <div>
          <div class="dz57-10"><%= r.description %></div>
          <div class="dz57-11"><%= new Date(r.created_at).toLocaleString('bn-BD') %></div>
        </div>
        <div class="dz57-12">+<%= Number(r.amount).toLocaleString('bn-BD') %></div>
      </div>
    <% }) %>
    <% if (rewardHistory.totalPages > 1) { %>
      <div class="im58-3">
        <% for (let p = 1; p <= rewardHistory.totalPages; p++) { %>
          <a href="/profile/vip/history?page=<%= p %>" style="padding:4px 10px;border-radius:6px;font-size:12px;text-decoration:none;background:<%= p === page ? '#f59e0b' : 'rgba(255,255,255,0.05)' %>;color:<%= p === page ? '#000' : 'var(--text-muted)' %>;"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="dz57-13"><%= t('viph_no_rewards') %></div>
  <% } %>

  <div class="dz57-14">⬆️ <%= t('viph_upgrade_history') %></div>
  <% if (upgradeHistory.rows && upgradeHistory.rows.length > 0) { %>
    <% upgradeHistory.rows.forEach(u => { %>
      <div class="dz57-9">
        <div>
          <div class="dz57-10"><%= t('loy_level') %> <%= u.from_level %> → <%= t('loy_level') %> <%= u.to_level %></div>
          <div class="dz57-11"><%= new Date(u.created_at).toLocaleString('bn-BD') %></div>
        </div>
        <div class="dz57-15">+<%= Number(u.bonus).toLocaleString('bn-BD') %></div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="dz57-13"><%= t('viph_no_upgrades') %></div>
  <% } %>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

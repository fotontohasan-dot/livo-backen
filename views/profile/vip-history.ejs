<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile/vip" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">📜 <%= t('viph_title') %></h1>
  </div>

  <div style="display:flex;gap:8px;margin-bottom:16px;">
    <div style="flex:1;background:rgba(255,255,255,0.05);border-radius:12px;padding:12px;text-align:center;">
      <div style="color:var(--text-muted);font-size:11px;"><%= t('viph_total_claims') %></div>
      <div style="color:#10b981;font-weight:900;font-size:18px;"><%= rewardHistory.total %></div>
    </div>
    <div style="flex:1;background:rgba(255,255,255,0.05);border-radius:12px;padding:12px;text-align:center;">
      <div style="color:var(--text-muted);font-size:11px;"><%= t('viph_total_upgrades') %></div>
      <div style="color:#f59e0b;font-weight:900;font-size:18px;"><%= upgradeHistory.total %></div>
    </div>
  </div>

  <div style="color:var(--text-main);font-weight:bold;margin-bottom:10px;">🎁 <%= t('viph_reward_history') %></div>
  <% if (rewardHistory.rows && rewardHistory.rows.length > 0) { %>
    <% rewardHistory.rows.forEach(r => { %>
      <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div style="color:var(--text-main);font-size:13px;font-weight:600;"><%= r.description %></div>
          <div style="color:var(--text-muted);font-size:11px;margin-top:2px;"><%= new Date(r.created_at).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
        </div>
        <div style="color:#10b981;font-weight:800;font-size:14px;white-space:nowrap;">+<%= Number(r.amount).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
      </div>
    <% }) %>
    <% if (rewardHistory.totalPages > 1) { %>
      <div style="display:flex;gap:8px;justify-content:center;margin:12px 0;">
        <% for (let p = 1; p <= rewardHistory.totalPages; p++) { %>
          <a href="/profile/vip/history?page=<%= p %>" style="padding:4px 10px;border-radius:6px;font-size:12px;text-decoration:none;background:<%= p === page ? '#f59e0b' : 'rgba(255,255,255,0.05)' %>;color:<%= p === page ? '#000' : 'var(--text-muted)' %>;"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div style="text-align:center;color:var(--text-muted);padding:24px;font-size:13px;"><%= t('viph_no_rewards') %></div>
  <% } %>

  <div style="color:var(--text-main);font-weight:bold;margin:20px 0 10px;">⬆️ <%= t('viph_upgrade_history') %></div>
  <% if (upgradeHistory.rows && upgradeHistory.rows.length > 0) { %>
    <% upgradeHistory.rows.forEach(u => { %>
      <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div style="color:var(--text-main);font-size:13px;font-weight:600;"><%= t('viph_level_change').replace('{from}', u.from_level).replace('{to}', u.to_level) %></div>
          <div style="color:var(--text-muted);font-size:11px;margin-top:2px;"><%= new Date(u.created_at).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
        </div>
        <div style="color:#f59e0b;font-weight:800;font-size:14px;white-space:nowrap;">+<%= Number(u.bonus).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
      </div>
    <% }) %>
  <% } else { %>
    <div style="text-align:center;color:var(--text-muted);padding:24px;font-size:13px;"><%= t('viph_no_upgrades') %></div>
  <% } %>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

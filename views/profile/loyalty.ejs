<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz80-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz80-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz80-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz80-4 { background: linear-gradient(135deg,#7c3aed,#a855f7); border-radius: 16px; padding: 24px; margin-bottom: 16px; text-align: center; }
  .dz80-5 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz80-6 { color: var(--text-main); font-size: 34px; font-weight: 900; }
  .dz80-7 { color: rgba(255,255,255,0.9); font-size: 13px; margin-top: 4px; }
  .dz80-8 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .dz80-9 { color: var(--text-main); font-weight: bold; }
  .dz80-10 { color: #f59e0b; font-size: 12px; }
  .dz80-11 { background: rgba(255,255,255,0.1); border-radius: 20px; height: 10px; overflow: hidden; margin-bottom: 6px; }
  .dz80-12 { color: var(--text-muted); font-size: 11px; }
  .dz80-13 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
  .dz80-14 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz80-15 { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.04); border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; }
  .dz80-16 { color: var(--text-main); font-size: 13px; font-weight: 600; }
  .dz80-17 { background: #10b981; color: #fff; border: none; border-radius: 8px; padding: 8px 14px; font-size: 12px; font-weight: bold; cursor: pointer; }
  .dz80-18 { color: var(--text-main); font-weight: bold; margin-bottom: 6px; }
  .dz80-19 { color: var(--text-muted); font-size: 12px; margin-bottom: 12px; }
  .dz80-20 { width: 100%; background: #1e1e1e; border: 1px solid #333; color: #fff; padding: 12px; border-radius: 8px; margin-bottom: 10px; }
  .dz80-21 { background: rgba(148,163,184,0.1); border-radius: 8px; padding: 12px; color: var(--text-muted); font-size: 13px; text-align: center; }
  .dz80-22 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz80-23 { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz80-24 { color: var(--text-main); font-size: 13px; }
  .dz80-25 { color: var(--text-muted); font-size: 13px; text-align: center; padding: 10px; }
  .dz80-26 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  .dz80-27 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 30px; text-align: center; color: var(--text-muted); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im81-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im81-2 { font-size: 40px; margin-bottom: 4px; }
  .im81-3 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .im81-4 { margin: 0; }
  .im81-5 { width: 100%; justify-content: center; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz80-1">
  <%- include('../partials/flash') %>

  <div class="im81-1">
    <a class="dz80-2" href="/profile">←</a>
    <h1 class="dz80-3">⭐ <%= t('loy_title') %></h1>
  </div>

  <% if (loyalty) { %>
    <!-- পয়েন্ট কার্ড -->
    <div class="dz80-4">
      <div class="im81-2">⭐</div>
      <div class="dz80-5"><%= t('loy_your_points') %></div>
      <div class="dz80-6"><%= Number(loyalty.points).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
      <div class="dz80-7">
        <%= t('loy_coin_value').replace('{value}', Number(loyalty.coinValue).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
      </div>
    </div>

    <!-- VIP লেভেল প্রোগ্রেস -->
    <% if (vip) { %>
    <div class="dz80-8">
      <div class="im81-3">
        <div class="dz80-9">👑 VIP <%= vip.current ? vip.current.name : '০' %> (<%= t('loy_level') %> <%= vip.level %>)</div>
        <a class="dz80-10" href="/profile/vip"><%= t('loy_details') %> →</a>
      </div>
      <div class="dz80-11">
        <div style="width:<%= vip.progress %>%;height:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24);"></div>
      </div>
      <div class="dz80-12">
        <% if (vip.next) { %>
          <%= t('loy_to_next').replace('{value}', Number(vip.toNext).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
        <% } else { %>
          <%= t('loy_max_level') %>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- রিডেমশন শপ -->
    <div class="dz80-13">
      <div class="dz80-14">🛍️ <%= t('loy_redemption_shop') %></div>
      <% [
        { pts: 100, label: t('loy_item_10'), coins: 10 },
        { pts: 500, label: t('loy_item_50'), coins: 50 },
        { pts: 1000, label: t('loy_item_100'), coins: 100 }
      ].forEach(function(item) { %>
        <div class="dz80-15">
          <div>
            <div class="dz80-16"><%= item.label %></div>
            <div class="dz80-12"><%= t('loy_points_needed').replace('{value}', item.pts) %></div>
          </div>
          <% if (loyalty.points >= item.pts) { %>
            <form class="im81-4" action="/profile/loyalty/redeem" method="POST">
              <input type="hidden" name="points" value="<%= item.pts %>">
              <button class="dz80-17" type="submit"><%= t('loy_redeem') %></button>
            </form>
          <% } else { %>
            <span class="dz80-12"><%= t('loy_not_enough_points') %></span>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- কাস্টম রূপান্তর -->
    <div class="dz80-13">
      <div class="dz80-18">🔄 <%= t('loy_custom_convert') %></div>
      <div class="dz80-19">
        <%= t('loy_convert_rate').replace('{min}', loyalty.minRedeem) %>
      </div>
      <% if (loyalty.points >= loyalty.minRedeem) { %>
        <form action="/profile/loyalty/redeem" method="POST">
          <input class="dz80-20" type="number" name="points" placeholder="<%= t('loy_convert_placeholder') %>" min="<%= loyalty.minRedeem %>" max="<%= loyalty.points %>" required>
          <button type="submit" class="btn btn-primary im81-5">🔄 <%= t('loy_convert_button') %></button>
        </form>
      <% } else { %>
        <div class="dz80-21">
          <%= t('loy_min_required').replace('{min}', loyalty.minRedeem) %>
        </div>
      <% } %>
    </div>

    <!-- হিস্ট্রি -->
    <div class="dz80-22">
      <div class="dz80-14">📜 <%= t('loy_history') %></div>
      <% if (loyalty.history && loyalty.history.length > 0) { %>
        <% loyalty.history.forEach(h => { %>
          <div class="dz80-23">
            <div>
              <div class="dz80-24"><%= h.reason === 'earn' ? '🎮 ' + t('loy_earned') : '🔄 ' + t('loy_converted') %></div>
              <div class="dz80-12"><%= new Date(h.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
            <div style="font-size:14px;font-weight:bold;color:<%= h.points >= 0 ? '#10b981' : '#ef4444' %>;">
              <%= h.points >= 0 ? '+' : '' %><%= h.points %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz80-25"><%= t('loy_no_history') %></div>
      <% } %>
    </div>

    <p class="dz80-26">
      <%= t('loy_info_rate') %><br>
      <%= t('loy_info_games') %>
    </p>

  <% } else { %>
    <div class="dz80-27">
      <%= t('loy_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">⭐ <%= t('loy_title') %></h1>
  </div>

  <% if (loyalty) { %>
    <!-- পয়েন্ট কার্ড -->
    <div style="background:linear-gradient(135deg,#7c3aed,#a855f7);border-radius:16px;padding:24px;margin-bottom:16px;text-align:center;">
      <div style="font-size:40px;margin-bottom:4px;">⭐</div>
      <div style="color:rgba(255,255,255,0.9);font-size:13px;"><%= t('loy_your_points') %></div>
      <div style="color:var(--text-main);font-size:34px;font-weight:900;"><%= Number(loyalty.points).toLocaleString('bn-BD') %></div>
      <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:4px;">
        <%= t('loy_coin_value').replace('{value}', Number(loyalty.coinValue).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
      </div>
    </div>

    <!-- VIP লেভেল প্রোগ্রেস -->
    <% if (vip) { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;margin-bottom:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div style="color:var(--text-main);font-weight:bold;">👑 VIP <%= vip.current ? vip.current.name : '০' %> (<%= t('loy_level') %> <%= vip.level %>)</div>
        <a href="/profile/vip" style="color:#f59e0b;font-size:12px;"><%= t('loy_details') %> →</a>
      </div>
      <div style="background:rgba(255,255,255,0.1);border-radius:20px;height:10px;overflow:hidden;margin-bottom:6px;">
        <div style="width:<%= vip.progress %>%;height:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24);"></div>
      </div>
      <div style="color:var(--text-muted);font-size:11px;">
        <% if (vip.next) { %>
          <%= t('loy_to_next').replace('{value}', Number(vip.toNext).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD')) %>
        <% } else { %>
          <%= t('loy_max_level') %>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- রিডেমশন শপ -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">🛍️ <%= t('loy_redemption_shop') %></div>
      <% [
        { pts: 100, label: t('loy_item_10'), coins: 10 },
        { pts: 500, label: t('loy_item_50'), coins: 50 },
        { pts: 1000, label: t('loy_item_100'), coins: 100 }
      ].forEach(function(item) { %>
        <div style="display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,0.04);border-radius:10px;padding:12px 14px;margin-bottom:8px;">
          <div>
            <div style="color:var(--text-main);font-size:13px;font-weight:600;"><%= item.label %></div>
            <div style="color:var(--text-muted);font-size:11px;"><%= t('loy_points_needed').replace('{value}', item.pts) %></div>
          </div>
          <% if (loyalty.points >= item.pts) { %>
            <form action="/profile/loyalty/redeem" method="POST" style="margin:0;">
              <input type="hidden" name="points" value="<%= item.pts %>">
              <button type="submit" style="background:#10b981;color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:bold;cursor:pointer;"><%= t('loy_redeem') %></button>
            </form>
          <% } else { %>
            <span style="color:var(--text-muted);font-size:11px;"><%= t('loy_not_enough_points') %></span>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- কাস্টম রূপান্তর -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:6px;">🔄 <%= t('loy_custom_convert') %></div>
      <div style="color:var(--text-muted);font-size:12px;margin-bottom:12px;">
        <%= t('loy_convert_rate').replace('{min}', loyalty.minRedeem) %>
      </div>
      <% if (loyalty.points >= loyalty.minRedeem) { %>
        <form action="/profile/loyalty/redeem" method="POST">
          <input type="number" name="points" placeholder="<%= t('loy_convert_placeholder') %>" min="<%= loyalty.minRedeem %>" max="<%= loyalty.points %>" required
                 style="width:100%;background:#1e1e1e;border:1px solid #333;color:#fff;padding:12px;border-radius:8px;margin-bottom:10px;">
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">🔄 <%= t('loy_convert_button') %></button>
        </form>
      <% } else { %>
        <div style="background:rgba(148,163,184,0.1);border-radius:8px;padding:12px;color: var(--text-muted);font-size:13px;text-align:center;">
          <%= t('loy_min_required').replace('{min}', loyalty.minRedeem) %>
        </div>
      <% } %>
    </div>

    <!-- হিস্ট্রি -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">📜 <%= t('loy_history') %></div>
      <% if (loyalty.history && loyalty.history.length > 0) { %>
        <% loyalty.history.forEach(h => { %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
            <div>
              <div style="color:var(--text-main);font-size:13px;"><%= h.reason === 'earn' ? '🎮 ' + t('loy_earned') : '🔄 ' + t('loy_converted') %></div>
              <div style="color:var(--text-muted);font-size:11px;"><%= new Date(h.created_at).toLocaleDateString(locals.lang === 'en' ? 'en-US' : 'bn-BD') %></div>
            </div>
            <div style="font-size:14px;font-weight:bold;color:<%= h.points >= 0 ? '#10b981' : '#ef4444' %>;">
              <%= h.points >= 0 ? '+' : '' %><%= h.points %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="color:var(--text-muted);font-size:13px;text-align:center;padding:10px;"><%= t('loy_no_history') %></div>
      <% } %>
    </div>

    <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
      <%= t('loy_info_rate') %><br>
      <%= t('loy_info_games') %>
    </p>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color: var(--text-muted);">
      <%= t('loy_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<style nonce="<%= cspNonce %>">
  .fa-crown-banner{position:relative;text-align:center;margin:6px auto 18px;max-width:340px;}
  .fa-crown-banner .crown{font-size:38px;filter:drop-shadow(0 3px 4px rgba(0,0,0,.4));}
  .fa-crown-banner .ribbon{background:linear-gradient(180deg,#ff6b6b,#d61f1f);color:#fff;font-weight:800;font-size:18px;padding:8px 0;border-radius:30px;margin-top:-10px;border:2px solid #ffd06b;box-shadow:0 4px 10px rgba(0,0,0,.35);}
  .fa-wheel-wrap{position:relative;width:300px;height:300px;margin:0 auto 20px;}
  .fa-wheel-ring{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 50%,#ffdf8a 0%,#f0a91e 60%,#c9791a 100%);box-shadow:0 0 40px rgba(245,158,11,.5), inset 0 0 0 6px rgba(255,255,255,.25);}
  .fa-wheel-ring::before{content:'';position:absolute;inset:6px;border-radius:50%;background:repeating-conic-gradient(#fff9e8 0deg 4deg, transparent 4deg 12deg);opacity:.35;}
  .fa-bulb{position:absolute;width:8px;height:8px;border-radius:50%;background:#fff8d6;box-shadow:0 0 6px 2px rgba(255,220,120,.9);}
  .fa-wheel-canvas-holder{position:absolute;inset:14px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 4px rgba(0,0,0,.15) inset;}
  .fa-go-btn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:64px;height:64px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff8a8a,#c81d1d);border:3px solid #ffe08a;color:#fff;font-weight:800;font-size:16px;cursor:pointer;z-index:5;box-shadow:0 4px 12px rgba(0,0,0,.5);}
  .fa-go-btn:disabled{opacity:.5;cursor:default;}
  .fa-pointer{position:absolute;top:-10px;left:50%;transform:translateX(-50%);z-index:10;font-size:34px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.5));}
</style>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;text-align:center;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
  </div>

  <div class="fa-crown-banner">
    <div class="crown">👑</div>
    <div class="ribbon"><%= t('whl_title') %></div>
  </div>

  <div style="color:var(--text-muted);font-size:13px;margin-bottom:6px;"><%= t('whl_sub') %></div>
  <div style="color:#f59e0b;font-size:13px;font-weight:bold;margin-bottom:20px;">
    <%= t('whl_remaining').replace('{n}', remainingToday || 0) %>
  </div>

  <!-- হুইল -->
  <div class="fa-wheel-wrap">
    <div class="fa-pointer">🔻</div>
    <div class="fa-wheel-ring" id="wheelBulbs"></div>
    <div class="fa-wheel-canvas-holder">
      <canvas id="wheelCanvas" width="272" height="272"></canvas>
    </div>
    <button id="spinBtn" class="fa-go-btn" <%= (status && status.canSpin) ? '' : 'disabled' %>>GO</button>
  </div>

  <% if (status && status.locked) { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;color: var(--text-muted);font-size:14px;">
      🔒 <%= t('whl_locked') %><br>
      <%= t('whl_locked_sub') %>
    </div>
  <% } else if (!(status && status.canSpin)) { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;color: var(--text-muted);font-size:14px;">
      ✅ <%= t('whl_done') %><% if (status && status.prize) { %> <%- t('whl_won').replace('{value}', '<strong style="color:#f59e0b;">' + status.prize + '</strong>') %><% } %><br>
      <%= t('whl_come_back') %>
    </div>
  <% } %>

  <div id="result" style="margin-top:20px;font-size:18px;font-weight:bold;color:#10b981;"></div>

  <!-- স্পিন হিস্ট্রি / প্রাইজ লগ -->
  <div style="margin-top:30px;text-align:left;">
    <div style="color:var(--text-main);font-size:15px;font-weight:bold;margin-bottom:10px;">🧾 <%= t('whl_history') %></div>
    <% if (history && history.length) { %>
      <% history.forEach(function(h) { %>
        <div style="display:flex;justify-content:space-between;background:rgba(255,255,255,0.05);border-radius:10px;padding:10px 14px;margin-bottom:8px;">
          <span style="color:var(--text-muted);font-size:13px;"><%= h.spin_date %></span>
          <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= t('whl_coins').replace('{value}', h.prize) %></span>
        </div>
      <% }); %>
    <% } else { %>
      <div style="color:var(--text-muted);font-size:13px;text-align:center;padding:16px;"><%= t('whl_no_history') %></div>
    <% } %>
  </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/canvas-confetti/1.9.3/confetti.browser.min.js"></script>
<script type="application/json" id="profile-wheelConfig"><%- jsonScriptSafe({ segmentCount: Number(locals.segmentCount) || 12 }) %></script>
<script src="/js/views/profile-wheel.js"></script>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold;">👑 VIP প্রোগ্রাম</h1>
  </div>

  <% if (vip) { %>
    <!-- বর্তমান লেভেল কার্ড -->
    <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:16px;padding:24px;margin-bottom:16px;text-align:center;">
      <div style="font-size:44px;margin-bottom:4px;">👑</div>
      <div style="color:#fff;font-size:22px;font-weight:900;"><%= vip.current.name %></div>
      <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:2px;">VIP লেভেল <%= vip.level %></div>
    </div>

    <!-- প্রোগ্রেস -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
        <span style="color:#94a3b8;font-size:13px;">মোট টার্নওভার</span>
        <span style="color:#f59e0b;font-size:14px;font-weight:bold;"><%= Number(vip.totalTurnover).toLocaleString('bn-BD') %></span>
      </div>

      <div style="background:rgba(255,255,255,0.1);border-radius:20px;height:14px;overflow:hidden;margin:10px 0;">
        <div style="width:<%= vip.progress %>%;height:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24);transition:width .5s;"></div>
      </div>

      <% if (vip.next) { %>
        <div style="color:#94a3b8;font-size:12px;text-align:center;">
          পরের লেভেল <strong style="color:#fff;"><%= vip.next.name %></strong> পেতে আরও
          <strong style="color:#f59e0b;"><%= Number(vip.toNext).toLocaleString('bn-BD') %></strong> টার্নওভার দরকার
        </div>
      <% } else { %>
        <div style="color:#10b981;font-size:13px;text-align:center;font-weight:bold;">🎉 আপনি সর্বোচ্চ VIP লেভেলে আছেন!</div>
      <% } %>
    </div>

    <!-- সব লেভেল তালিকা -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
      <div style="color:#fff;font-weight:bold;margin-bottom:12px;">📊 VIP লেভেলসমূহ</div>
      <% vip.levels.forEach(l => {
        const isCurrent = l.level === vip.level;
        const reached = vip.totalTurnover >= Number(l.min_turnover);
      %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;margin-bottom:8px;border-radius:10px;background:<%= isCurrent ? 'rgba(245,158,11,0.15)' : 'rgba(255,255,255,0.03)' %>;border:1px solid <%= isCurrent ? '#f59e0b' : 'transparent' %>;">
          <div>
            <div style="color:<%= reached ? '#fff' : '#94a3b8' %>;font-size:14px;font-weight:bold;">
              <%= reached ? '✅' : '🔒' %> <%= l.name %> (লেভেল <%= l.level %>)
            </div>
            <div style="color:#94a3b8;font-size:11px;margin-top:2px;">
              টার্নওভার: <%= Number(l.min_turnover).toLocaleString('bn-BD') %>
            </div>
          </div>
          <div style="text-align:right;">
            <% if (l.upgrade_bonus > 0) { %>
              <div style="color:#10b981;font-size:12px;font-weight:bold;">+<%= l.upgrade_bonus %></div>
              <div style="color:#94a3b8;font-size:10px;">আপগ্রেড বোনাস</div>
            <% } else { %>
              <div style="color:#94a3b8;font-size:11px;">শুরুর লেভেল</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <p style="font-size:.75rem;color:#94a3b8;text-align:center;margin-top:1rem;line-height:1.6;">
      যত বেশি খেলবেন (টার্নওভার), তত উঁচু VIP লেভেল।<br>
      প্রতি নতুন লেভেলে আপগ্রেড বোনাস স্বয়ংক্রিয়ভাবে যোগ হয়।
    </p>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color:#94a3b8;">
      VIP তথ্য লোড করা যায়নি। পরে আবার চেষ্টা করুন।
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz77-1 { padding: 15px; padding-bottom: 100px; }
  .dz77-2 { color: var(--text-main); text-decoration: none; width: 40px; height: 40px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .dz77-3 { color: var(--text-main); font-size: 20px; font-weight: 800; }
  .dz77-4 { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 14px; padding: 14px 16px; }
  .dz77-5 { color: var(--text-main); font-size: 13px; font-weight: 700; }
  .dz77-6 { color: var(--text-muted); font-size: 11px; margin-top: 6px; }
  .dz77-7 { background: rgba(245,158,11,0.15); color: var(--text-accent); font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 20px; white-space: nowrap; }
  .dz77-8 { color: var(--text-muted); font-size: 11px; margin-top: 8px; text-align: right; }
  .dz77-9 { text-align: center; padding: 40px 0; color: var(--text-muted); font-size: 13px; }
  .dz77-10 { flex: 1; text-align: center; background: var(--bg-card); border: 1px solid var(--border-glass); color: var(--text-main); padding: 12px; border-radius: 12px; font-size: 12px; font-weight: 700; text-decoration: none; }
  .dz77-11 { flex: 1; text-align: center; background: var(--grad-gold); color: #000; padding: 12px; border-radius: 12px; font-size: 12px; font-weight: 800; text-decoration: none; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im78-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .im78-2 { display: flex; flex-direction: column; gap: 10px; }
  .im78-3 { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .im78-4 { display: flex; justify-content: space-between; gap: 10px; margin-top: 18px; }
</style>


<div class="container dz77-1">
  <div class="im78-1">
    <a class="dz77-2" href="/profile/security">
      <i class="fas fa-chevron-left"></i>
    </a>
    <h1 class="dz77-3"><%= t.login_history_title %></h1>
  </div>

  <%- include('../partials/flash') %>

  <div class="im78-2">
    <% if (logins && logins.length) { %>
      <% logins.forEach(function(l) { %>
        <div class="dz77-4">
          <div class="im78-3">
            <div>
              <div class="dz77-5">
                <i class="fas <%= l.deviceType === 'Mobile' ? 'fa-mobile-screen' : (l.deviceType === 'Tablet' ? 'fa-tablet-screen-button' : 'fa-desktop') %>"></i>
                <%= l.browser %> · <%= l.os %>
              </div>
              <div class="dz77-6"><%= l.ip %><%= l.location ? ' · ' + l.location : '' %></div>
            </div>
            <% if (l.is_new_device) { %>
              <span class="dz77-7"><%= t.new_device_badge %></span>
            <% } %>
          </div>
          <div class="dz77-8">
            <%= new Date(l.created_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="dz77-9"><%= t.no_login_history %></div>
    <% } %>
  </div>

  <% if ((page && page > 1) || hasMore) { %>
    <div class="im78-4">
      <% if (page > 1) { %>
        <a class="dz77-10" href="/profile/login-history?page=<%= page - 1 %>"><%= t.back_to_page_prev %></a>
      <% } %>
      <% if (hasMore) { %>
        <a class="dz77-11" href="/profile/login-history?page=<%= page + 1 %>"><%= t.back_to_page_next %></a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

             var meta = iconMap[act.kind] || ['fa-circle-dot', 'rgba(255,255,255,.5)'];
             var labelMap = { login: 'লগইন', deposit: 'ডিপোজিট', withdraw: 'উইথড্র', vip_upgrade: 'VIP আপগ্রেড', reward_claim: 'রিওয়ার্ড ক্লেইম' };
             var label = labelMap[act.kind] || act.kind;
        %>
        <div class="pf-activity-row">

<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <!-- Premium Profile Header -->
  <div style="background: linear-gradient(135deg, #002d0b, #004d13); border-radius: 24px; padding: 25px 20px; margin-bottom: 20px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
    <!-- Decorative element -->
    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.1) 0%, transparent 70%); border-radius: 50%;"></div>

    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--grad-gold); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.5); border: 3px solid rgba(255,255,255,0.1);">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px;">
          👑
        </div>
      </div>

      <div style="flex: 1;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= user.username %></span>
          <span style="background: var(--gold); color: #000; font-size: 10px; padding: 2px 10px; border-radius: 20px; font-weight: 900; text-transform: uppercase;">VIP<%= Math.floor(user.total_points / 1000) %></span>
        </div>
        <div style="color: rgba(255,255,255,0.6); font-size: 12px; margin-top: 4px;">ID: <%= 100000 + user.id %></div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
           <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span style="font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold);"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div style="margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">মোট ব্যালেন্স</div>
          <div style="color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2;">৳ <%= user.coins.toLocaleString('bn-BD') %></div>
        </div>
        <a href="/profile/transactions" style="background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          <i class="fas fa-history"></i>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
        <a href="/payment/deposit" style="background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-plus-circle"></i>
          জমা দিন
        </a>
        <a href="/payment/withdraw" style="background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-hand-holding-usd"></i>
          উত্তোলন
        </a>
        <a href="/profile/referral" style="background: rgba(255,255,255,0.08); color: #fff; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-share-alt"></i>
          রেফারেল
        </a>
      </div>
    </div>
  </div>

  <!-- Quick Menu Grid (4x2) -->
  <div style="background: var(--bg-card); border-radius: 20px; padding: 20px; border: 1px solid var(--border-glass); margin-bottom: 20px;">
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px 10px;">

      <a href="/payment/deposit" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(245, 158, 11, 0.2);">
          <i class="fas fa-wallet"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">ডিপোজিট</div>
      </a>

      <a href="/payment/withdraw" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #10b981, #059669); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(16, 185, 129, 0.2);">
          <i class="fas fa-money-bill-wave"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">উইথড্র</div>
      </a>

      <a href="/profile/transactions" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #3b82f6, #2563eb); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(59, 130, 246, 0.2);">
          <i class="fas fa-exchange-alt"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">ট্রান্সফার</div>
      </a>

      <a href="/profile/history" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(139, 92, 246, 0.2);">
          <i class="fas fa-list-alt"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">রেকর্ড</div>
      </a>

      <a href="/profile/missions" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #ec4899, #db2777); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(236, 72, 153, 0.2);">
          <i class="fas fa-tasks"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">অ্যাক্টিভিটি</div>
      </a>

      <a href="/extra/promotion" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #f97316, #ea580c); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(249, 115, 22, 0.2);">
          <i class="fas fa-percentage"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">প্রমোশন</div>
      </a>

      <a href="/profile/rewards" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #facc15, #ca8a04); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(250, 204, 21, 0.2);">
          <i class="fas fa-crown"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">VIP</div>
      </a>

      <a href="/chat" style="text-decoration: none; text-align: center;">
        <div style="width: 45px; height: 45px; border-radius: 14px; background: linear-gradient(135deg, #06b6d4, #0891b2); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: #fff; font-size: 18px; box-shadow: 0 5px 15px rgba(6, 182, 212, 0.2);">
          <i class="fas fa-headset"></i>
        </div>
        <div style="color: var(--text-main); font-size: 11px; font-weight: 600;">সাপোর্ট</div>
      </a>

  <!-- Menu List -->

<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Class selectors are repeated so the generated rules keep
     the specificity the inline declarations had, without !important —
     JS-set element.style still wins. */
  .rs2-1.rs2-1.rs2-1 { padding: 15px; padding-bottom: 100px; }
  .rs2-2.rs2-2.rs2-2 { background: linear-gradient(135deg, #002d0b, #004d13); border-radius: 24px; padding: 25px 20px; margin-bottom: 20px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
  .rs2-3.rs2-3.rs2-3 { position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.1) 0%, transparent 70%); border-radius: 50%; }
  .rs2-4.rs2-4.rs2-4 { display: flex; align-items: center; gap: 20px; position: relative; z-index: 1; }
  .rs2-5.rs2-5.rs2-5 { position: relative; }
  .rs2-6.rs2-6.rs2-6 { position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer; }
  .rs2-7.rs2-7.rs2-7 { font-size: 12px; color: var(--gold); }
  .rs2-8.rs2-8.rs2-8 { flex: 1; min-width: 0; }
  .rs2-9.rs2-9.rs2-9 { display: flex; align-items: center; gap: 8px; }
  .rs2-10.rs2-10.rs2-10 { color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px; overflow-wrap:anywhere; }
  .rs2-11.rs2-11.rs2-11 { background: rgba(255,255,255,0.08); border: none; width: 24px; height: 24px; border-radius: 6px; color: var(--gold); cursor: pointer; flex-shrink:0; }
  .rs2-12.rs2-12.rs2-12 { font-size: 10px; }
  .rs2-13.rs2-13.rs2-13 { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; margin-top: 6px; }
  .rs2-14.rs2-14.rs2-14 { background: var(--gold); color: #000; font-size: 10px; padding: 2px 10px; border-radius: 20px; font-weight: 900; text-transform: uppercase; }
  .rs2-15.rs2-15.rs2-15 { display:flex; align-items:center; gap:6px; color: rgba(255,255,255,0.6); font-size: 12px; margin-top: 6px; }
  .rs2-16.rs2-16.rs2-16 { background: rgba(255,255,255,0.08); border: none; width: 20px; height: 20px; border-radius: 6px; color: var(--gold); cursor: pointer; }
  .rs2-17.rs2-17.rs2-17 { font-size: 9px; }
  .rs2-18.rs2-18.rs2-18 { display:flex; align-items:center; gap:8px; margin-top: 6px; }
  .rs2-19.rs2-19.rs2-19 { background: rgba(255,255,255,0.08); border: none; padding: 4px 8px; border-radius: 6px; color: var(--gold); cursor: pointer; font-size: 10px; display:flex; align-items:center; gap:4px; }
  .rs2-20.rs2-20.rs2-20 { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
  .rs2-21.rs2-21.rs2-21 { flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden; }
  .rs2-22.rs2-22.rs2-22 { font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold); }
  .rs2-23.rs2-23.rs2-23 { margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px); }
  .rs2-24.rs2-24.rs2-24 { display: flex; justify-content: space-between; align-items: center; }
  .rs2-25.rs2-25.rs2-25 { color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
  .rs2-26.rs2-26.rs2-26 { display:flex; align-items:center; gap:8px; }
  .rs2-27.rs2-27.rs2-27 { color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2; }
  .rs2-28.rs2-28.rs2-28 { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; }
  .rs2-29.rs2-29.rs2-29 { font-size: 13px; }
  .rs2-30.rs2-30.rs2-30 { color: var(--text-muted); font-size: 10px; }
  .rs2-31.rs2-31.rs2-31 { background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; }
  .rs2-32.rs2-32.rs2-32 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px; }
  .rs2-33.rs2-33.rs2-33 { background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .rs2-34.rs2-34.rs2-34 { background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .rs2-35.rs2-35.rs2-35 { background: rgba(255,255,255,0.08); color: #fff; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .rs2-36.rs2-36.rs2-36 { background: var(--bg-card); border-radius: 20px; padding: 20px; border: 1px solid var(--border-glass); }
  .rs2-37.rs2-37.rs2-37 { color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }
  .rs2-38.rs2-38.rs2-38 { text-align: center; margin-top: 30px; padding-bottom: 20px; }
  .rs2-39.rs2-39.rs2-39 { color: var(--text-muted); font-size: 12px; }
  .rs2-40.rs2-40.rs2-40 { color: var(--text-muted); font-size: 11px; margin-top: 5px; }
  .rs2-41.rs2-41.rs2-41 { position:fixed; bottom:90px; left:50%; transform:translateX(-50%) translateY(20px); opacity:0; transition:0.3s; background:#000; color:#fff; padding:10px 18px; border-radius:20px; font-size:13px; z-index:999; pointer-events:none; }
  .rs2-42.rs2-42.rs2-42 { background:var(--bg-card, #10251a); border-radius:20px; padding:20px; max-width:360px; width:100%; border:1px solid rgba(245,158,11,0.3); }
  .rs2-43.rs2-43.rs2-43 { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
  .rs2-44.rs2-44.rs2-44 { color:#fff; font-weight:800; }
  .rs2-45.rs2-45.rs2-45 { color:#fff; cursor:pointer; font-size:18px; }
  .rs2-46.rs2-46.rs2-46 { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
</style>

<div class="container rs2-1">
  <%- include('../partials/flash') %>
  <!-- Premium Profile Header -->
  <div class="rs2-2">
    <div class="rs2-3"></div>

    <div class="rs2-4">
      <div class="rs2-5">
        <div id="avatarCircle" data-profile-action="avatar-open" style="width: 80px; height: 80px; border-radius: 50%; background: <%= user.avatar ? 'transparent' : 'var(--grad-gold)' %>; background-image: <%= user.avatar ? "url('" + user.avatar + "')" : 'none' %>; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.5); border: 3px solid rgba(255,255,255,0.1); cursor: pointer;">
          <% if (!user.avatar) { %><%= user.username.charAt(0).toUpperCase() %><% } %>
        </div>
        <div class="rs2-6" data-profile-action="avatar-open">
          <i class="fas fa-camera rs2-7"></i>
        </div>
      </div>

      <div class="rs2-8">
        <div class="rs2-9">
          <span class="rs2-10" id="usernameText"><%= user.username %></span>
          <button class="rs2-11" type="button" data-profile-action="copy-username" aria-label="<%= t.copy_username || 'Copy username' %>">
            <i class="fas fa-copy rs2-12"></i>
          </button>
        </div>
        <a href="/profile/vip" class="pf-vip-badge-sm rs2-13">
          <span class="rs2-14">VIP<%= user.vip_level || 0 %></span>
        </a>
        <div class="rs2-15">
          <span>ID: <%= 100000 + user.id %></span>
          <button class="rs2-16" type="button" data-profile-action="copy-uid" aria-label="<%= t.copy_uid || 'Copy ID' %>">
            <i class="fas fa-copy rs2-17"></i>
          </button>
        </div>
        <div style="display:none;">
          <span id="profileUrlText"><%= baseUrl %>/profile</span>
        </div>
        <div class="rs2-18">
          <button class="rs2-19" type="button" data-profile-action="copy-profile-url" aria-label="<%= t.copy_profile_url || 'Copy profile link' %>">
            <i class="fas fa-link rs2-17"></i> <%= t.copy_link || 'Copy Link' %>
          </button>
          <button class="rs2-19" type="button" data-profile-action="share-profile-url" aria-label="<%= t.share_profile || 'Share profile' %>">
            <i class="fas fa-share-alt rs2-17"></i> <%= t.share || 'Share' %>
          </button>
        </div>
        <div class="rs2-20">
           <div class="rs2-21">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span class="rs2-22"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div class="rs2-23">
      <div class="rs2-24">
        <div>
          <div class="rs2-25"><%= t.total_balance %></div>
          <div class="rs2-26">
            <div class="rs2-27" id="balanceText">৳ <%= user.coins.toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
            <button class="rs2-28" type="button" data-profile-action="refresh-balance" aria-label="<%= t.refresh_balance || 'Refresh balance' %>">
              <i id="refreshIcon" class="fas fa-sync-alt rs2-29"></i>
            </button>
          </div>
          <div class="rs2-30" id="lastUpdatedText"></div>
        </div>
        <a class="rs2-31" href="/profile/transactions">
          <i class="fas fa-history"></i>
        </a>
      </div>

      <div class="rs2-32">
        <a class="rs2-33" href="/payment/deposit">
          <i class="fas fa-plus-circle"></i>
          <%= t.deposit %>
        </a>
        <a class="rs2-34" href="/payment/withdraw">
          <i class="fas fa-hand-holding-usd"></i>
          <%= t.withdraw %>
        </a>
        <a class="rs2-35" href="/profile/cards">
          <i class="fas fa-credit-card"></i>
          Bank Account
        </a>
      </div>
    </div>
  </div>

  <!-- Member Center: flat grid, every feature is one tap away -->
  <div class="rs2-36">
    <div class="rs2-37"><%= t.member_center %></div>

    <div class="mc-flat-grid">

      <a href="/profile/rewards" class="mc-tile">
        <div class="mc-tile-icon">
          <i class="fas fa-trophy"></i>
          <span class="mc-tile-badge" data-badge="reward" style="display:none;"></span>
        </div>
        <span class="mc-tile-label">Reward Center</span>
      </a>

      <a href="/profile/history" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-clipboard-list"></i></div>
        <span class="mc-tile-label">Betting Record</span>
      </a>

      <a href="/profile/stats" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-chart-pie"></i></div>
        <span class="mc-tile-label">Profit And Loss</span>
      </a>

      <a href="/payment/history?type=deposit" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-file-invoice-dollar"></i></div>
        <span class="mc-tile-label">Deposit Record</span>
      </a>

      <a href="/payment/history?type=withdraw" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-hand-holding-usd"></i></div>
        <span class="mc-tile-label">Withdrawal Record</span>
      </a>

      <a href="/profile/transactions" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-file-alt"></i></div>
        <span class="mc-tile-label">Account Record</span>
      </a>

      <a href="/profile/wheel" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-dharmachakra"></i></div>
        <span class="mc-tile-label">Lucky Wheel</span>
      </a>

      <a href="/profile/missions" class="mc-tile">
        <div class="mc-tile-icon">
          <i class="fas fa-bullseye"></i>
          <span class="mc-tile-badge" data-badge="mission" style="display:none;"></span>
        </div>
        <span class="mc-tile-label">Mission</span>
      </a>

      <a href="/profile/chat" class="mc-tile">
        <div class="mc-tile-icon">
          <i class="fas fa-envelope"></i>
          <span class="mc-tile-badge" data-badge="message" style="display:none;"></span>
        </div>
        <span class="mc-tile-label">Internal Message</span>
      </a>

      <a href="/profile/badges" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-medal"></i></div>
        <span class="mc-tile-label">Badges</span>
      </a>

      <a href="/profile/loyalty" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-gem"></i></div>
        <span class="mc-tile-label">Loyalty</span>
      </a>

      <a href="/profile/streak" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-fire"></i></div>
        <span class="mc-tile-label">Daily Streak</span>
      </a>

      <a href="/profile/freebet" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-ticket-alt"></i></div>
        <span class="mc-tile-label">Free Bet</span>
      </a>

      <a href="/profile/periodic" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-calendar-check"></i></div>
        <span class="mc-tile-label">Periodic Reward</span>
      </a>

      <a href="/profile/cashback" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-coins"></i></div>
        <span class="mc-tile-label">Rebate</span>
      </a>

      <a href="/profile/contest" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-flag-checkered"></i></div>
        <span class="mc-tile-label">Contest</span>
      </a>

      <a href="/profile/referral" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-user-plus"></i></div>
        <span class="mc-tile-label">Invite Friends</span>
      </a>

      <a href="/profile/share" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-share-alt"></i></div>
        <span class="mc-tile-label">Share</span>
      </a>

      <a href="/profile/responsible" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-hand-holding-heart"></i></div>
        <span class="mc-tile-label">Responsible Gaming</span>
      </a>

      <a href="/extra/kyc" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-id-card"></i></div>
        <span class="mc-tile-label">KYC Verification</span>
      </a>

      <a href="/profile/vip" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-crown"></i></div>
        <span class="mc-tile-label">VIP</span>
      </a>

      <a href="/profile/security" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-shield-alt"></i></div>
        <span class="mc-tile-label">সিকিউরিটি সেন্টার</span>
        <span class="mc-tile-sublabel">পাসওয়ার্ড · লগইন হিস্টোরি</span>
      </a>

      <a href="/notifications" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-envelope"></i></div>
        <span class="mc-tile-label">Internal Message</span>
      </a>

      <a href="/profile/feedback" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-comment-alt"></i></div>
        <span class="mc-tile-label">Suggestion</span>
      </a>

      <a href="/profile/app-download" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-mobile-alt"></i></div>
        <span class="mc-tile-label">Download APP</span>
      </a>

      <a href="/profile/chat" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-headset"></i></div>
        <span class="mc-tile-label">Customer Service</span>
      </a>

      <a href="/help-center" class="mc-tile">
        <div class="mc-tile-icon"><i class="fas fa-question-circle"></i></div>

<%- include('../partials/head') %>

  <!-- Profile Card -->
  <div style="background:linear-gradient(135deg,#002d0b,#004d13);border-radius:16px;padding:20px;margin-bottom:16px;position:relative;overflow:hidden; border: 1px solid rgba(245,158,11,0.3);">
    <div style="display:flex;align-items:center;gap:16px">
      <div style="width:70px;height:70px;border-radius:50%;background:var(--grad-gold);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:bold;color:#000; box-shadow: 0 0 15px rgba(245,158,11,0.4);">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div style="display:flex;align-items:center;gap:8px">
          <span style="color:#fff;font-size:18px;font-weight:bold"><%= user.username %></span>
          <span style="background:var(--gold);color:#000;font-size:11px;padding:2px 8px;border-radius:20px; font-weight: bold;">VIP0</span>
        </div>
        <div style="color:#94a3b8;font-size:13px;margin-top:4px">যোগদান: <%= new Date(user.created_at).toLocaleDateString('bn-BD') %></div>
        <div style="color:var(--gold);font-size:22px;font-weight:bold;margin-top:4px; font-family: 'Teko', sans-serif;">💰 <%= t.balance %>: ৳<%= user.coins %></div>
      </div>
    </div>

    <div style="display:flex;gap:8px;margin-top:16px">
      <a href="/payment/deposit" style="flex:1;background:var(--grad-gold);color:#000;padding:10px;border-radius:8px;text-align:center;text-decoration:none;font-size:14px;font-weight:bold">জমা দিন</a>
      <a href="/payment/withdraw" style="flex:1;background:rgba(255,255,255,0.1);color:var(--gold);padding:10px;border-radius:8px;text-align:center;text-decoration:none;font-size:14px;font-weight:bold;border:1px solid rgba(245,158,11,0.3)">উত্তোলন</a>
      <a href="/profile/referral" style="flex:1;background:rgba(255,255,255,0.1);color:#fff;padding:10px;border-radius:8px;text-align:center;text-decoration:none;font-size:14px">রেফারেল</a>
    </div>
  </div>

  <!-- Menu Grid -->
  <div style="background:rgba(255,255,255,0.03);border-radius:16px;padding:16px; border: 1px solid var(--border-glass);">
    <div style="color:#94a3b8;font-size:13px;margin-bottom:12px">সদস্য সেন্টার</div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px">

      <a href="/profile/rewards" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#ef4444);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">🏆</div>
        <div style="color:#fff;font-size:11px">পুরস্কার সেন্টার</div>
      </a>

      <a href="/profile/missions" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#8b5cf6,#6366f1);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">🎯</div>
        <div style="color:#fff;font-size:11px">মিশন</div>
      </a>

      <a href="/profile/referral" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#10b981,#06b6d4);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">👥</div>
        <div style="color:#fff;font-size:11px">বন্ধু আমন্ত্রণ</div>
      </a>

      <a href="/profile/security" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#8b5cf6);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">🔒</div>
        <div style="color:#fff;font-size:11px">সুরক্ষা কেন্দ্র</div>
      </a>

      <a href="/leaderboard" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#fbbf24);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">📊</div>
        <div style="color:#fff;font-size:11px">লিডারবোর্ড</div>
      </a>

      <a href="/profile/transactions" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#ec4899,#f43f5e);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">💳</div>
        <div style="color:#fff;font-size:11px">লেনদেন</div>
      </a>

      <a href="/chat" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#06b6d4,#3b82f6);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">💬</div>
        <div style="color:#fff;font-size:11px">সাপোর্ট</div>
      </a>

      <a href="/logout" style="text-decoration:none;text-align:center">
        <div style="width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-size:22px">🚪</div>
        <div style="color:#94a3b8;font-size:11px">লগআউট</div>
      </a>

  <!-- Menu List -->
  <div style="margin: 0 15px; background: var(--bg-surface); border-radius: 15px; overflow: hidden; border: 1px solid var(--border-glass);">
    <a href="/profile/security" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-user-shield" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">আমার তথ্য</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/profile/transactions" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-wallet" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">আমার ওয়ালেট</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/profile/history" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-file-invoice-dollar" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">বেট রেকর্ড</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/profile/transactions" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-list-ul" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">লেনদেনের রেকর্ড</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/profile/security" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-lock" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">নিরাপত্তা কেন্দ্র</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/notifications" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-envelope" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">মেসেজ সেন্টার</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/profile/referral" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-users" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">বন্ধুদের আমন্ত্রণ জানান</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="#" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <i class="fas fa-info-circle" style="width: 25px; color: var(--gold);"></i>
      <span style="flex: 1; font-size: 14px;">আমাদের সম্পর্কে</span>
      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/logout" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: #ef4444;">
      <i class="fas fa-sign-out-alt" style="width: 25px;"></i>
      <span style="flex: 1; font-size: 14px;">লগআউট</span>
    </a>
  </div>

</div>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

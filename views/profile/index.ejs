<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <!-- Premium Profile Header - Exact Green Match -->
  <div style="background: linear-gradient(135deg, #0a1f0a, #1a3c1a); border-radius: 24px; padding: 25px 20px; margin-bottom: 20px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.4); box-shadow: 0 10px 30px rgba(0,0,0,0.6);">
    
    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: #111; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #fff; box-shadow: 0 0 20px rgba(245,158,11,0.6); border: 4px solid #facc15;">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 3px solid #facc15; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 18px;">👑</div>
      </div>

      <div style="flex: 1;">
        <div style="color: #fff; font-size: 22px; font-weight: 800;"><%= user.username %></div>
        <div style="color: #facc15; font-size: 13px;">VIP<%= user.vip_level || 0 %></div>
        <div style="color: rgba(255,255,255,0.7); font-size: 13px;">ID: <%= 100000 + user.id %></div>
      </div>
    </div>

    <!-- Balance -->
    <div style="margin-top: 28px; background: rgba(0,0,0,0.4); border-radius: 18px; padding: 18px; border: 1px solid rgba(250,204,21,0.2);">
      <div style="color: rgba(255,255,255,0.6); font-size: 12px;">মোট ব্যালেন্স</div>
      <div style="color: #facc15; font-size: 36px; font-weight: 900; letter-spacing: -1px;">৳ <%= user.coins.toLocaleString('bn-BD') %></div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 18px;">
        <a href="/payment/deposit" style="background: #facc15; color: #000; padding: 14px 10px; border-radius: 14px; text-align: center; font-weight: 800; font-size: 14px;">+ ডিপোজিট</a>
        <a href="/payment/withdraw" style="background: #1f3a1f; color: #facc15; padding: 14px 10px; border-radius: 14px; text-align: center; font-weight: 800; border: 1px solid #facc15;">উইথড্র</a>
        <a href="/profile/cards" style="background: #1f3a1f; color: #fff; padding: 14px 10px; border-radius: 14px; text-align: center; font-weight: 800; border: 1px solid rgba(255,255,255,0.2);">আমার কার্ড</a>
      </div>
    </div>
  </div>

  <!-- Bonus & Rewards - Exact Grid Match -->
  <div style="background: #112211; border-radius: 24px; padding: 22px; margin-bottom: 20px; border: 1px solid rgba(245,158,11,0.2);">
    <div style="color: #facc15; font-size: 15px; font-weight: 800; margin-bottom: 18px;">🎁 বোনাস ও রিওয়ার্ড</div>
    
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px 8px; text-align: center;">
      <!-- All 11 items from screenshot - links ready -->
      <a href="/profile/rewards" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🎁</div><div style="font-size:11px">দৈনিক রিওয়ার্ড</div></a>
      <a href="/profile/cashback" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">💸</div><div style="font-size:11px">ক্যাশব্যাক</div></a>
      <a href="/profile/periodic" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">📅</div><div style="font-size:11px">সাপ্তাহিক/মাসিক</div></a>
      <a href="/profile/wheel" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🎡</div><div style="font-size:11px">লাকি হুইল</div></a>
      <a href="/profile/missions" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🎯</div><div style="font-size:11px">মিশন</div></a>
      <a href="/profile/loyalty" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">⭐</div><div style="font-size:11px">পয়েন্ট</div></a>
      <a href="/profile/streak" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🔥</div><div style="font-size:11px">হট স্ট্রিক</div></a>
      <a href="/profile/badges" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🏆</div><div style="font-size:11px">ব্যাজ</div></a>
      <a href="/profile/freebet" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🎟️</div><div style="font-size:11px">ফ্রি বেট</div></a>
      <a href="/profile/share" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">📨</div><div style="font-size:11px">শেয়ার বোনাস</div></a>
      <a href="/profile/contest" style="text-decoration:none;color:inherit"><div style="font-size:32px;margin-bottom:4px">🥇</div><div style="font-size:11px">কনটেস্ট</div></a>
    </div>
  </div>

  <!-- Member Center -->
  <div style="background: #112211; border-radius: 24px; padding: 22px; border: 1px solid rgba(245,158,11,0.2);">
    <div style="color: #aaa; font-size: 13px; margin-bottom: 18px;">সদস্য সেন্টার</div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px 10px; text-align: center;">
      <!-- Your existing icons updated to match design -->
      <a href="/profile/referral" style="text-decoration:none;color:inherit"><div style="font-size:28px">👤+</div><div style="font-size:11px;margin-top:4px">বন্ধু আমন্ত্রণ</div></a>
      <a href="/profile/history" style="text-decoration:none;color:inherit"><div style="font-size:28px">📋</div><div style="font-size:11px;margin-top:4px">বেট রেকর্ড</div></a>
      <a href="/profile/stats" style="text-decoration:none;color:inherit"><div style="font-size:28px">📈</div><div style="font-size:11px;margin-top:4px">লাভ এবং লস</div></a>
      <a href="/profile/transactions" style="text-decoration:none;color:inherit"><div style="font-size:28px">💵</div><div style="font-size:11px;margin-top:4px">লেনদেন রেকর্ড</div></a>
    </div>
  </div>
</div>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

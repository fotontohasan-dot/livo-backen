            <div class="pf-activity-time"><%= new Date(act.created_at).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %></div>
          </div>

<%- include('../partials/head') %>

<style>
/* ──────────────────── Profile CSS ──────────────────── */
/* ব্র্যান্ড গোল্ড গ্লোবাল টোকেন থেকেই আসে — এখানে হার্ডকোড করলে থিম সুইচে আটকে যেত */
:root{--gg:var(--grad-gold)}
.pf-wrap{max-width:520px;margin:0 auto;padding:0 0 110px;background:transparent}

/* Verify banner */
.pf-verify-banner{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:14px;padding:12px 14px;margin:10px 12px;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:var(--text-main)}
.pf-verify-text{flex:1;min-width:0}
.pf-verify-btn{background:rgba(239,68,68,.8);color:#fff;border:none;padding:6px 14px;border-radius:20px;font-size:12.5px;font-weight:700;cursor:pointer}

/* Header */
.pf-header{background:linear-gradient(160deg,#1a2235,#0d1117);padding:16px 14px 20px;position:relative;overflow:hidden}
.pf-header-glow{position:absolute;top:-60px;right:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(245,166,35,.18),transparent 70%);border-radius:50%;pointer-events:none}
.pf-header-top{display:flex;align-items:center;gap:14px;position:relative;z-index:2}
.pf-header-balance-row{display:flex;align-items:flex-end;justify-content:space-between;margin-top:18px;position:relative;z-index:2}
.pf-header-balance-label{color:rgba(255,255,255,.55);font-size:12px;font-weight:600}
.pf-header-balance-value{font-family:'Teko',sans-serif;font-size:34px;color: var(--text-accent);line-height:1;margin-top:2px}
.pf-header-refresh{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.7);width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pf-quick-row.pf-header-quick-row{margin:16px 0 0}
.pf-avatar-wrap{position:relative;flex-shrink:0}
.pf-avatar{width:68px;height:68px;border-radius:50%;background:var(--gg);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:900;color:var(--text-inverse);border:3px solid rgba(245,166,35,.5);box-shadow:0 0 20px rgba(245,166,35,.25);overflow:hidden;cursor:pointer;background-size:cover;background-position:center}
.pf-avatar-edit-btn{position:absolute;bottom:-2px;right:-2px;background:#111;border:2px solid var(--gold);border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:10px;cursor:pointer;color: var(--text-accent)}
.pf-online-dot{position:absolute;top:2px;left:2px;width:12px;height:12px;background:#22c55e;border-radius:50%;border:2px solid #0d1117;animation:pdot 2s infinite}
@keyframes pdot{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.4)}50%{box-shadow:0 0 0 5px rgba(34,197,94,0)}}
.pf-user-info{flex:1;min-width:0}
.pf-username-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.pf-username{color:#fff;font-size:18px;font-weight:800}
.pf-vip-badge-sm{background:var(--gg);color:var(--text-inverse);font-size:10.5px;padding:2px 8px;border-radius:20px;font-weight:900;white-space:nowrap;text-decoration:none}
.pf-user-id{color:rgba(255,255,255,.4);font-size:11.5px;margin-top:3px;display:flex;align-items:center;gap:5px}
.pf-copy-id-btn{background:none;border:none;color: var(--text-accent);cursor:pointer;padding:0;font-size:11px}
.pf-notif-btn{position:relative;background:rgba(255,255,255,.08);border:none;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.8);font-size:17px;cursor:pointer;flex-shrink:0;text-decoration:none}
.pf-notif-dot{position:absolute;top:4px;right:4px;background:#e53935;color:#fff;font-size:9px;font-weight:800;min-width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1.5px solid #0d1117;padding:0 2px}

/* Profile completion */
.pf-completion{margin:10px 0 0;padding:8px 12px;background:rgba(255,255,255,.05);border-radius:10px;display:flex;align-items:center;gap:10px;font-size:12px;color:var(--text-muted)}
.pf-comp-bar{flex:1;height:5px;background:rgba(255,255,255,.1);border-radius:10px;overflow:hidden}
.pf-comp-fill{height:100%;background:var(--gg);border-radius:10px}

/* Cards */
.pf-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;margin:12px 12px 0;overflow:hidden}
.pf-card-title-row{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px}
.pf-card-title{color:#fff;font-size:15px;font-weight:800;display:flex;align-items:center;gap:7px}
.pf-mini-btn{background:rgba(245,166,35,.15);color: var(--text-accent);border:1px solid rgba(245,166,35,.3);border-radius:20px;padding:4px 12px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap}

/* VIP */
.pf-vip-card{}
.pf-vip-body{padding:0 16px 14px}
.pf-vip-progress-bar{height:7px;background:rgba(255,255,255,.1);border-radius:10px;overflow:hidden;margin-bottom:7px}
.pf-vip-progress-fill{height:100%;background:var(--gg);border-radius:10px;transition:width .8s}
.pf-vip-info{color:rgba(255,255,255,.5);font-size:12px}
.pf-vip-info b{color:var(--text-main)}
.pf-wallet-mini{display:flex;justify-content:space-between;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06)}
.pf-wm-label{color:rgba(255,255,255,.4);font-size:12px}
.pf-wm-value{color: var(--text-accent);font-size:12px;font-weight:700}

/* Wallet */
.pf-wallet-card{}
.pf-wallet-balance-row{padding:0 16px 12px;display:flex;align-items:flex-end;justify-content:space-between}
.pf-balance-amount{color: var(--text-accent);font-size:30px;font-weight:800;font-family:'Teko',sans-serif;line-height:1.1}
.pf-balance-label{color:rgba(255,255,255,.4);font-size:11px;margin-bottom:4px}
.pf-refresh-btn{background:rgba(245,166,35,.12);border:none;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color: var(--text-accent);font-size:15px;transition:background .2s}
.pf-refresh-btn:active{background:rgba(245,166,35,.3)}
.pf-wallet-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 16px 14px}
.pf-wallet-item{background:rgba(255,255,255,.04);border-radius:12px;padding:9px 12px;border:1px solid rgba(255,255,255,.05)}
.pf-wi-label{color:rgba(255,255,255,.38);font-size:10.5px;margin-bottom:2px}
.pf-wi-value{color:#fff;font-size:13px;font-weight:700}
.pf-wi-value.demo{color: var(--text-accent)}
.pf-last-updated{color:rgba(255,255,255,.3);font-size:11px;padding:0 16px 10px}

/* Hub Quick Actions */
.pf-hub-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(255,255,255,.06);margin:0 12px}
.pf-hub-actions.card-style{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;margin:12px 12px 0;overflow:hidden;padding:4px}
.pf-qa{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 4px;text-decoration:none;transition:background .15s;border-radius:16px}
.pf-qa:active{background:rgba(255,255,255,.06)}
.pf-qa i{font-size:20px}
.pf-qa span{color:var(--text-main);font-size:11.5px;font-weight:600;text-align:center;line-height:1.3}
.pf-qa.deposit i{color:#22c55e}.pf-qa.withdraw i{color:#f87171}.pf-qa.cards i{color:#818cf8}.pf-qa.history i{color:var(--teal-text)}
.pf-qa.vip i{color:var(--purple-text)}.pf-qa.reward i{color: var(--text-accent)}.pf-qa.security i{color:var(--info-text)}.pf-qa.more i{color:var(--text-muted)}

/* Menu */
.pf-menu-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;margin:12px 12px 0;overflow:hidden}

/* Quick Actions (Deposit/Withdraw/My Cards) — সরাসরি Wallet Card এর নিচে, একবারে দৃশ্যমান */
.pf-quick-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 12px 0}
.pf-quick-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:14px 6px;border-radius:16px;text-decoration:none;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);transition:transform .12s,background .15s}
.pf-quick-btn:active{transform:scale(.96);background:rgba(255,255,255,.08)}
.pf-quick-btn i{font-size:19px}
.pf-quick-btn span{color:rgba(255,255,255,.8);font-size:12px;font-weight:700}
.pf-quick-btn.deposit i{color:#22c55e}
.pf-quick-btn.withdraw i{color:#f87171}
.pf-quick-btn.cards i{color:#818cf8}

/* Member Center — ৫টা বড় হাব টাইল (Wallet/VIP/Reward/Account/Support), ট্যাপ করলে সাব-আইটেম প্যানেল খোলে */
.mc-grid-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg, 20px);margin:14px 12px 0;overflow:hidden}
.mc-grid-title{padding:14px 16px 8px;color:#fff;font-size:15px;font-weight:800;display:flex;align-items:center;gap:7px}
/* ফ্ল্যাট গ্রিড — প্রতিটা আইটেম স্বাধীন, নেস্টেড কার্ড বা অ্যাকর্ডিয়ন নেই।
   মোবাইলে ৪ কলাম (৩২০px-এও লেবেল ভাঙে না), ছোট স্ক্রিনে ৩, ডেস্কটপে ৬। */
.mc-flat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding:2px 6px 10px}
.mc-tile{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  gap:7px;padding:12px 3px;min-height:64px;text-decoration:none;border-radius:14px;transition:background .15s}
.mc-tile:active{background:rgba(255,255,255,.06)}
.mc-tile:focus-visible{outline:2px solid var(--gold);outline-offset:-2px}
.mc-tile-icon{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.mc-tile-label{color:rgba(255,255,255,.78);font-size:10.5px;font-weight:700;text-align:center;line-height:1.25;
  overflow-wrap:anywhere;hyphens:auto;max-width:100%}
.mc-tile-badge{position:absolute;top:4px;right:8px;background:#e53935;color:#fff;font-size:9px;font-weight:800;
  min-width:16px;height:16px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;border:1.5px solid #12121f;z-index:1}
.mc-tile-badge.amber{background:#f59e0b;color:#14110A}
.mc-tile-sub{color:rgba(255,255,255,.4);font-size:9px;font-weight:600;text-align:center;line-height:1.2;margin-top:-3px}
@media (max-width:339px){.mc-flat-grid{grid-template-columns:repeat(3,1fr)}}
@media (min-width:768px){.mc-flat-grid{grid-template-columns:repeat(6,1fr)}.mc-tile-label{font-size:12px}}
.ic-sky-txt{color:var(--info-text)}


/* Footer */
.pf-footer{text-align:center;padding:22px 16px 10px;color:var(--text-muted);font-size:11px}
.pf-footer .ver{margin-top:4px;color:var(--text-muted)}

.mc-section-label{padding:12px 16px 6px;color:rgba(255,255,255,.35);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;display:flex;align-items:center;gap:6px}
.mc-section-label i{color: var(--text-accent);font-size:12px}

/* Icon color presets */
.ic-gold{background:rgba(245,166,35,.15);color: var(--text-accent)}
.ic-green{background:rgba(34,197,94,.12);color:var(--green-text)}
.ic-red{background:rgba(239,68,68,.12);color:var(--red-text)}
.ic-blue{background:rgba(99,102,241,.15);color:var(--indigo-text)}
.ic-purple{background:rgba(168,85,247,.12);color:var(--purple-text)}
.ic-teal{background:rgba(20,184,166,.12);color:var(--teal-text)}
.ic-orange{background:rgba(249,115,22,.12);color:var(--orange-text)}
.ic-sky{background:rgba(14,165,233,.12);color:var(--info-text)}

/* Logout */
.pf-logout-row{margin:16px 12px 0;display:flex;align-items:center;gap:12px;padding:14px 16px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.15);border-radius:20px;text-decoration:none;transition:background .15s}
.pf-logout-row:active{background:rgba(239,68,68,.14)}
.pf-logout-icon{width:38px;height:38px;border-radius:12px;background:rgba(239,68,68,.12);color:var(--red-text);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.pf-logout-label{color:var(--red-text);font-size:14px;font-weight:700}
.pf-version{text-align:center;margin-top:16px;margin-bottom:4px;color:rgba(255,255,255,.2);font-size:11px}

/* Sticky deposit FAB */
.pf-sticky-deposit{position:fixed;bottom:80px;right:16px;background:var(--gg);color:var(--text-inverse);width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 16px rgba(245,166,35,.4);text-decoration:none;z-index:100;transition:transform .15s}
.pf-sticky-deposit:active{transform:scale(.93)}

/* Toast */
#pf-toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);background:#1c2533;color:#fff;padding:9px 20px;border-radius:30px;font-size:12.5px;font-weight:600;border:1px solid var(--gold);opacity:0;transition:all .25s;z-index:9999;pointer-events:none;white-space:nowrap}

/* Spinning */
.spinning{animation:sp360 .7s linear infinite}
@keyframes sp360{to{transform:rotate(360deg)}}


/* Icon text colors */
.ic-gold{background:rgba(245,166,35,.15);color: var(--text-accent)}
.ic-purple{background:rgba(168,85,247,.12);color:var(--purple-text)}
.ic-orange{background:rgba(249,115,22,.12);color:var(--orange-text)}
.ic-sky{background:rgba(14,165,233,.12);color:var(--info-text)}
.ic-teal{background:rgba(20,184,166,.12);color:var(--teal-text)}
.ic-gold-txt{color: var(--text-accent)}
.ic-green-txt{color:var(--green-text)}
.ic-red-txt{color:var(--red-text)}
.ic-blue-txt{color:var(--indigo-text)}
.ic-teal-txt{color:var(--teal-text)}
.ic-purple-txt{color:var(--purple-text)}
.ic-orange-txt{color:var(--orange-text)}
.ic-pink-txt{color:var(--pink-text)}


/* Light mode */
body.light-mode .pf-header{background:linear-gradient(160deg,#e5e7eb,#d1d5db)}
body.light-mode .pf-username{color:#111}
body.light-mode .mc-tile-label{color:#374151}
body.light-mode .pf-card{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.08)}
body.light-mode .pf-vip-info{color: var(--text-muted)}
body.light-mode .pf-wi-label{color: var(--text-muted)}
body.light-mode .pf-wi-value{color:#111}
body.light-mode .pf-balance-label{color: var(--text-muted)}
body.light-mode .mc-grid-title{color:#111}
body.light-mode .mc-section-label{color:rgba(0,0,0,.6)}
body.light-mode .mc-tile-badge{border-color:#fff}
body.light-mode .mc-tile-sub{color:rgba(0,0,0,.6)}
body.light-mode .pf-card-title{color:#111}
body.light-mode .pf-completion{background:rgba(0,0,0,.04);color:rgba(0,0,0,.65)}
body.light-mode .pf-footer{color:rgba(0,0,0,.5)}
body.light-mode .pf-header-balance-label{color:rgba(0,0,0,.65)}
body.light-mode .pf-header-refresh{background:rgba(0,0,0,.06);border-color:rgba(0,0,0,.12);color:rgba(0,0,0,.7)}
body.light-mode .pf-last-updated{color:rgba(0,0,0,.5)}
body.light-mode .pf-notif-btn{background:rgba(0,0,0,.06);color:rgba(0,0,0,.75)}
body.light-mode .pf-quick-btn{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.08)}
body.light-mode .pf-user-id{color:rgba(0,0,0,.6)}
body.light-mode .pf-verify-banner{color:#7a1520}
body.light-mode .pf-version,body.light-mode .ver{color:rgba(0,0,0,.4)}
body.light-mode .pf-wm-label{color:rgba(0,0,0,.6)}
body.light-mode .pf-wallet-item{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.06)}
body.light-mode .pf-hub-actions.card-style{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.08)}
body.light-mode .pf-menu-card{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.08)}
body.light-mode .mc-grid-card{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.08)}
</style>

  <%- include('../partials/flash') %>

  <% if (user.email && !user.email_verified) { %>
  <div class="pf-verify-banner">
    <i class="fas fa-triangle-exclamation"></i>
    <div class="pf-verify-text"><%= t.email_not_verified_notice %></div>
    <form action="/resend-verification" method="POST" style="margin:0;">
      <button type="submit" class="pf-verify-btn"><%= t.send_link %></button>
    </form>
  </div>
  <% } %>

  <!-- ==================== 1. UNIFIED HEADER CARD (Avatar/ID/VIP badge/Bell + Balance + Deposit/Withdraw/Cards) ==================== -->
  <div class="pf-header">
    <div class="pf-header-glow"></div>
    <div class="pf-header-top">
      <div class="pf-avatar-wrap">
        <div id="avatarCircle" onclick="openAvatarPicker()" class="pf-avatar" style="background-image: <%= user.avatar ? `url('${user.avatar}')` : 'none' %>;">
          <% if (!user.avatar) { %><%= user.username.charAt(0).toUpperCase() %><% } %>
        </div>
        <span class="pf-online-dot" title="<%= t.online %>"></span>
        <div onclick="openAvatarPicker()" class="pf-avatar-edit">✏️</div>
      </div>

      <div class="pf-id-block">
        <div class="pf-username-row">
          <span id="usernameText" class="pf-username"><%= user.username %></span>
          <button onclick="copyUsername()" title="<%= t.copy %>" class="pf-copy-btn"><i class="fas fa-copy"></i></button>
          <a href="/profile/vip" class="pf-vip-badge-sm">
            <i class="fas fa-crown"></i><%= (vipStatus && vipStatus.current) ? vipStatus.current.name : 'VIP' %>
          </a>
        </div>
        <div class="pf-uid-row">
          <span>ID: <%= 100000 + user.id %></span>
          <button onclick="copyUid()" title="<%= t.copy %>" class="pf-copy-btn pf-copy-uid"><i class="fas fa-copy"></i></button>
        </div>
      </div>

      <a href="/notifications" class="pf-notif-icon">
        <i class="fas fa-bell"></i>
        <% if (typeof notifPreview !== 'undefined' && notifPreview.unreadCount > 0) { %><span class="pf-notif-dot"></span><% } %>
      </a>
    </div>

    <!-- Total Balance (Wallet Card বিলুপ্ত, এখানেই একীভূত) -->
    <div class="pf-header-balance-row">
      <div>
        <div class="pf-header-balance-label"><%= t.total_balance %></div>
        <div id="balanceText" class="pf-header-balance-value">৳ <%= Number(user.coins).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
        <div class="pf-wallet-updated"><%= t.last_updated %> <span id="lastUpdatedText"><%= t.just_now %></span></div>
      </div>
      <button onclick="refreshBalance()" id="refreshBtn" title="<%= t.refresh %>" class="pf-icon-btn pf-header-refresh"><i class="fas fa-sync-alt" id="refreshIcon"></i></button>
    </div>

    <!-- Deposit / Withdraw / My Cards — হেডার কার্ডেই, আলাদা Wallet Card নেই -->
    <div class="pf-quick-row pf-header-quick-row">
      <a href="/payment/deposit" class="pf-quick-btn deposit"><i class="fas fa-arrow-down-circle"></i><span><%= t.deposit %></span></a>
      <a href="/payment/withdraw" class="pf-quick-btn withdraw"><i class="fas fa-arrow-up-circle"></i><span><%= t.withdraw %></span></a>
      <a href="/profile/cards" class="pf-quick-btn cards"><i class="fas fa-credit-card"></i><span><%= t.my_cards %></span></a>
    </div>
  </div>

  <!-- ==================== PROFILE COMPLETION ==================== -->
  <% if (typeof profileCompletion !== 'undefined') { %>
  <div class="pf-completion-row">
    <div class="pf-completion-track"><div class="pf-completion-fill" style="width: <%= profileCompletion %>%;"></div></div>
    <span class="pf-completion-text"><%= t.profile_completion %> <b><%= profileCompletion %>%</b></span>
  </div>
  <% } %>

  <!-- ==================== 2. MEMBER CENTER (ফ্ল্যাট আইকন গ্রিড) ====================
       আগে এখানে ৫টা বড় "হাব" টাইল ছিল; প্রতিটাতে ট্যাপ করলে নিচে একটা অ্যাকর্ডিয়ন
       প্যানেল খুলে সাব-আইটেম দেখাত। ফলে ইউজারের কাঙ্ক্ষিত জিনিসটা (যেমন "মিশন" বা
       "লগইন হিস্টোরি") কোন হাবের ভেতরে আছে সেটা আন্দাজ করতে হতো — কার্ডের ভেতরে কার্ড,
       আর দুই ট্যাপ ছাড়া কিছুই পাওয়া যেত না।

       এখন প্রতিটা আইটেম স্বাধীন ও সরাসরি দৃশ্যমান, বিষয়ভিত্তিক সেকশনে ভাগ করা।

<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <%- include('../partials/flash') %>

  <% if (user.email && !user.email_verified) { %>
  <div style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 14px; padding: 14px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
    <i class="fas fa-triangle-exclamation" style="color: #f59e0b; font-size: 18px;"></i>
    <div style="flex: 1; min-width: 200px; font-size: 13px; color: var(--text-main, #eee);">
      আপনার ইমেইল এখনো ভেরিফাই করা হয়নি — কিছু ফিচার (যেমন উইথড্র) ব্যবহার করতে ভেরিফিকেশন লাগবে।
    </div>
    <form action="/resend-verification" method="POST" style="margin:0;">
      <button type="submit" style="background:#f59e0b;color:#1a1a1a;border:none;border-radius:8px;padding:8px 14px;font-size:12.5px;font-weight:800;cursor:pointer;white-space:nowrap;">লিঙ্ক পাঠান</button>
    </form>
  </div>
  <% } %>

  <!-- প্রোফাইল ব্যানার — হালকা ডার্ক শেড -->
  <div style="background: linear-gradient(135deg, #2d3446, #454e64); border-radius: 24px; padding: 25px 20px; margin: 0 -15px 20px -15px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.25); box-shadow: 0 10px 30px rgba(0,0,0,0.25);">
    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.12) 0%, transparent 70%); border-radius: 50%;"></div>

    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div id="avatarCircle" onclick="openAvatarPicker()" style="width: 80px; height: 80px; border-radius: 50%; background: var(--grad-gold); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.45); border: 3px solid rgba(255,255,255,0.12); cursor: pointer; overflow: hidden; background-image: <%= user.avatar ? `url('${user.avatar}')` : 'none' %>; background-size: cover; background-position: center;">
          <% if (!user.avatar) { %><%= user.username.charAt(0).toUpperCase() %><% } %>
        </div>
        <div onclick="openAvatarPicker()" style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 13px; cursor: pointer;">
          ✏️
        </div>
      </div>

      <div style="flex: 1; min-width: 0;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span id="usernameText" style="color:var(--text-main); font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= user.username %></span>
          <button onclick="copyUsername()" title="কপি করুন" style="background: rgba(245,158,11,0.15); border: none; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--gold); font-size: 11px; flex-shrink: 0;">
            <i class="fas fa-copy"></i>
          </button>
          <a href="/profile/vip" style="text-decoration: none; background: linear-gradient(135deg, #f5d67d, #f59e0b, #d97706); color: #3a1e00; font-size: 12px; padding: 3px 12px 3px 8px; border-radius: 20px; font-weight: 900; letter-spacing: 1px; display: inline-flex; align-items: center; gap: 4px; box-shadow: 0 2px 8px rgba(245,158,11,0.4), inset 0 1px 0 rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.3);">
            <i class="fas fa-crown" style="font-size: 11px;"></i>VIP
          </a>
        </div>
        <div style="color: rgba(255,255,255,0.55); font-size: 12px; margin-top: 4px;">ID: <%= 100000 + user.id %></div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
           <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span style="font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold);"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div style="margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;"><%= t.total_balance %></div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <div id="balanceText" style="color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2;">৳ <%= user.coins.toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
            <button onclick="refreshBalance()" id="refreshBtn" title="রিফ্রেশ" style="background: rgba(245,158,11,0.12); border: none; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--gold); font-size: 12px; flex-shrink: 0;">
              <i class="fas fa-sync-alt" id="refreshIcon"></i>
            </button>
          </div>
        </div>
        <a href="/profile/transactions" style="background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          <i class="fas fa-history"></i>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
        <a href="/payment/deposit" style="background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-plus-circle"></i>
          <%= t.deposit %>
        </a>
        <a href="/payment/withdraw" style="background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-hand-holding-usd"></i>
          <%= t.withdraw %>
        </a>
        <a href="/profile/cards" style="background: rgba(255,255,255,0.08); color:var(--text-main); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-credit-card"></i>
          <%= t.my_cards %>
        </a>
      </div>
    </div>
  </div>

  <!-- অ্যাভাটার পিকার মোডাল -->
  <div id="avatarModal" style="display:none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 999; align-items: flex-end; justify-content: center;">
    <div style="background: #1c2128; width: 100%; max-width: 480px; border-radius: 22px 22px 0 0; padding: 20px; border: 1px solid rgba(245,158,11,0.25); max-height: 75vh; display: flex; flex-direction: column;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <span style="color:var(--text-main); font-size:16px; font-weight:800;">প্রোফাইল ছবি বাছাই করুন</span>
        <span onclick="closeAvatarPicker()" style="color: rgba(255,255,255,0.6); font-size: 20px; cursor: pointer; padding: 0 6px;">&times;</span>
      </div>
      <div id="avatarGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; overflow-y: auto; padding-bottom: 10px;"></div>
    </div>
  </div>

  <!-- Member Center — আইকন গ্রিড (স্ক্রিনশট রেফারেন্স অনুযায়ী) -->
  <div class="member-center-card">
    <div class="mc-heading">
      <span class="mc-pill">Member Center</span>
      <span class="mc-hairline"></span>
    </div>

    <div class="mc-grid">
      <a href="/profile/rewards" class="mc-item">
        <span class="mc-icon-wrap">
          <span class="mc-icon"><i class="fas fa-trophy"></i></span>
          <% if (typeof rewardBadge !== 'undefined' && rewardBadge > 0) { %><span class="mc-badge"><%= rewardBadge %></span><% } %>
        </span>
        <span class="mc-label">Reward Center</span>
      </a>
      <a href="/profile/history" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-list-alt"></i></span></span>
        <span class="mc-label">Betting Record</span>
      </a>
      <a href="/profile/stats" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-file-invoice-dollar"></i></span></span>
        <span class="mc-label">Profit And Loss</span>
      </a>
      <a href="/payment/history?type=deposit" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-file-arrow-up"></i></span></span>
        <span class="mc-label">Deposit Record</span>
      </a>

      <a href="/payment/history?type=withdraw" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-file-arrow-down"></i></span></span>
        <span class="mc-label">Withdrawal Record</span>
      </a>
      <a href="/profile/transactions" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-clock-rotate-left"></i></span></span>
        <span class="mc-label">Account Record</span>
      </a>
      <a href="/profile/security" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-user"></i></span></span>
        <span class="mc-label">My Account</span>
      </a>
      <a href="/profile/security" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-shield-halved"></i></span></span>
        <span class="mc-label">Security Center</span>
      </a>

      <a href="/profile/referral" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-user-plus"></i></span></span>
        <span class="mc-label">Invite Friends</span>
      </a>
      <a href="/profile/missions" class="mc-item">
        <span class="mc-icon-wrap">
          <span class="mc-icon"><i class="fas fa-gift"></i></span>
          <% if (typeof missionBadge !== 'undefined' && missionBadge > 0) { %><span class="mc-badge"><%= missionBadge %></span><% } %>
        </span>
        <span class="mc-label">Mission</span>
      </a>
      <a href="/profile/cashback" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-coins"></i></span></span>
        <span class="mc-label">Rebate</span>
      </a>
      <a href="/notifications" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-at"></i></span></span>
        <span class="mc-label">Internal Message</span>
      </a>

      <a href="/profile/feedback" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-comment-dots"></i></span></span>
        <span class="mc-label">Suggestion</span>
      </a>
      <a href="/profile/app-download" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-mobile-screen-button"></i></span></span>
        <span class="mc-label">Download APP</span>
      </a>
      <a href="/chat" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-headset"></i></span></span>
        <span class="mc-label">Customer Service</span>
      </a>
      <a href="/chat" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-circle-question"></i></span></span>
        <span class="mc-label">Help Center</span>
      </a>
    </div>

    <div class="mc-logout-row">
      <a href="/logout" class="mc-item">
        <span class="mc-icon-wrap"><span class="mc-icon"><i class="fas fa-right-from-bracket"></i></span></span>
        <span class="mc-label">Logout</span>
      </a>
    </div>
  </div>

  <div style="text-align: center; margin-top: 30px; padding-bottom: 20px;">
    <div style="color: var(--text-muted); font-size: 12px;"><%= t.version %> 2.1.0</div>
    <div style="color: var(--text-muted); font-size: 11px; margin-top: 5px;">© 2024 <%= siteName %> Gaming</div>
  </div>

</div>

<div id="copyToast" style="position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px); background: #1c2128; color: #fff; padding: 10px 20px; border-radius: 30px; font-size: 13px; font-weight: 600; border: 1px solid var(--gold); opacity: 0; transition: all 0.25s; z-index: 999; pointer-events: none;">✅ কপি হয়েছে!</div>

<style>
.menu-folder {
  background: var(--bg-card);
  border-radius: 16px;
  border: 1px solid var(--border-glass);
  overflow: hidden;
}
.menu-folder summary {
  list-style: none;
  cursor: pointer;
  padding: 16px 18px;
  font-size: 14px;
  font-weight: 700;
  color:var(--text-main);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.menu-folder summary::-webkit-details-marker { display: none; }
.menu-folder summary::after {
  content: '▾';
  color: var(--gold);
  transition: transform 0.2s;
  margin-left: auto;
}
.menu-folder[open] summary::after { transform: rotate(180deg); }
.menu-folder-body {
  padding: 4px 8px 10px 8px;
  display: flex;
  flex-direction: column;
}
.menu-folder-body a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  color: var(--text-main);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  border-radius: 10px;
}
.menu-folder-body a i {
  width: 20px;
  text-align: center;
  color: var(--gold);
}
.menu-folder-body a:active { background: rgba(255,255,255,0.05); }
#refreshIcon.spinning { animation: spin 0.7s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* ---------- Member Center grid (screenshot reference) ---------- */
.member-center-card {
  /* ডার্ক মোডে (ডিফল্ট) হালকা গ্লাস-ডার্ক কার্ড */
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 20px;
  padding: 18px 14px 22px;
  margin: 0 -15px 20px -15px;
  box-shadow: 0 6px 24px rgba(0,0,0,0.25);
}
.mc-heading { display: flex; align-items: center; gap: 10px; padding: 0 6px; margin-bottom: 18px; }
.mc-pill {
  background: rgba(255,255,255,0.08); color: var(--text-muted); font-size: 12.5px; font-weight: 700;
  padding: 6px 16px; border-radius: 999px; white-space: nowrap;
}
.mc-hairline { flex: 1; height: 1px; background: var(--border-glass); }

.mc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 22px;
  column-gap: 4px;
}
.mc-item {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  text-decoration: none; text-align: center; padding: 0 2px;
}
.mc-icon-wrap { position: relative; }
.mc-icon {
  width: 56px; height: 56px; border-radius: 50%;
  background: rgba(245, 158, 11, 0.14);
  display: flex; align-items: center; justify-content: center;
  color: var(--gold); font-size: 22px;
}
.mc-badge {
  position: absolute; top: -4px; right: -4px;
  background: #e53935; color: #fff; font-size: 11px; font-weight: 800;
  min-width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--bg-surface); padding: 0 3px;
}
.mc-label { color: var(--text-main); font-size: 12.5px; font-weight: 600; line-height: 1.3; }

.mc-logout-row { margin-top: 22px; padding: 0 2px; }
.mc-logout-row .mc-item { align-items: flex-start; width: fit-content; }

/* লাইট মোডে আগের মতোই — সাদা কার্ড + ক্রিম আইকন লুক */
body.light-mode .member-center-card {
  background: #ffffff;
  border-color: rgba(0,0,0,0.05);
  box-shadow: 0 6px 24px rgba(0,0,0,0.08);
}
body.light-mode .mc-pill { background: #eceef1; color: #4b5563; }
body.light-mode .mc-hairline { background: #e5e7eb; }
body.light-mode .mc-icon { background: #fbebd0; color: #b8863a; }
body.light-mode .mc-badge { border-color: #fff; }
body.light-mode .mc-label { color: #374151; }
</style>

<script>
function showToast(msg) {
  var el = document.getElementById('copyToast');
  el.textContent = msg;
  el.style.opacity = '1';
  el.style.transform = 'translateX(-50%) translateY(0)';
  setTimeout(function () {
    el.style.opacity = '0';
    el.style.transform = 'translateX(-50%) translateY(20px)';
  }, 1800);
}

function copyUsername() {
  var name = document.getElementById('usernameText').textContent.trim();
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(name).then(function () { showToast('✅ কপি হয়েছে!'); });
  } else {
    var ta = document.createElement('textarea');
    ta.value = name;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showToast('✅ কপি হয়েছে!');
  }
}

var AVATAR_OPTIONS = [
  'https://i.pravatar.cc/300?img=12',
  'https://i.pravatar.cc/300?img=33',
  'https://i.pravatar.cc/300?img=5',
  'https://i.pravatar.cc/300?img=47',
  'https://i.pravatar.cc/300?img=8',
  'https://i.pravatar.cc/300?img=25',
  'https://i.pravatar.cc/300?img=15',
  'https://i.pravatar.cc/300?img=44',
  'https://i.pravatar.cc/300?img=68',
  'https://i.pravatar.cc/300?img=32',
  'https://i.pravatar.cc/300?img=60',
  'https://i.pravatar.cc/300?img=51',
  'https://i.pravatar.cc/300?img=20',
  'https://i.pravatar.cc/300?img=49',
  'https://i.pravatar.cc/300?img=65',
  'https://i.pravatar.cc/300?img=57'
];

function openAvatarPicker() {
  var grid = document.getElementById('avatarGrid');
  grid.innerHTML = '';
  AVATAR_OPTIONS.forEach(function (url) {
    var img = document.createElement('img');
    img.src = url;
    img.style.cssText = 'width:100%; aspect-ratio:1/1; border-radius:14px; background:rgba(255,255,255,0.06); border:2px solid rgba(255,255,255,0.08); cursor:pointer; padding:6px;';
    img.onclick = function () { selectAvatar(url); };
    grid.appendChild(img);
  });
  document.getElementById('avatarModal').style.display = 'flex';
}

function closeAvatarPicker() {
  document.getElementById('avatarModal').style.display = 'none';
}

function selectAvatar(url) {
  fetch('/profile/update-avatar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ avatar: url })
  })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        var circle = document.getElementById('avatarCircle');
        circle.style.backgroundImage = "url('" + url + "')";
        circle.textContent = '';
        closeAvatarPicker();
        showToast('✅ প্রোফাইল ছবি পরিবর্তন হয়েছে!');
      } else {
        showToast('❌ আপডেট ব্যর্থ হয়েছে');
      }
    })
    .catch(function () { showToast('❌ সমস্যা হয়েছে'); });
}

function refreshBalance() {
  var icon = document.getElementById('refreshIcon');
  icon.classList.add('spinning');
  fetch('/profile/api/balance')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        document.getElementById('balanceText').textContent = '৳ ' + Number(data.coins).toLocaleString('<%= lang === "bn" ? "bn-BD" : "en-US" %>');
        showToast('✅ ব্যালেন্স আপডেট হয়েছে');
      } else {
        showToast('❌ আপডেট ব্যর্থ হয়েছে');
      }
    })
    .catch(function () { showToast('❌ সমস্যা হয়েছে'); })
    .finally(function () {
      setTimeout(function () { icon.classList.remove('spinning'); }, 400);
    });
}
</script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

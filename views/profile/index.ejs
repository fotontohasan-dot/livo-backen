  <div class="rs2-38">
    <div class="rs2-39"><%= t.version %> 2.1.0</div>
    <div class="rs2-40">© <%= new Date().getFullYear() %> <%= siteName %> Gaming</div>
  </div>

</div>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', function () {
    var editBtn = document.getElementById('avatarEditBtn');
    var fileInput = document.getElementById('avatarInput');
    var form = document.getElementById('avatarForm');
    if (!editBtn || !fileInput || !form) return;
    editBtn.addEventListener('click', function () { fileInput.click(); });
    fileInput.addEventListener('change', function () {
      if (fileInput.files && fileInput.files.length > 0) form.submit();
    });
  });
</script>
<div class="rs2-41" id="copyToast"></div>
<script type="application/json" id="profileConfig"><%- jsonScriptSafe({ uid: 100000 + user.id, siteName: siteName, locale: lang === "bn" ? "bn-BD" : "en-US" }) %></script>

<style nonce="<%= cspNonce %>">
.mc-flat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 8px}
@media (max-width:339px){.mc-flat-grid{grid-template-columns:repeat(3,1fr)}}
@media (min-width:768px){.mc-flat-grid{grid-template-columns:repeat(6,1fr)}}
.mc-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-decoration:none;min-height:64px}
.mc-tile-label{color:var(--text-main);font-size:11px;font-weight:600;text-align:center;overflow-wrap:anywhere}
.mc-tile-sublabel{color:var(--text-muted);font-size:9px;text-align:center;overflow-wrap:anywhere}
.mc-tile-icon{width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--gold);position:relative}
.mc-tile-icon-danger{background:rgba(229,57,53,0.14);color:#e53935}
.mc-tile-label-danger{color:#e53935}
/* মেম্বার সেন্টার আইকন ব্যাজ — public/js/badges-realtime.js এইগুলোর টেক্সট/দৃশ্যমানতা নিয়ন্ত্রণ করে */
.mc-tile-badge{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 4px;border-radius:10px;background:#e53935;color:#fff;font-size:10px;font-weight:800;line-height:18px;text-align:center;border:2px solid var(--bg-card,#10251a);box-shadow:0 0 6px rgba(229,57,53,0.6)}
</style>


<%- include('../partials/head') %>
<style>
  :root {
    --gold-bright: #fbbf24;
    --gold-dark: #d97706;
    --bg-profile: #ffffff; /* White background as requested */
    --card-profile: #f8fafc;
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --border-light: #e2e8f0;
  }

  body {
    background: var(--bg-profile) !important;
    color: var(--text-dark) !important;
  }

  .container {
    max-width: none !important;
    padding: 0 !important;
  }

  .profile-header {
    background: linear-gradient(135deg, #fffbeb, #fef3c7); /* Light yellow/gold gradient */
    padding: 30px 20px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--gold-bright);
  }

  .avatar-container {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid #fff;
    overflow: hidden;
    background: #fff;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .avatar-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vip-badge {
    background: #000;
    color: var(--gold-bright);
    font-size: 10px;
    font-weight: 900;
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .copy-btn {
    background: rgba(0, 0, 0, 0.05);
    border: none;
    color: var(--text-muted);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    cursor: pointer;
  }

  .refresh-icon {
    transition: transform 0.5s ease;
  }
  .refresh-icon.spinning {
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .progress-container {
    margin-top: 15px;
    background: #fff;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #fbbf24, #d97706);
  }

  .folder-section {
    background: var(--card-profile);
    margin: 15px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  .folder-header {
    background: #f1f5f9;
    padding: 10px 15px;
    font-size: 12px;
    font-weight: bold;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid var(--border-light);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    padding: 15px;
  }

  .menu-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-dark);
    font-size: 11px;
    text-align: center;
    border: none !important;
  }

  .menu-icon {
    width: 45px;
    height: 45px;
    background: #fff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-dark);
    font-size: 20px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    border: 1px solid var(--border-light);
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    align-items: center;
    justify-content: center;
  }
  .modal-content {
    background: #fff;
    padding: 20px;
    border-radius: 16px;
    width: 90%;
    max-width: 400px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .avatar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 15px;
  }
  .avatar-option {
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
  }
  .avatar-option.selected {
    border-color: var(--gold-bright);
  }
  .avatar-option img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<div class="container pb-24">
  <!-- Header -->
  <div class="profile-header">
    <div style="display: flex; align-items: center; gap: 20px;">
      <div class="avatar-container" onclick="openAvatarModal()">
        <img src="<%= user.avatar_url || 'https://i.ibb.co/mR70f6V/default-avatar.png' %>" alt="Avatar" id="currentAvatar">
      </div>
      <div style="flex: 1;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <h2 style="color: var(--text-dark); font-size: 18px; font-weight: 800;"><%= user.username %></h2>
          <button class="copy-btn" onclick="copyUsername('<%= user.username %>')">
            <i class="far fa-copy"></i>
          </button>
        </div>
        <div style="margin-top: 5px; display: flex; align-items: center; gap: 10px;">
          <div class="vip-badge">
             <i class="fas fa-crown"></i> VIP <%= user.vip_level %>
          </div>
          <span style="color: var(--text-muted); font-size: 12px;">ID: <%= 100000 + user.id %></span>
        </div>
      </div>
    </div>

    <!-- Balance Section -->
    <div style="margin-top: 25px; background: #fff; border-radius: 16px; padding: 20px; border: 1px solid var(--gold-bright); box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <p style="color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">ব্যালেন্স</p>
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 5px;">
             <h3 style="color: var(--text-dark); font-size: 32px; font-weight: 800; margin: 0;" id="userBalance">৳ <%= user.coins.toLocaleString() %></h3>
             <i class="fas fa-sync-alt refresh-icon" style="color: var(--gold-dark); cursor: pointer;" onclick="refreshBalance()"></i>
          </div>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/payment/deposit" style="background: var(--gold-bright); color: #000; padding: 10px 20px; border-radius: 10px; text-decoration: none; font-weight: bold; font-size: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">ডিপোজিট</a>
        </div>
      </div>

      <!-- VIP Progress -->
      <div style="margin-top: 20px;">
        <div style="display: flex; justify-content: space-between; font-size: 10px; font-weight: bold; text-transform: uppercase;">
          <span style="color: var(--text-dark);">VIP <%= user.vip_level %> প্রগ্রেস</span>
          <span style="color: var(--gold-dark);" id="progressText"><%= vip.progress %>/1000</span>
        </div>
        <div class="progress-container">
          <div class="progress-bar" style="width: <%= vip.progress / 10 %>%;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Folder A: Account Management -->
  <div class="folder-section">
    <div class="folder-header">Folder A: একাউন্ট সেটিংস</div>
    <div class="menu-grid">
      <a href="/profile/security" class="menu-item">
        <div class="menu-icon"><i class="fas fa-user-circle"></i></div>
        <span>মাই একাউন্ট</span>
      </a>
      <a href="/profile/security" class="menu-item">
        <div class="menu-icon"><i class="fas fa-shield-alt"></i></div>
        <span>সিকিউরিটি</span>
      </a>
      <a href="/profile/referral" class="menu-item">
        <div class="menu-icon"><i class="fas fa-user-plus"></i></div>
        <span>ইনভাইট ফ্রেন্ড</span>
      </a>
      <a href="/profile/cards" class="menu-item">
        <div class="menu-icon"><i class="fas fa-credit-card"></i></div>
        <span>ব্যাংক কার্ড</span>
      </a>
    </div>
  </div>

  <!-- Folder B: Transaction History -->
  <div class="folder-section">
    <div class="folder-header">Folder B: ট্রানজেকশন রেকর্ড</div>
    <div class="menu-grid">
      <a href="/payment/history?type=deposit" class="menu-item">
        <div class="menu-icon"><i class="fas fa-file-import"></i></div>
        <span>ডিপোজিট রেকর্ড</span>
      </a>
      <a href="/payment/history?type=withdraw" class="menu-item">
        <div class="menu-icon"><i class="fas fa-file-export"></i></div>
        <span>উইথড্র রেকর্ড</span>
      </a>
      <a href="/profile/transactions" class="menu-item">
        <div class="menu-icon"><i class="fas fa-history"></i></div>
        <span>একাউন্ট রেকর্ড</span>
      </a>
    </div>
  </div>

  <!-- Folder C: Gaming Activity -->
  <div class="folder-section">
    <div class="folder-header">Folder C: বেটিং ও গেম হিস্ট্রি</div>
    <div class="menu-grid">
      <a href="/profile/history" class="menu-item">
        <div class="menu-icon"><i class="fas fa-clipboard-list"></i></div>
        <span>বেটিং রেকর্ড</span>
      </a>
      <a href="/profile/stats" class="menu-item">
        <div class="menu-icon"><i class="fas fa-chart-line"></i></div>
        <span>প্রফিট এন্ড লস</span>
      </a>
    </div>
  </div>

  <!-- Folder D: Rewards & Missions -->
  <div class="folder-section">
    <div class="folder-header">Folder D: রিওয়ার্ড ও মিশন</div>
    <div class="menu-grid">
      <a href="/profile/rewards" class="menu-item">
        <div class="menu-icon"><i class="fas fa-gift"></i></div>
        <span>বোনাস রিওয়ার্ড</span>
      </a>
      <a href="/profile/missions" class="menu-item">
        <div class="menu-icon"><i class="fas fa-bullseye"></i></div>
        <span>মিশন পয়েন্ট</span>
      </a>
      <a href="/profile/wheel" class="menu-item">
        <div class="menu-icon"><i class="fas fa-spinner"></i></div>
        <span>লাকি হুইল</span>
      </a>
      <a href="/profile/streak" class="menu-item">
        <div class="menu-icon"><i class="fas fa-fire"></i></div>
        <span>উইন স্ট্রিক</span>
      </a>
    </div>
  </div>

  <!-- Folder E: General -->
  <div class="folder-section">
    <div class="folder-header">Folder E: কাস্টমার সাপোর্ট ও অন্যান্য</div>
    <div class="menu-grid">
      <a href="mailto:support@livo.com" class="menu-item">
        <div class="menu-icon"><i class="fas fa-envelope-open-text"></i></div>
        <span>ইন্টারন্যাশনাল মেইল</span>
      </a>
      <a href="/feedback" class="menu-item">
        <div class="menu-icon"><i class="fas fa-lightbulb"></i></div>
        <span>সাজেশন</span>
      </a>
      <a href="/profile/app-download" class="menu-item">
        <div class="menu-icon"><i class="fas fa-download"></i></div>
        <span>অ্যাপ ডাউনলোড</span>
      </a>
      <a href="/chat" class="menu-item">
        <div class="menu-icon"><i class="fas fa-headset"></i></div>
        <span>কাস্টমার সেন্টার</span>
      </a>
      <a href="/help-center" class="menu-item">
        <div class="menu-icon"><i class="fas fa-question-circle"></i></div>
        <span>হেল্প সেন্টার</span>
      </a>
      <a href="/logout" class="menu-item">
        <div class="menu-icon" style="color: #ef4444; background: #fee2e2;"><i class="fas fa-sign-out-alt"></i></div>
        <span>লগ আউট</span>
      </a>
    </div>
  </div>

  <div style="text-align: center; margin-top: 30px; color: var(--text-muted); font-size: 12px; padding-bottom: 20px;">
    ভার্সন ৩.১.০ | © ২০২৪ <%= siteName %> Gaming
  </div>
</div>

<!-- Avatar Modal -->
<div id="avatarModal" class="modal">
  <div class="modal-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="color: var(--text-dark); margin: 0;">অবতার সিলেক্ট করুন</h3>
      <span style="color: var(--text-muted); cursor: pointer; font-size: 24px;" onclick="closeAvatarModal()">&times;</span>
    </div>
    <div class="avatar-grid">
      <%
        const avatars = [
          'https://i.ibb.co/mR70f6V/default-avatar.png',
          'https://i.ibb.co/L5hYvj9/elon-musk.png',
          'https://i.ibb.co/3WqPZqS/zuckerberg.png',
          'https://i.ibb.co/0Xz8z3R/jeff-bezos.png',
          'https://i.ibb.co/vV1J7fT/bill-gates.png',
          'https://i.ibb.co/D8mQ0Z8/warren-buffett.png'
        ];
        avatars.forEach(url => {
      %>
        <div class="avatar-option <%= user.avatar_url === url ? 'selected' : '' %>" onclick="selectAvatar('<%= url %>')">
          <img src="<%= url %>">
        </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
  function copyUsername(text) {
    navigator.clipboard.writeText(text).then(() => {
      alert('কপি হয়েছে!');
    });
  }

  async function refreshBalance() {
    const icon = document.querySelector('.refresh-icon');
    icon.classList.add('spinning');
    try {
      const res = await fetch('/profile/api/balance');
      const data = await res.json();
      if (data.success) {
        document.getElementById('userBalance').innerText = '৳ ' + data.coins.toLocaleString();
      }
    } catch (e) {}
    setTimeout(() => icon.classList.remove('spinning'), 1000);
  }

  function openAvatarModal() {
    document.getElementById('avatarModal').style.display = 'flex';
  }
  function closeAvatarModal() {
    document.getElementById('avatarModal').style.display = 'none';
  }

  async function selectAvatar(url) {
    try {
      const res = await fetch('/profile/avatar/update', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Origin': window.location.origin
        },
        body: JSON.stringify({ avatar_url: url })
      });
      if (res.ok) {
        document.getElementById('currentAvatar').src = url;
        closeAvatarModal();
      }
    } catch (e) {
      alert('অবতার আপডেট করতে সমস্যা হয়েছে।');
    }
  }

  window.onclick = function(event) {
    const modal = document.getElementById('avatarModal');
    if (event.target == modal) {
      closeAvatarModal();
    }
  }
</script>

<%- include('../partials/bottom-nav') %>

<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <%- include('../partials/flash') %>

  <!-- প্রোফাইল ব্যানার — হালকা ডার্ক শেড -->
  <div style="background: linear-gradient(135deg, #1c2128, #2a3140); border-radius: 24px; padding: 25px 20px; margin: 0 -15px 20px -15px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.25); box-shadow: 0 10px 30px rgba(0,0,0,0.35);">
    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.12) 0%, transparent 70%); border-radius: 50%;"></div>

    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--grad-gold); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.45); border: 3px solid rgba(255,255,255,0.12);">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px;">
          👑
        </div>
      </div>

      <div style="flex: 1; min-width: 0;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span id="usernameText" style="color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= user.username %></span>
          <button onclick="copyUsername()" title="কপি করুন" style="background: rgba(245,158,11,0.15); border: none; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--gold); font-size: 11px; flex-shrink: 0;">
            <i class="fas fa-copy"></i>
          </button>
          <a href="/profile/vip" style="text-decoration: none; background: linear-gradient(135deg, #f5d67d, #f59e0b, #d97706); color: #3a1e00; font-size: 12px; padding: 3px 12px 3px 8px; border-radius: 20px; font-weight: 900; letter-spacing: 1px; display: inline-flex; align-items: center; gap: 4px; box-shadow: 0 2px 8px rgba(245,158,11,0.4), inset 0 1px 0 rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.3);">
            <i class="fas fa-crown" style="font-size: 11px;"></i>VIP
          </a>
        </div>
        <div style="color: rgba(255,255,255,0.55); font-size: 12px; margin-top: 4px;">ID: <%= 100000 + user.id %></div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
           <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span style="font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold);"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div style="margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;"><%= t.total_balance %></div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <div id="balanceText" style="color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2;">৳ <%= user.coins.toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
            <button onclick="refreshBalance()" id="refreshBtn" title="রিফ্রেশ" style="background: rgba(245,158,11,0.12); border: none; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--gold); font-size: 12px; flex-shrink: 0;">
              <i class="fas fa-sync-alt" id="refreshIcon"></i>
            </button>
          </div>
        </div>
        <a href="/profile/transactions" style="background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          <i class="fas fa-history"></i>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
        <a href="/payment/deposit" style="background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-plus-circle"></i>
          <%= t.deposit %>
        </a>
        <a href="/payment/withdraw" style="background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-hand-holding-usd"></i>
          <%= t.withdraw %>
        </a>
        <a href="/profile/cards" style="background: rgba(255,255,255,0.08); color: #fff; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-credit-card"></i>
          <%= t.my_cards %>
        </a>
      </div>
    </div>
  </div>

  <!-- ফোল্ডার ভিত্তিক মেনু -->
  <div style="display: flex; flex-direction: column; gap: 12px;">

    <details class="menu-folder" open>
      <summary>👤 একাউন্ট সেটিংস</summary>
      <div class="menu-folder-body">
        <a href="/profile/security"><i class="fas fa-id-card"></i> মাই একাউন্ট</a>
        <a href="/profile/security"><i class="fas fa-shield-alt"></i> সিকিউরিটি</a>
        <a href="/profile/referral"><i class="fas fa-user-plus"></i> ইনভাইট ফ্রেন্ড</a>
      </div>
    </details>

    <details class="menu-folder">
      <summary>💳 ট্রানজেকশন রেকর্ড</summary>
      <div class="menu-folder-body">
        <a href="/payment/history?type=deposit"><i class="fas fa-arrow-down"></i> ডিপোজিট রেকর্ড</a>
        <a href="/payment/history?type=withdraw"><i class="fas fa-arrow-up"></i> উইথড্র রেকর্ড</a>
        <a href="/profile/transactions"><i class="fas fa-file-invoice-dollar"></i> একাউন্ট রেকর্ড</a>
      </div>
    </details>

    <details class="menu-folder">
      <summary>🎮 বেটিং ও গেম হিস্ট্রি</summary>
      <div class="menu-folder-body">
        <a href="/profile/history"><i class="fas fa-clipboard-list"></i> বেটিং রেকর্ড</a>
        <a href="/profile/stats"><i class="fas fa-chart-line"></i> প্রফিট এন্ড লস</a>
      </div>
    </details>

    <details class="menu-folder">
      <summary>🎁 রিওয়ার্ড ও মিশন</summary>
      <div class="menu-folder-body">
        <a href="/profile/rewards"><i class="fas fa-gift"></i> বোনাস রিওয়ার্ড ফান্ড</a>
        <a href="/profile/missions"><i class="fas fa-bullseye"></i> মিশন পয়েন্ট</a>
        <a href="/profile/stats"><i class="fas fa-list-ol"></i> গেম ওয়াইজ রেকর্ড</a>
      </div>
    </details>

    <details class="menu-folder">
      <summary>💬 কাস্টমার সাপোর্ট ও অন্যান্য</summary>
      <div class="menu-folder-body">
        <a href="/notifications"><i class="fas fa-envelope"></i> ইন্টারন্যাশনাল মেইল</a>
        <a href="/profile/feedback"><i class="fas fa-comment-alt"></i> সাজেশন</a>
        <a href="/profile/app-download"><i class="fas fa-mobile-alt"></i> অ্যাপ ডাউনলোড</a>
        <a href="/chat"><i class="fas fa-headset"></i> কাস্টমার সেন্টার</a>
        <a href="/chat"><i class="fas fa-question-circle"></i> হেল্প সেন্টার</a>
        <a href="/logout" style="color:#ef4444"><i class="fas fa-sign-out-alt"></i> লগ আউট</a>
      </div>
    </details>

  </div>

  <div style="text-align: center; margin-top: 30px; padding-bottom: 20px;">
    <div style="color: var(--text-muted); font-size: 12px;"><%= t.version %> 2.1.0</div>
    <div style="color: var(--text-muted); font-size: 11px; margin-top: 5px;">© 2024 <%= siteName %> Gaming</div>
  </div>

</div>

<div id="copyToast" style="position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px); background: #1c2128; color: #fff; padding: 10px 20px; border-radius: 30px; font-size: 13px; font-weight: 600; border: 1px solid var(--gold); opacity: 0; transition: all 0.25s; z-index: 999; pointer-events: none;">✅ কপি হয়েছে!</div>

<style>
.menu-folder {
  background: var(--bg-card);
  border-radius: 16px;
  border: 1px solid var(--border-glass);
  overflow: hidden;
}
.menu-folder summary {
  list-style: none;
  cursor: pointer;
  padding: 16px 18px;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.menu-folder summary::-webkit-details-marker { display: none; }
.menu-folder summary::after {
  content: '▾';
  color: var(--gold);
  transition: transform 0.2s;
  margin-left: auto;
}
.menu-folder[open] summary::after { transform: rotate(180deg); }
.menu-folder-body {
  padding: 4px 8px 10px 8px;
  display: flex;
  flex-direction: column;
}
.menu-folder-body a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  color: var(--text-main);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  border-radius: 10px;
}
.menu-folder-body a i {
  width: 20px;
  text-align: center;
  color: var(--gold);
}
.menu-folder-body a:active { background: rgba(255,255,255,0.05); }
#refreshIcon.spinning { animation: spin 0.7s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

<script>
function showToast(msg) {
  var el = document.getElementById('copyToast');
  el.textContent = msg;
  el.style.opacity = '1';
  el.style.transform = 'translateX(-50%) translateY(0)';
  setTimeout(function () {
    el.style.opacity = '0';
    el.style.transform = 'translateX(-50%) translateY(20px)';
  }, 1800);
}

function copyUsername() {
  var name = document.getElementById('usernameText').textContent.trim();
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(name).then(function () { showToast('✅ কপি হয়েছে!'); });
  } else {
    var ta = document.createElement('textarea');
    ta.value = name;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showToast('✅ কপি হয়েছে!');
  }
}

function refreshBalance() {
  var icon = document.getElementById('refreshIcon');
  icon.classList.add('spinning');
  fetch('/profile/api/balance')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        document.getElementById('balanceText').textContent = '৳ ' + Number(data.coins).toLocaleString('<%= lang === "bn" ? "bn-BD" : "en-US" %>');
        showToast('✅ ব্যালেন্স আপডেট হয়েছে');
      } else {
        showToast('❌ আপডেট ব্যর্থ হয়েছে');
      }
    })
    .catch(function () { showToast('❌ সমস্যা হয়েছে'); })
    .finally(function () {
      setTimeout(function () { icon.classList.remove('spinning'); }, 400);
    });
}
</script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

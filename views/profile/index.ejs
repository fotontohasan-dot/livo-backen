      <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
    </a>
    <a href="/notifications" style="display: flex; align-items: center; padding: 15px 20px; text-decoration: none; color: var(--text-main); border-bottom: 1px solid var(--border-glass);">
      <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245,158,11,0.1); display: flex; align-items: center; justify-content: center; margin-right: 12px;">
        <i class="fas fa-envelope" style="font-size: 14px; color: var(--gold);"></i>

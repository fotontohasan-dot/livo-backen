<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <!-- Premium Profile Header -->
  <div style="background: linear-gradient(135deg, #002d0b, #004d13); border-radius: 24px; padding: 25px 20px; margin-bottom: 20px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.1) 0%, transparent 70%); border-radius: 50%;"></div>

    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div id="avatarCircle" data-profile-action="avatar-open" style="width: 80px; height: 80px; border-radius: 50%; background: <%= user.avatar ? 'transparent' : 'var(--grad-gold)' %>; background-image: <%= user.avatar ? "url('" + user.avatar + "')" : 'none' %>; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.5); border: 3px solid rgba(255,255,255,0.1); cursor: pointer;">
          <% if (!user.avatar) { %><%= user.username.charAt(0).toUpperCase() %><% } %>
        </div>
        <div data-profile-action="avatar-open" style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer;">
          <i class="fas fa-camera" style="font-size: 12px; color: var(--gold);"></i>
        </div>
      </div>

      <div style="flex: 1;">
        <a href="/profile/vip" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
          <span style="color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= user.username %></span>
          <span style="background: var(--gold); color: #000; font-size: 10px; padding: 2px 10px; border-radius: 20px; font-weight: 900; text-transform: uppercase;">VIP<%= user.vip_level || 0 %></span>
        </a>
        <div style="color: rgba(255,255,255,0.6); font-size: 12px; margin-top: 4px;">ID: <%= 100000 + user.id %></div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
           <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span style="font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold);"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div style="margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;"><%= t.total_balance %></div>
          <div style="color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2;">৳ <%= user.coins.toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
        </div>
        <a href="/profile/transactions" style="background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          <i class="fas fa-history"></i>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
        <a href="/payment/deposit" style="background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-plus-circle"></i>
          <%= t.deposit %>
        </a>
        <a href="/payment/withdraw" style="background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-hand-holding-usd"></i>
          <%= t.withdraw %>
        </a>
        <a href="/profile/cards" style="background: rgba(255,255,255,0.08); color: #fff; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-credit-card"></i>
          Bank Account
        </a>
      </div>
    </div>
  </div>

  <!-- Member Center (matches reference screenshot: single 4x4 grid) -->
  <div style="background: var(--bg-card); border-radius: 20px; padding: 20px; border: 1px solid var(--border-glass);">
    <div style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">Member Center</div>

    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px 10px;">

      <a href="/profile/rewards" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-trophy"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Reward Center</div>
      </a>

      <a href="/profile/history" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-clipboard-list"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Betting Record</div>
      </a>

      <a href="/profile/stats" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-chart-pie"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Profit And Loss</div>
      </a>

      <a href="/payment/history?type=deposit" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-file-invoice-dollar"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Deposit Record</div>
      </a>

      <a href="/payment/history?type=withdraw" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-hand-holding-usd"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Withdrawal Record</div>
      </a>

      <a href="/profile/transactions" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-file-alt"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Account Record</div>
      </a>

      <a href="/profile/security" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-user"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">My Account</div>
      </a>

      <a href="/profile/security" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-shield-alt"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Security Center</div>
      </a>

      <a href="/profile/referral" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-user-plus"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Invite Friends</div>
      </a>

      <a href="/profile/missions" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-bullseye"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Mission</div>
      </a>

      <a href="/profile/cashback" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-coins"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Rebate</div>
      </a>

      <a href="/notifications" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-envelope"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Internal Message</div>
      </a>

      <a href="/profile/feedback" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-comment-alt"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Suggestion</div>
      </a>

      <a href="/profile/app-download" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-mobile-alt"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Download APP</div>
      </a>

      <a href="/chat" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-headset"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Customer Service</div>
      </a>

      <a href="/rules" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:var(--gold);font-size:22px"><i class="fas fa-question-circle"></i></div>
        <div style="color:var(--text-main);font-size:11px;font-weight:600">Help Center</div>
      </a>

      <a href="/logout" style="text-decoration:none; text-align:center">
        <div style="width:58px;height:58px;border-radius:50%;background:rgba(229,57,53,0.14);display:flex;align-items:center;justify-content:center;margin:0 auto 8px;color:#e53935;font-size:22px"><i class="fas fa-right-from-bracket"></i></div>
        <div style="color:#e53935;font-size:11px;font-weight:600">Logout</div>
      </a>

    </div>
  </div>


  <div style="text-align: center; margin-top: 30px; padding-bottom: 20px;">
    <div style="color: var(--text-muted); font-size: 12px;"><%= t.version %> 2.1.0</div>
    <div style="color: var(--text-muted); font-size: 11px; margin-top: 5px;">© <%= new Date().getFullYear() %> <%= siteName %> Gaming</div>
  </div>

</div>

<div id="avatarModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:200; align-items:center; justify-content:center; padding:20px;">
  <div style="background:var(--bg-card, #10251a); border-radius:20px; padding:20px; max-width:360px; width:100%; border:1px solid rgba(245,158,11,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
      <span style="color:#fff; font-weight:800;">প্রোফাইল ছবি বাছাই করুন</span>
      <span data-profile-action="avatar-close" style="color:#fff; cursor:pointer; font-size:18px;">&times;</span>
    </div>
    <div id="avatarGrid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px;"></div>
  </div>
</div>
<div id="copyToast" style="position:fixed; left:50%; bottom:90px; transform:translateX(-50%) translateY(20px); background:#000; color:#fff; padding:8px 16px; border-radius:20px; font-size:13px; opacity:0; transition:all .25s; z-index:250; pointer-events:none;"></div>

<script type="application/json" id="profileConfig"><%- jsonScriptSafe({ uid: user.id, siteName: siteName || '', locale: (typeof lang !== 'undefined' && lang === 'bn') ? 'bn-BD' : 'en-US' }) %></script>
<script nonce="<%= cspNonce %>" src="/js/profile-index.js"></script>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>

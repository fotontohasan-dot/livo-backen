<%- include('../partials/head') %>

<div class="container" style="padding: 15px; padding-bottom: 100px;">
  <!-- Premium Profile Header -->
  <div style="background: linear-gradient(135deg, #002d0b, #004d13); border-radius: 24px; padding: 25px 20px; margin-bottom: 20px; position: relative; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(245,158,11,0.1) 0%, transparent 70%); border-radius: 50%;"></div>

    <div style="display: flex; align-items: center; gap: 20px; position: relative; z-index: 1;">
      <div style="position: relative;">
        <div id="avatarCircle" data-profile-action="avatar-open" style="width: 80px; height: 80px; border-radius: 50%; background: <%= user.avatar ? 'transparent' : 'var(--grad-gold)' %>; background-image: <%= user.avatar ? "url('" + user.avatar + "')" : 'none' %>; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #000; box-shadow: 0 0 20px rgba(245, 158, 11, 0.5); border: 3px solid rgba(255,255,255,0.1); cursor: pointer;">
          <% if (!user.avatar) { %><%= user.username.charAt(0).toUpperCase() %><% } %>
        </div>
        <div data-profile-action="avatar-open" style="position: absolute; bottom: -5px; right: -5px; background: #000; border: 2px solid var(--gold); border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer;">
          <i class="fas fa-camera" style="font-size: 12px; color: var(--gold);"></i>
        </div>
      </div>

      <div style="flex: 1;">
        <a href="/profile/vip" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
          <span id="usernameText" style="color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0.5px;"><%= user.username %></span>
          <span class="pf-vip-badge-sm" style="background: var(--gold); color: #000; font-size: 10px; padding: 2px 10px; border-radius: 20px; font-weight: 900; text-transform: uppercase;">VIP<%= user.vip_level || 0 %></span>
        </a>
        <div style="color: rgba(255,255,255,0.6); font-size: 12px; margin-top: 4px; display: flex; align-items: center; gap: 8px;">
          <span>ID: <%= 100000 + user.id %></span>
          <i class="fas fa-copy" data-profile-action="copy-uid" style="cursor:pointer; opacity:0.7;" title="আইডি কপি করুন"></i>
          <i class="fas fa-user-tag" data-profile-action="copy-username" style="cursor:pointer; opacity:0.7;" title="ইউজারনেম কপি করুন"></i>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
           <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
              <div style="width: <%= (user.total_points % 1000) / 10 %>%; height: 100%; background: var(--grad-gold); border-radius: 10px;"></div>
           </div>
           <span style="font-family: 'Teko', sans-serif; font-size: 12px; color: var(--gold);"><%= user.total_points % 1000 %>/1000</span>
        </div>
      </div>
    </div>

    <!-- Wallet Card -->
    <div style="margin-top: 25px; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(5px);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;"><%= t.total_balance %></div>
          <div id="balanceText" style="color: var(--gold); font-size: 30px; font-weight: 800; font-family: 'Teko', sans-serif; line-height: 1.2;">৳ <%= user.coins.toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></div>
        </div>
        <a href="#" data-profile-action="refresh-balance" style="background: rgba(245, 158, 11, 0.1); color: var(--gold); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          <i class="fas fa-sync-alt" id="refreshIcon"></i>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
        <a href="/payment/deposit" style="background: var(--grad-gold); color: #000; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-plus-circle"></i>
          <%= t.deposit %>
        </a>
        <a href="/payment/withdraw" style="background: rgba(255,255,255,0.08); color: var(--gold); padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(245, 158, 11, 0.3); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-hand-holding-usd"></i>
          <%= t.withdraw %>
        </a>
        <a href="/profile/cards" style="background: rgba(255,255,255,0.08); color: #fff; padding: 10px; border-radius: 12px; text-align: center; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 4px; align-items: center;">
          <i class="fas fa-credit-card"></i>
          Bank Account
        </a>
      </div>
    </div>
  </div>

  <!-- Member Center — ফ্ল্যাট গ্রিড, প্রতিটা আইটেম স্বাধীন ও সরাসরি দৃশ্যমান (আগে
       অ্যাকর্ডিয়ন হাবের ভেতরে থাকত, দুই ট্যাপ লাগত)। -->
  <div style="background: var(--bg-card); border-radius: 20px; padding: 20px; border: 1px solid var(--border-glass);">
    <div style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;"><%= t.member_center %></div>

    <div class="mc-flat-grid">
      <a href="/profile/wheel" class="mc-tile"><i class="fas fa-dharmachakra"></i><div class="mc-tile-label">লাকি হুইল</div></a>
      <a href="/profile/rewards" class="mc-tile"><i class="fas fa-trophy"></i><div class="mc-tile-label"><%= t.reward_center %></div></a>
      <a href="/profile/missions" class="mc-tile"><i class="fas fa-bullseye"></i><div class="mc-tile-label">মিশন</div></a>
      <a href="/profile/cashback" class="mc-tile"><i class="fas fa-coins"></i><div class="mc-tile-label">রিবেট</div></a>
      <a href="/profile/vip" class="mc-tile"><i class="fas fa-crown"></i><div class="mc-tile-label">VIP</div></a>
      <a href="/profile/badges" class="mc-tile"><i class="fas fa-medal"></i><div class="mc-tile-label"><%= t.badges %></div></a>

      <a href="/payment/history?type=deposit" class="mc-tile"><i class="fas fa-file-invoice-dollar"></i><div class="mc-tile-label">ডিপোজিট রেকর্ড</div></a>
      <a href="/payment/history?type=withdraw" class="mc-tile"><i class="fas fa-hand-holding-usd"></i><div class="mc-tile-label">উইথড্র রেকর্ড</div></a>
      <a href="/profile/transactions" class="mc-tile"><i class="fas fa-file-alt"></i><div class="mc-tile-label"><%= t.account_record %></div></a>
      <a href="/profile/cards" class="mc-tile"><i class="fas fa-credit-card"></i><div class="mc-tile-label">ব্যাংক কার্ড</div></a>
      <a href="/extra/kyc" class="mc-tile"><i class="fas fa-id-card"></i><div class="mc-tile-label">KYC</div></a>
      <a href="/profile/security" class="mc-tile" title="লগইন হিস্টোরি, পাসওয়ার্ড ও ডিভাইস ম্যানেজমেন্ট"><i class="fas fa-shield-alt"></i><div class="mc-tile-label">সিকিউরিটি সেন্টার</div></a>

      <a href="/profile/referral" class="mc-tile"><i class="fas fa-user-plus"></i><div class="mc-tile-label">রেফার করুন</div></a>
      <a href="/notifications" class="mc-tile"><i class="fas fa-envelope"></i><div class="mc-tile-label">নোটিফিকেশন</div></a>
      <a href="/profile/chat" class="mc-tile"><i class="fas fa-headset"></i><div class="mc-tile-label">লাইভ চ্যাট</div></a>
      <a href="/help-center" class="mc-tile"><i class="fas fa-question-circle"></i><div class="mc-tile-label">হেল্প সেন্টার</div></a>
      <a href="/profile/feedback" class="mc-tile"><i class="fas fa-comment-alt"></i><div class="mc-tile-label">মতামত</div></a>
      <a href="/logout" class="mc-tile" style="color:#e53935"><i class="fas fa-right-from-bracket" style="color:#e53935"></i><div class="mc-tile-label" style="color:#e53935">লগআউট</div></a>
    </div>
  </div>

  <div style="text-align: center; margin-top: 30px; padding-bottom: 20px;">
    <div style="color: var(--text-muted); font-size: 12px;"><%= t.version %> 2.1.0</div>
    <div style="color: var(--text-muted); font-size: 11px; margin-top: 5px;">© <%= new Date().getFullYear() %> <%= siteName %> Gaming</div>
  </div>

</div>

<div id="avatarModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:200; align-items:center; justify-content:center; padding:20px;">
  <div style="background:var(--bg-card, #10251a); border-radius:20px; padding:20px; max-width:360px; width:100%; border:1px solid rgba(245,158,11,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
      <span style="color:#fff; font-weight:800;">প্রোফাইল ছবি বাছাই করুন</span>
      <span data-profile-action="avatar-close" style="color:#fff; cursor:pointer; font-size:18px;">&times;</span>
    </div>
    <div id="avatarGrid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px;"></div>
  </div>
</div>
<div id="copyToast" style="position:fixed; left:50%; bottom:90px; transform:translateX(-50%) translateY(20px); background:#000; color:#fff; padding:8px 16px; border-radius:20px; font-size:13px; opacity:0; transition:all .25s; z-index:250; pointer-events:none;"></div>

<script type="application/json" id="profileConfig"><%- jsonScriptSafe({ uid: 100000 + user.id, siteName: siteName || '', locale: (typeof lang !== 'undefined' && lang === 'bn') ? 'bn-BD' : 'en-US' }) %></script>

<style nonce="<%= cspNonce %>">
  .mc-flat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px 8px}
  @media (max-width:339px){.mc-flat-grid{grid-template-columns:repeat(3,1fr)}}
  @media (min-width:768px){.mc-flat-grid{grid-template-columns:repeat(6,1fr)}}
  .mc-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-decoration:none;text-align:center;min-height:64px;padding:4px}
  .mc-tile i{width:52px;height:52px;border-radius:50%;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:20px}
  .mc-tile-label{color:var(--text-main);font-size:11px;font-weight:600;overflow-wrap:anywhere;white-space:normal;line-height:1.3}
</style>

<%- include('../partials/navbar') %>
<%- include('../partials/bottom-nav') %>
<script nonce="<%= cspNonce %>" src="/js/profile-index.js"></script>

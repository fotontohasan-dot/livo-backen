<%- include('../partials/head') %>
<div class="container ix60-1">
  <div class="im61-1">
    <a class="ix60-2" href="/profile">←</a>
    <h1 class="ix60-3">💳 লেনদেন ইতিহাস</h1>
  </div>

  <% if (transactions && transactions.length > 0) { %>
    <div class="im61-2">
      <% transactions.forEach(t => { %>
        <div class="card glass ix60-4">
          <div class="im61-3">
            <div class="ix60-5">
                <%= t.type === 'deposit' ? '💰' : t.type === 'withdraw' ? '💸' : t.type === 'lucky_wheel' ? '🎡' : t.type === 'bet' ? '🎲' : '✨' %>
            </div>
            <div>
              <div class="dz60-1"><%= t.description || t.type %></div>
              <div class="dz60-2"><%= new Date(t.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
          </div>
          <div style="color:<%= t.amount > 0 ? '#10b981' : '#ef4444' %>; font-weight:bold; font-size:16px; font-family: 'Teko', sans-serif;">
            <%= t.amount > 0 ? '+' : '' %><%= t.amount.toLocaleString() %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else if (typeof loadError !== 'undefined' && loadError) { %>
    <%# loadError হলে খালি-অবস্থার বার্তা দেখানো যাবে না, কারণ সেটা জানা নেই। EJS মন্তব্য ব্যবহার করা হচ্ছে ইচ্ছাকৃতভাবে; HTML মন্তব্য আউটপুটে থেকে যেত আর ওই বার্তাটাই পেজে ফিরে আসত। %>
    <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz60-1 { color: var(--text-main); font-size: 14px; }
  .dz60-2 { color: var(--text-muted); font-size: 12px; }
  .dz60-3 { text-align: center; padding: 40px; color: var(--text-muted); }
  .dz60-4 { font-size: 48px; margin-bottom: 12px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). A declaration was moved only when no !important rule in
     the site CSS can match this element for that property. */
  .ix60-1 { padding: 16px; padding-bottom: 100px; }
  .ix60-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .ix60-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .ix60-4 { border-radius: 15px; padding: 16px; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border-glass); }
  .ix60-5 { width: 45px; height: 45px; border-radius: 12px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; font-size: 20px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im61-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im61-2 { display: flex; flex-direction: column; gap: 10px; }
  .im61-3 { display: flex; align-items: center; gap: 15px; }
      .tx-load-error { text-align:center; padding:40px; color:#f87171; }
      .tx-load-error-icon { font-size:48px; margin-bottom:12px; }
    </style>
    <div id="txLoadError" role="alert" class="tx-load-error">
      <div class="tx-load-error-icon">⚠️</div>
      <div><%= t.common_history_load_failed %></div>
    </div>
  <% } else { %>
    <div class="dz60-3">
      <div class="dz60-4">📭</div>
      <div>কোনো লেনদেন নেই</div>
    </div>
  <% } %>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

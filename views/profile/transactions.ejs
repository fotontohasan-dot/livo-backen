<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold">💳 লেনদেন ইতিহাস</h1>
  </div>

  <% if (transactions && transactions.length > 0) { %>
    <div style="display:flex;flex-direction:column;gap:8px">
      <% transactions.forEach(t => { %>
        <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;display:flex;align-items:center;justify-content:space-between">
          <div style="display:flex;align-items:center;gap:12px">
            <div style="font-size:24px"><%= t.type === 'deposit' ? '⬇️' : t.type === 'withdraw' ? '⬆️' : '🎯' %></div>
            <div>
              <div style="color:#fff;font-size:14px"><%= t.description || t.type %></div>
              <div style="color:#94a3b8;font-size:12px"><%= new Date(t.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
          </div>
          <div style="color:<%= t.amount > 0 ? '#10b981' : '#ef4444' %>;font-weight:bold;font-size:16px">
            <%= t.amount > 0 ? '+' : '' %><%= t.amount %> 🪙
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div style="text-align:center;padding:40px;color:#94a3b8">
      <div style="font-size:48px;margin-bottom:12px">📭</div>
      <div>কোনো লেনদেন নেই</div>
    </div>
  <% } %>
</div>
<%- include('../partials/navbar') %>

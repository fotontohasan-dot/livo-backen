<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">🔥 <%= t('stk_title') %></h1>
  </div>

  <% if (streak) { %>
    <!-- বর্তমান স্ট্রিক -->
    <div style="background:linear-gradient(135deg,#f97316,#ef4444);border-radius:16px;padding:24px;margin-bottom:16px;text-align:center;">
      <div style="font-size:44px;margin-bottom:4px;">🔥</div>
      <div style="color:rgba(255,255,255,0.9);font-size:13px;"><%= t('stk_current') %></div>
      <div style="color:var(--text-main);font-size:38px;font-weight:900;"><%= streak.current %></div>
      <div style="color:rgba(255,255,255,0.9);font-size:12px;margin-top:4px;"><%= t('stk_best').replace('{value}', streak.best) %></div>
    </div>

    <!-- পরের মাইলস্টোন -->
    <% if (streak.nextMilestone) { %>
      <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;margin-bottom:16px;text-align:center;">
        <div style="color:var(--text-muted);font-size:13px;"><%= t('stk_next_needed') %></div>
        <div style="color:#f59e0b;font-size:16px;font-weight:bold;margin-top:4px;">
          <%= t('stk_next_detail').replace('{n}', streak.nextMilestone - streak.current).replace('{mult}', streak.nextMultiplier) %>
        </div>
      </div>
    <% } %>

    <!-- সব মাইলস্টোন -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">🎯 <%= t('stk_milestones') %></div>
      <% streak.milestones.forEach(m => {
        const reached = streak.current >= m.streak;
      %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;margin-bottom:8px;border-radius:10px;background:<%= reached ? 'rgba(16,185,129,0.12)' : 'rgba(255,255,255,0.03)' %>;border:1px solid <%= reached ? '#10b981' : 'transparent' %>;">
          <div style="color:<%= reached ? 'var(--text-main)' : 'var(--text-muted)' %>;font-size:14px;font-weight:bold;">
            <%= reached ? '✅' : '🔒' %> <%= t('stk_wins_in_row').replace('{n}', m.streak) %>
          </div>
          <div style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= m.multiplier %>x 🪙</div>
        </div>
      <% }) %>
    </div>

    <!-- স্ট্রিক হিস্ট্রি -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;margin-top:16px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:12px;">🧾 <%= t('stk_history') %></div>
      <% if (streak.history && streak.history.length) { %>
        <% streak.history.forEach(h => { %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
            <div>
              <div style="color:var(--text-main);font-size:13px;"><%= h.description %></div>
              <div style="color:var(--text-muted);font-size:11px;"><%= new Date(h.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
            <div style="color:#10b981;font-size:13px;font-weight:bold;">+<%= h.amount %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="color:var(--text-muted);font-size:13px;text-align:center;padding:10px;"><%= t('stk_no_history') %></div>
      <% } %>
    </div>

    <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
      <%= t('stk_info_1') %><br>
      <%= t('stk_info_2') %>
    </p>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color: var(--text-muted);">
      <%= t('stk_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

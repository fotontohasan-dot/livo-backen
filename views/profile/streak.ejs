<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz66-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz66-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz66-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz66-4 { background: linear-gradient(135deg,#f97316,#ef4444); border-radius: 16px; padding: 24px; margin-bottom: 16px; text-align: center; }
  .dz66-5 { color: rgba(255,255,255,0.9); font-size: 13px; }
  .dz66-6 { color: var(--text-main); font-size: 38px; font-weight: 900; }
  .dz66-7 { color: rgba(255,255,255,0.9); font-size: 12px; margin-top: 4px; }
  .dz66-8 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; text-align: center; }
  .dz66-9 { color: var(--text-muted); font-size: 13px; }
  .dz66-10 { color: #f59e0b; font-size: 16px; font-weight: bold; margin-top: 4px; }
  .dz66-11 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz66-12 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz66-13 { color: #f59e0b; font-size: 13px; font-weight: bold; }
  .dz66-14 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-top: 16px; }
  .dz66-15 { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz66-16 { color: var(--text-main); font-size: 13px; }
  .dz66-17 { color: var(--text-muted); font-size: 11px; }
  .dz66-18 { color: #10b981; font-size: 13px; font-weight: bold; }
  .dz66-19 { color: var(--text-muted); font-size: 13px; text-align: center; padding: 10px; }
  .dz66-20 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  .dz66-21 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 30px; text-align: center; color: var(--text-muted); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im67-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im67-2 { font-size: 44px; margin-bottom: 4px; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz66-1">
  <%- include('../partials/flash') %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <div role="alert" class="data-load-error">
      <%= t.common_stats_load_failed %>
    </div>
  <% } %>

  <div class="im67-1">
    <a class="dz66-2" href="/profile">←</a>
    <h1 class="dz66-3">🔥 <%= t('stk_title') %></h1>
  </div>

  <% if (streak) { %>
    <!-- বর্তমান স্ট্রিক -->
    <div class="dz66-4">
      <div class="im67-2">🔥</div>
      <div class="dz66-5"><%= t('stk_current') %></div>
      <div class="dz66-6"><%= streak.current %></div>
      <div class="dz66-7"><%= t('stk_best').replace('{value}', streak.best) %></div>
    </div>

    <!-- পরের মাইলস্টোন -->
    <% if (streak.nextMilestone) { %>
      <div class="dz66-8">
        <div class="dz66-9"><%= t('stk_next_needed') %></div>
        <div class="dz66-10">
          <%= t('stk_next_detail').replace('{n}', streak.nextMilestone - streak.current).replace('{mult}', streak.nextMultiplier) %>
        </div>
      </div>
    <% } %>

    <!-- সব মাইলস্টোন -->
    <div class="dz66-11">
      <div class="dz66-12">🎯 <%= t('stk_milestones') %></div>
      <% streak.milestones.forEach(m => {
        const reached = streak.current >= m.streak;
      %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;margin-bottom:8px;border-radius:10px;background:<%= reached ? 'rgba(16,185,129,0.12)' : 'rgba(255,255,255,0.03)' %>;border:1px solid <%= reached ? '#10b981' : 'transparent' %>;">
          <div style="color:<%= reached ? 'var(--text-main)' : 'var(--text-muted)' %>;font-size:14px;font-weight:bold;">
            <%= reached ? '✅' : '🔒' %> <%= t('stk_wins_in_row').replace('{n}', m.streak) %>
          </div>
          <div class="dz66-13"><%= m.multiplier %>x 🪙</div>
        </div>
      <% }) %>
    </div>

    <!-- স্ট্রিক হিস্ট্রি -->
    <div class="dz66-14">
      <div class="dz66-12">🧾 <%= t('stk_history') %></div>
      <% if (streak.history && streak.history.length) { %>
        <% streak.history.forEach(h => { %>
          <div class="dz66-15">
            <div>
              <div class="dz66-16"><%= h.description %></div>
              <div class="dz66-17"><%= new Date(h.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
            <div class="dz66-18">+<%= h.amount %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz66-19"><%= t('stk_no_history') %></div>
      <% } %>
    </div>

    <p class="dz66-20">
      <%= t('stk_info_1') %><br>
      <%= t('stk_info_2') %>
    </p>

  <% } else { %>
    <div class="dz66-21">
      <%= t('stk_load_error') %>
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

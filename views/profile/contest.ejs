<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold;">🏆 রেফারেল কনটেস্</h1>
  </div>

  <% if (contest) { %>
    <!-- ব্যানার -->
    <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
      <div style="font-size:40px;margin-bottom:6px;">🏆</div>
      <div style="color:#fff;font-size:16px;font-weight:bold;">মাসিক রেফারেল কনটেস্ট</div>
      <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:2px;"><%= contest.monthName %></div>
      <div style="color:rgba(255,255,255,0.9);font-size:12px;margin-top:6px;">সবচেয়ে বেশি রেফার করুন, বড় প্রাইজ জিতুন!</div>
    </div>

    <!-- প্রাইজ তালিকা -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;margin-bottom:16px;">
      <div style="color:#fff;font-weight:bold;margin-bottom:12px;">🎁 এই মাসের প্রইজ</div>
      <% contest.prizes.forEach(p => {
        const medal = p.rank === 1 ? '🥇' : p.rank === 2 ? '🥈' : p.rank === 3 ? '🥉' : '🏅';
      %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
          <span style="color:#fff;font-size:13px;"><%= medal %> <%= p.rank %>ম স্থান</span>
          <span style="color:#f59e0b;font-size:13px;font-weight:bold;"><%= p.prize %></span>
        </div>
      <% }) %>
    </div>

    <!-- লিডারবোর্ড -->
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;">
      <div style="color:#fff;font-weight:bold;margin-bottom:12px;">📊 লিডারবোর্ (এই মাস)</div>

      <% if (contest.leaders.length > 0) { %>
        <% contest.leaders.forEach(l => {
          const medal = l.rank === 1 ? '🥇' : l.rank === 2 ? '🥈' : l.rank === 3 ? '🥉' : l.rank + '.';
        %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;margin-bottom:6px;border-radius:10px;background:<%= l.isMe ? 'rgba(245,158,11,0.15)' : 'rgba(255,255,255,0.03)' %>;border:1px solid <%= l.isMe ? '#f59e0b' : 'transparent' %>;">
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="color:#94a3b8;font-size:14px;font-weight:bold;min-width:24px;"><%= medal %></span>
              <span style="color:#fff;font-size:13px;"><%= l.username %><%= l.isMe ? ' (আপনি)' : '' %></span>
            </div>
            <span style="color:#10b981;font-size:13px;font-weight:bold;"><%= l.referrals %> রেফার</span>
          </div>
        <% }) %>
      <% } else { %>
        <div style="color:#94a3b8;font-size:13px;text-align:center;padding:10px;">এই মাসে এখনো কেউ রেফার করেনি। আপনিই প্রথম হোন!</div>
      <% } %>

      <!-- আমার অবস্থান (টপ ২০-তে না থাকলে) -->
      <% if (contest.myRank) { %>
        <div style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.1);text-align:center;color:#94a3b8;font-size:12px;">
          এই মাসে আপনার রেফার: <strong style="color:#f59e0b;"><%= contest.myRank.referrals %></strong> জন — লিডারবোর্ডে উঠতে আরও রেফার করুন!
        </div>
      <% } %>
    </div>

    <p style="font-size:.75rem;color:#94a3b8;text-align:center;margin-top:1rem;line-height:1.6;">
      মাস শেষে শীর্ষ রেফারকারীদের প্রাইজ দেওয়া হবে।<br>
      আপনার রেফারেল লিংক বন্ধুদের সাথে শেয়ার করুন!
    </p>

    <a href="/profile/referral" style="display:block;text-align:center;background:var(--gold,#f59e0b);color:#000;text-decoration:none;padding:12px;border-radius:10px;font-weight:bold;margin-top:12px;">
      🔗 আমার রেফারেল লিংক দেখুন
    </a>

  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color:#94a3b8;">
      কনটেস্ট তথ্য লোড করা যায়নি। পরে আবার চেষ্টা করুন।
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

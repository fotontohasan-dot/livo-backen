<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz59-1 { padding: 16px; padding-bottom: 100px; max-width: 600px; margin: 0 auto; }
  .dz59-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz59-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz59-4 { background: linear-gradient(135deg,#f59e0b,#d97706); border-radius: 16px; padding: 20px; margin-bottom: 16px; text-align: center; }
  .dz59-5 { color: var(--text-main); font-size: 16px; font-weight: bold; }
  .dz59-6 { color: rgba(255,255,255,0.9); font-size: 13px; margin-top: 2px; }
  .dz59-7 { color: rgba(255,255,255,0.9); font-size: 12px; margin-top: 6px; }
  .dz59-8 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .dz59-9 { color: var(--text-main); font-weight: bold; margin-bottom: 12px; }
  .dz59-10 { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .dz59-11 { color: var(--text-main); font-size: 13px; }
  .dz59-12 { color: #f59e0b; font-size: 13px; font-weight: bold; }
  .dz59-13 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 18px; }
  .dz59-14 { color: var(--text-muted); font-size: 14px; font-weight: bold; min-width: 24px; }
  .dz59-15 { color: #10b981; font-size: 13px; font-weight: bold; }
  .dz59-16 { color: var(--text-muted); font-size: 13px; text-align: center; padding: 10px; }
  .dz59-17 { margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center; color: var(--text-muted); font-size: 12px; }
  .dz59-18 { color: #f59e0b; }
  .dz59-19 { font-size: .75rem; color: var(--text-muted); text-align: center; margin-top: 1rem; line-height: 1.6; }
  .dz59-20 { display: block; text-align: center; background: var(--gold,#f59e0b); color: #000; text-decoration: none; padding: 12px; border-radius: 10px; font-weight: bold; margin-top: 12px; }
  .dz59-21 { color: var(--text-main); font-weight: bold; font-size: 15px; margin-bottom: 12px; }
  .dz59-22 { background: rgba(255,255,255,0.05); border-radius: 14px; padding: 16px; margin-bottom: 12px; }
  .dz59-23 { color: var(--text-muted); font-size: 12px; margin-bottom: 8px; }
  .dz59-24 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 30px; text-align: center; color: var(--text-muted); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im60-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .im60-2 { font-size: 40px; margin-bottom: 6px; }
  .im60-3 { display: flex; align-items: center; gap: 10px; }
  .im60-4 { margin-top: 24px; }
</style>

<%- include('../partials/navbar') %>
<div class="container dz59-1">
  <%- include('../partials/flash') %>

  <div class="im60-1">
    <a class="dz59-2" href="/profile">←</a>
    <h1 class="dz59-3">🏆 রেফারেল কনটেস্</h1>
  </div>

  <% if (contest) { %>
    <!-- ব্যানার -->
    <div class="dz59-4">
      <div class="im60-2">🏆</div>
      <div class="dz59-5">মাসিক রেফারেল কনটেস্ট</div>
      <div class="dz59-6"><%= contest.monthName %></div>
      <div class="dz59-7">সবচেয়ে বেশি রেফার করুন, বড় প্রাইজ জিতুন!</div>
    </div>

    <!-- প্রাইজ তালিকা -->
    <div class="dz59-8">
      <div class="dz59-9">🎁 এই মাসের প্রইজ</div>
      <% contest.prizes.forEach(p => {
        const medal = p.rank === 1 ? '🥇' : p.rank === 2 ? '🥈' : p.rank === 3 ? '🥉' : '🏅';
      %>
        <div class="dz59-10">
          <span class="dz59-11"><%= medal %> <%= p.rank %>ম স্থান</span>
          <span class="dz59-12"><%= p.prize %></span>
        </div>
      <% }) %>
    </div>

    <!-- লিডারবোর্ড -->
    <div class="dz59-13">
      <div class="dz59-9">📊 লিডারবোর্ (এই মাস)</div>

      <% if (contest.leaders.length > 0) { %>
        <% contest.leaders.forEach(l => {
          const medal = l.rank === 1 ? '🥇' : l.rank === 2 ? '🥈' : l.rank === 3 ? '🥉' : l.rank + '.';
        %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;margin-bottom:6px;border-radius:10px;background:<%= l.isMe ? 'rgba(245,158,11,0.15)' : 'rgba(255,255,255,0.03)' %>;border:1px solid <%= l.isMe ? '#f59e0b' : 'transparent' %>;">
            <div class="im60-3">
              <span class="dz59-14"><%= medal %></span>
              <span class="dz59-11"><%= l.username %><%= l.isMe ? ' (আপনি)' : '' %></span>
            </div>
            <span class="dz59-15"><%= l.referrals %> রেফার</span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="dz59-16">এই মাসে এখনো কেউ রেফার করেনি। আপনিই প্রথম হোন!</div>
      <% } %>

      <!-- আমার অবস্থান (টপ ২০-তে না থাকলে) -->
      <% if (contest.myRank) { %>
        <div class="dz59-17">
          এই মাসে আপনার রেফার: <strong class="dz59-18"><%= contest.myRank.referrals %></strong> জন — লিডারবোর্ডে উঠতে আরও রেফার করুন!
        </div>
      <% } %>
    </div>

    <p class="dz59-19">
      মাস শেষে শীর্ষ রেফারকারীদের প্রাইজ দেওয়া হবে।<br>
      আপনার রেফারেল লিংক বন্ধুদের সাথে শেয়ার করুন!
    </p>

    <a class="dz59-20" href="/profile/referral">
      🔗 আমার রেফারেল লিংক দেখুন
    </a>

    <!-- পাস্ট কনটেস্ট রেজাল্ট -->
    <% if (pastContests && pastContests.length > 0) { %>
      <div class="im60-4">
        <div class="dz59-21">📜 আগের মাসের ফলাফল</div>
        <% pastContests.forEach(pc => { %>
          <div class="dz59-22">
            <div class="dz59-23"><%= pc.monthName %></div>
            <% pc.leaders.forEach(l => {
              const medal = l.rank === 1 ? '🥇' : l.rank === 2 ? '🥈' : l.rank === 3 ? '🥉' : l.rank + '.';
            %>
              <div style="display:flex;justify-content:space-between;padding:6px 0;<%= l.isMe ? 'color:#f59e0b;' : 'color:var(--text-muted);' %>font-size:13px;">
                <span><%= medal %> <%= l.username %><%= l.isMe ? ' (আপনি)' : '' %></span>
                <span><%= l.referrals %> রেফার<% if (l.prize) { %> — <%= l.prize %><% } %></span>
              </div>
            <% }); %>
          </div>
        <% }); %>
      </div>
    <% } %>

  <% } else { %>
    <div class="dz59-24">
      কনটেস্ট তথ্য লোড করা যায়নি। পরে আবার চেষ্টা করুন।
    </div>
  <% } %>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

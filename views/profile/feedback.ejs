<%- include('../partials/head') %>
<div class="container" style="padding:16px;padding-bottom:100px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold">💬 <%= t('fb_page_title') %></h1>
  </div>

  <%- include('../partials/flash') %>

  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;border:1px solid rgba(255,255,255,0.1)">
    <form action="/profile/feedback" method="POST" style="display:flex;flex-direction:column;gap:12px" id="feedback-form">
      <div>
        <label style="color:var(--text-muted);font-size:13px;display:block;margin-bottom:6px"><%= t('fb_label') %></label>
        <textarea name="message" id="feedback-message" required rows="6" placeholder="<%= t('fb_placeholder') %>"
          style="width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:12px;color:var(--text-main);font-size:14px;outline:none;resize:none"></textarea>
      </div>
      <button type="submit" id="feedback-submit" style="background:linear-gradient(90deg,#f59e0b,#fbbf24);color:#000;border:none;border-radius:8px;padding:12px;font-size:16px;font-weight:bold;cursor:pointer">
        <%= t('fb_submit') %>
      </button>
    </form>
  </div>
</div>
<%- include('../partials/navbar') %>

<script src="/js/content-filter.js"></script>
<script src="/js/views/profile-feedback.js"></script>

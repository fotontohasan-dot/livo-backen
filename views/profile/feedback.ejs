<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz79-1 { padding: 16px; padding-bottom: 100px; }
  .dz79-2 { color: var(--text-main); text-decoration: none; font-size: 20px; }
  .dz79-3 { color: var(--text-main); font-size: 18px; font-weight: bold; }
  .dz79-4 { background: rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; border: 1px solid rgba(255,255,255,0.1); }
  .dz79-5 { display: flex; flex-direction: column; gap: 12px; }
  .dz79-6 { color: var(--text-muted); font-size: 13px; display: block; margin-bottom: 6px; }
  .dz79-7 { width: 100%; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 12px; color: var(--text-main); font-size: 14px; outline: none; resize: none; }
  .dz79-8 { background: linear-gradient(90deg,#f59e0b,#fbbf24); color: #000; border: none; border-radius: 8px; padding: 12px; font-size: 16px; font-weight: bold; cursor: pointer; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im80-1 { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
</style>

<div class="container dz79-1">
  <div class="im80-1">
    <a class="dz79-2" href="/profile">←</a>
    <h1 class="dz79-3">💬 <%= t('fb_page_title') %></h1>
  </div>

  <%- include('../partials/flash') %>

  <div class="dz79-4">
    <form class="dz79-5" action="/profile/feedback" method="POST" id="feedback-form">
      <div>
        <label class="dz79-6"><%= t('fb_label') %></label>
        <textarea class="dz79-7" name="message" id="feedback-message" required rows="6" placeholder="<%= t('fb_placeholder') %>"></textarea>
      </div>
      <button class="dz79-8" type="submit" id="feedback-submit">
        <%= t('prof_deposit') %>
      </button>
    </form>
  </div>
</div>
<%- include('../partials/navbar') %>

<script src="/js/content-filter.js"></script>
<script src="/js/views/profile-feedback.js"></script>

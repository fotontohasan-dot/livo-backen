<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">🛡️ দায়িত্বশীল গেমিং</h1>
  </div>

  <!-- ব্যানার -->
  <div style="background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
    <div style="font-size:40px;margin-bottom:8px;">🛡️</div>
    <div style="color:var(--text-main);font-size:16px;font-weight:bold;margin-bottom:4px;">নিরাপদ ও নিয়ন্ত্রিত খেলা</div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;">নিজের জন্য সীমা নির্ধারণ করুন</div>
  </div>

  <!-- দৈনিক ডিপোজিট সীমা -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;margin-bottom:16px;">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:6px;">💰 দৈনিক ডিপোজিট সীমা</div>
    <div style="color:var(--text-muted);font-size:12px;margin-bottom:12px;">
      প্রতিদিন সর্বোচ্চ কত টাকা ডিপোজিট করতে পারবেন তা ঠিক করুন। এর বেশি ডিপোজিট আটকে যাবে।
    </div>
    <% if (rg && rg.daily_deposit_limit) { %>
      <div style="background:rgba(16,185,129,0.1);border:1px solid #10b981;border-radius:8px;padding:10px;margin-bottom:12px;color:#10b981;font-size:13px;">
        বর্তমান সীমা: <strong><%= Number(rg.daily_deposit_limit).toLocaleString('bn-BD') %> টাকা</strong>
      </div>
    <% } %>
    <form action="/profile/responsible/deposit-limit" method="POST">
      <input type="number" name="limit" placeholder="যেমন: 5000 (খালি রাখলে সীমা সরে যাবে)" min="0"
             style="width:100%;background:#1e1e1e;border:1px solid #333;color:#fff;padding:12px;border-radius:8px;margin-bottom:10px;">
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">সীমা সেট করুন</button>
    </form>
  </div>

  <!-- সেল্ফ এক্সক্লুশন -->
  <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:20px;">
    <div style="color:var(--text-main);font-weight:bold;margin-bottom:6px;">⏸️ অ্যাকাউন্ট বিরতি (Self-Exclusion)</div>
    <div style="color:var(--text-muted);font-size:12px;margin-bottom:12px;">
      নির্দিষ্ট সময়ের জন্য নিজের অ্যাকাউন্ট বন্ধ রাখুন। এই সময়ে লগইন করা যাবে না। বিরতি শুরু হলে সাথে সাথে লগআউট হবে।
    </div>
    <% if (rg && rg.self_exclude_until && (new Date(rg.self_exclude_until) > new Date())) { %>
      <div style="background:rgba(239,68,68,0.1);border:1px solid #ef4444;border-radius:8px;padding:10px;color:#ef4444;font-size:13px;">
        অ্যাকাউন্ট বন্ধ আছে <%= new Date(rg.self_exclude_until).toLocaleDateString('bn-BD') %> পর্যন্ত।
      </div>
    <% } else { %>
      <form action="/profile/responsible/self-exclude" method="POST" data-confirm="আপনি কি নিশ্চিত? এই সময়ে লগইন করা যাবে না।">
        <select name="days" style="width:100%;background:#1e1e1e;border:1px solid #333;color:#fff;padding:12px;border-radius:8px;margin-bottom:10px;">
          <option value="1">১ দিন</option>
          <option value="7">৭ দিন</option>
          <option value="30">৩০ দিন</option>
          <option value="90">৯০ দিন</option>
        </select>
        <button type="submit" class="btn" style="width:100%;justify-content:center;background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid #ef4444;">
          অ্যাকাউন্ট বিরতি নিন
        </button>
      </form>
    <% } %>
  </div>

  <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
    জুয়া আসক্তি তৈরি করতে পারে। দায়িত্বের সাথে খেলুন।<br>
    সাহায্য দরকার হলে সাপোর্টে যোগাযোগ করুন।
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

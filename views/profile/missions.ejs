<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:100px;max-width:600px;margin:0 auto;">
  <%- include('../partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/profile" style="color:#fff;text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:#fff;font-size:18px;font-weight:bold;">🎯 ডেইলি মিশন</h1>
  </div>

  <!-- ব্যানার -->
  <div style="background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:16px;padding:20px;margin-bottom:16px;text-align:center;">
    <div style="font-size:40px;margin-bottom:8px;">🎯</div>
    <div style="color:#fff;font-size:16px;font-weight:bold;margin-bottom:4px;">আজকের মিশন সম্পন্ন করুন</div>
    <div style="color:rgba(255,255,255,0.9);font-size:13px;">প্রতিদিন খলে মিশন শেষ করুন আর কয়েন জতুন</div>
  </div>

  <% if (missions && missions.length > 0) { %>
    <% missions.forEach(m => { %>
      <div style="background:rgba(255,255,255,0.05);border-radius:14px;padding:16px;margin-bottom:12px;border:1px solid <%= m.done && !m.claimed ? '#10b981' : 'transparent' %>;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <div style="color:#fff;font-size:14px;font-weight:600;"><%= m.title %></div>
          <div style="color:#f59e0b;font-size:13px;font-weight:bold;">+<%= m.reward %> 🪙</div>
        </div>

        <!-- প্রোগ্রেস বার -->
        <div style="background:rgba(255,255,255,0.1);border-radius:20px;height:10px;overflow:hidden;margin-bottom:6px;">
          <div style="width:<%= m.pct %>%;height:100%;background:linear-gradient(90deg,#10b981,#34d399);transition:width .5s;"></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <div style="color:#94a3b8;font-size:11px;">
            <%= Number(m.progress).toLocaleString('bn-BD') %> / <%= Number(m.target).toLocaleString('bn-BD') %>
          </div>

          <% if (m.claimed) { %>
            <span style="color:#10b981;font-size:12px;font-weight:bold;">✅ নেওয়া হয়েছে</span>
          <% } else if (m.done) { %>
            <form action="/profile/missions/claim/<%= m.id %>" method="POST" style="margin:0;">
              <button type="submit" style="background:#10b981;color:#fff;border:none;border-radius:8px;padding:6px 16px;font-size:12px;font-weight:bold;cursor:pointer;">
                ক্লেইম করন
              </button>
            </form>
          <% } else { %>
            <span style="color:#94a3b8;font-size:12px;">চলমান...</span>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:16px;padding:30px;text-align:center;color:#94a3b8;">
      এখন কোনো মিশন নেই। পরে আবার দখুন।
    </div>
  <% } %>

  <p style="font-size:.75rem;color:#94a3b8;text-align:center;margin-top:1rem;line-height:1.6;">
    ⏰ প্রতিদিন রাত ১২টায় মিশন রিসেট হয়।<br>
    গেম বা স্পোর্টস — দুটোই মিশনে গণনা হয়।
  </p>

</div>
<%- include('../partials/bottom-nav') %>
</body></html>

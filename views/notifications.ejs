<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz85-1 { padding: 1rem; padding-bottom: 100px; max-width: 800px; margin: 0 auto; }
  .dz85-2 { font-size: 0.75rem; color: var(--text-muted); }
  .dz85-3 { width: 8px; height: 8px; background: var(--gold); border-radius: 50%; }
  .dz85-4 { color: var(--text-main); font-weight: 600; margin-bottom: 2px; }
  .dz85-5 { color: var(--text-muted); font-size: 0.9rem; }
  .dz85-6 { padding: 3rem; text-align: center; color: var(--text-muted); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im86-1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; }
  .im86-2 { display: flex; flex-direction: column; gap: 12px; }
  .im86-3 { font-size: 1.5rem; margin-top: 4px; }
  .im86-4 { flex: 1; }
  .im86-5 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .im86-6 { font-size: 3rem; margin-bottom: 1rem; }
</style>

<%- include('partials/navbar') %>

<div class="container dz85-1">
  <%- include('partials/flash') %>

  <h1 class="im86-1">🔔 <%= t.notifications_title %></h1>

  <div class="layout-grid im86-2">
    <% if (notifications && notifications.length > 0) { %>
      <% notifications.forEach(n => { %>
        <div class="glass-card" style="padding:1rem;display:flex;gap:15px;align-items:start;opacity:<%= n.is_read ? '0.7' : '1' %>;border-left:4px solid <%= n.type==='success'?'#10b981':n.type==='warning'?'#f59e0b':'#3b82f6' %>">
          <div class="im86-3">
            <%= n.type==='success'?'✅':n.type==='warning'?'⚠️':'ℹ️' %>
          </div>
          <div class="im86-4">
            <div class="im86-5">
              <div class="dz85-2">
                <%= new Date(n.created_at).toLocaleString('bn-BD') %>
              </div>
              <% if (!n.is_read) { %>
                <span class="dz85-3"></span>
              <% } %>
            </div>
            <div class="dz85-4"><%= n.title %></div>
            <div class="dz85-5"><%= n.message %></div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-card dz85-6">
        <div class="im86-6">🔔</div>
        <p><%= t.no_notifications %></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/bottom-nav') %>
</body>
</html>

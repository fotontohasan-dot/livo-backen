<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container" style="padding:1rem;padding-bottom:100px;max-width:800px;margin:0 auto;">
  <%- include('partials/flash') %>

  <h1 style="font-size:1.8rem;font-weight:800;margin-bottom:1.5rem;">🔔 <%= t.notifications_title %></h1>

  <div class="layout-grid" style="display:flex;flex-direction:column;gap:12px;">
    <% if (notifications && notifications.length > 0) { %>
      <% notifications.forEach(n => { %>
        <div class="glass-card" style="padding:1rem;display:flex;gap:15px;align-items:start;opacity:<%= n.is_read ? '0.7' : '1' %>;border-left:4px solid <%= n.type==='success'?'#10b981':n.type==='warning'?'#f59e0b':'#3b82f6' %>">
          <div style="font-size:1.5rem;margin-top:4px;">
            <%= n.type==='success'?'✅':n.type==='warning'?'⚠️':'ℹ️' %>
          </div>
          <div style="flex:1;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
              <div style="font-size:0.75rem;color:var(--text-muted);">
                <%= new Date(n.created_at).toLocaleString('bn-BD') %>
              </div>
              <% if (!n.is_read) { %>
                <span style="width:8px;height:8px;background:var(--gold);border-radius:50%;"></span>
              <% } %>
            </div>
            <div style="color:var(--text-main);font-weight:600;margin-bottom:2px;"><%= n.title %></div>
            <div style="color:var(--text-muted);font-size:0.9rem;"><%= n.message %></div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-card" style="padding:3rem;text-align:center;color:var(--text-muted);">
        <div style="font-size:3rem;margin-bottom:1rem;">🔔</div>
        <p><%= t.no_notifications %></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/bottom-nav') %>
</body>
</html>

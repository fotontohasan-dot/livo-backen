<!-- views/partials/sidebar.ejs -->
<aside class="w-64 bg-slate-900 border-r border-slate-700 flex flex-col h-screen sticky top-0">
    <!-- Logo -->
    <div class="px-6 py-6 border-b border-slate-700">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
                <i class="fas fa-shield-alt text-white text-2xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-white">Livo</h1>
                <p class="text-[10px] text-slate-400 -mt-1">Admin Panel</p>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-3 py-4 overflow-y-auto">
        <div class="space-y-1">
            <!-- Dashboard -->
            <a href="/admin/dashboard" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-tachometer-alt w-5"></i>
                <span>Dashboard</span>
            </a>

            <!-- Users -->
            <a href="/admin/users" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'users') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-users w-5"></i>
                <span>Users</span>
            </a>

            <!-- KYC -->
            <a href="/admin/kyc" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'kyc') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-id-card w-5"></i>
                <span>KYC Verification</span>
            </a>

            <!-- Bets -->
            <a href="/admin/bets" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'bets') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-ticket-alt w-5"></i>
                <span>Bets</span>
            </a>

            <!-- Matches -->
            <a href="/admin/matches" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'matches') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-gamepad w-5"></i>
                <span>Matches</span>
            </a>

            <!-- Markets -->
            <a href="/admin/markets" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'markets') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-chart-line w-5"></i>
                <span>Markets</span>
            </a>

            <!-- Bonuses -->
            <a href="/admin/bonuses" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'bonuses') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-gift w-5"></i>
                <span>Bonuses</span>
            </a>

            <!-- Promotions -->
            <a href="/admin/promotions" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'promotions') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-tags w-5"></i>
                <span>Promotions</span>
            </a>

            <!-- Reports -->
            <a href="/admin/reports" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'reports') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-file-alt w-5"></i>
                <span>Reports</span>
            </a>

            <!-- News -->
            <a href="/admin/news" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'news') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-newspaper w-5"></i>
                <span>News</span>
            </a>

            <!-- Tournaments -->
            <a href="/admin/tournaments" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'tournaments') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-trophy w-5"></i>
                <span>Tournaments</span>
            </a>

            <!-- Chat -->
            <a href="/admin/chat" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'chat') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-comments w-5"></i>
                <span>Live Chat</span>
            </a>

            <!-- Activity Log -->
            <a href="/admin/activity" 
               class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all <%= (typeof activePage !== 'undefined' && activePage === 'activity') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
                <i class="fas fa-history w-5"></i>
                <span>Activity Log</span>
            </a>
        </div>
    </nav>

    <!-- Bottom Section -->
    <div class="p-4 border-t border-slate-700">
        <!-- Settings -->
        <a href="/admin/settings" 
           class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium transition-all mb-2 <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
            <i class="fas fa-cog w-5"></i>
            <span>Settings</span>
        </a>

        <!-- Logout -->
        <a href="/admin/logout" 
           class="flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-medium text-red-400 hover:bg-red-500/10 hover:text-red-400 transition-all">
            <i class="fas fa-sign-out-alt w-5"></i>
            <span>Logout</span>
        </a>
    </div>
</aside>

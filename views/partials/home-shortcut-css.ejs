/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  margin: 0 0 12px 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border-glass);
  border-bottom: 1px solid var(--border-glass);
  border-radius: 0;
  padding: 7px 0;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
}

.shortcut-item:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}

.shortcut-icon-wrapper {
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--text-accent);
  margin-bottom: 3px;
  box-shadow: none;
}

.shortcut-label {
  font-size: 10px;
  font-weight: 500;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 0.1px;
}


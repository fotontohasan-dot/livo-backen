<style>
  #livoPromo { position: fixed; right: 14px; bottom: 100px; z-index: 9998; width: 66px; height: 66px; cursor: pointer; touch-action: none; animation: livoFloat 3s ease-in-out infinite; user-select: none; }
  #livoPromo.dragging { animation: none; }
  @keyframes livoFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
  #livoPromo img { width: 66px; height: 66px; object-fit: contain; pointer-events: none; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5)); }
  #livoPromo .promo-x { position: absolute; top: -6px; left: -6px; width: 22px; height: 22px; background: #333; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; line-height: 1; border: 1px solid rgba(255,255,255,0.4); z-index: 2; }
  #livoPromo .promo-badge { position: absolute; top: -4px; right: -2px; width: 14px; height: 14px; background: #ef4444; border-radius: 50%; border: 2px solid #111; }

  #livoPromoMenu { position: fixed; right: 14px; bottom: 175px; z-index: 9999; background: #1a1a1a; border: 1px solid rgba(245,158,11,0.4); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: none; overflow: hidden; min-width: 215px; }
  #livoPromoMenu a { display: flex; align-items: center; gap: 10px; padding: 13px 16px; color: #fff; text-decoration: none; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.06); }
  #livoPromoMenu a:last-child { border-bottom: none; }
  #livoPromoMenu a:active { background: rgba(245,158,11,0.15); }
  #livoPromoMenu .mi-emoji { font-size: 18px; }

  #livoPopupOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 10000; display: none; align-items: center; justify-content: center; padding: 24px; }
  #livoPopupOverlay .popup-box { background: #fff; border-radius: 18px; max-width: 360px; width: 100%; position: relative; overflow: hidden; animation: livoPop .3s ease; }
  @keyframes livoPop { from{transform:scale(.85);opacity:0;} to{transform:scale(1);opacity:1;} }
  #livoPopupOverlay .popup-img { width: 100%; display: block; }
  #livoPopupOverlay .popup-banner { padding: 28px 20px 22px; text-align: center; color: #fff; }
  #livoPopupOverlay .popup-banner .big-emoji { font-size: 52px; display:block; margin-bottom: 8px; }
  #livoPopupOverlay .popup-banner h2 { font-size: 19px; font-weight: 800; margin: 0 0 8px; }
  #livoPopupOverlay .popup-banner p { font-size: 14px; margin: 0; opacity: 0.95; line-height: 1.5; }
  #livoPopupOverlay .popup-title-img { padding: 16px 20px 4px; text-align: center; color: #111; }
  #livoPopupOverlay .popup-title-img h2 { font-size: 17px; font-weight: 800; margin: 0 0 6px; }
  #livoPopupOverlay .popup-title-img p { font-size: 13px; margin: 0; color: #555; line-height: 1.5; }
  #livoPopupOverlay .popup-close { position: absolute; top: 10px; right: 10px; width: 38px; height: 38px; background: rgba(0,0,0,0.55); color: #fff; border: 2px solid #fff; border-radius: 50%; font-size: 22px; font-weight: bold; line-height: 1; cursor: pointer; z-index: 5; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }
  #livoPopupOverlay .popup-actions { display: flex; gap: 8px; padding: 14px 16px 12px; background: #fff; }
  #livoPopupOverlay .popup-actions button { flex: 1; padding: 12px; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; }
  #livoPopupOverlay .btn-prev { background: #eee; color: #444; }
  #livoPopupOverlay .btn-next { background: #e11d48; color: #fff; }
  #livoPopupOverlay .popup-dots { display: flex; justify-content: center; gap: 6px; padding-bottom: 14px; background: #fff; }
  #livoPopupOverlay .popup-dots span { width: 8px; height: 8px; border-radius: 50%; background: #ddd; }
  #livoPopupOverlay .popup-dots span.active { background: #e11d48; }
</style>

<div id="livoPopupOverlay">
  <div class="popup-box">
    <button class="popup-close" onclick="livoClosePopup()">×</button>
    <div id="livoPopupBody"></div>
    <div class="popup-dots" id="livoPopupDots"></div>
    <div class="popup-actions">
      <button class="btn-prev" onclick="livoPrevPopup()">পূর্ববর</button>
      <button class="btn-next" onclick="livoNextPopup()">পরবর্তী</button>
    </div>
  </div>
</div>

<div id="livoPromoMenu">
  <a href="/promotions"><span class="mi-emoji">🎉</span> সদস্য উদযাপন দিবস</a>
  <a href="/profile/vip"><span class="mi-emoji">👑</span> VIP সদস্যদের সুবিধা</a>
  <a href="/profile/app-download"><span class="mi-emoji">📲</span> অ্যাপ ডাউনলোড করুন</a>
  <a href="/tournaments"><span class="mi-emoji">🏆</span> টুর্নামেন্ট</a>
  <a href="/profile/wheel"><span class="mi-emoji">🎡</span> লাকি সন</a>
</div>

<div id="livoPromo">
  <div class="promo-x" onclick="livoHidePromo(event)">×</div>
  <div class="promo-badge"></div>
  <img src="<%= promoIcon %>" alt="promo" onerror="this.style.display='none';this.parentElement.insertAdjacentHTML('beforeend','<div style=\'width:66px;height:66px;border-radius:16px;background:radial-gradient(circle at 30% 25%,#ff5a5a,#c81d1d);display:flex;align-items:center;justify-content:center;font-size:32px;\'>🧧</div>')">
</div>


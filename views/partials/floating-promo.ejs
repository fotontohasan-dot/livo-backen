<!-- ব্যবহার: হোমপেজে include করুন -->

<!-- ====== এখানে আপনার ছবির লিংক বসান (https://...) ====== -->
<%
  var promoIcon   = "";  // ভাসমান আইকন (খালি = সুন্দর লাল প্যাকেট ইমোজি)
  var popupImg1   = "https://i.postimg.cc/RWxKYRSh/IMG-3413.jpg";  // পপআপ ১ ছবি
  var popupImg2   = "https://i.postimg.cc/w7mDFPpR/IMG-3414.jpg";  // পপআপ ২ ছবি
  var popupImg3   = "https://i.postimg.cc/hXRTYrDj/photo-output.jpg";  // পপআপ ৩ ছবি

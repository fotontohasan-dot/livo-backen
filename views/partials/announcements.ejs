<% if (typeof activeAnnouncements !== 'undefined' && activeAnnouncements && activeAnnouncements.length) {
  const annLang = typeof lang !== 'undefined' ? lang : 'bn';
  const banners = activeAnnouncements.filter(a => a.type === 'banner');
  const scrolling = activeAnnouncements.filter(a => a.type === 'scrolling');
  const popups = activeAnnouncements.filter(a => a.type === 'popup');
  const inapp = activeAnnouncements.filter(a => a.type === 'inapp');
%>
  <% banners.forEach(function(a) { %>
    <div class="livo-announce-banner dz4-1" data-ann-id="<%= a.id %>">
      <span><i class="fas fa-bullhorn dz4-2"></i><%= annLang === 'en' && a.title_en ? a.title_en : (a.title_bn || '') %> — <%= annLang === 'en' && a.message_en ? a.message_en : a.message_bn %></span>
      <button class="dz4-3" data-dismiss-announcement="<%= a.id %>" data-dismiss-target=".livo-announce-banner">&times;</button>
    </div>
  <% }) %>

  <% if (scrolling.length) { %>
    <div class="bk-ticker" id="bkTicker">
      <div class="bk-ticker-bell"><i class="fas fa-bell"></i></div>
      <div class="bk-ticker-track">
        <div class="bk-ticker-text" id="bkNotice">
          <% scrolling.forEach(function(a, i) { %><span><%= annLang === 'en' && a.message_en ? a.message_en : a.message_bn %></span><% if (i < scrolling.length - 1) { %><span class="bk-ticker-sep">&nbsp;&nbsp;★&nbsp;&nbsp;</span><% } %><% }) %>
        </div>
      </div>
      <a href="/app/update" class="bk-ticker-app"><i class="fas fa-download"></i> APP</a>
    </div>
    <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz4-1 { background: linear-gradient(90deg,#1a1a1a,#2a2205); border-bottom: 1px solid rgba(234,179,8,0.35); color: #fff; padding: 10px 16px; font-size: 13px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .dz4-2 { color: var(--gold,#EAB308); margin-right: 6px; }
  .dz4-3 { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 15px; }
  .dz4-4 { display: inline-block; padding-left: 100%; animation: livoScrollAnnounce 28s linear infinite; color: #EAB308; font-size: 12.5px; font-weight: 600; }
  .dz4-5 { cursor: default; }
  .dz4-6 { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 99998; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .dz4-7 { background: #17181d; border: 1px solid rgba(234,179,8,0.35); border-radius: 20px; max-width: 420px; width: 100%; padding: 24px; text-align: center; }
  .dz4-8 { color: var(--gold,#EAB308); font-size: 30px; margin-bottom: 12px; }
  .dz4-9 { color: #fff; font-size: 17px; font-weight: 800; margin: 0 0 8px; }
  .dz4-10 { color: #cbd5e1; font-size: 13.5px; margin: 0 0 18px; line-height: 1.6; }
  .dz4-11 { width: 100%; padding: 12px; border-radius: 12px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). A declaration was moved only when no !important rule in
     the site CSS can match this element for that property. */
  .ix4-1 { background: #17181d; border-bottom: 1px solid rgba(234,179,8,0.25); overflow: hidden; white-space: nowrap; padding: 8px 0; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im4-1 { margin-right: 60px; }
  .im4-2 { font-size: 5px; vertical-align: middle; margin-right: 8px; }@keyframes livoScrollAnnounce { from { transform: translateX(0); } to { transform: translateX(-100%); } }

  /* ===== bk666-স্টাইল টিকার বার ===== */
  .bk-ticker {
    display: flex;
    align-items: center;
    height: 38px;
    background: #1a1a1a;
    overflow: hidden;
    /* GPU লেয়ারে প্রোমোট করা — sub-pixel scroll-এর সময় স্ক্রিনশট-২-এর মতো লাইন গ্লিচ আটকায় */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
  }
  .bk-ticker-bell {
    flex: 0 0 auto;
    margin: 0 10px;
    color: #FFC107;
    font-size: 15px;
    display: flex;
    align-items: center;
  }
  .bk-ticker-track {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    transform: translateZ(0);
  }
  .bk-ticker-text {
    display: inline-block;
    white-space: nowrap;
    color: #fff;
    font-size: 12.5px;
    font-weight: 500;
    animation: scrollLeft 20s linear infinite;
    will-change: transform;
  }
  .bk-ticker-sep { color: #FFC107; }
  .bk-ticker-app {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 10px 0 8px;
    padding: 4px 12px;
    background: #FFD700;
    color: #000;
    font-size: 11px;
    font-weight: 800;
    border-radius: 12px;
    text-decoration: none;
    white-space: nowrap;
  }
  @keyframes scrollLeft {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
</style>
  <% } %>

  <% inapp.forEach(function(a) { %>
    <div class="livo-toast info dz4-5" data-ann-id="<%= a.id %>">
      <i class="fas fa-bullhorn"></i>
      <span><%= annLang === 'en' && a.title_en ? a.title_en : a.title_bn %>: <%= annLang === 'en' && a.message_en ? a.message_en : a.message_bn %></span>
    </div>
  <% }) %>

  <% if (popups.length) { %>
    <% const p = popups[0]; %>
    <div class="dz4-6" id="livoAnnouncePopupOverlay">
      <div class="dz4-7">
        <i class="fas fa-bullhorn dz4-8"></i>
        <h3 class="dz4-9"><%= annLang === 'en' && p.title_en ? p.title_en : (p.title_bn || '') %></h3>
        <p class="dz4-10"><%= annLang === 'en' && p.message_en ? p.message_en : p.message_bn %></p>
        <button data-dismiss-announcement="<%= p.id %>" data-dismiss-id="livoAnnouncePopupOverlay" class="btn btn-gold dz4-11"><%= annLang === 'en' ? 'Close' : 'বন্ধ করুন' %></button>
      </div>
    </div>
  <% } %>

  <script src="/js/views/partials-announcements.js"></script>
<% } %>

<footer style="background:var(--bg-surface);border-top:1px solid var(--border-glass);color:var(--text-muted);padding:40px 16px 90px;margin-top:30px;">
  <div style="max-width:900px;margin:0 auto;">

    <!-- Brand and Links -->
    <div style="text-align:center;">
      <div class="text-main" style="font-size:2rem;font-weight:700;margin-bottom:20px;"><%= siteName %></div>
      <div style="display:flex;flex-wrap:wrap;gap:15px;justify-content:center;margin-bottom:25px;">
        <a href="/privacy" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.privacy_policy %></a>
        <a href="/terms" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.terms_conditions %></a>
        <a href="/rules" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.rules_regulation %></a>
        <a href="/kyc" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.kyc %></a>
      </div>
      <div style="display:flex;gap:12px;justify-content:center;margin-bottom:30px;">
        <div class="glass" style="padding:6px 16px;border-radius:8px;font-size:12px;font-weight:700;color:var(--primary);">🔞 18+</div>
        <div class="glass text-muted" style="padding:6px 16px;border-radius:8px;font-size:12px;">Curacao Licensed</div>
      </div>
    </div>

    <!-- লাইসেন্স সেকশন -->
    <div style="margin-bottom:30px;">
      <h3 class="text-main" style="font-size:16px;font-weight:700;margin-bottom:16px;text-align:center;"><%= t.footer_license_title %></h3>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">BMM</div>
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">iTech Labs</div>
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">GLI Certified</div>
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">MGA</div>
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">Gaming Labs</div>
        <div class="glass" style="padding:14px 8px;border-radius:12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;opacity:0.7;">PAGCOR</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:10px;">
      <!-- সুরক্ষা করা সেকশন -->
      <div>
        <h3 class="text-main" style="font-size:14px;font-weight:700;margin-bottom:14px;"><%= t.footer_security_title %></h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="glass" style="padding:14px 6px;border-radius:12px;text-align:center;font-size:11px;font-weight:700;opacity:0.7;">iovation</div>
          <div class="glass" style="padding:14px 6px;border-radius:12px;text-align:center;font-size:11px;font-weight:700;opacity:0.7;">ThreatMetrix</div>
        </div>
      </div>

      <!-- দায়িত্বশীলভাবে খেলুন সেকশন -->
      <div>
        <h3 class="text-main" style="font-size:14px;font-weight:700;margin-bottom:14px;"><%= t.footer_responsible_gaming_title %></h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="glass" style="padding:14px 6px;border-radius:12px;text-align:center;font-size:11px;font-weight:700;opacity:0.7;">GamCare</div>
          <div class="glass" style="padding:14px 6px;border-radius:12px;text-align:center;font-size:11px;font-weight:700;opacity:0.85;color:var(--primary);">BeGambleAware</div>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div style="padding-top:24px;margin-top:20px;border-top:1px solid var(--border-glass);text-align:center;">
      <p style="font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">
        <%= t.responsible_gaming_msg %>
      </p>
      <p style="font-size:10px;color:var(--text-muted);">
        <%= t.footer_copyright %>
      </p>
    </div>

  </div>
</footer>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .qq2-1 { width: 62%; }
  .qq2-2 { width: 50%; }
  .qq2-3 { width: 30%; }
  .qq2-4 { width: 20%; }
  .qq2-5 { background: var(--gold); }
  .qq2-6 { background: var(--primary); }
  .qq2-7 { background: var(--secondary); }
</style>
<%
/* ==========================================================================
   টুর্নামেন্ট শোকেস — সাজসজ্জার সেকশন।

   ইচ্ছাকৃতভাবে সম্পূর্ণ স্থির: কোনো DB কোয়েরি নেই, কোনো রুট নেই, কোনো ফর্ম বা
   বোতাম নেই যা কিছু জমা দেয়। নিচের অ্যারেগুলোই এর একমাত্র ডেটা উৎস, তাই
   সেকশনটি কখনো ব্যর্থ হতে পারে না এবং কোনো ইউজারের ব্যালেন্স বা টুর্নামেন্টের
   অবস্থার সাথে এর সম্পর্ক নেই।

   ⚠️ সংখ্যা ও নামগুলো নমুনা। উপরের প্রিভিউ চিহ্নটি সরাবেন না যতক্ষণ না এখানে
   আসল ডেটা যুক্ত হয় — নাহলে ব্যবহারকারী নমুনা বিজয়ীদের আসল বিজয়ী ভেবে বসবেন।
   ========================================================================== */
const tshowFmt = function (n) { return Number(n).toLocaleString(locals.lang === 'en' ? 'en-US' : 'bn-BD'); };
const tshowLeaders = [
  { initial: 'R', nick: 'rakib_h',    bets: 48, points: 3820, prize: 25000 },
  { initial: 'S', nick: 'sumaiya_a',  bets: 39, points: 3150, prize: 15000 },
  { initial: 'T', nick: 'tanvir_i',   bets: 52, points: 2940, prize: 10000 },
  { initial: 'N', nick: 'nadia_r',    bets: 31, points: 2110, prize: null },
  { initial: 'F', nick: 'fahim_c',    bets: 27, points: 1870, prize: null }
];
const tshowMe = { initial: (typeof user !== 'undefined' && user && user.username) ? String(user.username)[0].toUpperCase() : '?', bets: 22, points: 1240, rank: 7 };
const tshowWinners = [
  { initial: 'S', nick: 'shakil_a', tour: t.tshow_sample_tour_football, prize: 18000 },
  { initial: 'M', nick: 'mitu_b',   tour: t.tshow_sample_tour_t20,      prize: 12500 },
  { initial: 'A', nick: 'ariful_h', tour: t.tshow_sample_tour_cricket,  prize: 9000 },
  { initial: 'S', nick: 'sadia_n',  tour: t.tshow_sample_tour_football, prize: 7200 }
];
%>

<section class="tshow" aria-label="<%= t.tshow_aria %>">

  <span class="tshow-ribbon"><i class="fas fa-eye"></i> <%= t.tshow_preview_badge %></span>

  <div class="tshow-grid">

    <div>
      <!-- হেডার: সময়ের রেল + নিজের অবস্থান -->
      <div class="tshow-hero">
        <div class="tshow-rail">
          <div class="tshow-rail-track"><div class="tshow-rail-fill qq2-1"></div></div>
          <div class="tshow-rail-text"><%= t.tshow_ends_in %> <b><%= t.tshow_sample_remaining %></b></div>
        </div>

        <div class="tshow-eyebrow"><%= t.tshow_running %></div>
        <div class="tshow-name"><%= t.tshow_sample_tour_cricket %></div>

        <div class="tshow-standing">
          <div class="tshow-pos">
            <span class="big"><%= tshowFmt(tshowMe.rank) %></span><span class="of">/<%= tshowFmt(142) %></span>
          </div>
          <div class="tshow-standing-meta">
            <span class="tshow-delta"><i class="fas fa-arrow-up"></i> <%= t.tshow_moved_up %></span>
            <div class="tshow-mypoints"><%= t.tshow_your_points %> <b><%= tshowFmt(tshowMe.points) %></b></div>
          </div>
        </div>
      </div>

      <!-- প্রাইজ পুল ও তার ভাগ -->
      <div class="tshow-pool">
        <div class="tshow-pool-top">
          <span class="tshow-pool-cur">৳</span>
          <span class="tshow-pool-amount"><%= tshowFmt(50000) %></span>
          <span class="tshow-pool-side"><%= tshowFmt(142) %> <%= t.tshow_participants %></span>
        </div>

        <div class="tshow-split">
          <i class="p1 qq2-2"></i><i class="p2 qq2-3"></i><i class="p3 qq2-4"></i>
        </div>

        <div class="tshow-key">
          <div><span class="amt">৳<%= tshowFmt(25000) %></span><span class="sw qq2-5"></span><%= t.tshow_first %></div>
          <div><span class="amt">৳<%= tshowFmt(15000) %></span><span class="sw qq2-6"></span><%= t.tshow_second %></div>
          <div><span class="amt">৳<%= tshowFmt(10000) %></span><span class="sw qq2-7"></span><%= t.tshow_third %></div>
        </div>
      </div>
    </div>

    <!-- লিডারবোর্ড -->
    <div class="tshow-board">
      <% tshowLeaders.forEach(function (row, i) { %>
        <% if (i === 3) { %>
          <div class="tshow-cut"><span><%= t.tshow_payout_line %></span><i></i></div>
        <% } %>
        <div class="tshow-row <%= row.prize ? 'is-paid' : '' %>">
          <div class="tshow-rank"><%= tshowFmt(i + 1) %></div>
          <div class="tshow-who">
            <div class="tshow-av"><%= row.initial %></div>
            <div>
              <div class="tshow-nick"><%= row.nick %></div>
              <div class="tshow-sub"><%= row.bets %> <%= t.tshow_bets %></div>
            </div>
          </div>
          <div class="tshow-score">
            <div class="pts"><%= tshowFmt(row.points) %></div>
            <% if (row.prize) { %>
              <div class="prize">৳<%= tshowFmt(row.prize) %></div>
            <% } else { %>
              <div class="prize blank">—</div>
            <% } %>
          </div>
        </div>
      <% }); %>

      <div class="tshow-row is-me">
        <div class="tshow-rank"><%= tshowFmt(tshowMe.rank) %></div>
        <div class="tshow-who">
          <div class="tshow-av"><%= tshowMe.initial %></div>
          <div>
            <div class="tshow-nick"><%= t.tshow_you %></div>
            <div class="tshow-sub"><%= tshowMe.bets %> <%= t.tshow_bets %></div>
          </div>
        </div>
        <div class="tshow-score">
          <div class="pts"><%= tshowFmt(tshowMe.points) %></div>
          <div class="prize blank">—</div>
        </div>
      </div>
    </div>

  </div>

  <!-- সাম্প্রতিক বিজয়ী -->
  <div class="tshow-winners">
    <% tshowWinners.forEach(function (w) { %>
      <div class="tshow-winner">
        <div class="tshow-av"><%= w.initial %></div>
        <div class="tshow-winner-name"><%= w.nick %></div>
        <div class="tshow-winner-tour"><%= w.tour %></div>
        <div class="tshow-winner-prize"><span class="cur">৳</span><%= tshowFmt(w.prize) %></div>
      </div>
    <% }); %>
  </div>

  <!-- নিয়ম -->
  <div class="tshow-rules">
    <details class="tshow-rule" open>
      <summary><%= t.tshow_rule_points_q %></summary>
      <p><%= t.tshow_rule_points_a %></p>
    </details>
    <details class="tshow-rule">
      <summary><%= t.tshow_rule_payout_q %></summary>
      <p><%= t.tshow_rule_payout_a %></p>
    </details>
    <details class="tshow-rule">
      <summary><%= t.tshow_rule_tie_q %></summary>
      <p><%= t.tshow_rule_tie_a %></p>
    </details>
    <details class="tshow-rule">
      <summary><%= t.tshow_rule_cancel_q %></summary>
      <p><%= t.tshow_rule_cancel_a %></p>
    </details>
  </div>

</section>

<!DOCTYPE html>
<html lang="<%= locals.lang || 'bn' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'Livo - সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো প্ল্যাটফর্ম' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <!-- রেফারেন্স স্ক্রিনশট-ম্যাচিং ভিজ্যুয়াল লেয়ার (style.css-এর পরে লোড হয়) -->
  <link rel="stylesheet" href="/css/reference-theme.css?v=<%= Date.now() %>">
  <!-- টুর্নামেন্ট শোকেস (সাজসজ্জার সেকশন) -->
  <link rel="stylesheet" href="/css/tournament-showcase.css?v=<%= Date.now() %>">

  <meta name="description" content="<%= locals.description || 'Livo-তে খেলুন বাংলাদেশের সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো গেম, জিতুন রিয়েল রিওয়ার্ড, নিরাপদ ও দ্রুত ডিপোজিট-উইথড্র সুবিধাসহ।' %>">
  <meta name="keywords" content="<%= locals.keywords || 'Livo, স্পোর্টস প্রেডিকশন, অনলাইন ক্যাসিনো, বাংলাদেশ বেটিং, ক্রিকেট প্রেডিকশন, লাইভ ক্যাসিনো, অনলাইন গেমিং বাংলাদেশ' %>">
  <meta name="theme-color" content="#0A1C14">

  <!-- Canonical — query-string/ট্র্যাকিং প্যারামিটারসহ URL যেন আলাদা পেজ হিসেবে ইনডেক্স না হয় -->
  <%# ==================== ইনডেক্সিং নিয়ন্ত্রণ ====================
      robots.txt শুধু ভদ্র ক্রলারই মানে, আর সেটা নিজেই সংবেদনশীল পথের
      একটা তালিকা প্রকাশ করে দেয়। তাই ব্যক্তিগত ও আর্থিক পেজে সরাসরি
      noindex মেটা বসানো হয় — এটা পেজ-প্রতি, তাই তালিকা ফাঁস হয় না।

      locals.noindex স্পষ্টভাবে দেওয়া থাকলে সেটাই মানা হয়; নইলে পাথ দেখে
      সিদ্ধান্ত। ডিফল্ট ইনডেক্সযোগ্য, কারণ পাবলিক পেজই বেশি। %>
  <% const __path = (locals.currentPath || (typeof originalUrl !== 'undefined' ? originalUrl : '') || '');
     const __private = /^\/(admin|profile|payment|kyc|extra|settings|wallet|transactions)/.test(__path);
     const __noindex = (typeof locals.noindex !== 'undefined') ? locals.noindex : __private; %>
  <% if (__noindex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <link rel="canonical" href="<%= (locals.baseUrl || '') + (locals.canonicalPath || '') %>">

  <!-- Open Graph / ফেসবুক-হোয়াটসঅ্যাপে শেয়ার করলে যেভাবে দেখাবে -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Livo">
  <meta property="og:title" content="<%= locals.title || 'Livo - সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো প্ল্যাটফর্ম' %>">
  <meta property="og:description" content="<%= locals.description || 'Livo-তে খেলুন বাংলাদেশের সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো গেম, জিতুন রিয়েল রিওয়ার্ড, নিরাপদ ও দ্রুত ডিপোজিট-উইথড্র সুবিধাসহ।' %>">
  <meta property="og:image" content="<%= locals.baseUrl || '' %>/icon-512.png">
  <meta property="og:url" content="<%= (locals.baseUrl || '') + (locals.canonicalPath || '') %>">
  <meta property="og:locale" content="<%= locals.lang === 'en' ? 'en_US' : 'bn_BD' %>">

  <!-- Twitter/X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= locals.title || 'Livo - সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো প্ল্যাটফর্ম' %>">
  <meta name="twitter:description" content="<%= locals.description || 'Livo-তে খেলুন বাংলাদেশের সেরা স্পোর্টস প্রেডিকশন ও ক্যাসিনো গেম, জিতুন রিয়েল রিওয়ার্ড।' %>">
  <meta name="twitter:image" content="<%= locals.baseUrl || '' %>/icon-512.png">

  <!-- ফেভিকন -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Livo">
  <script src="/pwa.js" defer></script>
  <script src="/js/age-gate.js" defer></script>
  <script src="/js/team-crest.js" defer></script>
  <style>
    /* ==================== Livo Toast / Loading System ==================== */
    #livo-toast-root { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 99999; display: flex; flex-direction: column; gap: 10px; align-items: center; width: 100%; max-width: 440px; padding: 0 16px; pointer-events: none; }
    .livo-toast { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: #131a17; border: 1px solid rgba(201,162,39,0.35); color: #fff; padding: 13px 16px; border-radius: 14px; font-size: 13.5px; font-weight: 600; box-shadow: 0 10px 28px rgba(0,0,0,0.4); width: 100%; cursor: pointer; animation: livoToastIn .3s ease forwards; }
    .livo-toast.success { border-color: #10b981; } .livo-toast.success i { color: #10b981; }
    .livo-toast.error { border-color: #C83B3B; } .livo-toast.error i { color: #e57373; }
    .livo-toast.info { border-color: var(--gold, #C9A227); } .livo-toast.info i { color: var(--gold, #C9A227); }
    .livo-toast.leaving { animation: livoToastOut .25s ease forwards; }
    .livo-toast i { font-size: 16px; flex-shrink: 0; }
    @keyframes livoToastIn { from { opacity: 0; transform: translateY(-16px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes livoToastOut { to { opacity: 0; transform: translateY(-10px) scale(.96); } }
    .livo-spinner { width: 15px; height: 15px; border: 2.5px solid rgba(255,255,255,0.3); border-top-color: currentColor; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 6px; animation: livoSpin .7s linear infinite; }
    @keyframes livoSpin { to { transform: rotate(360deg); } }
    button:disabled { opacity: 0.75; cursor: not-allowed; }
  </style>

  <!-- ==================== CSRF টোকেন (Synchronizer Token Pattern) ====================
       middleware/csrf.js প্রতিটা GET রিকোয়েস্টে res.locals.csrfToken সেট করে দেয়।
       নিচের স্ক্রিপ্ট সব <form method="post"> এ স্বয়ংক্রিয়ভাবে hidden _csrf ফিল্ড বসায় এবং
       fetch/XHR দিয়ে পাঠানো POST/PUT/PATCH/DELETE-এ X-CSRF-Token হেডার যোগ করে — কোনো
       আলাদা ফর্ম বা JS ফাইল ম্যানুয়ালি এডিট না করেই পুরো সাইটে CSRF টোকেন কভারেজ পাওয়া যায়। -->
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
  <script src="/js/csrf-inject.js"></script>
  <script src="/js/ui-hooks.js" defer></script>
</head>
<body>
<script src="/js/views/partials-head.js"></script>

<div id="livo-toast-root"></div>
<script type="application/json" id="partials-headConfig"><%- jsonScriptSafe({
  success: (typeof success !== 'undefined' && success) ? success : [],
  error: (typeof error !== 'undefined' && error) ? error : []
}) %></script>



<% if (locals.currentPage === 'home') { %>
<div class="bottom-nav">
  <a href="/" onclick="location.href='/'; return false;" class="nav-link <%= (typeof activePage !== 'undefined' ? activePage : locals.currentPage) === 'home' ? 'active' : '' %>">
    <i class="fas fa-home"></i>
    <span><%= t.home %></span>
  </a>

  <a href="/extra/invitation" onclick="location.href='/extra/invitation'; return false;" class="nav-link <%= (typeof activePage !== 'undefined' ? activePage : locals.currentPage) === 'invitation' ? 'active' : '' %>">
    <i class="fas fa-user-plus"></i>
    <span><%= t.invite %></span>
  </a>

  <a href="/extra/promotion" onclick="location.href='/extra/promotion'; return false;" class="nav-link <%= (typeof activePage !== 'undefined' ? activePage : locals.currentPage) === 'promotion' ? 'active' : '' %>">
    <i class="fas fa-gift"></i>
    <span><%= t.promotion %></span>
  </a>

  <a href="/chat" onclick="location.href='/chat'; return false;" class="nav-link <%= (typeof activePage !== 'undefined' ? activePage : locals.currentPage) === 'chat' ? 'active' : '' %>">
    <i class="fas fa-headset"></i>
    <span><%= t.support %></span>
  </a>

  <a href="/profile" onclick="location.href='/profile'; return false;" class="nav-link <%= (typeof activePage !== 'undefined' ? activePage : locals.currentPage) === 'profile' ? 'active' : '' %>">
    <i class="fas fa-user-circle"></i>
    <span><%= t.member %></span>
  </a>
</div>
<% } %>

<div class="bottom-nav" style="background: #111; border-top: 1px solid rgba(255,255,255,0.05); padding: 8px 0;">
  <a href="/" onclick="location.href='/'; return false;" class="nav-link <%= locals.currentPage === 'home' ? 'active' : '' %>" style="color: <%= locals.currentPage === 'home' ? 'var(--primary)' : 'var(--text-muted)' %>">

    <span style="font-size: 11px; margin-top: 4px;"><%= t.home %></span>
  </a>

  <a href="/extra/invitation" onclick="location.href='/extra/invitation'; return false;" class="nav-link <%= locals.currentPage === 'invitation' ? 'active' : '' %>" style="color: <%= locals.currentPage === 'invitation' ? 'var(--primary)' : 'var(--text-muted)' %>">

<!-- ===== Why Choose Us + Trust (compact; footer লোগোর নিচে, লাইসেন্স ব্যাজের উপরে) ===== -->
<style nonce="<%= cspNonce %>">
/* "body" প্রিফিক্স: reference-theme.css-এর `body .why-us-*` নিয়মের চেয়ে বেশি জোর দিতে */
body .why-us-section { padding: 2px 0 10px; }
body .why-us-heading { text-align: center; margin-bottom: 6px; }
body .why-us-heading h2 {
  font-family: 'Teko', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.2px; line-height: 1.1;
  background: linear-gradient(135deg, var(--text-main) 40%, var(--gold-hover) 90%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  margin: 0 0 1px;
}
body .why-us-heading p { font-size: 9px; color: var(--text-muted); margin: 0; line-height: 1.3; }
body .why-us-grid, body .trust-badges-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px; }
body .trust-badges-grid { margin-top: 5px; }
body .why-us-card {
  display: flex; align-items: center; gap: 6px; text-align: left;
  border-radius: 8px; padding: 5px 7px;
}
body .why-us-icon {
  width: 20px; height: 20px; margin: 0; border-radius: 6px; flex-shrink: 0; font-size: 10px;
  display: flex; align-items: center; justify-content: center;
}
body .why-us-card h3 { font-size: 9.5px; font-weight: 800; color: var(--text-main); margin: 0; line-height: 1.25; }
body .why-us-card p { font-size: 8px; color: var(--text-muted); line-height: 1.3; margin: 0; }
body .trust-badge-item {
  display: flex; align-items: center; gap: 6px;
  border-radius: 8px; padding: 5px 7px;
}
body .trust-badge-item > i { font-size: 10px; width: 12px; text-align: center; flex-shrink: 0; }
body .trust-badge-item .label { font-size: 9px; font-weight: 700; color: var(--text-main); line-height: 1.25; }
body .trust-badge-item .sub { font-size: 8px; color: var(--text-muted); margin-top: 0; line-height: 1.2; }
@media (min-width: 640px) {
  body .why-us-grid, body .trust-badges-grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
<div class="why-us-section">
  <div class="why-us-heading">
    <h2><%= t.why_bet420_title %></h2>
    <p><%= t.why_bet420_subtitle %></p>
  </div>
  <div class="why-us-grid">
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-bolt"></i></div>
      <div><h3><%= t.feature_fast_withdraw %></h3><p><%= t.feature_fast_withdraw_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-chart-line"></i></div>
      <div><h3><%= t.feature_live_prediction %></h3><p><%= t.feature_live_prediction_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-headset"></i></div>
      <div><h3><%= t.feature_support %></h3><p><%= t.feature_support_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-gift"></i></div>
      <div><h3><%= t.feature_bonus %></h3><p><%= t.feature_bonus_desc %></p></div>
    </div>
  </div>
  <div class="trust-badges-grid">
    <div class="trust-badge-item">
      <i class="fas fa-shield-halved"></i>
      <div><div class="label"><%= t.trust_secure_payment %></div><div class="sub"><%= t.trust_ssl %></div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-headset"></i>
      <div><div class="label"><%= t.feature_support %></div><div class="sub"><%= t.trust_always_here %></div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-certificate"></i>
      <div><div class="label"><%= t.trust_licensed %></div><div class="sub">Curacao Licensed</div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-bolt"></i>
      <div><div class="label"><%= t.feature_fast_withdraw %></div><div class="sub"><%= t.trust_within_5_min %></div></div>
    </div>
  </div>
</div>

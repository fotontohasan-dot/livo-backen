<!-- ===== Why Choose Us + Trust (compact; footer লোগোর নিচে, লাইসেন্স ব্যাজের উপরে) ===== -->
<style nonce="<%= cspNonce %>">
.why-us-section { padding: 4px 0 14px; }
.why-us-heading { text-align: center; margin-bottom: 10px; }
.why-us-heading h2 {
  font-family: 'Teko', sans-serif; font-size: 20px; font-weight: 700; letter-spacing: 0.3px;
  background: linear-gradient(135deg, var(--text-main) 40%, var(--gold-hover) 90%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  margin: 0 0 2px;
}
.why-us-heading p { font-size: 10.5px; color: var(--text-muted); margin: 0; }
.why-us-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.why-us-card {
  display: flex; align-items: center; gap: 10px; text-align: left;
  background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);
  border-radius: 12px; padding: 9px 10px;
}
.why-us-icon {
  width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 13px;
  background: rgba(201, 162, 39,0.12); border: 1px solid rgba(201, 162, 39,0.25);
  color: var(--gold-hover);
}
.why-us-card h3 { font-size: 11.5px; font-weight: 800; color: var(--text-main); margin: 0 0 1px; }
.why-us-card p { font-size: 9.5px; color: var(--text-muted); line-height: 1.4; margin: 0; }
.trust-badges-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 8px; }
.trust-badge-item {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);
  border-radius: 12px; padding: 8px 10px;
}
.trust-badge-item i { font-size: 13px; color: #3ddc84; flex-shrink: 0; width: 16px; text-align: center; }
.trust-badge-item .label { font-size: 10.5px; font-weight: 700; color: var(--text-main); line-height: 1.3; }
.trust-badge-item .sub { font-size: 9px; color: var(--text-muted); margin-top: 1px; }
@media (min-width: 640px) {
  .why-us-grid, .trust-badges-grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
<div class="why-us-section">
  <div class="why-us-heading">
    <h2><%= t.why_bet420_title %></h2>
    <p><%= t.why_bet420_subtitle %></p>
  </div>
  <div class="why-us-grid">
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-bolt"></i></div>
      <div><h3><%= t.feature_fast_withdraw %></h3><p><%= t.feature_fast_withdraw_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-chart-line"></i></div>
      <div><h3><%= t.feature_live_prediction %></h3><p><%= t.feature_live_prediction_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-headset"></i></div>
      <div><h3><%= t.feature_support %></h3><p><%= t.feature_support_desc %></p></div>
    </div>
    <div class="why-us-card">
      <div class="why-us-icon"><i class="fas fa-gift"></i></div>
      <div><h3><%= t.feature_bonus %></h3><p><%= t.feature_bonus_desc %></p></div>
    </div>
  </div>
  <div class="trust-badges-grid">
    <div class="trust-badge-item">
      <i class="fas fa-shield-halved"></i>
      <div><div class="label"><%= t.trust_secure_payment %></div><div class="sub"><%= t.trust_ssl %></div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-headset"></i>
      <div><div class="label"><%= t.feature_support %></div><div class="sub"><%= t.trust_always_here %></div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-certificate"></i>
      <div><div class="label"><%= t.trust_licensed %></div><div class="sub">Curacao Licensed</div></div>
    </div>
    <div class="trust-badge-item">
      <i class="fas fa-bolt"></i>
      <div><div class="label"><%= t.feature_fast_withdraw %></div><div class="sub"><%= t.trust_within_5_min %></div></div>
    </div>
  </div>
</div>

<div class="side-menu" id="sideMenu">
  <div style="padding:20px;border-bottom:1px solid var(--border-glass);display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:12px;">
      <span class="nav-brand" style="color: var(--gold); font-family: 'Teko', sans-serif; font-size: 1.8rem;"><%= siteName %></span>
      <button id="theme-toggle-side" class="glass" style="width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold); border: 1px solid var(--border-glass); cursor: pointer; background: none;">
        <i class="fas fa-moon nav-theme-icon"></i>
      </button>
    </div>
        <button id="lvClose" style="background:none;border:none;color:var(--text-main);font-size:22px;cursor:pointer;">✕</button>

  </div>
  <% if(locals.user) { %>
  <div style="padding:15px 20px;border-bottom:1px solid var(--border-glass);display:flex;align-items:center;gap:12px;">
    <div style="width:45px;height:45px;border-radius:50%;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;color:var(--text-white);box-shadow: 0 0 10px var(--primary-glow);">
      <%= user.username[0].toUpperCase() %>
    </div>
    <div>
      <div style="font-weight:700;color:var(--text-main);"><%= user.username %></div>
      <div style="color:var(--gold);font-size:.85rem;font-family:'Teko',sans-serif;">💰 <%= t.balance %>: <span class="js-balance"><%= user.coins %></span></div>
    </div>
  </div>
  <% } %>
  <a href="/" class="menu-item"><i class="fas fa-home"></i> <%= t.menu_home %></a>
  <a href="/games/aviator" class="menu-item"><i class="fas fa-rocket"></i> <%= t.menu_aviator %></a>
  <a href="/games/slots" class="menu-item"><i class="fas fa-slot-machine"></i> <%= t.menu_slots %></a>
  <a href="/games/color-prediction" class="menu-item"><i class="fas fa-palette"></i> <%= t.menu_color %></a>
  <a href="/matches" class="menu-item"><i class="fas fa-futbol"></i> <%= t.menu_sports %></a>
  <a href="/tournaments" class="menu-item"><i class="fas fa-trophy"></i> <%= t.menu_tournament %></a>
  <a href="/payment/deposit" class="menu-item"><i class="fas fa-wallet"></i> <%= t.menu_deposit %></a>
  <a href="/payment/withdraw" class="menu-item"><i class="fas fa-money-bill-wave"></i> <%= t.menu_withdraw %></a>
  <a href="/leaderboard" class="menu-item"><i class="fas fa-medal"></i> <%= t.menu_leaderboard %></a>
  <a href="/news" class="menu-item"><i class="fas fa-newspaper"></i> <%= t.menu_news %></a>
  <a href="/profile" class="menu-item"><i class="fas fa-user"></i> <%= t.menu_profile %></a>
  <% if(locals.user && user.role === 'admin') { %>
  <a href="/admin" class="menu-item" style="color:var(--primary) !important;"><i class="fas fa-cog"></i> <%= t.menu_admin %></a>
  <% } %>
  <div style="padding:13px 20px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border-glass);">
    <span style="color:var(--text-muted);font-size:13px;">🌐</span>
    <div class="lang-switch">
      <a href="/lang/bn" class="lang-btn <%= lang === 'bn' ? 'active' : '' %>">বাং</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </div>
  <% if(locals.user) { %>
  <a href="/logout" class="menu-item" style="color:#ef4444 !important;"><i class="fas fa-sign-out-alt"></i> <%= t.logout %></a>
  <% } else { %>
  <a href="/login" class="menu-item" style="color:#10b981 !important;"><i class="fas fa-sign-in-alt"></i> <%= t.login %></a>
  <a href="/register" class="menu-item" style="color:var(--gold) !important;"><i class="fas fa-user-plus"></i> <%= t.register %></a>
  <% } %>
</div>

<div class="menu-overlay" id="menuOverlay"></div>


<nav class="navbar" style="position:relative; z-index:10000;">
  <div style="display:flex;align-items:center;gap:12px;">
    <button onclick="toggleMenu()" style="background:none;border:none;color:var(--text-main);font-size:24px;cursor:pointer;padding:0 12px;"><i class="fas fa-bars"></i></button>
    <div class="nav-brand" style="color: var(--text-main); font-family: 'Teko', sans-serif; font-size: 1.8rem; letter-spacing: 1px;"><%= siteName %></div>
  </div>
  <div style="display:flex;align-items:center;gap:12px;">
        

    <% if(locals.user) { %>
      <div class="glass" style="padding:4px 12px;border-radius:20px;font-size:13px;color:var(--gold);display:flex;align-items:center;gap:4px;font-family:'Teko',sans-serif;font-weight:700;">💰 <span class="js-balance"><%= user.coins %></span></div>
      <div style="display:flex;gap:12px;">
        <a href="/notifications" style="color:var(--text-main);font-size:18px;padding:8px;"><i class="fas fa-bell"></i></a>
        <a href="/news" style="color:var(--text-main);font-size:18px;padding:8px;"><i class="fas fa-envelope"></i></a>
      </div>
    <% } else { %>
      <a href="/login" class="btn btn-primary" style="padding:6px 14px;border-radius:20px;font-size:12px;">Login</a>
      <a href="/register" class="btn btn-secondary" style="padding:6px 14px;border-radius:20px;font-size:12px;">Register</a>
    <% } %>
  </div>
</nav>

<script>
window.addEventListener('error', function(ev){
  var bar = document.getElementById('navErrBar');
  if(!bar){ bar = document.createElement('div'); bar.id='navErrBar'; bar.style.cssText='position:fixed;top:0;left:0;right:0;z-index:999999;background:#dc2626;color:#fff;font-size:13px;padding:10px;text-align:center;'; document.body.appendChild(bar); }
  bar.textContent = 'ERROR: ' + ev.message + ' @ line ' + ev.lineno + ' (' + (ev.filename||'').split('/').pop() + ')';
});

function toggleMenu() {
  var menu = document.getElementById('sideMenu');
  var overlay = document.getElementById('menuOverlay');
  if (!menu) return;
  var willOpen = !menu.classList.contains('open');
  menu.classList.toggle('open', willOpen);
  if (overlay) overlay.classList.toggle('show', willOpen);
  document.body.classList.toggle('menu-open', willOpen);
}
window.toggleMenu = toggleMenu;
var lvHam = document.getElementById('lvHamburger'); if (lvHam) lvHam.addEventListener('click', toggleMenu);

var lvClose = document.getElementById('lvClose'); if (lvClose) lvClose.addEventListener('click', toggleMenu);
var lvOv = document.getElementById('menuOverlay'); if (lvOv) lvOv.addEventListener('click', toggleMenu);


document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') {
    var menu = document.getElementById('sideMenu');
    if (menu && menu.classList.contains('open')) toggleMenu();
  }
});

(function () {
  var btnNav = document.getElementById('theme-toggle-nav');
  var btnSide = document.getElementById('theme-toggle-side');
  function applyTheme(theme) {
    var light = theme === 'light';
    document.body.classList.toggle('light-mode', light);
    document.querySelectorAll('.nav-theme-icon').forEach(function (icon) {
      icon.className = 'fas ' + (light ? 'fa-sun' : 'fa-moon') + ' nav-theme-icon';
    });
  }
  applyTheme(localStorage.getItem('livo-theme') || 'dark');
  function handleToggle() {
    var next = document.body.classList.contains('light-mode') ? 'dark' : 'light';
    localStorage.setItem('livo-theme', next);
    applyTheme(next);
  }
  if (btnNav) btnNav.addEventListener('click', handleToggle);
  if (btnSide) btnSide.addEventListener('click', handleToggle);
})();


// ===== রিয়েল-টাইম ব্যালেন্স আপডেট =====
(function () {
  function refreshBalance() {
    fetch('/coins/balance', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.success && d.coins != null) {
          document.querySelectorAll('.js-balance').forEach(function (el) {
            el.textContent = d.coins;
          });
        }
      })
      .catch(function () {});
  }
  // অ্যাপে ফিরলে বা ট্যাব আবার দেখলে ব্যালেন্স রিফ্রেশ
  window.addEventListener('focus', refreshBalance);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) refreshBalance();
  });
  // প্রতি ৩০ সেকেন্ডে একবার
  setInterval(refreshBalance, 30000);
})();
</script>

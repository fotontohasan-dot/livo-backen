<nav class="navbar">
  <a href="/" class="nav-brand">🏆 Livo<span>Sport</span></a>
  <div class="nav-links">
    <a href="/matches">Matches</a>
    <a href="/tournaments">Tournaments</a>
    <a href="/news">News</a>
    <a href="/leaderboard">Leaderboard</a>
    <% if(locals.user && user.role === 'admin') { %>
      <a href="/admin" style="color:var(--secondary)">Admin</a>
    <% } %>
  </div>
  <div style="display:flex;align-items:center;gap:1rem;">
    <% if(locals.user) { %>
      <span class="nav-coins">🪙 <%= user.coins %></span>
      <a href="/notifications" style="text-decoration:none;color:var(--muted);font-size:1.2rem;">
        🔔
      </a>
      <a href="/profile" style="text-decoration:none;">
        <div class="avatar"><%= user.username[0].toUpperCase() %></div>
      </a>
      <a href="/logout" class="btn btn-outline btn-sm">Logout</a>
    <% } else { %>
      <a href="/login" class="btn btn-outline btn-sm">Login</a>
      <a href="/register" class="btn btn-primary btn-sm">Register</a>
    <% } %>
  </div>
</nav>

<nav class="navbar">
  <a href="/" class="nav-brand">LIVO</a>

  <div class="nav-links">
    <a href="/matches">ম্যাচ</a>
    <a href="/tournaments">টুর্নামেন্ট</a>
    <a href="/leaderboard">লিডারবোর্ড</a>
    <% if(locals.user && user.role === 'admin') { %>
      <a href="/admin" style="color:var(--secondary)">এডমিন</a>
    <% } %>
  </div>

  <div style="display:flex;align-items:center;gap:0.75rem;">
    <% if(locals.user) { %>
      <div class="nav-coins">🪙 <%= user.coins %></div>
      <a href="/notifications" style="text-decoration:none;font-size:1.2rem;">🔔</a>
      <a href="/profile" style="text-decoration:none;">
        <div class="avatar"><%= user.username[0].toUpperCase() %></div>
      </a>
    <% } else { %>
      <a href="/login" class="btn btn-outline btn-sm">লগইন</a>
      <a href="/register" class="btn btn-primary btn-sm">রেজিস্ট্রেশন</a>
    <% } %>
  </div>
</nav>

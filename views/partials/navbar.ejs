<div class="side-menu" id="sideMenu">
  <div style="padding:20px;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:space-between;">
    <span class="nav-brand" style="color: var(--primary); font-family: 'Teko', sans-serif; font-size: 1.8rem; font-weight:700;">LIVO</span>
    <button onclick="toggleMenu()" style="background:none;border:none;color:#fff;font-size:22px;cursor:pointer;">✕</button>
  </div>
  <% if(locals.user) { %>
  <div style="padding:15px 20px;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:12px;">
    <div style="width:45px;height:45px;border-radius:50%;background:var(--grad-primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;color:#fff;box-shadow: 0 0 10px var(--primary-glow);">
      <%= user.username[0].toUpperCase() %>
    </div>
    <div>
      <div style="font-weight:700;color:#fff;"><%= user.username %></div>
      <div style="color:var(--gold);font-size:.85rem;font-family:'Teko',sans-serif;">💰 <%= t.balance %>: <span class="js-balance"><%= user.coins %></span></div>
    </div>
  </div>
  <% } %>
  <a href="/" class="menu-item"><i class="fas fa-home"></i> <%= t.menu_home %></a>
  <a href="/games/aviator" class="menu-item"><i class="fas fa-rocket"></i> <%= t.menu_aviator %></a>
  <a href="/games/slots" class="menu-item"><i class="fas fa-slot-machine"></i> <%= t.menu_slots %></a>
  <a href="/games/color-prediction" class="menu-item"><i class="fas fa-palette"></i> <%= t.menu_color %></a>
  <a href="/matches" class="menu-item"><i class="fas fa-futbol"></i> <%= t.menu_sports %></a>
  <a href="/tournaments" class="menu-item"><i class="fas fa-trophy"></i> <%= t.menu_tournament %></a>
  <a href="/payment/deposit" class="menu-item"><i class="fas fa-wallet"></i> <%= t.menu_deposit %></a>
  <a href="/payment/withdraw" class="menu-item"><i class="fas fa-money-bill-wave"></i> <%= t.menu_withdraw %></a>
  <a href="/leaderboard" class="menu-item"><i class="fas fa-medal"></i> <%= t.menu_leaderboard %></a>
  <a href="/news" class="menu-item"><i class="fas fa-newspaper"></i> <%= t.menu_news %></a>
  <a href="/profile" class="menu-item"><i class="fas fa-user"></i> <%= t.menu_profile %></a>
  <% if(locals.user && user.role === 'admin') { %>
  <a href="/admin" class="menu-item" style="color:var(--primary) !important;"><i class="fas fa-cog"></i> <%= t.menu_admin %></a>
  <% } %>
  <div style="padding:13px 20px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(255,255,255,0.05);">
    <span style="color:#94a3b8;font-size:13px;">🌐</span>
    <div class="lang-switch">
      <a href="/lang/bn" class="lang-btn <%= lang === 'bn' ? 'active' : '' %>">বাং</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </div>
  <% if(locals.user) { %>
  <a href="/logout" class="menu-item" style="color:#ef4444 !important;"><i class="fas fa-sign-out-alt"></i> <%= t.logout %></a>
  <% } else { %>
  <a href="/login" class="menu-item" style="color:#10b981 !important;"><i class="fas fa-sign-in-alt"></i> <%= t.login %></a>
  <a href="/register" class="menu-item" style="color:var(--gold) !important;"><i class="fas fa-user-plus"></i> <%= t.register %></a>
  <% } %>
</div>

<div class="menu-overlay" id="menuOverlay" onclick="toggleMenu()"></div>

<nav class="navbar" style="background: #111; position:sticky; top:0; z-index:10000; border-bottom: 1px solid rgba(255,255,255,0.05);">
  <div style="display:flex;align-items:center;gap:8px;">
    <button onclick="toggleMenu()" style="background:none;border:none;color:#fff;font-size:20px;cursor:pointer;padding:8px;"><i class="fas fa-bars"></i></button>
    <div class="nav-brand" style="color: var(--primary); font-family: 'Teko', sans-serif; font-size: 1.8rem; letter-spacing: 0.5px; font-weight: 700;">LIVO</div>
  </div>

  <div style="display:flex;align-items:center;gap:10px;">
    <% if(locals.user) { %>
      <div style="display:flex;flex-direction:column;align-items:flex-end;">
        <div style="font-size:14px;color:var(--gold);font-family:'Teko',sans-serif;font-weight:700;display:flex;align-items:center;gap:4px;">
           <span class="js-balance"><%= user.coins %></span>
           <span style="font-size:10px; color:#fff;">৳</span>
        </div>
      </div>

      <div style="display:flex; gap:6px;">
        <a href="/payment/deposit" style="background:var(--grad-primary); color:#fff; font-size:10px; padding:4px 10px; border-radius:4px; text-decoration:none; font-weight:bold;"><%= t.deposit %></a>
        <a href="/payment/withdraw" style="background:#333; color:#fff; font-size:10px; padding:4px 10px; border-radius:4px; text-decoration:none; font-weight:bold;"><%= t.withdraw %></a>
      </div>

      <div style="display:flex; gap:8px; margin-left:4px;">
        <a href="/profile/rewards" title="Rewards" style="color:var(--gold); font-size:16px;"><i class="fas fa-gift"></i></a>
        <a href="/profile/cashback" title="Rebate" style="color:var(--gold); font-size:16px;"><i class="fas fa-percent"></i></a>
      </div>
    <% } else { %>
      <div class="lang-switch" style="background: rgba(255,255,255,0.05); border-radius: 4px; padding: 2px;">
        <a href="/lang/bn" class="lang-btn <%= lang === 'bn' ? 'active' : '' %>" style="border:none; padding: 2px 6px; font-size:10px;">BN</a>
        <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>" style="border:none; padding: 2px 6px; font-size:10px;">EN</a>
      </div>
      <a href="/login" style="color:#fff; font-size:12px; text-decoration:none; font-weight:bold; padding:4px 10px; border:1px solid rgba(255,255,255,0.2); border-radius:4px;">Login</a>
      <a href="/register" style="background:var(--grad-primary); color:#fff; font-size:12px; text-decoration:none; font-weight:bold; padding:4px 10px; border:1px solid rgba(255,255,255,0.05); border-radius:4px;">Join Now</a>
    <% } %>
  </div>
</nav>

<script>
function toggleMenu() {
  var menu = document.getElementById('sideMenu');
  var overlay = document.getElementById('menuOverlay');
  if (!menu) return;
  var willOpen = !menu.classList.contains('open');
  menu.classList.toggle('open', willOpen);
  if (overlay) overlay.classList.toggle('show', willOpen);
  document.body.classList.toggle('menu-open', willOpen);
}
window.toggleMenu = toggleMenu;

(function () {
  function refreshBalance() {
    fetch('/coins/balance', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.success && d.coins != null) {
          document.querySelectorAll('.js-balance').forEach(function (el) {
            el.textContent = d.coins;
          });
        }
      })
      .catch(function () {});
  }
  window.addEventListener('focus', refreshBalance);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) refreshBalance();
  });
  setInterval(refreshBalance, 30000);
})();
</script>

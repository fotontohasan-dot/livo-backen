<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .sp1-1.sp1-1.sp1-1 { color: var(--text-accent) !important; }
  .sp1-2.sp1-2.sp1-2 { color: var(--red-text) !important; }
  .sp1-3.sp1-3.sp1-3 { color: var(--green) !important; }
  .sp1-4.sp1-4.sp1-4 { color: var(--text-accent); font-family: 'Teko', sans-serif; font-size: 1.8rem; letter-spacing: 1px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .qq1-1 { padding: 20px; border-bottom: 1px solid var(--border-glass); display: flex; align-items: center; justify-content: space-between; }
  .qq1-2 { display: flex; align-items: center; gap: 12px; }
  .qq1-3 { color: var(--text-accent); font-family: 'Teko', sans-serif; font-size: 1.8rem; }
  .qq1-4 { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-accent); border: 1px solid var(--border-glass); cursor: pointer; background: none; }
  .qq1-5 { background: none; border: none; color: var(--text-main); font-size: 22px; cursor: pointer; }
  .qq1-6 { padding: 10px 20px; border-bottom: 1px solid var(--border-glass); display: flex; justify-content: center; }
  .qq1-7 { background: var(--bg-glass); border-radius: 20px; padding: 2px; border: 1px solid var(--border-glass); width: 100%; display: flex; }
  .qq1-8 { border: none; padding: 8px 0; border-radius: 18px; flex: 1; text-align: center; }
  .qq1-9 { padding: 15px 20px; border-bottom: 1px solid var(--border-glass); display: flex; align-items: center; gap: 12px; }
  .qq1-10 { width: 45px; height: 45px; border-radius: 50%; background: var(--grad-primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; color: var(--text-inverse); box-shadow: 0 0 10px var(--primary-glow); }
  .qq1-11 { font-weight: 700; color: var(--text-main); }
  .qq1-12 { color: var(--text-accent); font-size: .85rem; font-family: 'Teko',sans-serif; }
  .qq1-13 { position: relative; z-index: 1000; }
  .qq1-14 { background: none; border: none; color: var(--text-main); font-size: 24px; cursor: pointer; padding: 0 12px; }
  .qq1-15 { display: flex; gap: 4px; }
  .qq1-16 { display: flex; gap: 8px; }
</style>
<div class="side-menu" id="sideMenu">
  <div class="qq1-1">
    <div class="qq1-2">
      <span class="nav-brand qq1-3"><%= siteName %></span>
      <button id="theme-toggle-side" class="glass qq1-4">
        <i class="fas fa-moon nav-theme-icon"></i>
      </button>
    </div>
        <button class="qq1-5" id="lvClose">✕</button>

  </div>
  <div class="qq1-6">
    <div class="lang-switch qq1-7">
      <a href="/lang/bn" class="lang-btn <%= lang === 'bn' ? 'active' : '' %> qq1-8">BN</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %> qq1-8">EN</a>
    </div>
  </div>
  <% if(locals.user) { %>
  <div class="qq1-9">
    <div class="qq1-10">
      <%= user.username[0].toUpperCase() %>
    </div>
    <div>
      <div class="qq1-11"><%= user.username %></div>
      <div class="qq1-12">💰 <%= t.balance %>: <span class="js-balance"><%= user.coins %></span></div>
    </div>
  </div>
  <% } %>
  <a href="/" class="menu-item"><i class="fas fa-home"></i> <%= t.menu_home %></a>
  <a href="/games/aviator" class="menu-item"><i class="fas fa-rocket"></i> <%= t.menu_aviator %></a>
  <a href="/games/slots" class="menu-item"><i class="fas fa-slot-machine"></i> <%= t.menu_slots %></a>
  <a href="/games/color-prediction" class="menu-item"><i class="fas fa-palette"></i> <%= t.menu_color %></a>
  <a href="/matches" class="menu-item"><i class="fas fa-futbol"></i> <%= t.menu_sports %></a>
  <a href="/tournaments" class="menu-item"><i class="fas fa-trophy"></i> <%= t.menu_tournament %></a>
  <a href="/payment/deposit" class="menu-item"><i class="fas fa-wallet"></i> <%= t.menu_deposit %></a>
  <a href="/payment/withdraw" class="menu-item"><i class="fas fa-money-bill-wave"></i> <%= t.menu_withdraw %></a>
  <a href="/leaderboard" class="menu-item"><i class="fas fa-medal"></i> <%= t.menu_leaderboard %></a>
  <a href="/news" class="menu-item"><i class="fas fa-newspaper"></i> <%= t.menu_news %></a>
  <a href="/profile" class="menu-item"><i class="fas fa-user"></i> <%= t.menu_profile %></a>
  <% if(locals.user && user.role === 'admin') { %>
  <a href="/admin" class="menu-item sp1-1"><i class="fas fa-cog"></i> <%= t.menu_admin %></a>
  <% } %>
  <% if(locals.user) { %>
  <a href="/logout" class="menu-item sp1-2"><i class="fas fa-sign-out-alt"></i> <%= t.logout %></a>
  <% } else { %>
  <a href="/login" class="menu-item sp1-3"><i class="fas fa-sign-in-alt"></i> <%= t.login %></a>
  <a href="/register" class="menu-item sp1-1"><i class="fas fa-user-plus"></i> <%= t.register %></a>
  <% } %>
</div>

<div class="menu-overlay" id="menuOverlay"></div>


<% if (locals.currentPage === 'home') { %>
<nav class="navbar qq1-13">
  <div class="qq1-2">
    <button class="qq1-14" data-navbar-action="toggle-menu"><i class="fas fa-bars"></i></button>
    <div class="nav-brand sp1-4"><%= siteName %></div>
  </div>
  <div class="qq1-2">
        

    <% if(locals.user) { %>
      <!-- User Elements -->
      <%# ব্যালেন্স পিল — রেফারেন্স: ৳ <amount> + (ডিপোজিট শর্টকাট), রিফ্রেশ আলাদা আইকন %>
      <div class="nav-balance-box">
        <span class="nav-balance-currency">৳</span>
        <span class="js-balance"><%= Number(user.coins).toLocaleString(lang === 'bn' ? 'bn-BD' : 'en-US') %></span>
        <a href="/payment/deposit" class="nav-balance-add" aria-label="<%= t.deposit %>"><i class="fas fa-plus"></i></a>
      </div>
      <button data-navbar-action="refresh-balance" class="nav-refresh-btn" id="refreshBtn" aria-label="<%= t.refresh %>">
        <i class="fas fa-sync-alt"></i>
      </button>

      <div class="qq1-15">
        <a href="/notifications" class="nav-icon-link">
          <i class="fas fa-bell"></i>
          <span class="badge-dot"></span>
        </a>
        <a href="/profile/chat" class="nav-icon-link">
          <i class="fas fa-envelope"></i>
        </a>
      </div>
    <% } else { %>
      <!-- Auth Buttons -->
      <div class="qq1-16">
        <a href="/login" class="nav-btn-auth nav-btn-login"><%= t.login %></a>
        <a href="/register" class="nav-btn-auth nav-btn-register"><%= t.register %></a>
      </div>
    <% } %>
  </div>
</nav>
<% } %>

<script src="/js/views/partials-navbar.js"></script>

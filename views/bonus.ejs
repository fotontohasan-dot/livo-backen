<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Bonus - Livo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <style>
    body.bonus-body { background:#faece9; font-family:'Hind Siliguri', sans-serif; }
    .bonus-wrap { max-width:480px; margin:0 auto; min-height:100vh; background:#faece9; padding-bottom:90px; }

    /* Header */
    .bonus-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:16px 16px; position:sticky; top:0; z-index:200;
      background: linear-gradient(180deg, #ef4a3a, #e0392a);
    }
    .bonus-header .bh-btn { color:#fff; font-size:20px; width:32px; text-decoration:none; }
    .bonus-header .bh-title { color:#fff; font-size:19px; font-weight:700; }

    /* Banner */
    .bonus-banner {
      width:100%; display:block; height:auto;
    }

    /* Row */
    .bonus-row { display:flex; align-items:stretch; min-height:132px; }
    .bonus-row.tone-red    { background:#faece5; }
    .bonus-row.tone-pink   { background:#fbe7f3; }
    .bonus-row.tone-orange { background:#faece9; }
    .bonus-row + .bonus-row { border-top:8px solid #f3f3f3; }

    .bonus-card {
      flex: 0 0 30%;
      margin: 18px 0 18px 16px;
      border-radius: 18px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      text-align:center; color:#fff; padding: 10px 6px;
      box-shadow: 0 6px 14px rgba(0,0,0,0.12);
    }
    .bonus-card.grad-1 { background: linear-gradient(135deg, #f5273f 0%, #fb5570 100%); }
    .bonus-card.grad-2 { background: linear-gradient(135deg, #f634d1 0%, #fb5cc7 100%); }
    .bonus-card.grad-3 { background: linear-gradient(135deg, #ff2331 0%, #ff6b39 100%); }
    .bonus-card .bc-label { font-size:10.5px; font-weight:700; letter-spacing:0.3px; opacity:.95; }
    .bonus-card .bc-title { font-size:16px; font-weight:700; margin-top:4px; line-height:1.2; }
    .bonus-card .bc-date { font-size:11.5px; margin-top:4px; opacity:.9; }

    .bonus-mid {
      flex:1; display:flex; flex-direction:column; justify-content:center;
      padding: 10px 10px; min-width:0;
    }
    .bonus-mid .bm-label { font-size:12.5px; color:#8a8a8a; font-weight:600; }
    .bonus-mid .bm-text { font-size:13px; color:#333; line-height:1.45; margin-top:2px; }

    .bonus-due {
      flex: 0 0 27%; background:#fff; border-radius:18px 0 0 18px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      padding: 12px 4px; text-align:center;
    }
    .bonus-due .bd-label { font-size:11px; color:#9b9b9b; font-weight:600; }
    .bonus-due .bd-day { font-size:30px; font-weight:800; color:#1a1a1a; line-height:1; margin-top:2px; }
    .bonus-due .bd-day sub { font-size:11px; font-weight:600; color:#1a1a1a; margin-left:2px; }
    .bonus-due .bd-clock { font-size:14px; font-weight:700; color:#1a1a1a; margin-top:2px; font-variant-numeric: tabular-nums; }
    .bonus-claim {
      margin-top:8px; background: linear-gradient(180deg,#3adf12,#28c400); color:#fff; border:none;
      padding: 7px 20px; border-radius:20px; font-size:13px; font-weight:700;
      box-shadow: 0 3px 8px rgba(40,196,0,0.35); text-decoration:none; display:inline-block;
    }
  </style>
</head>
<body class="bonus-body">

  <div class="bonus-wrap">

    <div class="bonus-header">
      <a href="javascript:history.back()" class="bh-btn"><i class="fas fa-chevron-left"></i></a>
      <div class="bh-title">Bonus</div>
      <div class="bh-btn" style="text-align:right;"><i class="fas fa-ticket-alt"></i></div>
    </div>

    <img class="bonus-banner" src="/images/bonus/banner.png" alt="">

    <% vouchers.forEach(function(v){ %>
      <div class="bonus-row tone-<%= v.tone %>">
        <div class="bonus-card grad-<%= v.gradIndex %>">
          <div class="bc-label">REWARD VOUCHER</div>
          <div class="bc-title"><%= v.title %></div>
          <div class="bc-date"><%= v.dateLabel %></div>
        </div>
        <div class="bonus-mid">
          <div class="bm-label">Reward :</div>
          <div class="bm-text"><%= v.rewardText %></div>
        </div>
        <div class="bonus-due">
          <div class="bd-label">Due Date</div>
          <div class="bd-day"><span class="js-days">0</span><sub>Day</sub></div>
          <div class="bd-clock js-clock" data-due="<%= v.dueIso %>">--:--:--</div>
          <a class="bonus-claim" href="<%= v.claimUrl %>">Claim</a>
        </div>
      </div>
    <% }); %>

  </div>

  <%- include('partials/bottom-nav') %>

  <script>
    // প্রতিটি ভাউচারের কাউন্টডাউন — সার্ভার-দেওয়া due (পরবর্তী রাত ১২টা, Asia/Dhaka) পর্যন্ত।
    // প্রতি সেকেন্ডে আপডেট হয়, এবং ০:০০:০০ ছুঁলে নিজে থেকেই পরের দিনের জন্য রিসেট হয় (পেজ রিলোড ছাড়াই)।
    function tick() {
      document.querySelectorAll('.js-clock').forEach(function (el) {
        let due = new Date(el.getAttribute('data-due')).getTime();
        const now = Date.now();
        let diff = due - now;

        if (diff <= 0) {
          // মধ্যরাত পার হয়ে গেছে → পরের দিনের মধ্যরাত পর্যন্ত অটো রিস্টার্ট
          const next = new Date(due);
          while (next.getTime() <= now) next.setDate(next.getDate() + 1);
          el.setAttribute('data-due', next.toISOString());
          due = next.getTime();
          diff = due - now;

          // কার্ডের তারিখ লেবেলও (2026.07.13 ইত্যাদি) নতুন দিনের জন্য আপডেট করি
          const row = el.closest('.bonus-row');
          const dateEl = row && row.querySelector('.bc-date');
          if (dateEl) {
            const d = new Date(due);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            dateEl.textContent = `${y}.${m}.${day}`;
          }
        }

        const totalSec = Math.floor(diff / 1000);
        const days = Math.floor(totalSec / 86400);
        const hours = Math.floor((totalSec % 86400) / 3600);
        const mins = Math.floor((totalSec % 3600) / 60);
        const secs = totalSec % 60;

        const dayEl = el.closest('.bonus-due').querySelector('.js-days');
        if (dayEl) dayEl.textContent = days;

        const pad = n => String(n).padStart(2, '0');
        el.textContent = `${pad(hours)}:${pad(mins)}:${pad(secs)}`;
      });
    }
    tick();
    setInterval(tick, 1000);
  </script>

</body>
</html>


<%- include('../partials/head') %>

<!-- ==========================================================================
     Sports Hub — রেফারেন্স স্ক্রিনশট (স্ক্রিন ৩) অনুযায়ী।
     ডেটা আসে বিদ্যমান /matches/api/live এন্ডপয়েন্ট থেকে — কোনো বানানো ম্যাচ,
     স্কোর বা odds দেখানো হয় না। matches টেবিলে odds কলাম নেই, তাই odds সারি
     শুধু তখনই রেন্ডার হয় যখন API সত্যিই odds পাঠায়; নইলে "বিস্তারিত" লিংক।
     ========================================================================== -->
<style nonce="<%= cspNonce %>">
  .sp-topbar {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; gap: 10px;
    height: 52px; padding: 0 12px;
    background: var(--bg-dark); border-bottom: 1px solid var(--border-glass);
  }
  .sp-topbar__back, .sp-topbar__act {
    width: 34px; height: 34px; flex: 0 0 auto;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    color: var(--text-main); font-size: 17px; text-decoration: none;
  }
  .sp-topbar__title {
    flex: 1; text-align: center; font-size: 16px; font-weight: 700;
    color: var(--text-main); margin: 0;
  }

  .sp-tabs {
    display: flex; gap: 8px; overflow-x: auto;
    padding: 10px 12px; scrollbar-width: none;
    border-bottom: 1px solid var(--border-glass);
  }
  .sp-tabs::-webkit-scrollbar { display: none; }
  .sp-tab {
    flex: 0 0 auto; padding: 7px 15px; border-radius: 999px;
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    color: var(--text-muted); font-size: 12.5px; font-weight: 600;
    text-decoration: none; white-space: nowrap; cursor: pointer;
  }
  .sp-tab.active {
    background: var(--red); border-color: var(--red);
    color: #fff !important; -webkit-text-fill-color: #fff !important;
  }

  .sp-section-head { display: flex; align-items: center; gap: 10px; padding: 14px 12px 8px; }
  .sp-live-chip {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--red-text) !important; -webkit-text-fill-color: var(--red-text) !important;
    font-size: 12px; font-weight: 800; letter-spacing: .6px;
  }
  .sp-live-chip::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%;
    background: var(--red); animation: livedot 1.4s ease-in-out infinite;
  }
  @keyframes livedot { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .3; transform: scale(1.4); } }
  .sp-section-title { font-size: 13px; font-weight: 700; color: var(--text-main); margin: 0; }
  .sp-section-head .sp-divider { width: 1px; height: 13px; background: var(--border-glass); }

  .sp-list { display: flex; flex-direction: column; gap: 10px; padding: 0 12px 8px; }

  .sp-match {
    display: block; text-decoration: none;
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    border-radius: 12px; overflow: hidden;
  }
  .sp-match__head { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px 8px; }
  .sp-match__league { font-size: 11.5px; font-weight: 700; color: var(--text-main); }
  .sp-match__state { font-size: 11px; font-weight: 800; color: var(--red-text) !important; -webkit-text-fill-color: var(--red-text) !important; }
  .sp-match__state.is-upcoming { color: var(--text-muted) !important; -webkit-text-fill-color: var(--text-muted) !important; font-weight: 600; }

  .sp-match__teams { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; padding: 0 12px 10px; }
  .sp-team { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .sp-team.away { justify-content: flex-end; }
  .sp-team__name { font-size: 12.5px; font-weight: 600; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-score { font-size: 15px; font-weight: 800; color: var(--text-main); white-space: nowrap; padding: 0 6px; }
  .sp-score.is-time { font-size: 11.5px; font-weight: 600; color: var(--text-muted) !important; -webkit-text-fill-color: var(--text-muted) !important; }

  .sp-odds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0 10px 10px; }
  .sp-odd {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 10px; border-radius: 8px;
    background: var(--bg-surface-elevated); border: 1px solid var(--border-glass);
    font-size: 12px; font-weight: 700; color: var(--text-main);
  }
  .sp-odd span:first-child { color: var(--text-muted) !important; -webkit-text-fill-color: var(--text-muted) !important; font-weight: 600; }

  .sp-cta {
    display: block; margin: 0 10px 10px; padding: 9px;
    text-align: center; border-radius: 8px;
    background: rgba(0, 143, 90, .14); border: 1px solid var(--secondary);
    color: var(--secondary) !important; -webkit-text-fill-color: var(--secondary) !important;
    font-size: 12px; font-weight: 700; text-decoration: none;
  }

  .sp-empty { padding: 28px 16px; text-align: center; color: var(--text-muted) !important; -webkit-text-fill-color: var(--text-muted) !important; font-size: 12.5px; }
  .sp-skeleton { height: 92px; border-radius: 12px; background: var(--bg-surface); opacity: .55; }

  .sp-cats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 8px 12px 24px; }
  .sp-cat {
    display: flex; align-items: center; gap: 10px; text-decoration: none;
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    border-radius: 12px; padding: 14px 12px;
  }
  .sp-cat img { width: 34px; height: 34px; }
  .sp-cat b { display: block; font-size: 13px; color: var(--text-main); }
  .sp-cat small { font-size: 10.5px; color: var(--text-muted) !important; -webkit-text-fill-color: var(--text-muted) !important; }
</style>

<div class="sp-topbar">
  <a href="/" class="sp-topbar__back" aria-label="<%= t.nav_home %>"><i class="fas fa-arrow-left"></i></a>
  <h1 class="sp-topbar__title"><%= t.nav_sports %></h1>
  <button type="button" class="sp-topbar__act" id="spFilterBtn" aria-label="<%= t.all %>"><i class="fas fa-filter"></i></button>
  <a href="/matches" class="sp-topbar__act" aria-label="<%= t.view_all %>"><i class="fas fa-search"></i></a>
</div>

<div class="sp-tabs" id="spTabs" role="tablist">
  <button type="button" class="sp-tab active" data-filter="all"><%= t.all %></button>
  <button type="button" class="sp-tab" data-filter="live"><%= t.cat_live %></button>
  <button type="button" class="sp-tab" data-filter="football"><%= t.cat_football %></button>
  <button type="button" class="sp-tab" data-filter="cricket"><%= t.cat_cricket %></button>
</div>

<div class="sp-section-head">
  <span class="sp-live-chip">LIVE</span>
  <span class="sp-divider"></span>
  <h2 class="sp-section-title"><%= t.live_matches %></h2>
</div>
<div class="sp-list" id="spLive">
  <div class="sp-skeleton"></div>
  <div class="sp-skeleton"></div>
</div>

<div class="sp-section-head">
  <h2 class="sp-section-title"><%= t.matches_upcoming_title %></h2>
</div>
<div class="sp-list" id="spUpcoming">
  <div class="sp-skeleton"></div>
</div>

<div class="sp-cats">
  <a href="/matches/football" class="sp-cat">
    <img src="/images/sports/football.svg" alt="" aria-hidden="true" loading="lazy" width="96" height="96">
    <span><b><%= t.cat_football %></b><small><%= t.live_matches %></small></span>
  </a>
  <a href="/matches/cricket" class="sp-cat">
    <img src="/images/sports/cricket.svg" alt="" aria-hidden="true" loading="lazy" width="96" height="96">
    <span><b><%= t.cat_cricket %></b><small><%= t.live_matches %></small></span>
  </a>
  <a href="/tournaments" class="sp-cat">
    <img src="/images/sports/tournament.svg" alt="" aria-hidden="true" loading="lazy" width="96" height="96">
    <span><b><%= t.cat_tournaments %></b><small><%= t.cat_leaderboard %></small></span>
  </a>
  <a href="/matches" class="sp-cat">
    <img src="/images/sports/live.svg" alt="" aria-hidden="true" loading="lazy" width="96" height="96">
    <span><b><%= t.cat_live_matches %></b><small><%= t.all %></small></span>
  </a>
</div>

<script type="application/json" id="sports-indexConfig"><%- jsonScriptSafe({ currentPage: ['football','cricket'].includes(locals.currentPage) ? locals.currentPage : 'all', noMatches: t.no_matches_found, viewAll: t.view_all }) %></script>
<script src="/js/views/sports-index.js"></script>

<%- include('../partials/footer') %>
<%- include('../partials/bottom-nav') %>
</body></html>

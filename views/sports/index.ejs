<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('../partials/head') %>
  <title>Sports Hub | <%= siteName %></title>
</head>
<body class="bg-zinc-950 text-white min-h-screen pb-20">

  <%- include('../partials/header') %>

  <!-- Top Bar -->
  <div class="bg-yellow-500 p-4 flex items-center justify-between sticky top-0 z-50">
    <div class="bg-black text-yellow-500 px-5 py-2 rounded font-bold flex items-center gap-2">
      💰 Bets
    </div>
    <div class="text-sm font-medium">
      Main BDT 0.00<br>
      <span class="text-xs">Exposure 0.00</span>
    </div>
    <div class="flex gap-3">
      <button class="p-3 bg-zinc-900 rounded-xl">🔄</button>
      <button class="p-3 bg-zinc-900 rounded-xl">⚙️</button>
    </div>
  </div>

  <div class="p-4">
    <h1 class="text-3xl font-bold mb-6 text-yellow-400">Sports Hub</h1>

    <!-- Sports Tabs -->
    <div class="flex gap-2 mb-6 border-b border-gray-700">
      <a href="/sports/cricket" class="px-6 py-3 border-b-4 border-yellow-400 font-bold">🏏 Cricket</a>
      <a href="/sports/football" class="px-6 py-3 text-gray-400 hover:text-white">⚽ Football</a>
      <a href="/sports/tennis" class="px-6 py-3 text-gray-400 hover:text-white">🎾 Tennis</a>
    </div>

    <!-- Live Matches -->
    <div class="mb-8">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
        <span class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></span>
        LIVE MATCHES
      </h2>
      <a href="/matches" class="block bg-zinc-900 p-4 rounded-2xl mb-4">
        <div class="flex justify-between">
          <div>
            <div class="text-emerald-400 text-sm">In-Play</div>
            <div class="font-semibold">Sri Lanka Emerging vs West Indies</div>
          </div>
          <div class="text-right">
            <div class="text-yellow-400 font-bold">360/10</div>
            <div class="text-gray-400">122/4</div>
          </div>
        </div>
      </a>
    </div>

    <!-- All Sports -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-zinc-900 p-5 rounded-3xl">
        <div class="text-5xl mb-3">🏏</div>
        <h3 class="font-bold text-lg">Cricket</h3>
        <p class="text-gray-400 text-sm">13 Live Matches</p>
      </div>
      <div class="bg-zinc-900 p-5 rounded-3xl">
        <div class="text-5xl mb-3">⚽</div>
        <h3 class="font-bold text-lg">Football</h3>
        <p class="text-gray-400 text-sm">Coming Soon</p>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>
<div class="container" style="padding:16px;padding-bottom:120px;max-width:600px;margin:0 auto;">
  <%- include('partials/flash') %>

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
    <a href="/matches" style="color:var(--text-main);text-decoration:none;font-size:20px;">←</a>
    <h1 style="color:var(--text-main);font-size:18px;font-weight:bold;">🎯 <%= t.accumulator_bet %></h1>
  </div>

  <!-- ব্যানার -->
  <div style="background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:16px;padding:16px;margin-bottom:16px;text-align:center;">
    <div style="color:var(--text-main);font-size:15px;font-weight:bold;"><%= t.accumulator_desc %></div>
    <div style="color:rgba(255,255,255,0.9);font-size:12px;margin-top:4px;">
      <%= t.accumulator_boost_msg %>
    </div>
  </div>

  <% if (matches && matches.length > 0) { %>
    <div style="color:var(--text-muted);font-size:13px;margin-bottom:10px;"><%= t.select_selection_msg %></div>

    <% matches.forEach(m => { %>
      <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:14px;margin-bottom:12px;">
        <div style="color:var(--text-main);font-size:14px;font-weight:600;margin-bottom:10px;"><%= m.title %> <span style="color:var(--text-muted);font-size:11px;">(<%= m.sport %>)</span></div>
        <% m.markets.forEach(mk => {
          const runners = mk.odds && typeof mk.odds === 'object' ? Object.keys(mk.odds) : [];
        %>
          <div style="margin-bottom:8px;">
            <div style="color:var(--text-muted);font-size:12px;margin-bottom:5px;"><%= mk.market_name %></div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              <% runners.forEach(rn => {
                const odd = mk.odds[rn];
              %>
                <button type="button" class="acca-pick"
                        data-match="<%= m.match_id %>"
                        data-market="<%= mk.market_id %>"
                        data-mname="<%= mk.market_name %>"
                        data-runner="<%= rn %>"
                        data-odd="<%= odd %>"
                        style="background:#1e1e1e;border:1px solid #333;color:#fff;border-radius:8px;padding:8px 12px;font-size:12px;cursor:pointer;">
                  <%= rn %> <span style="color:#f59e0b;font-weight:bold;"><%= odd %></span>
                </button>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } else { %>
    <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:30px;text-align:center;color: var(--text-muted);">
      <%= t.no_open_markets_msg %>
    </div>
  <% } %>

  <!-- আমার অ্যাকুমুলেটর হিস -->
  <% if (myAccas && myAccas.length > 0) { %>
    <div style="margin-top:24px;">
      <div style="color:var(--text-main);font-weight:bold;margin-bottom:10px;">📜 <%= t.my_accumulators %></div>
      <% myAccas.forEach(a => {
        const color = a.status === 'won' ? '#10b981' : a.status === 'lost' ? '#ef4444' : '#f59e0b';
        const label = a.status === 'won' ? t.won : a.status === 'lost' ? t.lost : t.running;
      %>
        <div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:14px;margin-bottom:10px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
            <span style="color:var(--text-main);font-size:13px;font-weight:600;"><%= a.selection_count %> <%= t.selections_label %> <%= a.boost_percent > 0 ? '(+' + a.boost_percent + '% ' + t.boost_label + ')' : '' %></span>
            <span style="color:<%= color %>;font-size:12px;font-weight:bold;"><%= label %></span>
          </div>
          <div style="color:var(--text-muted);font-size:11px;">
            <%= t.stake_label %>: <%= a.stake %> · <%= t.total_odds_label %>: <%= a.total_odd %> · <%= t.potential_win_label %>: <span style="color:#f59e0b;"><%= a.potential_win %></span>
          </div>
          <div style="margin-top:8px;">
            <% a.selections.forEach(s => {
              const sc = s.status === 'won' ? '#10b981' : s.status === 'lost' ? '#ef4444' : '#94a3b8';
            %>
              <div style="font-size:11px;color:<%= sc %>;padding:2px 0;">• <%= s.market_name %> — <%= s.runner %> (<%= s.odd %>)</div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<!-- বট স্লিপ (নিচে ভাসমান) -->
<div id="betSlip" style="position:fixed;bottom:60px;left:0;right:0;background:#111;border-top:2px solid #f59e0b;padding:14px 16px;display:none;z-index:100;max-width:600px;margin:0 auto;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
    <span style="color:var(--text-main);font-weight:bold;font-size:14px;"><%= t.bet_slip %> (<span id="slipCount">0</span>)</span>
    <button data-acca-action="clear" style="background:none;border:none;color:#ef4444;font-size:12px;cursor:pointer;"><%= t.clear_all %></button>
  </div>
  <div id="slipItems" style="max-height:120px;overflow-y:auto;margin-bottom:8px;"></div>
  <div style="display:flex;gap:8px;align-items:center;">
    <input type="number" id="slipStake" placeholder="<%= t.stake_placeholder_short %>" min="10" style="flex:1;background:#1e1e1e;border:1px solid #333;color:#fff;padding:10px;border-radius:8px;">
    <button data-acca-action="place" style="background:#f59e0b;color:#000;border:none;border-radius:8px;padding:10px 16px;font-weight:bold;font-size:13px;cursor:pointer;"><%= t.place_bet %></button>
  </div>
  <div id="slipInfo" style="color:var(--text-muted);font-size:11px;margin-top:6px;text-align:center;"></div>
</div>

<script type="application/json" id="accumulatorConfig"><%- jsonScriptSafe({ minStake: t.min_stake_msg, minSelections: t.min_selections_msg, totalOdds: t.total_odds_label, boost: t.boost_label, potentialWin: t.potential_win_label, error: t.server_error }) %></script>
<script src="/js/views/accumulator.js"></script>
<%- include('partials/footer') %>
<%- include('partials/bottom-nav') %>
</body></html>

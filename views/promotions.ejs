<%- include('partials/head') %>

<div class="container" style="padding:0; background: var(--bg-dark); min-height: 100vh; padding-bottom: 80px;">

  <!-- Header -->
  <div style="background: #111; padding: 15px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; gap: 15px; position: sticky; top: 0; z-index: 100;">
    <a href="/" style="color: #fff; text-decoration: none;"><i class="fas fa-arrow-left"></i></a>
    <h1 style="color: #fff; font-size: 18px; font-weight: bold; margin: 0;">প্রমোশন এবং বোনাস</h1>
  </div>

  <div style="padding: 15px;">
    <!-- Promotions Grid -->
    <div style="display: flex; flex-direction: column; gap: 20px;">

      <!-- Promo 1 -->
      <div class="card" style="border-radius: 20px; overflow: hidden; border: 1px solid var(--primary); background: #111;">
        <div style="height: 140px; background: linear-gradient(135deg, #C8102E, #a30d25); display: flex; align-items: center; justify-content: center; position: relative;">
          <div style="font-size: 80px; opacity: 0.1; position: absolute; right: 20px;">🧧</div>
          <div style="text-align: center; z-index: 1;">
            <div style="font-family: 'Teko', sans-serif; font-size: 32px; color: var(--gold); line-height: 1;">১০০% ওয়েলকাম বোনাস</div>
            <div style="font-size: 12px; color: #fff; margin-top: 5px;">প্রথম ডিপোজিটে দ্বিগুণ ব্যালেন্স পান</div>
          </div>
        </div>
        <div style="padding: 15px; background: var(--bg-surface);">
          <div style="font-size: 13px; color: var(--text-muted); line-height: 1.5;">নতুন সদস্যদের জন্য বিশেষ অফার! ১০০০ টাকা পর্যন্ত ১০০% বোনাস উপভোগ করুন।</div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
            <div style="font-size: 11px; color: var(--gold); font-weight: bold;"><i class="fas fa-clock"></i> মেয়াদ: ৩১ ডিসেম্বর ২০২৪</div>
            <button onclick="location.href='/payment/deposit'" style="background: var(--grad-gold); color: #000; border: none; padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: bold;">ডিপোজিট করুন</button>
          </div>
        </div>
      </div>

      <!-- Promo 2 -->
      <div class="card" style="border-radius: 20px; overflow: hidden; border: 1px solid var(--border-glass); background: #111;">
        <div style="height: 140px; background: linear-gradient(135deg, #1e3a8a, #1e1b4b); display: flex; align-items: center; justify-content: center; position: relative;">
          <div style="font-size: 80px; opacity: 0.1; position: absolute; right: 20px;">💎</div>
          <div style="text-align: center; z-index: 1;">
            <div style="font-family: 'Teko', sans-serif; font-size: 32px; color: #60a5fa; line-height: 1;">১০% ডেইলি রিলোড বোনাস</div>
            <div style="font-size: 12px; color: #fff; margin-top: 5px;">প্রতিদিনের প্রথম ডিপোজিটে পান বোনাস</div>
          </div>
        </div>
        <div style="padding: 15px; background: var(--bg-surface);">
          <div style="font-size: 13px; color: var(--text-muted); line-height: 1.5;">আপনার প্রতিদিনের খেলাকে আরও আনন্দদায়ক করতে আমরা দিচ্ছি ১০% রিলোড বোনাস।</div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
            <div style="font-size: 11px; color: #60a5fa; font-weight: bold;"><i class="fas fa-sync"></i> প্রতিদিন ১বার</div>
            <button onclick="location.href='/payment/deposit'" style="background: #3b82f6; color: #fff; border: none; padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: bold;">বোনাস নিন</button>
          </div>
        </div>
      </div>

      <!-- Promo 3 -->
      <div class="card" style="border-radius: 20px; overflow: hidden; border: 1px solid var(--border-glass); background: #111;">
        <div style="height: 140px; background: linear-gradient(135deg, #7c2d12, #450a0a); display: flex; align-items: center; justify-content: center; position: relative;">
          <div style="font-size: 80px; opacity: 0.1; position: absolute; right: 20px;">🎁</div>
          <div style="text-align: center; z-index: 1;">
            <div style="font-family: 'Teko', sans-serif; font-size: 32px; color: #f87171; line-height: 1;">৫% উইকলি ক্যাশব্যাক</div>
            <div style="font-size: 12px; color: #fff; margin-top: 5px;">সাপ্তাহিক লসের ওপর ৫% ক্যাশব্যাক পান</div>
          </div>
        </div>
        <div style="padding: 15px; background: var(--bg-surface);">
          <div style="font-size: 13px; color: var(--text-muted); line-height: 1.5;">চিন্তা নেই! আপনার লস হলেও আমরা দিচ্ছি ৫% ক্যাশব্যাক যা প্রতি সোমবার আপনার ওয়ালেটে যোগ হবে।</div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
            <div style="font-size: 11px; color: #f87171; font-weight: bold;"><i class="fas fa-calendar-check"></i> প্রতি সোমবার</div>
            <button class="btn glass" style="padding: 8px 20px; border-radius: 20px; font-size: 12px; color: #fff; border-color: rgba(255,255,255,0.1);">বিস্তারিত</button>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

<%- include('partials/bottom-nav') %>

<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz54-1 { padding: 0; background: var(--bg-dark); min-height: 100vh; padding-bottom: 80px; }
  .dz54-2 { background: var(--grad-primary); padding: 20px; display: flex; align-items: center; gap: 15px; position: sticky; top: 0; z-index: 100; }
  .dz54-3 { color: var(--text-main); font-size: 18px; font-weight: bold; margin: 0; }
  .dz54-4 { padding: 15px; }
  .dz54-5 { border-radius: 20px; overflow: hidden; border: 1px solid var(--gold); background: var(--bg-surface); }
  .dz54-6 { height: 140px; background: linear-gradient(135deg, #006519, #004d13); display: flex; align-items: center; justify-content: center; position: relative; }
  .dz54-7 { font-family: 'Teko', sans-serif; font-size: 32px; color: #fff; line-height: 1; }
  .dz54-8 { font-size: 12px; color: #fff; margin-top: 5px; }
  .dz54-9 { padding: 15px; background: var(--bg-surface); }
  .dz54-10 { font-size: 13px; color: var(--text-muted); line-height: 1.5; }
  .dz54-11 { font-size: 11px; color: var(--text-accent); font-weight: bold; }
  .dz54-12 { background: var(--grad-gold); color: #000; border: none; padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: bold; }
  .dz54-13 { border-radius: 20px; overflow: hidden; border: 1px solid var(--border-glass); background: var(--bg-surface); }
  .dz54-14 { height: 140px; background: linear-gradient(135deg, #1e3a8a, #1e1b4b); display: flex; align-items: center; justify-content: center; position: relative; }
  .dz54-15 { font-family: 'Teko', sans-serif; font-size: 32px; color: #60a5fa; line-height: 1; }
  .dz54-16 { font-size: 12px; color: var(--text-main); margin-top: 5px; }
  .dz54-17 { font-size: 11px; color: #60a5fa; font-weight: bold; }
  .dz54-18 { background: #3473DA; color: #fff; border: none; padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: bold; }
  .dz54-19 { height: 140px; background: linear-gradient(135deg, #7c2d12, #450a0a); display: flex; align-items: center; justify-content: center; position: relative; }
  .dz54-20 { font-family: 'Teko', sans-serif; font-size: 32px; color: #f87171; line-height: 1; }
  .dz54-21 { font-size: 11px; color: #f87171; font-weight: bold; }
  .dz54-22 { padding: 8px 20px; border-radius: 20px; font-size: 12px; color: var(--text-main); border-color: rgba(255,255,255,0.1); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im54-1 { display: flex; flex-direction: column; gap: 20px; }
  .im54-2 { font-size: 80px; opacity: 0.1; position: absolute; right: 20px; }
  .im54-3 { text-align: center; z-index: 1; }
  .im54-4 { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; }
</style>


<div class="container dz54-1">

  <!-- Header -->
  <div class="dz54-2">
    <h1 class="dz54-3"><%= t.promotions_title %></h1>
  </div>

  <div class="dz54-4">
    <!-- Promotions Grid -->
    <div class="im54-1">

      <!-- Promo 1 -->
      <div class="card dz54-5">
        <div class="dz54-6">
          <div class="im54-2">🧧</div>
          <div class="im54-3">
            <div class="dz54-7"><%= t.promo_1_title %></div>
            <div class="dz54-8"><%= t.promo_1_desc_short %></div>
          </div>
        </div>
        <div class="dz54-9">
          <div class="dz54-10"><%= t.promo_1_desc_long %></div>
          <div class="im54-4">
            <div class="dz54-11"><i class="fas fa-clock"></i> <%= t.valid_until %>: 31 Dec 2024</div>
            <button class="dz54-12" data-href="/payment/deposit"><%= t.deposit_now %></button>
          </div>
        </div>
      </div>

      <!-- Promo 2 -->
      <div class="card dz54-13">
        <div class="dz54-14">
          <div class="im54-2">💎</div>
          <div class="im54-3">
            <div class="dz54-15"><%= t.promo_2_title %></div>
            <div class="dz54-16"><%= t.promo_2_desc_short %></div>
          </div>
        </div>
        <div class="dz54-9">
          <div class="dz54-10"><%= t.promo_2_desc_long %></div>
          <div class="im54-4">
            <div class="dz54-17"><i class="fas fa-sync"></i> <%= t.once_daily %></div>
            <button class="dz54-18" data-href="/payment/deposit"><%= t.get_bonus %></button>
          </div>
        </div>
      </div>

      <!-- Promo 3 -->
      <div class="card dz54-13">
        <div class="dz54-19">
          <div class="im54-2">🎁</div>
          <div class="im54-3">
            <div class="dz54-20"><%= t.promo_3_title %></div>
            <div class="dz54-16"><%= t.promo_3_desc_short %></div>
          </div>
        </div>
        <div class="dz54-9">
          <div class="dz54-10"><%= t.promo_3_desc_long %></div>
          <div class="im54-4">
            <div class="dz54-21"><i class="fas fa-calendar-check"></i> <%= t.every_monday %></div>
            <button class="btn glass dz54-22"><%= t.details %></button>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

<%- include('partials/bottom-nav') %>

<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">KYC Requests</h1>
        <p class="text-gray-400 text-sm mt-1">Verify user identities</p>
      </div>
    </div>

    <!-- KYC Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">User</th>
            <th class="text-left px-4 py-4 font-normal">Submitted</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% requests.forEach(k => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4">
              <div class="font-semibold text-white"><%= k.username %></div>
              <div class="text-xs text-gray-500">ID: <%= k.user_id %></div>
            </td>
            <td class="px-4 py-4 text-xs text-gray-400">
              <%= new Date(k.created_at).toLocaleDateString() %>
            </td>
            <td class="px-4 py-4 text-center">
              <% if(k.status === 'pending') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/20 text-yellow-400">Pending</span>
              <% } else if(k.status === 'approved') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Approved</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">Rejected</span>
              <% } %>
            </td>
            <td class="px-6 py-4">
              <div class="flex justify-center gap-2">
                <% if(k.status === 'pending') { %>
                  <form action="/admin/kyc/<%= k.id %>/approve" method="POST">
                    <button type="submit" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 rounded-xl text-xs text-white">Approve</button>
                  </form>
                  <form action="/admin/kyc/<%= k.id %>/reject" method="POST">
                    <button type="submit" class="px-4 py-1.5 bg-red-600 hover:bg-red-700 rounded-xl text-xs text-white">Reject</button>
                  </form>
                <% } else { %>
                  <span class="text-gray-500 text-xs">Processed</span>
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (requests.length === 0) { %>
      <div class="text-center py-12 text-gray-500">
        No KYC requests found.
      </div>
    <% } %>

  </main>
</div>

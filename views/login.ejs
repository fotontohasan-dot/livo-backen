<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-dark);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card glass">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;">🔐 <%= t.login_title %></div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <form action="/login" method="POST">
          <div class="form-group">
            <label class="form-label"><%= t.email_or_phone %></label>
            <input type="text" name="identifier" class="form-input" placeholder="<%= t.email_or_phone %>" required>
          </div>
          <div class="form-group">
            <label class="form-label"><%= t.password %></label>
            <input type="password" name="password" class="form-input" placeholder="••••••••" required>
          </div>
          <p style="text-align:right;margin:-8px 0 12px;">
            <a href="/forgot-password" style="color:var(--text-muted);font-size:.82rem;text-decoration:none;">পাসওয়ার্ড ভুলে গেছেন?</a>
          </p>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;"><%= t.login %> 🚀</button>
        </form>
        <p style="text-align:center;margin-top:1rem;color:var(--text-muted);font-size:.9rem;">
          <%= t.no_account %> <a href="/register" style="color:var(--secondary)"><%= t.register_now %></a>
        </p>
      </div>
    </div>
    <p style="text-align:center;margin-top:2rem;">
      <a href="/" style="color:var(--text-muted);text-decoration:none;font-size:.85rem;"><%= t.back_to_home %></a>
    </p>
  </div>
</div>

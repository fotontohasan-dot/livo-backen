<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--darker);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;">🔐 User Login</div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <form action="/login" method="POST">
          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-input" placeholder="your@email.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-input" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Login Now 🚀</button>
        </form>
        <p style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.9rem;">
          Don't have an account? <a href="/register" style="color:var(--primary)">Register</a>
        </p>
      </div>
    </div>
    <p style="text-align:center;margin-top:2rem;">
      <a href="/" style="color:var(--muted);text-decoration:none;font-size:.85rem;">← Back to Home</a>
    </p>
  </div>
</div>
</body></html>

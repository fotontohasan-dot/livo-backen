<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--darker);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;">🏆 Login to LiveSport</div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" class="form-input" placeholder="your@email.com" id="email">
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" class="form-input" placeholder="••••••••" id="password">
        </div>
        <button onclick="submitLogin()" class="btn btn-primary" style="width:100%;justify-content:center;">Login</button>
        <p style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.9rem;">
          Don't have an account? <a href="/register" style="color:var(--primary)">Register</a>
        </p>
      </div>
    </div>
  </div>
</div>
<script>
function submitLogin() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = '/login';
  [['email','email'],['password','password']].forEach(([n,id]) => {
    const i = document.createElement('input');
    i.name = n; i.value = document.getElementById(id).value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
</script>
</body></html>

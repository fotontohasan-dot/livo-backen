<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Online Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f0b1f; color: white; }
        .header {
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { font-size: 26px; font-weight: bold; color: #ffd700; }

        .category { margin-top: 70px; padding: 15px; }
        h2 { 
            color: #ffd700; 
            margin-bottom: 12px; 
            font-size: 19px;
        }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 12px;
        }
        .game-card {
            background: #1a1433;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
        }
        .game-card img { 
            width: 100%; 
            height: 115px; 
            object-fit: cover; 
        }
        .game-name { 
            font-size: 13.5px; 
            padding: 10px 5px; 
            color: #ffccff; 
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">LIVO</div>
    </div>

    <div class="category">
        <h2>🎮 All Games</h2>
        <div class="game-grid" id="allGames"></div>
    </div>

    <div class="category">
        <h2>🎰 Slots</h2>
        <div class="game-grid" id="slots"></div>
    </div>

    <div class="category">
        <h2>🎥 Live Casino</h2>
        <div class="game-grid" id="liveCasino"></div>
    </div>

    <div class="category">
        <h2>🃏 Table Games</h2>
        <div class="game-grid" id="tableGames"></div>
    </div>

    <script>
        // গেম লিস্ট
        const gamesList = [
            "Teen Patti", "Super Ace", "Crash", "Aviator", "Andar Bahar", 
            "Dragon Tiger", "Roulette", "Blackjack", "Fortune Gems", 
            "Boxing King", "Lucky Spin", "Color Prediction", "Mines", 
            "Plinko", "Jackpot", "Golden Empire", "Sweet Bonanza"
        ];

        function loadGames() {
            const containers = {
                allGames: document.getElementById('allGames'),
                slots: document.getElementById('slots'),
                liveCasino: document.getElementById('liveCasino'),
                tableGames: document.getElementById('tableGames')
            };

            Object.keys(containers).forEach(key => {
                const container = containers[key];
                gamesList.forEach(name => {
                    const card = document.createElement('div');
                    card.className = 'game-card';
                    card.innerHTML = `
                        <img src="https://picsum.photos/id/${Math.floor(Math.random()*100) + 10}/300/180" alt="${name}">
                        <div class="game-name">${name}</div>
                    `;
                    container.appendChild(card);
                });
            });
        }

        // পেজ লোড হওয়ার সাথে সাথে গেম লোড করবে
        window.onload = loadGames;
    </script>

</body>
</html>

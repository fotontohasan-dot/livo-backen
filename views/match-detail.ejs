<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz83-1 { padding-top: 14px; padding-bottom: 90px; }
  .dz83-2 { padding: 16px; margin: 20px 0; }
  .dz83-3 { color: var(--text-accent); }
  .dz83-4 { padding: 50px 20px; }
  .dz83-5 { font-size: 40px; margin-bottom: 12px; }
  .dz83-6 { font-size: 16px; font-weight: 600; }
  .dz83-7 { color: var(--text-muted); }
  .dz83-8 { margin-top: 20px; padding-top: 16px; border-top: 1px dashed #334155; }
  .dz83-9 { border-radius: 8px; padding: 10px 20px; }
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  /* ===== Match detail: theme-independent colours (বাংলাদেশ গ্রিন থিমে কালো লেখা মিশে যেত) ===== */
  .md-back {
    display: inline-flex; align-items: center; gap: 6px;
    color: #fff !important; text-decoration: none; font-weight: 600; font-size: 14px;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);
    padding: 8px 14px; border-radius: 999px; margin-bottom: 12px;
  }
  .md-back:active { background: rgba(255,255,255,.26); }

  .md-score {
    background: linear-gradient(160deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid #334155; border-radius: 16px; overflow: hidden;
    margin-bottom: 16px; color: #f8fafc;
  }
  .md-score-top {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 10px 16px; background: rgba(0,0,0,.28);
    font-size: 12px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: #cbd5e1;
  }
  .md-league { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .md-badge { flex-shrink: 0; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
  .md-badge-live { background: #dc2626; color: #fff; }
  .md-badge-up { background: #334155; color: #e2e8f0; }
  .md-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #fff; margin-right: 5px; }
  .md-teams { padding: 6px 16px 12px; }
  .md-team-row {
    display: flex; align-items: center; gap: 12px; padding: 12px 0;
    border-bottom: 1px solid rgba(148,163,184,.18);
  }
  .md-team-row:last-child { border-bottom: 0; }
  .md-shirt {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 15px; color: #fff;
  }
  .md-shirt-a { background: #2563eb; }
  .md-shirt-b { background: #ea580c; }
  .md-team-name { flex: 1; font-size: 17px; font-weight: 700; color: #f8fafc; min-width: 0; }
  .md-team-score { font-size: 20px; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; }
  .md-overs { padding: 0 16px 14px; font-size: 13px; color: #94a3b8; }
  .md-status { padding: 0 16px 14px; font-size: 13px; font-weight: 600; color: #fbbf24; }

  .market-box {
    background: #1f2937; border-radius: 14px; margin-bottom: 14px;
    overflow: hidden; border: 1px solid #334155;
  }
  .market-header {
    padding: 13px 16px; background: #111827; font-weight: 800; font-size: 15px;
    color: #fbbf24; display: flex; align-items: center; gap: 8px;
  }
  .market-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-top: 1px solid #334155; background: #1f2937;
  }
  .market-team { flex: 1; font-size: 16px; font-weight: 700; color: #f8fafc; min-width: 0; }
  .odds {
    padding: 12px 16px; border-radius: 10px; font-weight: 800; font-size: 17px;
    min-width: 88px; text-align: center; cursor: pointer; user-select: none;
    transition: transform .08s ease, filter .15s ease;
  }
  .odds:active { transform: scale(.95); }
  .back { background: #22c55e; color: #06240f; }
  .back:hover { filter: brightness(1.08); }
  .lay { background: #ef4444; color: #fff; }

  .md-empty { background: #1f2937; border: 1px solid #334155; border-radius: 14px; color: #f8fafc; }
  .md-empty .dz83-7 { color: #94a3b8; }

  /* ===== ট্যাব ===== */
  .md-tabs {
    display: flex; gap: 6px; overflow-x: auto; padding: 4px 2px 10px; margin-bottom: 4px;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .md-tabs::-webkit-scrollbar { display: none; }
  .md-tab {
    flex-shrink: 0; border: 1px solid rgba(255,255,255,.25); background: rgba(0,0,0,.25);
    color: #fff; font-weight: 700; font-size: 13px; padding: 8px 16px; border-radius: 999px; cursor: pointer;
  }
  .md-tab.active { background: #f59e0b; border-color: #f59e0b; color: #111; }

  /* ===== মার্কেট কার্ড: ভাঁজযোগ্য, রানার গ্রিড ===== */
  .market-box.hidden-by-tab { display: none; }
  .market-header { cursor: pointer; justify-content: space-between; user-select: none; }
  .market-header .mh-title { display: flex; align-items: center; gap: 8px; min-width: 0; line-height: 1.3; }
  .market-header .mh-toggle { flex-shrink: 0; font-size: 18px; color: #94a3b8; transition: transform .2s; }
  .market-box.collapsed .mh-toggle { transform: rotate(-90deg); }
  .market-box.collapsed .market-body { display: none; }
  .market-grid { display: grid; gap: 1px; background: #334155; }
  .market-grid.cols-2 { grid-template-columns: 1fr 1fr; }
  .market-grid.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
  .market-grid.cols-1 { grid-template-columns: 1fr; }
  .market-cell {
    background: #1f2937; color: #f8fafc; padding: 12px 10px; text-align: center; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0;
    transition: background .15s;
  }
  .market-cell:active { background: #273449; }
  .market-cell .mc-label { font-size: 13px; font-weight: 700; color: #e2e8f0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .market-cell .odds { min-width: 0; width: 100%; padding: 10px 0; font-size: 16px; }
  .market-cell.selected { background: #14532d; }
  .md-tab-empty { display: none; text-align: center; color: #fff; padding: 30px 10px; font-weight: 600; }

  /* ===== বেট স্লিপ (alert/prompt/confirm-এর বদলে) ===== */
  .bs-overlay {
    position: fixed; inset: 0; z-index: 10050; background: rgba(0,0,0,.6);
    display: none; align-items: flex-end; justify-content: center;
  }
  .bs-overlay.open { display: flex; }
  .bs-sheet {
    width: 100%; max-width: 480px; background: #111827; color: #f8fafc;
    border-radius: 20px 20px 0 0; border: 1px solid #334155; border-bottom: 0;
    padding: 18px 16px calc(18px + env(safe-area-inset-bottom, 0px));
    animation: bsUp .22s ease both;
  }
  @keyframes bsUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .bs-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .bs-title { font-size: 12px; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }
  .bs-market { font-size: 14px; color: #fbbf24; font-weight: 700; margin-top: 2px; }
  .bs-close { background: #334155; color: #fff; border: 0; width: 32px; height: 32px; border-radius: 50%; font-size: 18px; cursor: pointer; flex-shrink: 0; }
  .bs-pick { display: flex; align-items: center; justify-content: space-between; background: #1f2937; border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; }
  .bs-pick-name { font-weight: 800; font-size: 16px; }
  .bs-pick-odd { background: #22c55e; color: #06240f; font-weight: 800; padding: 6px 14px; border-radius: 8px; font-size: 16px; }
  .bs-label { font-size: 12px; color: #94a3b8; font-weight: 600; margin-bottom: 6px; display: block; }
  .bs-input {
    width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 12px;
    color: #fff; font-size: 20px; font-weight: 800; padding: 12px 14px; outline: none;
  }
  .bs-input:focus { border-color: #22c55e; }
  .bs-chips { display: flex; gap: 8px; margin: 10px 0 14px; flex-wrap: wrap; }
  .bs-chip { flex: 1; min-width: 56px; background: #1f2937; color: #e2e8f0; border: 1px solid #334155; border-radius: 10px; padding: 9px 0; font-weight: 700; cursor: pointer; }
  .bs-chip:active { background: #334155; }
  .bs-return { display: flex; justify-content: space-between; font-size: 14px; color: #cbd5e1; margin-bottom: 14px; }
  .bs-return b { color: #4ade80; font-size: 16px; }
  .bs-error { color: #fca5a5; font-size: 13px; font-weight: 600; min-height: 18px; margin-bottom: 8px; }
  .bs-actions { display: flex; gap: 10px; }
  .bs-btn { flex: 1; border: 0; border-radius: 12px; padding: 14px; font-weight: 800; font-size: 15px; cursor: pointer; }
  .bs-btn-cancel { background: #334155; color: #fff; }
  .bs-btn-place { background: #22c55e; color: #06240f; flex: 2; }
  .bs-btn:disabled { opacity: .55; cursor: not-allowed; }
  .bs-login { display: block; text-align: center; text-decoration: none; }

  /* ===== টোস্ট ===== */
  .md-toast {
    position: fixed; left: 50%; bottom: 100px; transform: translateX(-50%) translateY(20px);
    z-index: 10060; max-width: 90vw; padding: 12px 18px; border-radius: 12px; font-weight: 700; font-size: 14px;
    color: #fff; background: #111827; border: 1px solid #334155; box-shadow: 0 8px 24px rgba(0,0,0,.5);
    opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s;
  }
  .md-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .md-toast.ok { border-color: #22c55e; }
  .md-toast.err { border-color: #ef4444; }
</style>

<div class="container dz83-1">

  <%
    var teamA = match.teams ? match.teams[0] : t.team_a;
    var teamB = match.teams ? match.teams[1] : t.team_b;
    var isLive = /live|in.?play|running/i.test(String(match.status || ''));
  %>
  <a href="/matches" class="md-back">← <%= t.back_to_all_matches %></a>

  <!-- Match Header -->
  <div class="md-score">
    <div class="md-score-top">
      <span class="md-league"><%= match.league || match.sport || '' %></span>
      <% if (isLive) { %>
        <span class="md-badge md-badge-live" id="md-badge"><span class="md-dot pulse-live"></span>LIVE</span>
      <% } else { %>
        <span class="md-badge md-badge-up" id="md-badge"><%= match.status || t.upcoming_matches %></span>
      <% } %>
    </div>
    <div class="md-teams">
      <div class="md-team-row">
        <div class="md-shirt md-shirt-a"><%= String(teamA).charAt(0).toUpperCase() %></div>
        <div class="md-team-name"><%= teamA %></div>
        <div class="md-team-score" id="score-a"><%= match.score_a || '' %></div>
      </div>
      <div class="md-team-row">
        <div class="md-shirt md-shirt-b"><%= String(teamB).charAt(0).toUpperCase() %></div>
        <div class="md-team-name"><%= teamB %></div>
        <div class="md-team-score" id="score-b"><%= match.score_b || '' %></div>
      </div>
    </div>
    <div class="md-overs" id="md-overs"><%= match.overs || '' %></div>
    <% if (isLive && match.status) { %><div class="md-status"><%= match.status %></div><% } %>
  </div>

  <!-- Dynamic Markets -->
  <% if (marketView && marketView.markets.length > 0) { %>
    <div class="md-tabs" id="mdTabs">
      <% marketView.tabs.forEach(function(tab, i) { %>
        <button type="button" class="md-tab<%= i === 0 ? ' active' : '' %>" data-tab="<%= tab.id %>"><%= tab.label %></button>
      <% }) %>
    </div>

    <% marketView.markets.forEach(function(market) {
         var cols = market.runners.length >= 3 ? 3 : (market.runners.length === 2 ? 2 : 1);
         if (market.runners.length > 3) cols = 3;
    %>
      <div class="market-box" data-cat="<%= market.category %>" data-pop="<%= market.popular ? 1 : 0 %>">
        <div class="market-header" data-toggle>
          <span class="mh-title"><%= (market.type === 'bookmaker' || market.type === 'match_odds') ? '🏆' : '⚡' %> <%= market.name %></span>
          <span class="mh-toggle">▾</span>
        </div>
        <div class="market-body">
          <div class="market-grid cols-<%= cols %>">
            <% market.runners.forEach(function(r) { %>
              <div class="market-cell">
                <span class="mc-label"><%= r.label %></span>
                <div class="odds back"
                     data-market-id="<%= market.id %>"
                     data-market-name="<%= market.name %>"
                     data-runner="<%= r.key %>"
                     data-label="<%= r.label %>"
                     data-odd="<%= r.odd %>"><%= r.odd %></div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
    <div class="md-tab-empty" id="mdTabEmpty"><%= t.betting_options_soon %></div>
  <% } else { %>
    <div class="md-empty text-center dz83-4">
      <div class="dz83-5">⏳</div>
      <p class="dz83-6"><%= t.betting_options_soon %></p>
      <small class="dz83-7"><%= t.check_back_later_short %></small>

      <% if (locals.user && user.role === 'admin') { %>
        <div class="dz83-8">
          <a href="/admin/markets/<%= match.id %>" class="btn btn-primary dz83-9">
            <%= t.add_market_admin %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<!-- বেট স্লিপ -->
<div class="bs-overlay" id="bsOverlay" aria-hidden="true">
  <div class="bs-sheet" role="dialog" aria-modal="true" aria-labelledby="bsTitle">
    <div class="bs-head">
      <div>
        <div class="bs-title" id="bsTitle"><%= t.bet_slip_title %></div>
        <div class="bs-market" id="bsMarket"></div>
      </div>
      <button type="button" class="bs-close" id="bsClose" aria-label="Close">×</button>
    </div>
    <div class="bs-pick"><span class="bs-pick-name" id="bsPick"></span><span class="bs-pick-odd" id="bsOdd"></span></div>
    <label class="bs-label" for="bsStake"><%= t.bet_slip_stake %></label>
    <input type="number" inputmode="numeric" min="1" step="1" class="bs-input" id="bsStake" value="50">
    <div class="bs-chips" id="bsChips">
      <button type="button" class="bs-chip" data-add="50">+50</button>
      <button type="button" class="bs-chip" data-add="100">+100</button>
      <button type="button" class="bs-chip" data-add="500">+500</button>
      <button type="button" class="bs-chip" data-add="1000">+1000</button>
    </div>
    <div class="bs-return"><span><%= t.bet_slip_return %></span><b id="bsReturn">0</b></div>
    <div class="bs-error" id="bsError" role="alert"></div>
    <div class="bs-actions">
      <button type="button" class="bs-btn bs-btn-cancel" id="bsCancel"><%= t.bet_slip_cancel %></button>
      <% if (locals.user) { %>
        <button type="button" class="bs-btn bs-btn-place" id="bsPlace"><%= t.bet_slip_place %></button>
      <% } else { %>
        <a href="/login" class="bs-btn bs-btn-place bs-login"><%= t.login_to_bet %></a>
      <% } %>
    </div>
  </div>
</div>
<div class="md-toast" id="mdToast" role="status" aria-live="polite"></div>

<script type="application/json" id="match-detailConfig"><%- jsonScriptSafe({
  loggedIn: !!locals.user,
  matchId: match.id,
  loginToBet: t.login_to_bet,
  minBetMsg: t.min_bet_msg,
  betConfirmMsg: t.bet_confirm_msg,
  networkError: t.network_error,
  minBet: minBet,
  maxBet: maxBet,
  sessionExpired: t.bet_slip_session_expired
}) %></script>
<script src="/js/views/match-detail.js"></script>

<%- include('partials/bottom-nav') %>
</body>
</html>

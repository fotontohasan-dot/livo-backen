<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .market-box {
    background: #1f2937;
    border-radius: 12px;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid #334155;
  }
  .market-header {
    padding: 12px 16px;
    background: #111827;
    font-weight: 700;
    font-size: 15px;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .market-row {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    border-top: 1px solid #334155;
  }
  .market-team { flex: 1; font-size: 15px; font-weight: 600; }
  .odds {
    padding: 12px 16px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 16px;
    min-width: 85px;
    text-align: center;
    cursor: pointer;
  }
  .back { background: #22c55e; color: #000; }
  .lay { background: #ef4444; color: #fff; }
</style>

<div class="container" style="padding-top: 14px; padding-bottom: 90px;">

  <a href="/matches">← সব ম্যাচে ফিরে যান</a>

  <!-- Match Header -->
  <div class="card" style="padding:16px; margin:20px 0;">
    <h4><%= match.teams ? match.teams[0] + " vs " + match.teams[1] : match.title %></h4>
    <p style="color: var(--gold);"><%= match.status || 'Upcoming' %></p>
  </div>

  <!-- Dynamic Markets -->
  <% if (markets && markets.length > 0) { %>
    <% markets.forEach(market => { %>
      <div class="market-box">
        <div class="market-header">
          <%= market.type === 'bookmaker' ? '🏆' : '⚡' %> <%= market.name %>
        </div>

        <% if (market.type === 'bookmaker') { %>
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[0] : 'Team A' %></div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="0" 
                 data-odd="<%= market.odds && market.odds['0'] ? market.odds['0'] : 1.85 %>">
              <%= market.odds && market.odds['0'] ? market.odds['0'] : 1.85 %>
            </div>
          </div>
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[1] : 'Team B' %></div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="1" 
                 data-odd="<%= market.odds && market.odds['1'] ? market.odds['1'] : 2.10 %>">
              <%= market.odds && market.odds['1'] ? market.odds['1'] : 2.10 %>
            </div>
          </div>
        <% } else { %>
          <div class="market-row">
            <div class="market-team">Yes</div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="yes" 
                 data-odd="<%= market.odds && market.odds['yes'] ? market.odds['yes'] : 1.75 %>">
              Yes <%= market.odds && market.odds['yes'] ? market.odds['yes'] : 1.75 %>
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <div class="card text-center" style="padding:50px 20px;">
      <p>এই ম্যাচে এখনো কোনো মার্কেট খোলা হয়নি।</p>
      <small>অ্যাডমিন প্যানেল থেকে মার্কেট যোগ করুন</small>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.odds').forEach(btn => {
    btn.addEventListener('click', function() {
      if (!<%= locals.user ? 'true' : 'false' %>) {
        alert("বেটিং করতে লগইন করুন");
        return;
      }

      const oddText = this.textContent.trim();
      const stake = prompt("কত কয়েন বেট করবেন? (মিনিমাম ১০)", "50");
      const stakeAmount = parseInt(stake);

      if (!stakeAmount || stakeAmount < 10) {
        alert("মিনিমাম ১০ কয়েন বেট করতে হবে");
        return;
      }

      if (!confirm(`আপনি ${oddText} ওডসে ${stakeAmount} কয়েন বেট করবেন?`)) return;

      fetch(`/matches/<%= match.id %>/bet`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          market_id: this.dataset.marketId,
          runner: this.dataset.runner,
          odd: parseFloat(this.dataset.odd),
          stake: stakeAmount
        })
      })
      .then(r => r.json())
      .then(data => {
        alert(data.message || data.error);
        if (data.success) location.reload();
      })
      .catch(() => alert("নেটওয়ার্ক সমস্যা"));
    });
  });
</script>

<%- include('partials/bottom-nav') %>
</body>
</html>

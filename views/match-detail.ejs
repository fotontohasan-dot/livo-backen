<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .market-box {
    background: #1f2937;
    border-radius: 12px;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid #334155;
  }
  .market-header {
    padding: 12px 16px;
    background: #111827;
    font-weight: 700;
    font-size: 15px;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .market-row {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    border-top: 1px solid #334155;
  }
  .market-team { flex: 1; font-size: 15px; font-weight: 600; }
  .odds {
    padding: 12px 16px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 16px;
    min-width: 85px;
    text-align: center;
    cursor: pointer;
  }
  .back { background: #22c55e; color: #000; }
  .lay { background: #ef4444; color: #fff; }
</style>

<div class="container" style="padding-top: 14px; padding-bottom: 90px;">

  <a href="/matches"><%= t.back_to_all_matches %></a>

  <!-- Match Header -->
  <div class="card" style="padding:16px; margin:20px 0;">
    <h4><%= match.teams ? match.teams[0] + " " + t.vs + " " + match.teams[1] : match.title %></h4>
    <p style="color: var(--gold);"><%= match.status || t.upcoming_matches %></p>
  </div>

  <!-- Dynamic Markets -->
  <% if (markets && markets.length > 0) { %>
    <% markets.forEach(market => { %>
      <div class="market-box">
        <div class="market-header">
          <%= market.type === 'bookmaker' ? '🏆' : '⚡' %> <%= market.name %>
        </div>

        <% if (market.type === 'bookmaker') { %>
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[0] : t.team_a %></div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="0" 
                 data-odd="<%= market.odds && market.odds['0'] ? market.odds['0'] : 1.85 %>">
              <%= market.odds && market.odds['0'] ? market.odds['0'] : 1.85 %>
            </div>
          </div>
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[1] : t.team_b %></div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="1" 
                 data-odd="<%= market.odds && market.odds['1'] ? market.odds['1'] : 2.10 %>">
              <%= market.odds && market.odds['1'] ? market.odds['1'] : 2.10 %>
            </div>
          </div>
        <% } else { %>
          <div class="market-row">
            <div class="market-team"><%= t.yes %></div>
            <div class="odds back" 
                 data-market-id="<%= market.id %>" 
                 data-runner="yes" 
                 data-odd="<%= market.odds && market.odds['yes'] ? market.odds['yes'] : 1.75 %>">
              <%= t.yes %> <%= market.odds && market.odds['yes'] ? market.odds['yes'] : 1.75 %>
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <div class="card text-center" style="padding:50px 20px;">
      <div style="font-size:40px; margin-bottom:12px;">⏳</div>
      <p style="font-size:16px; font-weight:600;"><%= t.betting_options_soon %></p>
      <small style="color: var(--text-muted);"><%= t.check_back_later_short %></small>

      <% if (locals.user && user.role === 'admin') { %>
        <div style="margin-top:20px; padding-top:16px; border-top:1px dashed #334155;">
          <a href="/admin/markets/<%= match.id %>" class="btn btn-primary" style="border-radius:8px; padding:10px 20px;">
            <%= t.add_market_admin %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.odds').forEach(btn => {
    btn.addEventListener('click', function() {
      if (!<%= locals.user ? 'true' : 'false' %>) {
        alert("<%= t.login_to_bet %>");
        return;
      }

      const oddText = this.textContent.trim();
      const stake = prompt("<%= t.min_bet_msg %>", "50");
      const stakeAmount = parseInt(stake);

      if (!stakeAmount || stakeAmount < 10) {
        alert("<%= t.min_bet_msg %>");
        return;
      }

      const confirmMsg = "<%= t.bet_confirm_msg %>".replace('{odd}', oddText).replace('{stake}', stakeAmount);
      if (!confirm(confirmMsg)) return;

      fetch(`/matches/<%= match.id %>/bet`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          market_id: this.dataset.marketId,
          runner: this.dataset.runner,
          odd: parseFloat(this.dataset.odd),
          stake: stakeAmount
        })
      })
      .then(r => r.json())
      .then(data => {
        alert(data.message || data.error);
        if (data.success) location.reload();
      })
      .catch(() => alert("<%= t.network_error %>"));
    });
  });
</script>

<%- include('partials/bottom-nav') %>
</body>
</html>

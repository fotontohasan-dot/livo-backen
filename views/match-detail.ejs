<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }
  
  .market-section { margin-bottom: 20px; }
  .mkt {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .mkt-head {
    padding: 12px 16px;
    background: var(--grad-surface);
    border-bottom: 1px solid var(--border-glass);
    font-weight: 700; font-size: 14px; color: var(--text-main);
    display: flex; align-items: center; gap: 8px;
  }
  .mkt-row {
    display: flex; align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .mkt-name {
    flex: 1; padding: 14px 16px;
    font-size: 14.5px; font-weight: 600;
  }
  .odds-btn {
    min-width: 85px; padding: 12px 8px;
    text-align: center; border-left: 1px solid rgba(255,255,255,0.08);
    font-weight: 700; font-size: 15px; cursor: pointer;
    transition: 0.2s;
  }
  .odds-btn:hover { background: rgba(16,185,129,0.15); }
  .odds-btn.suspended { opacity: 0.5; cursor: not-allowed; background: #1f2937; }
  
  .fancy-row { display: flex; }
  .fancy-name { flex: 1; padding: 12px 16px; }
  .fancy-odds {
    display: flex; width: 180px;
  }
  .fancy-odds button {
    flex: 1; padding: 12px 4px; font-size: 15px; font-weight: 700;
  }
  .back { background: #10b981; color: white; }
  .lay { background: #ef4444; color: white; }
</style>

<div class="container" style="padding-top: 14px;">

  <a href="/matches" style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;margin-bottom:12px;">
    ← সব ম্যাচে ফিরে যান
  </a>

  <!-- Match Header -->
  <div class="card" style="padding:16px;margin-bottom:16px;">
    <!-- তোমার আগের ম্যাচ হেডার কোড এখানে রাখো (teams + score) -->
    <%- include('partials/match-header', {match: match}) %>   <!-- যদি আলাদা partial না থাকে তাহলে আগের কোডটা রেখে দাও -->
  </div>

  <!-- Bookmaker Section -->
  <div class="market-section">
    <h5 style="margin: 0 0 12px 4px; color: var(--gold); font-weight: 700;">📌 বুকমেকার মার্কেট</h5>
    
    <div class="mkt">
      <div class="mkt-head"><span>🏆</span> ম্যাচ উইনার</div>
      <div class="mkt-row">
        <div class="mkt-name"><%= match?.teams?.[0] || 'Team A' %></div>
        <div class="odds-btn back" data-market="bookmaker" data-runner="0" data-odd="1.85">1.85</div>
      </div>
      <div class="mkt-row">
        <div class="mkt-name"><%= match?.teams?.[1] || 'Team B' %></div>
        <div class="odds-btn back" data-market="bookmaker" data-runner="1" data-odd="2.10">2.10</div>
      </div>
    </div>
  </div>

  <!-- Fancy Market Section -->
  <div class="market-section">
    <h5 style="margin: 0 0 12px 4px; color: var(--gold); font-weight: 700;">⚡ ফ্যান্সি মার্কেট (লাইভ)</h5>
    
    <div id="fancyMarkets">
      <!-- JS দিয়ে ডাইনামিক লোড হবে -->
      <div class="mkt">
        <div class="mkt-head"><span>🏏</span> ব্যাটসম্যান রান</div>
        <!-- উদাহরণ -->
      </div>
    </div>
  </div>

  <% if (!locals.user) { %>
    <div class="card text-center" style="padding:30px;">
      <p>বেটিং করতে লগইন করুন</p>
      <a href="/login" class="btn btn-gold">লগইন করুন</a>
    </div>
  <% } %>

</div>

<script>
  // বেট প্লেসমেন্ট (পরে backend route তৈরি করব)
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('odds-btn')) {
      if (!<%= locals.user ? 'true' : 'false' %>) {
        alert("লগইন করুন");
        return;
      }
      const market = e.target.dataset.market;
      const runner = e.target.dataset.runner;
      const odd = parseFloat(e.target.dataset.odd);
      
      if (confirm(`এই ওডসে বেট করবেন? Odds: ${odd}`)) {
        // TODO: fetch('/api/bet/place', { ... })
        console.log("Bet placed:", {market, runner, odd});
      }
    }
  });

  // Socket for live fancy update
  var socket = io();
  socket.emit("joinMatch", "<%= match ? match.id : '' %>");
</script>

<%- include('partials/bottom-nav') %>
</body>
</html>

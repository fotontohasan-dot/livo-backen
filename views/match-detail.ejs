<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    .detail-card {
        background: var(--card);
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 20px;
        border: 1px solid var(--border);
    }
    .detail-header {
        background: var(--card2);
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
    }
    .detail-body { padding: 20px; text-align: center; }

    .prediction-box {
        background: var(--card2);
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }

    .team-select {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin: 20px 0;
    }

    .team-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-glass);
        padding: 15px 5px;
        border-radius: 10px;
        color: var(--text-main);
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }
    .team-btn.selected {
        border-color: var(--gold);
        background: rgba(245, 158, 11, 0.1);
        box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
    }
    .team-btn .odd {
        font-family: 'Teko', sans-serif;
        font-size: 20px;
        color: var(--gold);
    }
    .team-btn .label {
        font-size: 10px;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: bold;
    }
</style>

<div class="container page">
    <%- include('partials/flash') %>

    <div class="detail-card">
        <div class="detail-header">
            <span style="color: var(--muted);">⚽ <%= match.sport.toUpperCase() %></span>
            <span class="status-badge status-<%= match.status %>">
                <%= match.status === 'live' ? 'লাইভ' : match.status === 'upcoming' ? 'আসছে' : 'শেষ' %>
            </span>
        </div>
        <div class="detail-body">
            <div class="teams-container" style="margin: 30px 0;">
                <div class="team-box">
                    <div style="font-size: 40px;">🛡️</div>
                    <div style="font-size: 1.2rem; font-weight: 900;"><%= match.team_a %></div>
                </div>
                <div class="vs-box" style="font-size: 2rem;">
                    <% if(match.status === 'completed') { %>
                        <span style="color: var(--secondary);"><%= match.score_a %> - <%= match.score_b %></span>
                    <% } else { %>VS<% } %>
                </div>
                <div class="team-box">
                    <div style="font-size: 40px;">⚔️</div>
                    <div style="font-size: 1.2rem; font-weight: 900;"><%= match.team_b %></div>
                </div>
            </div>
            <div style="color: var(--muted); font-size: 14px;">
                📅 <%= new Date(match.match_date).toLocaleString('bn-BD') %>
            </div>
            <% if(match.result) { %>
                <div style="margin-top: 20px;">
                    <span style="background: var(--primary-gradient); padding: 8px 20px; border-radius: 20px; font-weight: bold;">
                        🏆 বিজয়ী: <%= match.result %>
                    </span>
                </div>
            <% } %>
        </div>
    </div>

    <% if(match.stream_url && match.status === 'live') { %>
        <div class="card" style="margin-bottom: 20px;">
            <div class="card-header">📺 লাইভ স্ট্রিম</div>
            <div class="card-body" style="padding: 0;">
                <iframe src="<%= match.stream_url %>" width="100%" height="250" frameborder="0" allowfullscreen></iframe>
            </div>
        </div>
    <% } %>

    <% if(match.status === 'upcoming' && locals.user) { %>
        <div class="prediction-box">
            <h3 style="text-align: center; color: var(--accent);">🎯 আপনার প্রেডিকশন দিন</h3>
            <% if(userPrediction) { %>
                <div class="alert alert-success" style="text-align: center; margin-top: 15px;">
                    ✅ আপনি প্রেডিক্ট করেছেন: <strong><%= userPrediction.predicted_winner %></strong> <br>
                    বেট করেছেন: <strong>🪙 <%= userPrediction.coins_bet %></strong>
                </div>
            <% } else { %>
                <div class="team-select">
                    <button onclick="selectTeam('<%= match.team_a %>', <%= match.odds_a %>)" id="btn-a" class="team-btn">
                        <span class="label">Home</span>
                        <span class="odd"><%= match.odds_a %></span>
                        <span style="font-size: 11px; font-weight: bold;"><%= match.team_a %></span>
                    </button>
                    <% if(match.sport === 'football') { %>
                    <button onclick="selectTeam('Draw', <%= match.odds_draw %>)" id="btn-draw" class="team-btn">
                        <span class="label">Draw</span>
                        <span class="odd"><%= match.odds_draw %></span>
                        <span style="font-size: 11px; font-weight: bold;">X</span>
                    </button>
                    <% } %>
                    <button onclick="selectTeam('<%= match.team_b %>', <%= match.odds_b %>)" id="btn-b" class="team-btn">
                        <span class="label">Away</span>
                        <span class="odd"><%= match.odds_b %></span>
                        <span style="font-size: 11px; font-weight: bold;"><%= match.team_b %></span>
                    </button>
                </div>

                <div class="glass" style="padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 13px;">
                        <span style="color: var(--text-muted);">বেট অ্যামাউন্ট (Coins)</span>
                        <span style="color: var(--gold); font-weight: bold;">ব্যালেন্স: <%= user.coins %> 🪙</span>
                    </div>
                    <input type="number" class="form-input" id="coins-input" min="10" max="<%= user.coins %>" value="100" oninput="updatePotential()">

                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px dashed var(--border-glass); display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 14px; color: var(--text-muted);">সম্ভাব্য জয় (Potential Win)</span>
                        <span id="potential-win" style="font-family: 'Teko', sans-serif; font-size: 24px; color: #10b981;">0 🪙</span>
                    </div>
                </div>

                <button onclick="submitPrediction()" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 15px; border-radius: 12px; font-weight: 800;">প্লেস বেট (PLACE BET) 🚀</button>
            <% } %>
        </div>
    <% } %>

    <div class="card" style="margin-top: 20px;">
        <div class="card-header">📊 সাম্প্রতিক প্রেডিকশন</div>
        <div class="card-body" style="padding: 0;">
            <% if(predictions.length === 0) { %>
                <p style="padding: 20px; text-align: center; color: var(--muted);">এখনো কোনো প্রেডিকশন নেই</p>
            <% } else { %>
                <% predictions.forEach(p => { %>
                    <div style="display: flex; justify-content: space-between; padding: 12px 15px; border-bottom: 1px solid var(--border);">
                        <div>
                            <div style="font-weight: bold; font-size: 14px;"><%= p.username %></div>
                            <div style="font-size: 12px; color: var(--muted);">→ <%= p.predicted_winner %></div>
                        </div>
                        <div style="color: var(--gold); font-weight: bold;">🪙 <%= p.coins_bet %></div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<script>
let selectedTeam = '';
let selectedOdd = 0;

function selectTeam(team, odd) {
    selectedTeam = team;
    selectedOdd = odd;

    document.querySelectorAll('.team-btn').forEach(btn => btn.classList.remove('selected'));

    if(team === '<%= match.team_a %>') {
        document.getElementById('btn-a').classList.add('selected');
    } else if(team === 'Draw') {
        document.getElementById('btn-draw').classList.add('selected');
    } else {
        document.getElementById('btn-b').classList.add('selected');
    }
    updatePotential();
}

function updatePotential() {
    const coins = document.getElementById('coins-input').value;
    const potential = document.getElementById('potential-win');
    if(selectedOdd > 0 && coins > 0) {
        potential.textContent = Math.floor(coins * selectedOdd) + ' 🪙';
    } else {
        potential.textContent = '0 🪙';
    }
}

function submitPrediction() {
    if(!selectedTeam) { alert('অনুগ্রহ করে একটি দল নির্বাচন করুন!'); return; }
    const coins = document.getElementById('coins-input').value;
    if(!coins || coins < 10) { alert('নূন্যতম ১০ কয়েন!'); return; }
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/matches/<%= match.id %>/predict';
    [['predicted_winner', selectedTeam], ['coins_bet', coins], ['odds_at_bet', selectedOdd]].forEach(([n,v]) => {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = n; i.value = v; form.appendChild(i);
    });
    document.body.appendChild(form); form.submit();
}
</script>
<%- include('partials/bottom-nav', { activePage: 'matches' }) %>
</body></html>

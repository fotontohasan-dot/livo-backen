<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .market-box {
    background: #1f2937;
    border-radius: 12px;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid #334155;
  }
  .market-header {
    padding: 12px 16px;
    background: #111827;
    font-weight: 700;
    font-size: 15px;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .market-row {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    border-top: 1px solid #334155;
  }
  .market-team {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
  }
  .odds {
    padding: 11px 16px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 16px;
    min-width: 82px;
    text-align: center;
    cursor: pointer;
  }
  .back { background: #22c55e; color: #000; }
  .lay { background: #ef4444; color: #fff; }

  .fancy-row {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    border-top: 1px solid #334155;
  }
  .fancy-name {
    flex: 1;
    font-size: 14.5px;
  }
</style>

<div class="container" style="padding-top: 14px; padding-bottom: 90px;">

  <a href="/matches" style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;margin-bottom:12px;">
    ← সব ম্যাচে ফিরে যান
  </a>

  <!-- Match Header -->
  <div class="card" style="padding:16px;margin-bottom:20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
      <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;">
        CRICKET
      </div>
      <% var isLive = match && (match.status || '').toLowerCase().includes('live'); %>
      <% if (isLive) { %>
        <span style="background:rgba(16,185,129,0.2);color:#22c55e;padding:4px 12px;border-radius:9999px;font-size:12px;font-weight:700;">
          <span class="pulse-live" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;margin-right:6px;"></span>
          LIVE
        </span>
      <% } else { %>
        <span style="background:rgba(245,158,11,0.2);color:#fbbf24;padding:4px 12px;border-radius:9999px;font-size:12px;font-weight:700;">UPCOMING</span>
      <% } %>
    </div>

    <% if (match && match.teams) { %>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:12px;">
        <div style="width:52px;height:52px;border-radius:50%;background:#3b82f6;display:flex;align-items:center;justify-content:center;font-size:26px;">🏏</div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:16.5px;"><%= match.teams[0] %></div>
          <% if (match.score && match.score[0]) { %>
            <div style="font-size:1.6rem;font-weight:700;color:#22c55e;"><%= match.score[0].r %>/<%= match.score[0].w %></div>
          <% } %>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:14px;">
        <div style="width:52px;height:52px;border-radius:50%;background:#f97316;display:flex;align-items:center;justify-content:center;font-size:26px;">🏏</div>
        <div style="flex:1;">
          <div style="font-weight:700;font-size:16.5px;"><%= match.teams[1] %></div>
        </div>
      </div>
    <% } %>

    <% if (match && match.status) { %>
      <div style="margin-top:16px;padding:10px;background:rgba(234,179,8,0.1);border-radius:8px;text-align:center;color:#fbbf24;font-weight:600;">
        <%= match.status %>
      </div>
    <% } %>
  </div>

  <!-- বুকমেকার মার্কেট -->
  <div class="market-box">
    <div class="market-header">
      🏆 ম্যাচ উইনার
    </div>
    <div class="market-row">
      <div class="market-team"><%= match?.teams?.[0] || 'Team A' %></div>
      <div class="odds back" data-market="match-winner" data-runner="0" data-odd="1.85">1.85</div>
    </div>
    <div class="market-row">
      <div class="market-team"><%= match?.teams?.[1] || 'Team B' %></div>
      <div class="odds back" data-market="match-winner" data-runner="1" data-odd="2.10">2.10</div>
    </div>
  </div>

  <!-- ফ্যান্সি মার্কেট -->
  <div class="market-box">
    <div class="market-header">
      ⚡ ফ্যান্সি মার্কেট (লাইভ)
    </div>
    <div class="fancy-row">
      <div class="fancy-name">কোনো ব্যাটসম্যান ৫০+ রান করবে</div>
      <div style="display:flex;gap:6px;">
        <div class="odds back" data-market="fancy" data-type="yes" data-odd="1.75">Yes 1.75</div>
        <div class="odds lay" data-market="fancy" data-type="no" data-odd="2.05">No 2.05</div>
      </div>
    </div>
  </div>

  <% if (!locals.user) { %>
    <div class="card text-center" style="padding:40px 20px;margin-top:20px;">
      <p style="margin-bottom:20px;">বেটিং করতে লগইন করুন</p>
      <a href="/login" class="btn btn-gold">লগইন করুন</a>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.odds').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (!<%= locals.user ? 'true' : 'false' %>) {
        alert("বেটিং করতে লগইন করুন");
        return;
      }
      const odd = this.textContent.trim();
      if (confirm(`আপনি ${odd} ওডসে বেট করতে চান?`)) {
        console.log("Bet request:", this.dataset);
        // পরে backend এ fetch করব
      }
    });
  });

  const socket = io();
  socket.emit("joinMatch", "<%= match ? match.id : '' %>");
</script>

<%- include('partials/bottom-nav') %>
</body>
</html>

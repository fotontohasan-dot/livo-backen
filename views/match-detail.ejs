<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('../partials/head') %>
  <title><%= match.team_a %> vs <%= match.team_b %> | Live</title>
</head>
<body class="bg-zinc-950 text-white pb-20">

  <%- include('../partials/header') %>

  <!-- Score Header -->
  <div class="bg-zinc-900 p-4">
    <div class="flex justify-between items-center">
      <div>
        <div class="flex items-center gap-3">
          <div class="bg-teal-600 w-10 h-10 rounded flex items-center justify-center text-xl">SL</div>
          <div>
            <div class="font-bold"><%= match.team_a %></div>
            <div class="text-3xl font-bold text-yellow-400"><%= match.score_a || '360/10' %></div>
            <div class="text-sm text-gray-400">50.0 / 50 Ovs</div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <div class="text-green-500 font-bold">LIVE</div>
        <div class="text-4xl font-black text-yellow-400">VS</div>
      </div>

      <div class="text-right">
        <div class="flex items-center gap-3 justify-end">
          <div>
            <div class="font-bold"><%= match.team_b %></div>
            <div class="text-3xl font-bold text-yellow-400"><%= match.score_b || '122/4' %></div>
            <div class="text-sm text-gray-400">24.3 / 50 Ovs</div>
          </div>
          <div class="bg-orange-600 w-10 h-10 rounded flex items-center justify-center text-xl">WI</div>
        </div>
      </div>
    </div>

    <!-- Win Probability -->
    <div class="mt-6 bg-emerald-950 p-4 rounded-xl">
      <div class="flex justify-between text-sm mb-2">
        <div><%= match.team_a %> <span class="text-emerald-400 font-bold">99%</span></div>
        <div><%= match.team_b %> <span class="text-red-400 font-bold">2%</span></div>
      </div>
      <div class="h-3 bg-gray-700 rounded-full overflow-hidden">
        <div class="h-3 bg-emerald-500 rounded-full" style="width: 99%"></div>
      </div>
    </div>
  </div>

  <!-- Betting Markets -->
  <div class="p-4 space-y-6">
    <div class="bg-zinc-900 rounded-xl overflow-hidden">
      <div class="bg-orange-600 px-5 py-3 font-bold">Match Winner</div>
      <div class="p-5 grid grid-cols-2 gap-4">
        <div class="bg-zinc-800 p-4 rounded-xl text-center font-semibold"><%= match.team_b %></div>
        <div class="border-2 border-red-500 text-red-500 font-bold text-center py-4 rounded-xl">Suspend</div>
      </div>
    </div>

    <!-- Over/Under -->
    <div class="bg-zinc-900 rounded-xl p-5">
      <h3 class="font-bold mb-4">1st Innings <%= match.team_b %> 30 Overs Total Runs</h3>
      <div class="grid grid-cols-2 gap-4">
        <div class="text-center bg-emerald-900/30 p-4 rounded-xl">
          <div class="text-emerald-400 text-sm">Over</div>
          <div class="text-3xl font-bold text-emerald-400">1.84</div>
        </div>
        <div class="text-center bg-emerald-900/30 p-4 rounded-xl">
          <div class="text-emerald-400 text-sm">Under</div>
          <div class="text-3xl font-bold text-emerald-400">1.80</div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>

<%- include('partials/head') %>

<%- include('partials/navbar') %>

<div class="container" style="padding-top: 16px;">

  <!-- Back button -->
  <a href="/matches" style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;margin-bottom:14px;">
    ← সব ম্যাচে ফিরে যান
  </a>

  <!-- Main Match Card -->
  <div class="card" style="padding: 18px; margin-bottom: 14px; border:1px solid var(--border-glass);">

    <!-- Tournament name -->
    <% if (match && match.name) { %>
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:12px;text-align:center;">
        <%= match.name %>
      </div>
    <% } %>

    <!-- Status indicator -->
    <% if (match && (match.status || '').toLowerCase().includes('live')) { %>
      <div style="text-align:center;margin-bottom:14px;">
        <span style="display:inline-flex;align-items:center;gap:6px;background:#ef4444;color:#fff;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;">
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#fff;animation:livepulse 1.5s infinite;"></span>
          LIVE
        </span>
      </div>
    <% } %>

    <!-- Teams + Scores -->
    <% if (match && match.teams && match.teams.length >= 2) { %>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;">
        <div style="flex:1;text-align:center;">
          <div style="font-size:30px;margin-bottom:6px;">🏏</div>
          <div style="font-weight:700;font-size:15px;color:var(--text-main);"><%= match.teams[0] %></div>
        </div>
        <div style="font-family:'Teko',sans-serif;font-size:1.4rem;color:var(--text-muted);">vs</div>
        <div style="flex:1;text-align:center;">
          <div style="font-size:30px;margin-bottom:6px;">🏏</div>
          <div style="font-weight:700;font-size:15px;color:var(--text-main);"><%= match.teams[1] %></div>
        </div>
      </div>
    <% } %>

    <!-- Cricket Score breakdown -->
    <% if (match && match.score && match.score.length > 0) { %>
      <div style="border-top:1px solid var(--border-glass);padding-top:14px;margin-top:14px;">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px;text-transform:uppercase;">স্কোর</div>
        <% match.score.forEach(function(s) { %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
            <div style="font-weight:600;font-size:14px;color:var(--text-main);"><%= s.inning %></div>
            <div style="font-family:'Teko',sans-serif;font-size:1.3rem;color:var(--gold);">
              <%= s.r %>/<%= s.w %> <span style="font-size:0.9rem;color:var(--text-muted);">(<%= s.o %> ov)</span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- Status text -->
    <% if (match && match.status) { %>
      <div style="margin-top:14px;padding:10px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:10px;text-align:center;font-size:13px;color:var(--gold);font-weight:600;">
        <%= match.status %>
      </div>
    <% } %>

    <!-- Venue -->
    <% if (match && match.venue) { %>
      <div style="margin-top:10px;text-align:center;font-size:12px;color:var(--text-muted);">
        📍 <%= match.venue %>
      </div>
    <% } %>

    <!-- Date -->
    <% if (match && match.date) { %>
      <div style="text-align:center;font-size:12px;color:var(--text-muted);margin-top:4px;">
        🕒 <%= match.date %>
      </div>
    <% } %>
  </div>

  <!-- Toss info -->
  <% if (match && match.tossWinner) { %>
    <div class="card" style="padding:14px;margin-bottom:12px;">
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;margin-bottom:6px;">টস</div>
      <div style="font-size:14px;color:var(--text-main);">
        <strong style="color:var(--gold);"><%= match.tossWinner %></strong> টস জিতে <%= match.tossChoice || '' %> নিয়েছে
      </div>
    </div>
  <% } %>

  <!-- Prediction Section -->
  <% if (locals.user) { %>
    <div class="card" style="padding:16px;margin-bottom:12px;background:linear-gradient(135deg, rgba(0,150,37,0.1), rgba(245,158,11,0.1));border:1px solid var(--gold);">
      <div style="text-align:center;margin-bottom:14px;">
        <div style="font-size:30px;margin-bottom:6px;">🎯</div>
        <div style="font-weight:700;font-size:16px;color:var(--text-main);">কে জিতবে বলুন?</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">সঠিক প্রেডিকশনে পয়েন্ট জিতুন</div>
      </div>

      <% if (match && match.teams && match.teams.length >= 2) { %>
        <div style="display:flex;gap:10px;margin-bottom:10px;">
          <button class="btn btn-primary" style="flex:1;padding:12px 8px;font-size:13px;" onclick="alert('শীঘ্রই আসছে!')">
            <%= match.teams[0] %>
          </button>
          <button class="btn btn-primary" style="flex:1;padding:12px 8px;font-size:13px;" onclick="alert('শীঘ্রই আসছে!')">
            <%= match.teams[1] %>
          </button>
        </div>
        <button class="btn btn-secondary" style="width:100%;padding:10px;font-size:12px;" onclick="alert('শীঘ্রই আসছে!')">
          ড্র / টাই
        </button>
      <% } %>
    </div>
  <% } else { %>
    <div class="card" style="padding:18px;margin-bottom:12px;text-align:center;">
      <div style="font-size:14px;color:var(--text-main);margin-bottom:10px;">প্রেডিকশন করতে লগইন করুন</div>
      <a href="/login" class="btn btn-gold" style="padding:10px 24px;text-decoration:none;">লগইন</a>
    </div>
  <% } %>

  <!-- Match Winner (if finished) -->
  <% if (match && match.matchWinner) { %>
    <div class="card" style="padding:14px;margin-bottom:12px;background:linear-gradient(135deg,#10b981,#059669);border:none;">
      <div style="text-align:center;color:#fff;">
        <div style="font-size:22px;margin-bottom:4px;">🏆</div>
        <div style="font-weight:700;font-size:14px;"><%= match.matchWinner %> জিতেছে!</div>
      </div>
    </div>
  <% } %>

</div>

<style>
@keyframes livepulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.3); }
}
</style>

<%- include('partials/bottom-nav') %>

</body>
</html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz83-1 { padding-top: 14px; padding-bottom: 90px; }
  .dz83-2 { padding: 16px; margin: 20px 0; }
  .dz83-3 { color: var(--text-accent); }
  .dz83-4 { padding: 50px 20px; }
  .dz83-5 { font-size: 40px; margin-bottom: 12px; }
  .dz83-6 { font-size: 16px; font-weight: 600; }
  .dz83-7 { color: var(--text-muted); }
  .dz83-8 { margin-top: 20px; padding-top: 16px; border-top: 1px dashed #334155; }
  .dz83-9 { border-radius: 8px; padding: 10px 20px; }
  .pulse-live { animation: pulselive 1.5s ease-in-out infinite; }
  @keyframes pulselive { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  /* ===== Match detail: theme-independent colours (বাংলাদেশ গ্রিন থিমে কালো লেখা মিশে যেত) ===== */
  .md-back {
    display: inline-flex; align-items: center; gap: 6px;
    color: #fff !important; text-decoration: none; font-weight: 600; font-size: 14px;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);
    padding: 8px 14px; border-radius: 999px; margin-bottom: 12px;
  }
  .md-back:active { background: rgba(255,255,255,.26); }

  .md-score {
    background: linear-gradient(160deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid #334155; border-radius: 16px; overflow: hidden;
    margin-bottom: 16px; color: #f8fafc;
  }
  .md-score-top {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 10px 16px; background: rgba(0,0,0,.28);
    font-size: 12px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: #cbd5e1;
  }
  .md-league { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .md-badge { flex-shrink: 0; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
  .md-badge-live { background: #dc2626; color: #fff; }
  .md-badge-up { background: #334155; color: #e2e8f0; }
  .md-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #fff; margin-right: 5px; }
  .md-teams { padding: 6px 16px 12px; }
  .md-team-row {
    display: flex; align-items: center; gap: 12px; padding: 12px 0;
    border-bottom: 1px solid rgba(148,163,184,.18);
  }
  .md-team-row:last-child { border-bottom: 0; }
  .md-shirt {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 15px; color: #fff;
  }
  .md-shirt-a { background: #2563eb; }
  .md-shirt-b { background: #ea580c; }
  .md-logo { object-fit: contain; background: #fff; border-radius: 50%; padding: 2px; }
  .md-team-name { flex: 1; font-size: 17px; font-weight: 700; color: #f8fafc; min-width: 0; }
  .md-team-score { font-size: 20px; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; }
  .md-overs { padding: 0 16px 14px; font-size: 13px; color: #94a3b8; }
  .md-status { padding: 0 16px 14px; font-size: 13px; font-weight: 600; color: #fbbf24; }

  .market-box {
    background: #1f2937; border-radius: 14px; margin-bottom: 14px;
    overflow: hidden; border: 1px solid #334155;
  }
  .market-header {
    padding: 13px 16px; background: #111827; font-weight: 800; font-size: 15px;
    color: #fbbf24; display: flex; align-items: center; gap: 8px;
  }
  .market-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-top: 1px solid #334155; background: #1f2937;
  }
  .market-team { flex: 1; font-size: 16px; font-weight: 700; color: #f8fafc; min-width: 0; }
  .odds {
    padding: 12px 16px; border-radius: 10px; font-weight: 800; font-size: 17px;
    min-width: 88px; text-align: center; cursor: pointer; user-select: none;
    transition: transform .08s ease, filter .15s ease;
  }
  .odds:active { transform: scale(.95); }
  /* Back = নীল, Lay = গোলাপী (এক্সচেঞ্জ সাইটের প্রচলিত রঙ) */
  .back { background: #72bbef; color: #0b2540; }
  .back:hover { filter: brightness(1.06); }
  .lay { background: #faa9ba; color: #4a0d1c; }
  .lay:hover { filter: brightness(1.06); }

  .md-empty { background: #1f2937; border: 1px solid #334155; border-radius: 14px; color: #f8fafc; }
  .md-empty .dz83-7 { color: #94a3b8; }

  /* ===== ট্যাব ===== */
  .md-tabs {
    display: flex; gap: 6px; overflow-x: auto; padding: 4px 2px 10px; margin-bottom: 4px;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .md-tabs::-webkit-scrollbar { display: none; }
  .md-tab {
    flex-shrink: 0; border: 1px solid rgba(255,255,255,.25); background: rgba(0,0,0,.25);
    color: #fff; font-weight: 700; font-size: 13px; padding: 8px 16px; border-radius: 999px; cursor: pointer;
  }
  .md-tab.active { background: #f59e0b; border-color: #f59e0b; color: #111; }

  /* ===== মার্কেট কার্ড: ভাঁজযোগ্য, রানার গ্রিড ===== */
  .market-box.hidden-by-tab { display: none; }
  .market-header { cursor: pointer; justify-content: space-between; user-select: none; }
  .market-header .mh-title { display: flex; align-items: center; gap: 8px; min-width: 0; line-height: 1.3; }
  .market-header .mh-toggle { flex-shrink: 0; font-size: 18px; color: #94a3b8; transition: transform .2s; }
  .market-box.collapsed .mh-toggle { transform: rotate(-90deg); }
  .market-box.collapsed .market-body { display: none; }
  .market-grid { display: grid; gap: 1px; background: #334155; }
  .market-grid.cols-2 { grid-template-columns: 1fr 1fr; }
  .market-grid.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
  .market-grid.cols-1 { grid-template-columns: 1fr; }
  .market-cell {
    background: #1f2937; color: #f8fafc; padding: 12px 10px; text-align: center; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0;
    transition: background .15s;
  }
  .market-cell:active { background: #273449; }
  .market-cell .mc-label { font-size: 13px; font-weight: 700; color: #e2e8f0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .market-cell .odds { min-width: 0; width: 100%; padding: 10px 0; font-size: 16px; }
  .market-cell.selected { background: #14532d; }
  /* Lay cell, odds flash, suspension */
  .market-cell .odds.lay { background: #f4a6b8; color: #111; margin-top: 4px; }
  .market-cell .odds { transition: background-color .35s ease, color .35s ease; }
  .odds.flash-up { background: #16a34a !important; color: #fff !important; }
  .odds.flash-down { background: #dc2626 !important; color: #fff !important; }
  .market-cell.runner-suspended, .market-box.market-suspended .market-cell, .odds.price-unavailable {
    opacity: .4; filter: grayscale(1); pointer-events: none; cursor: not-allowed;
  }
  .market-box.market-suspended .market-header::after { content: 'SUSPENDED'; font-size: 10px; font-weight: 800; color: #f87171; margin-left: 8px; }
  /* Suspension overlay: blurs the market body and blocks clicks while the market is suspended */
  .market-body { position: relative; }
  .susp-overlay { display: none; position: absolute; inset: 0; z-index: 5; align-items: center; justify-content: center;
    background: rgba(15,23,42,.55); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .susp-overlay span { color: #f87171; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .market-box.market-suspended .susp-overlay { display: flex; }
  /* On-screen numeric keypad */
  .bs-keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 8px 0; }
  .bs-key { border: 0; border-radius: 8px; padding: 12px 0; font-size: 18px; font-weight: 700; background: #1f2937; color: #fff; }
  .bs-key:active { background: #374151; }
  .bs-key-fn { background: #334155; }
  .bs-side-tag { font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 4px; margin-right: 6px; background: #1e3a5f; color: #fff; }
  /* My Bets rows */
  .mb-item { padding: 10px 14px; border-bottom: 1px solid #1f2937; font-size: 13px; }
  .mb-top { display: flex; gap: 8px; align-items: center; }
  .mb-match { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mb-side { font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; background: #1e3a5f; color: #fff; }
  .mb-side-lay { background: #9d174d; }
  .mb-status { font-size: 11px; font-weight: 700; }
  .mb-won .mb-status { color: #4ade80; } .mb-lost .mb-status { color: #f87171; } .mb-void .mb-status { color: #fbbf24; }
  .mb-sel { color: #94a3b8; margin: 4px 0; }
  .mb-figs { display: flex; gap: 14px; flex-wrap: wrap; } .mb-figs small { display: block; color: #94a3b8; font-size: 10px; }
  .mb-note { padding: 18px; text-align: center; color: #94a3b8; } .mb-err { color: #f87171; }
  .mb-more { display: block; margin: 10px auto; padding: 8px 18px; border: 0; border-radius: 16px; background: #1f2937; color: #fff; }
  .bs-return[hidden] { display: none; }
  /* SUSPEND overlay: blurred, unclickable */
  .market-cell { position: relative; }
  .market-cell.runner-suspended::after, .market-box.market-suspended .market-cell::after {
    content: 'SUSPEND'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(15,23,42,.55); backdrop-filter: blur(2px); color: #f87171; font-size: 11px; font-weight: 800; letter-spacing: 1px;
  }
  .vol { display: block; font-size: 10px; color: #94a3b8; min-height: 12px; line-height: 12px; }
  /* Live scoreboard */
  .lb { background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 12px; margin: 10px 0; color: #e5e7eb; }
  .lb:empty { display: none; }
  .lb-main { font-size: 22px; font-weight: 800; color: #fbbf24; }
  .lb-sub { font-size: 12px; color: #94a3b8; margin-left: 8px; font-weight: 600; }
  .lb table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 8px; }
  .lb th { color: #64748b; font-weight: 600; text-align: right; padding: 2px 4px; }
  .lb td { text-align: right; padding: 3px 4px; }
  .lb th:first-child, .lb td:first-child { text-align: left; }
  .lb .strike td:first-child::after { content: ' *'; color: #fbbf24; }
  .lb-balls { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; align-items: center; }
  .lb-ball { width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; background: #1f2937; color: #e5e7eb; }
  .lb-ball.b4 { background: #2563eb; color: #fff; } .lb-ball.b6 { background: #16a34a; color: #fff; } .lb-ball.bW { background: #dc2626; color: #fff; }
  .lb-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; background: #dc2626; color: #fff; font-size: 12px; font-weight: 800; }
  .lb-mom { height: 6px; background: #7c2d12; border-radius: 3px; margin-top: 10px; overflow: hidden; }
  .lb-mom > i { display: block; height: 100%; background: #0ea5e9; transition: width .6s ease; }
  /* Keypad */
  .bs-kp-toggle { background: none; border: 0; color: #93c5fd; font-size: 12px; font-weight: 700; margin: 0 0 8px; cursor: pointer; }
  .bs-keypad { display: none; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 12px; }
  .bs-keypad.open { display: grid; }
  .bs-key { padding: 12px 0; border-radius: 8px; border: 1px solid #334155; background: #1e293b; color: #f8fafc; font-size: 18px; font-weight: 700; cursor: pointer; }
  .bs-key:active { background: #334155; }
  /* My Bets drawer */
  .mb-fab { position: fixed; right: 12px; bottom: 84px; z-index: 900; padding: 10px 16px; border-radius: 999px; border: 0; background: #f59e0b; color: #111; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.4); }
  .mb-count { background: #111; color: #fbbf24; border-radius: 9px; padding: 0 6px; font-size: 11px; margin-left: 4px; }
  .mb-count:empty { display: none; }
  .mb-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 100%); z-index: 1100; background: #0f172a; color: #e5e7eb; transform: translateX(100%); transition: transform .25s ease; display: flex; flex-direction: column; box-shadow: -6px 0 20px rgba(0,0,0,.5); }
  .mb-drawer.open { transform: translateX(0); }
  .mb-head { display: flex; justify-content: space-between; align-items: center; padding: 14px; border-bottom: 1px solid #1f2937; font-size: 16px; }
  .mb-head button { background: none; border: 0; color: #e5e7eb; font-size: 24px; cursor: pointer; }
  .mb-list { overflow-y: auto; padding: 10px; flex: 1; }
  .mb-card { background: #1e293b; border-radius: 10px; padding: 10px; margin-bottom: 8px; border-left: 4px solid #64748b; font-size: 12px; }
  .mb-card.back { border-left-color: #3b82f6; } .mb-card.lay { border-left-color: #f4a6b8; }
  .mb-row { display: flex; justify-content: space-between; gap: 8px; margin-top: 3px; color: #94a3b8; }
  .mb-row b { color: #e5e7eb; }
  .mb-title { font-weight: 800; font-size: 13px; color: #f8fafc; }
  .mb-st { padding: 1px 8px; border-radius: 8px; font-weight: 800; font-size: 11px; }
  .mb-st.pending { background: #78350f; color: #fbbf24; } .mb-st.won { background: #14532d; color: #4ade80; } .mb-st.lost { background: #7f1d1d; color: #fca5a5; }
  .md-tab-empty { display: none; text-align: center; color: #fff; padding: 30px 10px; font-weight: 600; }

  /* ===== বেট স্লিপ (alert/prompt/confirm-এর বদলে) ===== */
  .bs-overlay {
    position: fixed; inset: 0; z-index: 10050; background: rgba(0,0,0,.6);
    display: none; align-items: flex-end; justify-content: center;
  }
  .bs-overlay.open { display: flex; }
  .bs-sheet {
    width: 100%; max-width: 480px; background: #111827; color: #f8fafc;
    border-radius: 20px 20px 0 0; border: 1px solid #334155; border-bottom: 0;
    padding: 18px 16px calc(18px + env(safe-area-inset-bottom, 0px));
    animation: bsUp .22s ease both;
  }
  @keyframes bsUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .bs-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .bs-title { font-size: 12px; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }
  .bs-market { font-size: 14px; color: #fbbf24; font-weight: 700; margin-top: 2px; }
  .bs-close { background: #334155; color: #fff; border: 0; width: 32px; height: 32px; border-radius: 50%; font-size: 18px; cursor: pointer; flex-shrink: 0; }
  .bs-pick { display: flex; align-items: center; justify-content: space-between; background: #1f2937; border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; }
  .bs-pick-name { font-weight: 800; font-size: 16px; }
  .bs-pick-odd { background: #72bbef; color: #0b2540; font-weight: 800; padding: 6px 14px; border-radius: 8px; font-size: 16px; }
  .bs-sheet.is-lay .bs-pick-odd { background: #faa9ba; color: #4a0d1c; }
  .bs-side-tag { font-size: 11px; font-weight: 900; letter-spacing: .6px; text-transform: uppercase; padding: 4px 8px; border-radius: 6px; background: #72bbef; color: #0b2540; margin-right: 8px; }
  .bs-sheet.is-lay .bs-side-tag { background: #faa9ba; color: #4a0d1c; }
  .bs-pick-name { flex: 1; min-width: 0; }
  .bs-liab { display: none; }
  .bs-sheet.is-lay .bs-liab { display: flex; }
  .bs-sheet.is-lay .bs-liab b { color: #fca5a5; }
  .bs-label { font-size: 12px; color: #94a3b8; font-weight: 600; margin-bottom: 6px; display: block; }
  .bs-input {
    width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 12px;
    color: #fff; font-size: 20px; font-weight: 800; padding: 12px 14px; outline: none;
  }
  .bs-input:focus { border-color: #22c55e; }
  .bs-chips { display: flex; gap: 8px; margin: 10px 0 14px; flex-wrap: wrap; }
  .bs-chip { flex: 1; min-width: 56px; background: #1f2937; color: #e2e8f0; border: 1px solid #334155; border-radius: 10px; padding: 9px 0; font-weight: 700; cursor: pointer; }
  .bs-chip:active { background: #334155; }
  .bs-return { display: flex; justify-content: space-between; font-size: 14px; color: #cbd5e1; margin-bottom: 14px; }
  .bs-return b { color: #4ade80; font-size: 16px; }
  .bs-error { color: #fca5a5; font-size: 13px; font-weight: 600; min-height: 18px; margin-bottom: 8px; }
  .bs-actions { display: flex; gap: 10px; }
  .bs-btn { flex: 1; border: 0; border-radius: 12px; padding: 14px; font-weight: 800; font-size: 15px; cursor: pointer; }
  .bs-btn-cancel { background: #334155; color: #fff; }
  .bs-btn-place { background: #22c55e; color: #06240f; flex: 2; }
  .bs-btn:disabled { opacity: .55; cursor: not-allowed; }
  .bs-login { display: block; text-align: center; text-decoration: none; }

  /* ===== টোস্ট ===== */
  .mb-fab { position: fixed; right: 14px; bottom: 80px; z-index: 40; border: 0; border-radius: 22px; padding: 10px 16px; background: #0f6cbd; color: #fff; font-weight: 700; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.3); }
  .mb-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; max-height: 75vh; overflow-y: auto; background: #111827; color: #e5e7eb; border-radius: 16px 16px 0 0; padding: 14px; transform: translateY(105%); transition: transform .25s; box-shadow: 0 -6px 24px rgba(0,0,0,.45); }
  .mb-panel.open { transform: translateY(0); }
  .mb-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; margin-bottom: 8px; }
  .mb-close { background: none; border: 0; color: #9ca3af; font-size: 22px; cursor: pointer; }
  .mb-item { border: 1px solid #263244; border-left: 4px solid #6b7280; border-radius: 10px; padding: 10px; margin-bottom: 8px; font-size: 14px; }
  .mb-item.won { border-left-color: #22c55e; } .mb-item.lost { border-left-color: #ef4444; } .mb-item.pending { border-left-color: #f59e0b; }
  .mb-row { display: flex; justify-content: space-between; gap: 8px; } .mb-mut { color: #9ca3af; font-size: 12px; }
  .mb-st { font-weight: 700; font-size: 12px; }
  .md-toast {
    position: fixed; left: 50%; bottom: 100px; transform: translateX(-50%) translateY(20px);
    z-index: 10060; max-width: 90vw; padding: 12px 18px; border-radius: 12px; font-weight: 700; font-size: 14px;
    color: #fff; background: #111827; border: 1px solid #334155; box-shadow: 0 8px 24px rgba(0,0,0,.5);
    opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s;
  }
  .md-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .md-toast.ok { border-color: #22c55e; }
  .md-toast.err { border-color: #ef4444; }
</style>

<div class="container dz83-1">

  <%
    var teamA = match.teams ? match.teams[0] : t.team_a;
    var teamB = match.teams ? match.teams[1] : t.team_b;
    var isLive = /live|in.?play|running/i.test(String(match.status || ''));
  %>
  <a href="/matches" class="md-back">← <%= t.back_to_all_matches %></a>

  <!-- Match Header -->
  <div class="md-score">
    <div class="md-score-top">
      <span class="md-league"><%= match.league || match.sport || '' %></span>
      <% if (isLive) { %>
        <span class="md-badge md-badge-live" id="md-badge"><span class="md-dot pulse-live"></span>LIVE</span>
      <% } else { %>
        <span class="md-badge md-badge-up" id="md-badge"><%= match.status || t.upcoming_matches %></span>
      <% } %>
    </div>
    <div class="md-teams">
      <div class="md-team-row">
        <% if (match.logo_a && /^\/images\/teams\/[a-f0-9]{32}\.(png|jpg|gif|webp)$/.test(match.logo_a)) { %><img class="md-shirt md-logo" src="<%= match.logo_a %>" alt="<%= teamA %>" width="36" height="36" loading="lazy"><% } else { %><div class="md-shirt md-shirt-a"><%= String(teamA).charAt(0).toUpperCase() %></div><% } %>
        <div class="md-team-name"><%= teamA %></div>
        <div class="md-team-score" id="score-a"><%= match.score_a || '' %></div>
      </div>
      <div class="md-team-row">
        <% if (match.logo_b && /^\/images\/teams\/[a-f0-9]{32}\.(png|jpg|gif|webp)$/.test(match.logo_b)) { %><img class="md-shirt md-logo" src="<%= match.logo_b %>" alt="<%= teamB %>" width="36" height="36" loading="lazy"><% } else { %><div class="md-shirt md-shirt-b"><%= String(teamB).charAt(0).toUpperCase() %></div><% } %>
        <div class="md-team-name"><%= teamB %></div>
        <div class="md-team-score" id="score-b"><%= match.score_b || '' %></div>
      </div>
    </div>
    <div class="md-overs" id="md-overs"><%= match.overs || '' %></div>
    <% if (isLive && match.status) { %><div class="md-status"><%= match.status %></div><% } %>
    <% if (typeof matchStale !== 'undefined' && matchStale) { %><div class="md-status md-stale" role="alert"><%= t.matches_stale_badge %></div><% } %>
  </div>

  <div class="lb" id="liveBoard"></div>

  <!-- Dynamic Markets -->
  <% if (marketView && (marketView.markets.length > 0 || marketView.tabs.length > 1)) { %>
    <div class="md-tabs" id="mdTabs">
      <% marketView.tabs.forEach(function(tab, i) { %>
        <button type="button" class="md-tab<%= i === 0 ? ' active' : '' %>" data-tab="<%= tab.id %>"><%= tab.label %></button>
      <% }) %>
    </div>

    <% var fmtVol = function (n) { if (n == null) return '–'; n = Number(n); return n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(Math.round(n)); }; %>
    <% marketView.markets.forEach(function(market) {
         var cols = market.runners.length >= 3 ? 3 : (market.runners.length === 2 ? 2 : 1);
         if (market.runners.length > 3) cols = 3;
    %>
      <div class="market-box<%= market.status === 'suspended' ? ' market-suspended' : '' %>" data-market-id="<%= market.id %>" data-cat="<%= market.category %>" data-pop="<%= market.popular ? 1 : 0 %>">
        <div class="market-header" data-toggle>
          <span class="mh-title"><%= (market.type === 'bookmaker' || market.type === 'match_odds') ? '🏆' : '⚡' %> <%= market.name %></span>
          <span class="mh-toggle">▾</span>
        </div>
        <div class="market-body">
          <div class="susp-overlay" aria-hidden="true"><span><%= t.market_suspended %></span></div>
          <div class="market-grid cols-<%= cols %>">
            <% market.runners.forEach(function(r) { %>
              <div class="market-cell<%= r.status === 'suspended' ? ' runner-suspended' : '' %>" data-runner="<%= r.key %>">
                <span class="mc-label"><%= r.label %></span>
                <div class="odds back"
                     data-bet-type="back"
                     data-market-id="<%= market.id %>"
                     data-market-name="<%= market.name %>"
                     data-runner="<%= r.key %>"
                     data-label="<%= r.label %>"
                     data-odd="<%= r.odd %>"<%- (r.status === 'suspended' || market.status === 'suspended') ? ' aria-disabled="true"' : '' %>><%= r.odd %></div>
                <small class="vol" data-vol="back"><%= fmtVol(r.backSize) %></small>
                <% if (r.lay) { %>
                <div class="odds lay"
                     data-bet-type="lay"
                     data-market-id="<%= market.id %>"
                     data-market-name="<%= market.name %>"
                     data-runner="<%= r.key %>"
                     data-label="<%= r.label %>"
                     data-odd="<%= r.lay %>"<%- (r.status === 'suspended' || market.status === 'suspended') ? ' aria-disabled="true"' : '' %>><%= r.lay %></div>
                <small class="vol" data-vol="lay"><%= fmtVol(r.laySize) %></small>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
    <div class="md-tab-empty" id="mdTabEmpty"><%= t.waiting_live_feed || 'Waiting for live feed…' %></div>
  <% } else { %>
    <div class="md-empty text-center dz83-4">
      <div class="dz83-5">⏳</div>
      <p class="dz83-6"><%= t.betting_options_soon %></p>
      <small class="dz83-7"><%= t.check_back_later_short %></small>

      <% if (locals.user && user.role === 'admin') { %>
        <div class="dz83-8">
          <a href="/admin/markets/<%= match.id %>" class="btn btn-primary dz83-9">
            <%= t.add_market_admin %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<!-- বেট স্লিপ -->
<div class="bs-overlay" id="bsOverlay" aria-hidden="true">
  <div class="bs-sheet" role="dialog" aria-modal="true" aria-labelledby="bsTitle">
    <div class="bs-head">
      <div>
        <div class="bs-title" id="bsTitle"><%= t.bet_slip_title %></div>
        <div class="bs-market" id="bsMarket"></div>
      </div>
      <button type="button" class="bs-close" id="bsClose" aria-label="Close">×</button>
    </div>
    <div class="bs-pick"><span class="bs-side-tag" id="bsSideTag"></span><span class="bs-pick-name" id="bsPick"></span><span class="bs-pick-odd" id="bsOdd"></span></div>
    <label class="bs-label" for="bsStake"><%= t.bet_slip_stake %></label>
    <input type="number" inputmode="numeric" min="1" step="1" class="bs-input" id="bsStake" value="50">
    <div class="bs-chips" id="bsChips">
      <button type="button" class="bs-chip" data-add="50">+50</button>
      <button type="button" class="bs-chip" data-add="100">+100</button>
      <button type="button" class="bs-chip" data-add="500">+500</button>
      <button type="button" class="bs-chip" data-add="1000">+1000</button>
    </div>
    <button type="button" class="bs-kp-toggle" id="bsKpToggle">⌨ Keypad</button>
    <div class="bs-keypad" id="bsKeypad">
      <% ['1','2','3','4','5','6','7','8','9','C','0','⌫'].forEach(function (k) { %>
        <button type="button" class="bs-key" data-key="<%= k %>"><%= k %></button>
      <% }) %>
    </div>
    <div class="bs-return"><span id="bsReturnLabel"><%= t.bet_slip_return %></span><b id="bsReturn">0</b></div>
    <div class="bs-return" id="bsLiabRow" hidden><span id="bsLiabLabel">Liability</span><b id="bsLiab">0</b></div>
    <div class="bs-error" id="bsError" role="alert"></div>
    <div class="bs-actions">
      <button type="button" class="bs-btn bs-btn-cancel" id="bsCancel"><%= t.bet_slip_cancel %></button>
      <% if (locals.user) { %>
        <button type="button" class="bs-btn bs-btn-place" id="bsPlace"><%= t.bet_slip_place %></button>
      <% } else { %>
        <a href="/login" class="bs-btn bs-btn-place bs-login"><%= t.login_to_bet %></a>
      <% } %>
    </div>
  </div>
</div>
<% if (locals.user) { %>
<button type="button" class="mb-fab" id="mbOpen">My Bets <span class="mb-count" id="mbCount"></span></button>
<aside class="mb-drawer" id="mbDrawer" aria-hidden="true" aria-label="My Bets">
  <div class="mb-head"><b>My Bets</b><button type="button" id="mbClose" aria-label="Close">×</button></div>
  <div class="mb-list" id="mbList"></div>
</aside>
<% } %>
<div class="md-toast" id="mdToast" role="status" aria-live="polite"></div>
<% if (locals.user) { %>
<button type="button" class="mb-fab" id="mbOpen"><%= t.my_bets %></button>
<div class="mb-panel" id="mbPanel" aria-hidden="true">
  <div class="mb-head"><span><%= t.my_bets %></span><button type="button" class="mb-close" id="mbClose" aria-label="Close">×</button></div>
  <div id="mbList"></div>
</div>
<% } %>

<script type="application/json" id="match-detailConfig"><%- jsonScriptSafe({
  loggedIn: !!locals.user,
  matchId: match.id,
  loginToBet: t.login_to_bet,
  minBetMsg: t.min_bet_msg,
  betConfirmMsg: t.bet_confirm_msg,
  networkError: t.network_error,
  minBet: minBet,
  maxBet: maxBet,
  sessionExpired: t.bet_slip_session_expired,
  returnLabel: t.bet_slip_return,
  profitLabel: t.bet_slip_profit_if_wins || 'Profit if wins',
  liabilityLabel: t.bet_slip_liability || 'Liability',
  suspendedMsg: t.runner_suspended || 'This selection is suspended',
  sport: match.sport,
  live: match.live || null,
  isLive: /^(live|inplay|in_play|in-play)$/i.test(String(match.status || '')),
  waitingMsg: t.waiting_live_feed || 'Waiting for live feed…',
  teamA: match.teams[0],
  teamB: match.teams[1]
}) %></script>
<script src="/js/views/match-detail.js"></script>

<%- include('partials/bottom-nav') %>
</body>
</html>

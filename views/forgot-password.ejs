<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-dark);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card glass">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;"><%= t.password_reset_title %></div>
      <div class="card-body">
        <%- include('partials/flash') %>

        <% if (sent) { %>
          <div style="text-align:center;padding:1rem 0;">
            <div style="font-size:2.2rem;margin-bottom:.5rem;">📧</div>
            <p style="color:var(--text-muted);font-size:.92rem;line-height:1.6;">
              <%= t.password_reset_sent %>
            </p>
          </div>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:.88rem;margin-bottom:1rem;">
            <%= t.password_reset_intro %>
          </p>
          <form action="/forgot-password" method="POST">
            <%# POST /forgot-password (routes/auth.js) services/botDetection.js দিয়ে প্রতিটা সাবমিশন
                যাচাই করে — form_rendered_at, honeypot (website) আর ঝুঁকি থাকলে captcha_answer আশা করে।
                এই তিনটা ফিল্ড আগে এখানে রেন্ডারই হতো না (login.ejs-এ হতো), ফলে ঝুঁকি শনাক্ত হলে
                (যেমন শেয়ার্ড/NAT IP থেকে বেশি রিকোয়েস্ট, বা অস্বাভাবিক user-agent) রুট captcha চাইত
                কিন্তু ইউজার কোথাও সেই প্রশ্নটাই দেখতে পেত না — পাসওয়ার্ড রিসেট স্থায়ীভাবে আটকে যেত। %>
            <input type="hidden" name="form_rendered_at" value="<%= locals.formRenderedAt || Date.now() %>">

            <!-- হানিপট — বট ডিটেকশন (ব্যাকএন্ড এই ফিল্ড চেক করে) -->
            <div class="auth-honeypot" aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden;">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="form-group">
              <label class="form-label"><%= t.email %></label>
              <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
            </div>

            <% if (locals.captcha) { %>
            <div class="form-group">
              <label class="form-label" for="captcha_answer"><%= t.captcha_verify %> <%= captcha.question %></label>
              <input
                type="text"
                id="captcha_answer"
                name="captcha_answer"
                class="form-input"
                placeholder="<%= t.captcha_answer_placeholder %>"
                inputmode="numeric"
                autocomplete="off"
                required>
            </div>
            <% } %>

            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;"><%= t.send_reset_link %></button>
          </form>
        <% } %>

        <p style="text-align:center;margin-top:1rem;color:var(--text-muted);font-size:.9rem;">
          <a href="/login" style="color:var(--secondary)"><%= t.back_to_login %></a>
        </p>
      </div>
    </div>
  </div>
</div>

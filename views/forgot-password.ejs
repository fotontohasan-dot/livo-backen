<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz87-1 { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-dark); }
  .dz87-2 { width: 100%; max-width: 400px; padding: 1rem; }
  .dz87-3 { text-align: center; padding: 1rem 0; }
  .dz87-4 { color: var(--text-muted); font-size: .92rem; line-height: 1.6; }
  .dz87-5 { color: var(--text-muted); font-size: .88rem; margin-bottom: 1rem; }
  .dz87-6 { width: 100%; justify-content: center; padding: 12px; }
  .dz87-7 { text-align: center; margin-top: 1rem; color: var(--text-muted); font-size: .9rem; }
  .dz87-8 { color: var(--secondary); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im88-1 { justify-content: center; font-size: 1.2rem; }
  .im88-2 { font-size: 2.2rem; margin-bottom: .5rem; }
  .im88-3 { position: absolute; left: -9999px; height: 0; overflow: hidden; }
</style>

<div class="dz87-1">
  <div class="dz87-2">
    <div class="card glass">
      <div class="card-header im88-1"><%= t.password_reset_title %></div>
      <div class="card-body">
        <%- include('partials/flash') %>

        <% if (sent) { %>
          <div class="dz87-3">
            <div class="im88-2">📧</div>
            <p class="dz87-4">
              <%= t.password_reset_sent %>
            </p>
          </div>
        <% } else { %>
          <p class="dz87-5">
            <%= t.password_reset_intro %>
          </p>
          <form action="/forgot-password" method="POST">
            <%# POST /forgot-password (routes/auth.js) services/botDetection.js দিয়ে প্রতিটা সাবমিশন
                যাচাই করে — form_rendered_at, honeypot (website) আর ঝুঁকি থাকলে captcha_answer আশা করে।
                এই তিনটা ফিল্ড আগে এখানে রেন্ডারই হতো না (login.ejs-এ হতো), ফলে ঝুঁকি শনাক্ত হলে
                (যেমন শেয়ার্ড/NAT IP থেকে বেশি রিকোয়েস্ট, বা অস্বাভাবিক user-agent) রুট captcha চাইত
                কিন্তু ইউজার কোথাও সেই প্রশ্নটাই দেখতে পেত না — পাসওয়ার্ড রিসেট স্থায়ীভাবে আটকে যেত। %>
            <input type="hidden" name="form_rendered_at" value="<%= locals.formRenderedAt || Date.now() %>">

            <!-- হানিপট — বট ডিটেকশন (ব্যাকএন্ড এই ফিল্ড চেক করে) -->
            <div class="auth-honeypot im88-3" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="form-group">
              <label class="form-label"><%= t.email %></label>
              <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
            </div>

            <% if (locals.captcha) { %>
            <div class="form-group">
              <label class="form-label" for="captcha_answer"><%= t.captcha_verify %> <%= captcha.question %></label>
              <input
                type="text"
                id="captcha_answer"
                name="captcha_answer"
                class="form-input"
                placeholder="<%= t.captcha_answer_placeholder %>"
                inputmode="numeric"
                autocomplete="off"
                required>
            </div>
            <% } %>

            <button type="submit" class="btn btn-primary dz87-6"><%= t.send_reset_link %></button>
          </form>
        <% } %>

        <p class="dz87-7">
          <a class="dz87-8" href="/login"><%= t.back_to_login %></a>
        </p>
      </div>
    </div>
  </div>
</div>

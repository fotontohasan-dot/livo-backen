<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container mt-4">
    <h2>লেনদেনের ইতিহাস</h2>
    <table class="table table-dark">
        <thead>
            <tr>
                <th>তারিখ</th>
                <th>ধরন</th>
                <th>মেথড</th>
                <th>পরিমাণ</th>
                <th>স্ট্যাটাস</th>
            </tr>
        </thead>
        <tbody>
            <% if(locals.transactions) { %>
                <% transactions.forEach(tx => { %>
                    <tr>
                        <td><%= tx.created_at.toLocaleDateString() %></td>
                        <td><%= tx.type === 'deposit' ? 'ডিপোজিট' : 'উইথড্র' %></td>
                        <td><%= tx.method %></td>
                        <td><%= tx.amount %></td>
                        <td><%= tx.status %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
<%- include('../partials/bottom-nav') %>

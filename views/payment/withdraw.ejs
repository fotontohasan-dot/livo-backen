<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .instr-card {
    background: var(--bg-surface);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .fab-add {
    position: absolute;
    right: 20px;
    top: 180px;
    width: 50px;
    height: 50px;
    background: #e61e26;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 4px 10px rgba(230, 30, 38, 0.3);
    z-index: 10;
  }

  .input-field {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    font-size: 16px;
    background: var(--bg-surface);
    color: var(--text-main);
  }
  .input-field:focus {
    outline: none;
    border-color: #e61e26;
  }

  .delete-btn {
    color: #e61e26;
    font-size: 18px;
    cursor: pointer;
  }
</style>

<div class="min-h-screen pb-32 max-w-[480px] mx-auto relative bg-dark">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-4 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center gap-4">
        <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
        <h1 class="text-lg font-bold">উত্তোলন</h1>
    </div>
    <div class="flex gap-4">
        <i class="fas fa-file-alt text-xl"></i>
        <i class="fas fa-headset text-xl"></i>
    </div>
  </div>

  <!-- Sub Header / Tab -->
  <div class="bg-surface py-3 flex justify-center items-center gap-2 border-b-2 border-red-600 mb-4">
    <div class="w-8 h-8 bg-pink-600 rounded-lg flex items-center justify-center text-white text-xs">
        <i class="fas fa-wallet"></i>
    </div>
    <span class="text-red-600 font-bold">E wallet</span>
  </div>

  <!-- FAB Add -->
  <a href="/profile/cards" class="fab-add">
    <i class="fas fa-plus"></i>
  </a>

  <div class="px-4">
    <%- include('../partials/flash') %>

    <!-- Bound Wallet Section -->
    <div class="mb-6">
        <h2 class="text-muted font-bold mb-4">আবদ্ধ E wallet (<%= cards ? cards.length : 0 %>/5)</h2>

        <% if (cards && cards.length > 0) { %>
            <div class="space-y-3">
                <% cards.forEach(c => { %>
                    <div class="bg-surface rounded-xl p-4 border border-glass flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center text-red-600">
                                <i class="fas fa-university"></i>
                            </div>
                            <div>
                                <p class="font-bold text-sm text-main"><%= c.bank_name %></p>
                                <p class="text-xs text-muted"><%= c.account_number %></p>
                            </div>
                        </div>
                        <form action="/profile/cards/delete/<%= c.id %>" method="POST" onsubmit="return confirm('আপনি কি নিশ্চিত?')">
                            <button type="submit" class="delete-btn">
                                <i class="far fa-times-circle"></i>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center py-8">
                <img src="https://img.icons8.com/illustrations/64/credit-card.png" class="opacity-20 mb-2" alt="empty">
                <p class="text-gray-400 font-bold">খালি ই-ওয়ালেট</p>
            </div>
        <% } %>
    </div>

    <!-- Instructions Section -->
    <div class="text-[13px] text-main leading-snug mb-6">
        <p class="text-muted mb-2">উত্তোলন সময়: 24 ঘণ্টা</p>
        <p class="font-bold mb-1">💬 প্রিয় সদস্য, শুভেচ্ছা! 🎯</p>
        <p class="font-bold mb-2">আপনার <span class="red-theme-text uppercase"><%= siteName %></span> অ্যাকাউন্টে উত্তোলনের আগে অনুগ্রহ করে আপনার ওয়ালেট (বিকাশ/নগদ/রকেট ইত্যাদি) সঠিকভাবে সংযুক্ত হয়েছে কিনা তা যাচাই করুন। ভুল ওয়ালেট সংযোগের কারণে টাকা স্থানান্তরে বিলম্ব বা ব্যর্থতা ঘটতে পারে।</p>
        <p class="font-bold mb-4">🔒 দয়া করে আবার পরীক্ষা করুন এবং নিরাপদে উত্তোলন সম্পন্ন করুন! 💰</p>

        <div class="text-muted space-y-1">
            <p>দৈনিক উত্তোলন ৯৯,৯৯৯ (বার), অবশিষ্ট উত্তোলন ৯৯,৯৯৯ (বার)</p>
            <p>প্রধান ওয়ালেট :৳ <%= (coins || 0).toFixed(2) %></p>
            <p>উপলব্ধ পরিমাণ : ৳ <%= (coins || 0).toFixed(2) %></p>
        </div>

        <button onclick="location.reload()" class="w-full mt-4 py-2.5 bg-blue-100 text-blue-600 rounded-full font-bold flex items-center justify-center gap-2 text-sm">
            <i class="fas fa-sync-alt"></i> আপনার ব্যালেন্স রিফ্রেশ করুন
        </button>
    </div>

    <% var locked = (typeof withdrawLock !== 'undefined') && withdrawLock && withdrawLock.allowed === false; %>

    <% if (locked) { %>
      <div class="rounded-xl p-4 mb-6" style="background: rgba(230,30,38,0.1); border: 1.5px solid #e61e26;">
        <div class="flex items-center gap-2 mb-2">
          <i class="fas fa-lock red-theme-text"></i>
          <span class="font-bold red-theme-text">উত্তোলন এই মুহূর্তে লক করা আছে</span>
        </div>
        <p class="text-sm text-main mb-2">বোনাসের টার্নওভার (Wagering) পূরণ না হওয়া পর্যন্ত উত্তোলন করা যাবে না। শর্ত পূরণ হলে স্বয়ংক্রিয়ভাবে আনলক হয়ে যাবে।</p>
        <div class="text-xs text-muted space-y-1">
          <% withdrawLock.pending.forEach(function(p) { %>
            <% if (p.sportsLeft > 0) { %><p>• স্পোর্টস টার্নওভার বাকি: ৳ <%= p.sportsLeft.toFixed(2) %></p><% } %>
            <% if (p.casinoLeft > 0) { %><p>• ক্যাসিনো টার্নওভার বাকি: ৳ <%= p.casinoLeft.toFixed(2) %></p><% } %>
          <% }) %>
        </div>
      </div>
    <% } %>

    <form action="/payment/withdraw" method="POST" id="withdrawForm">
      <!-- Withdrawal Form -->
      <fieldset <%= locked ? 'disabled' : '' %> class="space-y-5 <%= locked ? 'opacity-50' : '' %>">

        <% if (!cards || cards.length === 0) { %>
          <div class="bg-surface border border-glass rounded-xl p-4 text-center">
            <p class="text-muted font-bold mb-3">উত্তোলনের জন্য আগে একটি ই-ওয়ালেট যুক্ত করুন।</p>
            <a href="/profile/cards" class="inline-block red-theme-bg text-white font-bold px-5 py-2.5 rounded-full text-sm">
              <i class="fas fa-plus"></i> ই-ওয়ালেট যুক্ত করুন
            </a>
          </div>
        <% } else { %>
          <div>
            <label class="block text-main font-bold mb-2">ই-ওয়ালেট নির্বাচন করুন</label>
            <select id="walletSelect" class="w-full p-4 border-2 border-glass rounded-xl focus:outline-none bg-surface text-main font-bold" required onchange="syncWallet()">
              <option value="" disabled selected>আপনার সংযুক্ত ওয়ালেট বাছাই করুন</option>
              <% cards.forEach(c => {
                   const bn = (c.bank_name || '').toLowerCase();
                   let methodCode = 'bank';
                   if (bn.includes('bkash')) methodCode = 'bkash';
                   else if (bn.includes('nagad')) methodCode = 'nagad';
                   else if (bn.includes('rocket')) methodCode = 'rocket';
                   else if (bn.includes('upay')) methodCode = 'upay';
              %>
                <option value="<%= c.id %>" data-method="<%= methodCode %>" data-number="<%= c.account_number %>">
                  <%= c.bank_name %> — <%= c.account_number %>
                </option>
              <% }) %>
            </select>
            <p class="text-muted text-xs mt-2"><i class="fas fa-lock"></i> শুধুমাত্র আপনার ই-ওয়ালেটের সাথে সংযুক্ত নাম্বারেই উত্তোলন করা যাবে। নতুন নাম্বার লিখতে হলে আগে <a href="/profile/cards" class="red-theme-text font-bold">ই-ওয়ালেট</a> থেকে যুক্ত করুন।</p>
          </div>

          <!-- এই দুটো hidden ফিল্ড ই সার্ভারে পাঠানো হবে, ইউজার নিজে থেকে টাইপ করতে পারবে না -->
          <input type="hidden" name="method" id="methodField">
          <input type="hidden" name="account_number" id="accountNumberField">
        <% } %>

        <div>
          <label class="block text-main font-bold mb-2">পরিমাণ (১০০ ~ ৫০,০০০)</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <span class="text-muted font-bold">৳</span>
            </div>
            <input type="number" name="amount" placeholder="টাকার পরিমাণ লিখুন" min="100" max="50000" class="w-full pl-10 p-4 border-2 border-glass rounded-xl focus:outline-none bg-surface text-lg font-bold text-red-600" required>
          </div>
        </div>

        <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-main">পাসওয়ার্ড</span>
            <input type="password" id="secPassword" name="password" placeholder="পাসওয়ার্ড" class="input-field pl-24 text-right" required>
            <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted">
                <i class="fas fa-eye-slash" id="eyeIcon"></i>
            </button>
        </div>

        <button type="submit" <%= (!cards || cards.length === 0 || locked) ? 'disabled' : '' %> class="w-full red-theme-bg text-white py-4 rounded-lg font-bold text-lg mt-6 shadow-lg active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
            <%= locked ? 'টার্নওভার সম্পন্ন করুন' : 'জমা দিন' %>
        </button>
      </fieldset>
    </form>
  </div>
</div>

<script>
  function syncWallet() {
    const sel = document.getElementById('walletSelect');
    const opt = sel.options[sel.selectedIndex];
    document.getElementById('methodField').value = opt.dataset.method || '';
    document.getElementById('accountNumberField').value = opt.dataset.number || '';
  }

  function togglePassword() {
    const pwd = document.getElementById('secPassword');
    const eye = document.getElementById('eyeIcon');
    if (pwd.type === 'password') {
      pwd.type = 'text';
      eye.classList.remove('fa-eye-slash');
      eye.classList.add('fa-eye');
    } else {
      pwd.type = 'password';
      eye.classList.remove('fa-eye');
      eye.classList.add('fa-eye-slash');
    }
  }
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

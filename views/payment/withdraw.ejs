<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Class selectors are repeated so the generated rules keep
     the specificity the inline declarations had, without !important —
     JS-set element.style still wins. */
  .rt2-1.rt2-1.rt2-1 { background:#E6007E; }
  .rt2-2.rt2-2.rt2-2 { background:#F7931A; }
  .rt2-3.rt2-3.rt2-3 { font-size:40px; opacity:0.2; margin-bottom:8px; }
  .rt2-4.rt2-4.rt2-4 { margin-top:10px; }
  .rt2-5.rt2-5.rt2-5 { color:#fbbf24; }
  .rt2-6.rt2-6.rt2-6 { color:#60a5fa; }
</style>
<style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body { background-color: var(--bg-dark) !important; color: var(--text-main) !important; font-family: 'Hind Siliguri', sans-serif; }
  .wd-wrap { max-width: 480px; margin: 0 auto; padding-bottom: 110px; position: relative; }
  .wd-topbar { background: #000; color: #fff; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
  .wd-topbar .left { display: flex; align-items: center; gap: 14px; }
  .wd-topbar a, .wd-topbar i { color: #fff; }
  .wd-topbar h1 { font-size: 16px; font-weight: 700; margin: 0; }
  .wd-icons { display: flex; gap: 14px; font-size: 16px; }

  .wd-tabs { display: flex; background: var(--bg-surface); }
  .wd-tab { flex: 1; text-align: center; padding: 12px 0; font-weight: 700; color: var(--text-muted); border-bottom: 3px solid transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
  .wd-tab.active { color: #e61e26; border-color: #e61e26; }
  .wd-tab .dot { width: 22px; height: 22px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; }

  .fab-add { position: absolute; right: 16px; top: 130px; width: 44px; height: 44px; background: #e61e26; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 10px rgba(230,30,38,0.35); z-index: 10; text-decoration: none; }

  .wd-section { padding: 16px; }
  .wd-label { color: var(--text-muted); font-weight: 700; margin-bottom: 10px; }
  .wallet-card { background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 12px; padding: 14px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .wallet-card .info { display: flex; align-items: center; gap: 10px; }
  .wallet-card .ic { width: 38px; height: 38px; border-radius: 8px; background: rgba(230,30,38,0.12); color: #e61e26; display: flex; align-items: center; justify-content: center; }
  .wallet-card b { font-size: 14px; }
  .wallet-card small { color: var(--text-muted); display: block; }
  .wallet-card .del { color: #e61e26; cursor: pointer; background: none; border: none; font-size: 18px; }

  .empty-wallet { display: flex; flex-direction: column; align-items: center; padding: 30px 0; color: var(--text-muted); }

  .instr { font-size: 13px; line-height: 1.7; padding: 0 16px; }
  .instr .muted { color: var(--text-muted); }
  .instr .bold { font-weight: 700; }
  .refresh-btn { width: 100%; margin-top: 14px; padding: 10px; border-radius: 30px; border: none; background: rgba(59,130,246,0.15); color: #60a5fa; font-weight: 700; }

  .field-group { padding: 0 16px; margin-bottom: 16px; }
  .field-group label { display: block; font-weight: 700; margin-bottom: 6px; font-size: 14px; }
  .field-group select, .field-group input {
    width: 100%; padding: 13px; border: 2px solid var(--border-glass); border-radius: 12px;
    background: var(--bg-surface); color: var(--text-main); font-weight: 700;
  }
  .field-group select:focus, .field-group input:focus { outline: none; border-color: #e61e26; }
  .field-with-icon { position: relative; }
  .field-with-icon .toggle-eye { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); }

  .submit-btn { display: block; width: calc(100% - 32px); margin: 8px 16px 0; background: #e61e26; color: #fff; border: none; padding: 15px; border-radius: 14px; font-size: 16px; font-weight: 800; }
  .pin-note { font-size: 12px; color: var(--text-muted); padding: 0 16px 8px; }
  .rounded-msg-box { background: rgba(230,30,38,0.15); border: 1px solid rgba(230,30,38,0.55); color: #fff; border-radius: 14px; padding: 12px 16px; font-size: 13px; font-weight: 600; margin: 16px; line-height: 1.6; }
  .ic.has-logo { background: transparent; overflow: hidden; padding: 0; }
  .ic.has-logo img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; display: block; }
  #withdrawSubmitBtn:disabled { opacity: 0.55; cursor: not-allowed; }

  /* ===== টার্নওভার লক: ব্যানার + পপআপ ===== */
  .to-banner { display: flex; align-items: center; gap: 10px; margin: 12px 16px; padding: 12px 14px; border-radius: 14px; background: rgba(230,30,38,0.15); border: 1px solid rgba(230,30,38,0.55); color: #fff; font-size: 13px; font-weight: 600; line-height: 1.5; }
  .to-banner i { color: #ff5a60; }
  .to-banner-btn { margin-left: auto; flex-shrink: 0; background: #e61e26; color: #fff; border: 0; border-radius: 10px; padding: 7px 12px; font-size: 12px; font-weight: 700; cursor: pointer; }
  .to-modal { display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.72); align-items: center; justify-content: center; padding: 16px; }
  .to-modal.show { display: flex; }
  .to-card { width: 100%; max-width: 420px; max-height: 88vh; overflow-y: auto; background: var(--bg-card, #171b23); color: var(--text-main, #fff); border: 1px solid rgba(230,30,38,0.5); border-radius: 18px; padding: 18px 16px; box-shadow: 0 16px 48px rgba(0,0,0,0.5); }
  .to-head { display: flex; align-items: center; gap: 10px; }
  .to-head i { color: #ff5a60; font-size: 20px; }
  .to-head h3 { margin: 0; font-size: 18px; font-weight: 800; }
  .to-sub { margin: 8px 0 12px; font-size: 13px; opacity: 0.85; line-height: 1.5; }
  .to-row { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 10px 12px; margin-bottom: 10px; }
  .to-row-title { font-weight: 800; font-size: 13px; margin-bottom: 6px; color: #fbbf24; }
  .to-line { display: flex; justify-content: space-between; font-size: 13px; margin-top: 4px; }
  .to-bar { width: 100%; height: 8px; margin-top: 4px; accent-color: #22c55e; }
  .to-meta { font-size: 11px; opacity: 0.7; margin-top: 2px; }
  .to-actions { display: flex; gap: 8px; margin: 12px 0 8px; }
  .to-btn { flex: 1; text-align: center; border: 0; border-radius: 12px; padding: 11px 8px; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; display: block; }
  .to-btn-primary { background: #e61e26; color: #fff; }
  .to-btn-ghost { width: 100%; background: rgba(255,255,255,0.1); color: inherit; }
  .to-unlocked { background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.6); border-radius: 12px; padding: 12px; font-weight: 700; font-size: 14px; text-align: center; margin-bottom: 8px; }
</style>

<%
  // wallet নাম থেকে লোগো ফাইলের নাম (না মিললে খালি → আগের আইকন দেখাবে)
  function walletLogo(n){ n=(n||'').toLowerCase();
    if(n.includes('bkash'))return 'bkash'; if(n.includes('nagad'))return 'nagad';
    if(n.includes('rocket'))return 'rocket'; if(n.includes('upay'))return 'upay';
    if(n.includes('usdt')||n.includes('tether'))return 'usdt'; return ''; }
%>
<div class="wd-wrap">
  <div class="wd-topbar">
    <div class="left"><a href="/profile"><i class="fas fa-chevron-left"></i></a><h1><%= t.wd2_title %></h1></div>
    <div class="wd-icons"><i class="fas fa-file-alt"></i><i class="fas fa-headset"></i></div>
  </div>

  <div class="wd-tabs">
    <div class="wd-tab active" id="tabEwallet">
      <span class="dot rt2-1">e</span> E wallet
    </div>
    <div class="wd-tab" id="tabCrypto">
      <span class="dot rt2-2">₿</span> <%= t.wd2_crypto_wallet %>
    </div>
  </div>

  <a href="/profile/cards" class="fab-add"><i class="fas fa-plus"></i></a>

  <%- include('../partials/flash') %>

  <div class="wd-section" id="panelEwallet">
    <div class="wd-label"><%= t.wd2_linked_ewallet %> (<%= cards ? cards.length : 0 %>/5)</div>
    <% if (cards && cards.length > 0) { %>
      <% cards.forEach(function(c){ %>
        <div class="wallet-card">
          <div class="info">
            <div class="ic<% if (walletLogo(c.bank_name)) { %> has-logo<% } %>"><% if (walletLogo(c.bank_name)) { %><img src="/images/<%= walletLogo(c.bank_name) %>.png" alt="<%= c.bank_name %>"><% } else { %><i class="fas fa-wallet"></i><% } %></div>
            <div><b><%= c.bank_name %></b><small><%= c.account_number %></small></div>
          </div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form" data-confirm="<%= t('wd_confirm_delete') %>">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-wallet"><i class="fas fa-wallet rt2-3"></i><span><%= t.wd2_empty_ewallet %></span></div>
    <% } %>
  </div>

  <div class="wd-section" id="panelCrypto" style="display:none;">
    <div class="wd-label"><%= t.wd2_crypto_wallet %> (<%= cryptoCards ? cryptoCards.length : 0 %>/5)</div>
    <% if (cryptoCards && cryptoCards.length > 0) { %>
      <% cryptoCards.forEach(function(c){ %>
        <div class="wallet-card">
          <div class="info">
            <div class="ic<% if (walletLogo(c.bank_name)) { %> has-logo<% } %>"><% if (walletLogo(c.bank_name)) { %><img src="/images/<%= walletLogo(c.bank_name) %>.png" alt="<%= c.bank_name %>"><% } else { %><i class="fab fa-bitcoin"></i><% } %></div>
            <div><b><%= c.bank_name %></b><small><%= c.account_number %></small></div>
          </div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form" data-confirm="<%= t('wd_confirm_delete') %>">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-wallet"><i class="fab fa-bitcoin rt2-3"></i><span><%= t.wd2_empty_wallets %></span></div>
    <% } %>
  </div>

  <div class="instr">
    <p class="muted"><%= t.wd2_hours %></p>
    <p class="bold"><%= t.wd2_greeting %></p>
    <p class="bold">আপনার <%= siteName %> অ্যাকাউন্টে <%= t.wd2_title %><%= lang === 'en' ? ' ' : 'ের ' %>আগে অনুগ্রহ করে আপনার ওয়ালেট (বিকাশ/নগদ/রকেট ইত্যাদি) সঠিকভাবে সংযুক্ত হয়েছে কিনা তা যাচাই করুন। ভুল ওয়ালেট সংযোগের কারণে টাকা স্থানান্তরে বিলম্ব বা ব্যর্থতা ঘটতে পারে।</p>
    <p class="bold"><%= t.wd2_check_again %></p>
    <p class="muted"><%= t.wd2_daily_limits %></p>
    <p class="muted"><%= t.wd2_main_wallet %>৳ <span id="mainWalletAmt"><%= (coins || 0).toFixed(2) %></span></p>
    <p class="muted"><%= t.wd2_available %>৳ <span id="availableAmt"><%= (coins || 0).toFixed(2) %></span></p>
    <button type="button" id="refreshBalanceBtn" class="refresh-btn"><i class="fas fa-sync-alt" id="refreshIcon"></i> <%= t.wd2_refresh_balance %></button>
  </div>

  <%
    // সাবমিট বোতামের গেট। তিনটে শর্তের যেকোনো একটাতেই ফর্ম পাঠানো অর্থহীন,
    // কারণ সার্ভার নিশ্চিতভাবে বাতিল করবে: উইথড্র উইন্ডো বন্ধ, PIN সেট নেই,
    // অথবা কোনো সংরক্ষিত কার্ড/ওয়ালেট নেই (টাকা পাঠানোর গন্তব্যই নেই)।
    const windowClosed = typeof withdrawalWindow !== 'undefined' && withdrawalWindow && !withdrawalWindow.open;
    const noDestination = !((cards && cards.length) || (cryptoCards && cryptoCards.length));
    // টার্নওভার লক: সার্ভার withdrawLock পাঠায় (routes/payment.js GET /withdraw)।
    // যাচাই ব্যর্থ হলে (checkFailed) fail-closed — লক ধরা হয়।
    const lockInfo = (typeof withdrawLock !== 'undefined' && withdrawLock) ? withdrawLock : { allowed: true, pending: [] };
    const turnoverLocked = lockInfo.allowed === false;
    const otherGates = windowClosed || !hasWithdrawPin || noDestination;
    const formGated = turnoverLocked || otherGates;
    const toNum = function (v) { return (Number(v) || 0).toFixed(2); };
    const toTypeLabel = function (ty) {
      const k = 'to_type_' + ty;
      return (t[k] && t[k] !== k) ? t[k] : ty;
    };
    const lockedRows = (lockInfo.pending || []).filter(function (p) { return p.sportsLeft > 0 || p.casinoLeft > 0; });
  %>
  <% if (turnoverLocked) { %>
    <div class="to-banner" id="turnoverBanner">
      <i class="fas fa-lock"></i>
      <span><%= lockInfo.checkFailed ? t.to_check_failed : t.withdraw_turnover_notice %></span>
      <button type="button" class="to-banner-btn" data-modal-open="turnoverModal"><%= t.to_view_details %></button>
    </div>
  <% } %>
  <div class="to-modal<%= turnoverLocked ? ' show' : '' %>" id="turnoverModal" role="dialog" aria-modal="true" aria-labelledby="turnoverModalTitle"
       data-locked="<%= turnoverLocked ? '1' : '0' %>"
       data-status-url="/payment/withdraw/turnover-status"
       data-l-sports="<%= t.to_sports_label %>" data-l-casino="<%= t.to_casino_label %>"
       data-l-left="<%= t.to_left_label %>" data-l-done="<%= t.to_done_of %>"
       data-l-type-deposit="<%= t.to_type_deposit %>" data-l-type-daily="<%= t.to_type_daily %>" data-l-type-referral="<%= t.to_type_referral %>"
       data-l-unlocked="<%= t.to_unlocked %>" data-l-failed="<%= t.to_check_failed %>">
    <div class="to-card">
      <div class="to-head">
        <i class="fas fa-lock"></i>
        <h3 id="turnoverModalTitle"><%= t.to_modal_title %></h3>
      </div>
      <p class="to-sub" id="turnoverSub"><%= lockInfo.checkFailed ? t.to_check_failed : t.to_modal_sub %></p>
      <div id="turnoverList">
        <% lockedRows.forEach(function (p) { %>
          <div class="to-row">
            <div class="to-row-title"><%= toTypeLabel(p.type) %></div>
            <% if (p.sportsLeft > 0) { %>
              <div class="to-line"><span><%= t.to_sports_label %></span><b>৳ <%= toNum(p.sportsLeft) %> <%= t.to_left_label %></b></div>
              <progress class="to-bar" max="<%= toNum(p.sportsRequired) %>" value="<%= toNum(p.sportsDone) %>"></progress>
              <div class="to-meta">৳ <%= toNum(p.sportsDone) %> / ৳ <%= toNum(p.sportsRequired) %> <%= t.to_done_of %></div>
            <% } %>
            <% if (p.casinoLeft > 0) { %>
              <div class="to-line"><span><%= t.to_casino_label %></span><b>৳ <%= toNum(p.casinoLeft) %> <%= t.to_left_label %></b></div>
              <progress class="to-bar" max="<%= toNum(p.casinoRequired) %>" value="<%= toNum(p.casinoDone) %>"></progress>
              <div class="to-meta">৳ <%= toNum(p.casinoDone) %> / ৳ <%= toNum(p.casinoRequired) %> <%= t.to_done_of %></div>
            <% } %>
          </div>
        <% }) %>
      </div>
      <div class="to-actions" id="turnoverActions">
        <a class="to-btn to-btn-primary" href="/sports"><%= t.to_play_sports %></a>
        <a class="to-btn to-btn-primary" href="/games"><%= t.to_play_casino %></a>
      </div>
      <button type="button" class="to-btn to-btn-ghost" data-modal-close="turnoverModal"><%= t.to_close %></button>
    </div>
  </div>
  <% if (!hasWithdrawPin) { %>
    <div class="instr rt2-4" id="pinNotConfiguredNotice">
      <p class="rt2-5">⚠️ <%= t.wd2_title %><%= lang === 'en' ? ' ' : 'ের ' %>আগে আপনার Withdraw PIN সেট করুন — <a class="rt2-6" href="/profile/security"><%= t.wd2_set_here %></a></p>
    </div>
  <% } %>

  <form class="rt2-4" action="/payment/withdraw" method="POST" id="withdrawForm"
        data-loading-target="withdrawSubmitBtn" data-loading-label="<%= t('awd_sending') %>"
        data-confirm="<%= t('withdraw_submit_confirm') %>">
    <%
      // গন্তব্য শুধু সংরক্ষিত ওয়ালেট থেকেই বাছা যায়। আগে এখানে একটা খোলা
      // method dropdown আর হাতে-টাইপ করা account_number ছিল — অর্থাৎ
      // /profile/cards-এ যাচাই করা ওয়ালেটের বাইরে যেকোনো নম্বরে টাকা
      // পাঠানোর রিকোয়েস্ট করা যেত, আর টাইপো ধরার কোনো উপায় ছিল না।
      const withdrawWallets = [].concat(cards || [], cryptoCards || []);
    %>
    <div class="field-group">
      <label><%= t.select_ewallet %></label>
      <select id="walletSelect" name="wallet_id" required data-sync-wallet>
        <option value="" disabled<%= withdrawWallets.length ? '' : ' selected' %>><%= t.choose_linked_wallet %></option>
        <% withdrawWallets.forEach(function (c, i) {
             const bn = (c.bank_name || '').toLowerCase();
             let methodCode = 'bank';
             if (c.wallet_kind === 'crypto') methodCode = 'crypto';
             else if (bn.includes('bkash')) methodCode = 'bkash';
             else if (bn.includes('nagad')) methodCode = 'nagad';
             else if (bn.includes('rocket')) methodCode = 'rocket';
             else if (bn.includes('upay')) methodCode = 'upay';
        %>
          <option value="<%= c.id %>" data-method="<%= methodCode %>" data-number="<%= c.account_number %>"<%= i === 0 ? ' selected' : '' %>>
            <%= c.bank_name %> — <%= c.account_number %>
          </option>
        <% }) %>
      </select>
    </div>

    <%# সার্ভারে এই দুটোই যায়; ইউজার নিজে টাইপ করতে পারে না। %>
    <input type="hidden" name="method" id="methodField">
    <input type="hidden" name="account_number" id="accountNumberField">

    <div class="field-group">
      <label><%= t.wd2_amount_label %></label>
      <input type="number" name="amount" placeholder="<%= t.wd2_amount_placeholder %>" min="100" max="50000" required>
    </div>

    <div class="field-group field-with-icon">
      <label><%= t.wd2_tx_password %></label>
      <input type="password" id="secPassword" name="password" placeholder="<%= t.wd2_tx_password %>" required>
      <button type="button" class="toggle-eye" data-reveal-field="secPassword" data-reveal-icon="eyeIcon"><i class="fas fa-eye-slash" id="eyeIcon"></i></button>
    </div>

    <% if (hasWithdrawPin) { %>
      <div class="field-group field-with-icon">
        <label>Withdraw PIN</label>
        <input type="password" id="withdrawPinField" name="withdraw_pin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" autocomplete="off" placeholder="<%= t.wd2_pin_placeholder %>" required>
        <button type="button" class="toggle-eye" data-reveal-field="withdrawPinField" data-reveal-icon="withdrawPinEye"><i class="fas fa-eye-slash" id="withdrawPinEye"></i></button>
      </div>
      <p class="pin-note"><%= t.wd2_pin_note %></p>
    <% } %>

    <%# বন্ধ-সময় ও "ওয়ালেট যোগ করুন" বার্তা দুটো ইচ্ছাকৃতভাবে লুকানো (ইউজারের অনুরোধে);
        সাবমিট বাটন gate (formGated) আগের মতোই কাজ করছে — শর্ত পূরণ না হলে বাটন disabled। %>

    <button type="submit" id="withdrawSubmitBtn" class="submit-btn"
            data-other-gates="<%= otherGates ? '1' : '0' %>"
            data-label-ready="<%= t.wd2_submit_btn %>"
            <% if (formGated) { %> disabled<% } %>><%= turnoverLocked ? t.wd_complete_turnover : t.wd2_submit_btn %></button>
  </form>
</div>

<script src="/js/payment-withdraw.js"></script>

<%- include('../partials/bottom-nav') %>
</body></html>

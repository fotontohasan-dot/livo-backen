<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body {
    background-color: #f8f9fa !important;
    color: #333 !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  input:focus {
    border-color: #e61e26 !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.1);
  }

  /* Fix for navbar and bottom nav */
  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }
</style>

<div class="min-h-screen pb-24">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-3 flex items-center gap-4 sticky top-0 z-50">
    <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
    <h1 class="text-lg font-bold">উত্তোলন (Withdrawal)</h1>
  </div>

  <div class="p-4 max-w-md mx-auto">
    <%- include('../partials/flash') %>

    <!-- Wallet Status -->
    <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm mb-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4">
            <button onclick="location.reload()" class="text-gray-400 hover:text-red-500 transition-colors">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>

        <div class="space-y-4">
            <div>
                <span class="text-gray-500 text-sm block">দৈনিক উত্তোলনের সীমা</span>
                <span class="text-xl font-bold text-gray-800">৯৯,৯৯৯ বার</span>
            </div>

            <div class="flex items-end justify-between border-t border-gray-50 pt-4">
                <div>
                    <span class="text-gray-500 text-sm block">প্রধান ওয়ালেট ব্যালেন্স</span>
                    <span class="text-2xl font-black red-theme-text teko">৳<%= coins.toLocaleString('bn-BD') %></span>
                </div>
                <div class="text-right">
                    <span class="text-gray-500 text-sm block">উপলব্ধ পরিমাণ</span>
                    <span class="text-xl font-bold text-green-600 teko">৳<%= coins.toLocaleString('bn-BD') %></span>
                </div>
            </div>
        </div>

        <button onclick="location.reload()" class="w-full mt-6 py-2 border border-gray-200 rounded-xl text-gray-600 text-sm font-bold flex items-center justify-center gap-2 hover:bg-gray-50 transition-all">
            আপনার ব্যালেন্স রিফ্রেশ করুন
        </button>
    </div>

    <form action="/payment/withdraw" method="POST">
      <!-- Withdrawal Form -->
      <div class="space-y-5">
        <div>
          <label class="block text-gray-700 font-bold mb-2">পেমেন্ট মেথড</label>
          <select name="method" class="w-full p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white font-bold" required>
            <option value="bkash">bKash</option>
            <option value="nagad">Nagad</option>
            <option value="rocket">Rocket</option>
            <option value="upay">Upay</option>
            <option value="bank">Bank Transfer</option>
            <option value="crypto">USDT (TRC20)</option>
          </select>
        </div>

        <div>
          <label class="block text-gray-700 font-bold mb-2">পরিমাণ (১০০ ~ ৫০,০০০)</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <span class="text-gray-500 font-bold">৳</span>
            </div>
            <input type="number" name="amount" placeholder="টাকার পরিমাণ লিখুন" min="100" max="50000" class="w-full pl-10 p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white text-lg font-bold text-red-600" required>
          </div>
        </div>

        <div>
          <label class="block text-gray-700 font-bold mb-2">আপনার নম্বর / অ্যাকাউন্ট অ্যাড্রেস</label>
          <input type="text" name="account_number" placeholder="01XXXXXXXXX" class="w-full p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white font-bold" required>
        </div>

        <div>
          <label class="block text-gray-700 font-bold mb-2">সিকিউরিটি পাসওয়ার্ড</label>
          <div class="relative">
            <input type="password" id="secPassword" name="password" placeholder="সিকিউরিটি পিন দিন" class="w-full p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white font-mono" required>
            <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400">
                <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="w-full red-theme-bg text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all mt-10">
        জমা দিন (Submit)
      </button>
    </form>

    <div class="mt-8 text-center text-xs text-gray-400 px-6">
        <p>উত্তোলনের অনুরোধ সাধারণত ৩০-৬০ মিনিটের মধ্যে প্রসেস করা হয়। কিছু ক্ষেত্রে ২৪ ঘণ্টা পর্যন্ত সময় লাগতে পারে।</p>
    </div>
  </div>
</div>

<script>
  function togglePassword() {
    const pwd = document.getElementById('secPassword');
    const eye = document.getElementById('eyeIcon');
    if (pwd.type === 'password') {
      pwd.type = 'text';
      eye.classList.remove('fa-eye');
      eye.classList.add('fa-eye-slash');
    } else {
      pwd.type = 'password';
      eye.classList.remove('fa-eye-slash');
      eye.classList.add('fa-eye');
    }
  }
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

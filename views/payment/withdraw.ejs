<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Class selectors are repeated so the generated rules keep
     the specificity the inline declarations had, without !important —
     JS-set element.style still wins. */
  .rt2-1.rt2-1.rt2-1 { background:#E6007E; }
  .rt2-2.rt2-2.rt2-2 { background:#F7931A; }
  .rt2-3.rt2-3.rt2-3 { font-size:40px; opacity:0.2; margin-bottom:8px; }
  .rt2-4.rt2-4.rt2-4 { margin-top:10px; }
  .rt2-5.rt2-5.rt2-5 { color:#fbbf24; }
  .rt2-6.rt2-6.rt2-6 { color:#60a5fa; }
</style>
<style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body { background-color: var(--bg-dark) !important; color: var(--text-main) !important; font-family: 'Hind Siliguri', sans-serif; }
  .wd-wrap { max-width: 480px; margin: 0 auto; padding-bottom: 110px; position: relative; }
  .wd-topbar { background: #000; color: #fff; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
  .wd-topbar .left { display: flex; align-items: center; gap: 14px; }
  .wd-topbar a, .wd-topbar i { color: #fff; }
  .wd-topbar h1 { font-size: 16px; font-weight: 700; margin: 0; }
  .wd-icons { display: flex; gap: 14px; font-size: 16px; }

  .wd-tabs { display: flex; background: var(--bg-surface); }
  .wd-tab { flex: 1; text-align: center; padding: 12px 0; font-weight: 700; color: var(--text-muted); border-bottom: 3px solid transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
  .wd-tab.active { color: #e61e26; border-color: #e61e26; }
  .wd-tab .dot { width: 22px; height: 22px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; }

  .fab-add { position: absolute; right: 16px; top: 130px; width: 44px; height: 44px; background: #e61e26; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 10px rgba(230,30,38,0.35); z-index: 10; text-decoration: none; }

  .wd-section { padding: 16px; }
  .wd-label { color: var(--text-muted); font-weight: 700; margin-bottom: 10px; }
  .wallet-card { background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 12px; padding: 14px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .wallet-card .info { display: flex; align-items: center; gap: 10px; }
  .wallet-card .ic { width: 38px; height: 38px; border-radius: 8px; background: rgba(230,30,38,0.12); color: #e61e26; display: flex; align-items: center; justify-content: center; }
  .wallet-card b { font-size: 14px; }
  .wallet-card small { color: var(--text-muted); display: block; }
  .wallet-card .del { color: #e61e26; cursor: pointer; background: none; border: none; font-size: 18px; }

  .empty-wallet { display: flex; flex-direction: column; align-items: center; padding: 30px 0; color: var(--text-muted); }

  .instr { font-size: 13px; line-height: 1.7; padding: 0 16px; }
  .instr .muted { color: var(--text-muted); }
  .instr .bold { font-weight: 700; }
  .refresh-btn { width: 100%; margin-top: 14px; padding: 10px; border-radius: 30px; border: none; background: rgba(59,130,246,0.15); color: #60a5fa; font-weight: 700; }

  .field-group { padding: 0 16px; margin-bottom: 16px; }
  .field-group label { display: block; font-weight: 700; margin-bottom: 6px; font-size: 14px; }
  .field-group select, .field-group input {
    width: 100%; padding: 13px; border: 2px solid var(--border-glass); border-radius: 12px;
    background: var(--bg-surface); color: var(--text-main); font-weight: 700;
  }
  .field-group select:focus, .field-group input:focus { outline: none; border-color: #e61e26; }
  .field-with-icon { position: relative; }
  .field-with-icon .toggle-eye { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); }

  .submit-btn { display: block; width: calc(100% - 32px); margin: 8px 16px 0; background: #e61e26; color: #fff; border: none; padding: 15px; border-radius: 14px; font-size: 16px; font-weight: 800; }
  .pin-note { font-size: 12px; color: var(--text-muted); padding: 0 16px 8px; }
  .rounded-msg-box { background: #fef2f2; color: #b91c1c; border-radius: 14px; padding: 12px 16px; font-size: 13px; font-weight: 600; margin: 16px; }
  #withdrawSubmitBtn:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

<div class="wd-wrap">
  <div class="wd-topbar">
    <div class="left"><a href="/profile"><i class="fas fa-chevron-left"></i></a><h1>উত্তোলন</h1></div>
    <div class="wd-icons"><i class="fas fa-file-alt"></i><i class="fas fa-headset"></i></div>
  </div>

  <div class="wd-tabs">
    <div class="wd-tab active" id="tabEwallet">
      <span class="dot rt2-1">e</span> E wallet
    </div>
    <div class="wd-tab" id="tabCrypto">
      <span class="dot rt2-2">₿</span> ক্রিপ্টো ওয়ালেট
    </div>
  </div>

  <a href="/profile/cards" class="fab-add"><i class="fas fa-plus"></i></a>

  <%- include('../partials/flash') %>

  <div class="wd-section" id="panelEwallet">
    <div class="wd-label">আবদ্ধ E wallet (<%= cards ? cards.length : 0 %>/5)</div>
    <% if (cards && cards.length > 0) { %>
      <% cards.forEach(function(c){ %>
        <div class="wallet-card">
          <div class="info">
            <div class="ic"><i class="fas fa-wallet"></i></div>
            <div><b><%= c.bank_name %></b><small><%= c.account_number %></small></div>
          </div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form" data-confirm="<%= t('wd_confirm_delete') %>">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-wallet"><i class="fas fa-wallet rt2-3"></i><span>খালি ই-ওয়ালেট</span></div>
    <% } %>
  </div>

  <div class="wd-section" id="panelCrypto" style="display:none;">
    <div class="wd-label">ক্রিপ্টো ওয়ালেট (<%= cryptoCards ? cryptoCards.length : 0 %>/5)</div>
    <% if (cryptoCards && cryptoCards.length > 0) { %>
      <% cryptoCards.forEach(function(c){ %>
        <div class="wallet-card">
          <div class="info">
            <div class="ic"><i class="fab fa-bitcoin"></i></div>
            <div><b><%= c.bank_name %></b><small><%= c.account_number %></small></div>
          </div>
          <form action="/profile/cards/delete/<%= c.id %>" method="POST" class="card-delete-form" data-confirm="<%= t('wd_confirm_delete') %>">
            <button type="submit" class="del"><i class="far fa-times-circle"></i></button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-wallet"><i class="fab fa-bitcoin rt2-3"></i><span>খালি ওয়ালেট তালিকা</span></div>
    <% } %>
  </div>

  <div class="instr">
    <p class="muted">উত্তোলন সময়: ২৪ ঘণ্টা</p>
    <p class="bold">💬 প্রিয় সদস্য, শুভেচ্ছা! 🎯</p>
    <p class="bold">আপনার <%= siteName %> অ্যাকাউন্টে উত্তোলনের আগে অনুগ্রহ করে আপনার ওয়ালেট (বিকাশ/নগদ/রকেট ইত্যাদি) সঠিকভাবে সংযুক্ত হয়েছে কিনা তা যাচাই করুন। ভুল ওয়ালেট সংযোগের কারণে টাকা স্থানান্তরে বিলম্ব বা ব্যর্থতা ঘটতে পারে।</p>
    <p class="bold">🔒 দয়া করে আবার পরীক্ষা করুন এবং নিরাপদে উত্তোলন সম্পন্ন করুন! 💰</p>
    <p class="muted">দৈনিক উত্তোলন ৯৯,৯৯৯ (বার), অবশিষ্ট উত্তোলন ৯৯,৯৯৯ (বার)</p>
    <p class="muted">প্রধান ওয়ালেট :৳ <span id="mainWalletAmt"><%= (coins || 0).toFixed(2) %></span></p>
    <p class="muted">উপলব্ধ পরিমাণ : ৳ <span id="availableAmt"><%= (coins || 0).toFixed(2) %></span></p>
    <button type="button" id="refreshBalanceBtn" class="refresh-btn"><i class="fas fa-sync-alt" id="refreshIcon"></i> আপনার ব্যালেন্স রিফ্রেশ করুন</button>
  </div>

  <%
    // সাবমিট বোতামের গেট। তিনটে শর্তের যেকোনো একটাতেই ফর্ম পাঠানো অর্থহীন,
    // কারণ সার্ভার নিশ্চিতভাবে বাতিল করবে: উইথড্র উইন্ডো বন্ধ, PIN সেট নেই,
    // অথবা কোনো সংরক্ষিত কার্ড/ওয়ালেট নেই (টাকা পাঠানোর গন্তব্যই নেই)।
    const windowClosed = typeof withdrawalWindow !== 'undefined' && withdrawalWindow && !withdrawalWindow.open;
    const noDestination = !((cards && cards.length) || (cryptoCards && cryptoCards.length));
    const formGated = windowClosed || !hasWithdrawPin || noDestination;
  %>
  <% if (!hasWithdrawPin) { %>
    <div class="instr rt2-4" id="pinNotConfiguredNotice">
      <p class="rt2-5">⚠️ উত্তোলনের আগে আপনার Withdraw PIN সেট করুন — <a class="rt2-6" href="/profile/security">এখানে সেট করুন</a></p>
    </div>
  <% } %>

  <form class="rt2-4" action="/payment/withdraw" method="POST" id="withdrawForm"
        data-loading-target="withdrawSubmitBtn" data-loading-label="<%= t('awd_sending') %>"
        data-confirm="<%= t('withdraw_submit_confirm') %>">
    <%
      // গন্তব্য শুধু সংরক্ষিত ওয়ালেট থেকেই বাছা যায়। আগে এখানে একটা খোলা
      // method dropdown আর হাতে-টাইপ করা account_number ছিল — অর্থাৎ
      // /profile/cards-এ যাচাই করা ওয়ালেটের বাইরে যেকোনো নম্বরে টাকা
      // পাঠানোর রিকোয়েস্ট করা যেত, আর টাইপো ধরার কোনো উপায় ছিল না।
      const withdrawWallets = [].concat(cards || [], cryptoCards || []);
    %>
    <div class="field-group">
      <label><%= t.select_ewallet %></label>
      <select id="walletSelect" name="wallet_id" required data-sync-wallet>
        <option value="" disabled<%= withdrawWallets.length ? '' : ' selected' %>><%= t.choose_linked_wallet %></option>
        <% withdrawWallets.forEach(function (c, i) {
             const bn = (c.bank_name || '').toLowerCase();
             let methodCode = 'bank';
             if (c.wallet_kind === 'crypto') methodCode = 'crypto';
             else if (bn.includes('bkash')) methodCode = 'bkash';
             else if (bn.includes('nagad')) methodCode = 'nagad';
             else if (bn.includes('rocket')) methodCode = 'rocket';
             else if (bn.includes('upay')) methodCode = 'upay';
        %>
          <option value="<%= c.id %>" data-method="<%= methodCode %>" data-number="<%= c.account_number %>"<%= i === 0 ? ' selected' : '' %>>
            <%= c.bank_name %> — <%= c.account_number %>
          </option>
        <% }) %>
      </select>
    </div>

    <%# সার্ভারে এই দুটোই যায়; ইউজার নিজে টাইপ করতে পারে না। %>
    <input type="hidden" name="method" id="methodField">
    <input type="hidden" name="account_number" id="accountNumberField">

    <div class="field-group">
      <label>পরিমাণ (১০০ ~ ৫০,০০০)</label>
      <input type="number" name="amount" placeholder="টাকার পরিমাণ লিখুন" min="100" max="50000" required>
    </div>

    <div class="field-group field-with-icon">
      <label>লেনদেন পাসওয়ার্ড</label>
      <input type="password" id="secPassword" name="password" placeholder="লেনদেন পাসওয়ার্ড" required>
      <button type="button" class="toggle-eye" data-reveal-field="secPassword" data-reveal-icon="eyeIcon"><i class="fas fa-eye-slash" id="eyeIcon"></i></button>
    </div>

    <% if (hasWithdrawPin) { %>
      <div class="field-group field-with-icon">
        <label>Withdraw PIN</label>
        <input type="password" id="withdrawPinField" name="withdraw_pin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" autocomplete="off" placeholder="আপনার ৬-ডিজিট Withdraw PIN দিন" required>
        <button type="button" class="toggle-eye" data-reveal-field="withdrawPinField" data-reveal-icon="withdrawPinEye"><i class="fas fa-eye-slash" id="withdrawPinEye"></i></button>
      </div>
      <p class="pin-note">🛈 প্রতিটি উত্তোলনের আগে আপনার Withdraw PIN যাচাই করা হবে।</p>
    <% } %>

    <% if (typeof withdrawalWindow !== 'undefined' && withdrawalWindow && !withdrawalWindow.open) { %>
      <div class="rounded-msg-box dep-section" role="alert">
        <i class="fas fa-triangle-exclamation"></i>
        <%= withdrawalWindow.reason === 'forced_closed' ? t('withdraw_window_closed_manual') : t('withdraw_window_closed_scheduled').replace('{start}', withdrawalWindow.start || '').replace('{end}', withdrawalWindow.end || '') %>
      </div>
    <% } %>

    <% if (noDestination) { %>
      <div class="rounded-msg-box dep-section" role="alert" id="noCardNotice">
        <i class="fas fa-triangle-exclamation"></i>
        <%= t('withdraw_no_saved_card') %>
      </div>
    <% } %>

    <button type="submit" id="withdrawSubmitBtn" class="submit-btn"<% if (formGated) { %> disabled<% } %>>উত্তোলন করুন</button>
  </form>
</div>

<script src="/js/payment-withdraw.js"></script>

<%- include('../partials/bottom-nav') %>
</body></html>

<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .instr-card {
    background: var(--bg-surface);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .fab-add {
    position: absolute;
    right: 20px;
    top: 180px;
    width: 50px;
    height: 50px;
    background: #e61e26;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 4px 10px rgba(230, 30, 38, 0.3);
    z-index: 10;
  }

  .input-field {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    font-size: 16px;
    background: var(--bg-surface);
    color: var(--text-main);
  }
  .input-field:focus {
    outline: none;
    border-color: #e61e26;
  }

  .delete-btn {
    color: #e61e26;
    font-size: 18px;
    cursor: pointer;
  }
</style>

<div class="min-h-screen pb-32 max-w-[480px] mx-auto relative bg-dark">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-4 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center gap-4">
        <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
        <h1 class="text-lg font-bold"><%= t.withdrawal %></h1>
    </div>
    <div class="flex gap-4">
        <i class="fas fa-file-alt text-xl"></i>
        <i class="fas fa-headset text-xl"></i>
    </div>
  </div>

  <!-- Sub Header / Tab -->
  <div class="bg-surface py-3 flex justify-center items-center gap-2 border-b-2 border-red-600 mb-4">
    <div class="w-8 h-8 bg-pink-600 rounded-lg flex items-center justify-center text-white text-xs">
        <i class="fas fa-wallet"></i>
    </div>
    <span class="text-red-600 font-bold">E wallet</span>
  </div>

  <!-- FAB Add -->
  <a href="/profile/cards" class="fab-add">
    <i class="fas fa-plus"></i>
  </a>

  <div class="px-4">

    <!-- Bound Wallet Section -->
    <div class="mb-6">
        <h2 class="text-muted font-bold mb-4"><%= t.linked_ewallet_count %> (<%= cards ? cards.length : 0 %>/5)</h2>

        <% if (cards && cards.length > 0) { %>
            <div class="space-y-3">
                <% cards.forEach(c => { %>
                    <div class="bg-surface rounded-xl p-4 border border-glass flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center text-red-600">
                                <i class="fas fa-university"></i>
                            </div>
                            <div>
                                <p class="font-bold text-sm text-main"><%= c.bank_name %></p>
                                <p class="text-xs text-muted"><%= c.account_number %></p>
                            </div>
                        </div>
                        <form action="/profile/cards/delete/<%= c.id %>" method="POST" data-confirm="আপনি কি নিশ্চিত?">
                            <button type="submit" class="delete-btn">
                                <i class="far fa-times-circle"></i>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center py-8">
                <img src="https://img.icons8.com/illustrations/64/credit-card.png" class="opacity-20 mb-2" alt="empty">
                <p class="text-gray-400 font-bold"><%= t.empty_ewallet %></p>
            </div>
        <% } %>
    </div>

    <!-- Instructions Section -->
    <div class="text-[13px] text-main leading-snug mb-6">
        <p class="text-muted mb-2"><%= t.withdrawal_time_24h %></p>
        <p class="font-bold mb-1"><%= t.dear_member_greeting %></p>
        <p class="font-bold mb-2"><%= t.your_word %><span class="red-theme-text uppercase"><%= siteName %></span> <%= t.withdraw_wallet_check_notice %></p>
        <p class="font-bold mb-4"><%= t.withdraw_double_check %></p>

        <div class="text-muted space-y-1">
            <p><%= t.daily_withdraw_limit %></p>
            <p><%= t.main_wallet_label %>৳ <%= (coins || 0).toFixed(2) %></p>
            <p><%= t.available_amount_label %> ৳ <%= (coins || 0).toFixed(2) %></p>
        </div>

        <button data-reload class="w-full mt-4 py-2.5 bg-blue-100 text-blue-600 rounded-full font-bold flex items-center justify-center gap-2 text-sm">
            <i class="fas fa-sync-alt"></i> <%= t.refresh_your_balance %>
        </button>
    </div>

    <% var locked = (typeof withdrawLock !== 'undefined') && withdrawLock && withdrawLock.allowed === false; %>
    <% var pinNotConfigured = (typeof pinStatus !== 'undefined') && pinStatus && !pinStatus.configured; %>
    <% var pinLocked = (typeof pinStatus !== 'undefined') && pinStatus && pinStatus.locked; %>

    <% if (pinNotConfigured) { %>
      <div class="rounded-xl p-4 mb-6" style="background: rgba(230,30,38,0.1); border: 1.5px solid #e61e26;">
        <div class="flex items-center gap-2 mb-2">
          <i class="fas fa-shield-alt red-theme-text"></i>
          <span class="font-bold red-theme-text"><%= t.withdraw_pin_required %></span>
        </div>
        <p class="text-sm text-main mb-3"><%= t.withdraw_pin_setup_notice %></p>
        <a href="/profile/security" class="inline-block red-theme-bg text-white font-bold px-5 py-2.5 rounded-full text-sm">
          <i class="fas fa-lock"></i> <%= t.create_pin_now %>
        </a>
      </div>
    <% } else if (pinLocked) { %>
      <div class="rounded-xl p-4 mb-6" style="background: rgba(230,30,38,0.1); border: 1.5px solid #e61e26;">
        <div class="flex items-center gap-2 mb-2">
          <i class="fas fa-lock red-theme-text"></i>
          <span class="font-bold red-theme-text"><%= t.withdraw_pin_locked %></span>
        </div>
        <p class="text-sm text-main"><%= t.pin_locked_retry %></p>
      </div>
    <% } %>

    <% if (locked) { %>
      <div class="rounded-xl p-4 mb-6" style="background: rgba(230,30,38,0.1); border: 1.5px solid #e61e26;">
        <div class="flex items-center gap-2 mb-2">
          <i class="fas fa-lock red-theme-text"></i>
          <span class="font-bold red-theme-text"><%= t.withdrawal_currently_locked %></span>
        </div>
        <p class="text-sm text-main mb-2"><%= t.withdraw_turnover_notice %></p>
        <div class="text-xs text-muted space-y-1">
          <% withdrawLock.pending.forEach(function(p) { %>
            <% if (p.sportsLeft > 0) { %><p><%= t.sports_turnover_left %>৳ <%= p.sportsLeft.toFixed(2) %></p><% } %>
            <% if (p.casinoLeft > 0) { %><p><%= t.casino_turnover_left %>৳ <%= p.casinoLeft.toFixed(2) %></p><% } %>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%
      // সময়সূচি অনুযায়ী উইথড্র বন্ধ থাকলে ফর্ম নিষ্ক্রিয় করা হয়। এটা নিছক
      // সুবিধা — আসল যাচাই সার্ভারে (middleware/withdrawalWindow.js), তাই
      // কেউ ফর্ম চালু করে পাঠালেও রিকোয়েস্ট গৃহীত হবে না।
      var ww = locals.withdrawalWindow || { open: true };
      var windowClosed = ww.open === false;
    %>
    <% if (windowClosed) { %>
      <div class="mx-4 mb-4 rounded-2xl border border-amber-400/40 bg-amber-400/10 p-4 text-sm text-amber-200" role="status">
        <div class="font-bold mb-1">
          <i class="fas fa-clock"></i> <%= t.withdraw_window_status_closed %>
        </div>
        <% if (ww.reason === 'scheduled_closed') { %>
          <%= t.withdraw_window_closed_scheduled.replace('{start}', ww.start).replace('{end}', ww.end) %>
        <% } else { %>
          <%= t.withdraw_window_closed_manual %>
        <% } %>
      </div>
    <% } %>

    <form action="/payment/withdraw" method="POST" id="withdrawForm" data-loading-target="withdrawSubmitBtn" data-loading-label="উইথড্র অনুরোধ পাঠানো হচ্ছে...">
      <!-- Withdrawal Form -->
      <% var formGated = locked || pinNotConfigured || pinLocked || windowClosed; %>
      <fieldset <%= formGated ? 'disabled' : '' %> class="space-y-5 <%= formGated ? 'opacity-50' : '' %>">

        <% if (!cards || cards.length === 0) { %>
          <div class="bg-surface border border-glass rounded-xl p-4 text-center">
            <p class="text-muted font-bold mb-3"><%= t.add_ewallet_first %></p>
            <a href="/profile/cards" class="inline-block red-theme-bg text-white font-bold px-5 py-2.5 rounded-full text-sm">
              <i class="fas fa-plus"></i> <%= t.add_ewallet %>
            </a>
          </div>
        <% } else { %>
          <div>
            <label class="block text-main font-bold mb-2"><%= t.select_ewallet %></label>
            <select id="walletSelect" class="w-full p-4 border-2 border-glass rounded-xl focus:outline-none bg-surface text-main font-bold" required data-sync-wallet>
              <option value="" disabled selected><%= t.choose_linked_wallet %></option>
              <% cards.forEach(c => {
                   const bn = (c.bank_name || '').toLowerCase();
                   let methodCode = 'bank';
                   if (bn.includes('bkash')) methodCode = 'bkash';
                   else if (bn.includes('nagad')) methodCode = 'nagad';
                   else if (bn.includes('rocket')) methodCode = 'rocket';
                   else if (bn.includes('upay')) methodCode = 'upay';
              %>
                <option value="<%= c.id %>" data-method="<%= methodCode %>" data-number="<%= c.account_number %>">
                  <%= c.bank_name %> — <%= c.account_number %>
                </option>
              <% }) %>
            </select>
            <p class="text-muted text-xs mt-2"><i class="fas fa-lock"></i> <%= t.ewallet_number_only_notice %> <a href="/profile/cards" class="red-theme-text font-bold"><%= t.ewallet %></a> <%= t.add_from_there %></p>
          </div>

          <!-- এই দুটো hidden ফিল্ড ই সার্ভারে পাঠানো হবে, ইউজার নিজে থেকে টাইপ করতে পারবে না -->
          <input type="hidden" name="method" id="methodField">
          <input type="hidden" name="account_number" id="accountNumberField">
        <% } %>

        <div>
          <label class="block text-main font-bold mb-2"><%= t.amount_range_label %></label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <span class="text-muted font-bold">৳</span>
            </div>
            <input type="number" name="amount" placeholder="<%= t.enter_amount %>" min="100" max="50000" class="w-full pl-10 p-4 border-2 border-glass rounded-xl focus:outline-none bg-surface text-lg font-bold text-red-600" required>
          </div>
        </div>

        <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-main"><%= t.password %></span>
            <input type="password" id="secPassword" name="password" placeholder="<%= t.password %>" class="input-field pl-24 text-right" required>
            <button type="button" data-reveal-field="secPassword" data-reveal-icon="eyeIcon" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted">
                <i class="fas fa-eye-slash" id="eyeIcon"></i>
            </button>
        </div>

        <div>
          <label class="block text-main font-bold mb-2"><i class="fas fa-shield-alt red-theme-text"></i> Withdraw PIN</label>
          <div class="relative">
              <input type="password" id="withdrawPinField" name="withdraw_pin" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" autocomplete="off" placeholder="<%= t.enter_6_digit_pin %>" class="input-field pr-12 text-right" style="letter-spacing:4px;" required>
              <button type="button" data-reveal-field="withdrawPinField" data-reveal-icon="withdrawPinEye" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted">
                  <i class="fas fa-eye-slash" id="withdrawPinEye"></i>
              </button>
          </div>
          <p class="text-muted text-xs mt-2"><i class="fas fa-info-circle"></i> <%= t.withdraw_pin_verify_notice %></p>
        </div>

        <button type="submit" id="withdrawSubmitBtn" <%= (!cards || cards.length === 0 || formGated) ? 'disabled' : '' %> class="w-full red-theme-bg text-white py-4 rounded-lg font-bold text-lg mt-6 shadow-lg active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
            <%= locked ? 'টার্নওভার সম্পন্ন করুন' : 'জমা দিন' %>
        </button>
      </fieldset>
    </form>
  </div>
</div>

<script src="/js/payment-withdraw.js"></script>

<%- include('../partials/bottom-nav') %>
</body></html>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('payadm_title') %> • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz91-1 { display: flex; justify-content: flex-end; margin-bottom: 14px; }
  .dz91-2 { align-items: center; gap: 10px; margin-bottom: 14px; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: 12px; padding: 10px 14px; }
  .dz91-3 { font-size: 12px; font-weight: 700; color: #f59e0b; }
  .dz91-4 { margin-left: auto; }
  .dz91-5 { overflow-x: auto; }
  .dz91-6 { text-align: right; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .pay-tabs { display: flex; gap: 4px; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 16px; }
    .pay-tab-btn {
      background: none; border: none; color: #94a3b8; font-size: 13px; font-weight: 700;
      padding: 10px 16px; cursor: pointer; border-bottom: 2px solid transparent; display: flex; align-items: center; gap: 6px;
    }
    .pay-tab-btn.active { color: #f59e0b; border-bottom-color: #f59e0b; }
    .pay-panel { display: none; }
    .pay-panel.active { display: block; }
    .pending-strip { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: 12px; padding: 10px 14px; margin-bottom: 14px; font-size: 12px; color: #f59e0b; font-weight: 700; }
  </style>

<!-- ==================== CSRF টোকেন ==================== -->
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
<script src="/js/csrf-inject.js"></script>
</head>
<body>
  <div class="admin-wrap">
    <%- include('../admin/partials/sidebar', { active: 'payments' }) %>
    <div class="admin-content">
      <%- include('../admin/partials/header', { pageTitle: t("payadm_page_title"), pageSubtitle: t("payadm_page_sub") }) %>
      <%- include('../admin/partials/load-error') %>

      <div class="dz91-1">
        <a href="/payment/admin/summary" class="btn"><i class="fas fa-chart-bar"></i> <%= t('payadm_history_link') %></a>
      </div>

      <div id="paymentBulkBar" class="hidden dz91-2">
        <span class="dz91-3"><span id="paymentBulkCount">0</span>টা <%= t('adb_requests_unit') %> নির্বাচিত</span>
        <button type="button" data-pay-bulk="approve" class="btn btn-sm btn-green dz91-4"><i class="fas fa-check"></i> <%= t('payadm_bulk_approve') %></button>
        <button type="button" data-pay-bulk="reject" class="btn btn-sm btn-red"><i class="fas fa-xmark"></i> <%= t('payadm_bulk_reject') %></button>
        <button type="button" data-pay-clear class="btn btn-sm"><%= t('dep_reject') %></button>
      </div>

      <div class="pay-tabs">
        <button class="pay-tab-btn active" data-pay-tab="0"><i class="fas fa-arrow-down"></i> <%= t('psum_col_deposit') %> <span id="depositCount" class="badge badge-amber"></span></button>
        <button class="pay-tab-btn" data-pay-tab="1"><i class="fas fa-arrow-up"></i> <%= t('psum_col_withdraw') %> <span id="withdrawCount" class="badge badge-amber"></span></button>
      </div>

      <!-- Deposits -->
      <div class="pay-panel active" id="pay-tab-0">
        <div id="depositPendingStrip"></div>
        <div class="admin-card">
          <div class="admin-card-header"><%= t('payadm_deposit_requests') %></div>
          <div class="dz91-5">
            <table class="admin-table" id="depositTable">
              <thead><tr><th><input type="checkbox" class="pay-select-all" data-table="depositTable" ></th><th><%= t('psum_col_user') %></th><th><%= t('payadm_col_method') %></th><th><%= t('dep_col_amount') %></th><th>TrxID</th><th><%= t('payadm_col_number') %></th><th><%= t('psum_col_date') %></th><th><%= t('dep_col_status') %></th><th class="dz91-6"><%= t('dep_col_action') %></th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Withdrawals -->
      <div class="pay-panel" id="pay-tab-1">
        <div id="withdrawPendingStrip"></div>
        <div class="admin-card">
          <div class="admin-card-header"><%= t('payadm_withdraw_requests') %></div>
          <div class="dz91-5">
            <table class="admin-table" id="withdrawTable">
              <thead><tr><th><input type="checkbox" class="pay-select-all" data-table="withdrawTable" ></th><th><%= t('psum_col_user') %></th><th><%= t('payadm_col_method') %></th><th><%= t('dep_col_amount') %></th><th>TrxID</th><th><%= t('payadm_col_number') %></th><th><%= t('psum_col_date') %></th><th><%= t('dep_col_status') %></th><th class="dz91-6"><%= t('dep_col_action') %></th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="paymentRequests"><%- jsonScriptSafe(requests || []) %></script>
  <script src="/js/payment-admin.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>পেমেন্ট ম্যানেজমেন্ট • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .pay-tabs { display: flex; gap: 4px; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 16px; }
    .pay-tab-btn {
      background: none; border: none; color: #94a3b8; font-size: 13px; font-weight: 700;
      padding: 10px 16px; cursor: pointer; border-bottom: 2px solid transparent; display: flex; align-items: center; gap: 6px;
    }
    .pay-tab-btn.active { color: #f59e0b; border-bottom-color: #f59e0b; }
    .pay-panel { display: none; }
    .pay-panel.active { display: block; }
    .pending-strip { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: 12px; padding: 10px 14px; margin-bottom: 14px; font-size: 12px; color: #f59e0b; font-weight: 700; }
  </style>

<!-- ==================== CSRF টোকেন ==================== -->
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
<script src="/js/csrf-inject.js"></script>
</head>
<body>
  <div class="admin-wrap">
    <%- include('../admin/partials/sidebar', { active: 'payments' }) %>
    <div class="admin-content">
      <%- include('../admin/partials/header', { pageTitle: 'পেমেন্ট অনুমোদন', pageSubtitle: 'পেন্ডিং ডিপোজিট ও উইথড্র রিকোয়েস্ট অনুমোদন/বাতিল করুন — এটাই একমাত্র অনুমোদন কিউ' }) %>
      <%- include('../admin/partials/load-error') %>

      <div style="display:flex;justify-content:flex-end;margin-bottom:14px;">
        <a href="/payment/admin/summary" class="btn"><i class="fas fa-chart-bar"></i> হিস্টোরি ও দৈনিক সামারি</a>
      </div>

      <div id="paymentBulkBar" class="hidden" style="align-items:center;gap:10px;margin-bottom:14px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:12px;padding:10px 14px;">
        <span style="font-size:12px;font-weight:700;color:#f59e0b;"><span id="paymentBulkCount">0</span>টা রিকোয়েস্ট নির্বাচিত</span>
        <button type="button" data-pay-bulk="approve" class="btn btn-sm btn-green" style="margin-left:auto;"><i class="fas fa-check"></i> নির্বাচিতগুলো অনুমোদন করুন</button>
        <button type="button" data-pay-bulk="reject" class="btn btn-sm btn-red"><i class="fas fa-xmark"></i> নির্বাচিতগুলো বাতিল করুন</button>
        <button type="button" data-pay-clear class="btn btn-sm">বাতিল</button>
      </div>

      <div class="pay-tabs">
        <button class="pay-tab-btn active" data-pay-tab="0"><i class="fas fa-arrow-down"></i> ডিপোজিট <span id="depositCount" class="badge badge-amber"></span></button>
        <button class="pay-tab-btn" data-pay-tab="1"><i class="fas fa-arrow-up"></i> উইথড্র <span id="withdrawCount" class="badge badge-amber"></span></button>
      </div>

      <!-- Deposits -->
      <div class="pay-panel active" id="pay-tab-0">
        <div id="depositPendingStrip"></div>
        <div class="admin-card">
          <div class="admin-card-header">ডিপোজিট রিকোয়েস্ট</div>
          <div style="overflow-x:auto;">
            <table class="admin-table" id="depositTable">
              <thead><tr><th><input type="checkbox" class="pay-select-all" data-table="depositTable" ></th><th>ইউজার</th><th>মেথড</th><th>পরিমাণ</th><th>TrxID</th><th>নম্বর</th><th>তারিখ</th><th>স্ট্যাটাস</th><th style="text-align:right;">অ্যাকশন</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Withdrawals -->
      <div class="pay-panel" id="pay-tab-1">
        <div id="withdrawPendingStrip"></div>
        <div class="admin-card">
          <div class="admin-card-header">উইথড্র রিকোয়েস্ট</div>
          <div style="overflow-x:auto;">
            <table class="admin-table" id="withdrawTable">
              <thead><tr><th><input type="checkbox" class="pay-select-all" data-table="withdrawTable" ></th><th>ইউজার</th><th>মেথড</th><th>পরিমাণ</th><th>TrxID</th><th>নম্বর</th><th>তারিখ</th><th>স্ট্যাটাস</th><th style="text-align:right;">অ্যাকশন</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="paymentRequests"><%- jsonScriptSafe(requests || []) %></script>
  <script src="/js/payment-admin.js"></script>
</body>
</html>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container page">
  <%- include('../partials/flash') %>
  <div class="card" style="max-width:500px;margin:0 auto;">
    <div class="card-header">💰 ডিপোজিট করুন</div>
    <div class="card-body">
      <div style="background:var(--card2);border-radius:10px;padding:1rem;margin-bottom:1.5rem;border:1px solid rgba(230,0,0,0.2);">
        <p style="color:var(--muted);font-size:.8rem;margin-bottom:.5rem;">নিচের নম্বরে টাকা পাঠান:</p>
        <p style="font-size:1.3rem;font-weight:800;color:var(--gold);letter-spacing:1px;"><%= payNumber %></p>
        <p style="font-size:.85rem;color:#fff;margin-top:.3rem;">📲 bKash Personal</p>
        <p style="font-size:.85rem;color:#fff;">📲 Nagad Personal</p>
        <p style="font-size:.85rem;color:#fff;">📲 Rocket Personal</p>
        <p style="font-size:.8rem;color:var(--muted);margin-top:.6rem;">⚠️ Send Money করুন, তারপর নিচের ফর্ম পূরণ করুন। প্রতিবার নতুন নম্বর আসতে পারে — যে নম্বর দেখছেন সেখানেই পাঠান।</p>
      </div>
      <form action="/payment/deposit" method="POST">
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);">পেমেন্ট মেথড</label>
          <select name="method" class="form-input">
            <option value="bkash">bKash</option>
            <option value="nagad">Nagad</option>
            <option value="rocket">Rocket</option>
          </select>
        </div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);">পরিমাণ (সর্বনিম্ন ১০০)</label>
          <input type="number" name="amount" class="form-input" placeholder="টাকার পরিমাণ" min="100" required>
        </div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);">ট্রানজেকশন আইডি</label>
          <input type="text" name="transaction_id" class="form-input" placeholder="TrxID লিখুন" required>
        </div>
        <div class="form-group" style="margin-bottom:1.5rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);">আপনার নম্বর (যেটা থেকে পাঠিয়েছেন)</label>
          <input type="text" name="account_number" class="form-input" placeholder="01XXXXXXXXX" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">✅ সাবমিট করুন</button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

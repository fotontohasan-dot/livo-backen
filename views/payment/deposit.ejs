<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body {
    background-color: #f8f9fa !important;
    color: #333 !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  input:focus {
    border-color: #e61e26 !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.1);
  }
  .step-2 { display: none; }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }
</style>

<div class="min-h-screen pb-32">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-3 flex items-center gap-4 sticky top-0 z-50">
    <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
    <h1 class="text-lg font-bold">জমা দিন (Deposit)</h1>
  </div>

  <div class="p-4 max-w-md mx-auto">
    <%- include('../partials/flash') %>

    <form action="/payment/deposit" method="POST" id="depositForm">

      <!-- Step 1: Method & Amount -->
      <div id="step1">
        <!-- Payment Method -->
        <div class="mb-6">
          <label class="block text-gray-700 font-bold mb-3">পেমেন্ট মেথড সিলেক্টর</label>
          <div class="grid grid-cols-2 gap-4">
            <!-- bKash -->
            <div id="method-bkash" class="method-card border-2 border-red-600 bg-red-50 rounded-xl p-3 flex flex-col items-center justify-center cursor-pointer transition-all" onclick="selectMethod('bkash')">
              <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR_Y05v4D0V5v5yX_K0Q9f-xKz9Kq5Y8Y1w5A&s" class="h-10 object-contain mb-1" alt="bKash" onerror="this.src='https://via.placeholder.com/40?text=bKash'">
              <span class="text-sm font-bold">bKash</span>
              <input type="radio" name="method" value="bkash" id="radio-bkash" class="hidden" checked>
            </div>
            <!-- Nagad -->
            <div id="method-nagad" class="method-card border-2 border-gray-200 bg-white rounded-xl p-3 flex flex-col items-center justify-center cursor-pointer transition-all" onclick="selectMethod('nagad')">
              <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Nagad_Logo.svg/1200px-Nagad_Logo.svg.png" class="h-10 object-contain mb-1" alt="Nagad" onerror="this.src='https://via.placeholder.com/40?text=Nagad'">
              <span class="text-sm font-bold">Nagad</span>
              <input type="radio" name="method" value="nagad" id="radio-nagad" class="hidden">
            </div>
          </div>
        </div>

        <!-- Payment Channel -->
        <div class="mb-6">
          <label class="block text-gray-700 font-bold mb-3">পেমেন্ট চ্যানেল</label>
          <div class="grid grid-cols-2 gap-3">
            <% ['চ্যানেল ১', 'চ্যানেল ৪', 'চ্যানেল ৫', 'চ্যানেল ১০'].forEach((ch, i) => { %>
              <button type="button"
                      class="channel-btn <%= i===0?'red-theme-bg text-white':'bg-white text-gray-700 border-gray-200' %> border-2 rounded-lg py-2 text-sm font-bold transition-all"
                      onclick="selectChannel(this)">
                <%= ch %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- Amount Selection -->
        <div class="mb-6">
          <label class="block text-gray-700 font-bold mb-3">অ্যামাউন্ট সিলেকশন (Fast Amount)</label>
          <div class="grid grid-cols-3 gap-2 mb-4">
            <% [100, 200, 500, 1000, 3000, 5000, 20000, 30000, 50000].forEach(amt => { %>
              <button type="button"
                      class="amount-btn border border-gray-300 rounded-md py-2 text-sm font-semibold bg-white hover:border-red-400 transition-all"
                      onclick="setAmount(<%= amt %>, this)">
                <%= amt %>
              </button>
            <% }) %>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-gray-500 font-bold">৳</span>
            </div>
            <input type="number" name="amount" id="amountInput" placeholder="১০০ ~ ৫০,০০০" min="100" max="50000" class="block w-full pl-8 pr-3 py-4 border-2 border-gray-200 rounded-xl text-lg font-bold text-red-600 focus:outline-none" required>
          </div>
        </div>

        <!-- Next Button -->
        <button type="button" onclick="goToStep2()" class="w-full red-theme-bg text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all mt-4">
          পরবর্তী (Next)
        </button>
      </div>

      <!-- Step 2: Confirmation & Instructions -->
      <div id="step2" class="step-2">
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm mb-6">
          <p class="text-gray-500 text-sm mb-2 text-center">নিচের নম্বরে টাকা পাঠান:</p>
          <div class="bg-gray-50 rounded-xl p-4 flex flex-col items-center">
            <span class="text-2xl font-black tracking-widest text-gray-800" id="displayNumber"><%= payNumber %></span>
            <button type="button" onclick="copyNumber()" class="mt-2 text-blue-600 text-xs font-bold uppercase"><i class="far fa-copy mr-1"></i> কপি করুন</button>
          </div>
          <div class="mt-4 space-y-2 text-sm text-gray-600 text-center">
            <p>📲 <span id="selectedMethodName">bKash</span> Personal</p>
            <p class="text-xs text-gray-400">⚠️ Send Money করুন, তারপর নিচের ফর্ম পূরণ করুন।</p>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-gray-700 font-bold mb-2">ট্রানজেকশন আইডি</label>
            <input type="text" name="transaction_id" placeholder="TrxID লিখুন" class="w-full p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white font-mono" required>
          </div>
          <div>
            <label class="block text-gray-700 font-bold mb-2">আপনার নম্বর (যেটা থেকে পাঠিয়েছেন)</label>
            <input type="text" name="account_number" placeholder="01XXXXXXXXX" class="w-full p-4 border-2 border-gray-200 rounded-xl focus:outline-none bg-white" required>
          </div>
        </div>

        <div class="mt-6 bg-orange-50 border border-orange-100 rounded-xl p-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="want_bonus" value="yes" class="mt-1 w-5 h-5 accent-red-600">
            <div>
              <span class="block font-bold text-orange-800 text-sm mb-1">🎁 ডিপোজিট বোনাস নিন</span>
              <span class="text-[10px] text-orange-700 leading-tight block">
                ১ম ডিপোজিট ১০০%, ২য় ডিপোজিট ৫০%, প্রতি শুক্রবার ৮০% রিলোড, এরপর সব ডিপোজিটে ১৫% বোনাস
                (সর্বোচ্চ ১৫,০০০)। বোনাস নিলে উত্তোলনের আগে টার্নওভার পূরণ করতে হবে (স্পোর্টস ৫x অথবা ক্যাসিনো ৩৫x)।
                বোনাস না নিলে কোনো শর্ত ছাড়াই উত্তোলন করতে পারবেন।
              </span>
            </div>
          </label>
        </div>

        <div class="flex gap-3 mt-8">
          <button type="button" onclick="goToStep1()" class="flex-1 bg-gray-200 text-gray-700 py-4 rounded-xl font-bold">পিছনে</button>
          <button type="submit" class="flex-[2] red-theme-bg text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
            সাবমিট করুন
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
  function selectMethod(method) {
    // Reset all method cards
    document.querySelectorAll('.method-card').forEach(c => {
      c.classList.remove('border-red-600', 'bg-red-50');
      c.classList.add('border-gray-200', 'bg-white');
    });

    // Set active method card
    const el = document.getElementById('method-' + method);
    el.classList.remove('border-gray-200', 'bg-white');
    el.classList.add('border-red-600', 'bg-red-50');

    // Check hidden radio
    document.getElementById('radio-' + method).checked = true;

    // Update display name in step 2
    document.getElementById('selectedMethodName').innerText = method.charAt(0).toUpperCase() + method.slice(1);
  }

  function selectChannel(el) {
    document.querySelectorAll('.channel-btn').forEach(b => {
      b.classList.remove('red-theme-bg', 'text-white');
      b.classList.add('bg-white', 'text-gray-700', 'border-gray-200');
    });
    el.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');
    el.classList.add('red-theme-bg', 'text-white');
  }

  function setAmount(amt, el) {
    document.getElementById('amountInput').value = amt;
    document.querySelectorAll('.amount-btn').forEach(b => {
      b.classList.remove('border-red-600', 'text-red-600', 'bg-red-50');
      b.classList.add('border-gray-300', 'bg-white', 'text-gray-700');
    });
    el.classList.remove('border-gray-300', 'bg-white', 'text-gray-700');
    el.classList.add('border-red-600', 'text-red-600', 'bg-red-50');
  }

  function goToStep2() {
    const amt = document.getElementById('amountInput').value;
    if(!amt || amt < 100) {
      alert('সর্বনিম্ন ১০০ টাকা জমা দিন');
      return;
    }
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    window.scrollTo(0,0);
  }

  function goToStep1() {
    document.getElementById('step1').style.display = 'block';
    document.getElementById('step2').style.display = 'none';
  }

  function copyNumber() {
    const num = document.getElementById('displayNumber').innerText;
    navigator.clipboard.writeText(num).then(() => {
        alert('নম্বর কপি হয়েছে: ' + num);
    });
  }
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

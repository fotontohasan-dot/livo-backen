<%- include('../partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Class selectors are repeated so the generated rules keep
     the specificity the inline declarations had, without !important —
     JS-set element.style still wins. */
  .rs3-1.rs3-1.rs3-1 { background:#F47321; }
  .rs3-2.rs3-2.rs3-2 { background:#D12053; }
  .rs3-3.rs3-3.rs3-3 { background:#6C2EB5; }
  .rs3-4.rs3-4.rs3-4 { background:#D4145A; }
  .rs3-5.rs3-5.rs3-5 { background:#8FCB2E; }
  .rs3-6.rs3-6.rs3-6 { background:#26A17B; }
  .rs3-7.rs3-7.rs3-7 { margin-top:18px; }
  .rs3-8.rs3-8.rs3-8 { color:var(--text-muted); font-size:13px; margin-bottom:10px; }
  .rs3-9.rs3-9.rs3-9 { margin-top:14px; font-size:13px; color:var(--text-muted); }
  .rs3-10.rs3-10.rs3-10 { font-size:12px; color:#f87171; }
</style>
<style nonce="<%= cspNonce %>">
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .dep-wrap { max-width: 480px; margin: 0 auto; padding-bottom: 110px; }
  .dep-topbar {
    background: #000; color: #fff; padding: 14px 16px; display: flex; align-items: center; gap: 14px;
    position: sticky; top: 0; z-index: 50;
  }
  .dep-topbar a { color: #fff; font-size: 18px; text-decoration: none; }
  .dep-topbar h1 { font-size: 16px; font-weight: 700; margin: 0; }

  .dep-section { padding: 16px 16px 0; }
  .dep-label { color: var(--text-muted); font-size: 13px; font-weight: 700; margin-bottom: 10px; }

  .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .method-tile {
    border: 2px solid var(--border-glass); border-radius: 12px; background: var(--bg-surface);
    padding: 10px 6px; text-align: center; cursor: pointer; position: relative;
  }
  .method-tile.selected { border-color: #e61e26; }
  .method-tile.selected::after {
    content: '✓'; position: absolute; top: -1px; right: -1px; background: #e61e26; color: #fff;
    width: 16px; height: 16px; border-radius: 0 10px 0 10px; font-size: 10px; line-height: 16px;
  }
  .method-icon { width: 44px; height: 44px; border-radius: 10px; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; font-size: 13px; }
  .method-name { font-size: 11px; font-weight: 700; color: var(--text-main); }

  .warn-box { background: transparent; border: none; color: #e61e26; font-size: 14px; font-weight: 600; padding: 0; margin: 16px; line-height: 1.7; }

  .rounded-msg-box { background: #fef2f2; color: #b91c1c; border-radius: 14px; padding: 12px 16px; font-size: 13px; font-weight: 600; margin: 16px; }

  .channel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .channel-btn {
    border: 2px solid var(--border-glass); background: var(--bg-surface); color: var(--text-main);
    border-radius: 10px; padding: 10px 4px; font-size: 13px; font-weight: 700; text-align: center; cursor: pointer;
  }
  .channel-btn.selected { background: var(--bg-surface); border-color: #e61e26; color: #e61e26; }

  .amount-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-bottom: 12px; }
  .amount-btn {
    border: 2px solid var(--border-glass); background: var(--bg-surface); color: var(--text-main);
    border-radius: 10px; padding: 10px 2px; font-size: 12px; font-weight: 700; text-align: center; cursor: pointer;
  }
  .amount-btn.selected { border-color: #e61e26; color: #e61e26; }

  .amount-input-wrap { position: relative; }
  .amount-input-wrap span { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--text-muted); }
  .amount-input {
    width: 100%; padding: 14px 14px 14px 30px; border: 2px solid var(--border-glass); border-radius: 14px;
    background: var(--bg-surface); color: var(--text-main); font-size: 16px; font-weight: 700;
  }
  .amount-input:focus { outline: none; border-color: #e61e26; }

  .activity-row { display: flex; align-items: center; gap: 10px; background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 12px; padding: 12px; margin-bottom: 8px; }
  .activity-row input[type=radio] { accent-color: #e61e26; width: 18px; height: 18px; }
  .activity-row .amt { margin-left: auto; color: var(--text-muted); font-size: 12px; white-space: nowrap; }

  .next-btn { display: block; width: calc(100% - 32px); margin: 20px 16px; background: #e61e26; color: #fff; border: none; padding: 15px; border-radius: 14px; font-size: 16px; font-weight: 800; }
  .next-btn:active { opacity: 0.9; }

  .step-2 { display: none; }
  .trx-box { background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 16px; padding: 18px; margin: 0 16px 16px; text-align: center; }
  .trx-number { font-size: 26px; font-weight: 900; letter-spacing: 2px; color: var(--text-main); }
  .copy-btn { margin-top: 10px; background: transparent; border: 1px solid var(--border-glass); color: #60a5fa; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; }
  .field-group { margin: 0 16px 16px; }
  .field-group label { display: block; font-weight: 700; margin-bottom: 6px; font-size: 14px; }
  .field-group input {
    width: 100%; padding: 13px; border: 2px solid var(--border-glass); border-radius: 14px;
    background: var(--bg-surface); color: var(--text-main); font-weight: 700;
  }
  .field-group input:focus { outline: none; border-color: #e61e26; }
  .step2-btns { display: flex; gap: 10px; margin: 16px; }
  .step2-btns button { flex: 1; padding: 15px; border-radius: 14px; font-weight: 800; font-size: 15px; border: none; }
  .btn-back { background: var(--bg-surface); color: var(--text-main); border: 1px solid var(--border-glass) !important; }
  .btn-submit { background: #e61e26; color: #fff; flex: 2 !important; }
</style>

<div class="dep-wrap">
  <div class="dep-topbar">
    <a href="/profile"><i class="fas fa-chevron-left"></i></a>
    <h1>জমা দিন</h1>
  </div>

  <%- include('../partials/flash') %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <!-- payment_methods ক্যোয়ারি ব্যর্থ হলে: আগে পেজ payNumber ছাড়াই নীরবে
         রেন্ডার হতো, ইউজার বুঝতে পারত না কেন নম্বর নেই। -->
    <div id="methodError" class="rounded-msg-box dep-section" role="alert">
      <i class="fas fa-triangle-exclamation"></i> <%= t('payment_methods_load_error') %>
    </div>
  <% } %>

  <form action="/payment/deposit" method="POST" id="depositForm">
    <input type="hidden" name="channel_id" id="channelIdInput" value="">
    <input type="hidden" name="method" id="methodInput" value="nagad">

    <div id="step1">
      <div class="dep-section">
        <div class="dep-label">আমানতের মোড</div>
        <div class="method-grid" id="methodGrid">
          <div class="method-tile selected" data-method="nagad">
            <div class="method-icon rs3-1">নগদ</div>
            <div class="method-name">NAGAD</div>
          </div>
          <div class="method-tile" data-method="bkash">
            <div class="method-icon rs3-2">bK</div>
            <div class="method-name">Bkash</div>
          </div>
          <div class="method-tile" data-method="rocket">
            <div class="method-icon rs3-3">RK</div>
            <div class="method-name">ROCKET</div>
          </div>
          <div class="method-tile" data-method="nagad" data-agent="1">
            <div class="method-icon rs3-1">SM</div>
            <div class="method-name">Send Money<br>Nagad</div>
          </div>
          <div class="method-tile" data-method="bkash" data-agent="1">
            <div class="method-icon rs3-2">SM</div>
            <div class="method-name">Send Money<br>Bkash</div>
          </div>
          <div class="method-tile" data-method="upay">
            <div class="method-icon rs3-4">Up</div>
            <div class="method-icon rs3-5">UP</div>
            <div class="method-name">Upay</div>
          </div>
          <div class="method-tile" data-method="crypto">
            <div class="method-icon rs3-6">₮</div>
            <div class="method-name">USDT<br>+5%</div>
          </div>
        </div>
      </div>

      <div class="warn-box">
        অনুগ্রহ করে আপনার (<span id="methodLabelText">Nagad</span>) একাউন্টের মাধ্যমে অর্থ স্থানান্তর করুন এবং পেমেন্ট পাতায় (TRX ID) অনুলিপি করে সঠিকভাবে পূরণ করুন।
        ⚠️⚠️⚠️ যদি আপনি (TRX ID) না লিখেন বা ভুল লিখেন, তাহলে আপনার লেনদেন সফলভাবে সম্পন্ন হবে না।
      </div>

      <div class="dep-section">
        <div class="dep-label">পেমেন্ট চ্যানেল</div>
        <div class="channel-grid" id="channelGrid"></div>
      </div>

      <div class="dep-section rs3-7">
        <div class="dep-label">জমা পরিমাণ</div>
        <div class="amount-grid" id="amountGrid">
          <% [100,200,300,500,1000,3000,5000,10000,20000,30000,50000].forEach(function(amt){ %>
            <div class="amount-btn <%= amt === 200 ? 'selected' : '' %>" data-amt="<%= amt %>"><%= amt.toLocaleString('en-US') %></div>
          <% }) %>
        </div>
        <div class="amount-input-wrap">
          <span>৳</span>
          <input type="number" name="amount" id="amountInput" class="amount-input" value="200" min="100" max="50000" placeholder="100 - 50,000" required>
        </div>
      </div>

      <div class="dep-section rs3-7">
        <div class="dep-label">কার্যক্রম</div>
        <label class="activity-row">
          <input type="radio" name="want_bonus_choice" value="bonus">
          <span>প্রথম জমার বোনাস সর্বোচ্চ ১০০% পর্যন্ত</span>
          <span class="amt">≥ ৳ 100.00</span>
        </label>
        <label class="activity-row">
          <input type="radio" name="want_bonus_choice" value="none" checked>
          <span>কোনও প্রচারে অংশ নেওয়া যায় না</span>
        </label>
        <input type="hidden" name="want_bonus" id="wantBonusHidden" value="no">
      </div>

      <button type="button" class="next-btn" id="depNextBtn">পরবর্তী (Next)</button>
    </div>

    <div id="step2" class="step-2">
      <div class="trx-box">
        <p class="rs3-8">নিচের নম্বরে টাকা পাঠান:</p>
        <div class="trx-number" id="displayNumber"><%= payNumber %></div>
        <button type="button" id="depCopyBtn" class="copy-btn"><i class="far fa-copy"></i> কপি করুন</button>
        <p class="rs3-9">📲 <b id="selectedMethodName">Nagad</b> Personal</p>
        <p class="rs3-10">⚠️ Send Money করুন, তারপর নিচের ফর্ম পূরণ করুন।</p>
      </div>

      <div class="field-group">
        <label>ট্রানজেকশন আইডি</label>
        <input type="text" name="transaction_id" placeholder="TrxID লিখুন" required>
      </div>
      <div class="field-group">
        <label>আপনার নম্বর (যেটা থেকে পাঠিয়েছেন)</label>
        <input type="text" name="account_number" placeholder="01XXXXXXXXX" required>
      </div>

      <div class="step2-btns">
        <button type="button" class="btn-back" id="depBackBtn">পিছনে</button>
        <button type="submit" class="btn-submit">সাবমিট করুন</button>
      </div>
    </div>
  </form>
</div>

<script nonce="<%= cspNonce %>">
  var CHANNELS_BY_METHOD = <%- JSON.stringify(channelsByMethod || {}) %>;
  var METHOD_LABELS = { nagad: 'Nagad', bkash: 'Bkash', rocket: 'Rocket', upay: 'Upay', crypto: 'USDT' };
  var currentMethod = 'nagad';

  function renderChannels(method) {
    var grid = document.getElementById('channelGrid');
    if (!grid) return;
    grid.innerHTML = '';
    var list = CHANNELS_BY_METHOD[method] || [];
    var idInput = document.getElementById('channelIdInput');
    if (!Array.isArray(list) || list.length === 0) {
      if (idInput) idInput.value = '';
    if (list.length === 0) {
      document.getElementById('channelIdInput').value = '';
      // আগে এখানে চুপচাপ কিছু না দেখিয়ে ফিরে যেত — ইউজারের কাছে মনে হতো
      // মেথড ট্যাপ করাই কাজ করছে না, কারণ কোনো নম্বর/চ্যানেল দেখাত না।
      var msg = document.createElement('div');
      msg.style.cssText = 'grid-column:1/-1; color:var(--text-muted); font-size:12px; padding:8px 0;';
      msg.textContent = 'এই মুহূর্তে এই মেথডের জন্য কোনো চ্যানেল উপলব্ধ নেই। অন্য মেথড বেছে নিন।';
      grid.appendChild(msg);
      document.getElementById('displayNumber').textContent = '—';
      return;
    }
    list.forEach(function (ch, idx) {
      // ডিফেন্সিভ: কোনো রো-তে id/label/number অনুপস্থিত থাকলে সেটা স্কিপ করা
      // হয় — আগে এখানে ch.channel_label/ch.id সরাসরি ব্যবহার হতো, একটা রো
      // malformed হলেই পুরো forEach থ্রো করত এবং ফাংশনটাই ব্যর্থ হয়ে যেত।
      if (!ch || ch.id === undefined || ch.id === null) return;
      var btn = document.createElement('div');
      btn.className = 'channel-btn' + (idx === 0 ? ' selected' : '');
      btn.textContent = ch.channel_label || '';
      btn.setAttribute('data-id', ch.id);
      btn.addEventListener('click', function () {
        document.querySelectorAll('.channel-btn').forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        if (idInput) idInput.value = ch.id;
        var disp = document.getElementById('displayNumber');
        if (disp) disp.textContent = ch.receive_number || '';
      });
      grid.appendChild(btn);
    });
    var first = list[0];
    if (first) {
      if (idInput) idInput.value = first.id != null ? first.id : '';
      var disp0 = document.getElementById('displayNumber');
      if (disp0) disp0.textContent = first.receive_number || '';
    }
  }

  function selectMethod(method, el) {
    currentMethod = method;
    document.querySelectorAll('.method-tile').forEach(function(t){ t.classList.remove('selected'); });
    el.classList.add('selected');
    document.getElementById('methodLabelText').textContent = METHOD_LABELS[method] || method;
    document.getElementById('selectedMethodName').textContent = METHOD_LABELS[method] || method;
    document.getElementById('methodInput').value = method; // পোস্ট বডিতে method আগে কখনো যেতোই না
    // renderChannels ব্যর্থ হলেও (অপ্রত্যাশিত ডেটা শেপ) মেথড সিলেকশন নিজে
    // যেন ভেঙে না যায় — এই try/catch না থাকলে একটা ব্যর্থ চ্যানেল-রেন্ডার
    // পুরো ট্যাপটাকেই "কাজ করছে না" বানিয়ে দিত।
    try { renderChannels(method); } catch (e) { /* channel UI silently skipped */ }
  }

  document.addEventListener('DOMContentLoaded', function(){
    // ==================== প্রতিটা ফিচার আলাদাভাবে বাইন্ড করা হচ্ছে ====================
    // আগে সব কটা হ্যান্ডলার একটাই try ছাড়া ব্লকে পরপর বাঁধা হতো — শুরুর দিকে
    // renderChannels('nagad') বা যেকোনো একটা getElementById কল ব্যর্থ/থ্রো
    // করলে (যেমন অপ্রত্যাশিত payment_channels ডেটা শেপ) পুরো
    // DOMContentLoaded কলব্যাক থেমে যেত, ফলে নিচের method-tile, amount-btn,
    // এবং depNextBtn — এই তিনটার কোনোটাই আর বাইন্ড হতো না। ইউজারের কাছে এটা
    // দেখাত যেন পেমেন্ট মেথড ট্যাপ, অ্যামাউন্ট সিলেক্ট, আর Next বাটন —
    // তিনটাই একসাথে "কাজ করছে না"। প্রতিটা ব্লক এখন নিজের try/catch-এ
    // আলাদা, তাই একটা ব্যর্থ হলেও বাকিগুলো ঠিকই কাজ করবে।
    try { renderChannels('nagad'); } catch (e) { console.error('renderChannels init error:', e); }

    try {
      document.querySelectorAll('.method-tile').forEach(function(tile){
        tile.addEventListener('click', function(){
          var method = tile.getAttribute('data-method');
          selectMethod(method, tile);
        });
      });
    } catch (e) { console.error('method-tile bind error:', e); }

    try {
      document.querySelectorAll('input[name="want_bonus_choice"]').forEach(function(radio){
        radio.addEventListener('click', function(){
          document.getElementById('wantBonusHidden').value = radio.value === 'bonus' ? 'yes' : 'no';
        });
      });
    } catch (e) { console.error('bonus radio bind error:', e); }

    try {
      document.querySelectorAll('.amount-btn').forEach(function(b){
        b.addEventListener('click', function(){
          document.getElementById('amountInput').value = b.getAttribute('data-amt');
          document.querySelectorAll('.amount-btn').forEach(function(x){ x.classList.remove('selected'); });
          b.classList.add('selected');
        });
      });
    } catch (e) { console.error('amount-btn bind error:', e); }

    try {
      var nextBtn = document.getElementById('depNextBtn');
      if (nextBtn) nextBtn.addEventListener('click', function(){
        var amt = document.getElementById('amountInput').value;
        if (!amt || amt < 100) { alert('সর্বনিম্ন ১০০ টাকা জমা দিন'); return; }
        document.getElementById('step1').style.display = 'none';
        document.getElementById('step2').style.display = 'block';
        window.scrollTo(0,0);
      });
    } catch (e) { console.error('next-btn bind error:', e); }

    try {
      var backBtn = document.getElementById('depBackBtn');
      if (backBtn) backBtn.addEventListener('click', function(){
        document.getElementById('step1').style.display = 'block';
        document.getElementById('step2').style.display = 'none';
      });
    } catch (e) { console.error('back-btn bind error:', e); }

    try {
      var copyBtn = document.getElementById('depCopyBtn');
      if (copyBtn) copyBtn.addEventListener('click', function(){
        var num = document.getElementById('displayNumber').textContent;
        navigator.clipboard.writeText(num).then(function(){ alert('নম্বর কপি হয়েছে: ' + num); });
      });
    } catch (e) { console.error('copy-btn bind error:', e); }
  });
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

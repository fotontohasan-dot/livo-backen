<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container page">
  <%- include('../partials/flash') %>
  <div class="card" style="max-width:500px;margin:0 auto;">
    <div class="card-header">💰 <%= t.deposit %></div>
    <div class="card-body">
      <div style="background:var(--card2);border-radius:10px;padding:1rem;margin-bottom:1.5rem;border:1px solid rgba(230,0,0,0.2);">
        <p style="color:var(--muted);font-size:.8rem;margin-bottom:.5rem;"><%= t.send_money_to %></p>
        <p style="font-size:1.3rem;font-weight:800;color:var(--gold);letter-spacing:1px;"><%= payNumber %></p>
        <p style="font-size:.85rem;color:#fff;margin-top:.3rem;">📲 bKash <%= t.personal %></p>
        <p style="font-size:.85rem;color:#fff;">📲 Nagad <%= t.personal %></p>
        <p style="font-size:.85rem;color:#fff;">📲 Rocket <%= t.personal %></p>
        <p style="font-size:.85rem;color:#fff;">📲 Upay <%= t.personal %></p>
        <p style="font-size:.8rem;color:var(--muted);margin-top:.6rem;"><%= t.send_money_warn %></p>
      </div>
      <form action="/payment/deposit" method="POST">
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);"><%= t.payment_method %></label>
          <select name="method" class="form-input">
            <option value="bkash">bKash</option>
            <option value="nagad">Nagad</option>
            <option value="rocket">Rocket</option>
            <option value="upay">Upay</option>
            <option value="bank"><%= t.bank_transfer %></option>
          </select>
        </div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);"><%= t.amount_min_100 %></label>
          <input type="number" name="amount" class="form-input" placeholder="<%= t.amount_placeholder %>" min="100" required>
        </div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);"><%= t.trx_id %></label>
          <input type="text" name="transaction_id" class="form-input" placeholder="<%= t.trx_id_placeholder %>" required>
        </div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="display:block;margin-bottom:.5rem;color:var(--muted);"><%= t.sender_number %></label>
          <input type="text" name="account_number" class="form-input" placeholder="<%= t.phone_placeholder %>" required>
        </div>

        <div style="background:rgba(245,158,11,0.08);border:1px solid var(--gold);border-radius:10px;padding:12px;margin-bottom:1.5rem;">
          <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
            <input type="checkbox" name="want_bonus" value="yes" style="margin-top:3px;width:18px;height:18px;">
            <span>
              <span style="font-weight:700;color:var(--gold);"><%= t.get_deposit_bonus %></span>
              <span style="display:block;font-size:.78rem;color:var(--muted);margin-top:3px;">
                <%= t.bonus_terms_msg %>
              </span>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">✅ <%= t.submit %></button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/bottom-nav') %>
</body></html>

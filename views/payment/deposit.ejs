<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  input:focus {
    border-color: #e61e26 !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.1);
  }
  .step-2 { display: none; }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .method-card {
    transition: all 0.2s ease;
    position: relative;
  }
  .method-card.selected {
    border-color: #e61e26 !important;
    background-color: rgba(230, 30, 38, 0.08) !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.25);
  }
  .method-card .check-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e61e26;
    color: #fff;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  }
  .method-card.selected .check-badge {
    display: flex;
  }

  .channel-btn {
    transition: all 0.2s ease;
    position: relative;
  }
  .channel-btn.selected {
    background-color: #e61e26 !important;
    color: #fff !important;
    border-color: #e61e26 !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.25);
  }

  .amount-btn {
    position: relative;
  }
  .amount-btn.selected {
    border-color: #e61e26 !important;
    color: #e61e26 !important;
    background-color: rgba(230, 30, 38, 0.08) !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.25);
  }
</style>

<div class="min-h-screen pb-32 text-main">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-4 flex items-center gap-4 sticky top-0 z-50 shadow-md">
    <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
    <h1 class="text-lg font-bold"><%= t.deposit_title %></h1>
  </div>

  <div class="p-4 max-w-[480px] mx-auto">

    <form action="/payment/deposit" method="POST" id="depositForm" data-loading-target="depSubmitBtn" data-loading-label="জমা হচ্ছে...">

      <input type="hidden" name="method" id="methodInput" value="">

      <!-- Step 1: Method & Amount -->
      <div id="step1">
        <!-- Payment Method -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]"><%= t.payment_method_selector %></label>
          <div class="grid grid-cols-2 gap-4" id="methodGrid"></div>
          <div id="methodEmpty" class="hidden rounded-2xl border border-glass bg-surface p-5 text-center text-sm text-muted">
            <%= t.no_payment_methods_user %>
          </div>
          <div id="methodError" class="<%= loadError ? '' : 'hidden' %> rounded-2xl border border-red-500/40 bg-red-500/10 p-5 text-center text-sm text-red-300" role="alert">
            <%= t.payment_methods_load_error %>
          </div>
          <div id="methodLoading" class="hidden rounded-2xl border border-glass bg-surface p-5 text-center text-sm text-muted">
            <i class="fas fa-circle-notch fa-spin"></i> <%= t.loading %>
          </div>
        </div>

        <!-- Payment Channel -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]"><%= t.payment_channel %></label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="channel-btn selected border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" data-select-channel><%= t.channel_1 %></button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" data-select-channel><%= t.channel_4 %></button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" data-select-channel><%= t.channel_5 %></button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" data-select-channel><%= t.channel_1 %>০</button>
          </div>
        </div>

        <!-- Amount Selection -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]"><%= t.fast_amount %></label>
          <div class="grid grid-cols-3 gap-2 mb-4">
            <% [100, 200, 500, 1000, 3000, 5000, 20000, 30000, 50000].forEach(amt => { %>
              <button type="button"
                      class="amount-btn border-2 border-glass rounded-lg py-3 text-[15px] font-bold bg-surface text-main transition-all <%= amt === 200 ? 'selected' : '' %>"
                                            data-amt="<%= amt %>">

                <%= amt %>
              </button>
            <% }) %>
          </div>
          <div class="relative mt-4">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="text-muted font-bold text-lg">৳</span>
            </div>
            <input type="number" name="amount" id="amountInput" value="200" placeholder="<%= t.amount_range_hint %>" min="100" max="50000" class="block w-full pl-10 pr-4 py-4 border-2 border-glass rounded-2xl text-lg font-bold text-main bg-surface focus:outline-none" required>
          </div>
        </div>

        <!-- Auto Pay (SSLCommerz — bKash/Nagad/Rocket/Card, অটোমেটিক) -->
        <div class="mt-4">
          <label class="flex items-center gap-2 mb-3 text-xs text-muted">
            <input type="checkbox" id="autoBonusCheck" value="yes" class="w-4 h-4 accent-red-600"> <%= t.with_bonus_turnover %>
          </label>
          <!-- বাটন + নিচের লাইনটা অস্থায়ীভাবে হাইড করা হয়েছে — প্রয়োজন হলে কমেন্ট খুলে দিলেই ফিরে আসবে
          <button type="button" id="autoPayBtn" class="w-full bg-green-600 text-white py-4 rounded-2xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
            ⚡ অটো পে (bKash/Nagad/Rocket/Card)
          </button>
          <p class="text-[11px] text-muted text-center mt-2">সরাসরি গেটওয়েতে পে করুন — সাথে সাথে কয়েন যোগ হবে, ম্যানুয়াল অপেক্ষা লাগবে না।</p>
          -->
        </div>

        <!-- Next Button (ম্যানুয়াল পদ্ধতি) -->
        <div class="mt-4">
                        <button type="button" id="depNextBtn" class="w-full bg-surface border-2 border-glass text-main py-4 rounded-2xl font-bold text-lg transition-all">

                <%= t.deposit_manually_next %>
            </button>
        </div>
      </div>

      <!-- Step 2: Confirmation & Instructions -->
      <div id="step2" class="step-2">
        <div class="bg-surface rounded-2xl p-6 border border-glass shadow-sm mb-6">
          <p class="text-muted text-sm mb-3 text-center"><%= t.send_money_to_number %></p>
          <div class="bg-dark rounded-2xl p-5 flex flex-col items-center border border-glass">
            <span class="text-2xl sm:text-3xl font-black tracking-wider text-main break-all text-center" id="displayNumber">—</span>
                        <button type="button" id="depCopyBtn" data-copied-label="<%= t.copied %>" class="mt-3 px-4 py-1 bg-surface border border-glass rounded-full text-blue-400 text-xs font-bold uppercase shadow-sm"><i class="far fa-copy mr-1"></i> <%= t.copy %></button>

          </div>
          <div class="mt-4 space-y-2 text-sm text-muted text-center">
            <p>📲 <span id="selectedMethodName" class="font-bold">bKash</span> Personal</p>
            <p class="text-xs text-red-400 font-medium"><%= t.send_money_first_notice %></p>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-main font-bold mb-2"><%= t.transaction_id %></label>
            <input type="text" name="transaction_id" placeholder="<%= t.enter_trxid %>" class="w-full p-4 border-2 border-glass rounded-2xl focus:outline-none bg-surface text-main font-mono font-bold" required>
          </div>
          <div>
            <label class="block text-main font-bold mb-2"><%= t.your_sending_number %></label>
            <input type="text" name="account_number" placeholder="01XXXXXXXXX" class="w-full p-4 border-2 border-glass rounded-2xl focus:outline-none bg-surface text-main font-bold" required>
          </div>
        </div>

        <div class="mt-6 bg-orange-50 border border-orange-100 rounded-2xl p-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="want_bonus" value="yes" class="mt-1 w-5 h-5 accent-red-600">
            <div>
              <span class="block font-bold text-orange-800 text-sm mb-1"><%= t.take_deposit_bonus %></span>
              <span class="text-[11px] text-orange-700 leading-relaxed block">
                <%= t.deposit_bonus_terms %>
              </span>
            </div>
          </label>
        </div>

        <div class="flex gap-3 mt-8">
                    <button type="button" id="depBackBtn" class="flex-1 bg-gray-200 text-gray-700 py-4 rounded-2xl font-bold"><%= t.back %></button>

          <button type="submit" id="depSubmitBtn" class="flex-[2] red-theme-bg text-white py-4 rounded-2xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
            <%= t.submit %>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script id="activeMethodsData" type="application/json"><%- JSON.stringify(activeMethods || []) %></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/views/payment-deposit.js"></script>

<%- include('../partials/bottom-nav') %>
</body></html>

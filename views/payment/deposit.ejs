<%- include('../partials/head') %>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');

  body {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
    font-family: 'Hind Siliguri', sans-serif;
  }
  .red-theme-bg { background-color: #e61e26; }
  .red-theme-text { color: #e61e26; }
  .red-theme-border { border-color: #e61e26; }

  input:focus {
    border-color: #e61e26 !important;
    box-shadow: 0 0 0 2px rgba(230, 30, 38, 0.1);
  }
  .step-2 { display: none; }

  .navbar, .bottom-nav {
    max-width: 480px;
    margin: 0 auto;
  }

  .method-card {
    transition: all 0.2s ease;
  }
  .method-card.selected {
    border-color: #e61e26;
    background-color: var(--bg-surface);
  }

  .channel-btn.selected {
    background-color: #e61e26;
    color: white;
    border-color: #e61e26;
  }

  .amount-btn.selected {
    border-color: #e61e26;
    color: #e61e26;
  }
</style>

<div class="min-h-screen pb-32 text-main">
  <!-- Top Bar -->
  <div class="red-theme-bg text-white px-4 py-4 flex items-center gap-4 sticky top-0 z-50 shadow-md">
    <a href="/profile" class="text-xl"><i class="fas fa-chevron-left"></i></a>
    <h1 class="text-lg font-bold">জমা দিন (Deposit)</h1>
  </div>

  <div class="p-4 max-w-[480px] mx-auto">
    <%- include('../partials/flash') %>

    <form action="/payment/deposit" method="POST" id="depositForm">

      <!-- Step 1: Method & Amount -->
      <div id="step1">
        <!-- Payment Method -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]">পেমেন্ট মেথড সিলেক্টর</label>
          <div class="grid grid-cols-2 gap-4">
            <!-- bKash -->
            <div id="method-bkash" class="method-card selected border-2 border-glass bg-surface rounded-2xl p-4 flex flex-col items-center justify-center cursor-pointer" onclick="selectMethod('bkash')">
              <div class="h-12 w-12 rounded-full bg-[#D12053] flex items-center justify-center mb-2 shadow-sm">
                <span class="text-white font-bold text-xl">b</span>
              </div>
              <span class="text-sm font-bold text-main">bKash</span>
              <input type="radio" name="method" value="bkash" id="radio-bkash" class="hidden" checked>
            </div>
            <!-- Nagad -->
            <div id="method-nagad" class="method-card border-2 border-glass bg-surface rounded-2xl p-4 flex flex-col items-center justify-center cursor-pointer" onclick="selectMethod('nagad')">
              <div class="h-12 w-12 rounded-full bg-[#F47321] flex items-center justify-center mb-2 shadow-sm">
                <span class="text-white font-bold text-xl">n</span>
              </div>
              <span class="text-sm font-bold text-main">Nagad</span>
              <input type="radio" name="method" value="nagad" id="radio-nagad" class="hidden">
            </div>
          </div>
        </div>

        <!-- Payment Channel -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]">পেমেন্ট চ্যানেল</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="channel-btn selected border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" onclick="selectChannel(this)">চ্যানেল ১</button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" onclick="selectChannel(this)">চ্যানেল ৪</button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" onclick="selectChannel(this)">চ্যানেল ৫</button>
            <button type="button" class="channel-btn border-2 border-glass bg-surface rounded-xl py-3 text-sm font-bold transition-all" onclick="selectChannel(this)">চ্যানেল ১০</button>
          </div>
        </div>

        <!-- Amount Selection -->
        <div class="mb-6">
          <label class="block text-muted font-bold mb-3 text-[15px]">অ্যামাউন্ট সিলেকশন (Fast Amount)</label>
          <div class="grid grid-cols-3 gap-2 mb-4">
            <% [100, 200, 500, 1000, 3000, 5000, 20000, 30000, 50000].forEach(amt => { %>
              <button type="button"
                      class="amount-btn border-2 border-glass rounded-lg py-3 text-[15px] font-bold bg-surface text-main transition-all <%= amt === 200 ? 'selected' : '' %>"
                                            data-amt="<%= amt %>">

                <%= amt %>
              </button>
            <% }) %>
          </div>
          <div class="relative mt-4">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="text-muted font-bold text-lg">৳</span>
            </div>
            <input type="number" name="amount" id="amountInput" value="200" placeholder="১০০ ~ ৫০,০০০" min="100" max="50000" class="block w-full pl-10 pr-4 py-4 border-2 border-glass rounded-2xl text-lg font-bold text-main bg-surface focus:outline-none" required>
          </div>
        </div>

        <!-- Auto Pay (SSLCommerz — bKash/Nagad/Rocket/Card, অটোমেটিক) -->
        <div class="mt-4">
          <label class="flex items-center gap-2 mb-3 text-xs text-muted">
            <input type="checkbox" id="autoBonusCheck" value="yes" class="w-4 h-4 accent-red-600"> বোনাস সহ (টার্নওভার প্রযোজ্য)
          </label>
          <button type="button" id="autoPayBtn" class="w-full bg-green-600 text-white py-4 rounded-2xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
            ⚡ অটো পে (bKash/Nagad/Rocket/Card)
          </button>
          <p class="text-[11px] text-muted text-center mt-2">সরাসরি গেটওয়েতে পে করুন — সাথে সাথে কয়েন যোগ হবে, ম্যানুয়াল অপেক্ষা লাগবে না।</p>
        </div>

        <!-- Next Button (ম্যানুয়াল পদ্ধতি) -->
        <div class="mt-4">
                        <button type="button" id="depNextBtn" class="w-full bg-surface border-2 border-glass text-main py-4 rounded-2xl font-bold text-lg transition-all">

                ম্যানুয়ালি জমা দিন (Next)
            </button>
        </div>
      </div>

      <!-- Step 2: Confirmation & Instructions -->
      <div id="step2" class="step-2">
        <div class="bg-surface rounded-2xl p-6 border border-glass shadow-sm mb-6">
          <p class="text-muted text-sm mb-3 text-center">নিচের নম্বরে টাকা পাঠান:</p>
          <div class="bg-dark rounded-2xl p-5 flex flex-col items-center border border-glass">
            <span class="text-3xl font-black tracking-widest text-main" id="displayNumber"><%= payNumber %></span>
                        <button type="button" id="depCopyBtn" class="mt-3 px-4 py-1 bg-surface border border-glass rounded-full text-blue-400 text-xs font-bold uppercase shadow-sm"><i class="far fa-copy mr-1"></i> কপি করুন</button>

          </div>
          <div class="mt-4 space-y-2 text-sm text-muted text-center">
            <p>📲 <span id="selectedMethodName" class="font-bold">bKash</span> Personal</p>
            <p class="text-xs text-red-400 font-medium">⚠️ Send Money করুন, তারপর নিচের ফর্ম পূরণ করুন।</p>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-main font-bold mb-2">ট্রানজেকশন আইডি</label>
            <input type="text" name="transaction_id" placeholder="TrxID লিখুন" class="w-full p-4 border-2 border-glass rounded-2xl focus:outline-none bg-surface text-main font-mono font-bold" required>
          </div>
          <div>
            <label class="block text-main font-bold mb-2">আপনার নম্বর (যেটা থেকে পাঠিয়েছেন)</label>
            <input type="text" name="account_number" placeholder="01XXXXXXXXX" class="w-full p-4 border-2 border-glass rounded-2xl focus:outline-none bg-surface text-main font-bold" required>
          </div>
        </div>

        <div class="mt-6 bg-orange-50 border border-orange-100 rounded-2xl p-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="want_bonus" value="yes" class="mt-1 w-5 h-5 accent-red-600">
            <div>
              <span class="block font-bold text-orange-800 text-sm mb-1">🎁 ডিপোজিট বোনাস নিন</span>
              <span class="text-[11px] text-orange-700 leading-relaxed block">
                ১ম ডিপোজিট ১০০%, ২য় ডিপোজিট ৫০%, প্রতি শুক্রবার ৮০% রিলোড, এরপর সব ডিপোজিটে ১৫% বোনাস
                (সর্বোচ্চ ১৫,০০০)। বোনাস নিলে উত্তোলনের আগে টার্নওভার পূরণ করতে হবে।
              </span>
            </div>
          </label>
        </div>

        <div class="flex gap-3 mt-8">
                    <button type="button" id="depBackBtn" class="flex-1 bg-gray-200 text-gray-700 py-4 rounded-2xl font-bold">পিছনে</button>

          <button type="submit" class="flex-[2] red-theme-bg text-white py-4 rounded-2xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-95 transition-all">
            সাবমিট করুন
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
  function selectMethod(method) {
    document.querySelectorAll('.method-card').forEach(c => {
      c.classList.remove('selected', 'border-red-600');
      c.classList.add('border-gray-200');
    });

    const el = document.getElementById('method-' + method);
    el.classList.add('selected', 'border-red-600');
    el.classList.remove('border-gray-200');

    document.getElementById('radio-' + method).checked = true;
    document.getElementById('selectedMethodName').innerText = method.charAt(0).toUpperCase() + method.slice(1);
  }

  function selectChannel(el) {
    document.querySelectorAll('.channel-btn').forEach(b => {
      b.classList.remove('selected');
    });
    el.classList.add('selected');
  }

  function setAmount(amt, el) {
    document.getElementById('amountInput').value = amt;
    document.querySelectorAll('.amount-btn').forEach(b => {
      b.classList.remove('selected');
    });
    el.classList.add('selected');
  }

  function goToStep2() {
    const amt = document.getElementById('amountInput').value;
    if(!amt || amt < 100) {
      alert('সর্বনিম্ন ১০০ টাকা জমা দিন');
      return;
    }
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    window.scrollTo(0,0);
  }

  function goToStep1() {
    document.getElementById('step1').style.display = 'block';
    document.getElementById('step2').style.display = 'none';
  }

    function copyNumber() {
    const num = document.getElementById('displayNumber').innerText;
    navigator.clipboard.writeText(num).then(() => {
        alert('নম্বর কপি হয়েছে: ' + num);
    });
  }

  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('.amount-btn').forEach(function(b){
      b.addEventListener('click', function(){ setAmount(parseInt(b.getAttribute('data-amt')), b); });
    });
        var nb = document.getElementById('depNextBtn');
    if (nb) nb.addEventListener('click', goToStep2);
    document.querySelectorAll('.channel-btn').forEach(function(b){
      b.addEventListener('click', function(){ selectChannel(b); });
    });
    var mb = document.getElementById('method-bkash');
    if (mb) mb.addEventListener('click', function(){ selectMethod('bkash'); });
    var mn = document.getElementById('method-nagad');
    if (mn) mn.addEventListener('click', function(){ selectMethod('nagad'); });
    var cb = document.getElementById('depCopyBtn');
    if (cb) cb.addEventListener('click', copyNumber);
    var bb = document.getElementById('depBackBtn');
    if (bb) bb.addEventListener('click', goToStep1);

    var apBtn = document.getElementById('autoPayBtn');
    if (apBtn) apBtn.addEventListener('click', function () {
      var amt = document.getElementById('amountInput').value;
      if (!amt || amt < 100) { alert('সর্বনিম্ন ১০০ টাকা জমা দিন'); return; }
      var wantBonus = document.getElementById('autoBonusCheck').checked ? 'yes' : 'no';
      var f = document.createElement('form');
      f.method = 'POST';
      f.action = '/payment/sslcommerz/init';
      f.innerHTML = '<input type="hidden" name="amount" value="' + amt + '">' +
                    '<input type="hidden" name="want_bonus" value="' + wantBonus + '">';
      document.body.appendChild(f);
      f.submit();
    });
  });
</script>

<%- include('../partials/bottom-nav') %>
</body></html>

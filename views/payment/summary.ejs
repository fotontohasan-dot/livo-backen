<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ডিপোজিট/উইথড্র সামারি • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; color: #e2e8f0; }
    .card { background: #171b23; border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; }
    .card-body { padding: 16px; }
    .table { color: #e2e8f0; }
    :root { --gold: #f59e0b; --muted: #94a3b8; --border: rgba(255,255,255,0.08); }
  </style>
</head>
<body>
<div class="admin-wrap">
  <%- include('../admin/partials/sidebar', { active: 'payments' }) %>
  <div class="admin-content">

    <div class="card" style="margin-bottom:1.5rem;">
      <div class="card-body">
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:1rem;">
          <a href="/payment/admin/summary?quick=today" class="btn" style="padding:6px 14px;font-size:.8rem;<%= quick==='today' ? 'background:var(--gold);color:#000;' : '' %>">আজ</a>
          <a href="/payment/admin/summary?quick=7d" class="btn" style="padding:6px 14px;font-size:.8rem;<%= quick==='7d' ? 'background:var(--gold);color:#000;' : '' %>">গত ৭ দিন</a>
          <a href="/payment/admin/summary?quick=30d" class="btn" style="padding:6px 14px;font-size:.8rem;<%= quick==='30d' ? 'background:var(--gold);color:#000;' : '' %>">গত ৩০ দিন</a>
          <a href="/payment/admin/summary?quick=all" class="btn" style="padding:6px 14px;font-size:.8rem;<%= quick==='all' ? 'background:var(--gold);color:#000;' : '' %>">সব সময়</a>
        </div>
        <form method="GET" action="/payment/admin/summary" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
          <input type="hidden" name="quick" value="custom">
          <label style="font-size:.8rem;color:var(--muted);">থেকে
            <input type="date" name="from" value="<%= from %>" style="margin-left:5px;padding:5px;border-radius:6px;background:#111;color:#fff;border:1px solid var(--border);">
          </label>
          <label style="font-size:.8rem;color:var(--muted);">পর্যন্ত
            <input type="date" name="to" value="<%= to %>" style="margin-left:5px;padding:5px;border-radius:6px;background:#111;color:#fff;border:1px solid var(--border);">
          </label>
          <button class="btn" style="padding:6px 14px;font-size:.8rem;background:var(--gold);color:#000;">দেখুন</button>
        </form>
        <div style="margin-top:.75rem;font-size:.8rem;color:var(--muted);">সময়সীমা: <%= from %> থেকে <%= to %> পর্যন্ত</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem;">
      <div class="card"><div class="card-body">
        <div style="font-size:.75rem;color:var(--muted);">মোট ডিপোজিট</div>
        <div style="font-size:1.4rem;font-weight:800;color:#10b981;">৳ <%= Number(grand.total_deposit).toLocaleString('en-BD') %></div>
        <div style="font-size:.7rem;color:var(--muted);"><%= grand.deposit_count %> টি লেনদেন</div>
      </div></div>
      <div class="card"><div class="card-body">
        <div style="font-size:.75rem;color:var(--muted);">মোট উইথড্র</div>
        <div style="font-size:1.4rem;font-weight:800;color:#ff4444;">৳ <%= Number(grand.total_withdraw).toLocaleString('en-BD') %></div>
        <div style="font-size:.7rem;color:var(--muted);"><%= grand.withdraw_count %> টি লেনদেন</div>
      </div></div>
      <div class="card"><div class="card-body">
        <div style="font-size:.75rem;color:var(--muted);">নেট (ডিপোজিট - উইথড্র)</div>
        <div style="font-size:1.4rem;font-weight:800;color: var(--text-accent);">৳ <%= Number(grand.total_deposit - grand.total_withdraw).toLocaleString('en-BD') %></div>
      </div></div>
    </div>

    <div class="card" style="margin-bottom:1.5rem;">
      <div class="card-body" style="overflow-x:auto;">
        <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">📅 দৈনিক হিসাব</h2>
        <table class="table" style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid var(--border);">
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">তারিখ</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">ডিপোজিট</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">উইথড্র</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">নেট</th>
            </tr>
          </thead>
          <tbody>
            <% if(daily && daily.length > 0) { %>
              <% daily.forEach(d => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:.6rem;font-weight:600;"><%= new Date(d.day).toLocaleDateString('bn-BD', {day:'2-digit', month:'short', year:'numeric'}) %></td>
                  <td style="padding:.6rem;color:#10b981;font-weight:700;">৳ <%= Number(d.deposit_total).toLocaleString('en-BD') %></td>
                  <td style="padding:.6rem;color:#ff4444;font-weight:700;">৳ <%= Number(d.withdraw_total).toLocaleString('en-BD') %></td>
                  <td style="padding:.6rem;color: var(--text-accent);font-weight:700;">৳ <%= Number(d.deposit_total - d.withdraw_total).toLocaleString('en-BD') %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" style="padding:1.5rem;text-align:center;color:var(--muted);">এই সময়ে কোনো লেনদেন নেই</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-body" style="overflow-x:auto;">
        <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">👥 ইউজার অনুযায়ী হিসাব</h2>
        <table class="table" style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid var(--border);">
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">ইউজার</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">মোট ডিপোজিট</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">মোট উইথড্র</th>
              <th style="padding:.6rem;text-align:left;color:var(--muted);font-size:.8rem;">নেট</th>
            </tr>
          </thead>
          <tbody>
            <% if(users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:.6rem;font-weight:600;"><%= u.username %></td>
                  <td style="padding:.6rem;color:#10b981;font-weight:700;">৳ <%= Number(u.total_deposit).toLocaleString('en-BD') %></td>
                  <td style="padding:.6rem;color:#ff4444;font-weight:700;">৳ <%= Number(u.total_withdraw).toLocaleString('en-BD') %></td>
                  <td style="padding:.6rem;color: var(--text-accent);font-weight:700;">৳ <%= Number(u.total_deposit - u.total_withdraw).toLocaleString('en-BD') %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" style="padding:1.5rem;text-align:center;color:var(--muted);">এই সময়ে কোনো ইউজার নেই</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body></html>

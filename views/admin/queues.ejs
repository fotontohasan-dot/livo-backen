<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Queue Dashboard • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }

    .redis-banner {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 12px;
      font-size: 12px; font-weight: 700; margin-bottom: 14px;
    }
    .redis-banner.up { background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }
    .redis-banner.down { background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }

    .queue-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 18px;
    }
    .queue-card {
      background: #171b23; border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 14px;
    }
    .queue-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .queue-card-name { font-size: 13px; font-weight: 800; color: #fff; text-transform: capitalize; }
    .queue-stat-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; text-align: center; }
    .queue-stat { padding: 6px 2px; border-radius: 8px; background: rgba(255,255,255,0.03); }
    .queue-stat-num { font-size: 15px; font-weight: 800; color: #fff; }
    .queue-stat-label { font-size: 8.5px; color: #94a3b8; text-transform: uppercase; margin-top: 2px; }
    .queue-stat.failed .queue-stat-num { color: #ef4444; }
    .queue-stat.active .queue-stat-num { color: #f59e0b; }
    .queue-stat.completed .queue-stat-num { color: #10b981; }
    .queue-stat.waiting .queue-stat-num { color: #38bdf8; }
    .queue-stat.delayed .queue-stat-num { color: #a78bfa; }

    .dlq-data { font-size: 10.5px; color: #94a3b8; max-width: 260px; white-space: normal; word-break: break-all; }
    .dlq-reason { font-size: 10.5px; color: #ef4444; max-width: 220px; white-space: normal; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'queues' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'Queue Dashboard', pageSubtitle: 'Background Job Queue — Health, Statistics ও Dead Letter Queue' }) %>

      <div id="redisBanner" class="redis-banner <%= health.redisConnected ? 'up' : 'down' %>">
        <i class="fas <%= health.redisConnected ? 'fa-check-circle' : 'fa-triangle-exclamation' %>"></i>
        <span id="redisBannerText">
          <%= health.redisConnected
            ? 'Redis সংযুক্ত — Background Queue System সচল আছে'
            : 'Redis সংযুক্ত নেই — সব Job আপাতত সরাসরি (inline fallback) মোডে চলছে' %>
        </span>
      </div>

      <div class="queue-grid" id="queueGrid">
        <% health.queues.forEach(q => { %>
          <div class="queue-card">
            <div class="queue-card-head">
              <div class="queue-card-name"><i class="fas fa-layer-group" style="color:#f59e0b;margin-right:6px;"></i><%= q.name.replace('-', ' ') %></div>
              <% if (q.paused) { %><span class="badge badge-amber">Paused</span><% } %>
            </div>
            <div class="queue-stat-row">
              <div class="queue-stat waiting"><div class="queue-stat-num"><%= q.counts.waiting || 0 %></div><div class="queue-stat-label">Waiting</div></div>
              <div class="queue-stat active"><div class="queue-stat-num"><%= q.counts.active || 0 %></div><div class="queue-stat-label">Active</div></div>
              <div class="queue-stat delayed"><div class="queue-stat-num"><%= q.counts.delayed || 0 %></div><div class="queue-stat-label">Delayed</div></div>
              <div class="queue-stat completed"><div class="queue-stat-num"><%= q.counts.completed || 0 %></div><div class="queue-stat-label">Done</div></div>
              <div class="queue-stat failed"><div class="queue-stat-num"><%= q.counts.failed || 0 %></div><div class="queue-stat-label">Failed</div></div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">
          <i class="fas fa-skull-crossbones" style="color:#ef4444;margin-right:6px;"></i>
          Dead Letter Queue — সব রিট্রাই শেষ হয়ে যাওয়া জব (<%= deadLetterJobs.length %>)
        </div>
        <% if (deadLetterJobs && deadLetterJobs.length > 0) { %>
          <div style="overflow-x:auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Queue</th><th>Job</th><th>Data</th><th>Reason</th><th>Attempts</th><th>সময়</th><th>অ্যাকশন</th>
                </tr>
              </thead>
              <tbody id="dlqTableBody">
                <% deadLetterJobs.forEach(j => { %>
                  <tr id="dlq-row-<%= j.id %>">
                    <td><span class="badge badge-amber"><%= j.queue_name %></span></td>
                    <td><%= j.job_name %></td>
                    <td class="dlq-data"><%= JSON.stringify(j.job_data) %></td>
                    <td class="dlq-reason"><%= (j.failed_reason || '').slice(0, 120) %></td>
                    <td><%= j.attempts_made %></td>
                    <td style="font-size:10px;color:#94a3b8;"><%= new Date(j.created_at).toLocaleString('bn-BD') %></td>
                    <td>
                      <button class="btn btn-sm btn-green" onclick="retryDlq(<%= j.id %>)"><i class="fas fa-redo"></i> রিট্রাই</button>
                      <button class="btn btn-sm btn-red" onclick="deleteDlq(<%= j.id %>)"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state"><i class="fas fa-circle-check" style="font-size:22px;color:#10b981;display:block;margin-bottom:8px;"></i>কোনো Dead Letter জব নেই — সব Queue পরিষ্কার আছে</div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // প্রতি ৫ সেকেন্ডে লাইভ স্ট্যাটাস রিফ্রেশ
    async function refreshQueueStats() {
      try {
        const res = await fetch('/admin/queues/api/stats');
        const j = await res.json();
        if (!j.success) return;
        const health = j.health;

        const banner = document.getElementById('redisBanner');
        const bannerText = document.getElementById('redisBannerText');
        banner.className = 'redis-banner ' + (health.redisConnected ? 'up' : 'down');
        bannerText.textContent = health.redisConnected
          ? 'Redis সংযুক্ত — Background Queue System সচল আছে'
          : 'Redis সংযুক্ত নেই — সব Job আপাতত সরাসরি (inline fallback) মোডে চলছে';

        const cards = document.querySelectorAll('.queue-card');
        health.queues.forEach((q, i) => {
          const card = cards[i];
          if (!card) return;
          const nums = card.querySelectorAll('.queue-stat-num');
          nums[0].textContent = q.counts.waiting || 0;
          nums[1].textContent = q.counts.active || 0;
          nums[2].textContent = q.counts.delayed || 0;
          nums[3].textContent = q.counts.completed || 0;
          nums[4].textContent = q.counts.failed || 0;
        });
      } catch (e) { /* silent */ }
    }
    setInterval(refreshQueueStats, 5000);

    async function retryDlq(id) {
      const res = await fetch('/admin/queues/dead-letter/' + id + '/retry', { method: 'POST' });
      const j = await res.json();
      if (j.success) {
        showAdminToast('জব আবার Queue-তে পাঠানো হয়েছে');
        const row = document.getElementById('dlq-row-' + id);
        if (row) row.remove();
      } else {
        showAdminToast('ব্যর্থ: ' + (j.error || 'অজানা সমস্যা'));
      }
    }

    async function deleteDlq(id) {
      if (!confirm('এই dead-letter জবটা স্থায়ীভাবে ডিলিট করবেন?')) return;
      const res = await fetch('/admin/queues/dead-letter/' + id + '/delete', { method: 'POST' });
      const j = await res.json();
      if (j.success) {
        showAdminToast('ডিলিট করা হয়েছে');
        const row = document.getElementById('dlq-row-' + id);
        if (row) row.remove();
      } else {
        showAdminToast('ব্যর্থ: ' + (j.error || 'অজানা সমস্যা'));
      }
    }
  </script>
</body>
</html>

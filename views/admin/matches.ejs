<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="admin-layout">
  <div class="admin-sidebar">
    <div style="padding:0 1.5rem 1rem;font-size:.75rem;color:var(--muted);text-transform:uppercase;">অ্যাডমিন প্যানেল</div>
    <a href="/admin" class="admin-nav-link">📊 ড্যাশবোর্ড</a>
    <a href="/admin/users" class="admin-nav-link">👥 ব্যবহারকারী</a>
    <a href="/admin/matches" class="admin-nav-link active">⚽ ম্যাচসমূহ</a>
    <a href="/admin/tournaments" class="admin-nav-link">🏆 টুর্নামেন্ট</a>
    <a href="/admin/news" class="admin-nav-link">📰 নিউজ</a>
    <a href="/chat/admin" class="admin-nav-link">💬 সাপোর্ট চ্যাট</a>
    <a href="/" class="admin-nav-link">🏠 সাইটে ফিরে যান</a>
  </div>
  <div class="admin-content">
    <%- include('../partials/flash') %>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
      <h1 style="font-size:1.5rem;font-weight:800;">⚽ ম্যাচ ম্যানেজমেন্ট</h1>
      <div style="display:flex;gap:0.5rem;">
        <form action="/admin/matches/sync" method="POST">
          <button type="submit" class="btn btn-outline">🔄 ম্যাচ সিঙ্ক করুন</button>
        </form>
        <button onclick="document.getElementById('addModal').style.display='flex'" class="btn btn-primary">+ নতুন ম্যাচ</button>
      </div>
    </div>
    <div class="card">
      <table class="table">
        <thead>
          <tr><th>ম্যাচ</th><th>স্পোর্টস</th><th>তারিখ</th><th>স্ট্যাটাস</th><th>ফলাফল</th><th>অ্যাকশন</th></tr>
        </thead>
        <tbody>
          <% matches.forEach(m => { %>
            <tr>
              <td style="font-weight:600"><%= m.team_a %> vs <%= m.team_b %></td>
              <td><%= m.sport %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= new Date(m.match_date).toLocaleString() %></td>
              <td><span class="status-badge status-<%= m.status %>"><%= m.status === 'upcoming' ? 'আসন্ন' : (m.status === 'live' ? 'লাইভ' : 'সম্পন্ন') %></span></td>
              <td><%= m.result || '-' %></td>
              <td>
                <% if(m.status !== 'completed') { %>
                  <button onclick="setResult(<%= m.id %>, '<%= m.team_a %>', '<%= m.team_b %>')" class="btn btn-sm btn-primary">ফলাফল দিন</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div id="addModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#00000080;z-index:999;align-items:center;justify-content:center;">
      <div class="card" style="width:480px;max-width:95vw;max-height:90vh;overflow-y:auto;">
        <div class="card-header">
          + নতুন ম্যাচ যোগ করুন
          <button onclick="document.getElementById('addModal').style.display='none'" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.2rem;">✕</button>
        </div>
        <div class="card-body">
          <div class="form-group"><label class="form-label">টাইটেল</label><input type="text" class="form-input" id="mTitle" placeholder="ম্যাচ টাইটেল"></div>
          <div class="form-group"><label class="form-label">স্পোর্টস</label><select class="form-input" id="mSport"><option value="football">ফুটবল</option><option value="cricket">ক্রিকেট</option><option value="basketball">বাস্কেটবল</option><option value="tennis">টেনিস</option></select></div>
          <div class="form-group"><label class="form-label">টিম এ</label><input type="text" class="form-input" id="mTeamA"></div>
          <div class="form-group"><label class="form-label">টিম বি</label><input type="text" class="form-input" id="mTeamB"></div>
          <div class="form-group"><label class="form-label">ম্যাচের তারিখ ও সময়</label><input type="datetime-local" class="form-input" id="mDate"></div>
          <div class="form-group"><label class="form-label">স্ট্রিম ইউআরএল (ঐচ্ছিক)</label><input type="text" class="form-input" id="mStream" placeholder="https://..."></div>
          <button onclick="submitMatch()" class="btn btn-primary">ম্যাচ তৈরি করুন</button>
        </div>
      </div>
    </div>

    <div id="resultModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#00000080;z-index:999;align-items:center;justify-content:center;">
      <div class="card" style="width:380px;">
        <div class="card-header">🏆 ফলাফল নির্ধারণ করুন</div>
        <div class="card-body">
          <div class="form-group">
            <label class="form-label">বিজয়ী</label>
            <select class="form-input" id="resultWinner">
              <option id="optA"></option>
              <option id="optB"></option>
              <option value="draw">ড্র (Draw)</option>
            </select>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="form-group"><label class="form-label">স্কোর এ</label><input type="number" class="form-input" id="scoreA" value="0"></div>
            <div class="form-group"><label class="form-label">স্কোর বি</label><input type="number" class="form-input" id="scoreB" value="0"></div>
          </div>
          <div style="display:flex;gap:.75rem;">
            <button onclick="submitResult()" class="btn btn-primary">ফলাফল সংরক্ষণ করুন</button>
            <button onclick="document.getElementById('resultModal').style.display='none'" class="btn btn-outline">বাতিল</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
let currentMatchId;
function submitMatch() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = '/admin/matches';
  [['title','mTitle'],['sport','mSport'],['team_a','mTeamA'],['team_b','mTeamB'],['match_date','mDate'],['stream_url','mStream']].forEach(([n,id]) => {
    const i = document.createElement('input');
    i.name = n; i.value = document.getElementById(id).value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
function setResult(id, teamA, teamB) {
  currentMatchId = id;
  document.getElementById('optA').value = teamA;
  document.getElementById('optA').textContent = teamA;
  document.getElementById('optB').value = teamB;
  document.getElementById('optB').textContent = teamB;
  document.getElementById('resultModal').style.display = 'flex';
}
function submitResult() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = `/admin/matches/${currentMatchId}/result`;
  [['result','resultWinner'],['score_a','scoreA'],['score_b','scoreB']].forEach(([n,id]) => {
    const i = document.createElement('input');
    i.name = n; i.value = document.getElementById(id).value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
</script>
</body></html>

<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Matches</h1>
        <p class="text-gray-400 text-sm mt-1">Manage all matches & markets</p>
      </div>
      <button onclick="document.getElementById('add-match-modal').classList.remove('hidden')" 
              class="px-5 py-2.5 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl flex items-center gap-2 text-sm">
        <i class="fas fa-plus"></i>
        <span>Add Match</span>
      </button>
    </div>

    <!-- Matches Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">Match</th>
            <th class="text-center px-4 py-4 font-normal">Sport</th>
            <th class="text-center px-4 py-4 font-normal">Start Time</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% matches.forEach(m => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4">
              <div class="font-semibold text-white"><%= m.team_a %> vs <%= m.team_b %></div>
              <div class="text-xs text-gray-500"><%= m.title || '' %></div>
            </td>
            <td class="px-4 py-4 text-center">
              <span class="px-3 py-1 text-xs rounded-full bg-[#334155]"><%= m.sport || 'N/A' %></span>
            </td>
            <td class="px-4 py-4 text-center text-xs">
              <%= m.start_time ? new Date(m.start_time).toLocaleString() : 'Not set' %>
            </td>
            <td class="px-4 py-4 text-center">
              <% if(m.status === 'live') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">Live</span>
              <% } else if(m.status === 'upcoming') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/20 text-yellow-400">Upcoming</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-gray-500/20 text-gray-400">Completed</span>
              <% } %>
            </td>
            <td class="px-6 py-4">
              <div class="flex justify-center gap-2">
                <a href="/admin/markets/<%= m.id %>" class="px-3 py-1.5 bg-[#334155] hover:bg-[#475569] rounded-xl text-xs">Markets</a>
                <form action="/admin/matches/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Delete this match?')">
                  <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 rounded-xl text-xs text-white">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Add Match Modal -->
    <div id="add-match-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
      <div class="bg-[#1e2937] rounded-3xl p-8 w-full max-w-md border border-[#334155]">
        <h3 class="text-xl font-bold text-white mb-6">Add New Match</h3>
        
        <form action="/admin/matches/add" method="POST">
          <div class="space-y-4">
            <div>
              <label class="text-sm text-gray-400 block mb-1">Team A</label>
              <input type="text" name="team_a" required class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Team B</label>
              <input type="text" name="team_b" required class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Sport</label>
              <input type="text" name="sport" value="cricket" class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Start Time</label>
              <input type="datetime-local" name="start_time" class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
          </div>

          <div class="flex gap-3 mt-8">
            <button type="button" onclick="document.getElementById('add-match-modal').classList.add('hidden')"
                    class="flex-1 py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm">Cancel</button>
            <button type="submit" class="flex-1 py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl">Add Match</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

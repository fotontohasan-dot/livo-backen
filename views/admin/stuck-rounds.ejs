<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
// ⚠️ কোনো সিক্রেট/ব্যক্তিগত তথ্য নেই: শুধু ইউজার আইডি, প্রোভাইডার, রাউন্ড আইডি, স্টেক, আটকে থাকার সময়।
const res = (typeof result !== 'undefined' && result) || { hours: 6, count: 0, totalStake: 0, unmatchable: 0, rounds: [] };
const dur = (sec) => { const s = Math.max(0, Math.floor(Number(sec) || 0)); return Math.floor(s / 3600) + 'h ' + String(Math.floor((s % 3600) / 60)).padStart(2, '0') + 'm'; };
const rows = res.rounds.map((r) =>
  '<tr class="border-t border-slate-100"><td class="px-4 py-3 text-sm">' + escapeHtml(r.userId) + '</td>' +
  '<td class="px-4 py-3 text-sm">' + escapeHtml(r.provider) + '</td>' +
  '<td class="px-4 py-3 text-sm font-mono break-all">' + escapeHtml(r.roundId) + '</td>' +
  '<td class="px-4 py-3 text-sm">' + escapeHtml(r.stake) + '</td>' +
  '<td class="px-4 py-3 text-sm">' + escapeHtml(dur(r.stuckSeconds)) + '</td></tr>').join('');
const badge = res.count > 0
  ? '<span class="px-3 py-1 rounded-xl text-sm font-semibold bg-red-50 text-red-600">' + escapeHtml(res.count) + '</span>'
  : '<span class="px-3 py-1 rounded-xl text-sm font-semibold bg-emerald-50 text-emerald-700">0</span>';
%>
<%- include('partials/admin-layout', {
    title: 'Stuck casino rounds',
    active: 'integrations',
    body: `
<div class="max-w-7xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">${t('scr_title')}</h1>
    <p class="text-slate-500 mt-1 text-sm">${t('scr_subtitle').replace('{hours}', escapeHtml(res.hours))}</p>
  </div>
  ${typeof loadError !== 'undefined' && loadError ? '<div class="mb-6 px-4 py-3 rounded-2xl bg-red-50 text-red-700 text-sm">' + t('scr_load_error') + '</div>' : ''}
  <div class="bg-white rounded-3xl border border-slate-100 p-6 mb-6">
    <div class="text-sm text-slate-500">${t('scr_count')}</div>
    <div class="mt-2">${badge}</div>
    <div class="text-xs text-slate-500 mt-3">${t('scr_total_stake')}: ${escapeHtml(res.totalStake)}</div>
    ${res.unmatchable ? '<div class="text-xs text-amber-700 mt-1">' + t('scr_unmatchable') + ': ' + escapeHtml(res.unmatchable) + '</div>' : ''}
  </div>
  <div class="bg-white rounded-3xl border border-slate-100 overflow-x-auto">
    <table class="w-full">
      <thead class="bg-slate-50"><tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">${t('scr_col_user')}</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">${t('scr_col_provider')}</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">${t('scr_col_round')}</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">${t('scr_col_stake')}</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">${t('scr_col_stuck')}</th>
      </tr></thead>
      <tbody>${rows || '<tr><td colspan="5" class="px-6 py-8 text-center text-sm text-slate-400">' + t('scr_none') + '</td></tr>'}</tbody>
    </table>
  </div>
</div>
`
}) %>

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('admin_title_backup_codes') %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }
        .admin-card { box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.4); }
    </style>

<!-- ==================== CSRF টোকেন ==================== -->
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
<script src="/js/csrf-inject.js"></script>
  <script src="/js/ui-hooks.js" defer></script>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-emerald-600 rounded-2xl mb-4">
                <i class="fas fa-check text-white text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-white"><%= t('admin_2fa_enabled_heading') %></h1>
            <p class="text-slate-400 mt-2 text-sm"><%= t('admin_2fa_backup_intro') %></p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-3xl p-8 admin-card space-y-6">
            <div class="bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-3 rounded-2xl text-sm flex items-start gap-3">
                <i class="fas fa-triangle-exclamation mt-0.5"></i>
                <span><%= t('admin_2fa_each_code') %> <b><%= t('admin_2fa_only_once') %></b> <%= t('admin_2fa_codes_warning') %></span>
            </div>

            <div class="grid grid-cols-2 gap-3 font-mono text-sm">
                <% codes.forEach(code => { %>
                    <div class="bg-slate-900 border border-slate-700 rounded-xl py-3 text-center text-blue-300"><%= code %></div>
                <% }) %>
            </div>

            <button data-copy-all id="copyBtn"
                class="w-full bg-slate-700 hover:bg-slate-600 transition-all text-white font-semibold py-3 rounded-2xl text-sm flex items-center justify-center gap-2">
                <i class="fas fa-copy"></i> <%= t('admin_2fa_copy_all') %>
            </button>

            <form method="POST" action="/admin/2fa/backup-codes/acknowledge">
                <button type="submit"
                    class="block text-center w-full bg-blue-600 hover:bg-blue-700 transition-all text-white font-semibold py-3.5 rounded-2xl text-base shadow-lg shadow-blue-600/30">
                    <%= t('admin_2fa_saved_ack') %>
                </button>
            </form>
        </div>
    </div>

    <script type="application/json" id="admin-2fa-backup-codesConfig"><%- jsonScriptSafe({ codes: codes }) %></script>
<script src="/js/views/admin-2fa-backup-codes.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_contest_payouts') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'leaderboard' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'রেফারেল কনটেস্ট পেআউট', pageSubtitle: 'মাসিক টপ-৫ বিজয়ীর প্রাইজ প্রদানের অবস্থা ও হিস্ট্রি' }) %>

      <% if (saved) { %>
        <div class="admin-card" style="padding:12px 16px;margin-bottom:14px;background:rgba(16,185,129,0.1);border-color:rgba(16,185,129,0.3);color:#10b981;font-weight:700;font-size:13px;">
          <i class="fas fa-check-circle"></i> <%= t('admin_msg_updated_successfully') %>
        </div>
      <% } %>
      <% if (saveError) { %>
        <div class="admin-card" style="padding:12px 16px;margin-bottom:14px;background:rgba(239,68,68,0.1);border-color:rgba(239,68,68,0.3);color:#ef4444;font-weight:700;font-size:13px;">
          <i class="fas fa-circle-exclamation"></i> <%= saveError %>
        </div>
      <% } %>

      <div class="admin-card" style="padding:14px;margin-bottom:14px;">
        <form method="GET" action="/admin/leaderboard/contest/payouts" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
          <label style="font-size:12px;color:var(--text-muted);"><%= t('admin_label_months_ago') %></label>
          <select class="select" style="max-width:160px;" name="months" data-auto-submit>
            <% for (let i = 1; i <= 12; i++) { %>
              <option value="<%= i %>" <%= monthsBack === i ? 'selected' : '' %>><%= i %> মাস আগে</option>
            <% } %>
          </select>
          <span style="font-size:13px;color:var(--text-muted);font-weight:600;"><%= monthName || '—' %></span>
          <a class="btn btn-sm" href="/admin/leaderboard" style="margin-left:auto;"><i class="fas fa-arrow-left"></i> <%= t('admin_back_to_leaderboard') %></a>
        </form>
      </div>

      <div class="admin-card" style="margin-bottom:20px;">
        <div class="admin-card-header"><%= monthName || '—' %> — টপ ৫ বিজয়ী</div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th><%= t('admin_col_rank') %></th>
                <th><%= t('admin_col_user') %></th>
                <th><%= t('admin_col_referrals') %></th>
                <th><%= t('admin_col_prize') %></th>
                <th><%= t('admin_col_status') %></th>
                <th><%= t('admin_payout_details') %></th>
                <th style="text-align:right;"><%= t('admin_col_action') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (payouts && payouts.length > 0) { %>
                <% payouts.forEach(p => { %>
                  <tr>
                    <td class="lb-rank">#<%= p.rank %></td>
                    <td>@<%= p.username || '—' %></td>
                    <td><%= p.referrals_count %></td>
                    <td><%= p.prize_label || '—' %></td>
                    <td>
                      <% if (p.status === 'paid') { %>
                        <span class="badge badge-green"><%= t('admin_status_paid') %></span>
                      <% } else { %>
                        <span class="badge badge-amber"><%= t('admin_status_unpaid') %></span>
                      <% } %>
                    </td>
                    <td style="font-size:11px;color:var(--text-muted);">
                      <% if (p.status === 'paid') { %>
                        <%= p.paid_at ? new Date(p.paid_at).toLocaleString('bn-BD') : '—' %><br>
                        by <%= p.paid_by_username || '—' %>
                        <% if (p.notes) { %><br>নোট: <%= p.notes %><% } %>
                      <% } else { %>—<% } %>
                    </td>
                    <td style="text-align:right;white-space:nowrap;">
                      <% if (p.status === 'pending') { %>
                        <button type="button" class="btn btn-sm btn-green" data-markpaid-id="<%= p.id %>" data-markpaid-name="<%= p.username || '' %>"><i class="fas fa-check"></i> <%= t('admin_btn_mark_paid') %></button>
                      <% } else { %>
                        <span style="color:var(--text-muted);font-size:11px;"><%= t('admin_label_final') %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7"><div class="empty-state"><%= t('admin_empty_month_winners') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="admin-card">
        <div class="admin-card-header"><%= t('admin_payout_history_heading') %></div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr><th><%= t('admin_col_month') %></th><th><%= t('admin_col_rank') %></th><th><%= t('admin_col_user') %></th><th><%= t('admin_col_prize') %></th><th><%= t('admin_col_payout_date') %></th><th><%= t('admin_col_admin') %></th></tr>
            </thead>
            <tbody>
              <% if (history && history.length > 0) { %>
                <% history.forEach(h => { %>
                  <tr>
                    <td><%= h.contest_month %></td>
                    <td>#<%= h.rank %></td>
                    <td>@<%= h.username || '—' %></td>
                    <td><%= h.prize_label || '—' %></td>
                    <td><%= h.paid_at ? new Date(h.paid_at).toLocaleString('bn-BD') : '—' %></td>
                    <td><%= h.paid_by_username || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6"><div class="empty-state"><%= t('admin_empty_payouts') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <!-- Mark Paid Modal -->
  <div class="modal-overlay" id="markPaidModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3><%= t('admin_confirm_prize_heading') %></h3>
        <button class="modal-close" data-modal-close="markPaidModal"><i class="fas fa-times"></i></button>
      </div>
      <form method="POST" id="markPaidForm">
        <div class="modal-body">
          <p style="font-size:13px;color:var(--text-muted);margin-top:0;"><span id="markPaidUsername"></span> <%= t('admin_confirm_prize_note') %></p>
          <textarea class="input" name="notes" rows="2" placeholder="<%= t('admin_field_note_optional_trx') %>"></textarea>
          <input type="hidden" name="months" value="<%= monthsBack %>">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn" data-modal-close="markPaidModal"><%= t('admin_btn_cancel') %></button>
          <button type="submit" class="btn btn-green"><i class="fas fa-check"></i> <%= t('admin_btn_confirm') %></button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/views/admin-contest-payouts.js"></script>
</body>
</html>

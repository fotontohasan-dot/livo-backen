<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users • Livo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background-color: #0f172a; }
        .admin-card { transition: all 0.2s ease; }
        .admin-card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); }
        .table-row:hover { background-color: #1e293b; }
        .modern-badge { font-size: 0.75rem; padding: 0.25rem 0.75rem; border-radius: 9999px; }
    </style>
</head>
<body class="bg-slate-950 text-slate-200">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <%- include('../../partials/sidebar', { activePage: 'users' }) %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header -->
            <%- include('../../partials/header', { 
                pageTitle: 'Users', 
                pageSubtitle: 'Manage all registered users' 
            }) %>

            <!-- Main Content Area -->
            <div class="flex-1 overflow-y-auto p-6">
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 admin-card">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Total Users</p>
                                <p class="text-3xl font-bold text-white mt-1"><%= totalUsers || 1248 %></p>
                            </div>
                            <div class="w-12 h-12 bg-blue-600/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-users text-blue-500 text-2xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 admin-card">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Active Users</p>
                                <p class="text-3xl font-bold text-emerald-400 mt-1"><%= activeUsers || 987 %></p>
                            </div>
                            <div class="w-12 h-12 bg-emerald-600/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-user-check text-emerald-500 text-2xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 admin-card">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Banned Users</p>
                                <p class="text-3xl font-bold text-red-400 mt-1"><%= bannedUsers || 45 %></p>
                            </div>
                            <div class="w-12 h-12 bg-red-600/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-user-slash text-red-500 text-2xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 admin-card">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">New Today</p>
                                <p class="text-3xl font-bold text-amber-400 mt-1"><%= newToday || 23 %></p>
                            </div>
                            <div class="w-12 h-12 bg-amber-600/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-user-plus text-amber-500 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search + Filter + Export -->
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                    <div class="flex-1 w-full md:w-auto">
                        <div class="relative">
                            <input type="text" id="searchInput" placeholder="Search by name, email or phone..." 
                                   class="w-full bg-slate-900 border border-slate-700 text-white pl-11 pr-4 py-3 rounded-2xl focus:outline-none focus:border-blue-500 text-sm">
                            <i class="fas fa-search absolute left-4 top-4 text-slate-400"></i>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <select id="statusFilter" class="bg-slate-900 border border-slate-700 text-white px-4 py-3 rounded-2xl text-sm focus:outline-none">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="banned">Banned</option>
                            <option value="pending">Pending</option>
                        </select>
                        
                        <button onclick="exportToCSV()" 
                                class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 px-5 py-3 rounded-2xl text-sm font-medium transition-colors">
                            <i class="fas fa-download"></i>
                            <span>Export CSV</span>
                        </button>
                        
                        <a href="/admin/users/new" 
                           class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 px-5 py-3 rounded-2xl text-sm font-medium transition-colors">
                            <i class="fas fa-plus"></i>
                            <span>Add User</span>
                        </a>
                    </div>
                </div>

                <!-- Users Table -->
                <div class="bg-slate-900 border border-slate-700 rounded-3xl overflow-hidden">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-slate-700 bg-slate-950">
                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-300">User</th>
                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-300">Email / Phone</th>
                                <th class="text-center px-6 py-4 text-sm font-semibold text-slate-300">Joined</th>
                                <th class="text-center px-6 py-4 text-sm font-semibold text-slate-300">Status</th>
                                <th class="text-center px-6 py-4 text-sm font-semibold text-slate-300">Balance</th>
                                <th class="text-center px-6 py-4 text-sm font-semibold text-slate-300">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <% if (users && users.length > 0) { %>
                                <% users.forEach(user => { %>
                                    <tr class="table-row border-b border-slate-700 last:border-0">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center overflow-hidden">
                                                    <% if (user.avatar) { %>
                                                        <img src="<%= user.avatar %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <i class="fas fa-user text-slate-400"></i>
                                                    <% } %>
                                                </div>
                                                <div>
                                                    <div class="font-medium text-white"><%= user.name || 'N/A' %></div>
                                                    <div class="text-xs text-slate-400">ID: <%= user.id %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm"><%= user.email || 'N/A' %></div>
                                            <div class="text-xs text-slate-400"><%= user.phone || '' %></div>
                                        </td>
                                        <td class="px-6 py-4 text-center text-sm text-slate-300">
                                            <%= user.joinedDate || 'N/A' %>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <% if (user.status === 'active') { %>
                                                <span class="modern-badge bg-emerald-500/10 text-emerald-400">Active</span>
                                            <% } else if (user.status === 'banned') { %>
                                                <span class="modern-badge bg-red-500/10 text-red-400">Banned</span>
                                            <% } else { %>
                                                <span class="modern-badge bg-amber-500/10 text-amber-400">Pending</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-center font-medium text-white">
                                            ৳ <%= user.balance || '0.00' %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/admin/user/<%= user.id %>" class="text-blue-400 hover:text-blue-300 p-2" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button onclick="adjustCoins(<%= user.id %>, '<%= user.name %>')" class="text-emerald-400 hover:text-emerald-300 p-2" title="Adjust Coins">
                                                    <i class="fas fa-coins"></i>
                                                </button>
                                                <button onclick="toggleBan(<%= user.id %>, '<%= user.name %>', '<%= user.status %>')" 
                                                        class="text-red-400 hover:text-red-300 p-2" title="Ban / Unban">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                                        <i class="fas fa-users text-4xl mb-3 opacity-30"></i>
                                        <p>No users found</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            const rows = document.querySelectorAll('#usersTableBody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const statusBadge = row.querySelector('.modern-badge');
                const statusText = statusBadge ? statusBadge.textContent.toLowerCase() : '';

                const matchesSearch = text.includes(search);
                const matchesStatus = !status || statusText.includes(status);

                row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
            });
        }

        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);

        function exportToCSV() {
            const rows = document.querySelectorAll('#usersTableBody tr');
            let csv = 'Name,Email,Phone,Joined,Status,Balance\n';
            
            rows.forEach(row => {
                if (row.style.display === 'none') return;
                const cells = row.querySelectorAll('td');
                if (cells.length < 6) return;
                
                const name = cells[0].innerText.trim().replace(/,/g, '');
                const email = cells[1].innerText.trim().replace(/,/g, '');
                const joined = cells[2].innerText.trim();
                const status = cells[3].innerText.trim();
                const balance = cells[4].innerText.trim().replace('৳', '').trim();
                
                csv += `"${name}","${email}","${joined}","${status}","${balance}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'users_export.csv';
            a.click();
        }

        function adjustCoins(userId, userName) {
            const amount = prompt(`Enter amount to add/remove for ${userName} (use negative for remove):`, '100');
            if (amount === null) return;
            alert(`Coins adjusted for ${userName} by ${amount} (Demo)`);
        }

        function toggleBan(userId, userName, currentStatus) {
            const action = currentStatus === 'banned' ? 'unban' : 'ban';
            if (!confirm(`Are you sure you want to ${action} ${userName}?`)) return;
            alert(`${userName} has been ${action}ned (Demo)`);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === '/' && document.activeElement.tagName === 'BODY') {
                e.preventDefault();
                document.getElementById('searchInput').focus();
            }
        });
    </script>
</body>
</html>

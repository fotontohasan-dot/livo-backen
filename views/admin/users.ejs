<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="admin-wrap">
  <%- include('../partials/sidebar', { active: 'users' }) %>

  <div class="admin-content">
    <!-- Topbar -->
    <div class="admin-topbar">
      <button class="admin-hamburger" onclick="toggleAdminSidebar(true)">
        <i class="fas fa-bars"></i>
      </button>
      <div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">ইউজার ম্যানেজমেন্ট</h1>
        <p class="text-sm text-slate-400">সকল ইউজার দেখুন, ব্যান/আনব্যান করুন এবং কয়েন অ্যাডজাস্ট করুন</p>
      </div>
      <div class="flex-1"></div>
      <a href="/admin/users" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-sm flex items-center gap-2 border border-white/10">
        <i class="fas fa-sync-alt"></i> <span>রিফ্রেশ</span>
      </a>
      <button onclick="exportUsersCSV()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm flex items-center gap-2">
        <i class="fas fa-download"></i> <span>Export CSV</span>
      </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="stat-card">
        <div class="stat-label">মোট ইউজার</div>
        <div class="stat-number"><%= total || 0 %></div>
        <div class="stat-sub">সকল রেজিস্টার্ড</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">অ্যাকটিভ ইউজার</div>
        <div class="stat-number text-emerald-400"><%= (users || []).filter(u => !u.is_banned).length %></div>
        <div class="stat-sub">বর্তমানে অ্যাকটিভ</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">ব্যান্ড ইউজার</div>
        <div class="stat-number text-red-400"><%= (users || []).filter(u => u.is_banned).length %></div>
        <div class="stat-sub">সাসপেন্ডেড</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">নতুন (আজ)</div>
        <div class="stat-number text-amber-400"><%= newUsersToday || 0 %></div>
        <div class="stat-sub">আজকের রেজিস্ট্রেশন</div>
      </div>
    </div>

    <!-- Search & Filter -->
    <div class="admin-card mb-6">
      <div class="admin-card-header flex items-center justify-between">
        <span>ফিল্টার ও সার্চ</span>
      </div>
      <div class="p-4">
        <form method="GET" action="/admin/users" class="flex flex-col md:flex-row gap-3">
          <div class="flex-1 relative">
            <i class="fas fa-search absolute left-4 top-3.5 text-slate-400"></i>
            <input type="text" name="search" value="<%= search || '' %>" 
                   class="w-full bg-[#0f1115] border border-white/10 rounded-2xl pl-11 py-3 text-sm focus:outline-none focus:border-amber-500"
                   placeholder="ইউজারনেম, ইমেইল বা ফোন নাম্বার দিয়ে সার্চ করুন...">
          </div>
          
          <select name="status" class="bg-[#0f1115] border border-white/10 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-amber-500">
            <option value="">সব স্ট্যাটাস</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>অ্যাকটিভ</option>
            <option value="banned" <%= status === 'banned' ? 'selected' : '' %>>ব্যান্ড</option>
          </select>

          <button type="submit" 
                  class="px-8 py-3 bg-amber-500 hover:bg-amber-600 transition rounded-2xl text-sm font-semibold text-black flex items-center justify-center gap-2">
            <i class="fas fa-search"></i> সার্চ
          </button>
        </form>
      </div>
    </div>

    <!-- Users Table -->
    <div class="admin-card">
      <div class="admin-card-header flex items-center justify-between">
        <span>ইউজার লিস্ট (<%= users ? users.length : 0 %> জন)</span>
        <span class="text-xs text-slate-400">পেজ <%= page || 1 %> / <%= totalPages || 1 %></span>
      </div>

      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ইউজার</th>
              <th>কন্ট্যাক্ট</th>
              <th class="text-right">কয়েন</th>
              <th>স্ট্যাটাস</th>
              <th>জয়েনড</th>
              <th class="text-center">অ্যাকশন</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(user => { %>
                <tr class="hover:bg-white/5 transition-colors">
                  <td>
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-black font-bold text-sm flex-shrink-0">
                        <%= (user.username || 'U').charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <div class="font-semibold text-white"><%= user.username || 'N/A' %></div>
                        <div class="text-[10px] text-slate-500 font-mono">ID: <%= user.id %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="text-sm"><%= user.email || '-' %></div>
                    <div class="text-xs text-slate-400"><%= user.phone || '-' %></div>
                  </td>
                  <td class="text-right">
                    <span class="font-mono text-emerald-400 font-semibold">৳ <%= Number(user.coins || 0).toLocaleString('bn-BD') %></span>
                  </td>
                  <td>
                    <% if (user.is_banned) { %>
                      <span class="badge badge-red">BANNED</span>
                    <% } else { %>
                      <span class="badge badge-green">ACTIVE</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="text-xs text-slate-400">
                      <%= user.created_at ? new Date(user.created_at).toLocaleDateString('bn-BD') : '-' %>
                    </span>
                  </td>
                  <td class="text-center">
                    <div class="flex items-center justify-center gap-2">
                      <!-- View Details -->
                      <a href="/admin/users/<%= user.id %>" 
                         class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white transition"
                         title="বিস্তারিত দেখুন">
                        <i class="fas fa-eye text-sm"></i>
                      </a>

                      <!-- Quick Coin Adjust (link to detail page) -->
                      <a href="/admin/users/<%= user.id %>#coins" 
                         class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 transition"
                         title="কয়েন অ্যাডজাস্ট">
                        <i class="fas fa-coins text-sm"></i>
                      </a>

                      <!-- Ban / Unban -->
                      <form action="/admin/users/<%= user.id %>/ban" method="POST" class="inline" onsubmit="return confirm('<%= user.is_banned ? 'এই ইউজারকে আনব্যান করবেন?' : 'এই ইউজারকে ব্যান করবেন?' %>')">
                        <button type="submit" 
                                class="inline-flex items-center justify-center w-9 h-9 rounded-xl transition <%= user.is_banned ? 'bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400' : 'bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-red-400' %>"
                                title="<%= user.is_banned ? 'আনব্যান করুন' : 'ব্যান করুন' %>">
                          <i class="fas <%= user.is_banned ? 'fa-user-check' : 'fa-user-slash' %> text-sm"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-12 text-slate-400">
                  <i class="fas fa-users text-3xl mb-3 opacity-50"></i><br>
                  কোনো ইউজার পাওয়া যায়নি
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-between px-4 py-4 border-t border-white/10 text-sm">
          <div class="text-slate-400">
            দেখানো হচ্ছে <span class="text-white"><%= users.length %></span> টি এন্ট্রি
          </div>
          <div class="flex gap-1">
            <% for(let i=1; i<=totalPages; i++) { %>
              <a href="/admin/users?page=<%= i %>&search=<%= search || '' %>&status=<%= status || '' %>" 
                 class="px-3.5 py-1.5 rounded-xl <%= i == (page || 1) ? 'bg-amber-500 text-black font-semibold' : 'bg-white/5 hover:bg-white/10' %>">
                <%= i %>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
function toggleAdminSidebar(show) {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('adminOverlay');
  if (!sidebar || !overlay) return;
  
  if (show) {
    sidebar.classList.add('open');
    overlay.classList.add('show');
  } else {
    sidebar.classList.remove('open');
    overlay.classList.remove('show');
  }
}

function exportUsersCSV() {
  // Simple client-side export (can be improved with server route later)
  const table = document.querySelector('.admin-table');
  if (!table) return alert('টেবিল পাওয়া যায়নি');
  
  let csv = [];
  const rows = table.querySelectorAll('tr');
  
  rows.forEach(row => {
    let cols = row.querySelectorAll('td, th');
    let rowData = [];
    cols.forEach(col => rowData.push('"' + col.innerText.replace(/"/g, '""') + '"'));
    csv.push(rowData.join(','));
  });
  
  const csvContent = csv.join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'users_export.csv';
  link.click();
}
</script>

<style>
/* Extra polish for this page */
.admin-table tbody tr:hover {
  background: rgba(255,255,255,0.03);
}
.badge {
  padding: 3px 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
</style>

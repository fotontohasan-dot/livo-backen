<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Users</h1>
        <p class="text-gray-400 text-sm mt-1">Total: <%= total %> users</p>
      </div>
      <a href="/admin/users" class="px-4 py-2 bg-[#334155] hover:bg-[#475569] text-white rounded-2xl text-sm flex items-center gap-2">
        <i class="fas fa-sync"></i>
        <span>Refresh</span>
      </a>
    </div>

    <!-- Search & Filter -->
    <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155] mb-6">
      <form method="GET" class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <input type="text" name="search" value="<%= search %>" placeholder="Search username, email, phone..." 
                 class="w-full bg-[#0f172a] border border-[#475569] text-white rounded-2xl px-4 py-3 text-sm focus:border-[#f59e0b]">
        </div>
        <div class="flex gap-3">
          <select name="status" class="bg-[#0f172a] border border-[#475569] text-white rounded-2xl px-4 py-3 text-sm focus:border-[#f59e0b]">
            <option value="">All Status</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="banned" <%= status === 'banned' ? 'selected' : '' %>>Banned</option>
          </select>
          <button type="submit" class="px-6 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl">Search</button>
        </div>
      </form>
    </div>

    <!-- Users Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">User</th>
            <th class="text-left px-4 py-4 font-normal">Contact</th>
            <th class="text-right px-4 py-4 font-normal">Coins</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% users.forEach(u => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4">
              <div class="font-semibold text-white"><%= u.username %></div>
              <div class="text-xs text-gray-500">ID: <%= u.id %></div>
            </td>
            <td class="px-4 py-4 text-xs">
              <%= u.email || '-' %><br>
              <%= u.phone || '-' %>
            </td>
            <td class="px-4 py-4 text-right font-bold text-emerald-400">৳<%= u.coins || 0 %></td>
            <td class="px-4 py-4 text-center">
              <% if(u.is_banned) { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">Banned</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Active</span>
              <% } %>
            </td>
            <td class="px-6 py-4">
              <div class="flex justify-center gap-2">
                <a href="/admin/users/<%= u.id %>" class="px-3 py-1.5 bg-[#334155] hover:bg-[#475569] rounded-xl text-xs">View</a>
                <form action="/admin/users/<%= u.id %>/ban" method="POST" class="inline">
                  <button type="submit" class="px-3 py-1.5 <%= u.is_banned ? 'bg-emerald-600' : 'bg-red-600' %> hover:opacity-90 rounded-xl text-xs text-white">
                    <%= u.is_banned ? 'Unban' : 'Ban' %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="flex justify-center mt-6 gap-2">
      <% for(let i=1; i<=totalPages; i++) { %>
        <a href="/admin/users?page=<%= i %>&search=<%= search %>&status=<%= status %>" 
           class="px-4 py-2 rounded-2xl text-sm <%= page === i ? 'bg-[#f59e0b] text-black' : 'bg-[#1e2937] text-gray-300 hover:bg-[#334155]' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
    <% } %>

  </main>
</div>

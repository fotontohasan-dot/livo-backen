<%
function fmtDate(d) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
function userRow(u) {
  const statusBadge = u.is_banned
    ? '<span class="px-3 py-1 text-xs font-bold rounded-full bg-red-100 text-red-700">Banned</span>'
    : '<span class="px-3 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-700">Active</span>';
  const banLabel = u.is_banned ? 'Unban' : 'Ban';
  const banColor = u.is_banned ? 'bg-emerald-500 hover:bg-emerald-600' : 'bg-red-500 hover:bg-red-600';
  return '<tr class="hover:bg-slate-50">' +
    '<td class="px-6 py-4">' +
      '<div class="font-semibold text-slate-800">' + u.username + '</div>' +
      '<div class="text-xs text-slate-500">#' + u.id + ' • ' + (u.email || u.phone || '-') + '</div>' +
    '</td>' +
    '<td class="px-6 py-4 font-mono font-semibold">৳ ' + Number(u.coins || 0).toLocaleString('en-US') + '</td>' +
    '<td class="px-6 py-4 text-sm">' + Number(u.total_points || 0).toLocaleString('en-US') + '</td>' +
    '<td class="px-6 py-4">' + statusBadge + '</td>' +
    '<td class="px-6 py-4 text-sm text-slate-500">' + fmtDate(u.created_at) + '</td>' +
    '<td class="px-6 py-4">' +
      '<div class="flex items-center justify-center gap-x-1.5 flex-wrap">' +
        '<a href="/admin/users/' + u.id + '" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-blue-500 hover:bg-blue-600 text-white transition-colors">View</a>' +
        '<form method="POST" action="/admin/users/' + u.id + '/ban" style="display:inline" onsubmit="return confirm(\'স্ট্যাটাস পরিবর্তন করবেন?\')">' +
          '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl ' + banColor + ' text-white transition-colors">' + banLabel + '</button>' +
        '</form>' +
      '</div>' +
    '</td>' +
  '</tr>';
}
const rows = (users || []).map(userRow).join('') || '<tr><td colspan="6" class="px-6 py-10 text-center text-slate-400">কোনো ইউজার পাওয়া যায়নি</td></tr>';
%>
<%- include('partials/admin-layout', {
    title: 'User Management',
    active: 'users',
    body: `
<div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">User Management</h1>
            <p class="text-slate-500 mt-1 text-sm">মোট ${total || 0} জন ইউজার</p>
        </div>
    </div>

    <form method="GET" action="/admin/users" class="flex flex-wrap gap-3 mb-6">
        <input type="text" name="search" value="${search || ''}" placeholder="নাম, ইমেইল বা ফোন দিয়ে খুঁজুন..."
               class="flex-1 min-w-[220px] border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-blue-300">
        <select name="status" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <option value="">সব স্ট্যাটাস</option>
            <option value="active" ${status === 'active' ? 'selected' : ''}>Active</option>
            <option value="banned" ${status === 'banned' ? 'selected' : ''}>Banned</option>
        </select>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-2xl text-sm font-semibold">খুঁজুন</button>
        ${(search || status) ? '<a href="/admin/users" class="px-4 py-2.5 bg-slate-100 text-slate-600 rounded-2xl text-sm font-medium">রিসেট</a>' : ''}
    </form>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-hidden modern-table">
        <table class="w-full text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">User</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Coins</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Points</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Status</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Joined</th>
                    <th class="px-6 py-4 text-center font-medium text-slate-500 uppercase text-xs">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">${rows}</tbody>
        </table>
    </div>

    <div class="flex justify-center gap-3 mt-6">
        ${page > 1 ? '<a href="/admin/users?page=' + (page - 1) + '&search=' + encodeURIComponent(search || '') + '&status=' + (status || '') + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">← আগের পেজ</a>' : ''}
        <span class="px-4 py-2 text-sm text-slate-500">পেজ ${page} / ${totalPages}</span>
        ${page < totalPages ? '<a href="/admin/users?page=' + (page + 1) + '&search=' + encodeURIComponent(search || '') + '&status=' + (status || '') + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">পরের পেজ →</a>' : ''}
    </div>
</div>
`
}) %>

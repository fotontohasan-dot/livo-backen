<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="admin-layout">
  <div class="admin-sidebar">
    <div style="padding:0 1.5rem 1rem;font-size:.75rem;color:var(--muted);text-transform:uppercase;">অ্যাডমিন প্যনেল</div>
    <a href="/admin" class="admin-nav-link">📊 ড্যাশবোর্ড</a>
    <a href="/admin/users" class="admin-nav-link active">👥 ব্যবহারকারী</a>
    <a href="/admin/matches" class="admin-nav-link">⚽ ম্যাচসমূহ</a>
    <a href="/admin/tournaments" class="admin-nav-link">🏆 টুর্নামেন্ট</a>
    <a href="/admin/news" class="admin-nav-link">📰 নিউজ</a>
    <a href="/chat/admin" class="admin-nav-link">💬 সপোর্ট চ্যাট</a>
    <a href="/" class="admin-nav-link">🏠 সাইটে ফির যান</a>
  </div>
  <div class="admin-content">
    <%- include('../partials/flash') %>
    <h1 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">👥 ইউজার ম্যানেজমেন্ট</h1>
    <div class="card">
      <table class="table">
        <thead>
          <tr>
            <th>ইউজার</th>
            <th>ইমেইল</th>
            <th>কয়েন</th>
            <th>পয়েন্ট</th>
            <th>স্ট্যাটাস</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td style="font-weight:600"><%= u.username %></td>
              <td style="font-size:.8rem;color:var(--muted)"><%= u.email %></td>
              <td style="color:var(--gold)"><%= u.coins %></td>
              <td style="color:var(--primary)"><%= u.total_points %></td>
              <td>
                <span style="color:<%= u.is_banned ? 'var(--red)' : 'var(--green)' %>;font-size:.85rem">
                  <%= u.is_banned ? '🚫 নিষিদ্ধ' : '✅ সচল' %>
                </span>
              </td>
              <td style="display:flex;gap:.4rem;flex-wrap:wrap;">
                <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-primary">👁️ বিস্তারিত</a>
                <button onclick="banUser(<%= u.id %>)" class="btn btn-sm <%= u.is_banned ? 'btn-outline' : 'btn-danger' %>">
                  <%= u.is_banned ? 'আনব্যান' : 'ব্যান' %>
                </button>
                <button onclick="showAddCoins(<%= u.id %>)" class="btn btn-sm btn-gold">+ কয়েন</button>
                <button onclick="showRemoveCoins(<%= u.id %>)" class="btn btn-sm btn-danger">- কয়েন</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div id="addCoinModal" style="display:none;position:fixed;inset:0;background:#000000aa;z-index:9999;align-items:center;justify-content:center;">
      <div class="card" style="width:90%;max-width:350px;padding:20px;">
        <h3 style="color:var(--gold);margin-bottom:12px;">💰 কয়েন যোগ করুন</h3>
        <input type="number" class="form-input" id="addCoinAmount" min="1" placeholder="যত কয়েন দিতে চান" style="margin-bottom:12px;width:100%;">
        <div style="display:flex;gap:.5rem;">
          <button onclick="submitAddCoins()" class="btn btn-primary">✅ যোগ করুন</button>
          <button onclick="closeModals()" class="btn btn-outline">বাতিল</button>
        </div>
      </div>
    </div>

    <div id="removeCoinModal" style="display:none;position:fixed;inset:0;background:#000000aa;z-index:9999;align-items:center;justify-content:center;">
      <div class="card" style="width:90%;max-width:350px;padding:20px;">
        <h3 style="color:var(--red);margin-bottom:12px;">🔻 কয়েন কমান</h3>
        <input type="number" class="form-input" id="removeCoinAmount" min="1" placeholder="যত কয়েন কমাতে চান" style="margin-bottom:12px;width:100%;">
        <div style="display:flex;gap:.5rem;">
          <button onclick="submitRemoveCoins()" class="btn btn-danger">🔻 কমান</button>
          <button onclick="closeModals()" class="btn btn-outline">বাতিল</button>
        </div>
      </div>
    </div>

  </div>
</div>
<script>
let currentUserId;

function closeModals() {
  document.getElementById('addCoinModal').style.display = 'none';
  document.getElementById('removeCoinModal').style.display = 'none';
}

function postForm(action, fields) {
  const f = document.createElement('form');
  f.method = 'POST'; f.action = action;
  for (const k in fields) {
    const i = document.createElement('input');
    i.type = 'hidden'; i.name = k; i.value = fields[k];
    f.appendChild(i);
  }
  document.body.appendChild(f);
  f.submit();
}

function banUser(id) {
  if (!confirm('স্ট্যাটাস পরিবর্তন করবেন?')) return;
  postForm(`/admin/users/${id}/ban`, {});
}

function showAddCoins(id) {
  currentUserId = id;
  document.getElementById('addCoinAmount').value = '';
  document.getElementById('addCoinModal').style.display = 'flex';
}

function showRemoveCoins(id) {
  currentUserId = id;
  document.getElementById('removeCoinAmount').value = '';
  document.getElementById('removeCoinModal').style.display = 'flex';
}

function submitAddCoins() {
  const amount = document.getElementById('addCoinAmount').value;
  if (!amount || amount <= 0) { alert('সঠিক পরিমাণ দিন!'); return; }
  postForm(`/admin/users/${currentUserId}/coins/add`, { amount });
}

function submitRemoveCoins() {
  const amount = document.getElementById('removeCoinAmount').value;
  if (!amount || amount <= 0) { alert('সঠিক পরিমাণ দিন!'); return; }
  postForm(`/admin/users/${currentUserId}/coins/remove`, { amount });
}
</script>
</body></html>

<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function channelBadge(c) {
  const map = { email: 'bg-blue-100 text-blue-700', sms: 'bg-purple-100 text-purple-700', in_app: 'bg-emerald-100 text-emerald-700' };
  const label = { email: '📧 Email', sms: '📱 SMS', in_app: '🔔 In-App' };
  return '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + (map[c] || 'bg-slate-100') + '">' + (label[c] || c) + '</span>';
}
function langBadge(l) {
  return '<span class="px-2 py-0.5 text-[10px] font-bold rounded bg-slate-100 text-slate-500 uppercase">' + escapeHtml(l) + '</span>';
}
function row(t) {
  return '<tr class="border-b border-slate-100 align-top hover:bg-slate-50">' +
    '<td class="px-5 py-4">' + channelBadge(t.channel) + '</td>' +
    '<td class="px-5 py-4">' + langBadge(t.lang) + '</td>' +
    '<td class="px-5 py-4">' +
      '<div class="font-semibold text-slate-900 text-sm">' + escapeHtml(t.name) + '</div>' +
      '<div class="text-xs text-slate-400 font-mono">' + escapeHtml(t.template_key) + '</div>' +
    '</td>' +
    '<td class="px-5 py-4 text-xs text-slate-500 max-w-xs truncate">' + escapeHtml((t.body || '').replace(/<[^>]+>/g, ' ').slice(0, 80)) + '...</td>' +
    '<td class="px-5 py-4">' +
      '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + (t.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-500') + '">' + (t.is_active ? 'সক্রিয়' : 'নিষ্ক্রিয়') + '</span>' +
    '</td>' +
    '<td class="px-5 py-4 text-right whitespace-nowrap">' +
      '<a href="/admin/notification-templates/' + t.id + '/edit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 mr-1.5">Edit</a>' +
      '<form method="POST" action="/admin/notification-templates/' + t.id + '/delete" onsubmit="return confirm(\'ডিলিট করবেন?\')" style="display:inline">' +
        '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-red-50 text-red-600 hover:bg-red-100">Delete</button>' +
      '</form>' +
    '</td>' +
  '</tr>';
}
const rows = (list || []).map(row).join('') || '<tr><td colspan="6" class="px-5 py-10 text-center text-slate-400 text-sm">কোনো টেমপ্লেট নেই — উপরের বাটন থেকে একটা তৈরি করুন</td></tr>';
const f = filters || { channel: '', lang: '', q: '' };
%>
<%- include('partials/admin-layout', {
    title: 'Notification Templates',
    active: 'notification-templates',
    body: `
<div class="max-w-6xl mx-auto space-y-5">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Notification Templates</h1>
            <p class="text-slate-500 mt-1 text-sm">Email / SMS / In-App টেমপ্লেট — {{name}}, {{otp}}, {{amount}} এর মতো ভ্যারিয়েবল সাপোর্ট সহ, বাংলা ও ইংরেজি দুই ভাষাতেই</p>
        </div>
        <a href="/admin/notification-templates/new" class="px-5 py-2.5 bg-slate-900 text-white rounded-2xl text-sm font-semibold hover:bg-slate-800">
            <i class="fas fa-plus mr-1"></i> নতুন টেমপ্লেট
        </a>
    </div>

    ${error ? '<div class="px-4 py-3 bg-red-50 text-red-700 rounded-2xl text-sm font-medium">❌ ' + escapeHtml(error) + '</div>' : ''}

    <form method="GET" class="bg-white rounded-3xl border border-slate-100 p-4 flex flex-wrap gap-3 items-center">
        <select name="channel" class="border border-slate-200 px-3 py-2 rounded-xl text-sm">
            <option value="">সব চ্যানেল</option>
            <option value="email" ${f.channel === 'email' ? 'selected' : ''}>Email</option>
            <option value="sms" ${f.channel === 'sms' ? 'selected' : ''}>SMS</option>
            <option value="in_app" ${f.channel === 'in_app' ? 'selected' : ''}>In-App</option>
        </select>
        <select name="lang" class="border border-slate-200 px-3 py-2 rounded-xl text-sm">
            <option value="">সব ভাষা</option>
            <option value="bn" ${f.lang === 'bn' ? 'selected' : ''}>বাংলা</option>
            <option value="en" ${f.lang === 'en' ? 'selected' : ''}>English</option>
        </select>
        <input type="text" name="q" value="${escapeHtml(f.q)}" placeholder="key বা নাম দিয়ে খুঁজুন..." class="border border-slate-200 px-3 py-2 rounded-xl text-sm flex-1 min-w-[180px]">
        <button type="submit" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200">ফিল্টার</button>
    </form>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-slate-100 text-left text-xs text-slate-400 uppercase">
                    <th class="px-5 py-3">চ্যানেল</th>
                    <th class="px-5 py-3">ভাষা</th>
                    <th class="px-5 py-3">নাম / Key</th>
                    <th class="px-5 py-3">Body প্রিভিউ</th>
                    <th class="px-5 py-3">স্ট্যাটাস</th>
                    <th class="px-5 py-3 text-right">অ্যাকশন</th>
                </tr>
            </thead>
            <tbody>${rows}</tbody>
        </table>
    </div>
</div>
`
}) %>

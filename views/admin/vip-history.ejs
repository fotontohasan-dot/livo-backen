<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_vip_history') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz7-1 { color: #f59e0b; font-size: 12px; text-decoration: none; display: inline-block; margin-bottom: 12px; }
  .dz7-2 { margin-bottom: 16px; }
  .dz7-3 { overflow-x: auto; }
  .dz7-4 { font-weight: 700; }
  .dz7-5 { color: #10b981; font-weight: 700; }
  .dz7-6 { font-size: 11px; color: var(--text-muted); }
  .dz7-7 { font-size: 11px; }
  .dz7-8 { text-align: center; color: var(--text-muted); padding: 20px; }
  .dz7-9 { display: flex; gap: 8px; justify-content: center; padding: 12px; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'vip' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'VIP রিওয়ার্ড ও আপগ্রেড হিস্ট্রি', pageSubtitle: 'সব ইউজারের VIP ক্লেইম ও লেভেল পরিবর্তনের সম্পূর্ণ লগ' }) %>

      <a class="dz7-1" href="/admin/vip"><i class="fas fa-arrow-left"></i> <%= t('admin_back_to_vip') %></a>

      <div class="admin-card dz7-2">
        <div class="admin-card-header">রিওয়ার্ড / ক্লেইম হিস্ট্রি (মোট <%= rewardHistory.total %>)</div>
        <div class="dz7-3">
          <table class="admin-table">
            <thead><tr><th><%= t('admin_col_user') %></th><th><%= t('admin_col_vip_level') %></th><th><%= t('admin_col_type') %></th><th><%= t('admin_col_amount') %></th><th><%= t('admin_col_description') %></th><th><%= t('admin_col_date') %></th></tr></thead>
            <tbody>
              <% if (rewardHistory.rows && rewardHistory.rows.length > 0) { %>
                <% rewardHistory.rows.forEach(r => { %>
                  <tr>
                    <td class="dz7-4">@<%= r.username || 'N/A' %></td>
                    <td><%= r.vip_level %></td>
                    <td><span class="badge badge-amber"><%= r.reward_type %></span></td>
                    <td class="dz7-5">+<%= Number(r.amount).toLocaleString('bn-BD') %></td>
                    <td class="dz7-6"><%= r.description %></td>
                    <td class="dz7-7"><%= new Date(r.created_at).toLocaleString('bn-BD') %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td class="dz7-8" colspan="6"><%= t('admin_empty_records') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% if (rewardHistory.totalPages > 1) { %>
          <div class="dz7-9">
            <% for (let p = 1; p <= rewardHistory.totalPages; p++) { %>
              <a href="/admin/vip/history?page=<%= p %>" style="padding:4px 10px;border-radius:6px;font-size:12px;text-decoration:none;background:<%= p === page ? '#f59e0b' : 'rgba(255,255,255,0.05)' %>;color:<%= p === page ? '#000' : 'var(--text-muted)' %>;"><%= p %></a>
            <% } %>
          </div>
        <% } %>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">VIP আপগ্রেড হিস্ট্রি (মোট <%= upgradeHistory.total %>)</div>
        <div class="dz7-3">
          <table class="admin-table">
            <thead><tr><th><%= t('admin_col_user') %></th><th><%= t('admin_col_old_level') %></th><th><%= t('admin_col_new_level') %></th><th><%= t('admin_col_bonus') %></th><th><%= t('admin_col_turnover_at_upgrade') %></th><th><%= t('admin_col_date') %></th></tr></thead>
            <tbody>
              <% if (upgradeHistory.rows && upgradeHistory.rows.length > 0) { %>
                <% upgradeHistory.rows.forEach(u => { %>
                  <tr>
                    <td class="dz7-4">@<%= u.username || 'N/A' %></td>
                    <td><%= u.from_level %></td>
                    <td><span class="badge badge-green"><%= u.to_level %></span></td>
                    <td class="dz7-5">+<%= Number(u.bonus).toLocaleString('bn-BD') %></td>
                    <td><%= Number(u.total_turnover_at_upgrade).toLocaleString('bn-BD') %></td>
                    <td class="dz7-7"><%= new Date(u.created_at).toLocaleString('bn-BD') %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td class="dz7-8" colspan="6"><%= t('admin_empty_records') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</body>
</html>

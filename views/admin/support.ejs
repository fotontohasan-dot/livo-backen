<%
function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function ticketListItem(t) {
  return '<div class="px-4 py-3.5 mx-1 mb-1 rounded-2xl cursor-pointer border border-transparent hover:bg-slate-50" onclick="openTicket(' + Number(t.userId) + ')" id="ticket-item-' + Number(t.userId) + '">' +
    '<div class="flex justify-between"><div class="font-semibold text-sm">' + esc(t.username) + '</div>' +
    '<div class="text-[10px] px-2 py-0.5 rounded ' + (t.status === 'Open' ? 'bg-yellow-100 text-yellow-700' : 'bg-emerald-100 text-emerald-700') + '">' + esc(t.status) + '</div></div>' +
    '<div class="text-xs text-slate-400 mt-1 line-clamp-1">' + esc(String(t.lastMessage || '').slice(0, 60)) + '</div>' +
  '</div>';
}
const ticketsHtml = (tickets || []).map(ticketListItem).join('') || '<div class="text-center text-slate-400 py-10 text-sm">কোনো সাপোর্ট মেসেজ নেই</div>';
// JSON.stringify escapes quotes/backslashes কিন্তু "</script>" সিকোয়েন্স আটকায় না।
// কোনো user message/username-এ "</script>" থাকলে <script> ব্লক ভেঙে আর্বিট্রারি HTML/JS ইনজেক্ট হতে পারত,
// তাই '<' কে '\u003c' দিয়ে replace করে script-breakout বন্ধ করা হচ্ছে।
const ticketsData = JSON.stringify((tickets || []).map(t => ({ userId: t.userId, username: t.username, messages: t.messages, status: t.status }))).replace(/</g, '\\u003c');
%>
<%- include('partials/admin-layout', { 
    title: 'Support Tickets', 
    active: 'support',
    body: `
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between mb-6">
        <div>
            <h2 class="text-2xl font-semibold">Support Tickets</h2>
            <p class="text-sm text-slate-600">${openCount || 0} open tickets</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-100 p-1">
            <div class="p-4">
                <input type="text" placeholder="Search tickets..." class="w-full border px-4 py-2.5 rounded-2xl text-sm mb-4" onkeyup="filterTickets(this.value)">
            </div>
            <div id="ticketsList" class="max-h-[520px] overflow-auto px-2">${ticketsHtml}</div>
        </div>

        <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-100 flex flex-col h-[580px]">
            <div id="chatHeader" class="px-6 py-4 border-b flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-slate-200 rounded-2xl flex-shrink-0"></div>
                    <div>
                        <div id="chatUserName" class="font-semibold">একটা টিকেট বাছাই করুন</div>
                        <div id="chatUserId" class="text-xs text-slate-500"></div>
                    </div>
                </div>
                <button onclick="resolveTicket()" class="text-xs px-4 py-1.5 bg-emerald-100 text-emerald-700 rounded-2xl font-bold">Mark as Resolved</button>
            </div>
            <div id="chatMessages" class="flex-1 p-6 overflow-auto space-y-4 text-sm bg-slate-50"></div>
            <div class="p-4 border-t flex gap-2">
                <input id="replyInput" type="text" placeholder="Type your reply..." class="flex-1 border rounded-2xl px-5 py-3 text-sm">
                <button onclick="sendReply()" class="px-6 bg-blue-600 text-white rounded-2xl font-semibold">Send</button>
            </div>
        </div>
    </div>
</div>

<script>
let tickets = ${ticketsData};
let currentUserId = null;

function filterTickets(term) {
    term = term.toLowerCase();
    document.querySelectorAll('#ticketsList > div').forEach(el => {
        el.style.display = el.textContent.toLowerCase().includes(term) ? '' : 'none';
    });
}

function openTicket(userId) {
    currentUserId = userId;
    const ticket = tickets.find(t => t.userId === userId);
    if (!ticket) return;

    document.getElementById('chatUserName').textContent = ticket.username;
    document.getElementById('chatUserId').textContent = '#' + ticket.userId;

    const chatBox = document.getElementById('chatMessages');
    chatBox.innerHTML = '';
    ticket.messages.forEach(m => {
        const msgDiv = document.createElement('div');
        msgDiv.className = m.from === 'admin' ? 'flex justify-end' : '';
        const bubble = document.createElement('div');
        bubble.className = (m.from === 'admin' ? 'bg-blue-600 text-white' : 'bg-white border') + ' max-w-[75%] px-4 py-2 rounded-2xl text-sm';
        bubble.textContent = m.text;
        msgDiv.appendChild(bubble);
        chatBox.appendChild(msgDiv);
    });
    chatBox.scrollTop = chatBox.scrollHeight;

    document.querySelectorAll('#ticketsList > div').forEach(el => el.classList.remove('border-blue-300', 'bg-blue-50'));
    const activeEl = document.getElementById('ticket-item-' + userId);
    if (activeEl) activeEl.classList.add('border-blue-300', 'bg-blue-50');
}

async function sendReply() {
    const input = document.getElementById('replyInput');
    const message = input.value.trim();
    if (!message || !currentUserId) return;
    try {
        const res = await fetch('/admin/api/support/' + currentUserId + '/reply', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message })
        });
        const data = await res.json();
        if (data.success) {
            const ticket = tickets.find(t => t.userId === currentUserId);
            ticket.messages.push({ from: 'admin', text: message, time: new Date().toISOString() });
            ticket.status = 'Resolved';
            input.value = '';
            openTicket(currentUserId);
        } else {
            alert('❌ ' + (data.error || 'সমস্যা হয়েছে'));
        }
    } catch (e) { alert('❌ সার্ভার এরর'); }
}

async function resolveTicket() {
    if (!currentUserId) return;
    try {
        const res = await fetch('/admin/api/support/' + currentUserId + '/resolve', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            alert('✅ টিকেট Resolved হিসেবে মার্ক করা হয়েছে');
            location.reload();
        }
    } catch (e) { alert('❌ সার্ভার এরর'); }
}
</script>
` 
}) %>

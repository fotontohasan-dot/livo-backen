<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="admin-layout">
  <div class="admin-sidebar">
    <div style="padding:0 1.5rem 1rem;font-size:.75rem;color:var(--muted);text-transform:uppercase;">অ্যাডমিন প্যানেল</div>
    <a href="/admin" class="admin-nav-link">📊 ড্যাশবোর্ড</a>
    <a href="/admin/users" class="admin-nav-link">👥 ব্যবহারকারী</a>
    <a href="/admin/matches" class="admin-nav-link">⚽ ম্যাচসমূহ</a>
    <a href="/admin/tournaments" class="admin-nav-link">🏆 টুর্নামেন্ট</a>
    <a href="/admin/news" class="admin-nav-link active">📰 নিউজ</a>
    <a href="/" class="admin-nav-link">🏠 সাইটে ফিরে যান</a>
  </div>
  <div class="admin-content">
    <%- include('../partials/flash') %>
    <div class="layout-main">
      <div>
        <h1 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">📰 নিউজ ম্যানেজমেন্ট</h1>
        <div class="card">
          <table class="table">
            <thead>
              <tr><th>টাইটেল</th><th>স্পোর্টস</th><th>লেখক</th><th>ভিউ</th><th>তারিখ</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody>
              <% news.forEach(n => { %>
                <tr>
                  <td style="font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= n.title %></td>
                  <td><%= n.sport %></td>
                  <td><%= n.author %></td>
                  <td><%= n.views %></td>
                  <td style="font-size:.8rem;color:var(--muted)"><%= new Date(n.created_at).toLocaleDateString() %></td>
                  <td><button onclick="deleteNews(<%= n.id %>)" class="btn btn-danger btn-sm">মুছে ফেলুন</button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <div class="card">
          <div class="card-header">📝 নিউজ পাবলিশ করুন</div>
          <div class="card-body">
            <div class="form-group"><label class="form-label">টাইটেল</label><input type="text" class="form-input" id="nTitle"></div>
            <div class="form-group"><label class="form-label">স্পোর্টস</label><select class="form-input" id="nSport"><option value="football">ফুটবল</option><option value="cricket">ক্রিকেট</option><option value="basketball">বাস্কেটবল</option><option value="tennis">টেনিস</option><option value="general">সাধারণ</option></select></div>
            <div class="form-group"><label class="form-label">ইমেজ ইউআরএল (ঐচ্ছিক)</label><input type="text" class="form-input" id="nImage" placeholder="https://..."></div>
            <div class="form-group"><label class="form-label">কন্টেন্ট</label><textarea class="form-input" id="nContent" rows="8" placeholder="নিউজ আর্টিকেল লিখুন..."></textarea></div>
            <button onclick="publishNews()" class="btn btn-primary">নিউজ পাবলিশ করুন</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function publishNews() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = '/admin/news';
  [['title','nTitle'],['sport','nSport'],['image','nImage'],['content','nContent']].forEach(([n,id]) => {
    const el = document.getElementById(id);
    const i = document.createElement('input');
    i.name = n; i.value = el.value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
function deleteNews(id) {
  if(confirm('Delete this article?')) {
    const form = document.createElement('form');
    form.method = 'POST'; form.action = `/admin/news/${id}/delete`;
    document.body.appendChild(form); form.submit();
  }
}
</script>
</body></html>

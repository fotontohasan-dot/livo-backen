<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container" style="padding-top: 20px;">
  <h2>📰 নিউজ ম্যানেজমেন্ট</h2>
  <a href="/admin" class="btn btn-secondary">← ড্যাশবোর্ড</a>

  <div class="card" style="margin: 20px 0; padding: 20px;">
    <h5>নতুন নিউজ লিখুন</h5>
    <form action="/admin/news" method="POST">
      <input type="text" name="title" placeholder="শিরোনাম" required class="form-control" style="margin-bottom:10px;">

      <textarea name="content" placeholder="বিস্তারিত লেখা..." rows="6" class="form-control" style="margin-bottom:10px;"></textarea>

      <input type="text" name="image_url" placeholder="ছবির লিংক (ঐচ্ছিক)" class="form-control" style="margin-bottom:10px;">

      <select name="sport" class="form-control" style="margin-bottom:10px;">
        <option value="">-- ক্যাটাগরি (ঐচ্ছিক) --</option>
        <option value="cricket">ক্রিকেট</option>
        <option value="football">ফুটবল</option>
        <option value="general">সাধারণ</option>
      </select>

      <button type="submit" class="btn btn-success" style="width:100%;">প্রকাশ করুন</button>
    </form>
  </div>

  <h5>প্রকাশিত নিউজ</h5>
  <% if (news.length === 0) { %>
    <p style="color:#888;">এখনো কোনো নিউজ নেই।</p>
  <% } %>
  <% news.forEach(item => { %>
    <div class="card" style="margin-bottom:12px; padding:15px;">
      <strong><%= item.title %></strong>
      <% if (item.sport) { %><span class="badge bg-info"><%= item.sport %></span><% } %>
      <p style="font-size:13px; color:#aaa; margin:6px 0;">👁️ <%= item.views || 0 %> ভিউ</p>

      <form action="/admin/news/<%= item.id %>/delete" method="POST" style="display:inline;"
            onsubmit="return confirm('এই নিউজটি মুছে ফেলবেন?');">
        <button type="submit" class="btn btn-sm btn-danger">🗑️ মুছুন</button>
      </form>
    </div>
  <% }) %>

</div>

<%- include('../partials/bottom-nav') %>

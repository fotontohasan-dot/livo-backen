<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_news') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz16-1 { padding: 16px; margin-bottom: 16px; }
  .dz16-2 { font-weight: 800; color: var(--text-main); font-size: 13px; margin-bottom: 12px; }
  .dz16-3 { color: #f59e0b; }
  .dz16-4 { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .dz16-5 { flex: 1; min-width: 0; }
  .dz16-6 { font-weight: 700; color: #fff; font-size: 13px; }
  .dz16-7 { color: #94a3b8; font-size: 11px; margin-top: 3px; }
  .dz16-8 { color: #94a3b8; font-size: 12px; margin-top: 4px; max-height: 36px; overflow: hidden; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .news-row { display: flex; gap: 12px; padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .news-row img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; flex-shrink: 0; background: #0f1115; }
    .news-row:last-child { border-bottom: none; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'news' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'নিউজ', pageSubtitle: 'স্পোর্টস নিউজ পোস্ট ও পরিচালনা করুন' }) %>

      <div class="admin-card dz16-1">
        <div class="dz16-2"><i class="fas fa-newspaper dz16-3"></i> <%= t('admin_news_add_heading') %></div>
        <form class="dz16-4" method="POST" action="/admin/news/add">
          <input class="input" type="text" name="title" placeholder="<%= t('admin_col_title') %>" required>
          <textarea class="input" name="content" rows="4" placeholder="<%= t('admin_col_details') %>"></textarea>
          <input class="input" type="text" name="image_url" placeholder="<%= t('admin_field_image_url_optional') %>">
          <input class="input" type="text" name="sport" placeholder="<%= t('admin_field_sport_optional') %>">
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> <%= t('admin_btn_post') %></button>
        </form>
      </div>

      <div class="admin-card">
        <div class="admin-card-header"><%= t('admin_news_all') %></div>
        <% if (newsList && newsList.length > 0) { %>
          <% newsList.forEach(n => { %>
            <div class="news-row">
              <% if (n.image_url) { %><img alt="" src="<%= n.image_url %>" data-img-fallback="hide"><% } %>
              <div class="dz16-5">
                <div class="dz16-6"><%= n.title %></div>
                <div class="dz16-7">
                  <%= n.sport || 'সাধারণ' %> · <%= n.views || 0 %> ভিউ · <%= n.created_at ? new Date(n.created_at).toLocaleDateString('bn-BD') : '—' %>
                </div>
                <div class="dz16-8">
                  <%= (n.content || '').slice(0, 120) %><%= (n.content || '').length > 120 ? '...' : '' %>
                </div>
              </div>
              <form method="POST" action="/admin/news/<%= n.id %>/delete" data-confirm="মুছে ফেলবেন?">
                <button class="btn btn-sm btn-red" type="submit" aria-label="<%= t('admin_ui_delete') %>" title="<%= t('admin_ui_delete') %>"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state"><%= t('admin_empty_news') %></div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>

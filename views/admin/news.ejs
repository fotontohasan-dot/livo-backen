<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>নিউজ • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .news-row { display: flex; gap: 12px; padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .news-row img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; flex-shrink: 0; background: #0f1115; }
    .news-row:last-child { border-bottom: none; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'news' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'নিউজ', pageSubtitle: 'স্পোর্টস নিউজ পোস্ট ও পরিচালনা করুন' }) %>

      <div class="admin-card" style="padding:16px;margin-bottom:16px;">
        <div style="font-weight:800;color:var(--text-main);font-size:13px;margin-bottom:12px;"><i class="fas fa-newspaper" style="color:#f59e0b;"></i> নতুন নিউজ যোগ করুন</div>
        <form method="POST" action="/admin/news/add" style="display:grid;grid-template-columns:1fr;gap:10px;">
          <input class="input" type="text" name="title" placeholder="শিরোনাম" required>
          <textarea class="input" name="content" rows="4" placeholder="বিস্তারিত"></textarea>
          <input class="input" type="text" name="image_url" placeholder="ইমেজ URL (ঐচ্ছিক)">
          <input class="input" type="text" name="sport" placeholder="স্পোর্ট (ঐচ্ছিক)">
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> পোস্ট করুন</button>
        </form>
      </div>

      <div class="admin-card">
        <div class="admin-card-header">সকল নিউজ</div>
        <% if (newsList && newsList.length > 0) { %>
          <% newsList.forEach(n => { %>
            <div class="news-row">
              <% if (n.image_url) { %><img src="<%= n.image_url %>" onerror="this.style.display='none'"><% } %>
              <div style="flex:1;min-width:0;">
                <div style="font-weight:700;color:#fff;font-size:13px;"><%= n.title %></div>
                <div style="color:#94a3b8;font-size:11px;margin-top:3px;">
                  <%= n.sport || 'সাধারণ' %> · <%= n.views || 0 %> ভিউ · <%= n.created_at ? new Date(n.created_at).toLocaleDateString('bn-BD') : '—' %>
                </div>
                <div style="color:#94a3b8;font-size:12px;margin-top:4px;max-height:36px;overflow:hidden;">
                  <%= (n.content || '').slice(0, 120) %><%= (n.content || '').length > 120 ? '...' : '' %>
                </div>
              </div>
              <form method="POST" action="/admin/news/<%= n.id %>/delete" onsubmit="return confirm('মুছে ফেলবেন?')">
                <button class="btn btn-sm btn-red" type="submit"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state">কোনো নিউজ পাওয়া যায়নি</div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>

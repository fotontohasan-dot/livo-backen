<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
%>
<%- include('partials/admin-layout', {
    title: 'Roles & Permissions',
    active: 'roles',
    body: `
<div class="max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div>
      <h1 class="text-xl font-bold text-slate-800">🛡️ Roles & Permissions</h1>
      <p class="text-sm text-slate-500">Super Admin, Admin, Moderator, Support, Finance ও Custom Role ম্যানেজ করুন</p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <a href="/admin/roles/matrix" class="px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-semibold"><i class="fas fa-table-cells"></i> Permission Matrix</a>
      <a href="/admin/user-roles" class="px-4 py-2 bg-blue-600 text-white rounded-xl text-sm font-semibold"><i class="fas fa-users-gear"></i> User Role Assignment</a>
      <a href="/admin/roles/export" class="px-4 py-2 bg-emerald-600 text-white rounded-xl text-sm font-semibold"><i class="fas fa-download"></i> Export</a>
      <form method="POST" action="/admin/roles/import" enctype="multipart/form-data" class="flex items-center gap-1">
        <input type="file" name="file" accept=".json" required class="text-xs w-40">
        <button type="submit" class="px-3 py-2 bg-slate-100 text-slate-700 rounded-xl text-xs font-semibold"><i class="fas fa-upload"></i> Import</button>
      </form>
    </div>
  </div>

  ${error ? `<div class="mb-4 bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-2xl text-sm">${escapeHtml(error)}</div>` : ''}

  <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm mb-6">
    <p class="text-sm font-bold text-slate-700 mb-3">নতুন Custom Role তৈরি করুন</p>
    <form method="POST" action="/admin/roles" class="grid grid-cols-1 md:grid-cols-3 gap-2">
      <input type="text" name="name" placeholder="Role নাম (যেমন: Content Editor)" required class="border px-3 py-2.5 rounded-xl text-sm md:col-span-1">
      <input type="text" name="description" placeholder="বিবরণ (ঐচ্ছিক)" class="border px-3 py-2.5 rounded-xl text-sm md:col-span-1">
      <button type="submit" class="px-4 py-2.5 bg-slate-800 text-white rounded-xl text-sm font-semibold">তৈরি করুন (পরে পারমিশন সেট করুন)</button>
    </form>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    ${roles.map(role => `
      <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-800">${escapeHtml(role.name)}</h3>
              ${role.is_system ? '<span class="px-2 py-0.5 text-xs font-bold rounded-full bg-slate-200 text-slate-600">System</span>' : '<span class="px-2 py-0.5 text-xs font-bold rounded-full bg-blue-100 text-blue-600">Custom</span>'}
            </div>
            <p class="text-xs text-slate-400 font-mono mt-0.5">${escapeHtml(role.key)}</p>
            <p class="text-xs text-slate-500 mt-1.5">${escapeHtml(role.description || '—')}</p>
            <p class="text-xs text-slate-400 mt-1.5"><i class="fas fa-users"></i> ${role.user_count} জন ইউজার</p>
          </div>
        </div>
        <div class="flex gap-2 mt-4 flex-wrap">
          <a href="/admin/roles/${role.id}/edit" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold"><i class="fas fa-pen"></i> Edit</a>
          <form method="POST" action="/admin/roles/${role.id}/clone" class="inline-flex gap-1">
            <input type="hidden" name="name" value="${escapeHtml(role.name)} (Copy)">
            <button type="submit" class="px-3 py-1.5 bg-amber-100 text-amber-700 rounded-lg text-xs font-semibold"><i class="fas fa-copy"></i> Clone</button>
          </form>
          ${!role.is_system ? `
          <form method="POST" action="/admin/roles/${role.id}/delete" onsubmit="return confirm('Role \\'${escapeHtml(role.name)}\\' ডিলিট করবেন?')" class="inline-flex">
            <button type="submit" class="px-3 py-1.5 bg-red-100 text-red-600 rounded-lg text-xs font-semibold"><i class="fas fa-trash"></i> Delete</button>
          </form>` : ''}
        </div>
      </div>
    `).join('') || '<p class="text-slate-400 text-center py-10 col-span-2">কোনো Role পাওয়া যায়নি।</p>'}
  </div>
</div>
`
}) %>

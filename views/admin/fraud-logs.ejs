<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmtDate(d) { return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); }
function riskBadge(level) {
  const map = {
    high: 'bg-red-100 text-red-700',
    medium: 'bg-amber-100 text-amber-700',
    low: 'bg-slate-100 text-slate-600'
  };
  return '<span class="px-3 py-1 text-xs font-bold rounded-full ' + (map[level] || map.low) + '">' + escapeHtml((level || '').toUpperCase()) + '</span>';
}
function statusBadge(status) {
  const map = {
    open: 'bg-blue-100 text-blue-700',
    reviewed: 'bg-emerald-100 text-emerald-700',
    dismissed: 'bg-slate-100 text-slate-500'
  };
  return '<span class="px-2.5 py-1 text-xs font-semibold rounded-full ' + (map[status] || map.open) + '">' + escapeHtml(status) + '</span>';
}
function logRow(l) {
  const userLabel = l.username ? escapeHtml(l.username) + ' <span class="text-slate-400">(#' + l.user_id + ')</span>' : '#' + l.user_id;
  const actions = l.status === 'open'
    ? '<div class="flex gap-1.5 justify-center">' +
        '<form method="POST" action="/admin/fraud-logs/' + l.id + '/review" style="display:inline">' +
          '<input type="hidden" name="action" value="reviewed">' +
          '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white">Reviewed</button>' +
        '</form>' +
        '<form method="POST" action="/admin/fraud-logs/' + l.id + '/review" style="display:inline">' +
          '<input type="hidden" name="action" value="dismiss">' +
          '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-400 hover:bg-slate-500 text-white">Dismiss</button>' +
        '</form>' +
      '</div>'
    : '<span class="text-xs text-slate-400">' + (l.reviewed_at ? fmtDate(l.reviewed_at) : '-') + '</span>';

  return '<tr class="hover:bg-slate-50 align-top">' +
    '<td class="px-6 py-4"><a href="/admin/users/' + l.user_id + '" class="font-semibold text-blue-600 hover:underline">' + userLabel + '</a></td>' +
    '<td class="px-6 py-4">' + riskBadge(l.risk_level) + '</td>' +
    '<td class="px-6 py-4 text-sm font-mono font-semibold text-slate-600">' + (l.risk_score != null ? l.risk_score : '-') + '</td>' +
    '<td class="px-6 py-4 text-sm text-slate-600 max-w-md">' + escapeHtml(l.reason) + '</td>' +
    '<td class="px-6 py-4">' + statusBadge(l.status) + '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-400">' + fmtDate(l.created_at) + '</td>' +
    '<td class="px-6 py-4 text-center">' + actions + '</td>' +
  '</tr>';
}
const rows = (logs || []).map(logRow).join('') || '<tr><td colspan="7" class="px-6 py-10 text-center text-slate-400">কোনো ফ্রড ফ্ল্যাগ পাওয়া যায়নি</td></tr>';
const f = filters || {};
function qs(overrides) {
  const merged = Object.assign({ risk_level: f.risk_level, status: f.status, user_id: f.user_id, from: f.from, to: f.to }, overrides);
  return Object.keys(merged).map(k => k + '=' + encodeURIComponent(merged[k] || '')).join('&');
}
%>
<%- include('partials/admin-layout', {
    title: 'Fraud Log',
    active: 'fraud-logs',
    body: `
<div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Fraud Log</h1>
            <p class="text-slate-500 mt-1 text-sm">মোট ${total || 0}টি ফ্রড ফ্ল্যাগ — শুধু রিভিউয়ের জন্য, অটোমেটিক ব্লক হয় না</p>
        </div>
    </div>

    <form method="GET" action="/admin/fraud-logs" class="flex flex-wrap gap-3 mb-6">
        <select name="risk_level" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <option value="">সব ঝুঁকির মাত্রা</option>
            <option value="high" ${f.risk_level === 'high' ? 'selected' : ''}>High</option>
            <option value="medium" ${f.risk_level === 'medium' ? 'selected' : ''}>Medium</option>
            <option value="low" ${f.risk_level === 'low' ? 'selected' : ''}>Low</option>
        </select>
        <select name="status" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <option value="">সব স্ট্যাটাস</option>
            <option value="open" ${f.status === 'open' ? 'selected' : ''}>Open</option>
            <option value="reviewed" ${f.status === 'reviewed' ? 'selected' : ''}>Reviewed</option>
            <option value="dismissed" ${f.status === 'dismissed' ? 'selected' : ''}>Dismissed</option>
        </select>
        <input type="text" name="user_id" value="${f.user_id || ''}" placeholder="ইউজার ID"
               class="w-32 border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-blue-300">
        <input type="date" name="from" value="${f.from || ''}" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        <input type="date" name="to" value="${f.to || ''}" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-2xl text-sm font-semibold">ফিল্টার</button>
        ${(f.risk_level || f.status || f.user_id || f.from || f.to) ? '<a href="/admin/fraud-logs" class="px-4 py-2.5 bg-slate-100 text-slate-600 rounded-2xl text-sm font-medium">রিসেট</a>' : ''}
    </form>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-hidden modern-table">
        <table class="w-full text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">User</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Risk</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Score</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Reason</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Status</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Date</th>
                    <th class="px-6 py-4 text-center font-medium text-slate-500 uppercase text-xs">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">${rows}</tbody>
        </table>
    </div>

    <div class="flex justify-center gap-3 mt-6">
        ${page > 1 ? '<a href="/admin/fraud-logs?page=' + (page - 1) + '&' + qs({}) + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">← আগের পেজ</a>' : ''}
        <span class="px-4 py-2 text-sm text-slate-500">পেজ ${page} / ${totalPages}</span>
        ${page < totalPages ? '<a href="/admin/fraud-logs?page=' + (page + 1) + '&' + qs({}) + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">পরের পেজ →</a>' : ''}
    </div>
</div>
`
}) %>

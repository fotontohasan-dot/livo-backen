<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const isSuperAdmin = role.key === 'super_admin';
%>
<%- include('partials/admin-layout', {
    title: 'Edit Role: ' + role.name,
    active: 'roles',
    body: `
<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-xl font-bold text-slate-800">✏️ ${escapeHtml(role.name)} <span class="text-sm font-normal text-slate-400">(${escapeHtml(role.key)})</span></h1>
    <a href="/admin/roles" class="text-sm text-slate-500"><i class="fas fa-arrow-left"></i> ফিরে যান</a>
  </div>

  ${isSuperAdmin ? `<div class="mb-4 bg-amber-50 border border-amber-200 text-amber-700 px-4 py-3 rounded-2xl text-sm">
    ⚠️ Super Admin Role-এর সব permission সবসময় ✅ চালু থাকে (override) — এখান থেকে বন্ধ করা যায় না।
  </div>` : ''}

  <form method="POST" action="/admin/roles/${role.id}" class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-5">
      <div>
        <label class="text-xs font-semibold text-slate-500">Role নাম</label>
        <input type="text" name="name" value="${escapeHtml(role.name)}" ${role.is_system ? 'readonly' : ''} class="w-full border px-3 py-2.5 rounded-xl text-sm mt-1 ${role.is_system ? 'bg-slate-50 text-slate-400' : ''}">
      </div>
      <div>
        <label class="text-xs font-semibold text-slate-500">বিবরণ</label>
        <input type="text" name="description" value="${escapeHtml(role.description || '')}" class="w-full border px-3 py-2.5 rounded-xl text-sm mt-1">
      </div>
    </div>

    ${Object.entries(permissionGroups).map(([group, perms]) => `
      <div class="mb-5">
        <p class="text-sm font-bold text-slate-700 mb-2 border-b pb-1">${escapeHtml(group)}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          ${perms.map(p => `
            <label class="flex items-center gap-2 text-sm py-1">
              <input type="checkbox" name="perm_${p.key}" ${(role.permissions && role.permissions[p.key]) || isSuperAdmin ? 'checked' : ''} ${isSuperAdmin ? 'disabled' : ''} class="w-4 h-4 rounded">
              <span>${escapeHtml(p.label)}</span>
            </label>
          `).join('')}
        </div>
      </div>
    `).join('')}

    <button type="submit" class="px-5 py-2.5 bg-slate-800 text-white rounded-xl text-sm font-semibold"><i class="fas fa-check"></i> সেভ করুন</button>
  </form>
</div>
`
}) %>

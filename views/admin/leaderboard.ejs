<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_leaderboard') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz25-1 { padding: 12px 16px; margin-bottom: 14px; background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.3); color: #10b981; font-weight: 700; font-size: 13px; }
  .dz25-2 { padding: 12px 16px; margin-bottom: 14px; background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3); color: #ef4444; font-weight: 700; font-size: 13px; }
  .dz25-3 { margin-bottom: 14px; }
  .dz25-4 { color: #f59e0b; }
  .dz25-5 { color: #10b981; }
  .dz25-6 { padding: 14px; margin-bottom: 14px; }
  .dz25-7 { display: flex; gap: 10px; flex-wrap: wrap; }
  .dz25-8 { flex: 1; min-width: 220px; }
  .dz25-9 { max-width: 200px; }
  .dz25-10 { margin-bottom: 20px; }
  .dz25-11 { overflow-x: auto; }
  .dz25-12 { text-align: right; }
  .dz25-13 { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
  .dz25-14 { color: var(--text-muted); }
  .dz25-15 { font-weight: 700; }
  .dz25-16 { font-size: 11px; color: var(--text-muted); }
  .dz25-17 { font-weight: 700; color: #f59e0b; }
  .dz25-18 { text-align: right; white-space: nowrap; }
  .dz25-19 { display: inline; }
  .dz25-20 { display: flex; justify-content: center; gap: 10px; margin-bottom: 24px; }
  .dz25-21 { padding: 9px 12px; color: var(--text-muted); font-size: 12px; }
  .dz25-22 { float: right; margin-left: 8px; }
  .dz25-23 { float: right; }
  .dz25-24 { padding: 0 14px 14px; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .lb-rank { font-weight: 800; }
    .lb-rank-1 { color: #f59e0b; }
    .lb-rank-2 { color: #cbd5e1; }
    .lb-rank-3 { color: #d97706; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'leaderboard' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'লিডারবোর্ড ম্যানেজমেন্ট', pageSubtitle: 'পয়েন্ট র‍্যাঙ্কিং, রেফারেল কনটেস্ট প্রাইজ ও মডারেশন — এক জায়গায়' }) %>

      <% if (saved) { %>
        <div class="admin-card dz25-1">
          <i class="fas fa-check-circle"></i> <%= t('admin_msg_updated_successfully') %>
        </div>
      <% } %>
      <% if (saveError) { %>
        <div class="admin-card dz25-2">
          <i class="fas fa-circle-exclamation"></i> <%= saveError %>
        </div>
      <% } %>

      <div class="grid grid-4 dz25-3">
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_users_role_user') %></div><div class="stat-number"><%= total %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_label_on_this_page') %></div><div class="stat-number"><%= entries.length %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_public_top50') %></div><div class="stat-number dz25-4">50</div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_current_month_contest') %></div><div class="stat-number dz25-5"><%= contest.monthName || '—' %></div></div>
      </div>

      <!-- ==================== পয়েন্ট লিডারবোর্ড: সার্চ/ফিল্টার ==================== -->
      <div class="admin-card dz25-6">
        <form class="dz25-7" method="GET" action="/admin/leaderboard">
          <input class="input dz25-8" type="text" name="search" value="<%= search || '' %>" placeholder="<%= t('admin_ph_search_user_email_phone') %>">
          <select class="select dz25-9" name="status">
            <option value=""><%= t('admin_filter_all_status') %></option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>><%= t('admin_status_active_ranked') %></option>
            <option value="banned" <%= status === 'banned' ? 'selected' : '' %>><%= t('admin_status_banned') %></option>
          </select>
          <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> <%= t('admin_btn_search') %></button>
          <% if (search || status) { %>
            <a class="btn" href="/admin/leaderboard"><%= t('admin_btn_reset') %></a>
          <% } %>
        </form>
      </div>

      <!-- ==================== পয়েন্ট লিডারবোর্ড: টেবিল ==================== -->
      <div class="admin-card dz25-10">
        <div class="admin-card-header">পয়েন্ট র‍্যাঙ্কিং (মোট <%= total %> জন ইউজার)</div>
        <div class="dz25-11">
          <table class="admin-table">
            <thead>
              <tr>
                <th><%= t('admin_col_rank') %></th>
                <th><%= t('admin_col_user') %></th>
                <th><%= t('admin_col_points') %></th>
                <th><%= t('admin_col_coins') %></th>
                <th><%= t('admin_col_wins_total_bets') %></th>
                <th><%= t('admin_col_status') %></th>
                <th class="dz25-12"><%= t('admin_col_action') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (entries && entries.length > 0) { %>
                <% entries.forEach(u => { %>
                  <tr>
                    <td>
                      <% if (u.rank) { %>
                        <span class="lb-rank <%= u.rank == 1 ? 'lb-rank-1' : (u.rank == 2 ? 'lb-rank-2' : (u.rank == 3 ? 'lb-rank-3' : '')) %>">#<%= u.rank %></span>
                        <% if (u.rank <= 50) { %>
                          <div class="dz25-13"><%= t('admin_in_public_top50') %></div>
                        <% } %>
                      <% } else { %>
                        <span class="dz25-14">—</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="dz25-15">@<%= u.username %></div>
                      <div class="dz25-16">#<%= u.id %><% if (u.email) { %> · <%= u.email %><% } %></div>
                    </td>
                    <td class="dz25-17"><%= Number(u.total_points || 0).toLocaleString('en-US') %></td>
                    <td><%= Number(u.coins || 0).toLocaleString('en-US') %></td>
                    <td><%= u.wins %> / <%= u.total_bets %></td>
                    <td>
                      <% if (u.is_banned) { %>
                        <span class="badge badge-red"><%= t('admin_status_banned') %></span>
                      <% } else { %>
                        <span class="badge badge-green"><%= t('admin_status_active') %></span>
                      <% } %>
                    </td>
                    <td class="dz25-18">
                      <a class="btn btn-sm" href="/admin/users/<%= u.id %>"><%= t('admin_col_profile') %></a>
                      <form class="dz25-19" method="POST" action="/admin/leaderboard/<%= u.id %>/toggle-ban" data-confirm="<%= u.is_banned ? 'আনব্যান' : 'ব্যান' %> করবেন? এটা পাবলিক লিডারবোর্ডের র‍্যাঙ্কিংও বদলে দেবে।">
                        <input type="hidden" name="page" value="<%= page %>">
                        <input type="hidden" name="search" value="<%= search || '' %>">
                        <input type="hidden" name="status" value="<%= status || '' %>">
                        <button type="submit" class="btn btn-sm <%= u.is_banned ? 'btn-green' : 'btn-red' %>"><%= u.is_banned ? 'আনব্যান' : 'ব্যান' %></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7"><div class="empty-state"><%= t('admin_empty_users') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="dz25-20">
        <% if (page > 1) { %>
          <a class="btn" href="/admin/leaderboard?page=<%= page - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status || '' %>">&larr; <%= t('admin_pagination_prev') %></a>
        <% } %>
        <span class="dz25-21">পেজ <%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a class="btn" href="/admin/leaderboard?page=<%= page + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status || '' %>"><%= t('admin_pagination_next') %> &rarr;</a>
        <% } %>
      </div>

      <!-- ==================== রেফারেল কনটেস্ট (প্রাইজ/রিওয়ার্ড) ==================== -->
      <div class="admin-card dz25-10">
        <div class="admin-card-header">
          চলতি মাসের রেফারেল কনটেস্ট<% if (contest.monthName) { %> — <%= contest.monthName %><% } %>
          <a href="/admin/leaderboard/contest/payouts" class="btn btn-sm dz25-22"><i class="fas fa-money-check-dollar"></i> <%= t('admin_payout_tracking') %></a>
          <button type="button" class="btn btn-sm dz25-23" data-load-history><i class="fas fa-clock-rotate-left"></i> <%= t('admin_previous_months') %></button>
        </div>
        <div class="dz25-11">
          <table class="admin-table">
            <thead>
              <tr><th><%= t('admin_col_rank') %></th><th><%= t('admin_col_user') %></th><th><%= t('admin_col_referrals') %></th><th><%= t('admin_col_prize') %></th></tr>
            </thead>
            <tbody>
              <% if (contest.leaders && contest.leaders.length > 0) { %>
                <% contest.leaders.forEach(l => { %>
                  <tr>
                    <td class="lb-rank <%= l.rank == 1 ? 'lb-rank-1' : (l.rank == 2 ? 'lb-rank-2' : (l.rank == 3 ? 'lb-rank-3' : '')) %>">#<%= l.rank %></td>
                    <td>@<%= l.username %></td>
                    <td><%= l.referrals %></td>
                    <td><%= l.prize || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4"><div class="empty-state"><%= t('admin_empty_month_referrals') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="dz25-24" id="contestHistory"></div>
      </div>

    </div>
  </div>

  <script src="/js/views/admin-leaderboard.js"></script>
</body>
</html>

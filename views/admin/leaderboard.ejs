<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_leaderboard') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .lb-rank { font-weight: 800; }
    .lb-rank-1 { color: #f59e0b; }
    .lb-rank-2 { color: #cbd5e1; }
    .lb-rank-3 { color: #d97706; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'leaderboard' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'লিডারবোর্ড ম্যানেজমেন্ট', pageSubtitle: 'পয়েন্ট র‍্যাঙ্কিং, রেফারেল কনটেস্ট প্রাইজ ও মডারেশন — এক জায়গায়' }) %>

      <% if (saved) { %>
        <div class="admin-card" style="padding:12px 16px;margin-bottom:14px;background:rgba(16,185,129,0.1);border-color:rgba(16,185,129,0.3);color:#10b981;font-weight:700;font-size:13px;">
          <i class="fas fa-check-circle"></i> <%= t('admin_msg_updated_successfully') %>
        </div>
      <% } %>
      <% if (saveError) { %>
        <div class="admin-card" style="padding:12px 16px;margin-bottom:14px;background:rgba(239,68,68,0.1);border-color:rgba(239,68,68,0.3);color:#ef4444;font-weight:700;font-size:13px;">
          <i class="fas fa-circle-exclamation"></i> <%= saveError %>
        </div>
      <% } %>

      <div class="grid grid-4" style="margin-bottom:14px;">
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_users_role_user') %></div><div class="stat-number"><%= total %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_label_on_this_page') %></div><div class="stat-number"><%= entries.length %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_public_top50') %></div><div class="stat-number" style="color:#f59e0b;">50</div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_current_month_contest') %></div><div class="stat-number" style="color:#10b981;"><%= contest.monthName || '—' %></div></div>
      </div>

      <!-- ==================== পয়েন্ট লিডারবোর্ড: সার্চ/ফিল্টার ==================== -->
      <div class="admin-card" style="padding:14px;margin-bottom:14px;">
        <form method="GET" action="/admin/leaderboard" style="display:flex;gap:10px;flex-wrap:wrap;">
          <input class="input" style="flex:1;min-width:220px;" type="text" name="search" value="<%= search || '' %>" placeholder="<%= t('admin_ph_search_user_email_phone') %>">
          <select class="select" style="max-width:200px;" name="status">
            <option value=""><%= t('admin_filter_all_status') %></option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>><%= t('admin_status_active_ranked') %></option>
            <option value="banned" <%= status === 'banned' ? 'selected' : '' %>><%= t('admin_status_banned') %></option>
          </select>
          <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> <%= t('admin_btn_search') %></button>
          <% if (search || status) { %>
            <a class="btn" href="/admin/leaderboard"><%= t('admin_btn_reset') %></a>
          <% } %>
        </form>
      </div>

      <!-- ==================== পয়েন্ট লিডারবোর্ড: টেবিল ==================== -->
      <div class="admin-card" style="margin-bottom:20px;">
        <div class="admin-card-header">পয়েন্ট র‍্যাঙ্কিং (মোট <%= total %> জন ইউজার)</div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th><%= t('admin_col_rank') %></th>
                <th><%= t('admin_col_user') %></th>
                <th><%= t('admin_col_points') %></th>
                <th><%= t('admin_col_coins') %></th>
                <th><%= t('admin_col_wins_total_bets') %></th>
                <th><%= t('admin_col_status') %></th>
                <th style="text-align:right;"><%= t('admin_col_action') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (entries && entries.length > 0) { %>
                <% entries.forEach(u => { %>
                  <tr>
                    <td>
                      <% if (u.rank) { %>
                        <span class="lb-rank <%= u.rank == 1 ? 'lb-rank-1' : (u.rank == 2 ? 'lb-rank-2' : (u.rank == 3 ? 'lb-rank-3' : '')) %>">#<%= u.rank %></span>
                        <% if (u.rank <= 50) { %>
                          <div style="font-size:10px;color:var(--text-muted);margin-top:2px;"><%= t('admin_in_public_top50') %></div>
                        <% } %>
                      <% } else { %>
                        <span style="color:var(--text-muted);">—</span>
                      <% } %>
                    </td>
                    <td>
                      <div style="font-weight:700;">@<%= u.username %></div>
                      <div style="font-size:11px;color:var(--text-muted);">#<%= u.id %><% if (u.email) { %> · <%= u.email %><% } %></div>
                    </td>
                    <td style="font-weight:700;color:#f59e0b;"><%= Number(u.total_points || 0).toLocaleString('en-US') %></td>
                    <td><%= Number(u.coins || 0).toLocaleString('en-US') %></td>
                    <td><%= u.wins %> / <%= u.total_bets %></td>
                    <td>
                      <% if (u.is_banned) { %>
                        <span class="badge badge-red"><%= t('admin_status_banned') %></span>
                      <% } else { %>
                        <span class="badge badge-green"><%= t('admin_status_active') %></span>
                      <% } %>
                    </td>
                    <td style="text-align:right;white-space:nowrap;">
                      <a class="btn btn-sm" href="/admin/users/<%= u.id %>"><%= t('admin_col_profile') %></a>
                      <form method="POST" action="/admin/leaderboard/<%= u.id %>/toggle-ban" style="display:inline" onsubmit="return confirm('<%= u.is_banned ? 'আনব্যান' : 'ব্যান' %> করবেন? এটা পাবলিক লিডারবোর্ডের র‍্যাঙ্কিংও বদলে দেবে।')">
                        <input type="hidden" name="page" value="<%= page %>">
                        <input type="hidden" name="search" value="<%= search || '' %>">
                        <input type="hidden" name="status" value="<%= status || '' %>">
                        <button type="submit" class="btn btn-sm <%= u.is_banned ? 'btn-green' : 'btn-red' %>"><%= u.is_banned ? 'আনব্যান' : 'ব্যান' %></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7"><div class="empty-state"><%= t('admin_empty_users') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div style="display:flex;justify-content:center;gap:10px;margin-bottom:24px;">
        <% if (page > 1) { %>
          <a class="btn" href="/admin/leaderboard?page=<%= page - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status || '' %>">&larr; <%= t('admin_pagination_prev') %></a>
        <% } %>
        <span style="padding:9px 12px;color:var(--text-muted);font-size:12px;">পেজ <%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a class="btn" href="/admin/leaderboard?page=<%= page + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= status || '' %>"><%= t('admin_pagination_next') %> &rarr;</a>
        <% } %>
      </div>

      <!-- ==================== রেফারেল কনটেস্ট (প্রাইজ/রিওয়ার্ড) ==================== -->
      <div class="admin-card" style="margin-bottom:20px;">
        <div class="admin-card-header">
          চলতি মাসের রেফারেল কনটেস্ট<% if (contest.monthName) { %> — <%= contest.monthName %><% } %>
          <a href="/admin/leaderboard/contest/payouts" class="btn btn-sm" style="float:right;margin-left:8px;"><i class="fas fa-money-check-dollar"></i> <%= t('admin_payout_tracking') %></a>
          <button type="button" class="btn btn-sm" style="float:right;" onclick="loadContestHistory()"><i class="fas fa-clock-rotate-left"></i> <%= t('admin_previous_months') %></button>
        </div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr><th><%= t('admin_col_rank') %></th><th><%= t('admin_col_user') %></th><th><%= t('admin_col_referrals') %></th><th><%= t('admin_col_prize') %></th></tr>
            </thead>
            <tbody>
              <% if (contest.leaders && contest.leaders.length > 0) { %>
                <% contest.leaders.forEach(l => { %>
                  <tr>
                    <td class="lb-rank <%= l.rank == 1 ? 'lb-rank-1' : (l.rank == 2 ? 'lb-rank-2' : (l.rank == 3 ? 'lb-rank-3' : '')) %>">#<%= l.rank %></td>
                    <td>@<%= l.username %></td>
                    <td><%= l.referrals %></td>
                    <td><%= l.prize || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4"><div class="empty-state"><%= t('admin_empty_month_referrals') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div id="contestHistory" style="padding:0 14px 14px;"></div>
      </div>

    </div>
  </div>

  <script>
    // username ইউজার-নিয়ন্ত্রিত — আগে সরাসরি innerHTML স্ট্রিং-এ বসানো হতো, ফলে
    // একজন ইউজার নিজের নামে HTML রেখে অ্যাডমিনের লিডারবোর্ড পেজে স্ক্রিপ্ট চালাতে পারত।
    function esc(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    async function loadContestHistory() {
      const box = document.getElementById('contestHistory');
      box.innerHTML = '<p style="color:var(--text-muted);font-size:12px;">লোড হচ্ছে...</p>';
      try {
        const res = await fetch('/admin/leaderboard/contest/history?months=3');
        const data = await res.json();
        if (!data.success || !data.past || !data.past.length) {
          box.innerHTML = '<p style="color:var(--text-muted);font-size:12px;">আগের কোনো মাসের কনটেস্ট রেজাল্ট নেই।</p>';
          return;
        }
        box.innerHTML = data.past.map(function (m) {
          const rows = m.leaders.map(function (l) {
            return '<tr><td class="lb-rank">#' + esc(l.rank) + '</td><td>@' + esc(l.username) + '</td><td>' + esc(l.referrals) + '</td><td>' + esc(l.prize || '—') + '</td></tr>';
          }).join('');
          return '<div style="margin-top:14px;"><div style="font-weight:700;color:var(--text-muted);font-size:13px;margin-bottom:6px;">' + esc(m.monthName) + '</div>' +
            '<table class="admin-table"><thead><tr><th>র‍্যাঙ্ক</th><th>ইউজার</th><th>রেফারেল</th><th>প্রাইজ</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
        }).join('');
      } catch (e) {
        box.innerHTML = '<p style="color:#ef4444;font-size:12px;">লোড করা যায়নি: ' + esc(e.message) + '</p>';
      }
    }
  </script>
</body>
</html>

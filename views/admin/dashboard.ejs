<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <!-- Main Content -->
  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Welcome -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Welcome back, Admin 👋</h1>
      <p class="text-gray-400 mt-1">Here's what's happening with your platform today.</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Total Users</div>
        <div class="text-4xl font-bold text-white mt-2"><%= stats.total_users || 0 %></div>
      </div>
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Total Coins</div>
        <div class="text-4xl font-bold text-white mt-2"><%= (stats.total_coins_in_system || 0).toLocaleString() %></div>
      </div>
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Today's Deposit</div>
        <div class="text-4xl font-bold text-emerald-400 mt-2">৳<%= stats.today_deposit || 0 %></div>
        <div class="text-xs text-emerald-400/70 mt-1"><%= stats.today_deposit_count || 0 %> transactions</div>
      </div>
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Today's Withdraw</div>
        <div class="text-4xl font-bold text-red-400 mt-2">৳<%= stats.today_withdraw || 0 %></div>
        <div class="text-xs text-red-400/70 mt-1"><%= stats.today_withdraw_count || 0 %> requests</div>
      </div>
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Today's Bets</div>
        <div class="text-4xl font-bold text-white mt-2">৳<%= stats.today_bet_amount || 0 %></div>
        <div class="text-xs text-gray-500 mt-1"><%= stats.today_bet_count || 0 %> bets</div>
      </div>
      <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155]">
        <div class="text-gray-400 text-sm">Today's Profit</div>
        <div class="text-4xl font-bold text-[#f59e0b] mt-2">৳<%= stats.today_profit || 0 %></div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mb-8">
      <h3 class="text-white font-semibold mb-3 text-lg">Quick Actions</h3>
      <div class="flex flex-wrap gap-3">
        <a href="/admin/users" class="px-5 py-2.5 bg-[#334155] hover:bg-[#475569] text-white rounded-2xl text-sm flex items-center gap-2 transition">
          <i class="fas fa-user-plus"></i> <span>Manage Users</span>
        </a>
        <a href="/admin/matches" class="px-5 py-2.5 bg-[#334155] hover:bg-[#475569] text-white rounded-2xl text-sm flex items-center gap-2 transition">
          <i class="fas fa-plus"></i> <span>Add Match</span>
        </a>
        <a href="/admin/settings" class="px-5 py-2.5 bg-[#334155] hover:bg-[#475569] text-white rounded-2xl text-sm flex items-center gap-2 transition">
          <i class="fas fa-cog"></i> <span>Site Settings</span>
        </a>
      </div>
    </div>

    <!-- Recent Activity Tables -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Recent Bets -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex justify-between items-center mb-5">
          <h3 class="font-semibold text-white">Recent Bets</h3>
          <a href="/admin/bets" class="text-[#f59e0b] text-sm hover:underline">View all →</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-gray-400 border-b border-[#334155]">
                <th class="text-left pb-3 font-normal">User</th>
                <th class="text-left pb-3 font-normal">Match</th>
                <th class="text-right pb-3 font-normal">Stake</th>
                <th class="text-center pb-3 font-normal">Status</th>
              </tr>
            </thead>
            <tbody class="text-gray-300">
              <% recentBets.forEach(bet => { %>
              <tr class="border-b border-[#334155] last:border-none">
                <td class="py-3"><%= bet.username %></td>
                <td class="py-3 text-xs"><%= bet.team_a %> vs <%= bet.team_b %></td>
                <td class="py-3 text-right font-medium">৳<%= bet.stake %></td>
                <td class="py-3 text-center">
                  <% if(bet.status === 'won') { %>
                    <span class="px-3 py-0.5 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Won</span>
                  <% } else if(bet.status === 'lost') { %>
                    <span class="px-3 py-0.5 text-xs rounded-full bg-red-500/20 text-red-400">Lost</span>
                  <% } else { %>
                    <span class="px-3 py-0.5 text-xs rounded-full bg-yellow-500/20 text-yellow-400">Pending</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Users -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex justify-between items-center mb-5">
          <h3 class="font-semibold text-white">New Users</h3>
          <a href="/admin/users" class="text-[#f59e0b] text-sm hover:underline">View all →</a>
        </div>
        <div class="space-y-4">
          <% recentUsers.forEach(u => { %>
          <div class="flex items-center justify-between">
            <div>
              <div class="font-medium text-white"><%= u.username %></div>
              <div class="text-xs text-gray-500"><%= new Date(u.created_at).toLocaleDateString() %></div>
            </div>
            <div class="text-right">
              <div class="text-emerald-400 font-semibold">৳<%= u.coins || 0 %></div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

    </div>

  </main>
</div>

<script>
  // Mobile sidebar toggle
  document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
    const sidebar = document.getElementById('admin-sidebar');
    sidebar.classList.toggle('-translate-x-full');
  });
</script>

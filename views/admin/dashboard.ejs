<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmt(n) { return Number(n||0).toLocaleString('en-US'); }
function fmtBDT(n) { return '৳ ' + fmt(n); }
function fmtDate(d) { return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric'}); }

const s = stats || {};
const rf = revenueTrend || [];
const ug = userGrowth   || [];
const bs = betStats7    || [];
const sc = securitySummary || {};
const qh = queueHealth  || {};
const kc = kycSummary   || {};
const td = topDepositors|| [];
const ra = recentActivity || [];
const ds = demoStats    || {};
const rs = redisStatus  || {};
const fa = fraudAlerts  || {};
const da = dupAlerts    || {};
const rff= recentFraudFlags || [];
const rdf= recentDupFlags   || [];

// Chart data JSON strings
const revLabels  = JSON.stringify(rf.map(r => fmtDate(r.day)));
const revDep     = JSON.stringify(rf.map(r => Number(r.deposit)));
const revWit     = JSON.stringify(rf.map(r => Number(r.withdraw)));
const ugLabels   = JSON.stringify(ug.map(r => fmtDate(r.day)));
const ugCounts   = JSON.stringify(ug.map(r => r.count));
const bsLabels   = JSON.stringify(bs.map(r => fmtDate(r.day)));
const bsCnts     = JSON.stringify(bs.map(r => r.cnt));
const bsGGR      = JSON.stringify(bs.map(r => Math.max(0, r.ggr||0)));
%>
<%- include('partials/admin-layout', {
  title: 'Dashboard',
  active: 'dashboard',
  body: `
<div class="max-w-7xl mx-auto" id="dash-root">

<!-- ===== HEADER ===== -->
<div class="flex flex-wrap items-end justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">ড্যাশবোর্ড</h1>
    <p class="text-slate-500 text-sm mt-0.5">সর্বশেষ আপডেট: <span id="current-time"></span></p>
  </div>
  <div class="flex flex-wrap gap-2 items-center">
    <select id="range-select" onchange="changeRange(this.value)" class="border border-slate-200 rounded-2xl px-4 py-2 text-sm">
      <option value="7">গত ৭ দিন</option>
      <option value="14" selected>গত ১৪ দিন</option>
      <option value="30">গত ৩০ দিন</option>
      <option value="90">গত ৯০ দিন</option>
    </select>
    <button onclick="exportCSV()" class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-2xl text-sm font-semibold hover:bg-slate-50">
      <i class="fas fa-download mr-1"></i> Export
    </button>
    <button onclick="refreshAll()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-sm font-semibold">
      <i class="fas fa-rotate-right mr-1" id="refresh-icon"></i> রিফ্রেশ
    </button>
    <span class="px-3 py-2 rounded-2xl text-xs font-semibold ${rs.connected ? 'bg-emerald-100 text-emerald-700' : (rs.enabled ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-500')}">
      <i class="fas fa-database mr-1"></i>Redis: ${rs.connected ? 'Connected' : (rs.enabled ? 'Disconnected' : 'Disabled')}
    </span>
  </div>
</div>

<!-- ===== KPI CARDS ===== -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
  ${[
    { label:'মোট ব্যবহারকারী',  val: fmt(s.total_users),         sub:'+'+fmt(s.new_users_today)+' আজ',   icon:'fa-users',          color:'blue'   },
    { label:'সক্রিয় (১৫ মিনিট)',val: fmt(s.active_users_now),   sub:'লাইভ',                              icon:'fa-signal',         color:'emerald'},
    { label:'আজ ডিপোজিট',      val: fmtBDT(s.today_deposit),    sub:fmt(s.today_deposit_count)+' টি',   icon:'fa-arrow-down',     color:'emerald'},
    { label:'আজ উইথড্র',        val: fmtBDT(s.today_withdraw),  sub:fmt(s.today_withdraw_count)+' টি',  icon:'fa-arrow-up',       color:'amber'  },
    { label:'আজ GGR',           val: fmtBDT(s.today_profit),     sub:fmt(s.today_bet_count)+' বেট',      icon:'fa-chart-line',     color:'emerald'},
    { label:'পেন্ডিং অ্যাকশন', val: String(s.pending_total||0), sub:fmt(s.pending_deposits)+' dep · '+fmt(s.pending_withdrawals)+' wit', icon:'fa-clock', color:'orange'},
  ].map(c => `
  <div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm">
    <div class="flex justify-between items-start mb-2">
      <p class="text-xs text-slate-500 font-medium leading-tight">${c.label}</p>
      <div class="w-8 h-8 bg-${c.color}-100 text-${c.color}-600 rounded-xl flex items-center justify-center flex-shrink-0">
        <i class="fas ${c.icon} text-sm"></i>
      </div>
    </div>
    <p class="text-xl font-bold text-slate-900">${c.val}</p>
    <p class="text-xs text-slate-400 mt-0.5">${c.sub}</p>
  </div>`).join('')}
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
  <!-- Revenue Chart -->
  <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">💰 Revenue Trend</h3>
      <div class="flex gap-3 text-xs text-slate-500">
        <span class="flex items-center gap-1"><span class="w-3 h-1 bg-emerald-500 rounded inline-block"></span>Deposit</span>
        <span class="flex items-center gap-1"><span class="w-3 h-1 bg-amber-400 rounded inline-block"></span>Withdraw</span>
      </div>
    </div>
    <div style="position:relative;height:200px"><canvas id="revenueChart"></canvas></div>
  </div>

  <!-- User Growth -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">👥 User Growth</h3>
    <div style="position:relative;height:200px"><canvas id="userChart"></canvas></div>
  </div>
</div>

<!-- ===== BET STATS + SECURITY ROW ===== -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
  <!-- Bet Stats 7-day -->
  <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">🎯 Bet Statistics (৭ দিন)</h3>
      <a href="/admin/reports" class="text-xs text-blue-600 hover:underline">বিস্তারিত →</a>
    </div>
    <div style="position:relative;height:170px"><canvas id="betChart"></canvas></div>
    <div class="grid grid-cols-3 gap-3 mt-4">
      <div class="bg-slate-50 rounded-2xl p-3 text-center">
        <p class="text-xs text-slate-500">মোট বেট</p>
        <p class="font-bold text-slate-800">${fmt(bs.reduce((a,r)=>a+r.cnt,0))}</p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-3 text-center">
        <p class="text-xs text-slate-500">মোট বেটকৃত</p>
        <p class="font-bold text-emerald-600">${fmtBDT(bs.reduce((a,r)=>a+r.staked,0))}</p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-3 text-center">
        <p class="text-xs text-slate-500">GGR (৭ দিন)</p>
        <p class="font-bold text-blue-600">${fmtBDT(bs.reduce((a,r)=>a+(r.ggr||0),0))}</p>
      </div>
    </div>
  </div>

  <!-- Security Summary -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">🛡️ Security</h3>
      <a href="/admin/diagnostics" class="text-xs text-blue-600 hover:underline">Diagnostics →</a>
    </div>
    <div class="space-y-3">
      ${[
        { label:'Fraud Alerts (Open)',    val: (sc.open_fraud||0),   color: sc.open_fraud>0?'red':'slate',    link:'/admin/fraud-logs'         },
        { label:'Duplicate Accounts',    val: (sc.open_dup||0),     color: sc.open_dup>0?'amber':'slate',   link:'/admin/duplicate-accounts' },
        { label:'Bot Activity (24h)',     val: (sc.bot_high_24h||0), color: sc.bot_high_24h>0?'amber':'slate',link:'/admin/bot-logs'           },
        { label:'Banned Users',           val: (sc.banned_users||0), color: sc.banned_users>0?'red':'slate',  link:'/admin/users?status=banned' },
      ].map(i=>`
      <a href="${i.link}" class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl hover:bg-slate-100 transition">
        <span class="text-sm text-slate-600">${i.label}</span>
        <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-${i.color}-100 text-${i.color}-700">${fmt(i.val)}</span>
      </a>`).join('')}
    </div>
    <!-- KYC -->
    <div class="mt-4 pt-4 border-t border-slate-100">
      <p class="text-xs text-slate-500 mb-2 font-medium">KYC Status</p>
      <div class="flex gap-2">
        <span class="px-2.5 py-1 bg-amber-50 text-amber-700 text-xs rounded-xl font-semibold">Pending: ${kc.pending||0}</span>
        <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs rounded-xl font-semibold">Approved: ${kc.approved||0}</span>
        <span class="px-2.5 py-1 bg-red-50 text-red-700 text-xs rounded-xl font-semibold">Rejected: ${kc.rejected||0}</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== QUEUE + DEMO + TOP DEPOSITORS ===== -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
  <!-- Queue Health -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">📋 Queue System</h3>
      <span class="px-2.5 py-1 text-xs font-bold rounded-full ${qh.redisConnected ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}">${qh.redisConnected ? 'Connected' : 'Offline'}</span>
    </div>
    <div class="grid grid-cols-3 gap-2">
      ${[
        { label:'Active',  val: qh.totalActive||0,  color:'blue'   },
        { label:'Waiting', val: qh.totalWaiting||0, color:'amber'  },
        { label:'Failed',  val: qh.totalFailed||0,  color:'red'    },
      ].map(q=>`
      <div class="bg-slate-50 rounded-2xl p-3 text-center">
        <p class="text-xs text-slate-500">${q.label}</p>
        <p class="font-bold text-${q.color}-600 text-lg">${fmt(q.val)}</p>
      </div>`).join('')}
    </div>
    <a href="/admin/diagnostics" class="mt-3 flex items-center justify-center gap-2 py-2.5 bg-slate-50 hover:bg-slate-100 rounded-2xl text-sm text-slate-600 transition font-medium">
      <i class="fas fa-heart-pulse"></i> System Diagnostics
    </a>
  </div>

  <!-- Demo Currency -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">🎮 ডেমো কারেন্সি</h3>
    <div class="grid grid-cols-2 gap-3">
      ${[
        { label:'মোট ডেমো',         id:'demo-total',  val: fmt(ds.totalDemo),           color:'slate'  },
        { label:'ব্যবহারকারীর কাছে', id:'demo-held',   val: fmt(ds.userHeldDemo),        color:'blue'   },
        { label:'ক্যাসিনো বেট',      id:'demo-casino', val: fmt(ds.casinoDemoWagered),   color:'purple' },
        { label:'স্পোর্টস বেট',      id:'demo-sports', val: fmt(ds.sportsDemoWagered),   color:'orange' },
      ].map(d=>`
      <div class="bg-slate-50 rounded-2xl p-3">
        <p class="text-xs text-slate-500">${d.label}</p>
        <p class="font-bold text-${d.color}-600 text-sm mt-0.5" id="${d.id}">${d.val}</p>
      </div>`).join('')}
    </div>
  </div>

  <!-- Top Depositors Today -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4">🏆 আজকের শীর্ষ ডিপোজিটকারী</h3>
    ${td.length ? td.map((u,i)=>`
    <div class="flex items-center justify-between py-2 ${i>0?'border-t border-slate-50':''}">
      <div class="flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-slate-100 text-xs font-bold text-slate-500 flex items-center justify-center">${i+1}</span>
        <span class="text-sm font-medium text-slate-700">${escapeHtml(u.username)}</span>
      </div>
      <span class="text-sm font-bold text-emerald-600">${fmtBDT(u.total)}</span>
    </div>`).join('') : '<p class="text-sm text-slate-400 text-center py-4">আজ কোনো ডিপোজিট নেই</p>'}
  </div>
</div>

<!-- ===== FRAUD + DUPLICATE ALERTS ===== -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <!-- Fraud Alerts -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">🛡️ Fraud Alerts <span class="text-xs font-normal text-slate-400">ওপেন</span></h3>
      <a href="/admin/fraud-logs" class="text-xs text-blue-600 hover:underline">সব →</a>
    </div>
    <div class="grid grid-cols-3 gap-3 mb-3">
      <div class="p-3 rounded-2xl ${fa.high>0?'bg-red-50':'bg-slate-50'} text-center">
        <p class="text-xs text-slate-500">High</p>
        <p class="text-xl font-bold ${fa.high>0?'text-red-600':'text-slate-700'}">${fa.high||0}</p>
      </div>
      <div class="p-3 rounded-2xl ${fa.medium>0?'bg-amber-50':'bg-slate-50'} text-center">
        <p class="text-xs text-slate-500">Medium</p>
        <p class="text-xl font-bold ${fa.medium>0?'text-amber-600':'text-slate-700'}">${fa.medium||0}</p>
      </div>
      <div class="p-3 rounded-2xl bg-slate-50 text-center">
        <p class="text-xs text-slate-500">Low</p>
        <p class="text-xl font-bold text-slate-700">${fa.low||0}</p>
      </div>
    </div>
    ${rff.length ? rff.map(f=>{
      const rc = f.risk_level==='high'?'bg-red-100 text-red-700':(f.risk_level==='medium'?'bg-amber-100 text-amber-700':'bg-slate-100 text-slate-600');
      return '<div class="flex items-center justify-between py-2 border-t border-slate-50">'+
        '<a href="/admin/users/'+f.user_id+'" class="text-sm font-semibold text-blue-600 hover:underline">'+(f.username?escapeHtml(f.username):'#'+f.user_id)+'</a>'+
        '<span class="px-2.5 py-1 text-xs font-bold rounded-full '+rc+'">'+f.risk_level.toUpperCase()+'</span>'+
      '</div>';
    }).join('') : '<p class="text-xs text-slate-400 text-center py-2">কোনো ফ্ল্যাগ নেই</p>'}
  </div>

  <!-- Duplicate Accounts -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">🧬 Duplicate Accounts <span class="text-xs font-normal text-slate-400">ওপেন</span></h3>
      <a href="/admin/duplicate-accounts" class="text-xs text-blue-600 hover:underline">সব →</a>
    </div>
    <div class="grid grid-cols-3 gap-3 mb-3">
      <div class="p-3 rounded-2xl ${da.high>0?'bg-red-50':'bg-slate-50'} text-center">
        <p class="text-xs text-slate-500">High</p>
        <p class="text-xl font-bold ${da.high>0?'text-red-600':'text-slate-700'}">${da.high||0}</p>
      </div>
      <div class="p-3 rounded-2xl ${da.medium>0?'bg-amber-50':'bg-slate-50'} text-center">
        <p class="text-xs text-slate-500">Medium</p>
        <p class="text-xl font-bold ${da.medium>0?'text-amber-600':'text-slate-700'}">${da.medium||0}</p>
      </div>
      <div class="p-3 rounded-2xl bg-slate-50 text-center">
        <p class="text-xs text-slate-500">Low</p>
        <p class="text-xl font-bold text-slate-700">${da.low||0}</p>
      </div>
    </div>
    ${rdf.length ? rdf.map(f=>{
      const sc2 = Number(f.risk_score)||0;
      const rc2 = sc2>=70?'bg-red-100 text-red-700':(sc2>=40?'bg-amber-100 text-amber-700':'bg-slate-100 text-slate-600');
      return '<div class="flex items-center justify-between py-2 border-t border-slate-50">'+
        '<a href="/admin/users/'+f.user_id+'" class="text-sm font-semibold text-blue-600 hover:underline">'+(f.username?escapeHtml(f.username):'#'+f.user_id)+'</a>'+
        '<span class="px-2.5 py-1 text-xs font-bold rounded-full '+rc2+'">'+sc2+' / 100</span>'+
      '</div>';
    }).join('') : '<p class="text-xs text-slate-400 text-center py-2">কোনো ফ্ল্যাগ নেই</p>'}
  </div>
</div>

<!-- ===== QUICK ACTIONS + RECENT ACTIVITY ===== -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
  <!-- Quick Actions -->
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2"><i class="fas fa-bolt text-blue-500"></i> Quick Actions</h3>
    <div class="space-y-1.5">
      ${[
        { href:'/admin/users',               icon:'fa-user-plus',        color:'blue',   label:'ব্যবহারকারী ব্যবস্থাপনা'                                    },
        { href:'/payment/admin/payments',    icon:'fa-check-circle',     color:'emerald',label:'পেন্ডিং ডিপোজিট অনুমোদন ('+fmt(s.pending_deposits)+')' },
        { href:'/admin/withdrawals',         icon:'fa-hand-holding-usd', color:'amber',  label:'পেন্ডিং উইথড্র ('+fmt(s.pending_withdrawals)+')'         },
        { href:'/admin/kyc',                 icon:'fa-id-card',          color:'indigo', label:'KYC পর্যালোচনা ('+fmt(s.pending_kyc)+')'                 },
        { href:'/chat/admin',                icon:'fa-headset',          color:'purple', label:'লাইভ সাপোর্ট চ্যাট'                                      },
        { href:'/admin/diagnostics',         icon:'fa-heart-pulse',      color:'red',    label:'System Diagnostics'                                       },
      ].map(a=>`
      <a href="${a.href}" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition group">
        <div class="flex items-center gap-3">
          <i class="fas ${a.icon} text-${a.color}-500 w-5 text-sm"></i>
          <span class="text-sm font-medium text-slate-700">${a.label}</span>
        </div>
        <i class="fas fa-chevron-right text-slate-300 text-xs group-hover:text-${a.color}-500 transition"></i>
      </a>`).join('')}
    </div>
  </div>

  <!-- Recent Activity Feed -->
  <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-slate-800">📋 সাম্প্রতিক কার্যক্রম</h3>
      <a href="/admin/reports" class="text-xs text-blue-600 hover:underline">সব দেখুন →</a>
    </div>
    <div class="space-y-3 text-sm max-h-80 overflow-y-auto pr-1">
      ${ra.length ? ra.slice(0,10).map(a => {
        const icon = a.kind==='deposit'?'fa-arrow-down bg-emerald-100 text-emerald-600':(a.kind==='withdraw'?'fa-arrow-up bg-amber-100 text-amber-600':'fa-dice bg-blue-100 text-blue-600');
        const label = a.kind==='deposit'?'ডিপোজিট':(a.kind==='withdraw'?'উইথড্র':'বেট');
        const time = new Date(a.created_at).toLocaleString('en-BD',{hour:'numeric',minute:'2-digit',hour12:true});
        return '<div class="flex items-start gap-3">'+
          '<div class="w-8 h-8 rounded-2xl flex-shrink-0 flex items-center justify-center '+icon+'"><i class="fas '+icon.split(' ')[0]+' text-xs"></i></div>'+
          '<div class="flex-1 min-w-0">'+
            '<div class="flex justify-between gap-2">'+
              '<span class="font-medium text-slate-700">'+label+' · '+escapeHtml(a.status)+'</span>'+
              '<span class="text-xs text-slate-400 flex-shrink-0">'+time+'</span>'+
            '</div>'+
            '<p class="text-slate-500 text-xs truncate">'+escapeHtml(a.username)+' · ৳ '+fmt(a.amount)+(a.match?' · '+escapeHtml(a.match):'')+'</p>'+
          '</div>'+
        '</div>';
      }).join('') : '<p class="text-slate-400 text-center py-6">কোনো কার্যক্রম নেই</p>'}
    </div>
  </div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
// ===== Chart.js defaults =====
Chart.defaults.font.family = "'Inter', sans-serif";
Chart.defaults.font.size   = 11;
Chart.defaults.color       = '#94a3b8';

const revLabels  = ${revLabels};
const revDep     = ${revDep};
const revWit     = ${revWit};
const ugLabels   = ${ugLabels};
const ugCounts   = ${ugCounts};
const bsLabels   = ${bsLabels};
const bsCnts     = ${bsCnts};

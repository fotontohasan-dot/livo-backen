<%- include('partials/admin-layout', { 
    title: 'Dashboard', 
    active: 'dashboard',
    body: `
<div class="max-w-7xl mx-auto">
    <!-- Welcome Header -->
    <div class="flex items-end justify-between mb-8">
        <div>
            <h1 class="text-3xl font-semibold text-slate-900">Welcome back, Admin 👋</h1>
            <p class="text-slate-600 mt-1">Here's what's happening with your platform today.</p>
        </div>
        <div class="text-right">
            <div class="text-sm text-slate-500">Last updated</div>
            <div class="font-medium text-slate-700" id="current-time"></div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
        <!-- Total Users -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Users</p>
                    <p class="metric-value text-slate-900 mt-2">48,291</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +1,284 today
                    </p>
                </div>
                <div class="w-11 h-11 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-users text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Deposits -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Deposits</p>
                    <p class="metric-value text-slate-900 mt-2">৳ 124.8M</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +৳ 8.4M today
                    </p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-down text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Withdrawals -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Withdrawals</p>
                    <p class="metric-value text-slate-900 mt-2">৳ 89.2M</p>
                    <p class="text-amber-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-down"></i> ৳ 3.1M today
                    </p>
                </div>
                <div class="w-11 h-11 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-up text-xl"></i>
                </div>
            </div>
        </div>

        <!-- GGR Today -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">GGR (Today)</p>
                    <p class="metric-value text-emerald-600 mt-2">৳ 4.82M</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1">+18% from yesterday</p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-chart-line text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Pending Actions -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Pending Actions</p>
                    <p class="metric-value text-orange-600 mt-2">187</p>
                    <p class="text-orange-600 text-xs font-semibold mt-1">42 deposits • 31 withdrawals</p>
                </div>
                <div class="w-11 h-11 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-clock text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions + Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Quick Actions -->
        <div class="lg:col-span-1 bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
                <i class="fas fa-bolt text-blue-500"></i> 
                <span>Quick Actions</span>
            </h3>
            <div class="space-y-2">
                <a href="/admin/users" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-user-plus text-blue-500 w-5"></i>
                        <span class="font-medium text-sm">Add New User / Adjust Coins</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-blue-500 transition-colors"></i>
                </a>
                <a href="/admin/deposits" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-check-circle text-emerald-500 w-5"></i>
                        <span class="font-medium text-sm">Approve Pending Deposits (42)</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-emerald-500 transition-colors"></i>
                </a>
                <a href="/admin/support" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-headset text-purple-500 w-5"></i>
                        <span class="font-medium text-sm">Reply to Support Tickets (31)</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-purple-500 transition-colors"></i>
                </a>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-lg">Recent Activity</h3>
                <a href="/admin/transactions" class="text-sm text-blue-600 hover:underline flex items-center gap-1">View all <i class="fas fa-arrow-right text-xs"></i></a>
            </div>
            
            <div class="space-y-4 text-sm">
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-2xl flex-shrink-0 flex items-center justify-center"><i class="fas fa-arrow-down text-sm"></i></div>
                    <div class="flex-1">
                        <div class="flex justify-between">
                            <span class="font-medium">Deposit approved</span>
                            <span class="text-xs text-slate-500">2 min ago</span>
                        </div>
                        <p class="text-slate-600">Rahim Khan • ৳ 25,000 • #TXN98421</p>
                    </div>
                </div>
                
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-2xl flex-shrink-0 flex items-center justify-center"><i class="fas fa-dice text-sm"></i></div>
                    <div class="flex-1">
                        <div class="flex justify-between">
                            <span class="font-medium">Big win settled</span>
                            <span class="text-xs text-slate-500">14 min ago</span>
                        </div>
                        <p class="text-slate-600">User #28491 won ৳ 1,24,500 on Bangladesh vs India</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Update time
    function updateTime() {
        const el = document.getElementById('current-time');
        if (el) el.textContent = new Date().toLocaleString('en-BD', { hour: 'numeric', minute: '2-digit', hour12: true });
    }
    setInterval(updateTime, 30000);
    updateTime();
</script>
` 
}) %>
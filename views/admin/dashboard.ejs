<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard • Livo</title>
    <!-- Tailwind CSS CDN (Modern Look) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&amp;family=Poppins:wght@500;600&amp;display=swap');
        
        :root {
            --primary: #6366f1;
        }
        
        body {
            font-family: 'Inter', system_ui, sans-serif;
        }
        
        .admin-header {
            background: linear-gradient(to right, #1e2937, #0f172a);
        }
        
        .stat-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
        
        .modern-table {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05);
        }
        
        .nav-link {
            transition: all 0.2s ease;
        }
        
        .nav-link:hover {
            background-color: #334155;
            color: white;
        }
        
        .nav-link.active {
            background-color: #6366f1;
            color: white;
            border-radius: 8px;
        }
        
        .section-title {
            font-family: 'Poppins', sans-serif;
            letter-spacing: -0.025em;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-200">
    <div class="flex h-screen overflow-hidden">
        <!-- SIDEBAR -->
        <div class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col">
            <!-- Logo -->
            <div class="px-6 py-6 border-b border-slate-800">
                <div class="flex items-center gap-x-3">
                    <div class="w-10 h-10 bg-indigo-600 rounded-2xl flex items-center justify-center">
                        <i class="fa-solid fa-chart-line text-white text-2xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-2xl tracking-tighter">Livo</span>
                        <span class="text-indigo-400 text-sm font-medium">Admin</span>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <div class="px-3 py-6 flex-1">
                <div class="space-y-1">
                    <a href="/admin/dashboard" class="nav-link active flex items-center gap-x-3 px-4 py-3 text-sm font-medium">
                        <i class="fa-solid fa-home w-5"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/admin/users" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-users w-5"></i>
                        <span>Users</span>
                    </a>
                    <a href="/admin/kyc" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-id-card w-5"></i>
                        <span>KYC Verification</span>
                    </a>
                    <a href="/admin/matches" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-tachometer-alt w-5"></i>
                        <span>Matches &amp; Markets</span>
                    </a>
                    <a href="/admin/bets" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-receipt w-5"></i>
                        <span>Bets &amp; Settlements</span>
                    </a>
                    <a href="/admin/bonuses" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-gift w-5"></i>
                        <span>Bonuses &amp; Promotions</span>
                    </a>
                    <a href="/admin/reports" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-chart-bar w-5"></i>
                        <span>Reports</span>
                    </a>
                </div>

                <div class="mt-8 px-4">
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">System</div>
                    <a href="/admin/settings" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-cog w-5"></i>
                        <span>Settings</span>
                    </a>
                    <a href="/admin/activity" class="nav-link flex items-center gap-x-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white">
                        <i class="fa-solid fa-history w-5"></i>
                        <span>Activity Log</span>
                    </a>
                </div>
            </div>

            <!-- User Profile -->
            <div class="p-4 border-t border-slate-800">
                <div class="flex items-center gap-x-3">
                    <div class="w-9 h-9 bg-slate-700 rounded-full flex items-center justify-center">
                        <i class="fa-solid fa-user text-slate-300"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">Admin User</p>
                        <p class="text-xs text-slate-500">Super Admin</p>
                    </div>
                    <a href="/admin/logout" class="text-slate-400 hover:text-red-400 transition-colors">
                        <i class="fa-solid fa-sign-out-alt"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="flex-1 flex flex-col overflow-hidden">
            
            <!-- Top Header -->
            <div class="h-16 bg-slate-900 border-b border-slate-800 flex items-center justify-between px-8">
                <div>
                    <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
                    <p class="text-xs text-slate-500">Welcome back, Admin • <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
                
                <div class="flex items-center gap-x-4">
                    <!-- Search -->
                    <div class="relative w-72">
                        <input type="text" 
                               class="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 transition-colors text-sm rounded-2xl py-2.5 pl-10 pr-4 outline-none"
                               placeholder="Search users, bets, matches...">
                        <i class="fa-solid fa-search absolute left-4 top-3 text-slate-500"></i>
                    </div>
                    
                    <!-- Notifications -->
                    <div class="relative">
                        <button class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 rounded-2xl transition-colors">
                            <i class="fa-solid fa-bell text-lg"></i>
                        </button>
                        <div class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-[10px] font-bold rounded-full flex items-center justify-center">7</div>
                    </div>
                    
                    <div class="h-8 w-px bg-slate-700"></div>
                    
                    <div class="flex items-center gap-x-2 text-sm">
                        <div class="text-right">
                            <div class="font-medium">Super Admin</div>
                            <div class="text-[10px] text-emerald-400">Online</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="flex-1 overflow-auto p-8 bg-slate-950">
                
                <!-- Stats Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-5 mb-8">
                    
                    <!-- Stat Card 1 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Total Users</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter"><%= stats?.totalUsers || 12480 %></p>
                            </div>
                            <div class="w-12 h-12 bg-blue-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-users text-blue-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                            <span class="font-medium">+12.4%</span>
                            <span class="text-slate-500 ml-2">from last week</span>
                        </div>
                    </div>

                    <!-- Stat Card 2 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Active Users</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter"><%= stats?.activeUsers || 8720 %></p>
                            </div>
                            <div class="w-12 h-12 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-user-check text-emerald-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                            <span class="font-medium">+8.7%</span>
                            <span class="text-slate-500 ml-2">from yesterday</span>
                        </div>
                    </div>

                    <!-- Stat Card 3 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Total Bets (Today)</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter"><%= stats?.totalBetsToday || 18420 %></p>
                            </div>
                            <div class="w-12 h-12 bg-amber-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-ticket text-amber-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                            <span class="font-medium">+31%</span>
                            <span class="text-slate-500 ml-2">vs last week</span>
                        </div>
                    </div>

                    <!-- Stat Card 4 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Pending KYC</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter text-orange-400"><%= stats?.pendingKYC || 47 %></p>
                            </div>
                            <div class="w-12 h-12 bg-orange-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-id-card text-orange-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4">
                            <a href="/admin/kyc" class="inline-flex items-center text-xs font-medium text-orange-400 hover:text-orange-300">
                                Review now <i class="fa-solid fa-arrow-right ml-1.5 text-xs"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Stat Card 5 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Total Revenue</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter">৳<%= (stats?.totalRevenue || 1245000).toLocaleString() %></p>
                            </div>
                            <div class="w-12 h-12 bg-violet-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-wallet text-violet-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                            <span class="font-medium">+19.2%</span>
                            <span class="text-slate-500 ml-2">this month</span>
                        </div>
                    </div>

                    <!-- Stat Card 6 -->
                    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-slate-400 text-sm font-medium">Open Markets</p>
                                <p class="text-4xl font-semibold mt-2 tracking-tighter"><%= stats?.openMarkets || 128 %></p>
                            </div>
                            <div class="w-12 h-12 bg-teal-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fa-solid fa-chart-line text-teal-400 text-2xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-teal-400 text-sm">
                            <span class="font-medium">42 live now</span>
                        </div>
                    </div>
                </div>

                <!-- Charts + Recent Users -->
                <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
                    
                    <!-- Revenue Trend Chart -->
                    <div class="xl:col-span-7 bg-slate-900 border border-slate-800 rounded-3xl p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="section-title text-xl font-semibold">Revenue Trend</h3>
                                <p class="text-sm text-slate-500">Last 7 days performance</p>
                            </div>
                            <div class="flex items-center gap-x-2 text-xs">
                                <div class="flex items-center gap-x-1.5">
                                    <div class="w-3 h-3 bg-indigo-500 rounded-full"></div>
                                    <span class="text-slate-400">Revenue</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="h-72">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>

                    <!-- Recent Users -->
                    <div class="xl:col-span-5 bg-slate-900 border border-slate-800 rounded-3xl p-6 flex flex-col">
                        <div class="flex items-center justify-between mb-5">
                            <div>
                                <h3 class="section-title text-xl font-semibold">Recent Users</h3>
                                <p class="text-sm text-slate-500">New registrations today</p>
                            </div>
                            <a href="/admin/users" class="text-xs font-medium px-4 py-2 bg-slate-800 hover:bg-slate-700 rounded-2xl transition-colors flex items-center gap-x-2">
                                View All <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        </div>

                        <div class="flex-1 overflow-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-slate-400 text-xs border-b border-slate-800">
                                        <th class="text-left pb-3 font-medium">User</th>
                                        <th class="text-left pb-3 font-medium">Joined</th>
                                        <th class="text-right pb-3 font-medium">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    <% if (recentUsers && recentUsers.length > 0) { %>
                                        <% recentUsers.slice(0,6).forEach(user => { %>
                                        <tr class="hover:bg-slate-800/50 transition-colors">
                                            <td class="py-3.5">
                                                <div class="flex items-center gap-x-3">
                                                    <div class="w-8 h-8 bg-slate-700 rounded-full flex items-center justify-center text-xs font-medium">
                                                        <%= user.name ? user.name[0].toUpperCase() : 'U' %>
                                                    </div>
                                                    <div>
                                                        <div class="font-medium"><%= user.name || user.username || 'Unknown User' %></div>
                                                        <div class="text-xs text-slate-500"><%= user.email || user.phone || '' %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3.5 text-slate-400 text-xs">
                                                <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('bn-BD') : 'Today' %>
                                            </td>
                                            <td class="py-3.5 text-right">
                                                <% if (user.status === 'active' || !user.status) { %>
                                                    <span class="inline-block px-3 py-1 text-emerald-400 bg-emerald-500/10 text-xs font-medium rounded-full">Active</span>
                                                <% } else { %>
                                                    <span class="inline-block px-3 py-1 text-orange-400 bg-orange-500/10 text-xs font-medium rounded-full"><%= user.status %></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <!-- Sample Data -->
                                        <tr class="hover:bg-slate-800/50 transition-colors">
                                            <td class="py-3.5">
                                                <div class="flex items-center gap-x-3">
                                                    <div class="w-8 h-8 bg-slate-700 rounded-full flex items-center justify-center text-xs font-medium">R</div>
                                                    <div>
                                                        <div class="font-medium">Rahim Khan</div>
                                                        <div class="text-xs text-slate-500">rahim.khan@email.com</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3.5 text-slate-400 text-xs">2h ago</td>
                                            <td class="py-3.5 text-right">
                                                <span class="inline-block px-3 py-1 text-emerald-400 bg-emerald-500/10 text-xs font-medium rounded-full">Active</span>
                                            </td>
                                        </tr>
                                        <tr class="hover:bg-slate-800/50 transition-colors">
                                            <td class="py-3.5">
                                                <div class="flex items-center gap-x-3">
                                                    <div class="w-8 h-8 bg-slate-700 rounded-full flex items-center justify-center text-xs font-medium">S</div>
                                                    <div>
                                                        <div class="font-medium">Sadia Islam</div>
                                                        <div class="text-xs text-slate-500">sadia.islam@email.com</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3.5 text-slate-400 text-xs">5h ago</td>
                                            <td class="py-3.5 text-right">
                                                <span class="inline-block px-3 py-1 text-emerald-400 bg-emerald-500/10 text-xs font-medium rounded-full">Active</span>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Security Alerts -->
                    <div class="xl:col-span-12 bg-slate-900 border border-slate-800 rounded-3xl p-6">
                        <div class="flex items-center justify-between mb-5">
                            <div class="flex items-center gap-x-3">
                                <i class="fa-solid fa-shield-halved text-red-400 text-xl"></i>
                                <div>
                                    <h3 class="section-title text-xl font-semibold">Security Alerts</h3>
                                    <p class="text-sm text-slate-500">Potential issues detected in last 24 hours</p>
                                </div>
                            </div>
                            <a href="/admin/activity" class="text-xs font-medium px-4 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-2xl transition-colors flex items-center gap-x-2">
                                View Full Log
                            </a>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4">
                                <div class="flex items-start gap-x-3">
                                    <div class="text-red-400 mt-1"><i class="fa-solid fa-exclamation-triangle"></i></div>
                                    <div class="flex-1">
                                        <div class="font-medium text-sm">Multiple accounts from same IP</div>
                                        <div class="text-xs text-slate-400 mt-1">IP: 103.XX.XX.45 • 4 accounts detected</div>
                                        <div class="mt-3">
                                            <button onclick="reviewSecurityAlert(this)" class="text-xs px-4 py-1.5 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium transition-colors">Review Accounts</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4">
                                <div class="flex items-start gap-x-3">
                                    <div class="text-amber-400 mt-1"><i class="fa-solid fa-user-lock"></i></div>
                                    <div class="flex-1">
                                        <div class="font-medium text-sm">Unusual betting pattern</div>
                                        <div class="text-xs text-slate-400 mt-1">User ID: #U-98421 • High volume bets</div>
                                        <div class="mt-3">
                                            <button onclick="reviewSecurityAlert(this)" class="text-xs px-4 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-medium transition-colors">Investigate</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4">
                                <div class="flex items-start gap-x-3">
                                    <div class="text-emerald-400 mt-1"><i class="fa-solid fa-check-circle"></i></div>
                                    <div class="flex-1">
                                        <div class="font-medium text-sm">All systems normal</div>
                                        <div class="text-xs text-slate-400 mt-1">No critical issues found in last scan</div>
                                        <div class="mt-3 text-xs text-emerald-400 font-medium">Last scan: Just now</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Tailwind script
        function initializeTailwind() {
            document.documentElement.style.setProperty('--accent', '#6366f1');
        }
        
        // Revenue Chart
        function initRevenueChart() {
            const ctx = document.getElementById('revenueChart');
            if (!ctx) return;
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan 28', 'Jan 29', 'Jan 30', 'Jan 31', 'Feb 1', 'Feb 2', 'Feb 3'],
                    datasets: [{
                        label: 'Revenue (BDT)',
                        data: [124000, 189000, 156000, 234000, 198000, 267000, 312000],
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#6366f1',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e2937',
                            titleColor: '#fff',
                            bodyColor: '#cbd5e1',
                            borderColor: '#334155',
                            borderWidth: 1
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#334155', lineWidth: 0.5 },
                            ticks: { color: '#64748b', font: { size: 11 } }
                        },
                        y: {
                            grid: { color: '#334155', lineWidth: 0.5 },
                            ticks: { 
                                color: '#64748b', 
                                font: { size: 11 },
                                callback: function(value) {
                                    return '৳' + (value / 1000) + 'k';
                                }
                            }
                        }
                    },
                    elements: {
                        line: { tension: 0.4 },
                        point: { hitRadius: 20 }
                    }
                }
            });
        }
        
        function reviewSecurityAlert(element) {
            element.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Reviewing...';
            element.disabled = true;
            
            setTimeout(() => {
                element.outerHTML = `<span class="text-emerald-400 text-xs font-medium">✓ Reviewed &amp; Action Taken</span>`;
            }, 1800);
        }
        
        // Initialize everything
        function initDashboard() {
            initializeTailwind();
            initRevenueChart();
            

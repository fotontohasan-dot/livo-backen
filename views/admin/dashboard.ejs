<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard • Livo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background-color: #0f172a; }
        .stat-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .modern-table { border-collapse: separate; border-spacing: 0 8px; }
        .modern-table tr { background: #1e293b; transition: all 0.2s; }
        .modern-table tr:hover { background: #334155; }
        .section-header { font-size: 1.1rem; font-weight: 600; color: #e2e8f0; }
    </style>
</head>
<body class="text-slate-200">
    <div class="flex min-h-screen">
        
        <!-- Sidebar -->
        <%- include('../../partials/sidebar', { activePage: 'dashboard' }) %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            
            <!-- Header -->
            <%- include('../../partials/header', { 
                pageTitle: 'Dashboard', 
                pageSubtitle: 'Overview & key metrics' 
            }) %>

            <!-- Main Content Area -->
            <div class="p-6 space-y-8">

                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="stat-card bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Total Users</p>
                                <p class="text-4xl font-bold text-white mt-2"><%= stats.totalUsers || 12480 %></p>
                            </div>
                            <div class="w-14 h-14 bg-blue-600/20 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-users text-blue-400 text-3xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fas fa-arrow-up mr-1"></i>
                            <span>+12% from last month</span>
                        </div>
                    </div>

                    <div class="stat-card bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Total Revenue</p>
                                <p class="text-4xl font-bold text-white mt-2">৳ <%= (stats.totalRevenue || 2845000).toLocaleString() %></p>
                            </div>
                            <div class="w-14 h-14 bg-emerald-600/20 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-wallet text-emerald-400 text-3xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-emerald-400 text-sm">
                            <i class="fas fa-arrow-up mr-1"></i>
                            <span>+8.4% from last week</span>
                        </div>
                    </div>

                    <div class="stat-card bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Active Bets</p>
                                <p class="text-4xl font-bold text-white mt-2"><%= stats.activeBets || 1842 %></p>
                            </div>
                            <div class="w-14 h-14 bg-amber-600/20 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-ticket-alt text-amber-400 text-3xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-amber-400 text-sm">
                            <i class="fas fa-arrow-up mr-1"></i>
                            <span>342 new today</span>
                        </div>
                    </div>

                    <div class="stat-card bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Pending KYC</p>
                                <p class="text-4xl font-bold text-white mt-2"><%= stats.pendingKYC || 87 %></p>
                            </div>
                            <div class="w-14 h-14 bg-rose-600/20 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-id-card text-rose-400 text-3xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 flex items-center text-rose-400 text-sm">
                            <i class="fas fa-exclamation-circle mr-1"></i>
                            <span>Needs attention</span>
                        </div>
                    </div>
                </div>

                <!-- Revenue Trend + Recent Users -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <!-- Revenue Chart -->
                    <div class="lg:col-span-2 bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="section-header">Revenue Trend</h3>
                                <p class="text-slate-400 text-sm">Last 30 days</p>
                            </div>
                            <div class="flex items-center gap-2 text-sm">
                                <div class="flex items-center gap-1.5">
                                    <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                                    <span class="text-slate-300">Revenue</span>
                                </div>
                            </div>
                        </div>
                        <div class="h-72">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>

                    <!-- Recent Users -->
                    <div class="bg-slate-800 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="section-header">Recent Users</h3>
                            <a href="/admin/users" class="text-blue-400 hover:text-blue-300 text-sm flex items-center gap-1">
                                View all <i class="fas fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                        
                        <div class="space-y-4">
                            <% if (recentUsers && recentUsers.length > 0) { %>
                                <% recentUsers.slice(0,5).forEach(user => { %>
                                    <div class="flex items-center gap-3 p-3 hover:bg-slate-700/50 rounded-2xl transition-colors">
                                        <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-white font-semibold">
                                            <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-medium text-white truncate"><%= user.username || 'Unknown User' %></p>
                                            <p class="text-xs text-slate-400"><%= user.email || 'No email' %></p>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-emerald-400 text-sm font-medium">+৳<%= user.balance || 0 %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-8 text-slate-400">
                                    <i class="fas fa-users text-3xl mb-3 opacity-50"></i>
                                    <p>No recent users</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="bg-slate-800 border border-slate-700 rounded-3xl p-6">
                    <h3 class="section-header mb-5">Quick Actions</h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <a href="/admin/users" class="flex items-center gap-3 p-4 bg-slate-700 hover:bg-slate-600 rounded-2xl transition-all group">
                            <div class="w-11 h-11 bg-blue-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-user-plus text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold">Manage Users</p>
                                <p class="text-xs text-slate-400">View & edit users</p>
                            </div>
                        </a>
                        
                        <a href="/admin/kyc" class="flex items-center gap-3 p-4 bg-slate-700 hover:bg-slate-600 rounded-2xl transition-all group">
                            <div class="w-11 h-11 bg-emerald-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-check-double text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold">Review KYC</p>
                                <p class="text-xs text-slate-400"><%= stats.pendingKYC || 0 %> pending</p>
                            </div>
                        </a>
                        
                        <a href="/admin/bets" class="flex items-center gap-3 p-4 bg-slate-700 hover:bg-slate-600 rounded-2xl transition-all group">
                            <div class="w-11 h-11 bg-amber-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-ticket-alt text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold">Settle Bets</p>
                                <p class="text-xs text-slate-400">Process pending bets</p>
                            </div>
                        </a>
                        
                        <a href="/admin/reports" class="flex items-center gap-3 p-4 bg-slate-700 hover:bg-slate-600 rounded-2xl transition-all group">
                            <div class="w-11 h-11 bg-rose-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-exclamation-triangle text-white"></i>
                            </div>
                            <div>
                                <p class="font-semibold">View Reports</p>
                                <p class="text-xs text-slate-400">Check user reports</p>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        // Revenue Chart
        const ctx = document.getElementById('revenueChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan 5', 'Jan 10', 'Jan 15', 'Jan 20', 'Jan 25', 'Jan 30'],
                    datasets: [{
                        label: 'Revenue (BDT)',
                        data: [185000, 242000, 198000, 315000, 278000, 341000],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#3b82f6',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: '#334155' }, ticks: { color: '#94a3b8' } },
                        y: { grid: { color: '#334155' }, ticks: { color: '#94a3b8', callback: v => '৳' + (v/1000) + 'k' } }
                    }
                }
            });
        }
    </script>
</body>
</html>

// ===== Date range change =====
async function changeRange(days) {
  try {
    const r = await fetch('/admin/api/analytics?days=' + days);
    const d = await r.json();
    const fDate = s => new Date(s).toLocaleDateString('en-US',{month:'short',day:'numeric'});
    makeRevenue(d.revenue.map(r=>fDate(r.day)), d.revenue.map(r=>r.deposit), d.revenue.map(r=>r.withdraw));
    makeUserGrowth(d.userGrowth.map(r=>fDate(r.day)), d.userGrowth.map(r=>r.count));
  } catch(e) { console.error(e); }
}

// ===== Export CSV =====
function exportCSV() {
  const days = document.getElementById('range-select')?.value || 14;
  fetch('/admin/api/analytics?days='+days).then(r=>r.json()).then(d => {
    const rows = [['Date','Deposit','Withdraw','Net Revenue','New Users']];
    d.revenue.forEach((r,i) => {
      const ug = d.userGrowth[i] || {};
      rows.push([r.day, r.deposit, r.withdraw, r.net, ug.count||0]);
    });
    const csv = rows.map(r=>r.join(',')).join('\n');
    const a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
    a.download = 'livo-analytics-' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
  });
}

// ===== Refresh =====
async function refreshAll() {
  const icon = document.getElementById('refresh-icon');
  icon.classList.add('fa-spin');
  try { await changeRange(document.getElementById('range-select')?.value || 14); } catch(e) {}
  icon.classList.remove('fa-spin');
}

// ===== Time =====
function updateTime() {
  const el = document.getElementById('current-time');
  if (el) el.textContent = new Date().toLocaleString('en-BD',{hour:'numeric',minute:'2-digit',hour12:true});
}
updateTime();
setInterval(updateTime, 30000);
setInterval(refreshAll, 60000); // 60s auto-refresh


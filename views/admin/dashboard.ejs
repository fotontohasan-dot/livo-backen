<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&')
    .replace(/</g, '<')
    .replace(/>/g, '>')
    .replace(/"/g, '"')
    .replace(/'/g, '&#39;');
}
const totalDeposits = Number(stats.total_deposits_all_time || stats.total_deposit_all || 0);
const totalWithdrawals = Number(stats.total_withdrawals_all_time || stats.total_withdraw_all || 0);
const pendingTotal = Number(stats.pending_total || ((stats.pending_deposits||0)+(stats.pending_withdrawals||0)+(stats.pending_kyc||0)));
%>
<%- include('partials/admin-layout', { 
    title: 'Dashboard', 
    active: 'dashboard',
    body: `
<div class="max-w-7xl mx-auto">
    <!-- Welcome Header + Controls -->
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-semibold text-slate-900">Welcome back, Admin 👋</h1>
            <p class="text-slate-600 mt-1">Real-time platform analytics & system health.</p>
        </div>
        <div class="text-right flex flex-col items-end gap-2">
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500">Auto-refresh</label>
                <select id="auto-refresh-interval" class="text-xs border border-slate-200 rounded-lg px-2 py-1">
                    <option value="0">Off</option>
                    <option value="15000">15s</option>
                    <option value="20000" selected>20s</option>
                    <option value="60000">60s</option>
                </select>
                <button id="btn-export-csv" class="text-xs px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 font-semibold">Export CSV</button>
            </div>
            <div class="text-sm text-slate-500">Last updated</div>
            <div class="font-medium text-slate-700" id="current-time"></div>
            <div class="mt-1 flex flex-col items-end gap-1.5">
                <span class="px-3 py-1.5 rounded-xl text-xs font-semibold ${redisStatus.connected ? 'bg-emerald-100 text-emerald-700' : (redisStatus.enabled ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-500')}">
                    <i class="fas fa-database mr-1"></i>Redis: ${redisStatus.connected ? 'Connected' : (redisStatus.enabled ? 'Disconnected' : 'Disabled')}
                </span>
                ${(!redisStatus.connected && redisStatus.lastError) ? `<div class="text-[11px] text-red-500 max-w-[220px] text-right">${escapeHtml(redisStatus.lastError)}</div>` : ''}
                <a href="/admin/queues" class="px-3 py-1.5 rounded-xl text-xs font-semibold ${queueStatus.running ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'} hover:opacity-80">
                    <i class="fas fa-layer-group mr-1"></i>Queue: ${queueStatus.running ? 'Running' : 'Stopped'}${(queueStatus.failed || 0) > 0 ? ` · ${queueStatus.failed} failed` : ''}
                </a>
                <a href="/admin/system-diagnostics" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 hover:opacity-80">
                    <i class="fas fa-heart-pulse mr-1"></i>Server Health
                </a>
            </div>
        </div>
    </div>

    <!-- Demo Currency Widget -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-slate-800">🎮 ডেমো কারেন্সি ওভারভিউ <span class="text-xs font-normal text-emerald-600">● লাইভ</span></h3>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">মোট ডেমো</p>
                <p class="text-xl font-bold text-slate-900 mt-1" id="demo-total">${Number(demoStats.totalDemo || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">ব্যবহারকারীদের কাছে থাকা ডেমো</p>
                <p class="text-xl font-bold text-blue-600 mt-1" id="demo-held">${Number(demoStats.userHeldDemo || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">ক্যাসিনো বেট ডেমো</p>
                <p class="text-xl font-bold text-purple-600 mt-1" id="demo-casino">${Number(demoStats.casinoDemoWagered || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">স্পোর্টস বেটিং ডেমো</p>
                <p class="text-xl font-bold text-orange-600 mt-1" id="demo-sports">${Number(demoStats.sportsDemoWagered || 0).toLocaleString('en-US')}</p>
            </div>
        </div>
    </div>

    <!-- Fraud Alerts -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-slate-800">🛡️ Fraud Alerts <span class="text-xs font-normal text-slate-400">ওপেন ফ্ল্যাগ</span></h3>
            <div class="flex items-center gap-3">
                <a href="/admin/fraud-monitoring" class="text-xs font-semibold text-blue-600 hover:underline">মনিটরিং ড্যাশবোর্ড</a>
                <a href="/admin/fraud-logs" class="text-xs font-semibold text-blue-600 hover:underline">সব দেখুন <i class="fas fa-arrow-right ml-1"></i></a>
            </div>
        </div>
        <div class="grid grid-cols-3 gap-4 mb-4">
            <div class="p-4 rounded-2xl ${fraudAlerts.high > 0 ? 'bg-red-50' : 'bg-slate-50'}">
                <p class="text-xs text-slate-500">High Risk</p>
                <p class="text-xl font-bold ${fraudAlerts.high > 0 ? 'text-red-600' : 'text-slate-900'} mt-1">${fraudAlerts.high || 0}</p>
            </div>
            <div class="p-4 rounded-2xl ${fraudAlerts.medium > 0 ? 'bg-amber-50' : 'bg-slate-50'}">
                <p class="text-xs text-slate-500">Medium Risk</p>
                <p class="text-xl font-bold ${fraudAlerts.medium > 0 ? 'text-amber-600' : 'text-slate-900'} mt-1">${fraudAlerts.medium || 0}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">Low Risk</p>
                <p class="text-xl font-bold text-slate-900 mt-1">${fraudAlerts.low || 0}</p>
            </div>
        </div>
        ${(recentFraudFlags && recentFraudFlags.length) ? recentFraudFlags.map(f => {
          const riskClass = f.risk_level === 'high' ? 'bg-red-100 text-red-700' : (f.risk_level === 'medium' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600');
          const uLabel = f.username ? escapeHtml(f.username) : ('#' + f.user_id);
          return '<div class="flex items-center justify-between py-2 border-t border-slate-50">' +
            '<div class="min-w-0 flex-1">' +
              '<a href="/admin/users/' + f.user_id + '" class="text-sm font-semibold text-blue-600 hover:underline">' + uLabel + '</a>' +
              '<p class="text-xs text-slate-500 truncate">' + escapeHtml(f.reason) + '</p>' +
            '</div>' +
            '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + riskClass + ' ml-3 flex-shrink-0">' + f.risk_level.toUpperCase() + '</span>' +
          '</div>';
        }).join('') : '<p class="text-sm text-slate-400 text-center py-3">কোনো ওপেন ফ্রড ফ্ল্যাগ নেই</p>'}
    </div>

    <!-- Duplicate Accounts -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-slate-800">🧬 Duplicate Accounts <span class="text-xs font-normal text-slate-400">ওপেন ফ্ল্যাগ</span></h3>
            <a href="/admin/duplicate-accounts" class="text-xs font-semibold text-blue-600 hover:underline">সব দেখুন <i class="fas fa-arrow-right ml-1"></i></a>
        </div>
        <div class="grid grid-cols-3 gap-4 mb-4">
            <div class="p-4 rounded-2xl ${dupAlerts.high > 0 ? 'bg-red-50' : 'bg-slate-50'}">
                <p class="text-xs text-slate-500">High (70+)</p>
                <p class="text-xl font-bold ${dupAlerts.high > 0 ? 'text-red-600' : 'text-slate-900'} mt-1">${dupAlerts.high || 0}</p>
            </div>
            <div class="p-4 rounded-2xl ${dupAlerts.medium > 0 ? 'bg-amber-50' : 'bg-slate-50'}">
                <p class="text-xs text-slate-500">Medium (40-69)</p>
                <p class="text-xl font-bold ${dupAlerts.medium > 0 ? 'text-amber-600' : 'text-slate-900'} mt-1">${dupAlerts.medium || 0}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">Low (<40)</p>
                <p class="text-xl font-bold text-slate-900 mt-1">${dupAlerts.low || 0}</p>
            </div>
        </div>
        ${(recentDupFlags && recentDupFlags.length) ? recentDupFlags.map(f => {
          const score = Number(f.risk_score) || 0;
          const riskClass = score >= 70 ? 'bg-red-100 text-red-700' : (score >= 40 ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600');
          const uLabel = f.username ? escapeHtml(f.username) : ('#' + f.user_id);
          return '<div class="flex items-center justify-between py-2 border-t border-slate-50">' +
            '<div class="min-w-0 flex-1">' +
              '<a href="/admin/users/' + f.user_id + '" class="text-sm font-semibold text-blue-600 hover:underline">' + uLabel + '</a>' +
              '<p class="text-xs text-slate-500 truncate">' + escapeHtml(f.reason) + '</p>' +
            '</div>' +
            '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + riskClass + ' ml-3 flex-shrink-0">' + score + ' / 100</span>' +
          '</div>';
        }).join('') : '<p class="text-sm text-slate-400 text-center py-3">কোনো ওপেন ডুপ্লিকেট ফ্ল্যাগ নেই</p>'}
    </div>

    <!-- Core Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4 gap-5 mb-8">
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Users</p>
                    <p class="metric-value text-slate-900 mt-2" id="stat-total-users">${Number(stats.total_users || 0).toLocaleString('en-US')}</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +${Number(stats.new_users_today || 0).toLocaleString('en-US')} today
                    </p>
                </div>
                <div class="w-11 h-11 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-users text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Coins</p>
                    <p class="metric-value text-slate-900 mt-2" id="stat-total-coins">${Number(stats.total_coins_in_system || stats.total_coins || 0).toLocaleString('en-US')}</p>
                    <p class="text-slate-500 text-xs font-semibold mt-1">সব ইউজার মিলিয়ে সিস্টেমে</p>
                </div>
                <div class="w-11 h-11 bg-yellow-100 text-yellow-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-coins text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Active Users</p>
                    <p class="metric-value text-emerald-600 mt-2" id="stat-active-users">${Number(stats.active_users || stats.active_users_now || 0).toLocaleString('en-US')}</p>
                    <p class="text-slate-500 text-xs font-semibold mt-1">গত ১৫ মিনিটে</p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-user-clock text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Deposits</p>
                    <p class="metric-value text-slate-900 mt-2">৳ ${totalDeposits.toLocaleString('en-US')}</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +৳ ${Number(stats.today_deposit || 0).toLocaleString('en-US')} today
                    </p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-down text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Withdrawals</p>
                    <p class="metric-value text-slate-900 mt-2">৳ ${totalWithdrawals.toLocaleString('en-US')}</p>
                    <p class="text-amber-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> ৳ ${Number(stats.today_withdraw || 0).toLocaleString('en-US')} today
                    </p>
                </div>
                <div class="w-11 h-11 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-up text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">GGR (Today)</p>
                    <p class="metric-value text-emerald-600 mt-2">৳ ${Number(stats.today_profit || 0).toLocaleString('en-US')}</p>
                    <p class="text-slate-500 text-xs font-semibold mt-1">${stats.today_bet_count || 0} bets today</p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-chart-line text-xl"></i>
                </div>
            </div>
        </div>

        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Pending Actions</p>
                    <p class="metric-value text-orange-600 mt-2">${pendingTotal}</p>
                    <p class="text-orange-600 text-xs font-semibold mt-1">${stats.pending_deposits || 0} deposits • ${stats.pending_withdrawals || 0} withdrawals • ${stats.pending_kyc || 0} KYC</p>
                </div>
                <div class="w-11 h-11 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-clock text-xl"></i>
                </div>
            </div>
        </div>

        <a href="/admin/withdrawals" class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm hover:shadow-md transition block">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Pending Withdraw Requests</p>
                    <p class="metric-value text-red-600 mt-2">${stats.pending_withdrawals || 0}</p>
                    <p class="text-slate-400 text-xs font-semibold mt-1">রিভিউ করতে ক্লিক করুন</p>
                </div>
                <div class="w-11 h-11 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-hand-holding-usd text-xl"></i>
                </div>
            </div>
        </a>
    </div>

    <!-- Charts: Revenue + User Growth -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
            <h3 class="font-semibold text-slate-800 mb-4">📈 Revenue Trend (14 days)</h3>
            <canvas id="revenueChart" height="180"></canvas>
        </div>
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
            <h3 class="font-semibold text-slate-800 mb-4">👥 User Growth (14 days)</h3>
            <canvas id="userGrowthChart" height="180"></canvas>
        </div>
    </div>

    <!-- Quick Actions + Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
                <i class="fas fa-bolt text-blue-500"></i> 
                <span>Quick Actions</span>
            </h3>
            <div class="space-y-2">
                <a href="/admin/users" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-user-plus text-blue-500 w-5"></i>
                        <span class="font-medium text-sm">Add New User / Adjust Coins</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-blue-500 transition-colors"></i>
                </a>
                <a href="/payment/admin/payments" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-check-circle text-emerald-500 w-5"></i>
                        <span class="font-medium text-sm">Approve Pending Deposits (${stats.pending_deposits || 0})</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-emerald-500 transition-colors"></i>
                </a>
                <a href="/admin/kyc" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-id-card text-indigo-500 w-5"></i>
                        <span class="font-medium text-sm">Review Pending KYC (${stats.pending_kyc || 0})</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-indigo-500 transition-colors"></i>
                </a>
                <a href="/chat/admin" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-headset text-purple-500 w-5"></i>
                        <span class="font-medium text-sm">Live Support Chat</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-purple-500 transition-colors"></i>
                </a>
                <a href="/admin/reports" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-file-export text-slate-500 w-5"></i>
                        <span class="font-medium text-sm">Full Reports (Date Range)</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-slate-500 transition-colors"></i>
                </a>
            </div>
        </div>

        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-lg">Recent Activity</h3>
                <a href="/admin/reports" class="text-sm text-blue-600 hover:underline flex items-center gap-1">View all <i class="fas fa-arrow-right text-xs"></i></a>
            </div>
            <div class="space-y-4 text-sm" id="recent-activity-list">
                ${recentWithdrawals.slice(0, 4).map(w => `
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-amber-100 text-amber-600 rounded-2xl flex-shrink-0 flex items-center justify-center"><i class="fas fa-arrow-up text-sm"></i></div>
                    <div class="flex-1">
                        <div class="flex justify-between">
                            <span class="font-medium">Withdrawal ${w.status}</span>
                            <span class="text-xs text-slate-500">${new Date(w.created_at).toLocaleString('en-BD', { hour: 'numeric', minute: '2-digit', hour12: true })}</span>
                        </div>
                        <p class="text-slate-600">${escapeHtml(w.username)} • ৳ ${Number(w.amount).toLocaleString('en-US')}</p>
                    </div>
                </div>`).join('')}
                ${recentBets.slice(0, 4).map(b => `
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-2xl flex-shrink-0 flex items-center justify-center"><i class="fas fa-dice text-sm"></i></div>
                    <div class="flex-1">
                        <div class="flex justify-between">
                            <span class="font-medium">Bet ${b.status}</span>
                            <span class="text-xs text-slate-500">${new Date(b.created_at).toLocaleString('en-BD', { hour: 'numeric', minute: '2-digit', hour12: true })}</span>
                        </div>
                        <p class="text-slate-600">${escapeHtml(b.username)} • ৳ ${Number(b.stake).toLocaleString('en-US')} on ${escapeHtml(b.title || (b.team_a + ' vs ' + b.team_b))}</p>
                    </div>
                </div>`).join('')}
                ${(recentWithdrawals.length === 0 && recentBets.length === 0) ? '<p class="text-slate-400 text-sm">এখনো কোনো সাম্প্রতিক কার্যকলাপ নেই।</p>' : ''}
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    const revenueData = ${JSON.stringify((typeof revenueTrend !== 'undefined' ? revenueTrend : []).map(r => ({ day: r.day, deposit: r.deposit, withdraw: r.withdraw })))};
    const userGrowthData = ${JSON.stringify((typeof userGrowth !== 'undefined' ? userGrowth : []).map(r => ({ day: r.day, count: r.count })))};

    function updateTime() {
        const el = document.getElementById('current-time');
        if (el) el.textContent = new Date().toLocaleString('en-BD', { hour: 'numeric', minute: '2-digit', hour12: true });
    }
    setInterval(updateTime, 30000);
    updateTime();

    (function() {
        const socket = io();
        socket.emit('join_admin');
        socket.on('demo_stats_update', function(stats) {
            const map = { 'demo-total': stats.totalDemo, 'demo-held': stats.userHeldDemo, 'demo-casino': stats.casinoDemoWagered, 'demo-sports': stats.sportsDemoWagered };
            Object.keys(map).forEach(function(id) {
                const el = document.getElementById(id);
                if (el) el.textContent = Number(map[id] || 0).toLocaleString('en-US');
            });
        });
    })();

    let pollTimer = null;
    function pollDashboardStats() {
        fetch('/admin/api/dashboard-stats').then(function(r) { return r.json(); }).then(function(data) {
            if (!data || !data.success) return;
            var s = data.stats || {};
            var coinsEl = document.getElementById('stat-total-coins');
            if (coinsEl && typeof s.total_coins === 'number') coinsEl.textContent = Number(s.total_coins).toLocaleString('en-US');
            var activeEl = document.getElementById('stat-active-users');
            if (activeEl && typeof s.active_users === 'number') activeEl.textContent = Number(s.active_users).toLocaleString('en-US');
            var usersEl = document.getElementById('stat-total-users');
            if (usersEl && typeof s.total_users === 'number') usersEl.textContent = Number(s.total_users).toLocaleString('en-US');
            updateTime();
        }).catch(function() {});
    }

    function setAutoRefresh(ms) {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = null;
        if (ms > 0) {
            pollTimer = setInterval(pollDashboardStats, ms);
            pollDashboardStats();
        }
    }
    setAutoRefresh(20000);
    document.getElementById('auto-refresh-interval').addEventListener('change', function() {
        setAutoRefresh(parseInt(this.value, 10) || 0);
    });

    document.getElementById('btn-export-csv').addEventListener('click', function() {
        window.location.href = '/admin/activity/export.csv';
    });

    // Charts
    if (window.Chart && revenueData.length) {
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revenueData.map(r => new Date(r.day).toLocaleDateString('en-BD', { month: 'short', day: 'numeric' })),
                datasets: [
                    { label: 'Deposit', data: revenueData.map(r => r.deposit), borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', tension: 0.3, fill: true },
                    { label: 'Withdraw', data: revenueData.map(r => r.withdraw), borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,0.1)', tension: 0.3, fill: true }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
        });
    }
    if (window.Chart && userGrowthData.length) {
        new Chart(document.getElementById('userGrowthChart'), {
            type: 'bar',
            data: {
                labels: userGrowthData.map(r => new Date(r.day).toLocaleDateString('en-BD', { month: 'short', day: 'numeric' })),
                datasets: [{ label: 'New Users', data: userGrowthData.map(r => r.count), backgroundColor: '#3b82f6' }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
        });
    }
</script>
` 

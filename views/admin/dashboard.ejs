                </a>
                <a href="/payment/admin/payments" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-check-circle text-emerald-500 w-5"></i>
                        <span class="font-medium text-sm">Approve Pending Deposits (${stats.pending_deposits || 0})</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-emerald-500 transition-colors"></i>
                </a>
                <a href="/admin/kyc" class="flex items-center justify-between p-3 hover:bg-slate-50 rounded-2xl transition-colors group">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-id-card text-indigo-500 w-5"></i>
                        <span class="font-medium text-sm">Review Pending KYC (${stats.pending_kyc || 0})</span>
                    </div>
                    <i class="fas fa-chevron-right text-slate-300 group-hover:text-indigo-500 transition-colors"></i>
                </a>

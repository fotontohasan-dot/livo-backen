                </div>
                <div class="w-11 h-11 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-up text-xl"></i>
                </div>
            </div>
        </div>

        <!-- GGR Today -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">

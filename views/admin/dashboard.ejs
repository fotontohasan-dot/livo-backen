<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="admin-layout">
  <div class="admin-sidebar">
    <div style="padding:0 1.5rem 1rem;font-size:.75rem;color:var(--muted);text-transform:uppercase;">অ্যাডমিন প্যানেল</div>
    <a href="/admin" class="admin-nav-link active">📊 ড্যাশবোর্ড</a>
    <a href="/admin/users" class="admin-nav-link">👥 ব্যবহারকারী</a>
    <a href="/admin/matches" class="admin-nav-link">⚽ ম্যাচসমূহ</a>
    <a href="/admin/tournaments" class="admin-nav-link">🏆 টুর্নামেন্ট</a>
    <a href="/admin/news" class="admin-nav-link">📰 নিউজ</a>
    <a href="/chat/admin" class="admin-nav-link">💬 সাপোর্ট চ্যাট</a>
    <a href="/payment/admin/payments" class="admin-nav-link">💳 পেমেন্ট</a>
    <a href="/" class="admin-nav-link">🏠 সাইটে ফিরে যান</a>
  </div>
  <div class="admin-content">
    <%- include('../partials/flash') %>
    <h1 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">📊 ড্যাশবোর্ড</h1>
    <div class="grid grid-4" style="margin-bottom:2rem;">
      <div class="stat-card"><div class="stat-number"><%= stats.total_users %></div><div class="stat-label">মোট ইউজার</div></div>
      <div class="stat-card"><div class="stat-number" style="color:var(--secondary)"><%= stats.total_matches %></div><div class="stat-label">মোট ম্যাচ</div></div>
      <div class="stat-card"><div class="stat-number" style="color:var(--green)"><%= stats.total_predictions %></div><div class="stat-label">প্রেডিকশন</div></div>
      <div class="stat-card"><div class="stat-number" style="color:var(--gold)"><%= stats.total_coins_in_system %></div><div class="stat-label">সিস্টেম কয়েন</div></div>
    </div>
    <div class="grid grid-2">
      <div class="card">
        <div class="card-header">👥 সাম্প্রতিক ইউজার</div>
        <table class="table">
          <thead><tr><th>ইউজারনেম</th><th>ইমেইল</th><th>কয়েন</th><th>যোগদান</th></tr></thead>
          <tbody>
            <% recentUsers.forEach(u => { %>
              <tr>
                <td><%= u.username %></td>
                <td style="font-size:.8rem;color:var(--muted)"><%= u.email %></td>
                <td style="color:var(--gold)"><%= u.coins %></td>
                <td style="font-size:.8rem;color:var(--muted)"><%= new Date(u.created_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card">
        <div class="card-header">⚽ সাম্প্রতিক ম্যাচ</div>
        <table class="table">
          <thead><tr><th>ম্যাচ</th><th>স্ট্যাটাস</th><th>তারিখ</th></tr></thead>
          <tbody>
            <% recentMatches.forEach(m => { %>
              <tr>
                <td style="font-size:.85rem"><%= m.team_a %> vs <%= m.team_b %></td>
                <td><span class="status-badge status-<%= m.status %>"><%= m.status %></span></td>
                <td style="font-size:.8rem;color:var(--muted)"><%= new Date(m.match_date).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card" style="margin-top:1.5rem;">
      <div class="card-header">📢 ব্রডকাস্ট নোটিফিকেশন</div>
      <div class="card-body">
        <div class="form-group">
          <label class="form-label">টাইটেল</label>
          <input type="text" class="form-input" id="notifTitle" placeholder="নোটিফিকেশন টাইটেল">
        </div>
        <div class="form-group">
          <label class="form-label">মেসেজ</label>
          <input type="text" class="form-input" id="notifMsg" placeholder="সব ইউজারদের জন্য মেসেজ">
        </div>
        <button onclick="broadcastNotif()" class="btn btn-primary">📢 সব ইউজারকে পাঠান</button>
      </div>
    </div>
  </div>
</div>
<script>
function broadcastNotif() {
  const form = document.createElement('form');
  form.method = 'POST'; form.action = '/admin/notify-all';
  [['title','notifTitle'],['message','notifMsg']].forEach(([n,id]) => {
    const i = document.createElement('input');
    i.name = n; i.value = document.getElementById(id).value;
    form.appendChild(i);
  });
  document.body.appendChild(form); form.submit();
}
</script>
</body></html>

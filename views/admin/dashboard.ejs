<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
%>
<%- include('partials/admin-layout', { 
    title: 'Dashboard', 
    active: 'dashboard',
    body: `
<div class="max-w-7xl mx-auto">
    <!-- Welcome Header -->
    <div class="flex items-end justify-between mb-8">
        <div>
            <h1 class="text-3xl font-semibold text-slate-900">Welcome back, Admin 👋</h1>
            <p class="text-slate-600 mt-1">Here's what's happening with your platform today.</p>
        </div>
        <div class="text-right">
            <div class="text-sm text-slate-500">Last updated</div>
            <div class="font-medium text-slate-700" id="current-time"></div>
        </div>
    </div>

    <!-- ডেমো (প্র্যাকটিস) কারেন্সি উইজেট -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-slate-800">🎮 ডেমো কারেন্সি ওভারভিউ <span class="text-xs font-normal text-emerald-600">● লাইভ</span></h3>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">মোট ডেমো</p>
                <p class="text-xl font-bold text-slate-900 mt-1" id="demo-total">${Number(demoStats.totalDemo || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">ব্যবহারকারীদের কাছে থাকা ডেমো</p>
                <p class="text-xl font-bold text-blue-600 mt-1" id="demo-held">${Number(demoStats.userHeldDemo || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">ক্যাসিনো বেট ডেমো</p>
                <p class="text-xl font-bold text-purple-600 mt-1" id="demo-casino">${Number(demoStats.casinoDemoWagered || 0).toLocaleString('en-US')}</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50">
                <p class="text-xs text-slate-500">স্পোর্টস বেটিং ডেমো</p>
                <p class="text-xl font-bold text-orange-600 mt-1" id="demo-sports">${Number(demoStats.sportsDemoWagered || 0).toLocaleString('en-US')}</p>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
        <!-- Total Users -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">

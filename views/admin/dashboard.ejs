                    <p class="metric-value text-slate-900 mt-2">${Number(stats.total_users || 0).toLocaleString('en-US')}</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +${Number(stats.new_users_today || 0).toLocaleString('en-US')} today
                    </p>
                </div>
                <div class="w-11 h-11 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-users text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Active Users (last 15 min) -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Active Users</p>
                    <p class="metric-value text-slate-900 mt-2">${Number(stats.active_users_now || 0).toLocaleString('en-US')}</p>
                    <p class="text-slate-400 text-xs font-semibold mt-1">গত ১৫ মিনিটে</p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-signal text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Deposits -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Deposits</p>
                    <p class="metric-value text-slate-900 mt-2">৳ ${Number(stats.total_deposits_all_time || 0).toLocaleString('en-US')}</p>
                    <p class="text-emerald-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> +৳ ${Number(stats.today_deposit || 0).toLocaleString('en-US')} today
                    </p>
                </div>
                <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-arrow-down text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Withdrawals -->
        <div class="stat-card bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Withdrawals</p>
                    <p class="metric-value text-slate-900 mt-2">৳ ${Number(stats.total_withdrawals_all_time || 0).toLocaleString('en-US')}</p>
                    <p class="text-amber-600 text-xs font-semibold mt-1 flex items-center gap-1">
                        <i class="fas fa-arrow-up"></i> ৳ ${Number(stats.today_withdraw || 0).toLocaleString('en-US')} today

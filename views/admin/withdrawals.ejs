<%- include('partials/admin-layout', { 
    title: 'Withdrawals Management', 
    active: 'withdrawals',
    body: `
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between mb-6">
        <div>
            <h2 class="text-2xl font-semibold">Withdrawals Management</h2>
            <p class="text-sm text-slate-600">31 pending withdrawals • Total: ৳ 9.7M</p>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-hidden modern-table">
        <table class="w-full text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left">User</th>
                    <th class="px-6 py-4 text-left">Amount</th>
                    <th class="px-6 py-4 text-left">Method / Details</th>
                    <th class="px-6 py-4 text-center">Status</th>
                    <th class="px-6 py-4 text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="withdrawalsBody" class="divide-y"></tbody>
        </table>
    </div>
</div>

<script>
let withdrawals = [
    { id: "WTH9821", userId: 28491, userName: "Rahim Khan", amount: 45000, method: "bKash", details: "01711-223344", status: "Pending", requested: "2026-01-09" },
    { id: "WTH9822", userId: 19283, userName: "Karim Hossain", amount: 120000, method: "Bank", details: "Brac Bank • 4521****", status: "Pending", requested: "2026-01-09" },
    { id: "WTH9823", userId: 47291, userName: "Jasim Uddin", amount: 85000, method: "Nagad", details: "01655-998877", status: "Approved", requested: "2026-01-08" }
];

function renderWithdrawals() {
    const tbody = document.getElementById('withdrawalsBody');
    tbody.innerHTML = '';
    
    withdrawals.forEach(w => {
        const row = document.createElement('tr');
        row.innerHTML = \`
            <td class="px-6 py-4">
                <div class="font-semibold">\${w.userName}</div>
                <div class="text-xs text-slate-500">#\${w.userId}</div>
            </td>
            <td class="px-6 py-4 font-mono font-bold text-red-600">৳ \${w.amount.toLocaleString()}</td>
            <td class="px-6 py-4 text-sm">
                <div>\${w.method}</div>
                <div class="text-xs text-slate-500">\${w.details}</div>
            </td>
            <td class="px-6 py-4 text-center">
                <span class="px-3 py-1 text-xs font-bold rounded-full \${w.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 'bg-emerald-100 text-emerald-700'}">\${w.status}</span>
            </td>
            <td class="px-6 py-4 text-center">
                \${w.status === 'Pending' ? \`
                    <div class="flex justify-center gap-2">
                        <button onclick="approveWithdrawal('\${w.id}')" class="px-3.5 py-1.5 text-xs bg-emerald-600 text-white rounded-xl font-bold">Approve + TXN</button>
                        <button onclick="rejectWithdrawal('\${w.id}')" class="px-3.5 py-1.5 text-xs bg-red-600 text-white rounded-xl font-bold">Reject</button>
                    </div>
                \` : '<span class="text-emerald-600 text-xs font-medium">Paid</span>'}
            </td>
        \`;
        tbody.appendChild(row);
    });
}

function approveWithdrawal(id) {
    const txn = prompt('Enter transaction ID / reference:', 'TXN' + Date.now().toString().slice(-8));
    if (!txn) return;
    
    const w = withdrawals.find(x => x.id === id);
    if (w) {
        w.status = 'Approved';
        alert('Withdrawal approved! Transaction ID: ' + txn);
        renderWithdrawals();
    }
}

function rejectWithdrawal(id) {
    const reason = prompt('Reason for rejection:');
    if (!reason) return;
    const w = withdrawals.find(x => x.id === id);
    if (w) {
        w.status = 'Rejected';
        alert('Withdrawal rejected. User will be notified.');
        renderWithdrawals();
    }
}

renderWithdrawals();
</script>
` 
}) %>
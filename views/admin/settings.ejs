<%
const s = settings || {};
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function field(name, label, type, value, step) {
  return '<div><label class="block text-sm font-medium mb-1.5 text-slate-700">' + label + '</label>' +
    '<input type="' + type + '" name="' + name + '" value="' + escapeHtml(value !== undefined && value !== null ? value : '') + '"' +
    (step ? ' step="' + step + '"' : '') +
    ' class="w-full border border-slate-200 px-4 py-3 rounded-2xl text-sm outline-none focus:border-blue-300"></div>';
}
function adminRow(a, currentAdminId) {
  const isSelf = String(a.id) === String(currentAdminId);
  return '<tr class="border-b border-slate-100"><td class="px-4 py-3 text-sm font-medium">' + escapeHtml(a.username) + '</td>' +
    '<td class="px-4 py-3 text-sm text-slate-500">' + escapeHtml(a.email || '-') + '</td>' +
    '<td class="px-4 py-3 text-xs text-slate-400">' + new Date(a.created_at).toLocaleDateString('en-US') + '</td>' +
    '<td class="px-4 py-3 text-center">' + (isSelf
      ? '<span class="text-xs text-slate-400">' + t("adms_you") + '</span>'
      : '<form method="POST" action="/admin/settings/admins/' + a.id + '/demote" data-confirm="' + t("adms_demote_confirm") + '">' +
          '<button type="submit" class="px-3 py-1.5 text-xs bg-red-100 text-red-600 rounded-xl font-semibold">Remove Admin</button></form>') +
    '</td></tr>';
}
%>
<%- include('partials/admin-layout', {
    title: 'Platform Settings',
    active: 'settings',
    body: `
<div class="max-w-4xl mx-auto space-y-6">
    <h2 class="text-2xl font-semibold text-slate-900">Platform Settings</h2>

    <form method="POST" action="/admin/settings/update" class="bg-white rounded-3xl border border-slate-100 p-6 space-y-5" data-loading-target="settingsSaveBtn" data-loading-label="Saving...">
        <h3 class="font-semibold text-slate-800 border-b pb-3">${t('adms_general')}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            ${field('site_name', t('adms_site_name'), 'text', s.site_name || 'Livo Betting')}
            ${field('support_email', t('adms_support_email'), 'email', s.support_email || '')}
        </div>

        <h3 class="font-semibold text-slate-800 border-b pb-3 pt-2">${t('adms_bet_limits')}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            ${field('min_bet', t('adms_min_bet'), 'number', s.min_bet || 10)}
            ${field('max_bet', t('adms_max_bet'), 'number', s.max_bet || 50000)}
            ${field('turnover_multiplier', t('adms_turnover_mult'), 'number', s.turnover_multiplier || 3, '0.1')}
            ${field('max_daily_bets', t('adms_max_daily_bets'), 'number', s.max_daily_bets || 0)}
        </div>

        <h3 class="font-semibold text-slate-800 border-b pb-3 pt-2">${t('adms_payment')}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            ${field('min_deposit', t('adms_min_deposit'), 'number', s.min_deposit || 100)}
            ${field('min_withdraw', t('adms_min_withdraw'), 'number', s.min_withdraw || 300)}
            ${field('deposit_commission_percent', t('adms_dep_commission'), 'number', s.deposit_commission_percent || 0, '0.1')}
            ${field('withdraw_commission_percent', t('adms_wd_commission'), 'number', s.withdraw_commission_percent || 0, '0.1')}
        </div>

        <h3 class="font-semibold text-slate-800 border-b pb-3 pt-2">${t('adms_referral_commission')}</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            ${field('referral_commission_tier1_percent', t('adms_tier1'), 'number', s.referral_commission_tier1_percent || 2.5, '0.01')}
            ${field('referral_commission_tier2_percent', 'Tier 2 (%)', 'number', s.referral_commission_tier2_percent || 1.5, '0.01')}
            ${field('referral_commission_tier3_percent', 'Tier 3 (%)', 'number', s.referral_commission_tier3_percent || 0.8, '0.01')}
        </div>
        <p class="text-xs text-slate-400 -mt-3">${t('adms_commission_hint')}</p>

        <h3 class="font-semibold text-slate-800 border-b pb-3 pt-2">${t('adms_security')}</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
            ${field('max_login_attempts', t('adms_max_login'), 'number', s.max_login_attempts || 5)}
            <label class="flex items-center gap-3 mt-6">
                <input type="hidden" name="maintenance_mode" value="false">
                <input type="checkbox" name="maintenance_mode" value="true" ${s.maintenance_mode ? 'checked' : ''} class="w-5 h-5 rounded">
                <span class="text-sm font-medium text-slate-700">🔧 ${t('adms_maintenance')}</span>
            </label>
        </div>

        <button type="submit" id="settingsSaveBtn" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-2xl transition-colors">Save Changes</button>
        ${saved ? '<span class="ml-4 text-emerald-600 text-sm font-medium"><i class="fas fa-check-circle"></i> ' + t("adms_saved") + '</span>' : ''}
        ${saveError ? '<span class="ml-4 text-red-600 text-sm font-medium"><i class="fas fa-triangle-exclamation"></i> ' + t("adms_save_error") + '</span>' : ''}
    </form>

    <div class="bg-white rounded-3xl border border-slate-100 p-6">
        <h3 class="font-semibold text-slate-800 mb-4">${t('adms_admin_list')}</h3>
        <form method="POST" action="/admin/settings/admins/promote" class="flex gap-2 mb-4">
            <input type="text" name="username" placeholder="${t('adms_add_placeholder')}" required class="flex-1 border px-4 py-2.5 rounded-2xl text-sm">
            <button type="submit" class="px-5 bg-slate-800 text-white rounded-2xl text-sm font-semibold">Promote</button>
        </form>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead><tr class="text-left text-xs text-slate-400 uppercase"><th class="px-4 py-2">Username</th><th class="px-4 py-2">Email</th><th class="px-4 py-2">Since</th><th class="px-4 py-2 text-center">Action</th></tr></thead>
                <tbody>${(admins || []).map(a => adminRow(a, user.id)).join('') || '<tr><td colspan="4" class="px-4 py-6 text-center text-slate-400 text-sm">' + t("adms_no_admins") + '</td></tr>'}</tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-slate-100 p-6">
        <h3 class="font-semibold text-slate-800 border-b pb-3 mb-4">${t('adms_2fa_heading')}</h3>
        <p class="text-sm text-slate-500 mb-4">${t('adms_2fa_desc')}</p>
        <a href="/admin/2fa/setup" class="inline-flex items-center gap-2 px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-sm font-semibold">
            <i class="fas fa-shield-halved"></i> ${t('adms_2fa_manage')}
        </a>
    </div>
</div>
`
}) %>

<%- include('../partials/head') %>
<div class="admin-wrap">
  <%- include('./partials/sidebar', { active: 'settings' }) %>
  <div class="admin-content">
    <div class="admin-topbar">
      <button class="admin-hamburger" onclick="toggleAdminSidebar()"><i class="fas fa-bars"></i></button>
      <h1 style="font-size:18px;font-weight:800;color:#fff;">⚙️ সেটিংস</h1>
    </div>
    <%- include('../partials/flash') %>

    <div class="admin-card" style="margin-bottom:20px;">
      <div class="admin-card-header">সাইট কনফিগারেশন</div>
      <form method="POST" action="/admin/settings/update" style="padding:16px;display:flex;flex-direction:column;gap:14px;">
        <div>
          <label style="color:#94a3b8;font-size:12px;display:block;margin-bottom:6px;">সর্বনিম্ন বেট (৳)</label>
          <input type="number" name="min_bet" value="<%= settings.min_bet %>" style="width:100%;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;">
        </div>
        <div>
          <label style="color:#94a3b8;font-size:12px;display:block;margin-bottom:6px;">সর্বোচ্চ বেট (৳)</label>
          <input type="number" name="max_bet" value="<%= settings.max_bet %>" style="width:100%;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;">
        </div>
        <div>
          <label style="color:#94a3b8;font-size:12px;display:block;margin-bottom:6px;">টার্নওভার মাল্টিপ্লায়ার (ডিপোজিট বোনাসের স্পোর্টস টার্নওভার — যেমন ৫ মানে বোনাসের ৫ গুণ বাজি ধরতে হবে)</label>
          <input type="number" name="turnover_multiplier" value="<%= settings.turnover_multiplier %>" style="width:100%;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;">
        </div>
        <div>
          <label style="color:#94a3b8;font-size:12px;display:block;margin-bottom:6px;">ডিপোজিট কমিশন (%)</label>
          <input type="number" step="0.01" name="deposit_commission_percent" value="<%= settings.deposit_commission_percent %>" style="width:100%;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;">
        </div>
        <div>
          <label style="color:#94a3b8;font-size:12px;display:block;margin-bottom:6px;">উইথড্র কমিশন (%)</label>
          <input type="number" step="0.01" name="withdraw_commission_percent" value="<%= settings.withdraw_commission_percent %>" style="width:100%;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;">
        </div>
        <button type="submit" style="background:#f59e0b;color:#000;border:none;padding:12px;border-radius:10px;font-weight:800;">সেভ করুন</button>
      </form>
    </div>

    <div class="admin-card" style="margin-bottom:20px;">
      <div class="admin-card-header">নতুন অ্যাডমিন যোগ করুন</div>
      <form method="POST" action="/admin/settings/admins/promote" style="padding:16px;display:flex;gap:10px;">
        <input type="text" name="username" required placeholder="ইউজারনেম দাও (আগে থেকে রেজিস্টার করা থাকতে হবে)" style="flex:1;background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;font-size:13px;">
        <button type="submit" style="background:#f59e0b;color:#000;border:none;padding:10px 18px;border-radius:10px;font-weight:800;font-size:13px;">অ্যাডমিন বানাও</button>
      </form>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">বর্তমান অ্যাডমিনরা</div>
      <div style="overflow-x:auto;">
        <table class="admin-table">
          <thead><tr><th>ইউজারনেম</th><th>ইমেইল</th><th>অ্যাকশন</th></tr></thead>
          <tbody>
            <% admins.forEach(function(a) { %>
              <tr>
                <td style="color:#fff;font-weight:700;"><%= a.username %></td>
                <td style="color:#94a3b8;"><%= a.email %></td>
                <td>
                  <form method="POST" action="/admin/settings/admins/<%= a.id %>/demote" onsubmit="return confirm('অ্যাডমিন অ্যাক্সেস বাতিল করবেন?')">
                    <button type="submit" style="background:rgba(239,68,68,0.15);color:#ef4444;border:none;padding:5px 10px;border-radius:6px;font-size:11px;font-weight:700;">রিমুভ করুন</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

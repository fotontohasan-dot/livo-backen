<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white">Settings</h1>
        <p class="text-gray-400 text-sm mt-1">Manage site configuration, betting rules & admin access</p>
      </div>
      <button onclick="window.location.reload()" 
              class="flex items-center gap-2 px-4 py-2.5 bg-[#1e2937] hover:bg-[#334155] border border-[#475569] text-white rounded-2xl text-sm font-medium transition-all">
        <i class="fas fa-sync-alt"></i>
        <span>Refresh</span>
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex border-b border-[#334155] mb-8">
      <button onclick="showTab(0)" class="tab-btn active px-6 py-3 text-sm font-semibold border-b-2 border-[#f59e0b] text-[#f59e0b]">General</button>
      <button onclick="showTab(1)" class="tab-btn px-6 py-3 text-sm font-semibold text-gray-400 hover:text-white">Betting Rules</button>
      <button onclick="showTab(2)" class="tab-btn px-6 py-3 text-sm font-semibold text-gray-400 hover:text-white">Payment</button>
      <button onclick="showTab(3)" class="tab-btn px-6 py-3 text-sm font-semibold text-gray-400 hover:text-white">Admin Management</button>
    </div>

    <!-- Tab 0: General Settings -->
    <div id="tab-0" class="tab-content">
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-8 mb-8">
        <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <i class="fas fa-globe text-[#f59e0b]"></i>
          <span>General Site Settings</span>
        </h3>

        <form action="/admin/settings/update" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm text-gray-400 mb-2">Site Name</label>
              <input type="text" name="site_name" value="<%= settings.site_name || 'Livo' %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Support Email</label>
              <input type="email" name="support_email" value="<%= settings.support_email || '' %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Maintenance Mode</label>
              <div class="flex items-center gap-3 mt-1">
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="maintenance_mode" <%= settings.maintenance_mode ? 'checked' : '' %> class="sr-only peer">
                  <div class="w-11 h-6 bg-[#475569] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#f59e0b]"></div>
                </label>
                <span class="text-sm text-gray-400">Enable maintenance mode</span>
              </div>
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Max Login Attempts</label>
              <input type="number" name="max_login_attempts" value="<%= settings.max_login_attempts || 5 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
          </div>

          <div class="mt-8">
            <button type="submit" class="px-8 py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl transition-all active:scale-[0.985]">
              Save General Settings
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tab 1: Betting Rules -->
    <div id="tab-1" class="tab-content hidden">
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-8 mb-8">
        <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <i class="fas fa-dice text-[#f59e0b]"></i>
          <span>Betting Rules & Limits</span>
        </h3>

        <form action="/admin/settings/update" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm text-gray-400 mb-2">Minimum Bet Amount (৳)</label>
              <input type="number" name="min_bet" value="<%= settings.min_bet || 10 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Maximum Bet Amount (৳)</label>
              <input type="number" name="max_bet" value="<%= settings.max_bet || 50000 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Turnover Multiplier</label>
              <input type="number" step="0.1" name="turnover_multiplier" value="<%= settings.turnover_multiplier || 1 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Max Daily Bets Per User</label>
              <input type="number" name="max_daily_bets" value="<%= settings.max_daily_bets || 50 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
          </div>

          <div class="mt-8">
            <button type="submit" class="px-8 py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl transition-all active:scale-[0.985]">
              Save Betting Rules
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tab 2: Payment Settings -->
    <div id="tab-2" class="tab-content hidden">
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-8 mb-8">
        <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <i class="fas fa-credit-card text-[#f59e0b]"></i>
          <span>Payment & Commission Settings</span>
        </h3>

        <form action="/admin/settings/update" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm text-gray-400 mb-2">Deposit Commission (%)</label>
              <input type="number" step="0.1" name="deposit_commission_percent" value="<%= settings.deposit_commission_percent || 0 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Withdraw Commission (%)</label>
              <input type="number" step="0.1" name="withdraw_commission_percent" value="<%= settings.withdraw_commission_percent || 0 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Minimum Deposit (৳)</label>
              <input type="number" name="min_deposit" value="<%= settings.min_deposit || 100 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-2">Minimum Withdraw (৳)</label>
              <input type="number" name="min_withdraw" value="<%= settings.min_withdraw || 500 %>" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
            </div>
          </div>

          <div class="mt-8">
            <button type="submit" class="px-8 py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl transition-all active:scale-[0.985]">
              Save Payment Settings
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tab 3: Admin Management -->
    <div id="tab-3" class="tab-content hidden">
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-8">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-semibold text-white flex items-center gap-2">
            <i class="fas fa-user-shield text-[#f59e0b]"></i>
            <span>Admin Management</span>
          </h3>
          <span class="text-xs px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full"><%= admins.length %> Admins</span>
        </div>

        <!-- Add New Admin -->
        <form action="/admin/settings/admins/promote" method="POST" class="flex flex-col md:flex-row gap-3 mb-8">
          <input type="text" name="username" placeholder="Enter username to promote as admin" 
                 class="flex-1 bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]" required>
          <button type="submit" 
                  class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl transition-all active:scale-[0.985] whitespace-nowrap">
            <i class="fas fa-user-plus mr-2"></i> Promote to Admin
          </button>
        </form>

        <!-- Current Admins Table -->
        <div>
          <h4 class="text-sm text-gray-400 mb-3">Current Admins</h4>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-[#334155] text-left">
                  <th class="py-3 px-4 text-xs font-semibold text-gray-400">Username</th>
                  <th class="py-3 px-4 text-xs font-semibold text-gray-400">Email</th>
                  <th class="py-3 px-4 text-xs font-semibold text-gray-400">Joined</th>
                  <th class="py-3 px-4 text-xs font-semibold text-gray-400 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#334155]">
                <% admins.forEach(a => { %>
                  <tr class="hover:bg-[#0f172a] transition-colors">
                    <td class="py-4 px-4">
                      <div class="font-semibold text-white"><%= a.username %></div>
                    </td>
                    <td class="py-4 px-4 text-gray-400 text-sm"><%= a.email || 'N/A' %></td>
                    <td class="py-4 px-4 text-gray-400 text-sm">
                      <%= a.created_at ? new Date(a.created_at).toLocaleDateString() : 'N/A' %>
                    </td>
                    <td class="py-4 px-4 text-right">
                      <form action="/admin/settings/admins/<%= a.id %>/demote" method="POST" 
                            onsubmit="return confirm('Remove admin access from <%= a.username %>?')">
                        <button type="submit" 
                                class="px-4 py-1.5 text-xs bg-red-600 hover:bg-red-700 rounded-xl text-white font-medium transition-all">
                          Remove Admin
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
function showTab(tabIndex) {
  // Hide all tabs
  document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
  // Remove active from all buttons
  document.querySelectorAll('.tab-btn').forEach(el => {
    el.classList.remove('active', 'border-b-2', 'border-[#f59e0b]', 'text-[#f59e0b]');
    el.classList.add('text-gray-400');
  });
  // Show selected tab
  document.getElementById('tab-' + tabIndex).classList.remove('hidden');
  // Activate button
  const btns = document.querySelectorAll('.tab-btn');
  btns[tabIndex].classList.add('active', 'border-b-2', 'border-[#f59e0b]', 'text-[#f59e0b]');
  btns[tabIndex].classList.remove('text-gray-400');
}

// Show first tab by default
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('tab-0').classList.remove('hidden');
});
</script>

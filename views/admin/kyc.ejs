<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_kyc') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .kyc-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
    .kyc-filters .input-icon-wrap { flex: 1; min-width: 180px; }
    .kyc-filters .select { width: auto; min-width: 130px; }
    .doc-preview { width: 100%; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); margin-top: 8px; }
    .kv-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 12px; }
    .kv-row span:first-child { color: #94a3b8; }
    .kv-row span:last-child { color: #e2e8f0; font-weight: 600; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'kyc' }) %>

    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', {
        pageTitle: 'KYC ভেরিফিকেশন',
        pageSubtitle: 'ইউজারদের পরিচয়পত্র যাচাই ও অনুমোদন'
      }) %>

      <div class="grid grid-4" style="margin-bottom:14px;">
        <div class="stat-card">
          <div class="stat-label"><%= t('admin_stat_total_applications') %></div>
          <div class="stat-number"><%= stats.total || 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label"><%= t('admin_status_pending') %></div>
          <div class="stat-number" style="color:#f59e0b;"><%= stats.pending || 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label"><%= t('admin_status_approved') %></div>
          <div class="stat-number" style="color:#10b981;"><%= stats.approved || 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label"><%= t('admin_btn_cancel') %></div>
          <div class="stat-number" style="color:#ef4444;"><%= stats.rejected || 0 %></div>
        </div>
      </div>

      <form class="kyc-filters" method="GET" action="/admin/kyc">
        <div class="input-icon-wrap">
          <i class="fas fa-search"></i>
          <input class="input" type="text" name="q" placeholder="<%= t('admin_ph_search_name_user_phone') %>" value="<%= filters.q || '' %>">
        </div>
        <select class="select" name="status" data-auto-submit>
          <option value=""><%= t('admin_filter_all_status') %></option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>><%= t('admin_status_pending') %></option>
          <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>><%= t('admin_status_approved') %></option>
          <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>><%= t('admin_btn_cancel') %></option>
        </select>
        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> <%= t('admin_btn_filter') %></button>
      </form>

      <div class="admin-card" id="kycBulkBar" style="display:none;padding:10px 14px;margin-bottom:14px;background:rgba(245,158,11,0.08);border-color:rgba(245,158,11,0.25);">
        <span style="font-size:12px;color:var(--text-muted);font-weight:600;"><span id="kycSelectedCount">0</span> <%= t('admin_kyc_selected_suffix') %></span>
        <button type="button" class="btn btn-sm btn-green" style="margin-left:10px;" data-kyc-bulk-approve><i class="fas fa-check"></i> <%= t('admin_btn_bulk_approve') %></button>
        <button type="button" class="btn btn-sm btn-red" data-kyc-bulk-reject><i class="fas fa-times"></i> <%= t('admin_btn_bulk_reject') %></button>
        <button type="button" class="btn btn-sm" data-kyc-clear-selection><%= t('admin_btn_clear_selection') %></button>
      </div>

      <div class="admin-card">
        <div class="admin-card-header"><%= t('admin_kyc_applications') %></div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width:34px;"><input type="checkbox" id="kycSelectAll"></th>
                <th><%= t('admin_col_user') %></th>
                <th><%= t('admin_col_document') %></th>
                <th><%= t('admin_col_submitted_at') %></th>
                <th><%= t('admin_col_status') %></th>
                <th style="text-align:right;"><%= t('admin_col_action') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (kycList && kycList.length > 0) { %>
                <% kycList.forEach(k => { %>
                  <tr>
                    <td>
                      <% if (k.status === 'pending') { %>
                        <input type="checkbox" class="kyc-row-check" value="<%= k.id %>">
                      <% } %>
                    </td>
                    <td>
                      <div style="font-weight:700;"><%= k.full_name || k.username || 'N/A' %></div>
                      <div style="color:var(--text-muted);font-size:11px;">@<%= k.username || '—' %> · <%= k.phone || '—' %></div>
                    </td>
                    <td><%= k.document_type || '—' %></td>
                    <td><%= k.created_at ? new Date(k.created_at).toLocaleDateString('bn-BD') : '—' %></td>
                    <td>
                      <% if (k.status === 'approved') { %>
                        <span class="badge badge-green"><%= t('admin_status_approved') %></span>
                      <% } else if (k.status === 'rejected') { %>
                        <span class="badge badge-red"><%= t('admin_btn_cancel') %></span>
                      <% } else { %>
                        <span class="badge badge-amber"><%= t('admin_status_pending') %></span>
                      <% } %>
                    </td>
                    <td style="text-align:right;">
                      <button class="btn btn-sm" data-kyc-view="<%= k.id %>"><%= t('admin_col_details') %></button>
                      <% if (k.status === 'pending') { %>
                        <button class="btn btn-sm btn-green" data-kyc-approve="<%= k.id %>"><%= t('admin_btn_approve') %></button>
                        <button class="btn btn-sm btn-red" data-kyc-reject="<%= k.id %>"><%= t('admin_btn_cancel') %></button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="5"><div class="empty-state"><i class="fas fa-id-card" style="font-size:22px;margin-bottom:8px;display:block;"></i><%= t('admin_empty_kyc') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- View Modal -->
  <div class="modal-overlay" id="viewModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3><%= t('admin_kyc_detail_heading') %></h3>
        <button class="modal-close" data-modal-close="viewModal" aria-label="<%= t('admin_ui_close') %>"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body" id="viewModalBody"></div>
    </div>
  </div>

  <!-- Reject Modal -->
  <div class="modal-overlay" id="rejectModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3><%= t('admin_field_reject_reason') %></h3>
        <button class="modal-close" data-modal-close="rejectModal" aria-label="<%= t('admin_ui_close') %>"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <textarea class="input" id="rejectReason" rows="3" placeholder="<%= t('admin_ph_reason_shown_to_user') %>"></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn" data-modal-close="rejectModal"><%= t('admin_btn_reject') %></button>
        <button class="btn btn-red" id="confirmRejectBtn"><%= t('admin_confirm_reject') %></button>
      </div>
    </div>
  </div>

  <!-- Bulk Reject Modal -->
  <div class="modal-overlay" id="bulkRejectModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3><%= t('admin_field_bulk_reject_reason') %></h3>
        <button class="modal-close" data-modal-close="bulkRejectModal" aria-label="<%= t('admin_ui_close') %>"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <p style="font-size:12px;color:var(--text-muted);margin-top:0;"><span id="bulkRejectCount">0</span> <%= t('admin_kyc_bulk_reject_note') %></p>
        <textarea class="input" id="bulkRejectReason" rows="3" placeholder="<%= t('admin_ph_reason_shown_to_user') %>"></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn" data-modal-close="bulkRejectModal"><%= t('admin_btn_reject') %></button>
        <button class="btn btn-red" id="confirmBulkRejectBtn"><%= t('admin_confirm_reject') %></button>
      </div>
    </div>
  </div>

  <%# KYC ডেটা executable স্ক্রিপ্ট নয় — type="application/json" ব্লক, তাই CSP-র
     script-src এতে বাধা দেয় না এবং কোনো nonce লাগে না। %>
  <script type="application/json" id="kycConfig"><%- jsonScriptSafe({ docAlt: t('admin_ui_kyc_document') }) %></script>
  <%# শুধু মডালে দরকারি ফিল্ডগুলো পাঠানো হয়। আসল document_url (Cloudinary
     ঠিকানা) ইচ্ছাকৃতভাবে বাদ — ওটা পেইজের HTML-এ থাকলে ব্রাউজার ইতিহাস,
     রেফারার হেডার ও এক্সটেনশনে ছড়িয়ে পড়ত। ক্লায়েন্টের শুধু জানা দরকার
     ডকুমেন্ট আছে কি না; দেখার সময় প্রমাণীকৃত প্রক্সি রুট ব্যবহার হয়। %>
  <script type="application/json" id="kycData"><%- jsonScriptSafe((kycList || []).map(k => ({
    id: k.id,
    full_name: k.full_name,
    username: k.username,
    phone: k.phone,
    document_type: k.document_type,
    document_number: k.document_number,
    created_at: k.created_at,
    has_document: !!k.document_url
  }))) %></script>
  <script src="/js/admin-kyc.js"></script>
</body>
</html>

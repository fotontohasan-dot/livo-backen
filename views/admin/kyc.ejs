<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KYC Verification • Livo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-950 text-white">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { activePage: 'kyc' }) %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header -->
            <%- include('../partials/header', { 
                pageTitle: 'KYC Verification', 
                pageSubtitle: 'Review and manage user identity documents' 
            }) %>

            <main class="flex-1 overflow-y-auto p-6">
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Total Applications</p>
                                <p class="text-3xl font-bold mt-1"><%= stats.total || 0 %></p>
                            </div>
                            <div class="w-12 h-12 bg-blue-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-id-card text-blue-400 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Pending Review</p>
                                <p class="text-3xl font-bold mt-1 text-yellow-400"><%= stats.pending || 0 %></p>
                            </div>
                            <div class="w-12 h-12 bg-yellow-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-clock text-yellow-400 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Approved</p>
                                <p class="text-3xl font-bold mt-1 text-emerald-400"><%= stats.approved || 0 %></p>
                            </div>
                            <div class="w-12 h-12 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-check-circle text-emerald-400 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-slate-400 text-sm">Rejected</p>
                                <p class="text-3xl font-bold mt-1 text-red-400"><%= stats.rejected || 0 %></p>
                            </div>
                            <div class="w-12 h-12 bg-red-500/10 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-times-circle text-red-400 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search and Filter -->
                <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 mb-6">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <div class="relative">
                                <i class="fas fa-search absolute left-4 top-3.5 text-slate-400"></i>
                                <input type="text" id="searchInput" placeholder="Search by name or user ID..." 
                                       class="w-full bg-slate-800 border border-slate-700 pl-11 pr-4 py-3 rounded-2xl text-sm focus:outline-none focus:border-blue-500">
                            </div>
                        </div>
                        <select id="statusFilter" class="bg-slate-800 border border-slate-700 px-4 py-3 rounded-2xl text-sm focus:outline-none focus:border-blue-500">
                            <option value="">All Status</option>
                            <option value="pending">Pending</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                        </select>
                        <button onclick="exportCSV()" 
                                class="px-6 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-2xl text-sm flex items-center gap-2 transition-colors">
                            <i class="fas fa-download"></i>
                            <span>Export CSV</span>
                        </button>
                    </div>
                </div>

                <!-- KYC Table -->
                <div class="bg-slate-900 border border-slate-700 rounded-3xl overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-slate-800">
                            <tr>
                                <th class="text-left px-6 py-4 text-sm font-medium text-slate-300">User</th>
                                <th class="text-left px-6 py-4 text-sm font-medium text-slate-300">Document Type</th>
                                <th class="text-left px-6 py-4 text-sm font-medium text-slate-300">Submitted</th>
                                <th class="text-left px-6 py-4 text-sm font-medium text-slate-300">Status</th>
                                <th class="text-right px-6 py-4 text-sm font-medium text-slate-300">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700" id="kycTableBody">
                            <% if (kycList && kycList.length > 0) { %>
                                <% kycList.forEach(kyc => { %>
                                    <tr class="hover:bg-slate-800/50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center">
                                                    <i class="fas fa-user text-slate-400"></i>
                                                </div>
                                                <div>
                                                    <p class="font-medium"><%= kyc.userName || 'N/A' %></p>
                                                    <p class="text-xs text-slate-400"><%= kyc.userId || '' %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-sm"><%= kyc.documentType || 'NID / Passport' %></td>
                                        <td class="px-6 py-4 text-sm text-slate-300"><%= kyc.submittedAt ? new Date(kyc.submittedAt).toLocaleDateString() : 'N/A' %></td>
                                        <td class="px-6 py-4">
                                            <% if (kyc.status === 'approved') { %>
                                                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/10 text-emerald-400">Approved</span>
                                            <% } else if (kyc.status === 'rejected') { %>
                                                <span class="px-3 py-1 text-xs rounded-full bg-red-500/10 text-red-400">Rejected</span>
                                            <% } else { %>
                                                <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/10 text-yellow-400">Pending</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <button onclick="viewDocument('<%= kyc.id %>')" 
                                                        class="px-4 py-2 text-sm bg-slate-800 hover:bg-slate-700 rounded-xl transition-colors">
                                                    View
                                                </button>
                                                <% if (kyc.status === 'pending') { %>
                                                    <button onclick="approveKYC('<%= kyc.id %>')" 
                                                            class="px-4 py-2 text-sm bg-emerald-600 hover:bg-emerald-700 rounded-xl transition-colors">
                                                        Approve
                                                    </button>
                                                    <button onclick="rejectKYC('<%= kyc.id %>')" 
                                                            class="px-4 py-2 text-sm bg-red-600 hover:bg-red-700 rounded-xl transition-colors">
                                                        Reject
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                                        No KYC applications found
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </main>
        </div>
    </div>

    <!-- Modals for View, Approve, Reject -->
    <!-- Add your modal HTML/JS here (same as previous modern version) -->

    <script>
        // Search and Filter JS
        function filterTable() {
            // Add your filter logic here
            console.log('Filtering...');
        }

        function exportCSV() {
            alert('CSV export triggered (implement backend if needed)');
        }

        function viewDocument(id) {
            alert('View document for ID: ' + id + ' (implement modal)');
        }

        function approveKYC(id) {
            if (confirm('Approve this KYC?')) {
                // Call your backend route
                window.location.href = '/admin/kyc/approve/' + id;
            }
        }

        function rejectKYC(id) {
            const reason = prompt('Enter rejection reason:');
            if (reason) {
                // Call your backend route with reason
                window.location.href = '/admin/kyc/reject/' + id + '?reason=' + encodeURIComponent(reason);
            }
        }

        // Attach filter listeners
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);
    </script>
</body>
</html>

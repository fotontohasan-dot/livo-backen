<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KYC Management - Livo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { font-family: 'Inter', system_ui, sans-serif; }
        .admin-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .admin-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .status-badge { padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
        .table-row { transition: background-color 0.2s; }
        .table-row:hover { background-color: #f8fafc; }
        .modal { animation: fadeInScale 0.2s ease-out forwards; }
        @keyframes fadeInScale { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        .nav-active { background-color: #1e40af; color: white; border-radius: 8px; }
    </style>
</head>
<body class="bg-slate-50">
    <!-- Top Navbar -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-screen-2xl mx-auto">
            <div class="flex items-center justify-between h-16 px-8">
                <div class="flex items-center gap-x-3">
                    <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
                        <i class="fas fa-shield-alt text-white text-2xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-2xl text-slate-900">Livo</span>
                        <span class="text-blue-600 font-bold text-2xl">Admin</span>
                    </div>
                </div>
                
                <div class="flex items-center gap-x-4">
                    <div class="flex items-center gap-x-2 bg-slate-100 rounded-full px-4 py-1.5">
                        <img src="https://i.pravatar.cc/32?img=12" class="w-8 h-8 rounded-full ring-2 ring-white" alt="Admin">
                        <div class="text-sm">
                            <div class="font-semibold text-slate-700">Admin User</div>
                        </div>
                    </div>
                    <button onclick="logout()" class="px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 rounded-xl flex items-center gap-x-2 transition-colors">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-screen-2xl mx-auto flex">
        <!-- Sidebar -->
        <div class="w-72 bg-white border-r border-slate-200 min-h-screen p-6 hidden lg:block">
            <div class="mb-8">
                <div class="text-xs font-semibold text-slate-400 tracking-widest mb-3 px-3">MAIN MENU</div>
                <nav class="space-y-1">
                    <a href="/admin/dashboard" class="flex items-center gap-x-3 px-4 py-3 text-slate-600 hover:bg-slate-100 rounded-2xl text-sm font-medium">
                        <i class="fas fa-chart-line w-5"></i> <span>Dashboard</span>
                    </a>
                    <a href="/admin/users" class="flex items-center gap-x-3 px-4 py-3 text-slate-600 hover:bg-slate-100 rounded-2xl text-sm font-medium">
                        <i class="fas fa-users w-5"></i> <span>Users</span>
                    </a>
                    <a href="/admin/kyc" class="flex items-center gap-x-3 px-4 py-3 nav-active text-sm font-medium">
                        <i class="fas fa-id-card w-5"></i> <span>KYC Verification</span>
                    </a>
                    <a href="/admin/bets" class="flex items-center gap-x-3 px-4 py-3 text-slate-600 hover:bg-slate-100 rounded-2xl text-sm font-medium">
                        <i class="fas fa-ticket-alt w-5"></i> <span>Bets</span>
                    </a>
                    <a href="/admin/matches" class="flex items-center gap-x-3 px-4 py-3 text-slate-600 hover:bg-slate-100 rounded-2xl text-sm font-medium">
                        <i class="fas fa-futbol w-5"></i> <span>Matches</span>
                    </a>
                    <a href="/admin/markets" class="flex items-center gap-x-3 px-4 py-3 text-slate-600 hover:bg-slate-100 rounded-2xl text-sm font-medium">
                        <i class="fas fa-chart-bar w-5"></i> <span>Markets</span>
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-slate-900">KYC Verification</h1>
                    <p class="text-slate-500 mt-1">Manage user identity verification requests</p>
                </div>
                <div class="flex items-center gap-x-3">
                    <button onclick="exportKYC()" 
                            class="px-5 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-2xl text-sm font-semibold flex items-center gap-x-2 transition-all active:scale-[0.985]">
                        <i class="fas fa-download"></i>
                        <span>Export CSV</span>
                    </button>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="admin-card bg-white rounded-3xl p-6 border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-500">Pending Review</p>
                            <p class="text-4xl font-bold text-amber-600 mt-2"><%= pendingCount || 47 %></p>
                        </div>
                        <div class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center">
                            <i class="fas fa-clock text-3xl text-amber-600"></i>
                        </div>
                    </div>
                </div>
                
                <div class="admin-card bg-white rounded-3xl p-6 border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-500">Approved Today</p>
                            <p class="text-4xl font-bold text-emerald-600 mt-2"><%= approvedToday || 128 %></p>
                        </div>
                        <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center">
                            <i class="fas fa-check-circle text-3xl text-emerald-600"></i>
                        </div>
                    </div>
                </div>

                <div class="admin-card bg-white rounded-3xl p-6 border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-500">Rejected</p>
                            <p class="text-4xl font-bold text-red-600 mt-2"><%= rejectedCount || 19 %></p>
                        </div>
                        <div class="w-14 h-14 bg-red-100 rounded-2xl flex items-center justify-center">
                            <i class="fas fa-times-circle text-3xl text-red-600"></i>
                        </div>
                    </div>
                </div>

                <div class="admin-card bg-white rounded-3xl p-6 border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-500">Total Submitted</p>
                            <p class="text-4xl font-bold text-slate-900 mt-2"><%= totalKYC || 194 %></p>
                        </div>
                        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center">
                            <i class="fas fa-id-card text-3xl text-blue-600"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 mb-6">
                <div class="flex flex-col lg:flex-row gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <i class="fas fa-search absolute left-4 top-3.5 text-slate-400"></i>
                            <input type="text" id="searchInput" placeholder="Search by name, email or user ID..." 
                                   class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:outline-none focus:border-blue-500"
                                   onkeyup="filterTable()">
                        </div>
                    </div>
                    <div>
                        <select id="statusFilter" onchange="filterTable()" 
                                class="px-5 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm font-medium focus:outline-none focus:border-blue-500">
                            <option value="">All Status</option>
                            <option value="pending">Pending</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- KYC Table -->
            <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200">
                                <th class="px-8 py-4 text-left text-xs font-semibold text-slate-500 tracking-wider">USER</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 tracking-wider">SUBMITTED</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 tracking-wider">STATUS</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 tracking-wider">DOCUMENTS</th>
                                <th class="px-8 py-4 text-right text-xs font-semibold text-slate-500 tracking-wider">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody id="kycTableBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Dynamic rows populated by EJS or JS -->
                            <% if (kycRequests && kycRequests.length > 0) { %>
                                <% kycRequests.forEach((kyc, index) => { %>
                                <tr class="table-row" data-status="<%= kyc.status %>">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-x-4">
                                            <img src="<%= kyc.userAvatar || 'https://i.pravatar.cc/40?img=' + (index % 8 + 1) %>" class="w-10 h-10 rounded-2xl ring-2 ring-slate-100" alt="">
                                            <div>
                                                <div class="font-semibold text-slate-800"><%= kyc.userName || 'User ' + kyc.userId %></div>
                                                <div class="text-xs text-slate-500"><%= kyc.userEmail || 'user@example.com' %></div>
                                                <div class="text-[10px] text-slate-400 mt-0.5">ID: #<%= kyc.userId %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="text-slate-700"><%= kyc.submittedAt || '2 hours ago' %></div>
                                        <div class="text-xs text-slate-400"><%= kyc.submittedDate || 'Jan 08, 2026' %></div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <% if (kyc.status === 'pending') { %>
                                            <span class="status-badge bg-amber-100 text-amber-700">Pending Review</span>
                                        <% } else if (kyc.status === 'approved') { %>
                                            <span class="status-badge bg-emerald-100 text-emerald-700">Approved</span>
                                        <% } else { %>
                                            <span class="status-badge bg-red-100 text-red-700">Rejected</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-5">
                                        <button onclick="viewDocuments(<%= kyc.id %>, '<%= kyc.userName %>')" 
                                                class="inline-flex items-center gap-x-2 px-4 py-2 text-sm font-medium text-blue-600 hover:bg-blue-50 rounded-2xl transition-colors">
                                            <i class="fas fa-file-alt"></i>
                                            <span>View Documents</span>
                                        </button>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <% if (kyc.status === 'pending') { %>
                                            <div class="flex items-center justify-end gap-x-2">
                                                <button onclick="approveKYC(<%= kyc.id %>, '<%= kyc.userName %>')" 
                                                        class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-2xl transition-all active:scale-95 flex items-center gap-x-2">
                                                    <i class="fas fa-check"></i>
                                                    <span>Approve</span>
                                                </button>
                                                <button onclick="rejectKYC(<%= kyc.id %>, '<%= kyc.userName %>')" 
                                                        class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-2xl transition-all active:scale-95 flex items-center gap-x-2">
                                                    <i class="fas fa-times"></i>
                                                    <span>Reject</span>
                                                </button>
                                            </div>
                                        <% } else { %>
                                            <span class="text-xs text-slate-400 font-medium">Processed</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <!-- Sample Data if no kycRequests passed -->
                                <tr class="table-row" data-status="pending">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-x-4">
                                            <img src="https://i.pravatar.cc/40?img=28" class="w-10 h-10 rounded-2xl ring-2 ring-slate-100">
                                            <div>
                                                <div class="font-semibold text-slate-800">Rahim Khan</div>
                                                <div class="text-xs text-slate-500">rahim.khan@gmail.com</div>
                                                <div class="text-[10px] text-slate-400 mt-0.5">ID: #28491</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="text-slate-700">Just now</div>
                                        <div class="text-xs text-slate-400">Jan 09, 2026</div>
                                    </td>
                                    <td class="px-6 py-5"><span class="status-badge bg-amber-100 text-amber-700">Pending Review</span></td>
                                    <td class="px-6 py-5">
                                        <button onclick="viewDocuments(1, 'Rahim Khan')" class="inline-flex items-center gap-x-2 px-4 py-2 text-sm font-medium text-blue-600 hover:bg-blue-50 rounded-2xl">
                                            <i class="fas fa-file-alt"></i> <span>View Documents</span>
                                        </button>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-x-2">
                                            <button onclick="approveKYC(1, 'Rahim Khan')" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-2xl flex items-center gap-x-2 active:scale-95 transition-all">
                                                <i class="fas fa-check"></i> <span>Approve</span>
                                            </button>
                                            <button onclick="rejectKYC(1, 'Rahim Khan')" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-2xl flex items-center gap-x-2 active:scale-95 transition-all">
                                                <i class="fas fa-times"></i> <span>Reject</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- More sample rows... (similar structure for demo) -->
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- View Documents Modal -->
    <div id="docModal" onclick="if (event.target.id === 'docModal') closeDocModal()" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
        <div onclick="event.stopImmediatePropagation()" class="modal bg-white rounded-3xl max-w-2xl w-full shadow-2xl border border-slate-100">
            <div class="px-8 py-6 border-b flex items-center justify-between">
                <div>
                    <div class="font-bold text-xl">Submitted Documents</div>
                    <div id="docUserName" class="text-sm text-slate-500"></div>
                </div>
                <button onclick="closeDocModal()" class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-2xl text-2xl leading-none">&times;</button>
            </div>
            <div class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="border border-slate-200 rounded-2xl p-5 hover:border-blue-200 transition-colors">
                        <div class="flex items-center gap-x-3 mb-3">
                            <i class="fas fa-id-card text-blue-600 text-xl"></i>
                            <span class="font-semibold">National ID / Passport</span>
                        </div>
                        <button onclick="previewDocument('NID')" class="mt-2 text-sm px-4 py-2 bg-blue-600 text-white rounded-2xl text-xs font-semibold flex items-center gap-x-2">
                            <i class="fas fa-eye"></i> <span>VIEW / DOWNLOAD</span>
                        </button>
                    </div>
                    <div class="border border-slate-200 rounded-2xl p-5 hover:border-blue-200 transition-colors">
                        <div class="flex items-center gap-x-3 mb-3">
                            <i class="fas fa-file-image text-emerald-600 text-xl"></i>
                            <span class="font-semibold">Selfie Photo</span>
                        </div>
                        <button onclick="previewDocument('Selfie')" class="mt-2 text-sm px-4 py-2 bg-emerald-600 text-white rounded-2xl text-xs font-semibold flex items-center gap-x-2">
                            <i class="fas fa-eye"></i> <span>VIEW / DOWNLOAD</span>
                        </button>
                    </div>
                </div>
                <div class="mt-6 text-xs text-slate-500 flex items-center gap-x-2">
                    <i class="fas fa-info-circle"></i> 
                    <span>Documents are securely stored. All actions are logged.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Approve / Reject Modal -->
    <div id="actionModal" onclick="if (event.target.id === 'actionModal') closeActionModal()" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
        <div onclick="event.stopImmediatePropagation()" class="modal bg-white rounded-3xl max-w-md w-full shadow-2xl">
            <div class="px-8 py-6 border-b">
                <div id="actionTitle" class="font-bold text-xl"></div>
                <div id="actionSubtitle" class="text-sm text-slate-500 mt-1"></div>
            </div>
            <div class="p-8">
                <div id="reasonSection" class="mb-6">
                    <label class="block text-sm font-semibold text-slate-600 mb-2">Reason (optional for approve)</label>
                    <textarea id="actionReason" rows="3" placeholder="Enter reason..." 
                              class="w-full border border-slate-200 rounded-2xl p-4 text-sm focus:border-blue-500 focus:ring-0"></textarea>
                </div>
                
                <div class="flex gap-x-3">
                    <button onclick="closeActionModal()" 
                            class="flex-1 py-3 rounded-2xl border border-slate-300 font-semibold text-sm hover:bg-slate-50 transition-colors">Cancel</button>
                    <button id="confirmActionBtn" 
                            class="flex-1 py-3 rounded-2xl font-semibold text-sm text-white transition-all active:scale-[0.985]">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('#kycTableBody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const rowStatus = row.getAttribute('data-status');
                const matchesSearch = text.includes(search);
                const matchesStatus = !status || rowStatus === status;
                row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
            });
        }

        let currentKYCId = null;
        let currentAction = null;

        function viewDocuments(kycId, userName) {
            document.getElementById('docUserName').innerHTML = `<span class="font-medium">${userName}</span> • KYC #${kycId}`;
            document.getElementById('docModal').classList.remove('hidden');
            document.getElementById('docModal').classList.add('flex');
        }

        function closeDocModal() {
            const modal = document.getElementById('docModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function previewDocument(type) {
            alert(`Opening ${type} document preview... (In production this will open secure document viewer)`);
            // In real app: window.open(`/admin/kyc/document/${kycId}/${type}`, '_blank')
        }

        function approveKYC(kycId, userName) {
            currentKYCId = kycId;
            currentAction = 'approve';
            document.getElementById('actionTitle').innerHTML = `<i class="fas fa-check-circle text-emerald-600 mr-2"></i> Approve KYC`;
            document.getElementById('actionSubtitle').innerHTML = `Approving request for <strong>${userName}</strong>`;
            document.getElementById('reasonSection').style.display = 'block';
            document.getElementById('confirmActionBtn').innerHTML = `<i class="fas fa-check mr-2"></i> Confirm Approve`;
            document.getElementById('confirmActionBtn').className = `flex-1 py-3 rounded-2xl font-semibold text-sm bg-emerald-600 hover:bg-emerald-700 text-white`;
            document.getElementById('actionModal').classList.remove('hidden');
            document.getElementById('actionModal').classList.add('flex');
        }

        function rejectKYC(kycId, userName) {
            currentKYCId = kycId;
            currentAction = 'reject';
            document.getElementById('actionTitle').innerHTML = `<i class="fas fa-times-circle text-red-600 mr-2"></i> Reject KYC`;
            document.getElementById('actionSubtitle').innerHTML = `Rejecting request for <strong>${userName}</strong>`;
            document.getElementById('reasonSection').style.display = 'block';
            document.getElementById('confirmActionBtn').innerHTML = `<i class="fas fa-times mr-2"></i> Confirm Reject`;
            document.getElementById('confirmActionBtn').className = `flex-1 py-3 rounded-2xl font-semibold text-sm bg-red-600 hover:bg-red-700 text-white`;
            document.getElementById('actionModal').classList.remove('hidden');
            document.getElementById('actionModal').classList.add('flex');
        }

        function closeActionModal() {
            const modal = document.getElementById('actionModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.getElementById('actionReason').value = '';
        }

        function confirmAction() {
            const reason = document.getElementById('actionReason').value.trim();
            
            if (currentAction === 'approve') {
                // Call your backend route: POST /admin/kyc/approve/:id
                alert(`KYC #${currentKYCId} has been APPROVED.\nReason: ${reason || 'No reason provided'}`);
                // In real: fetch(`/admin/kyc/approve/${currentKYCId}`, { method: 'POST', body: JSON.stringify({reason}) })
            } else if (currentAction === 'reject') {
                if (!reason) {
                    alert("Please provide a reason for rejection.");
                    return;
                }
                alert(`KYC #${currentKYCId} has been REJECTED.\nReason: ${reason}`);
                // In real: fetch(`/admin/kyc/reject/${currentKYCId}`, { method: 'POST', body: JSON.stringify({reason}) })
            }
            
            closeActionModal();
            // Optional: reload page or remove row from table
            setTimeout(() => location.reload(), 800);
        }

        // Attach confirm button
        document.getElementById('confirmActionBtn').addEventListener('click', confirmAction);

        function exportKYC() {
            alert('Exporting KYC data as CSV... (Implement backend export route)');
            // window.location.href = '/admin/kyc/export'
        }

        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                window.location.href = '/admin/logout';
            }
        }

        // Keyboard support
        document.addEventListener('keydown', function(e) {
            if (e.key === "Escape") {
                const docModal = document.getElementById('docModal');
                const actionModal = document.getElementById('actionModal');
                if (!docModal.classList.contains('hidden')) closeDocModal();
                else if (!actionModal.classList.contains('hidden')) closeActionModal();
            }
        });

        // Initial filter setup
        console.log('%c[KYC Modern] Modern KYC page loaded successfully', 'color:#64748b');
    </script>
</body>
</html>

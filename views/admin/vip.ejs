<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_vip') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz23-1 { margin-bottom: 14px; }
  .dz23-2 { color: #f59e0b; }
  .dz23-3 { color: #10b981; }
  .dz23-4 { color: #3b82f6; }
  .dz23-5 { color: #a855f7; }
  .dz23-6 { margin-bottom: 16px; }
  .dz23-7 { float: right; font-size: 12px; color: #f59e0b; text-decoration: none; }
  .dz23-8 { overflow-x: auto; }
  .dz23-9 { font-weight: 700; }
  .dz23-10 { margin-bottom: 8px; }
  .dz23-11 { display: flex; justify-content: space-between; align-items: center; }
  .dz23-12 { font-weight: 800; color: var(--text-main); font-size: 14px; }
  .dz23-13 { padding: 6px 14px; font-size: 12px; }
  .dz23-14 { margin-top: 10px; }
  .dz23-15 { width: 100%; }
  .dz23-16 { display: flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 12px; }
  .dz23-17 { font-weight: 800; color: var(--text-main); font-size: 14px; margin-bottom: 8px; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .vip-level-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 16px; margin-bottom: 14px; }
    .vip-level-card.inactive { opacity: 0.55; }
    .vip-form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; margin-top: 10px; }
    .vip-form-grid label { font-size: 11px; color: #94a3b8; display: block; margin-bottom: 4px; }
    .vip-toggle-row { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
    .flash-box { padding: 10px 14px; border-radius: 10px; font-size: 12px; margin-bottom: 10px; }
    .flash-success { background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.25); }
    .flash-error { background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.25); }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'vip' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'VIP সিস্টেম ম্যানেজমেন্ট', pageSubtitle: 'VIP লেভেল, বোনাস, ক্যাশব্যাক ও বেনিফিটস পরিচালনা করুন' }) %>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% success.forEach(function(m) { %><div class="flash-box flash-success"><%= m %></div><% }) %>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% error.forEach(function(m) { %><div class="flash-box flash-error"><%= m %></div><% }) %>
      <% } %>

      <!-- ==================== Analytics Dashboard ==================== -->
      <div class="grid grid-4 dz23-1">
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_vip_levels') %></div><div class="stat-number dz23-2"><%= levels.length %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_users_all_levels') %></div><div class="stat-number dz23-3"><%= analytics.perLevel.reduce((a,l)=>a+l.userCount,0) %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_upgrades') %></div><div class="stat-number dz23-4"><%= analytics.upgradeStats.reduce((a,u)=>a+u.upgradeCount,0) %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_total_vip_bonus') %></div><div class="stat-number dz23-5"><%= Math.round(analytics.grandTotalBonus).toLocaleString('bn-BD') %></div></div>
      </div>

      <div class="admin-card dz23-6">
        <div class="admin-card-header"><%= t('admin_stats_per_level') %> <a class="dz23-7" href="/admin/vip/history"><i class="fas fa-history"></i> <%= t('admin_btn_view_full_history') %></a></div>
        <div class="dz23-8">
          <table class="admin-table">
            <thead>
              <tr>
                <th><%= t('admin_col_level') %></th><th><%= t('admin_col_user_count') %></th><th><%= t('admin_col_total_turnover') %></th>
                <th><%= t('admin_col_upgrade_bonus_paid') %></th><th><%= t('admin_col_daily_bonus_paid') %></th><th><%= t('admin_col_weekly') %></th><th><%= t('admin_col_monthly') %></th><th><%= t('admin_col_cashback') %></th>
              </tr>
            </thead>
            <tbody>
              <% analytics.perLevel.forEach(l => { %>
                <tr>
                  <td class="dz23-9"><%= l.icon %> <%= l.name %> (<%= l.level %>)</td>
                  <td><%= l.userCount %></td>
                  <td><%= Math.round(l.totalTurnover).toLocaleString('bn-BD') %></td>
                  <td><%= Math.round(l.totalUpgradeBonus).toLocaleString('bn-BD') %></td>
                  <td><%= Math.round(l.totalDailyBonus).toLocaleString('bn-BD') %></td>
                  <td><%= Math.round(l.totalWeeklyBonus).toLocaleString('bn-BD') %></td>
                  <td><%= Math.round(l.totalMonthlyBonus).toLocaleString('bn-BD') %></td>
                  <td><%= Math.round(l.totalCashback).toLocaleString('bn-BD') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ==================== Level Management (CRUD) ==================== -->
      <div class="admin-card-header dz23-10"><%= t('admin_vip_level_management') %></div>

      <% levels.forEach(l => { %>
        <div class="vip-level-card <%= l.is_active === false ? 'inactive' : '' %>">
          <form method="POST" action="/admin/vip/save">
            <input type="hidden" name="level" value="<%= l.level %>">
            <div class="dz23-11">
              <div class="dz23-12"><%= l.icon || '👑' %> লেভেল <%= l.level %> <% if (l.is_active === false) { %><span class="badge badge-red"><%= t('admin_status_inactive') %></span><% } else { %><span class="badge badge-green"><%= t('admin_status_active') %></span><% } %></div>
              <button type="submit" class="btn btn-primary dz23-13"><i class="fas fa-save"></i> <%= t('admin_btn_save') %></button>
            </div>
            <div class="vip-form-grid">
              <div><label><%= t('admin_col_name') %></label><input class="input" type="text" name="name" value="<%= l.name %>" required></div>
              <div><label><%= t('admin_field_icon_emoji') %></label><input class="input" type="text" name="icon" value="<%= l.icon || '👑' %>"></div>
              <div><label><%= t('admin_field_min_turnover') %></label><input class="input" type="number" step="0.01" name="min_turnover" value="<%= l.min_turnover %>"></div>
              <div><label><%= t('admin_field_upgrade_bonus') %></label><input class="input" type="number" step="0.01" name="upgrade_bonus" value="<%= l.upgrade_bonus %>"></div>
              <div><label><%= t('admin_field_daily_bonus') %></label><input class="input" type="number" step="0.01" name="daily_bonus" value="<%= l.daily_bonus || 0 %>"></div>
              <div><label><%= t('admin_field_weekly_bonus') %></label><input class="input" type="number" step="0.01" name="weekly_bonus" value="<%= l.weekly_bonus || 0 %>"></div>
              <div><label><%= t('admin_field_monthly_bonus') %></label><input class="input" type="number" step="0.01" name="monthly_bonus" value="<%= l.monthly_bonus || 0 %>"></div>
              <div><label><%= t('admin_field_cashback_extra') %></label><input class="input" type="number" step="0.01" name="cashback_percent" value="<%= l.cashback_percent || 0 %>"></div>
              <div><label><%= t('admin_field_withdraw_limit') %></label><input class="input" type="number" step="0.01" name="withdrawal_limit" value="<%= l.withdrawal_limit || 0 %>"></div>
              <div><label><%= t('admin_field_deposit_bonus_pct') %></label><input class="input" type="number" step="0.01" name="deposit_bonus_percent" value="<%= l.deposit_bonus_percent || 0 %>"></div>
              <div><label><%= t('admin_field_birthday_bonus') %></label><input class="input" type="number" step="0.01" name="birthday_bonus" value="<%= l.birthday_bonus || 0 %>"></div>
            </div>
            <div class="dz23-14">
              <label><%= t('admin_field_exclusive_event') %></label>
              <input class="input dz23-15" type="text" name="exclusive_events" value="<%= l.exclusive_events || '' %>">
            </div>
            <div class="vip-toggle-row">
              <label class="dz23-16">
                <input type="checkbox" name="priority_support" <%= l.priority_support ? 'checked' : '' %>> <%= t('admin_field_priority_support') %>
              </label>
              <label class="dz23-16">
                <input type="checkbox" name="is_active" <%= l.is_active !== false ? 'checked' : '' %>> <%= t('admin_field_level_active') %>
              </label>
            </div>
          </form>
        </div>
      <% }) %>

      <div class="vip-level-card">
        <div class="dz23-17"><i class="fas fa-plus"></i> <%= t('admin_vip_add_level_heading') %></div>
        <form method="POST" action="/admin/vip/save">
          <div class="vip-form-grid">
            <div><label><%= t('admin_field_level_number') %></label><input class="input" type="number" name="level" required></div>
            <div><label><%= t('admin_col_name') %></label><input class="input" type="text" name="name" required></div>
            <div><label><%= t('admin_col_icon') %></label><input class="input" type="text" name="icon" value="🏆"></div>
            <div><label><%= t('admin_field_min_turnover') %></label><input class="input" type="number" step="0.01" name="min_turnover" value="0"></div>
            <div><label><%= t('admin_field_upgrade_bonus') %></label><input class="input" type="number" step="0.01" name="upgrade_bonus" value="0"></div>
            <div><label><%= t('admin_field_daily_bonus') %></label><input class="input" type="number" step="0.01" name="daily_bonus" value="0"></div>
            <div><label><%= t('admin_field_weekly_bonus') %></label><input class="input" type="number" step="0.01" name="weekly_bonus" value="0"></div>
            <div><label><%= t('admin_field_monthly_bonus') %></label><input class="input" type="number" step="0.01" name="monthly_bonus" value="0"></div>
            <div><label><%= t('admin_field_cashback_pct') %></label><input class="input" type="number" step="0.01" name="cashback_percent" value="0"></div>
          </div>
          <button type="submit" class="btn btn-primary dz23-14"><i class="fas fa-plus"></i> <%= t('admin_btn_create_level') %></button>
        </form>
      </div>

    </div>
  </div>
</body>
</html>

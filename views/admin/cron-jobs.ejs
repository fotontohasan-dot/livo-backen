<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmtDate(d) { return d ? new Date(d).toLocaleString('en-US', { timeZone: 'Asia/Dhaka' }) : '—'; }
function fmtInterval(ms) {
  const mins = Math.round(ms / 60000);
  if (mins < 60) return mins + ' মিনিট';
  if (mins < 1440) return Math.round(mins / 60) + ' ঘণ্টা';
  return Math.round(mins / 1440) + ' দিন';
}
%>
<%- include('partials/admin-layout', {
    title: 'Cron Jobs',
    active: 'cron-jobs',
    body: `
<div class="max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-slate-800">⏰ Cron Jobs Management</h1>
      <p class="text-sm text-slate-500">Daily Cleanup, Token/Log Cleanup, Backup, Fraud Scan, Queue/Cache/Session Cleanup, Health Check — সব একজায়গায় নিয়ন্ত্রণ</p>
    </div>
  </div>

  ${error ? `<div class="mb-4 bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-2xl text-sm">${escapeHtml(error)}</div>` : ''}

  <div class="grid grid-cols-1 gap-4">
    ${jobs.map(job => `
      <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-800">${escapeHtml(job.label)}</h3>
              ${job.enabled
                ? '<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-100 text-emerald-700">চালু আছে</span>'
                : '<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-slate-200 text-slate-500">বন্ধ আছে</span>'}
              ${job.last_status === 'error' ? '<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-red-100 text-red-600">সর্বশেষ রান ব্যর্থ</span>' : ''}
            </div>
            <p class="text-xs text-slate-500 mt-1 max-w-xl">${escapeHtml(job.description)}</p>
          </div>
          <div class="flex gap-2 flex-wrap">
            <form method="POST" action="/admin/cron-jobs/${job.key}/toggle">
              <input type="hidden" name="enabled" value="${job.enabled ? 'false' : 'true'}">
              <button type="submit" class="px-3 py-2 rounded-xl text-xs font-semibold ${job.enabled ? 'bg-slate-100 text-slate-600' : 'bg-emerald-100 text-emerald-700'}">
                ${job.enabled ? 'বন্ধ করুন' : 'চালু করুন'}
              </button>
            </form>
            <form method="POST" action="/admin/cron-jobs/${job.key}/run" onsubmit="return confirm('${escapeHtml(job.label)} এখনই ম্যানুয়ালি রান করবেন?')">
              <button type="submit" class="px-3 py-2 rounded-xl text-xs font-semibold bg-blue-100 text-blue-700"><i class="fas fa-play"></i> এখনই রান করুন</button>
            </form>
            <a href="/admin/cron-jobs/${job.key}/logs" class="px-3 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-white"><i class="fas fa-list"></i> লগ</a>
          </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4 text-xs">
          <div><span class="text-slate-400">ইন্টারভাল</span><br><b>${fmtInterval(job.interval_ms)}</b></div>
          <div><span class="text-slate-400">Last Run</span><br><b>${fmtDate(job.last_run_at)}</b></div>
          <div><span class="text-slate-400">Next Run</span><br><b>${fmtDate(job.next_run_at)}</b></div>
          <div><span class="text-slate-400">সর্বশেষ ফলাফল</span><br><b class="truncate block" title="${escapeHtml(job.last_message)}">${escapeHtml((job.last_message || '—').slice(0, 40))}</b></div>
        </div>
      </div>
    `).join('') || '<p class="text-slate-400 text-center py-10">কোনো Cron Job পাওয়া যায়নি — সার্ভার একবার রিস্টার্ট/রিডেপ্লয় করুন।</p>'}
  </div>
</div>
`
}) %>

<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Bets</h1>
        <p class="text-gray-400 text-sm mt-1">Total: <%= total %> bets</p>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-[#1e2937] rounded-3xl p-5 border border-[#334155] mb-6">
      <form method="GET" class="flex flex-wrap gap-3">
        <select name="status" class="bg-[#0f172a] border border-[#475569] text-white rounded-2xl px-4 py-3 text-sm">
          <option value="">All Status</option>
          <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="won" <%= status === 'won' ? 'selected' : '' %>>Won</option>
          <option value="lost" <%= status === 'lost' ? 'selected' : '' %>>Lost</option>
        </select>
        <button type="submit" class="px-6 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl">Filter</button>
      </form>
    </div>

    <!-- Bets Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">User</th>
            <th class="text-left px-4 py-4 font-normal">Match</th>
            <th class="text-right px-4 py-4 font-normal">Stake</th>
            <th class="text-right px-4 py-4 font-normal">Odd</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% bets.forEach(b => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4 font-medium text-white"><%= b.username %></td>
            <td class="px-4 py-4 text-xs"><%= b.team_a %> vs <%= b.team_b %></td>
            <td class="px-4 py-4 text-right font-bold">৳<%= b.stake %></td>
            <td class="px-4 py-4 text-right"><%= b.odd %></td>
            <td class="px-4 py-4 text-center">
              <% if(b.status === 'won') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Won</span>
              <% } else if(b.status === 'lost') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">Lost</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/20 text-yellow-400">Pending</span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-center">
              <% if(b.status === 'pending') { %>
                <form action="/admin/bets/<%= b.id %>/settle" method="POST" class="flex justify-center gap-2">
                  <button name="result" value="won" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 rounded-xl text-xs">Win</button>
                  <button name="result" value="lost" class="px-3 py-1 bg-red-600 hover:bg-red-700 rounded-xl text-xs">Lose</button>
                </form>
              <% } else { %>
                <span class="text-gray-500 text-xs">Settled</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="flex justify-center mt-6 gap-2">
      <% for(let i=1; i<=totalPages; i++) { %>
        <a href="/admin/bets?page=<%= i %>&status=<%= status %>" 
           class="px-4 py-2 rounded-2xl text-sm <%= page === i ? 'bg-[#f59e0b] text-black' : 'bg-[#1e2937] hover:bg-[#334155]' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
    <% } %>

  </main>
</div>

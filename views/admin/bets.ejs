<%- include('partials/admin-layout', { 
    title: 'Bets Management', 
    currentPage: 'bets',
    body: `
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-6">
        <div>
            <h2 class="section-header">Bets Management</h2>
            <p class="text-slate-500">Settle and monitor all user bets • 12,489 total</p>
        </div>
        <button onclick="window.location.reload()" class="px-4 py-2 text-sm flex items-center gap-x-2 border border-slate-200 rounded-2xl hover:bg-white">
            <i class="fa-solid fa-sync"></i> <span>Refresh</span>
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white p-5 rounded-3xl border"><div class="text-xs text-slate-500">Total Bets</div><div class="text-3xl font-bold">12,489</div></div>
        <div class="bg-white p-5 rounded-3xl border"><div class="text-xs text-slate-500">Pending Settlement</div><div class="text-3xl font-bold text-amber-600">184</div></div>
        <div class="bg-white p-5 rounded-3xl border"><div class="text-xs text-slate-500">Total Stake (Today)</div><div class="text-3xl font-bold">৳4.2M</div></div>
        <div class="bg-white p-5 rounded-3xl border"><div class="text-xs text-slate-500">GGR (Today)</div><div class="text-3xl font-bold text-emerald-600">৳312k</div></div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border overflow-hidden modern-table">
        <table class="w-full">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs">BET ID / USER</th>
                    <th class="px-6 py-4 text-left text-xs">MATCH / SELECTION</th>
                    <th class="px-6 py-4 text-right text-xs">STAKE</th>
                    <th class="px-6 py-4 text-center text-xs">ODDS</th>
                    <th class="px-6 py-4 text-center text-xs">STATUS</th>
                    <th class="px-6 py-4 text-center text-xs w-48">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b hover:bg-slate-50">
                    <td class="px-6 py-4 font-mono text-sm">#B-28491<br><span class="text-xs text-slate-500">Rahim Khan</span></td>
                    <td class="px-6 py-4">Bangladesh vs India<br><span class="text-emerald-600 text-xs">Bangladesh to win</span></td>
                    <td class="px-6 py-4 text-right font-semibold">৳5,000</td>
                    <td class="px-6 py-4 text-center">2.45</td>
                    <td class="px-6 py-4 text-center"><span class="badge bg-amber-100 text-amber-700">Pending</span></td>
                    <td class="px-6 py-4 text-center">
                        <button onclick="settleBet(this, 'win')" class="px-4 py-1 text-xs bg-emerald-600 text-white rounded-xl mr-1">WIN</button>
                        <button onclick="settleBet(this, 'lose')" class="px-4 py-1 text-xs bg-red-600 text-white rounded-xl">LOSE</button>
                    </td>
                </tr>
                <!-- More rows can be added similarly -->
            </tbody>
        </table>
    </div>
</div>

<script>
function settleBet(btn, result) {
    const row = btn.closest('tr');
    row.style.transition = 'all .3s';
    row.style.opacity = '0.4';
    
    setTimeout(() => {
        row.querySelector('.badge').outerHTML = result === 'win' 
            ? '<span class="badge bg-emerald-100 text-emerald-700">Won</span>' 
            : '<span class="badge bg-red-100 text-red-700">Lost</span>';
        
        btn.parentElement.innerHTML = '<span class="text-xs text-slate-400">Settled</span>';
        row.style.opacity = '1';
    }, 600);
}
</script>
` 
}) %>
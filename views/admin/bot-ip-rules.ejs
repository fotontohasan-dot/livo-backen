<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
%>
<%- include('partials/admin-layout', {
    title: 'IP Block/Whitelist',
    active: 'bot-monitoring',
    body: `
<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-xl font-bold text-slate-800">🛡️ IP Block / Whitelist</h1>
    <a href="/admin/bot-monitoring" class="text-sm text-slate-500"><i class="fas fa-arrow-left"></i> ${t('abi_back_dash')}</a>
  </div>

  <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm mb-6">
    <p class="text-sm font-bold text-slate-700 mb-3">${t('abi_add_rule')}</p>
    <form method="POST" action="/admin/bot-monitoring/ip-rules" class="grid grid-cols-1 md:grid-cols-4 gap-2">
      <input type="text" name="ip" placeholder="${t('abi_ip_placeholder')}" required class="border px-3 py-2.5 rounded-xl text-sm md:col-span-2">
      <select name="type" class="border px-3 py-2.5 rounded-xl text-sm">
        <option value="block">🚫 Block</option>
        <option value="whitelist">✅ Whitelist</option>
      </select>
      <button type="submit" class="px-4 py-2.5 bg-slate-800 text-white rounded-xl text-sm font-semibold">${t('abi_add')}</button>
      <input type="text" name="reason" placeholder="${t('abi_reason_placeholder')}" class="border px-3 py-2.5 rounded-xl text-sm md:col-span-4">
    </form>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase">
        <th class="p-3">IP</th><th class="p-3">${t('abi_col_type')}</th><th class="p-3">${t('abi_col_reason')}</th><th class="p-3">${t('abi_col_added_by')}</th><th class="p-3">${t('abi_col_date')}</th><th class="p-3">${t('abi_col_action')}</th>
      </tr></thead>
      <tbody>
        ${rules.map(r => `
          <tr class="border-t border-slate-50">
            <td class="p-3 font-mono">${escapeHtml(r.ip)}</td>
            <td class="p-3">${r.type === 'block' ? '<span class="text-red-500 font-bold">🚫 Block</span>' : '<span class="text-emerald-600 font-bold">✅ Whitelist</span>'}</td>
            <td class="p-3 text-slate-500">${escapeHtml(r.reason || '-')}</td>
            <td class="p-3 text-slate-500">${escapeHtml(r.created_by || '-')}</td>
            <td class="p-3 text-slate-500 whitespace-nowrap">${new Date(r.created_at).toLocaleString('en-US', { timeZone: 'Asia/Dhaka' })}</td>
            <td class="p-3">
              <form method="POST" action="/admin/bot-monitoring/ip-rules/${encodeURIComponent(r.ip)}/remove" data-confirm="${t('abi_remove_confirm').replace('{ip}', escapeHtml(r.ip))}">
                <button type="submit" class="text-slate-400 hover:text-red-500 text-xs font-bold"><i class="fas fa-trash"></i> ${t('abi_remove')}</button>
              </form>
            </td>
          </tr>
        `).join('') || '<tr><td colspan="6" class="p-6 text-center text-slate-400">' + t("abi_no_rules") + '</td></tr>'}
      </tbody>
    </table>
  </div>
</div>
`
}) %>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>রিপোর্টিং • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .date-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: end; }
    .date-filters .form-field label { font-size: 11px; color: #94a3b8; margin-bottom: 5px; display: block; }
  </style>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'reports' }) %>
    <div class="admin-content">
      <%- include('./partials/header', { pageTitle: 'রিপোর্টিং', pageSubtitle: 'আর্থিক ও বেটিং পারফরম্যান্স ওভারভিউ' }) %>

      <form class="date-filters" method="GET" action="/admin/reports">
        <div class="form-field">
          <label>শুরুর তারিখ</label>
          <input class="input" type="date" name="from" value="<%= from %>">
        </div>
        <div class="form-field">
          <label>শেষ তারিখ</label>
          <input class="input" type="date" name="to" value="<%= to %>">
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-sync-alt"></i> আপডেট করুন</button>
      </form>

      <div class="grid grid-4" style="margin-bottom:14px;">
        <div class="stat-card">
          <div class="stat-label">মোট ডিপোজিট</div>
          <div class="stat-number" style="color:#10b981;">৳<%= Number(deposits.total).toLocaleString('bn-BD') %></div>
          <div class="stat-sub"><%= deposits.cnt %>টি লেনদেন</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">মোট উইথড্র</div>
          <div class="stat-number" style="color:#ef4444;">৳<%= Number(withdrawals.total).toLocaleString('bn-BD') %></div>
          <div class="stat-sub"><%= withdrawals.cnt %>টি লেনদেন</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">মোট বেট (স্টেক)</div>
          <div class="stat-number">৳<%= Number(bets.total_stake).toLocaleString('bn-BD') %></div>
          <div class="stat-sub"><%= bets.cnt %>টি বেট</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">নতুন ইউজার</div>
          <div class="stat-number" style="color:#f59e0b;"><%= newUsers %></div>
        </div>
      </div>

      <div class="admin-card" style="padding:18px;">
        <div style="font-weight:800;color:#fff;font-size:14px;margin-bottom:14px;"><i class="fas fa-chart-line" style="color:#f59e0b;"></i> নিট রেভিনিউ সারসংক্ষেপ</div>
        <div class="kv-row" style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:13px;">
          <span style="color:#94a3b8;">মোট বেট স্টেক</span><span style="color:#e2e8f0;font-weight:600;">৳<%= Number(bets.total_stake).toLocaleString('bn-BD') %></span>
        </div>
        <div class="kv-row" style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:13px;">
          <span style="color:#94a3b8;">মোট পে-আউট (জেতা বেট)</span><span style="color:#e2e8f0;font-weight:600;">৳<%= Number(bets.total_payout).toLocaleString('bn-BD') %></span>
        </div>
        <div class="kv-row" style="display:flex;justify-content:space-between;padding:10px 0;font-size:14px;">
          <span style="color:#fff;font-weight:700;">নিট রেভিনিউ</span>
          <span style="font-weight:800;color:<%= netRevenue >= 0 ? '#10b981' : '#ef4444' %>;">৳<%= Number(netRevenue).toLocaleString('bn-BD') %></span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

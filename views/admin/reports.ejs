                <span class="font-medium text-white">Bets Report</span>
              </div>
            </td>
            <td class="py-4 px-6 text-gray-300">admin@ livo.com</td>
            <td class="py-4 px-6 text-gray-300">09 Jul 2026, 11:42</td>
            <td class="py-4 px-6 text-white font-medium">12,458</td>
            <td class="py-4 px-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400">Completed</span>
            </td>
            <td class="py-4 px-6 text-right">
              <button onclick="downloadReport(this)" class="text-[#f59e0b] hover:text-white text-xs font-medium px-4 py-1.5 rounded-xl border border-[#f59e0b]/30 hover:bg-[#f59e0b]/10 transition-all">Download</button>
            </td>
          </tr>
          <tr class="hover:bg-[#0f172a] transition-colors">
            <td class="py-4 px-6">
              <div class="flex items-center gap-3">
                <i class="fas fa-users text-blue-400"></i>
                <span class="font-medium text-white">Users Report</span>
              </div>
            </td>
            <td class="py-4 px-6 text-gray-300">admin@ livo.com</td>
            <td class="py-4 px-6 text-gray-300">09 Jul 2026, 09:15</td>
            <td class="py-4 px-6 text-white font-medium">8,721</td>
            <td class="py-4 px-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400">Completed</span>
            </td>
            <td class="py-4 px-6 text-right">
              <button onclick="downloadReport(this)" class="text-[#f59e0b] hover:text-white text-xs font-medium px-4 py-1.5 rounded-xl border border-[#f59e0b]/30 hover:bg-[#f59e0b]/10 transition-all">Download</button>
            </td>
          </tr>
          <tr class="hover:bg-[#0f172a] transition-colors">
            <td class="py-4 px-6">
              <div class="flex items-center gap-3">
                <i class="fas fa-wallet text-amber-400"></i>
                <span class="font-medium text-white">Payments Report</span>
              </div>
            </td>
            <td class="py-4 px-6 text-gray-300">finance@ livo.com</td>
            <td class="py-4 px-6 text-gray-300">08 Jul 2026, 16:30</td>
            <td class="py-4 px-6 text-white font-medium">3,245</td>
            <td class="py-4 px-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400">Completed</span>
            </td>
            <td class="py-4 px-6 text-right">
              <button onclick="downloadReport(this)" class="text-[#f59e0b] hover:text-white text-xs font-medium px-4 py-1.5 rounded-xl border border-[#f59e0b]/30 hover:bg-[#f59e0b]/10 transition-all">Download</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </main>
</div>

<!-- Toast Notification -->
<div id="toast" class="hidden fixed bottom-6 right-6 bg-[#1e2937] border border-[#334155] text-white px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 z-50">
  <i class="fas fa-check-circle text-emerald-400"></i>
  <span id="toast-message"></span>
</div>

<script>
function showToast(message) {
  const toast = document.getElementById('toast');
  const msg = document.getElementById('toast-message');
  msg.textContent = message;
  toast.classList.remove('hidden');
  toast.classList.add('flex');
  
  setTimeout(() => {
    toast.classList.remove('flex');
    toast.classList.add('hidden');
  }, 3000);
}

function refreshStats() {
  const btns = document.querySelectorAll('button');
  btns.forEach(b => b.disabled = true);
  
  setTimeout(() => {
    document.getElementById('stat-total').textContent = '1,291';
    document.getElementById('stat-today').textContent = '54';
    btns.forEach(b => b.disabled = false);
    showToast('Stats refreshed successfully');
  }, 800);
}

function downloadReport(btn) {
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Downloading...';
  btn.disabled = true;
  
  setTimeout(() => {
    btn.innerHTML = originalText;
    btn.disabled = false;
    showToast('Report downloaded successfully');
  }, 1500);
}

function exportToCSV() {
  const btns = document.querySelectorAll('button');
  const originalTexts = [];
  
  btns.forEach((btn, i) => {
    originalTexts[i] = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Exporting...';
    btn.disabled = true;
  });
  
  setTimeout(() => {
    btns.forEach((btn, i) => {
      btn.innerHTML = originalTexts[i];
      btn.disabled = false;
    });
    showToast('Export log downloaded as CSV');
  }, 1200);
}

// Keyboard support
document.addEventListener('keydown', function(e) {
  if (e.key === "/" && document.activeElement.tagName === "BODY") {
    e.preventDefault();
    const searchInput = document.getElementById('search-input');
    if (searchInput) searchInput.focus();
  }
});
</script>

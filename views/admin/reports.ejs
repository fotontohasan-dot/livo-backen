          </div>
        </div>
        <p class="text-gray-400 text-xs mt-3">Downloaded 312 times this month</p>
      </div>
      
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">This Month</p>

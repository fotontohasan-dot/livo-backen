          <i class="fas fa-download"></i>
          <span>Export CSV</span>
        </a>
      </div>

      <!-- Payments Report -->
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-6 hover:border-[#f59e0b]/50 transition-all group">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-amber-500/10 rounded-2xl flex items-center justify-center group-hover:bg-amber-500/20 transition-all">

<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Reports</h1>
      <p class="text-gray-400 text-sm mt-1">Export data for analysis</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Users Report -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex items-center gap-3 mb-4">
          <i class="fas fa-users text-2xl text-[#f59e0b]"></i>
          <h3 class="font-semibold text-white">Users Report</h3>
        </div>
        <p class="text-sm text-gray-400 mb-6">Download all users data with filters</p>
        <a href="/admin/reports/export/users" class="block w-full text-center py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium">Download CSV</a>
      </div>

      <!-- Bets Report -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex items-center gap-3 mb-4">
          <i class="fas fa-ticket-alt text-2xl text-[#f59e0b]"></i>
          <h3 class="font-semibold text-white">Bets Report</h3>
        </div>
        <p class="text-sm text-gray-400 mb-6">All bets with user and status</p>
        <a href="/admin/reports/export/bets" class="block w-full text-center py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium">Download CSV</a>
      </div>

      <!-- Payments Report -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex items-center gap-3 mb-4">
          <i class="fas fa-wallet text-2xl text-[#f59e0b]"></i>
          <h3 class="font-semibold text-white">Payments Report</h3>
        </div>
        <p class="text-sm text-gray-400 mb-6">Deposits & Withdrawals data</p>
        <a href="/admin/reports/export/payments" class="block w-full text-center py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium">Download CSV</a>
      </div>

      <!-- Profit Report -->
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
        <div class="flex items-center gap-3 mb-4">
          <i class="fas fa-chart-line text-2xl text-[#f59e0b]"></i>
          <h3 class="font-semibold text-white">Profit Report</h3>
        </div>
        <p class="text-sm text-gray-400 mb-6">Daily profit & loss summary</p>
        <a href="/admin/reports/export/profit" class="block w-full text-center py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium">Download CSV</a>
      </div>

    </div>

  </main>
</div>

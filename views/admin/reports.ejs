            <p class="text-xs text-gray-400">Daily P&amp;L Summary</p>
          </div>
        </div>
        <p class="text-sm text-gray-400 mb-6 leading-relaxed">Daily profit and loss breakdown with commission, winning payouts and net revenue.</p>
        
        <a href="/admin/reports/export/profit" 
           class="block w-full text-center py-3.5 bg-[#334155] hover:bg-[#f59e0b] hover:text-black text-white font-semibold rounded-2xl text-sm transition-all flex items-center justify-center gap-2">

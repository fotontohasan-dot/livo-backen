        <div class="flex items-center gap-4 mb-4">
          <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center group-hover:bg-blue-500/20 transition-all">
            <i class="fas fa-users text-blue-400 text-3xl"></i>
          </div>
          <div>

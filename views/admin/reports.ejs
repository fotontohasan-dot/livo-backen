            <th class="text-left py-4 px-6 text-gray-400 font-medium">Exported By</th>
            <th class="text-left py-4 px-6 text-gray-400 font-medium">Date &amp; Time</th>
            <th class="text-left py-4 px-6 text-gray-400 font-medium">Records</th>
            <th class="text-left py-4 px-6 text-gray-400 font-medium">Status</th>
            <th class="text-right py-4 px-6 text-gray-400 font-medium">Action</th>

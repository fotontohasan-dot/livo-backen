<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const st = status || {};
const cats = st.categories || {};

const statusBadge = st.active
  ? '<span class="px-4 py-2 rounded-2xl text-sm font-semibold bg-emerald-50 text-emerald-700"><i class="fas fa-circle-check"></i> ' + t("tg_active") + '</span>'
  : (st.enabled
      ? '<span class="px-4 py-2 rounded-2xl text-sm font-semibold bg-amber-50 text-amber-700"><i class="fas fa-triangle-exclamation"></i> ' + t("tg_not_configured") + '</span>'
      : '<span class="px-4 py-2 rounded-2xl text-sm font-semibold bg-slate-100 text-slate-500"><i class="fas fa-circle-pause"></i> ' + t("tg_off") + '</span>');

function sourceTag(src) {
  if (src === 'database') return '<span class="text-xs px-2 py-0.5 rounded-lg bg-blue-50 text-blue-600">' + t("tg_src_admin") + '</span>';
  if (src === 'env') return '<span class="text-xs px-2 py-0.5 rounded-lg bg-slate-100 text-slate-500">' + t("tg_src_env") + '</span>';
  return '<span class="text-xs px-2 py-0.5 rounded-lg bg-red-50 text-red-500">' + t("tg_not_set") + '</span>';
}

const categoryRows = (categories || []).map(key =>
  '<label class="flex items-center gap-3 py-2.5 border-b border-slate-50 last:border-0">' +
    '<input type="checkbox" name="categories[' + key + ']" value="true" ' + (cats[key] !== false ? 'checked' : '') + ' class="w-5 h-5 rounded">' +
    '<span class="text-sm font-medium text-slate-700 flex-1">' + escapeHtml((categoryLabels || {})[key] || key) + '</span>' +
    '<button type="button" data-send-test="' + escapeHtml(key) + '" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">' + t("tg_send_test") + '</button>' +
  '</label>'
).join('');

const lastTest = st.lastTestAt
  ? '<p class="text-xs mt-2 ' + (st.lastTestStatus === 'success' ? 'text-emerald-600' : 'text-red-500') + '">' +
      '<i class="fas ' + (st.lastTestStatus === 'success' ? 'fa-check' : 'fa-xmark') + '"></i> ' + t("tg_last_test") + '' +
      escapeHtml(new Date(st.lastTestAt).toLocaleString('en-GB')) +
      (st.lastTestBot ? ' — ' + escapeHtml(st.lastTestBot) : '') +
      (st.lastTestStatus !== 'success' && st.lastTestError ? '<br>' + escapeHtml(st.lastTestError) : '') +
    '</p>'
  : '<p class="text-xs text-slate-400 mt-2">' + t("tg_no_test_yet") + '</p>';
%>
<%- include('partials/admin-layout', {
    title: 'Telegram Integration',
    active: 'telegram',
    body: `
<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900"><i class="fab fa-telegram text-sky-500"></i> Telegram Integration</h1>
            <p class="text-slate-500 mt-1 text-sm">${t('tg_subtitle')}</p>
        </div>
        ${statusBadge}
    </div>

    ${saved ? '<div class="mb-5 px-5 py-3 rounded-2xl bg-emerald-50 text-emerald-700 text-sm font-semibold"><i class="fas fa-check-circle"></i> ' + t("tg_saved") + '</div>' : ''}
    ${saveError ? '<div class="mb-5 px-5 py-3 rounded-2xl bg-red-50 text-red-600 text-sm font-semibold"><i class="fas fa-circle-exclamation"></i> ' + escapeHtml(saveError) + '</div>' : ''}

    <!-- ==================== স্ট্যাটাস ==================== -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Bot Token</p>
            <p class="mt-2 text-base font-bold ${st.tokenSet ? 'text-slate-900' : 'text-red-500'} font-mono">${st.tokenSet ? escapeHtml(st.tokenMasked) : t('tg_not_set')}</p>
            <p class="mt-2">${sourceTag(st.tokenSource)}</p>
        </div>
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Chat ID</p>
            <p class="mt-2 text-base font-bold ${st.chatId ? 'text-slate-900' : 'text-red-500'} font-mono">${st.chatId ? escapeHtml(st.chatId) : t('tg_not_set')}</p>
            <p class="mt-2">${sourceTag(st.chatIdSource)}</p>
        </div>
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">${t('tg_webhook_secret')}</p>
            <p class="mt-2 text-base font-bold ${st.webhookSecretSet ? 'text-emerald-600' : 'text-amber-600'}">${st.webhookSecretSet ? t('tg_is_set') : t('tg_is_not_set')}</p>
            <p class="text-xs text-slate-400 mt-2">${t('tg_env_only')}</p>
        </div>
    </div>

    <!-- ==================== কানেকশন টেস্ট ==================== -->
    <div class="bg-white rounded-3xl border border-slate-100 p-6 mb-6">
        <h2 class="font-semibold text-slate-900 mb-1"><i class="fas fa-plug text-blue-600"></i> ${t('tg_conn_test')}</h2>
        <p class="text-sm text-slate-500 mb-4">${t('tg_conn_desc')}</p>
        <div class="flex flex-wrap gap-3">
            <button type="button" data-run-test="false" class="px-4 py-2.5 text-sm font-semibold rounded-2xl bg-slate-900 text-white hover:bg-slate-800"><i class="fas fa-vial"></i> ${t('tg_verify_token')}</button>
            <button type="button" data-run-test="true" class="px-4 py-2.5 text-sm font-semibold rounded-2xl bg-blue-600 text-white hover:bg-blue-700"><i class="fas fa-paper-plane"></i> ${t('tg_send_test_msg')}</button>
        </div>
        <div id="testResult" class="mt-4 text-sm"></div>
        ${lastTest}
    </div>

    <!-- ==================== সেটিংস ==================== -->
    <form method="POST" action="/admin/telegram/settings" class="bg-white rounded-3xl border border-slate-100 p-6 mb-6">
        <h2 class="font-semibold text-slate-900 mb-4"><i class="fas fa-sliders text-blue-600"></i> ${t('tg_notif_settings')}</h2>

        <label class="flex items-center gap-3 py-2 mb-4">
            <input type="hidden" name="enabled" value="false">
            <input type="checkbox" name="enabled" value="true" ${st.enabled ? 'checked' : ''} class="w-5 h-5 rounded">
            <span class="text-sm font-medium text-slate-700">${t('tg_enable')}
                <span class="block text-xs text-slate-400 font-normal">${t('tg_enable_hint')}</span>
            </span>
        </label>

        <div class="mb-5">
            <label class="block text-sm font-medium mb-1.5 text-slate-700">Admin Chat ID</label>
            <input type="text" name="chat_id" value="${st.chatIdSource === 'database' ? escapeHtml(st.chatId || '') : ''}"
                placeholder="${st.chatIdSource === 'env' ? escapeHtml(st.chatId || '') + t('tg_from_env') : t('tg_chatid_placeholder')}"
                class="w-full border border-slate-200 px-4 py-3 rounded-2xl text-sm outline-none focus:border-blue-300 font-mono">
            <p class="text-xs text-slate-400 mt-1.5">${t('tg_chatid_hint')}</p>
        </div>

        <p class="text-sm font-medium text-slate-700 mb-1">${t('tg_which_events')}</p>
        <div class="mb-5">${categoryRows}</div>

        <button type="submit" class="px-5 py-2.5 text-sm font-semibold rounded-2xl bg-blue-600 text-white hover:bg-blue-700"><i class="fas fa-floppy-disk"></i> ${t('tg_save_settings')}</button>
    </form>

    <!-- ==================== Bot Token ==================== -->
    <form method="POST" action="/admin/telegram/token" class="bg-white rounded-3xl border border-slate-100 p-6 mb-6" data-confirm="${t('tg_token_confirm')}">
        <h2 class="font-semibold text-slate-900 mb-1"><i class="fas fa-key text-amber-500"></i> Bot Token</h2>
        <p class="text-sm text-slate-500 mb-4">${t('tg_token_desc')}</p>

        ${!st.encryptionAvailable ? '<div class="mb-4 px-4 py-3 rounded-2xl bg-red-50 text-red-600 text-sm"><i class="fas fa-lock"></i> ' + t("tg_no_enc_key") + '</div>' : ''}

        <input type="hidden" name="action" value="set">
        <input type="password" name="bot_token" autocomplete="new-password" placeholder="123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
            class="w-full border border-slate-200 px-4 py-3 rounded-2xl text-sm outline-none focus:border-blue-300 font-mono mb-4">

        <div class="flex flex-wrap gap-3">
            <button type="submit" ${st.encryptionAvailable ? '' : 'disabled'} class="px-5 py-2.5 text-sm font-semibold rounded-2xl bg-slate-900 text-white hover:bg-slate-800"><i class="fas fa-rotate"></i> ${t('tg_save_rotate')}</button>
            ${st.tokenSource === 'database' ? '<button type="submit" name="action" value="clear" formnovalidate class="px-5 py-2.5 text-sm font-semibold rounded-2xl bg-red-50 text-red-600 hover:bg-red-100"><i class="fas fa-trash"></i> ' + t("tg_clear_db") + '</button>' : ''}
        </div>
    </form>

    <div class="bg-slate-50 border border-slate-100 rounded-3xl p-5 text-sm text-slate-500">
        <p class="font-semibold text-slate-700 mb-2">${t('tg_note')}</p>
        <ul class="list-disc pl-5 space-y-1">
            <li>${t('tg_note_1')}</li>
            <li>${t('tg_note_2')}</li>
            <li>${t('tg_note_3')}</li>
        </ul>
    </div>
</div>

<script src="/js/views/admin-telegram.js"></script>
` }) %>

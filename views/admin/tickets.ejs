<%
// PHASE 4 — ইভেন্ট, ইনভেন্টরি ও অর্ডার ব্যবস্থাপনা।
function esc(s) { return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function dt(v) { return v ? new Date(v).toLocaleString('en-GB') : '—'; }
const csrf = esc(locals.csrfToken || '');
const statusPill = (s) => {
  const map = { paid: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                reserved: 'bg-amber-50 text-amber-700 border-amber-200',
                cancelled: 'bg-slate-50 text-slate-500 border-slate-200',
                refunded: 'bg-red-50 text-red-700 border-red-200',
                on_sale: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
  return '<span class="px-2 py-0.5 rounded-full text-xs border ' + (map[s] || 'bg-slate-50 text-slate-600 border-slate-200') + '">' + esc(s || '') + '</span>';
};
%>
<%- include('partials/admin-layout', {
  title: 'Event Tickets',
  active: 'tickets',
  body: `
<div class="max-w-7xl mx-auto">

  ${(success||[]).map(m=>'<div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-2xl text-sm">'+esc(m)+'</div>').join('')}
  ${(error||[]).map(m=>'<div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-2xl text-sm">'+esc(m)+'</div>').join('')}
  ${typeof loadError !== 'undefined' && loadError ? '<div class="mb-4 px-4 py-3 bg-amber-50 border border-amber-200 text-amber-700 rounded-2xl text-sm">' + esc(t('adm_load_failed')) + '</div>' : ''}

  <h1 class="text-xl font-semibold text-slate-800 mb-1">Event Tickets</h1>
  <p class="text-sm text-slate-500 mb-6">
    ${esc(t('adm_tk_intro'))}
  </p>

  <!-- new event -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 mb-8">
    <h2 class="text-sm font-semibold text-slate-700 mb-4">${esc(t('adm_tk_new_event'))}</h2>
    <form method="POST" action="/admin/tickets/events" class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <input type="hidden" name="_csrf" value="${csrf}">
      <input name="title" required placeholder="Title *" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="competition" placeholder="Competition" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="event_date" type="datetime-local" required class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="home_team" placeholder="Home team" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="away_team" placeholder="Away team" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="venue" placeholder="Venue" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="city" placeholder="City" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="country" placeholder="Country" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <input name="banner_url" placeholder="Banner URL" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300">
      <div class="md:col-span-3">
        <button type="submit" class="px-4 py-2.5 rounded-2xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700">Create event</button>
      </div>
    </form>
  </div>

  <!-- event list -->
  <h2 class="text-sm font-semibold text-slate-700 mb-3">Events</h2>
  <div class="space-y-4 mb-10">
    ${events.length ? events.map(e => `
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="font-medium text-slate-800">${esc(e.title)} ${statusPill(e.status)}</div>
          <div class="text-xs text-slate-500 mt-1">
            ${esc(e.competition || '')} · ${esc(e.venue || '')} · ${esc(dt(e.event_date))}
          </div>
          <div class="text-xs text-slate-500 mt-1">
            ${esc(t('adm_tk_inventory'))}: <strong>${e.sold_qty}</strong> / ${e.total_qty} ${esc(t('adm_tk_sold'))}
          </div>
        </div>
        <form method="POST" action="/admin/tickets/events/${e.id}/status" class="flex items-center gap-2">
          <input type="hidden" name="_csrf" value="${csrf}">
          <select name="status" class="border border-slate-200 px-3 py-2 rounded-xl text-xs">
            <option value="on_sale" ${e.status === 'on_sale' ? 'selected' : ''}>on_sale</option>
            <option value="paused" ${e.status === 'paused' ? 'selected' : ''}>paused</option>
            <option value="closed" ${e.status === 'closed' ? 'selected' : ''}>closed</option>
          </select>
          <button type="submit" class="px-3 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-semibold hover:bg-slate-200">Save</button>
        </form>
      </div>

      <form method="POST" action="/admin/tickets/events/${e.id}/categories" class="grid grid-cols-2 md:grid-cols-5 gap-2 mt-4 pt-4 border-t border-slate-100">
        <input type="hidden" name="_csrf" value="${csrf}">
        <input name="name" required placeholder="Category *" class="border border-slate-200 px-3 py-2 rounded-xl text-xs">
        <input name="price" required type="number" step="0.01" min="0" placeholder="Price *" class="border border-slate-200 px-3 py-2 rounded-xl text-xs">
        <input name="total_qty" required type="number" min="1" placeholder="Qty *" class="border border-slate-200 px-3 py-2 rounded-xl text-xs">
        <input name="max_per_user" type="number" min="1" value="4" placeholder="Max/user" class="border border-slate-200 px-3 py-2 rounded-xl text-xs">
        <button type="submit" class="px-3 py-2 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700">Add tier</button>
      </form>
    </div>`).join('') : '<div class="bg-white border border-slate-200 rounded-2xl px-4 py-10 text-center text-slate-400 text-sm">' + esc(t('adm_tk_no_events')) + '</div>'}
  </div>

  <!-- orders -->
  <h2 class="text-sm font-semibold text-slate-700 mb-3">Orders</h2>
  <div class="bg-white border border-slate-200 rounded-2xl overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-xs uppercase">
        <tr>
          <th class="text-left px-4 py-3">Ref</th>
          <th class="text-left px-4 py-3">User</th>
          <th class="text-left px-4 py-3">Event</th>
          <th class="text-right px-4 py-3">Qty</th>
          <th class="text-right px-4 py-3">Total</th>
          <th class="text-left px-4 py-3">Status</th>
          <th class="text-left px-4 py-3">Created</th>
          <th class="text-right px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        ${orders.length ? orders.map(o => `
        <tr class="border-t border-slate-100">
          <td class="px-4 py-3 font-mono text-xs">${esc(o.order_ref)}</td>
          <td class="px-4 py-3">${esc(o.username)}</td>
          <td class="px-4 py-3">${esc(o.title)}</td>
          <td class="px-4 py-3 text-right">${o.qty}</td>
          <td class="px-4 py-3 text-right">৳ ${Number(o.total).toLocaleString('en-US')}</td>
          <td class="px-4 py-3">${statusPill(o.status)}</td>
          <td class="px-4 py-3 text-slate-500 text-xs">${esc(dt(o.created_at))}</td>
          <td class="px-4 py-3 text-right">
            ${o.status === 'paid' ? `
            <form method="POST" action="/admin/tickets/orders/${o.id}/refund">
              <input type="hidden" name="_csrf" value="${csrf}">
              <button type="submit" class="px-3 py-1.5 rounded-xl bg-red-50 text-red-700 border border-red-200 text-xs font-semibold hover:bg-red-100">Refund</button>
            </form>` : ''}
          </td>
        </tr>`).join('') : '<tr><td colspan="8" class="px-4 py-10 text-center text-slate-400">' + esc(t('adm_tk_no_orders')) + '</td></tr>'}
      </tbody>
    </table>
  </div>

</div>
`
}) %>

<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const d = dashStats || {};
const riskByLevel = d.riskByLevel || { high: 0, medium: 0, low: 0 };
const statusCounts = d.statusCounts || { open: 0, reviewed: 0, dismissed: 0 };
const topSignals = d.topSignals || [];
const topUsers = d.topUsers || [];
const trend = d.trend || [];
const avgScore = d.avgOpenRiskScore || 0;

const SIGNAL_LABELS = {
  shared_ip: t('frm_shared_ip'),
  shared_device: t('frm_shared_device'),
  shared_payment_account: t('frm_shared_payment'),
  rapid_registration: t('frm_rapid_reg'),
  rapid_transaction: t('frm_rapid_txn'),
  repeated_failed_login: t('frm_failed_login'),
  repeated_failed_login_severe: t('frm_bruteforce'),
  multiple_ip_change: t('frm_multi_ip'),
  multiple_device_change: t('frm_multi_device'),
  unusual_login: t('frm_unusual_login'),
  vpn_detected: t('frm_vpn'),
  proxy_detected: t('frm_proxy'),
  tor_detected: t('frm_tor'),
  hosting_ip_detected: t('frm_hosting_ip'),
  large_withdraw_new_device: t('frm_large_withdraw')
};

const maxSignalCount = Math.max(1, ...topSignals.map(s => s.count));
const signalRows = topSignals.map(s =>
  '<div class="flex items-center gap-3 py-2">' +
    '<div class="w-40 text-xs text-slate-600 flex-shrink-0 truncate">' + escapeHtml(SIGNAL_LABELS[s.type] || s.type) + '</div>' +
    '<div class="flex-1 bg-slate-100 rounded-full h-2.5 overflow-hidden"><div class="bg-red-400 h-full rounded-full" style="width:' + Math.round((s.count / maxSignalCount) * 100) + '%"></div></div>' +
    '<div class="w-8 text-xs font-semibold text-slate-700 text-right">' + s.count + '</div>' +
  '</div>'
).join('') || '<div class="text-xs text-slate-400 py-3 text-center">' + t("frm_no_signal") + '</div>';

const userRows = topUsers.map(u =>
  '<tr class="hover:bg-slate-50">' +
    '<td class="px-5 py-3"><a href="/admin/users/' + u.user_id + '" class="font-semibold text-blue-600 hover:underline text-sm">' + escapeHtml(u.username || ('#' + u.user_id)) + '</a></td>' +
    '<td class="px-5 py-3 text-sm font-mono font-bold ' + (u.max_score >= 70 ? 'text-red-600' : (u.max_score >= 40 ? 'text-amber-600' : 'text-slate-600')) + '">' + u.max_score + '</td>' +
    '<td class="px-5 py-3 text-sm text-slate-500">' + u.flag_count + '</td>' +
    '<td class="px-5 py-3 text-xs text-slate-400">' + new Date(u.last_flag_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) + '</td>' +
    '<td class="px-5 py-3 text-center"><a href="/admin/fraud-logs?user_id=' + u.user_id + '" class="text-xs text-blue-600 hover:underline">ফ্ল্যাগ দেখুন</a></td>' +
  '</tr>'
).join('') || '<tr><td colspan="5" class="px-5 py-8 text-center text-slate-400 text-sm">' + t("frm_no_open_flags") + '</td></tr>';

const maxTrendCount = Math.max(1, ...trend.map(point => point.count));
const trendBars = trend.map(point => {
  const h = Math.max(4, Math.round((point.count / maxTrendCount) * 80));
  const label = new Date(point.day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  return '<div class="flex flex-col items-center gap-1 flex-1">' +
    '<div class="text-[10px] text-slate-400">' + point.count + '</div>' +
    '<div class="w-full bg-red-400 rounded-t-md" style="height:' + h + 'px" title="' + label + ': ' + point.count + '"></div>' +
    '<div class="text-[9px] text-slate-400 rotate-0">' + label + '</div>' +
  '</div>';
}).join('') || '<div class="text-xs text-slate-400 py-8 text-center w-full">' + t("frm_no_flags_14d") + '</div>';
%>
<%- include('partials/admin-layout', {
    title: 'Fraud Monitoring Dashboard',
    active: 'fraud-monitoring',
    body: `
<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Fraud Monitoring Dashboard</h1>
            <p class="text-slate-500 mt-1 text-sm">${t('frm_subtitle')}</p>
        </div>
        <a href="/admin/fraud-logs" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-2xl text-sm font-semibold hover:bg-slate-200">
            <i class="fas fa-list mr-1"></i> ${t('frm_all_flags')}
        </a>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">High Risk (Open)</div><div class="text-2xl font-bold text-red-600 mt-1">${riskByLevel.high || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Medium Risk (Open)</div><div class="text-2xl font-bold text-amber-600 mt-1">${riskByLevel.medium || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Low Risk (Open)</div><div class="text-2xl font-bold text-slate-600 mt-1">${riskByLevel.low || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Avg Risk Score (Open)</div><div class="text-2xl font-bold text-slate-700 mt-1">${avgScore}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Reviewed / Dismissed</div><div class="text-2xl font-bold text-emerald-600 mt-1">${(statusCounts.reviewed || 0) + (statusCounts.dismissed || 0)}</div></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Trend Chart (last 14 days) -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6">
            <h3 class="font-semibold text-slate-800 mb-4 text-sm"><i class="fas fa-chart-column text-red-500 mr-2"></i>${t('frm_trend')}</h3>
            <div class="flex items-end gap-1.5 h-32">${trendBars}</div>
        </div>

        <!-- Top Signal Types -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6">
            <h3 class="font-semibold text-slate-800 mb-2 text-sm"><i class="fas fa-radar text-red-500 mr-2"></i>${t('frm_top_patterns')}</h3>
            ${signalRows}
        </div>
    </div>

    <!-- Top Flagged Users -->
    <div class="bg-white rounded-3xl border border-slate-100 overflow-x-auto modern-table">
        <div class="px-6 py-4 border-b border-slate-100">
            <h3 class="font-semibold text-slate-800 text-sm"><i class="fas fa-user-shield text-red-500 mr-2"></i>${t('frm_riskiest_users')}</h3>
        </div>
        <table class="w-full text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-5 py-3 text-left font-medium text-slate-500 uppercase text-xs">User</th>
                    <th class="px-5 py-3 text-left font-medium text-slate-500 uppercase text-xs">Max Score</th>
                    <th class="px-5 py-3 text-left font-medium text-slate-500 uppercase text-xs">Flags</th>
                    <th class="px-5 py-3 text-left font-medium text-slate-500 uppercase text-xs">Last Flagged</th>
                    <th class="px-5 py-3 text-center font-medium text-slate-500 uppercase text-xs">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">${userRows}</tbody>
        </table>
    </div>
</div>
`
}) %>

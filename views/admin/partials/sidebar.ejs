<!-- views/admin/partials/sidebar.ejs -->
<!-- ব্যবহার: include './partials/sidebar' with { active: 'dashboard' } -->
<style>
  .admin-wrap { display: flex; min-height: 100vh; background: #0f1115; }
  .admin-sidebar {
    width: 240px; background: #14171f; border-right: 1px solid rgba(255,255,255,0.06);
    position: fixed; top: 0; left: 0; bottom: 0; overflow-y: auto; z-index: 50;
    transform: translateX(-100%); transition: transform 0.25s ease;
  }
  .admin-sidebar.open { transform: translateX(0); }
  .admin-sidebar-brand {
    padding: 20px 18px; font-size: 16px; font-weight: 900; color: #f59e0b;
    border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 8px;
  }
  .admin-nav-group-title {
    padding: 16px 18px 6px; font-size: 10px; letter-spacing: 1px; text-transform: uppercase;
    color: #94a3b8; font-weight: 700;
  }
  .admin-nav-link {
    display: flex; align-items: center; gap: 10px; padding: 11px 18px; color: #cbd5e1;
    text-decoration: none; font-size: 13px; font-weight: 600; border-left: 3px solid transparent;
  }
  .admin-nav-link i { width: 18px; text-align: center; color: #94a3b8; font-size: 13px; }
  .admin-nav-link:active { background: rgba(255,255,255,0.04); }
  .admin-nav-link.active { background: rgba(245,158,11,0.1); border-left-color: #f59e0b; color: #fff; }
  .admin-nav-link.active i { color: #f59e0b; }

  .admin-content { flex: 1; min-width: 0; padding: 16px; padding-bottom: 60px; }
  .admin-topbar {
    display: flex; align-items: center; gap: 12px; margin-bottom: 18px; position: sticky; top: 0;
    background: #0f1115; z-index: 40; padding: 4px 0;
  }
  .admin-hamburger {
    width: 38px; height: 38px; border-radius: 10px; background: #1c2028; border: 1px solid rgba(255,255,255,0.08);
    color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .admin-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 45; display: none;
  }
  .admin-overlay.show { display: block; }

  .stat-card { background: #171b23; border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 16px; }
  .stat-card .stat-label { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .stat-card .stat-number { font-size: 22px; font-weight: 800; color: #fff; font-family: 'Teko', sans-serif; }
  .stat-card .stat-sub { font-size: 11px; color: #94a3b8; margin-top: 4px; }

  .grid { display: grid; gap: 12px; }
  .grid-2 { grid-template-columns: 1fr; }
  .grid-4 { grid-template-columns: 1fr 1fr; }
  @media (min-width: 700px) {
    .grid-2 { grid-template-columns: 1fr 1fr; }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
    .admin-sidebar { transform: translateX(0); position: sticky; }
    .admin-hamburger { display: none; }
    .admin-content { padding: 22px; }
  }

  .admin-card { background: #171b23; border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; overflow: hidden; }
  .admin-card-header { padding: 14px 16px; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 13px; font-weight: 700; color: #fff; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .admin-table th { text-align: left; padding: 8px 12px; color: #94a3b8; font-weight: 600; font-size: 10px; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.06); white-space: nowrap; }
  .admin-table td { padding: 9px 12px; color: #e2e8f0; border-bottom: 1px solid rgba(255,255,255,0.04); white-space: nowrap; }
  .badge { padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 700; }
  .badge-green { background: rgba(16,185,129,0.15); color: #10b981; }
  .badge-red { background: rgba(239,68,68,0.15); color: #ef4444; }
  .badge-amber { background: rgba(245,158,11,0.15); color: #f59e0b; }
</style>

<div class="admin-overlay" id="adminOverlay" onclick="toggleAdminSidebar(false)"></div>
<div class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-brand"><i class="fas fa-shield-alt"></i> Livo Admin</div>

  <%
    // নেভিগেশন আর এখানে হার্ডকোড করা নেই। আগে এই ফাইলে ৫৬টা লিংক ও তাদের বাংলা
    // লেবেল সরাসরি লেখা ছিল — অর্থাৎ English মোডেও এই ২৪টা পেজের সাইডবার বাংলাতেই
    // থাকত, আর admin-layout.ejs-এর ডেটা-চালিত নেভের সাথে দুটো আলাদা তালিকা
    // রক্ষণাবেক্ষণ করতে হতো (utils/adminNav.js-এ একটা লিংক যোগ করলে এখানে আসত না)।
    // এখন দুটো লেআউটই একই উৎস (res.locals.adminNav) থেকে রেন্ডার হয়, তাই লেবেল
    // অনুবাদিত এবং তালিকা কখনো ড্রিফট করে না।
    const sbGroups = (typeof adminNav !== 'undefined' && adminNav) ? adminNav : [];
    const sbActive = typeof active !== 'undefined' ? active : '';
    // ব্যাজ দেখানো হয় যে আইটেমগুলোর জন্য — id গুলো নিচের স্ক্রিপ্ট ব্যবহার করে।
    const sbBadgeId = { kyc: 'navBadgeKyc', payments: 'navBadgePayments' };
  %>

  <% sbGroups.forEach(function (group) { %>
    <div class="admin-nav-group-title"><%= t(group.labelKey || group.label) %></div>
    <% group.items.forEach(function (item) { %>
      <a href="<%= item.href %>" class="admin-nav-link <%= sbActive === item.active ? 'active' : '' %>">
        <i class="fas <%= item.icon %>"></i> <%= t(item.labelKey || item.label) %><% if (sbBadgeId[item.active]) { %><span class="badge badge-red" id="<%= sbBadgeId[item.active] %>" style="display:none;margin-left:auto;"></span><% } %>
      </a>
    <% }); %>
  <% }); %>

  <div class="admin-nav-group-title"><%= t('admin_nav_general') %></div>
  <a href="/" class="admin-nav-link"><i class="fas fa-home"></i> <%= t('admin_nav_back_to_site') %></a>
  <a href="/logout" class="admin-nav-link" style="color:#f87171"><i class="fas fa-sign-out-alt"></i> <%= t('admin_ui_logout') %></a>

  <%- include('./lang-switch') %>
</div>

<script>
function toggleAdminSidebar(force) {
  var sb = document.getElementById('adminSidebar');
  var ov = document.getElementById('adminOverlay');
  var show = force !== undefined ? force : !sb.classList.contains('open');
  sb.classList.toggle('open', show);
  ov.classList.toggle('show', show);
}

function updateAdminNavBadges() {
  fetch('/admin/pending-counts').then(function(r){ return r.json(); }).then(function(data){
    var payBadge = document.getElementById('navBadgePayments');
    var kycBadge = document.getElementById('navBadgeKyc');
    var payTotal = (data.deposits || 0) + (data.withdrawals || 0);
    if (payBadge) {
      if (payTotal > 0) { payBadge.textContent = payTotal; payBadge.style.display = 'inline-block'; }
      else { payBadge.style.display = 'none'; }
    }
    if (kycBadge) {
      if (data.kyc > 0) { kycBadge.textContent = data.kyc; kycBadge.style.display = 'inline-block'; }
      else { kycBadge.style.display = 'none'; }
    }
  }).catch(function(){});
}
updateAdminNavBadges();
setInterval(updateAdminNavBadges, 20000);
</script>

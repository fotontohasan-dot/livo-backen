<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Livo Admin - <%= title || 'Panel' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600&display=swap');
        body { font-family: 'Inter', system-ui, sans-serif; }
        .logo-font { font-family: 'Poppins', system-ui, sans-serif; font-weight: 600; letter-spacing: -.025em; }
        .nav-link { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .nav-link:hover { background-color: #334155; transform: translateX(4px); }
        .nav-link.active { background-color: #3b82f6; color: white; box-shadow: 0 10px 15px -3px rgb(59 130 246 / 0.3); }
        .sidebar-item { border-radius: 8px; margin: 2px 8px; }

        /* ===== Sidebar: always fixed + full-height scroll ===== */
        .admin-sidebar-shell {
          background: linear-gradient(to bottom, #0f172a, #1e293b);
          position: fixed;
          top: 0; left: 0; bottom: 0;
          width: 288px;
          z-index: 60;
          display: flex;
          flex-direction: column;
          transform: translateX(-100%);
          transition: transform 0.25s ease;
        }
        .admin-sidebar-shell.open { transform: translateX(0); }
        .admin-sidebar-nav {
          flex: 1 1 auto;
          overflow-y: auto;
          overflow-x: hidden;
          -webkit-overflow-scrolling: touch;
          overscroll-behavior: contain;
          padding: 12px 8px 120px 8px; /* bottom padding so last items clear bottom-nav */
        }
        .admin-sidebar-overlay {
          display: none;
          position: fixed; inset: 0;
          background: rgba(0,0,0,0.5);
          z-index: 55;
        }
        .admin-sidebar-overlay.show { display: block; }
        .admin-main { min-width: 0; }
        @media (min-width: 1024px) {
          .admin-sidebar-shell {
            transform: translateX(0);
            position: sticky;
            height: 100vh;
            flex-shrink: 0;
          }
          .admin-sidebar-overlay { display: none !important; }
          .admin-sidebar-nav { padding-bottom: 24px; }
        }

        #livo-toast-root { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 99999; display: flex; flex-direction: column; gap: 10px; align-items: center; width: 100%; max-width: 440px; padding: 0 16px; pointer-events: none; }
        .livo-toast { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: #1e293b; border: 1px solid rgba(234,179,8,0.4); color: #fff; padding: 13px 16px; border-radius: 14px; font-size: 13.5px; font-weight: 600; box-shadow: 0 10px 28px rgba(0,0,0,0.25); width: 100%; cursor: pointer; animation: livoToastIn .3s ease forwards; }
        .livo-toast.success { border-color: #10b981; } .livo-toast.success i { color: #34d399; }
        .livo-toast.error { border-color: #ef4444; } .livo-toast.error i { color: #f87171; }
        .livo-toast.info { border-color: #EAB308; } .livo-toast.info i { color: #facc15; }
        .livo-toast.leaving { animation: livoToastOut .25s ease forwards; }
        .livo-toast i { font-size: 16px; flex-shrink: 0; }
        @keyframes livoToastIn { from { opacity: 0; transform: translateY(-16px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes livoToastOut { to { opacity: 0; transform: translateY(-10px) scale(.96); } }
        .livo-spinner { width: 15px; height: 15px; border: 2.5px solid rgba(255,255,255,0.3); border-top-color: currentColor; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 6px; animation: livoSpin .7s linear infinite; }
        @keyframes livoSpin { to { transform: rotate(360deg); } }
        button:disabled { opacity: 0.75; cursor: not-allowed; }
    </style>
</head>
<body class="bg-slate-50">
    <div id="livo-toast-root"></div>
    <script>
      window.LivoToast = (function () {
        function ensureRoot() { return document.getElementById('livo-toast-root'); }
        function show(message, type, duration) {
          type = type || 'info'; duration = duration || 4000;
          const root = ensureRoot();
          if (!root || !message) return;
          const el = document.createElement('div');
          el.className = 'livo-toast ' + type;
          const icon = type === 'success' ? 'fa-circle-check' : (type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-info');
          el.innerHTML = '<i class="fas ' + icon + '"></i><span></span>';
          el.querySelector('span').textContent = message;
          const dismiss = () => { el.classList.add('leaving'); setTimeout(() => el.remove(), 250); };
          el.addEventListener('click', dismiss);
          root.appendChild(el);
          setTimeout(dismiss, duration);
        }
        function setLoading(btn, loading, loadingText) {
          if (!btn) return;
          if (loading) {
            if (!btn.dataset.livoOriginalHtml) btn.dataset.livoOriginalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="livo-spinner"></span>' + (loadingText || 'অপেক্ষা করুন...');
          } else {
            btn.disabled = false;
            if (btn.dataset.livoOriginalHtml) btn.innerHTML = btn.dataset.livoOriginalHtml;
          }
        }
        return { show: show, setLoading: setLoading };
      })();
      document.addEventListener('DOMContentLoaded', function () {
        <% if (typeof success !== 'undefined' && success && success.length) { %>
          <% success.forEach(function (m) { %> LivoToast.show(<%- JSON.stringify(m) %>, 'success'); <% }) %>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length) { %>
          <% error.forEach(function (m) { %> LivoToast.show(<%- JSON.stringify(m) %>, 'error'); <% }) %>
        <% } %>
      });
    </script>

    <div class="admin-sidebar-overlay" id="adminSidebarOverlay" onclick="closeMobileSidebar()"></div>

    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <div class="admin-sidebar-shell text-white" id="adminSidebarShell">
            <div class="px-6 py-5 flex items-center gap-x-3 border-b border-slate-700 flex-shrink-0">
                <div class="w-11 h-11 bg-blue-600 rounded-2xl flex items-center justify-center shadow-inner">
                    <i class="fas fa-chart-line text-white text-2xl"></i>
                </div>
                <div>
                    <span class="logo-font text-2xl font-semibold tracking-tighter">Livo</span>
                    <span class="text-blue-400 text-lg font-semibold">Admin</span>
                </div>
            </div>

            <div class="admin-sidebar-nav">
                <div class="px-3 mb-2"><p class="text-xs font-semibold tracking-widest text-slate-400 px-3">MAIN</p></div>

                <a href="/admin" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'dashboard' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-home w-5"></i><span>Dashboard</span></a>
                <a href="/admin/users" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'users' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-users w-5"></i><span>User Management</span></a>
                <a href="/admin/kyc" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'kyc' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-id-card w-5"></i><span>KYC</span></a>
                <a href="/admin/bets" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'bets' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-dice w-5"></i><span>Bets Management</span></a>
                <a href="/admin/matches" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'matches' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-futbol w-5"></i><span>Matches</span></a>
                <a href="/admin/deposits" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'deposits' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-arrow-down w-5"></i><span>Deposits</span></a>
                <a href="/admin/withdrawals" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'withdrawals' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-arrow-up w-5"></i><span>Withdrawals</span></a>
                <a href="/admin/transactions" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'transactions' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-exchange-alt w-5"></i><span>Transactions</span></a>
                <a href="/admin/support" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'support' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-headset w-5"></i><span>Support Tickets</span></a>
                <a href="/chat/admin" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link text-slate-300 hover:text-white"><i class="fas fa-comments w-5"></i><span>Live Chat</span></a>
                <a href="/admin/notifications" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'notifications' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-bullhorn w-5"></i><span>Broadcast</span></a>
                <a href="/admin/notification-templates" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'notification-templates' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-bell w-5"></i><span>Notification Templates</span></a>
                <a href="/admin/announcements" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'announcements' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-megaphone w-5"></i><span>Announcements</span></a>
                <a href="/admin/reports" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'reports' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-chart-bar w-5"></i><span>Reports</span></a>

                <div class="px-3 mt-5 mb-2"><p class="text-xs font-semibold tracking-widest text-slate-400 px-3">SECURITY</p></div>
                <a href="/admin/security-overview" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'security-overview' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-shield-halved w-5"></i><span>Security Overview</span></a>
                <a href="/admin/fraud-monitoring" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'fraud-monitoring' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-exclamation-triangle w-5"></i><span>Fraud Monitoring</span></a>
                <a href="/admin/fraud-logs" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'fraud-logs' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-flag w-5"></i><span>Fraud Log</span></a>
                <a href="/admin/duplicate-accounts" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'duplicate-accounts' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-clone w-5"></i><span>Duplicate Accounts</span></a>
                <a href="/admin/login-history" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'login-history' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-clock-rotate-left w-5"></i><span>Login History</span></a>
                <a href="/admin/bot-monitoring" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'bot-monitoring' || active === 'bot-logs' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-robot w-5"></i><span>Bot Monitoring</span></a>
                <a href="/admin/audit-logs" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'audit-logs' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-clipboard-list w-5"></i><span>Audit Logs</span></a>

                <div class="px-3 mt-5 mb-2"><p class="text-xs font-semibold tracking-widest text-slate-400 px-3">SYSTEM</p></div>
                <a href="/admin/system-diagnostics" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'system-diagnostics' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-heart-pulse w-5"></i><span>Server Health</span></a>
                <a href="/admin/queues" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'queues' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-layer-group w-5"></i><span>Job Queue</span></a>
                <a href="/admin/cache" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'cache' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-bolt w-5"></i><span>Cache</span></a>
                <a href="/admin/cron-jobs" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'cron-jobs' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-clock w-5"></i><span>Cron Jobs</span></a>
                <a href="/admin/backups" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'backups' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-database w-5"></i><span>Backup & Restore</span></a>
                <a href="/admin/feature-flags" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'feature-flags' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-toggle-on w-5"></i><span>Feature Flags</span></a>
                <a href="/admin/api-keys" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'api-keys' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-key w-5"></i><span>API Keys</span></a>
                <a href="/admin/api-logs" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'api-logs' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-list-alt w-5"></i><span>API Logs</span></a>
                <a href="/admin/system-settings" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'system-settings' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-sliders w-5"></i><span>System Settings</span></a>
                <a href="/admin/settings" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'settings' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
                <a href="/admin/localization" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'localization' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-language w-5"></i><span>Localization</span></a>
                <a href="/admin/roles" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'roles' ? 'active' : 'text-slate-300 hover:text-white' %>"><i class="fas fa-user-shield w-5"></i><span>Roles</span></a>
                <a href="/" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link text-slate-300 hover:text-white"><i class="fas fa-home w-5"></i><span>Back to Site</span></a>
                <a href="/admin/logout" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link text-red-400 hover:text-red-300"><i class="fas fa-sign-out-alt w-5"></i><span>Logout</span></a>
            </div>

            <div class="px-4 py-4 border-t border-slate-700 bg-slate-900/50 flex-shrink-0">
                <div class="flex items-center gap-x-3 px-2">
                    <div class="w-9 h-9 rounded-full ring-2 ring-blue-500/30 bg-blue-600 flex items-center justify-center font-bold text-sm flex-shrink-0">
                        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user && user.username) || 'Admin' %></p>
                        <p class="text-xs text-slate-400">Super Admin</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden admin-main lg:ml-0">
            <div class="admin-header h-16 flex items-center justify-between px-4 sm:px-6 flex-shrink-0 bg-white shadow-sm">
                <div class="flex items-center gap-x-4">
                    <button type="button" class="lg:hidden text-slate-600 hover:text-slate-900 p-2" onclick="toggleMobileSidebar()" aria-label="Menu">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg sm:text-xl font-semibold text-slate-800"><%= title || 'Admin Panel' %></h1>
                        <p class="text-xs text-slate-500 hidden md:block">Livo Betting Platform • Admin Dashboard</p>
                    </div>
                </div>
                <div class="flex items-center gap-x-2">
                    <div class="w-9 h-9 rounded-2xl ring-2 ring-blue-100 bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
                        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
                    </div>
                </div>
            </div>

            <div class="flex-1 overflow-auto p-4 sm:p-6 bg-slate-50" style="padding-bottom: 90px;">
                <%- body %>
            </div>
        </div>
    </div>

    <script>
        function toggleMobileSidebar() {
          var shell = document.getElementById('adminSidebarShell');
          var ov = document.getElementById('adminSidebarOverlay');
          if (!shell) return;
          var open = shell.classList.toggle('open');
          if (ov) ov.classList.toggle('show', open);
        }
        function closeMobileSidebar() {
          var shell = document.getElementById('adminSidebarShell');
          var ov = document.getElementById('adminSidebarOverlay');
          if (shell) shell.classList.remove('open');
          if (ov) ov.classList.remove('show');
        }
        function logout() {
          if (confirm('Are you sure you want to logout?')) window.location.href = '/admin/logout';
        }
    </script>

    <%- include('./bottom-nav') %>
</body>
</html>

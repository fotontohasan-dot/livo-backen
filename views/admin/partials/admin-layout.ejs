                <a href="/admin/cache" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'cache' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-bolt w-5"></i>
                    <span>Cache Management</span>
                </a>

                <a href="/admin/backups" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'backups' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-database w-5"></i>
                    <span>Backup &amp; Restore</span>
                </a>

                <a href="/admin/feature-flags" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'feature-flags' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-flag w-5"></i>
                    <span>Feature Flags</span>
                </a>

                <a href="/admin/localization" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'localization' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-language w-5"></i>
                    <span>Localization</span>
                </a>

                <a href="/admin/telegram" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'telegram' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fab fa-telegram w-5"></i>
                    <span>Telegram Integration</span>
                </a>

                <a href="/admin/system-diagnostics" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'system-diagnostics' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-heart-pulse w-5"></i>
                    <span>System Diagnostics</span>
                </a>

                <a href="/admin/diagnostics" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'diagnostics' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-stethoscope w-5"></i>
                    <span>Diagnostics</span>
                </a>

                <a href="/admin/sentry-status" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'sentry-status' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-bug w-5"></i>
                    <span>Sentry Status</span>
                </a>

                <div class="px-3 mt-6 mb-2">
                    <p class="text-xs font-semibold tracking-widest text-slate-400 px-3">INTEGRATIONS</p>
                </div>

                <a href="/admin/api-keys" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'api-keys' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-key w-5"></i>
                    <span>API Keys</span>
                </a>

                <a href="/admin/support" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'support' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-headset w-5"></i>
                    <span>Support Tickets</span>
                </a>

                <a href="/chat/admin" class="sidebar-item flex items-center gap-x-3 px-4 py-3 text-sm font-medium nav-link <%= active === 'chat' ? 'active' : 'text-slate-300 hover:text-white' %>">
                    <i class="fas fa-comments w-5"></i>
                    <span>Live Chat</span>
                </a>
            </div>

            <!-- Admin Profile -->
            <div class="px-4 py-4 border-t border-slate-700 bg-slate-900/50">
                <div class="flex items-center gap-x-3 px-2">
                    <div class="w-9 h-9 rounded-full ring-2 ring-blue-500/30 bg-blue-600 flex items-center justify-center font-bold text-sm flex-shrink-0">
                        <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-white truncate"><%= (user && user.username) || 'Admin' %></p>
                        <p class="text-xs text-slate-400">Super Admin</p>
                    </div>
                    <button onclick="logout()" class="text-slate-400 hover:text-red-400 transition-colors">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Navbar -->
            <div class="admin-header h-16 flex items-center justify-between px-6 flex-shrink-0">
                <div class="flex items-center gap-x-4">
                    <!-- Mobile Menu -->
                    <button class="lg:hidden text-slate-600 hover:text-slate-900" onclick="toggleMobileSidebar()">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    
                    <div>
                        <h1 class="text-xl font-semibold text-slate-800"><%= title || 'Admin Panel' %></h1>
                        <p class="text-xs text-slate-500 hidden md:block">Livo Betting Platform • Admin Dashboard</p>
                    </div>
                </div>

                <div class="flex items-center gap-x-4">
                    <!-- Profile -->
                    <div class="flex items-center gap-x-2 pl-3 border-l border-slate-200">
                        <div class="text-right hidden md:block">
                            <p class="text-sm font-semibold text-slate-700"><%= (user && user.username) || 'Admin' %></p>
                            <p class="text-xs text-slate-500">Super Admin</p>
                        </div>
                        <div class="w-9 h-9 rounded-2xl ring-2 ring-blue-100 bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
                            <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="flex-1 overflow-auto p-6 bg-slate-50">
                <%- body %>
            </div>
        </div>
    </div>

    <script>
        function toggleMobileSidebar() {
            const sidebar = document.querySelector('.admin-sidebar');
            if (sidebar) sidebar.classList.toggle('hidden');
        }
        
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                window.location.href = '/admin/logout';
            }
        }
        
        // Tailwind script
        function initTailwind() {
            document.documentElement.style.setProperty('--accent', '#3b82f6');
        }
        
        window.onload = function() {
            initTailwind();
        }
    </script>

    <%- include('./bottom-nav') %>
</body>
</html>

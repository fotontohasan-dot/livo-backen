<!-- views/admin/partials/bottom-nav.ejs -->
<!-- অ্যাডমিন প্যানেলের ফিক্সড বটম নেভিগেশন বার — জরুরি ফিচারে দ্রুত অ্যাক্সেস + রিয়েল-টাইম নোটিফিকেশন ব্যাজ -->
<style>
  .admin-bottom-nav {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 500;
    display: flex; justify-content: space-around; align-items: stretch;
    background: #14171f; border-top: 1px solid rgba(255,255,255,0.08);
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -4px 16px rgba(0,0,0,0.35);
  }
  .admin-bottom-nav a {
    position: relative; display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: 3px; color: #94a3b8; text-decoration: none;
    font-size: 10px; font-weight: 700; padding: 6px 4px; border-radius: 10px; flex: 1;
    transition: color .15s;
  }
  .admin-bottom-nav a i { font-size: 18px; }
  .admin-bottom-nav a.active { color: #f59e0b; }
  .admin-bottom-nav a:active { color: #f59e0b; }

  .admin-bn-badge {
    position: absolute; top: -2px; right: 12px; min-width: 16px; height: 16px; padding: 0 4px;
    background: #ef4444; color: #fff; border-radius: 999px; font-size: 10px; font-weight: 800;
    display: none; align-items: center; justify-content: center; line-height: 1;
    box-shadow: 0 0 0 2px #14171f;
  }
  .admin-bn-badge.show { display: flex; }
  .admin-bn-badge.pulse { animation: adminBnPulse .6s ease; }
  @keyframes adminBnPulse { 0% { transform: scale(1); } 30% { transform: scale(1.55); } 100% { transform: scale(1); } }

  .admin-bn-toast {
    position: fixed; left: 50%; bottom: 72px; transform: translateX(-50%) translateY(16px);
    background: #1c2028; border: 1px solid rgba(245,158,11,0.45); color: #fff;
    padding: 10px 16px; border-radius: 12px; font-size: 12px; font-weight: 700;
    box-shadow: 0 8px 24px rgba(0,0,0,0.45); z-index: 600; opacity: 0; pointer-events: none;
    transition: all .3s ease; max-width: 88vw; display: flex; align-items: center; gap: 8px;
  }
  .admin-bn-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* ===== সাউন্ড নোটিফিকেশন অন/অফ টগল বাটন ===== */
  .admin-sound-toggle {
    position: fixed; top: calc(10px + env(safe-area-inset-top, 0px)); right: 12px; z-index: 580;
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.1);
    background: #1c2028; color: #94a3b8; display: flex; align-items: center; justify-content: center;
    font-size: 16px; box-shadow: 0 4px 14px rgba(0,0,0,0.35); cursor: pointer;
  }
  .admin-sound-toggle.on { color: #f59e0b; border-color: rgba(245,158,11,0.4); }
  .admin-sound-toggle.flash { animation: adminSoundFlash .4s ease; }
  @keyframes adminSoundFlash { 0% { transform: scale(1); } 40% { transform: scale(1.2); } 100% { transform: scale(1); } }
</style>

<nav class="admin-bottom-nav" id="adminBottomNav">
  <a href="/admin/dashboard"><i class="fas fa-house"></i><span>হোম</span></a>
  <a href="/payment/admin/payments?tab=deposit">
    <i class="fas fa-arrow-down"></i><span>ডিপোজিট</span>
    <span class="admin-bn-badge" id="bnBadgeDeposit">0</span>
  </a>
  <a href="/payment/admin/payments?tab=withdraw">
    <i class="fas fa-arrow-up"></i><span>উইথড্র</span>
    <span class="admin-bn-badge" id="bnBadgeWithdraw">0</span>
  </a>
  <a href="/chat/admin">
    <i class="fas fa-headset"></i><span>চ্যাট</span>
    <span class="admin-bn-badge" id="bnBadgeChat">0</span>
  </a>
  <a href="/admin/kyc"><i class="fas fa-id-card"></i><span>KYC</span></a>
</nav>

<div class="admin-bn-toast" id="adminBnToast"></div>

<button type="button" class="admin-sound-toggle" id="adminSoundToggle" title="সাউন্ড নোটিফিকেশন অন/অফ">
  <i class="fas fa-bell"></i>
</button>

<script>
(function () {
  function setBadge(id, val) {
    var el = document.getElementById(id);
    if (!el) return;
    var n = Number(val) || 0;
    if (n > 0) { el.textContent = n > 99 ? '99+' : n; el.classList.add('show'); }
    else { el.classList.remove('show'); }
  }

  function bump(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('pulse');
    void el.offsetWidth; // রিফ্লো — অ্যানিমেশন আবার ট্রিগার করার জন্য
    el.classList.add('pulse');
  }

  function loadCounts() {
    fetch('/admin/api/notification-counts')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        setBadge('bnBadgeDeposit', d.deposits);
        setBadge('bnBadgeWithdraw', d.withdrawals);
        setBadge('bnBadgeChat', d.chats);
      })
      .catch(function () {});
  }

  function showToast(text) {
    var t = document.getElementById('adminBnToast');
    if (!t) return;
    t.innerHTML = '🔔 ' + text;
    t.classList.add('show');
    clearTimeout(t._hideTimer);
    t._hideTimer = setTimeout(function () { t.classList.remove('show'); }, 3200);
  }

  // ===== সাউন্ড নোটিফিকেশন অন/অফ (এক ট্যাপে টগল, localStorage-এ সেভ থাকে) =====
  var SOUND_KEY = 'livo_admin_sound_enabled';
  function isSoundOn() {
    var v = localStorage.getItem(SOUND_KEY);
    return v === null ? true : v === '1'; // ডিফল্ট: অন
  }
  function setSoundOn(on) {
    localStorage.setItem(SOUND_KEY, on ? '1' : '0');
    updateSoundToggleUI();
  }
  function updateSoundToggleUI() {
    var btn = document.getElementById('adminSoundToggle');
    if (!btn) return;
    var on = isSoundOn();
    btn.classList.toggle('on', on);
    btn.innerHTML = '<i class="fas fa-bell' + (on ? '' : '-slash') + '"></i>';
    btn.title = on ? 'সাউন্ড নোটিফিকেশন: চালু (বন্ধ করতে ট্যাপ করুন)' : 'সাউন্ড নোটিফিকেশন: বন্ধ (চালু করতে ট্যাপ করুন)';
  }

  // ===== অডিও আনলক (ব্রাউজার অটোপ্লে পলিসি হ্যান্ডলিং) =====
  // ব্রাউজার ইউজার-জেসচার (ক্লিক/টাচ) ছাড়া AudioContext চালু করতে দেয় না।
  // তাই একটাই AudioContext বানিয়ে রাখা হচ্ছে, আর অ্যাডমিন প্যানেলে প্রথম
  // ক্লিক/টাচ হওয়া মাত্র সেটা resume() করে "আনলক" করে দেওয়া হচ্ছে।
  var audioCtx = null;
  var pendingSound = false;

  function getCtx() {
    if (!audioCtx) {
      var Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      audioCtx = new Ctx();
    }
    return audioCtx;
  }

  function unlockAudio() {
    var ctx = getCtx();
    if (!ctx) return;
    if (ctx.state === 'suspended') {
      ctx.resume().then(function () {
        if (pendingSound) { pendingSound = false; playSound(); }
      }).catch(function () {});
    } else if (pendingSound) {
      pendingSound = false; playSound();
    }
    // ফাইল-বেজড অডিওকেও একই জেসচারে "আনলক" করে রাখা হচ্ছে
    fileAudio.play().then(function () {
      fileAudio.pause();
      fileAudio.currentTime = 0;
    }).catch(function () {});
  }

  ['click', 'touchstart', 'keydown'].forEach(function (evt) {
    document.addEventListener(evt, unlockAudio, { passive: true });
  });

  // দুই-টোনের রিং বীপ (কোনো এক্সটার্নাল mp3 ফাইলের উপর নির্ভর করে না)
  function beep() {
    var ctx = getCtx();
    if (!ctx) return;
    [0, 0.16, 0.34].forEach(function (delay, i) {
      var o = ctx.createOscillator();
      var g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = i === 1 ? 1180 : 920;
      var t0 = ctx.currentTime + delay;
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(0.22, t0 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.26);
      o.connect(g); g.connect(ctx.destination);
      o.start(t0);
      o.stop(t0 + 0.28);
    });
  }

  // (ঐচ্ছিক) public/notification.mp3 ফাইল আপলোড করলে সেটাই বাজবে,
  // না থাকলে বা প্লে ফেইল করলে জেনারেটেড বীপে ফলব্যাক হবে।
  var fileAudio = new Audio('/notification.mp3');
  fileAudio.preload = 'auto';
  var fileAudioAvailable = null; // null = এখনো যাচাই হয়নি
  fileAudio.addEventListener('canplaythrough', function () { fileAudioAvailable = true; });
  fileAudio.addEventListener('error', function () { fileAudioAvailable = false; });

  function playSound() {
    if (!isSoundOn()) return; // অ্যাডমিন নিজে অফ করে রাখলে বাজবে না
    try {
      var ctx = getCtx();
      if (ctx && ctx.state === 'suspended') {
        // এখনো আনলক হয়নি (অ্যাডমিন এখনো একবারও ক্লিক/টাচ করেননি) —
        // পরের ক্লিকেই এই সাউন্ড বেজে উঠবে
        pendingSound = true;
      } else if (fileAudioAvailable) {
        fileAudio.currentTime = 0;
        var p = fileAudio.play();
        if (p && p.catch) p.catch(beep);
      } else {
        beep();
      }
      if (navigator.vibrate) navigator.vibrate([120, 60, 120]);
    } catch (e) {
      beep();
    }
  }

  // ===== Web Push সাবস্ক্রিপশন (ফোন লক/ব্যাকগ্রাউন্ড/অন্য অ্যাপে থাকলেও নোটিফিকেশন) =====
  // এটা Socket.io থেকে আলাদা — একবার পারমিশন দিলে ব্রাউজার/সিস্টেম নিজেই
  // পুশ ডেলিভার করে, অ্যাডমিন প্যানেল খোলা রাখা লাগে না।
  function urlBase64ToUint8Array(base64String) {
    var padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    var rawData = atob(base64);
    var outputArray = new Uint8Array(rawData.length);
    for (var i = 0; i < rawData.length; i++) outputArray[i] = rawData.charCodeAt(i);
    return outputArray;
  }

  function isIOS() {
    return /iphone|ipad|ipod/i.test(navigator.userAgent);
  }
  function isStandalone() {
    return window.navigator.standalone === true ||
      (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
  }

  function showAddToHomeHint() {
    if (document.getElementById('adminA2hsHint')) return;
    var btn = document.createElement('div');
    btn.id = 'adminA2hsHint';
    btn.innerHTML = '📲 ফোন লক থাকলেও নোটিফিকেশন পেতে: Safari-র Share বাটন → Add to Home Screen → হোম স্ক্রিনের আইকন থেকে অ্যাপ খুলুন';
    btn.style.cssText = 'position:fixed;left:12px;right:12px;bottom:84px;z-index:590;' +
      'background:#1c2028;color:#e2e8f0;border:1px solid rgba(245,158,11,0.4);padding:10px 14px;border-radius:12px;' +
      'font-weight:600;font-size:11.5px;line-height:1.5;box-shadow:0 8px 24px rgba(0,0,0,0.35);';
    document.body.appendChild(btn);
  }

  function showPushEnableButton() {
    if (document.getElementById('adminPushEnableBtn')) return;
    var btn = document.createElement('button');
    btn.id = 'adminPushEnableBtn';
    btn.innerHTML = '🔔 লক থাকলেও নোটিফিকেশন চালু করুন';
    btn.style.cssText = 'position:fixed;left:12px;right:12px;bottom:84px;z-index:590;' +
      'background:#f59e0b;color:#111;border:none;padding:10px 14px;border-radius:12px;' +
      'font-weight:700;font-size:12px;box-shadow:0 8px 24px rgba(0,0,0,0.35);cursor:pointer;';
    btn.onclick = function () {
      btn.remove();
      subscribePush();
    };
    document.body.appendChild(btn);
  }

  function subscribePush() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;

    navigator.serviceWorker.register('/service-worker.js').then(function (reg) {
      return Notification.requestPermission().then(function (perm) {
        if (perm !== 'granted') return;
        return fetch('/admin/push/public-key')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.publicKey) return;
            return reg.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(d.publicKey)
            });
          })
          .then(function (sub) {
            if (!sub) return;
            return fetch('/admin/push/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ subscription: sub.toJSON ? sub.toJSON() : sub })
            });
          });
      });
    }).catch(function (err) { console.warn('Push subscribe failed:', err); });
  }

  function initPush() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
      // iOS Safari-তে সাধারণ ট্যাবে (হোম স্ক্রিন থেকে না খুললে) এই APIগুলো থাকেই না
      if (isIOS() && !isStandalone()) showAddToHomeHint();
      return;
    }
    if (Notification.permission === 'granted') {
      // আগে থেকেই পারমিশন থাকলে চুপচাপ (কোনো UI ছাড়াই) সাবস্ক্রিপশন নিশ্চিত করা
      subscribePush();
    } else if (Notification.permission === 'default') {
      // ===== পেজ ঢোকার সাথে সাথেই অটোমেটিক পারমিশন চাওয়ার চেষ্টা =====
      // Android Chrome-এ এটা গেসচার ছাড়াই popup দেখাতে পারে।
      // iOS/অন্য কিছু ব্রাউজারে গেসচার ছাড়া popup আসে না — তখন এই কল
      // চুপচাপ কিছু না করেই থেমে যায় (permission 'default'-ই থেকে যায়),
      // তাই সামান্য পরে চেক করে দরকার হলে ম্যানুয়াল বাটন দেখানো হচ্ছে।
      subscribePush();
      setTimeout(function () {
        if (Notification.permission === 'default') showPushEnableButton();
      }, 800);
    }
    // permission === 'denied' হলে কিছু করার নেই, ব্রাউজার সেটিংস থেকে অ্যাডমিনকে বদলাতে হবে
  }

  document.addEventListener('DOMContentLoaded', initPush);

  document.addEventListener('DOMContentLoaded', function () {
    updateSoundToggleUI();
    var toggleBtn = document.getElementById('adminSoundToggle');
    if (!toggleBtn) return;
    toggleBtn.addEventListener('click', function () {
      var turningOn = !isSoundOn();
      setSoundOn(turningOn);
      toggleBtn.classList.add('flash');
      setTimeout(function () { toggleBtn.classList.remove('flash'); }, 400);
      if (turningOn) {
        // অন করার সাথে সাথে একটা টেস্ট বীপ — বোঝার জন্য যে সাউন্ড কাজ করছে
        // এই ক্লিকটাই ব্রাউজারের ইউজার-জেসচার হিসেবে অডিও আনলকও করে দেয়
        setTimeout(playSound, 50);
      }
    });
  });

  var LABELS = { deposit: 'নতুন ডিপোজিট রিকোয়েস্ট', withdraw: 'নতুন উইথড্র রিকোয়েস্ট', chat: 'নতুন সাপোর্ট মেসেজ' };
  var BADGE_IDS = { deposit: 'bnBadgeDeposit', withdraw: 'bnBadgeWithdraw', chat: 'bnBadgeChat' };

  function handleAlert(data) {
    var type = data && data.type;
    if (BADGE_IDS[type]) bump(BADGE_IDS[type]);
    showToast((data && data.message) ? data.message : (LABELS[type] || 'নতুন নোটিফিকেশন'));
    playSound();
    loadCounts();
  }

  loadCounts();
  setInterval(loadCounts, 30000); // সকেট কোনো কারণে না পৌঁছালেও ৩০ সেকেন্ড পরপর ফলব্যাক আপডেট

  function connectSocket() {
    if (typeof io === 'undefined') return;
    var socket = io();
    socket.on('connect', function () { socket.emit('join_admin'); });
    socket.on('admin_alert', handleAlert);
    socket.on('new_message', function (data) {
      if (data && !data.isAdmin) handleAlert({ type: 'chat', message: 'নতুন সাপোর্ট মেসেজ এসেছে' });
    });
  }

  if (typeof io === 'undefined') {
    var s = document.createElement('script');
    s.src = '/socket.io/socket.io.js';
    s.onload = connectSocket;
    document.head.appendChild(s);
  } else {
    connectSocket();
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Layout A (Tailwind ড্যাশবোর্ড)-এর স্ক্রলযোগ্য কন্টেইনারে বটম-নেভের জন্য জায়গা রাখা
    var layoutAContent = document.querySelector('.flex-1.overflow-auto');
    if (layoutAContent) layoutAContent.style.paddingBottom = '76px';

    var path = window.location.pathname;
    var curTab = new URLSearchParams(window.location.search).get('tab') || 'deposit';
    document.querySelectorAll('#adminBottomNav a').forEach(function (a) {
      var href = a.getAttribute('href');
      var hp = href.split('?')[0];
      var hq = href.split('?')[1] || '';
      var samePath = (path === hp) || (hp !== '/admin/dashboard' && path.indexOf(hp) === 0);
      var sameTab = true;
      if (hq) sameTab = (new URLSearchParams(hq).get('tab') === curTab);
      if (samePath && sameTab) a.classList.add('active');
    });
    if (path === '/admin' || path === '/admin/dashboard') {
      document.querySelector('#adminBottomNav a').classList.add('active');
    }
  });
})();
</script>

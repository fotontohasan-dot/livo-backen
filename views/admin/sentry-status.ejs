<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const s = status;
const enabledBadge = s && s.enabled
  ? '<span class="px-4 py-2 rounded-2xl text-sm font-bold bg-emerald-100 text-emerald-700"><i class="fas fa-circle-check"></i> ' + t("snt_active") + '</span>'
  : '<span class="px-4 py-2 rounded-2xl text-sm font-bold bg-slate-100 text-slate-500"><i class="fas fa-circle-pause"></i> ' + t("snt_inactive") + '</span>';

function row(label, value, mono) {
  return '<div class="flex items-center justify-between py-3 border-b border-slate-50 last:border-0">' +
    '<span class="text-sm text-slate-500">' + label + '</span>' +
    '<span class="text-sm font-semibold text-slate-800' + (mono ? ' font-mono' : '') + '">' + escapeHtml(value) + '</span>' +
  '</div>';
}
%>
<%- include('partials/admin-layout', {
    title: 'Sentry Monitoring',
    active: 'sentry-status',
    body: `
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h2 class="text-2xl font-semibold text-slate-900">Sentry Monitoring</h2>
            <p class="text-slate-500 mt-1 text-sm">${t('snt_subtitle')}</p>
        </div>
        ${enabledBadge}
    </div>

    ${error ? `<div class="bg-red-50 border border-red-200 text-red-600 px-5 py-4 rounded-2xl text-sm">❌ ${escapeHtml(error)}</div>` : ''}
    ${testSent ? `<div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-5 py-4 rounded-2xl text-sm">✅ ${t('snt_test_sent')}</div>` : ''}

    ${s ? `
    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 mb-2">${t('snt_config')}</h3>
        ${row(t('snt_dsn_configured'), s.dsnConfigured ? t('snt_yes') : t('snt_no'))}
        ${s.dsnMasked ? row(t('snt_dsn_masked'), s.dsnMasked, true) : ''}
        ${row('Environment', s.environment)}
        ${row('Release', s.release, true)}
        ${row('Traces Sample Rate', s.tracesSampleRate)}
        ${row('Profiles Sample Rate', s.profilesSampleRate)}
        ${row(t('snt_init_done'), s.initialized ? t('snt_yes') : t('snt_no'))}
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 mb-3">${t('snt_env_vars')}</h3>
        <div class="bg-slate-50 rounded-2xl p-4 font-mono text-xs text-slate-600 leading-relaxed overflow-x-auto">
SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXXX   <span class="text-slate-400"># ${t('snt_env_dsn')}</span><br>
SENTRY_ENABLED=false                                  <span class="text-slate-400"># ${t('snt_env_disable')}</span><br>
SENTRY_ENVIRONMENT=production                         <span class="text-slate-400"># ${t('snt_env_default')}</span><br>
SENTRY_RELEASE=1.2.3                                  <span class="text-slate-400"># ${t('snt_env_release')}</span><br>
SENTRY_TRACES_SAMPLE_RATE=0.1                         <span class="text-slate-400"># ${t('snt_env_traces')}</span><br>
SENTRY_PROFILES_SAMPLE_RATE=0                         <span class="text-slate-400"># ${t('snt_env_profiles')}</span>
        </div>
        <p class="text-xs text-slate-400 mt-3">${t('snt_restart_hint')}</p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 mb-2">${t('snt_test_event')}</h3>
        <p class="text-xs text-slate-500 mb-4">${t('snt_test_desc')}</p>
        <form method="POST" action="/admin/sentry-status/test-error">
            <button type="submit" class="px-5 py-2.5 ${s.enabled ? 'bg-blue-600 hover:bg-blue-700' : 'bg-slate-300 cursor-not-allowed'} text-white rounded-2xl text-sm font-semibold" ${s.enabled ? '' : 'disabled'}>
                <i class="fas fa-bug"></i> ${t('snt_send_test')}
            </button>
        </form>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 mb-2">${t('snt_monitored')}</h3>
        <ul class="text-xs text-slate-500 space-y-1.5 list-disc pl-4">
            <li>${t('snt_mon_http')}</li>
            <li>${t('snt_mon_promise')}</li>
            <li>${t('snt_mon_queue')}</li>
            <li>${t('snt_mon_cron')}</li>
            <li>${t('snt_mon_pg')}</li>
            <li>${t('snt_mon_user')}</li>
            <li>${t('snt_mon_redact')}</li>
        </ul>
    </div>
    ` : ''}
</div>
`
}) %>

<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
%>
<%- include('partials/admin-layout', {
    title: 'User Role Assignment',
    active: 'user-roles',
    body: `
<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-xl font-bold text-slate-800">👤 User Role Assignment</h1>
    <a href="/admin/roles" class="text-sm text-slate-500"><i class="fas fa-arrow-left"></i> Roles-এ ফিরে যান</a>
  </div>

  <form method="GET" action="/admin/user-roles" class="mb-5">
    <input type="text" name="q" value="${escapeHtml(search)}" placeholder="Username দিয়ে খুঁজুন" class="border px-3 py-2.5 rounded-xl text-sm w-full md:w-80">
  </form>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase">
        <th class="p-3">Username</th><th class="p-3">Email</th><th class="p-3">বর্তমান Role</th><th class="p-3">নতুন Role এসাইন করুন</th>
      </tr></thead>
      <tbody>
        ${users.map(u => `
          <tr class="border-t border-slate-50">
            <td class="p-3 font-medium">${escapeHtml(u.username)}</td>
            <td class="p-3 text-slate-500">${escapeHtml(u.email || '-')}</td>
            <td class="p-3">${u.role_key ? `<span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full text-xs font-bold">${escapeHtml(u.role_key)}</span>` : '<span class="px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full text-xs font-bold">Super Admin (ডিফল্ট)</span>'}</td>
            <td class="p-3">
              <form method="POST" action="/admin/user-roles/${u.id}/assign" class="flex gap-2">
                <select name="role_key" class="border px-2 py-1.5 rounded-lg text-xs">
                  <option value="">— কোনোটা না (সুপার-অ্যাডমিন-সমতুল্য) —</option>
                  ${roles.map(r => `<option value="${r.key}" ${u.role_key === r.key ? 'selected' : ''}>${escapeHtml(r.name)}</option>`).join('')}
                </select>
                <button type="submit" class="px-3 py-1.5 bg-slate-800 text-white rounded-lg text-xs font-semibold">সেভ</button>
              </form>
            </td>
          </tr>
        `).join('') || '<tr><td colspan="4" class="p-6 text-center text-slate-400">কোনো admin ইউজার পাওয়া যায়নি</td></tr>'}
      </tbody>
    </table>
  </div>
</div>
`
}) %>

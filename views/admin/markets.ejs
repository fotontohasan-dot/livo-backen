<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container" style="padding-top: 20px;">
  <h2>⚙️ মার্কেট ম্যানেজমেন্ট</h2>
  <p><strong><%= match.teams ? match.teams[0] + ' vs ' + match.teams[1] : match.title %></strong></p>

  <a href="/admin/matches" class="btn btn-secondary">← ম্যাচ লস্ট</a>

  <!-- নতুন মার্কেট যোগ -->
  <div class="card" style="margin: 20px 0; padding: 20px;">
    <h5>নতুন মার্কেট যোগ করুন</h5>
    <form action="/admin/markets/update" method="POST">
      <input type="hidden" name="match_id" value="<%= match.id %>">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <select name="type" required class="form-control">
          <option value="bookmaker">বুকমেকার</option>
          <option value="fancy">ফ্যান্সি</option>
        </select>

        <input type="text" name="name" placeholder="মার্কটের নাম (যেমন: ম্যাচ উইনার)" required class="form-control">
      </div>

      <input type="text" name="odds" placeholder='{"0": 1.85, "1": 2.10}' style="margin-top:10px;" required class="form-control">

      <button type="submit" class="btn btn-success" style="margin-top:15px; width:100%;">মার্কেট যোগ করুন</button>
    </form>
  </div>

  <!-- বরমান মার্কেট -->
  <h5>বর্তমান মার্কেটসমূহ</h5>
  <% markets.forEach(market => { %>
    <div class="card" style="margin-bottom:15px; padding:15px;">
      <strong><%= market.name %></strong>
      <span class="badge <%= market.status === 'open' ? 'bg-success' : (market.status === 'settled' ? 'bg-secondary' : 'bg-danger') %>"><%= market.status %></span>

      <pre style="background:#111; padding:10px; border-radius:8px; font-size:12px;"><%= JSON.stringify(market.odds, null, 2) %></pre>

      <!-- সাসপেন্ড / ওপেন (শুধু settled না হলে) -->
      <% if (market.status !== 'settled') { %>
        <form action="/admin/markets/<%= market.id %>/toggle" method="POST" style="display:inline;">
          <input type="hidden" name="status" value="<%= market.status === 'open' ? 'suspended' : 'open' %>">
          <button type="submit" class="btn btn-sm <%= market.status === 'open' ? 'btn-warning' : 'btn-success' %>">
            <%= market.status === 'open' ? 'সাসপেন্ড করুন' : 'ওপেন করুন' %>
          </button>
        </form>

        <!-- ===== বেট সেটেল (জয়ী নির্ধারণ) ===== -->
        <form action="/admin/markets/<%= market.id %>/settle" method="POST"
              style="margin-top:12px; border-top:1px solid #333; padding-top:12px;"
              onsubmit="return confirm('নিশ্চিত? জয়ী নির্ধারণ করলে সব বট নিষ্পত্তি হবে এবং কয়েন বিতরণ হবে। এটা ফেরানো যাবে না।');">
          <label style="font-size:13px; display:block; margin-bottom:6px;">জয়ী নির্বাচন করুন:</label>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <select name="winning_runner" required class="form-control" style="flex:1; min-width:150px;">
              <% Object.keys(market.odds || {}).forEach(key => { %>
                <option value="<%= key %>">
                  <% if (key === '0') { %><%= match.teams ? match.teams[0] : 'Team A' %>
                  <% } else if (key === '1') { %><%= match.teams ? match.teams[1] : 'Team B' %>
                  <% } else { %><%= key %><% } %>
                  (<%= market.odds[key] %>x)
                </option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-danger">✅ সেটেল করুন</button>
          </div>
        </form>
      <% } else { %>
        <p style="color:#888; font-size:13px; margin-top:8px;">✔️ এই মার্কেট নিষ্পত্তি হয়ে গেছে।</p>
      <% } %>
    </div>
  <% }) %>

</div>

<%- include('../partials/bottom-nav') %>

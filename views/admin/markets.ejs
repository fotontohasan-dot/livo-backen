<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin/matches" class="flex items-center justify-center w-10 h-10 bg-[#1e2937] hover:bg-[#334155] rounded-2xl text-gray-300">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div>
        <h1 class="text-3xl font-bold text-white"><%= match.team_a %> vs <%= match.team_b %></h1>
        <p class="text-gray-400 text-sm">Manage Markets & Odds • <%= match.sport || 'Cricket' %></p>
      </div>
    </div>

    <!-- Add / Update Market Form -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6 mb-8">
      <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
        <i class="fas fa-plus-circle text-[#f59e0b]"></i>
        <span>Add or Update Market</span>
      </h3>

      <form action="/admin/markets/update" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <input type="hidden" name="match_id" value="<%= match.id %>">

        <div class="md:col-span-1">
          <label class="text-xs text-gray-400 block mb-1">Type</label>
          <input type="text" name="type" placeholder="e.g. match_winner" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>

        <div class="md:col-span-2">
          <label class="text-xs text-gray-400 block mb-1">Market Name / Runner</label>
          <input type="text" name="name" placeholder="e.g. Team A Win" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>

        <div>
          <label class="text-xs text-gray-400 block mb-1">Odds</label>
          <input type="number" step="0.01" name="odds" placeholder="1.85" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>

        <div class="flex items-end">
          <button type="submit" 
                  class="w-full py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl text-sm">
            Save Market
          </button>
        </div>
      </form>
    </div>

    <!-- Markets List -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <div class="px-6 py-4 border-b border-[#334155] flex items-center justify-between">
        <h3 class="font-semibold text-white">Active Markets</h3>
        <span class="text-xs text-gray-400"><%= markets.length %> markets</span>
      </div>

      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">Market</th>
            <th class="text-center px-4 py-4 font-normal">Type</th>
            <th class="text-center px-4 py-4 font-normal">Odds</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% markets.forEach(m => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4 font-medium text-white"><%= m.name %></td>
            <td class="px-4 py-4 text-center">
              <span class="px-3 py-1 text-xs rounded-full bg-[#334155]"><%= m.type %></span>
            </td>
            <td class="px-4 py-4 text-center font-bold text-[#f59e0b]"><%= m.odds %></td>
            <td class="px-4 py-4 text-center">
              <% if(m.status === 'open') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Open</span>
              <% } else if(m.status === 'settled') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-gray-500/20 text-gray-400">Settled</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-500/20 text-yellow-400"><%= m.status %></span>
              <% } %>
            </td>
            <td class="px-6 py-4">
              <div class="flex justify-center gap-2">
                <!-- Toggle Status -->
                <form action="/admin/markets/<%= m.id %>/toggle" method="POST">
                  <input type="hidden" name="status" value="<%= m.status === 'open' ? 'suspended' : 'open' %>">
                  <button type="submit" class="px-3 py-1.5 text-xs rounded-xl <%= m.status === 'open' ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-emerald-600 hover:bg-emerald-700' %> text-white">
                    <%= m.status === 'open' ? 'Suspend' : 'Open' %>
                  </button>
                </form>

                <!-- Settle -->
                <% if(m.status === 'open') { %>
                  <button onclick="showSettleModal(<%= m.id %>, '<%= m.name %>')" 
                          class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs rounded-xl">
                    Settle
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (markets.length === 0) { %>
      <div class="text-center py-12 text-gray-500">
        No markets created yet for this match.
      </div>
    <% } %>

  </main>
</div>

<!-- Settle Market Modal -->
<div id="settle-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
  <div class="bg-[#1e2937] rounded-3xl p-8 w-full max-w-md border border-[#334155]">
    <h3 class="text-xl font-bold text-white mb-2">Settle Market</h3>
    <p id="settle-market-name" class="text-gray-400 text-sm mb-6"></p>

    <form id="settle-form" method="POST">
      <input type="hidden" name="winning_runner" id="winning-runner-input">

      <div class="mb-6">
        <label class="text-sm text-gray-400 block mb-2">Winning Runner / Result</label>
        <input type="text" id="winning-runner-text" required
               class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
      </div>

      <div class="flex gap-3">
        <button type="button" onclick="hideSettleModal()" 
                class="flex-1 py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm">Cancel</button>
        <button type="submit" 
                class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl">Settle Market</button>
      </div>
    </form>
  </div>
</div>

<script>
  function showSettleModal(marketId, marketName) {
    document.getElementById('settle-modal').classList.remove('hidden');
    document.getElementById('settle-market-name').innerText = marketName;
    document.getElementById('settle-form').action = `/admin/markets/${marketId}/settle`;
  }

  function hideSettleModal() {
    document.getElementById('settle-modal').classList.add('hidden');
  }
</script>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= match ? match.team_a + ' vs ' + match.team_b : 'Markets' %> • Livo Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <%- include('./partials/pwa-head') %>
</head>
<body class="bg-[#0f172a]">
<div class="admin-wrap">
  <%- include('./partials/sidebar', { active: 'matches' }) %>
  <div class="admin-content">
    <%- include('./partials/load-error') %>
  <%- include('./partials/header', {
    pageTitle: match ? (match.team_a + ' vs ' + match.team_b) : 'মার্কেট',
    pageSubtitle: match ? (match.sport || 'Cricket') : 'বেটিং মার্কেট পরিচালনা করুন'
  }) %>

  <main class="flex-1">
    <!-- Back + Actions -->
    <div class="flex items-center justify-between mb-6">
      <a href="/admin/matches" 
         class="flex items-center justify-center w-10 h-10 bg-[#1e2937] hover:bg-[#334155] border border-[#475569] rounded-2xl text-gray-400 hover:text-white transition-all">
        <i class="fas fa-arrow-left"></i>
      </a>
      <button onclick="exportMarketsCSV()" 
              class="px-4 py-2.5 bg-[#334155] hover:bg-[#475569] text-white text-sm font-medium rounded-2xl flex items-center gap-2 transition-all">
        <i class="fas fa-download"></i>
        <span>Export</span>
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-400 text-sm">Total Markets</p>
            <p class="text-3xl font-bold text-white mt-1"><%= markets ? markets.length : 0 %></p>
          </div>
          <i class="fas fa-chart-line text-[#f59e0b] text-3xl mt-1"></i>
        </div>
      </div>
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-400 text-sm">Open Markets</p>
            <p class="text-3xl font-bold text-emerald-400 mt-1"><%= markets ? markets.filter(m => m.status === 'open').length : 0 %></p>
          </div>
          <i class="fas fa-unlock text-emerald-400 text-3xl mt-1"></i>
        </div>
      </div>
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-400 text-sm">Settled</p>
            <p class="text-3xl font-bold text-gray-400 mt-1"><%= markets ? markets.filter(m => m.status === 'settled').length : 0 %></p>
          </div>
          <i class="fas fa-check-double text-gray-400 text-3xl mt-1"></i>
        </div>
      </div>
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-400 text-sm">Suspended</p>
            <p class="text-3xl font-bold text-orange-400 mt-1"><%= markets ? markets.filter(m => m.status === 'suspended').length : 0 %></p>
          </div>
          <i class="fas fa-pause-circle text-orange-400 text-3xl mt-1"></i>
        </div>
      </div>
    </div>

    <!-- Add / Update Market Form -->
    <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-6 mb-6">
      <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
        <i class="fas fa-plus-circle text-[#f59e0b]"></i> Create or Update Market
      </h3>
      
      <form action="/admin/markets/update" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <input type="hidden" name="match_id" value="<%= match ? match.id : '' %>">
        
        <div class="md:col-span-1">
          <label class="text-xs text-gray-400 block mb-1.5">Market Type</label>
          <input type="text" name="type" placeholder="match_winner" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-400 block mb-1.5">Market Name / Runner</label>
          <input type="text" name="name" placeholder="Team A Win" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>
        <div>
          <label class="text-xs text-gray-400 block mb-1.5">Odds</label>
          <input type="number" step="0.01" name="odds" placeholder="1.85" required 
                 class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm text-white">
        </div>
        <div class="flex items-end">
          <button type="submit" 
                  class="w-full py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl text-sm transition-all active:scale-[0.985]">
            Save Market
          </button>
        </div>
      </form>
    </div>

    <!-- Markets Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <div class="px-6 py-4 border-b border-[#334155] flex items-center justify-between">
        <h3 class="font-semibold text-white">Active Markets</h3>
        <span class="text-xs px-3 py-1 bg-[#334155] rounded-full text-gray-400"><%= markets ? markets.length : 0 %> total</span>
      </div>
      
      <table class="w-full text-sm" id="marketsTable">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">Market / Runner</th>
            <th class="text-center px-4 py-4 font-normal">Type</th>
            <th class="text-center px-4 py-4 font-normal">Odds</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% if (markets && markets.length > 0) { %>
            <% markets.forEach(m => { %>
            <tr class="hover:bg-[#0f172a] transition-colors">
              <td class="px-6 py-4">
                <div class="font-medium text-white"><%= m.name %></div>
              </td>
              <td class="px-4 py-4 text-center">
                <span class="px-3 py-1 text-xs rounded-full bg-[#334155]"><%= m.type %></span>
              </td>
              <td class="px-4 py-4 text-center">
                <span class="font-mono text-lg font-semibold text-[#f59e0b]"><%= m.odds %></span>
              </td>
              <td class="px-4 py-4 text-center">
                <% if(m.status === 'open') { %>
                  <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400 font-medium">Open</span>
                <% } else if(m.status === 'settled') { %>
                  <span class="px-3 py-1 text-xs rounded-full bg-gray-500/20 text-gray-400 font-medium">Settled</span>
                <% } else { %>
                  <span class="px-3 py-1 text-xs rounded-full bg-orange-500/20 text-orange-400 font-medium">Suspended</span>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <div class="flex justify-center gap-2">
                  <form action="/admin/markets/<%= m.id %>/toggle" method="POST">
                    <button type="submit" class="px-3 py-1.5 bg-[#334155] hover:bg-[#475569] rounded-xl text-xs transition-all">
                      <%= m.status === 'open' ? 'Suspend' : 'Open' %>
                    </button>
                  </form>
                  
                  <% if(m.status === 'open') { %>
                  <button onclick="showSettleModal('<%= m.id %>', '<%= m.name %>')" 
                          class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 rounded-xl text-xs text-white transition-all flex items-center gap-1">
                    <i class="fas fa-check"></i>
                    <span>Settle</span>
                  </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                <i class="fas fa-inbox text-4xl mb-3 block"></i>
                No markets created yet for this match.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Settle Market Modal -->
    <div id="settle-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
      <div class="bg-[#1e2937] rounded-3xl p-8 w-full max-w-md border border-[#334155]">
        <h3 class="text-xl font-bold text-white mb-2">Settle Market</h3>
        <p id="settle-market-name" class="text-gray-400 mb-6 text-sm"></p>
        
        <form id="settle-form" method="POST">
          <div class="mb-5">
            <label class="text-sm text-gray-400 block mb-1.5">Winning Runner / Result</label>
            <input type="text" name="result" required placeholder="e.g. Team A" 
                   class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
          </div>
          
          <div class="flex gap-3">
            <button type="button" onclick="hideSettleModal()" 
                    class="flex-1 py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium transition-all">Cancel</button>
            <button type="submit" 
                    class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl transition-all">Settle &amp; Payout</button>
          </div>
        </form>
      </div>
    </div>

<script>
function showSettleModal(marketId, marketName) {
  document.getElementById('settle-modal').classList.remove('hidden');
  document.getElementById('settle-market-name').innerText = marketName;
  const form = document.getElementById('settle-form');
  form.action = `/admin/markets/${marketId}/settle`;
}

function hideSettleModal() {
  document.getElementById('settle-modal').classList.add('hidden');
}

function exportMarketsCSV() {
  const table = document.getElementById('marketsTable');
  let csv = [];
  const rows = table.querySelectorAll('tr');
  
  rows.forEach((row, index) => {
    if (index === 0 || row.style.display === 'none') return; // skip header if needed
    const cols = row.querySelectorAll('td, th');
    let rowData = [];
    cols.forEach(col => rowData.push('"' + col.innerText.replace(/"/g, '""') + '"'));
    csv.push(rowData.join(','));
  });

  const csvContent = csv.join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'markets_export.csv';
  link.click();
}
</script>
  </main>
  </div>
</div>
</body>
</html>

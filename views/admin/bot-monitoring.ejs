<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
const riskColor = { high: '#ef4444', medium: '#f59e0b', low: '#64748b' };
const riskMap = {};
byRisk.forEach(r => { riskMap[r.risk_level] = parseInt(r.cnt); });
%>
<%- include('partials/admin-layout', {
    title: 'Bot Monitoring',
    active: 'bot-monitoring',
    body: `
<div class="max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div>
      <h1 class="text-xl font-bold text-slate-800">🤖 Bot Monitoring Dashboard</h1>
      <p class="text-sm text-slate-500">Registration, Login, Forgot Password, Support Chat ও Public API-তে বট/স্ক্রিপ্টেড কার্যকলাপ নজরদারি</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/bot-logs" class="px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-semibold"><i class="fas fa-list"></i> সব লগ দেখুন</a>
      <a href="/admin/bot-monitoring/ip-rules" class="px-4 py-2 bg-amber-500 text-white rounded-xl text-sm font-semibold"><i class="fas fa-shield-halved"></i> IP Block/Whitelist</a>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">আজকের মোট ডিটেকশন</p>
      <p class="text-2xl font-bold text-slate-800 mt-1">${statsToday.total || 0}</p>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">আজকে ব্লক করা হয়েছে</p>
      <p class="text-2xl font-bold text-red-500 mt-1">${statsToday.blocked || 0}</p>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">ব্লকলিস্টেড IP</p>
      <p class="text-2xl font-bold text-slate-800 mt-1">${ipRuleCounts.blocked_ips || 0}</p>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">হোয়াইটলিস্টেড IP</p>
      <p class="text-2xl font-bold text-emerald-600 mt-1">${ipRuleCounts.whitelisted_ips || 0}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-sm font-bold text-slate-700 mb-3">রিস্ক লেভেল (গত ৭ দিন)</p>
      <div class="flex gap-4">
        <div><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#ef4444"></span> High: <b>${riskMap.high || 0}</b></div>
        <div><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#f59e0b"></span> Medium: <b>${riskMap.medium || 0}</b></div>
        <div><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#64748b"></span> Low: <b>${riskMap.low || 0}</b></div>
      </div>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
      <p class="text-sm font-bold text-slate-700 mb-3">এন্ডপয়েন্ট অনুযায়ী (গত ৭ দিন)</p>
      ${byEndpoint.map(e => `<div class="flex justify-between text-sm py-1 border-b border-slate-50"><span>${escapeHtml(e.endpoint)}</span><b>${e.cnt}</b></div>`).join('') || '<p class="text-slate-400 text-sm">কোনো ডেটা নেই</p>'}
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-x-auto">
    <div class="p-4 border-b border-slate-100 font-bold text-slate-700 text-sm">সাম্প্রতিক ২০টা ডিটেকশন</div>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase">
        <th class="p-3">সময়</th><th class="p-3">IP</th><th class="p-3">এন্ডপয়েন্ট</th><th class="p-3">রিস্ক</th><th class="p-3">কারণ</th><th class="p-3">ব্লকড</th>
      </tr></thead>
      <tbody>
        ${recentLogs.map(l => `
          <tr class="border-t border-slate-50">
            <td class="p-3 text-slate-500 whitespace-nowrap">${new Date(l.created_at).toLocaleString('en-US', { timeZone: 'Asia/Dhaka' })}</td>
            <td class="p-3 font-mono">${escapeHtml(l.ip)}</td>
            <td class="p-3">${escapeHtml(l.endpoint)}</td>
            <td class="p-3"><span style="color:${riskColor[l.risk_level] || '#64748b'};font-weight:700;">${escapeHtml(l.risk_level || '-')}</span></td>
            <td class="p-3 text-slate-500 max-w-xs truncate" title="${escapeHtml(l.reason)}">${escapeHtml((l.reason || '').slice(0, 60))}</td>
            <td class="p-3">${l.blocked ? '<span class="text-red-500 font-bold">হ্যাঁ</span>' : '<span class="text-slate-400">না</span>'}</td>
          </tr>
        `).join('') || '<tr><td colspan="6" class="p-6 text-center text-slate-400">কোনো ডিটেকশন নেই</td></tr>'}
      </tbody>
    </table>
  </div>
</div>
`
}) %>

<%
function esc(s) { return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
const f = { category: selectedCategory||'all', provider: selectedProvider||'all', badge: selectedBadge||'all', status: selectedStatus||'all' };
function qstr(o) {
  const m = Object.assign({category:f.category,provider:f.provider,badge:f.badge,status:f.status,q:searchQ||''},o);
  return Object.entries(m).map(([k,v])=>k+'='+encodeURIComponent(v||'')).join('&');
}
const catLabels = {all:t('adg_all'),hot:'🔥 Hot',slots:'🎰 Slots',live:'📹 Live',sports:'⚽ Sports',poker:'♠️ Poker',casino:'🎲 Casino',fishing:'🎣 Fishing',table:'🃏 Table'};
function fieldRow(id, label, tag, opts) {
  return '<div><label class="block text-xs font-semibold text-slate-500 mb-1">'+label+'</label>'+tag+'</div>';
}
%>
<%- include('partials/admin-layout', {
  title: 'Games Management',
  active: 'games',
  body: `
<div class="max-w-7xl mx-auto">

  ${(success||[]).map(m=>'<div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-2xl text-sm">'+esc(m)+'</div>').join('')}
  ${(error||[]).map(m=>'<div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-2xl text-sm">'+esc(m)+'</div>').join('')}

  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Games Management</h1>
      <p class="text-slate-500 text-sm mt-0.5">${t('adg_summary').replace('{total}', totalGames).replace('{active}', activeGames).replace('{inactive}', totalGames-activeGames)}</p>
    </div>
    <button data-modal-open="addModal" aria-label="${t('adg_add_game')}" title="${t('adg_add_game')}"
      class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-sm font-semibold flex items-center gap-2">
      <i class="fas fa-plus"></i> ${t('adg_add_game')}
    </button>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    ${[{l:t('adg_total_games'),v:totalGames,c:'slate'},{l:t('adg_active'),v:activeGames,c:'emerald'},{l:t('adg_inactive'),v:totalGames-activeGames,c:'red'},{l:t('adg_this_page'),v:games.length,c:'blue'}].map(k=>'<div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-4 text-center"><p class="text-xs text-slate-500 mb-1">'+k.l+'</p><p class="text-2xl font-bold text-'+k.c+'-600">'+k.v+'</p></div>').join('')}
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1 mb-4">
    ${Object.entries(catLabels).map(([c,l])=>'<a href="/admin/games?'+qstr({category:c,page:1})+'" class="flex-shrink-0 px-4 py-2 rounded-2xl text-sm font-semibold border transition '+(f.category===c?'bg-indigo-600 text-white border-indigo-600':'bg-white border-slate-200 text-slate-600 hover:bg-slate-50')+'">'+l+'</a>').join('')}
  </div>

  <form method="GET" action="/admin/games" class="flex flex-wrap gap-3 mb-5">
    <input type="hidden" name="category" value="${esc(f.category)}">
    <input type="text" name="q" value="${esc(searchQ||'')}" placeholder="${t('adg_search_placeholder')}"
      class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm flex-1 min-w-40 outline-none focus:border-indigo-300">
    <select name="status" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
      <option value="all" ${f.status==='all'?'selected':''}>${t('adg_all_status')}</option>
      <option value="active" ${f.status==='active'?'selected':''}>${t('adg_active')}</option>
      <option value="inactive" ${f.status==='inactive'?'selected':''}>${t('adg_inactive')}</option>
    </select>
    <select name="badge" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
      <option value="all" ${f.badge==='all'?'selected':''}>${t('adg_all_badges')}</option>
      <option value="hot" ${f.badge==='hot'?'selected':''}>🔥 Hot</option>
      <option value="pop" ${f.badge==='pop'?'selected':''}>⭐ Popular</option>
      <option value="new" ${f.badge==='new'?'selected':''}>✨ New</option>
    </select>
    <button type="submit" class="px-5 py-2.5 bg-slate-800 text-white rounded-2xl text-sm font-semibold">${t('adg_filter')}</button>
    <a href="/admin/games" class="px-4 py-2.5 bg-slate-100 text-slate-600 rounded-2xl text-sm font-medium">${t('adg_reset')}</a>
  </form>

  <form method="POST" action="/admin/games/bulk-toggle" id="bulkForm">
    <input type="hidden" name="action" id="bulkAction" value="">
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-x-auto mb-4">
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 bg-slate-50">
        <span class="text-sm text-slate-500">${t('adg_results').replace('{total}', '<strong>' + total + '</strong>').replace('{page}', page).replace('{pages}', totalPages)}</span>
        <div class="flex gap-2">
          <button type="button" data-bulk-action="activate" class="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-semibold">✅ ${t('adg_active')}</button>
          <button type="button" data-bulk-action="deactivate" class="px-3 py-1.5 bg-red-400 hover:bg-red-500 text-white rounded-xl text-xs font-semibold">❌ ${t('adg_inactive')}</button>
        </div>
      </div>
      <table class="w-full text-sm">
        <thead><tr class="bg-slate-50 text-left">
          <th class="px-4 py-3"><input type="checkbox" id="selectAll" data-toggle-all></th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_icon')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_name')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_category')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_provider')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_badge')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase">${t('adg_col_status')}</th>
          <th class="px-4 py-3 text-slate-500 font-medium text-xs uppercase text-center">${t('adg_col_action')}</th>
        </tr></thead>
        <tbody class="divide-y divide-slate-100">
          ${(() => { const L_EDIT = esc(t('admin_ui_edit')); const L_DELETE = esc(t('admin_ui_delete')); return games.length ? games.map(g => {
            const bc = g.badge==='hot'?'bg-red-100 text-red-700':g.badge==='pop'?'bg-amber-100 text-amber-700':g.badge==='new'?'bg-blue-100 text-blue-700':'bg-slate-100 text-slate-500';
            return '<tr class="hover:bg-slate-50">'+
              '<td class="px-4 py-3"><input type="checkbox" name="ids" value="'+g.id+'" class="row-check"></td>'+
              '<td class="px-4 py-3 text-xl">'+esc(g.emoji||'🎮')+'</td>'+
              '<td class="px-4 py-3"><p class="font-medium text-slate-800">'+esc(g.name)+'</p><p class="text-xs text-slate-400">'+esc(g.slug)+'</p></td>'+
              '<td class="px-4 py-3 text-slate-600">'+esc(g.category)+'</td>'+
              '<td class="px-4 py-3 text-slate-600">'+esc(g.provider||'-')+'</td>'+
              '<td class="px-4 py-3">'+(g.badge?'<span class="px-2.5 py-1 text-xs font-bold rounded-full '+bc+'">'+g.badge+'</span>':'<span class="text-slate-300">-</span>')+'</td>'+
              '<td class="px-4 py-3"><form method="POST" action="/admin/games/'+g.id+'/toggle"><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" data-auto-submit '+(g.is_active?'checked':'')+' class="sr-only peer"><div class="w-9 h-5 bg-slate-200 peer-checked:bg-emerald-500 rounded-full peer peer-checked:after:translate-x-4 after:content-[\'\'] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all"></div></label></form></td>'+
              '<td class="px-4 py-3"><div class="flex items-center justify-center gap-1.5">'+
                '<button type="button" data-edit-game="'+g.id+'" aria-label="'+L_EDIT+'" title="'+L_EDIT+'" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold"><i class="fas fa-pen"></i></button>'+
                '<form method="POST" action="/admin/games/'+g.id+'/delete" data-confirm="' + t("adg_delete_confirm") + '"><button type="submit" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-xl text-xs font-semibold" aria-label="'+L_DELETE+'" title="'+L_DELETE+'"><i class="fas fa-trash"></i></button></form>'+
              '</div></td>'+
            '</tr>';
          }).join('') : '<tr><td colspan="8" class="px-6 py-10 text-center text-slate-400">' + t("adg_no_games") + '</td></tr>'; })()}
        </tbody>
      </table>
    </div>
  </form>

  <div class="flex justify-center gap-3 items-center">
    ${page>1?'<a href="/admin/games?'+qstr({page:page-1})+'" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium hover:bg-slate-50">← ' + t("adg_prev") + '</a>':''}
    <span class="text-sm text-slate-500">${t('adg_page_x_of_y').replace('{page}', page).replace('{pages}', totalPages)}</span>
    ${page<totalPages?'<a href="/admin/games?'+qstr({page:page+1})+'" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium hover:bg-slate-50">' + t("adg_next") + ' →</a>':''}
  </div>
</div>

<!-- Add Modal -->
<div id="addModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md max-h-screen overflow-y-auto">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <h3 class="font-semibold text-slate-800">${t('adg_add_heading')}</h3>
      <button data-modal-close="addModal" aria-label="${t('adg_close')}" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>
    <form method="POST" action="/admin/games/add" class="p-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2"><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_game_name')}</label><input name="name" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
        <div class="col-span-2"><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_slug_auto')}</label><input name="slug" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300" placeholder="provider-slug:game-id"></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_emoji')}</label><input name="emoji" value="🎮" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_badge')}</label><select name="badge" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="">নেই</option><option value="hot">🔥 Hot</option><option value="pop">⭐ Popular</option><option value="new">✨ New</option></select></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_category_req')}</label><select name="category" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="slots">Slots</option><option value="live">Live</option><option value="sports">Sports</option><option value="poker">Poker</option><option value="casino">Casino</option><option value="fishing">Fishing</option><option value="table">Table</option></select></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_provider_req')}</label><input name="provider" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300" placeholder="Jili"></div>
      </div>
      <div class="flex gap-3 justify-end pt-2">
        <button type="button" data-modal-close="addModal" class="px-5 py-2.5 bg-slate-100 text-slate-600 rounded-2xl text-sm font-semibold">${t('adg_cancel')}</button>
        <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-sm font-semibold">${t('adg_add')}</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md max-h-screen overflow-y-auto">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <h3 class="font-semibold text-slate-800" id="editTitle">${t('adg_edit_heading')}</h3>
      <button data-modal-close="editModal" aria-label="${t('adg_close')}" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>
    <form method="POST" id="editForm" action="#" class="p-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2"><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_game_name')}</label><input id="e_name" name="name" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
        <div class="col-span-2"><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_slug')}</label><input id="e_slug" name="slug" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_emoji')}</label><input id="e_emoji" name="emoji" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_badge')}</label><select id="e_badge" name="badge" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="">নেই</option><option value="hot">🔥 Hot</option><option value="pop">⭐ Popular</option><option value="new">✨ New</option></select></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_category_req')}</label><select id="e_category" name="category" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="slots">Slots</option><option value="live">Live</option><option value="sports">Sports</option><option value="poker">Poker</option><option value="casino">Casino</option><option value="fishing">Fishing</option><option value="table">Table</option></select></div>
        <div><label class="block text-xs font-semibold text-slate-500 mb-1">${t('adg_provider_req')}</label><input id="e_provider" name="provider" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm outline-none focus:border-indigo-300"></div>
      </div>
      <div class="flex gap-3 justify-end pt-2">
        <button type="button" data-modal-close="editModal" class="px-5 py-2.5 bg-slate-100 text-slate-600 rounded-2xl text-sm font-semibold">${t('adg_cancel')}</button>
        <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-sm font-semibold">${t('adg_save')}</button>
      </div>
    </form>
  </div>
</div>

<script type="application/json" id="gamesData">${jsonScriptSafe(games.map(g => ({
  id: g.id, name: g.name, slug: g.slug, emoji: g.emoji || '🎮',
  category: g.category, provider: g.provider || '', badge: g.badge || ''
})))}</script>
<script src="/js/admin-games.js"></script>

`
}) %>

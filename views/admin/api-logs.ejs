<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmtDate(d) { return d ? new Date(d).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '-'; }
function statusBadge(code) {
  if (code >= 200 && code < 300) return '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-700">' + code + '</span>';
  if (code >= 400) return '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-700">' + code + '</span>';
  return '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-slate-100 text-slate-600">' + (code || '-') + '</span>';
}
function logRow(l) {
  return '<tr class="hover:bg-slate-50 align-top">' +
    '<td class="px-6 py-4 text-xs text-slate-400">#' + l.id + '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-400">' + fmtDate(l.created_at) + '</td>' +
    '<td class="px-6 py-4"><span class="px-2 py-0.5 text-xs font-bold rounded bg-indigo-50 text-indigo-600 border border-indigo-200">' + escapeHtml(l.method) + '</span></td>' +
    '<td class="px-6 py-4 text-xs font-mono text-slate-600 max-w-xs truncate" title="' + escapeHtml(l.endpoint) + '">' + escapeHtml(l.endpoint) + '</td>' +
    '<td class="px-6 py-4">' + statusBadge(l.status_code) + '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-500">' + (l.response_time_ms != null ? l.response_time_ms + 'ms' : '-') + '</td>' +
    '<td class="px-6 py-4 text-xs font-mono text-slate-500">' + escapeHtml(l.ip || '-') + '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-500">' + escapeHtml(l.username || (l.user_id ? '#' + l.user_id : '-')) + '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-500">' + escapeHtml(l.api_key_name || (l.api_key_id ? '#' + l.api_key_id : '-')) + '</td>' +
  '</tr>';
}
const rows = (logs || []).map(logRow).join('') || '<tr><td colspan="9" class="px-6 py-10 text-center text-slate-400">কোনো API রিকোয়েস্ট লগ পাওয়া যায়নি</td></tr>';
const f = filters || {};
const a = analytics || { total_requests: 0, success_count: 0, error_count: 0, avg_response_ms: 0, max_response_ms: 0 };
const qsString = Object.keys(f).map(k => k + '=' + encodeURIComponent(f[k] || '')).join('&');
const topKeysHtml = (topKeys || []).map(k => '<div class="flex justify-between text-sm py-1.5 border-b border-slate-100"><span class="text-slate-600">' + escapeHtml(k.name) + '</span><span class="font-semibold text-slate-800">' + k.request_count + '</span></div>').join('') || '<div class="text-xs text-slate-400 py-2">কোনো ডেটা নেই</div>';
%>
<%- include('partials/admin-layout', {
    title: 'API Usage Logs',
    active: 'api-logs',
    body: `
<div class="max-w-7xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-slate-900">API Usage Logs & Analytics</h1>
        <p class="text-slate-500 mt-1 text-sm">মোট ${total || 0}টি রিকোয়েস্ট লগ হয়েছে</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Total Requests</div><div class="text-2xl font-bold text-slate-700 mt-1">${a.total_requests || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Success (2xx)</div><div class="text-2xl font-bold text-emerald-600 mt-1">${a.success_count || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Errors (4xx+)</div><div class="text-2xl font-bold text-red-600 mt-1">${a.error_count || 0}</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Avg Response</div><div class="text-2xl font-bold text-slate-700 mt-1">${Math.round(a.avg_response_ms || 0)}ms</div></div>
        <div class="bg-white rounded-2xl border border-slate-100 p-5"><div class="text-xs text-slate-400 uppercase font-medium">Max Response</div><div class="text-2xl font-bold text-slate-700 mt-1">${a.max_response_ms || 0}ms</div></div>
    </div>

    <div class="bg-white rounded-3xl border border-slate-100 p-6">
        <h3 class="font-semibold text-slate-800 mb-2 text-sm"><i class="fas fa-key text-indigo-500 mr-2"></i>Top API Keys (এই ফিল্টারে)</h3>
        ${topKeysHtml}
    </div>

    <form method="GET" action="/admin/api-logs" class="flex flex-wrap gap-3">
        <input type="text" name="endpoint" value="${escapeHtml(f.endpoint || '')}" placeholder="Endpoint সার্চ" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm w-40">
        <select name="method" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <option value="">সব Method</option>
            <option value="GET" ${f.method === 'GET' ? 'selected' : ''}>GET</option>
            <option value="POST" ${f.method === 'POST' ? 'selected' : ''}>POST</option>
            <option value="PUT" ${f.method === 'PUT' ? 'selected' : ''}>PUT</option>
            <option value="DELETE" ${f.method === 'DELETE' ? 'selected' : ''}>DELETE</option>
        </select>
        <input type="number" name="status" value="${escapeHtml(f.status || '')}" placeholder="Status" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm w-24">
        <input type="text" name="ip" value="${escapeHtml(f.ip || '')}" placeholder="IP" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm w-36">
        <select name="api_key_id" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <option value="">সব API Key</option>
            ${(apiKeys || []).map(k => '<option value="' + k.id + '" ' + (f.api_key_id == k.id ? 'selected' : '') + '>' + escapeHtml(k.name) + '</option>').join('')}
        </select>
        <input type="date" name="from" value="${escapeHtml(f.from || '')}" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        <input type="date" name="to" value="${escapeHtml(f.to || '')}" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-2xl text-sm font-semibold">ফিল্টার</button>
        <a href="/admin/api-logs/export.csv?${qsString}" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-2xl text-sm font-semibold"><i class="fas fa-download mr-1"></i>CSV Export</a>
    </form>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-x-auto modern-table">
        <table class="w-full text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">ID</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Time</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Method</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Endpoint</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Status</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">Time</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">IP</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">User</th>
                    <th class="px-6 py-4 text-left font-medium text-slate-500 uppercase text-xs">API Key</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">${rows}</tbody>
        </table>
    </div>

    <div class="flex justify-center gap-3">
        ${page > 1 ? '<a href="/admin/api-logs?page=' + (page - 1) + '&' + qsString + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">← আগের পেজ</a>' : ''}
        <span class="px-4 py-2 text-sm text-slate-500">পেজ ${page} / ${totalPages}</span>
        ${page < totalPages ? '<a href="/admin/api-logs?page=' + (page + 1) + '&' + qsString + '" class="px-4 py-2 bg-white border rounded-xl text-sm font-medium">পরের পেজ →</a>' : ''}
    </div>
</div>
`
}) %>

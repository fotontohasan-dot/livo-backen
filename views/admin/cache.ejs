<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const s = cacheStats || {};
const categoryRows = (s.categories || []).map(c =>
  '<tr class="border-b border-slate-100">' +
    '<td class="px-6 py-3 text-sm text-slate-700">' + escapeHtml(c.label) + '<div class="text-xs text-slate-400 font-mono">' + escapeHtml(c.pattern) + '</div></td>' +
    '<td class="px-6 py-3 text-sm font-semibold text-slate-900">' + c.count + '</td>' +
    '<td class="px-6 py-3 text-right">' +
      '<form method="POST" action="/admin/cache/clear" onsubmit="return confirm(\'এই ক্যাটাগরির ক্যাশ পরিষ্কার করবেন?\')" style="display:inline">' +
        '<input type="hidden" name="pattern" value="' + escapeHtml(c.pattern) + '">' +
        '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-red-50 text-red-600 hover:bg-red-100">Clear</button>' +
      '</form>' +
    '</td>' +
  '</tr>'
).join('') || '<tr><td colspan="3" class="px-6 py-8 text-center text-slate-400">কোনো ক্যাশড ডেটা নেই</td></tr>';
%>
<%- include('partials/admin-layout', {
    title: 'Cache Management',
    active: 'cache',
    body: `
<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Redis Cache Management</h1>
            <p class="text-slate-500 mt-1 text-sm">Frequently-used ডেটা (Settings, Matches/Odds, Leaderboard, Profile) ক্যাশ স্ট্যাটাস ও ম্যানেজমেন্ট</p>
        </div>
        ${cleared ? '<span class="px-4 py-2 bg-emerald-50 text-emerald-700 rounded-2xl text-sm font-semibold"><i class="fas fa-check-circle"></i> ' + cleared + ' টি কী পরিষ্কার হয়েছে</span>' : ''}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Redis Status</p>
            <p class="mt-2 text-lg font-bold ${s.connected ? 'text-emerald-600' : 'text-red-500'}">
                <i class="fas fa-circle text-xs"></i> ${s.connected ? 'Connected' : (s.enabled ? 'Disconnected' : 'Disabled')}
            </p>
            <p class="text-xs text-slate-400 mt-1">${escapeHtml(s.host || '-')}</p>
        </div>
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Total Cached Keys</p>
            <p class="mt-2 text-2xl font-bold text-slate-900">${s.totalKeys || 0}</p>
            <p class="text-xs text-slate-400 mt-1">Memory: ${escapeHtml(s.memoryUsed || 'N/A')}</p>
        </div>
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Hit Rate</p>
            <p class="mt-2 text-2xl font-bold text-blue-600">${s.hitRatePercent !== null && s.hitRatePercent !== undefined ? s.hitRatePercent + '%' : 'N/A'}</p>
            <p class="text-xs text-slate-400 mt-1">${s.hits || 0} hits / ${s.misses || 0} misses (এই প্রসেস চালু হওয়ার পর থেকে)</p>
        </div>
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Total Writes</p>
            <p class="mt-2 text-2xl font-bold text-slate-900">${s.sets || 0}</p>
            ${!s.connected ? '<p class="text-xs text-amber-600 mt-1"><i class="fas fa-triangle-exclamation"></i> Fallback: সরাসরি DB থেকে সার্ভ হচ্ছে</p>' : ''}
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Cache Categories</h2>
            <form method="POST" action="/admin/cache/clear" onsubmit="return confirm('সমস্ত ক্যাশ (এই অ্যাপের) পরিষ্কার করবেন? এতে সাময়িকভাবে ডাটাবেজে লোড বাড়তে পারে।')">
                <input type="hidden" name="pattern" value="*">
                <button type="submit" class="px-4 py-2 text-sm font-semibold rounded-2xl bg-red-600 text-white hover:bg-red-700"><i class="fas fa-trash"></i> Clear All Cache</button>
            </form>
        </div>
        <table class="w-full">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Category</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Keys</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Action</th>
                </tr>
            </thead>
            <tbody>${categoryRows}</tbody>
        </table>
    </div>

    <div class="bg-slate-50 border border-slate-100 rounded-3xl p-5 text-sm text-slate-500">
        <p class="font-semibold text-slate-700 mb-2">TTL / Refresh Strategy (কোড থেকে):</p>
        <ul class="list-disc list-inside space-y-1">
            <li>ম্যাচ/অডস (match:detail:*) — ৮ সেকেন্ড TTL + অ্যাডমিন মার্কেট আপডেট/সেটেল করলে সাথে সাথে invalidate</li>
            <li>সাইট সেটিংস — ৩০ সেকেন্ড TTL + সেটিংস সেভ করলে সাথে সাথে invalidate</li>
            <li>লিডারবোর্ড — ৪৫ সেকেন্ড TTL (স্বয়ংক্রিয় expire)</li>
            <li>প্রোফাইল অ্যাক্টিভিটি — ১৫ সেকেন্ড TTL (কয়েন ব্যালেন্স কখনো ক্যাশ হয় না, সবসময় সরাসরি DB থেকে)</li>
            <li>Redis ডাউন থাকলে সব ফিচার সরাসরি ডাটাবেজ থেকে কাজ করে — কখনো ভাঙে না (graceful fallback)</li>
        </ul>
    </div>
</div>
`
}) %>

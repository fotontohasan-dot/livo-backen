<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Promotions</h1>
        <p class="text-gray-400 text-sm mt-1">Manage homepage banners & promotional content</p>
      </div>
      <button onclick="document.getElementById('add-promo-modal').classList.remove('hidden')" 
              class="px-5 py-2.5 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl flex items-center gap-2 text-sm transition-all">
        <i class="fas fa-plus"></i>
        <span>Add Promotion</span>
      </button>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Total Promotions</p>
            <p class="text-3xl font-bold text-white mt-1" id="stat-total"><%= promotions.length %></p>
          </div>
          <div class="w-12 h-12 bg-blue-500/10 rounded-2xl flex items-center justify-center">
            <i class="fas fa-bullhorn text-blue-400 text-2xl"></i>
          </div>
        </div>
      </div>
      
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Active</p>
            <p class="text-3xl font-bold text-emerald-400 mt-1" id="stat-active">
              <%= promotions.filter(p => p.active).length %>
            </p>
          </div>
          <div class="w-12 h-12 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
            <i class="fas fa-check-circle text-emerald-400 text-2xl"></i>
          </div>
        </div>
      </div>
      
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Inactive</p>
            <p class="text-3xl font-bold text-gray-400 mt-1" id="stat-inactive">
              <%= promotions.filter(p => !p.active).length %>
            </p>
          </div>
          <div class="w-12 h-12 bg-gray-500/10 rounded-2xl flex items-center justify-center">
            <i class="fas fa-pause-circle text-gray-400 text-2xl"></i>
          </div>
        </div>
      </div>
      
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">With Link</p>
            <p class="text-3xl font-bold text-amber-400 mt-1" id="stat-linked">
              <%= promotions.filter(p => p.link_url && p.link_url.length > 0).length %>
            </p>
          </div>
          <div class="w-12 h-12 bg-amber-500/10 rounded-2xl flex items-center justify-center">
            <i class="fas fa-link text-amber-400 text-2xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex flex-col md:flex-row gap-3 mb-6">
      <div class="flex-1 relative">
        <input type="text" id="search-input" placeholder="Search by title..." 
               class="w-full bg-[#1e2937] border border-[#334155] rounded-2xl pl-11 pr-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-[#f59e0b]">
        <i class="fas fa-search absolute left-4 top-4 text-gray-500"></i>
      </div>
      
      <select id="status-filter" class="bg-[#1e2937] border border-[#334155] rounded-2xl px-4 py-3 text-white focus:outline-none focus:border-[#f59e0b]">
        <option value="">All Status</option>
        <option value="active">Active Only</option>
        <option value="inactive">Inactive Only</option>
      </select>
      
      <button onclick="exportToCSV()" 
              class="px-5 py-3 bg-[#1e2937] hover:bg-[#334155] border border-[#475569] text-white rounded-2xl flex items-center gap-2 text-sm transition-all">
        <i class="fas fa-download"></i>
        <span>Export CSV</span>
      </button>
    </div>

    <!-- Promotions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="promotions-grid">
      <% promotions.forEach(p => { %>
      <div class="promo-card bg-[#1e2937] border border-[#334155] rounded-3xl overflow-hidden hover:border-[#f59e0b]/50 transition-all group"
           data-title="<%= (p.title || '').toLowerCase() %>" 
           data-active="<%= p.active ? 'active' : 'inactive' %>">
        
        <div class="h-44 bg-[#0f172a] flex items-center justify-center overflow-hidden relative">
          <% if(p.image_url) { %>
            <img src="<%= p.image_url %>" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" alt="<%= p.title || 'Promotion' %>">
          <% } else { %>
            <div class="text-center">
              <i class="fas fa-image text-6xl text-gray-600"></i>
              <p class="text-xs text-gray-500 mt-2">No image</p>
            </div>
          <% } %>
          
          <div class="absolute top-3 right-3">
            <span class="px-3 py-1 text-xs font-medium rounded-full <%= p.active ? 'bg-emerald-500/90 text-white' : 'bg-gray-600/90 text-white' %>">
              <%= p.active ? 'Active' : 'Inactive' %>
            </span>
          </div>
        </div>
        
        <div class="p-5">
          <div class="flex items-start justify-between mb-3">
            <div class="font-semibold text-white text-lg leading-tight"><%= p.title || 'Untitled Promotion' %></div>
          </div>
          
          <div class="text-xs text-gray-500 mb-1">Position: <span class="text-gray-400 font-mono"><%= p.position || 0 %></span></div>
          
          <% if(p.link_url) { %>
          <div class="text-xs text-amber-400 mb-4 truncate">
            <i class="fas fa-link mr-1"></i> <%= p.link_url %>
          </div>
          <% } else { %>
          <div class="text-xs text-gray-500 mb-4">No link attached</div>
          <% } %>

          <div class="flex gap-2">
            <form action="/admin/promotions/<%= p.id %>/toggle" method="POST" class="flex-1">
              <button type="submit" 
                      class="w-full py-2.5 text-xs font-medium rounded-2xl transition-all <%= p.active ? 'bg-yellow-600 hover:bg-yellow-700 text-white' : 'bg-emerald-600 hover:bg-emerald-700 text-white' %>">
                <%= p.active ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
            
            <form action="/admin/promotions/<%= p.id %>/delete" method="POST" class="flex-1" onsubmit="return confirm('Delete this promotion permanently?')">
              <button type="submit" 
                      class="w-full py-2.5 text-xs font-medium bg-red-600 hover:bg-red-700 rounded-2xl text-white transition-all">
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <% if (promotions.length === 0) { %>
      <div class="text-center py-16 bg-[#1e2937] border border-[#334155] rounded-3xl">
        <i class="fas fa-bullhorn text-6xl text-gray-600 mb-4"></i>
        <p class="text-gray-400 text-lg">No promotions found</p>
        <p class="text-gray-500 text-sm mt-1">Click "Add Promotion" to create your first banner</p>
      </div>
    <% } %>

    <!-- Add Promotion Modal -->
    <div id="add-promo-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
      <div class="bg-[#1e2937] rounded-3xl p-8 w-full max-w-lg border border-[#334155]">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-2xl font-bold text-white">Add New Promotion Banner</h3>
          <button onclick="document.getElementById('add-promo-modal').classList.add('hidden')" class="text-gray-400 hover:text-white">
            <i class="fas fa-times text-xl"></i>
          </button>
        </div>
        
        <form action="/admin/promotions/add" method="POST" class="space-y-5">
          <div>
            <label class="text-sm text-gray-400 block mb-2">Title (Optional)</label>
            <input type="text" name="title" placeholder="Summer Sale 2026" 
                   class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-5 py-3.5 text-white placeholder-gray-500 focus:border-[#f59e0b] focus:outline-none">
          </div>
          
          <div>
            <label class="text-sm text-gray-400 block mb-2">Image URL <span class="text-red-400">*</span></label>
            <input type="url" name="image_url" required placeholder="https://example.com/banner.jpg" 
                   class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-5 py-3.5 text-white placeholder-gray-500 focus:border-[#f59e0b] focus:outline-none">
            <p class="text-xs text-gray-500 mt-1.5">Recommended size: 1200x400px or similar</p>
          </div>
          
          <div>
            <label class="text-sm text-gray-400 block mb-2">Link URL (Optional)</label>
            <input type="url" name="link_url" placeholder="https://your-site.com/offer" 
                   class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-5 py-3.5 text-white placeholder-gray-500 focus:border-[#f59e0b] focus:outline-none">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="text-sm text-gray-400 block mb-2">Position</label>
              <input type="number" name="position" value="0" 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-5 py-3.5 text-white focus:border-[#f59e0b] focus:outline-none">
              <p class="text-xs text-gray-500 mt-1">Lower number = higher priority</p>
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-2">Status</label>
              <select name="active" class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-5 py-3.5 text-white focus:border-[#f59e0b] focus:outline-none">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
          </div>

          <div class="flex gap-3 pt-4">
            <button type="button" onclick="document.getElementById('add-promo-modal').classList.add('hidden')"
                    class="flex-1 py-3.5 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm font-medium transition-all">Cancel</button>
            <button type="submit" 
                    class="flex-1 py-3.5 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl transition-all">Create Promotion</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script>
// Live Search + Filter
const searchInput = document.getElementById('search-input');
const statusFilter = document.getElementById('status-filter');
const grid = document.getElementById('promotions-grid');

function filterPromotions() {
  const searchTerm = searchInput.value.toLowerCase().trim();
  const statusValue = statusFilter.value;
  const cards = grid.querySelectorAll('.promo-card');

  let visibleCount = 0;

  cards.forEach(card => {
    const title = card.dataset.title || '';
    const activeStatus = card.dataset.active;

    const matchesSearch = title.includes(searchTerm);
    let matchesStatus = true;

    if (statusValue === 'active') matchesStatus = activeStatus === 'active';
    if (statusValue === 'inactive') matchesStatus = activeStatus === 'inactive';

    if (matchesSearch && matchesStatus) {
      card.style.display = '';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });
}

searchInput.addEventListener('input', filterPromotions);
statusFilter.addEventListener('change', filterPromotions);

// Export to CSV
function exportToCSV() {
  const cards = Array.from(grid.querySelectorAll('.promo-card')).filter(c => c.style.display !== 'none');
  
  if (cards.length === 0) {
    alert('No promotions to export');
    return;
  }

  let csv = 'Title,Status,Position,Link URL,Image URL\n';
  
  cards.forEach(card => {
    const title = card.querySelector('.font-semibold')?.innerText || '';
    const statusEl = card.querySelector('.px-3');
    const status = statusEl ? statusEl.innerText : '';
    const position = card.querySelector('.font-mono')?.innerText || '0';
    const linkEl = card.querySelector('.text-amber-400');
    const link = linkEl ? linkEl.innerText.trim() : '';
    const img = card.querySelector('img')?.src || '';
    
    csv += `"${title.replace(/"/g, '""')}","${status}","${position}","${link.replace(/"/g, '""')}","${img}"\n`;
  });

  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  const url = URL.createObjectURL(blob);
  link.href = url;
  link.download = `promotions_${new Date().toISOString().slice(0,10)}.csv`;
  link.click();
  URL.revokeObjectURL(url);
}

// Close modal on outside click
document.getElementById('add-promo-modal').addEventListener('click', function(e) {
  if (e.target === this) {
    this.classList.add('hidden');
  }
});
</script>

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_promotions') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz20-1 { padding: 16px; margin-bottom: 16px; }
  .dz20-2 { font-weight: 800; color: var(--text-main); font-size: 13px; margin-bottom: 12px; }
  .dz20-3 { color: #f59e0b; }
  .dz20-4 { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .dz20-5 { font-weight: 700; color: #fff; font-size: 13px; }
  .dz20-6 { color: #94a3b8; font-size: 11px; margin-top: 4px; }
  .dz20-7 { grid-column: 1/-1; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .promo-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
    @media (min-width: 700px) { .promo-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1100px) { .promo-grid { grid-template-columns: 1fr 1fr 1fr; } }
    .promo-card img { width: 100%; height: 130px; object-fit: cover; border-radius: 10px 10px 0 0; background: #0f1115; }
    .promo-card .promo-body { padding: 12px; }
    .promo-actions { display: flex; gap: 8px; margin-top: 10px; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'promotions' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'প্রমোশন ব্যানার', pageSubtitle: 'হোমপেজের প্রমোশনাল ব্যানার পরিচালনা করুন' }) %>

      <div class="admin-card dz20-1">
        <div class="dz20-2"><i class="fas fa-plus-circle dz20-3"></i> <%= t('admin_promo_add_heading') %></div>
        <form class="dz20-4" method="POST" action="/admin/promotions/add">
          <input class="input" type="text" name="title" placeholder="<%= t('admin_field_banner_title_optional') %>">
          <input class="input" type="text" name="image_url" placeholder="<%= t('admin_field_image_url') %>" required>
          <input class="input" type="text" name="link_url" placeholder="<%= t('admin_field_click_link_optional') %>">
          <input class="input" type="number" name="position" placeholder="<%= t('admin_field_position_number') %>" value="0">
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> <%= t('admin_btn_add') %></button>
        </form>
      </div>

      <div class="promo-grid">
        <% if (promotions && promotions.length > 0) { %>
          <% promotions.forEach(p => { %>
            <div class="admin-card promo-card">
              <img alt="" src="<%= p.image_url %>" data-img-fallback="fade">
              <div class="promo-body">
                <div class="dz20-5"><%= p.title || 'শিরোনাম নেই' %></div>
                <div class="dz20-6">পজিশন: <%= p.position %> · <%= p.active ? 'সক্রিয়' : 'নিষ্ক্রিয়' %></div>
                <div class="promo-actions">
                  <form method="POST" action="/admin/promotions/<%= p.id %>/toggle">
                    <button class="btn btn-sm <%= p.active ? 'btn-green' : '' %>" type="submit"><%= p.active ? 'সক্রিয়' : 'নিষ্ক্রিয়' %></button>
                  </form>
                  <form method="POST" action="/admin/promotions/<%= p.id %>/delete" data-confirm="মুছে ফেলবেন?">
                    <button class="btn btn-sm btn-red" type="submit"><i class="fas fa-trash"></i></button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state dz20-7"><%= t('admin_empty_promotions') %></div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>

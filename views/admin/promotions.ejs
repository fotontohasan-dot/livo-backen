<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>প্রমোশন ব্যানার • Livo Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
    .promo-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
    @media (min-width: 700px) { .promo-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1100px) { .promo-grid { grid-template-columns: 1fr 1fr 1fr; } }
    .promo-card img { width: 100%; height: 130px; object-fit: cover; border-radius: 10px 10px 0 0; background: #0f1115; }
    .promo-card .promo-body { padding: 12px; }
    .promo-actions { display: flex; gap: 8px; margin-top: 10px; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'promotions' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'প্রমোশন ব্যানার', pageSubtitle: 'হোমপেজের প্রমোশনাল ব্যানার পরিচালনা করুন' }) %>

      <div class="admin-card" style="padding:16px;margin-bottom:16px;">
        <div style="font-weight:800;color:var(--text-main);font-size:13px;margin-bottom:12px;"><i class="fas fa-plus-circle" style="color:#f59e0b;"></i> নতুন ব্যানার যোগ করুন</div>
        <form method="POST" action="/admin/promotions/add" style="display:grid;grid-template-columns:1fr;gap:10px;">
          <input class="input" type="text" name="title" placeholder="ব্যানারের শিরোনাম (ঐচ্ছিক)">
          <input class="input" type="text" name="image_url" placeholder="ইমেজ URL" required>
          <input class="input" type="text" name="link_url" placeholder="ক্লিক করলে যে লিংকে যাবে (ঐচ্ছিক)">
          <input class="input" type="number" name="position" placeholder="ক্রম নম্বর (position)" value="0">
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> যোগ করুন</button>
        </form>
      </div>

      <div class="promo-grid">
        <% if (promotions && promotions.length > 0) { %>
          <% promotions.forEach(p => { %>
            <div class="admin-card promo-card">
              <img alt="" src="<%= p.image_url %>" onerror="this.style.opacity=0.3">
              <div class="promo-body">
                <div style="font-weight:700;color:#fff;font-size:13px;"><%= p.title || 'শিরোনাম নেই' %></div>
                <div style="color:#94a3b8;font-size:11px;margin-top:4px;">পজিশন: <%= p.position %> · <%= p.active ? 'সক্রিয়' : 'নিষ্ক্রিয়' %></div>
                <div class="promo-actions">
                  <form method="POST" action="/admin/promotions/<%= p.id %>/toggle">
                    <button class="btn btn-sm <%= p.active ? 'btn-green' : '' %>" type="submit"><%= p.active ? 'সক্রিয়' : 'নিষ্ক্রিয়' %></button>
                  </form>
                  <form method="POST" action="/admin/promotions/<%= p.id %>/delete" onsubmit="return confirm('মুছে ফেলবেন?')">
                    <button class="btn btn-sm btn-red" type="submit"><i class="fas fa-trash"></i></button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state" style="grid-column:1/-1;">কোনো প্রমোশন ব্যানার পাওয়া যায়নি</div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>

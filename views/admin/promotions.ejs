<%- include('../partials/head') %>
<div class="admin-wrap">
  <%- include('./partials/sidebar', { active: 'promotions' }) %>
  <div class="admin-content">
    <div class="admin-topbar">
      <button class="admin-hamburger" onclick="toggleAdminSidebar()"><i class="fas fa-bars"></i></button>
      <h1 style="font-size:18px;font-weight:800;color:#fff;">🖼️ প্রমোশন ব্যানার</h1>
    </div>
    <%- include('../partials/flash') %>

    <div class="admin-card" style="margin-bottom:20px;">
      <div class="admin-card-header">নতুন ব্যানার যোগ করুন</div>
      <form method="POST" action="/admin/promotions/add" style="padding:16px;display:flex;flex-direction:column;gap:10px;">
        <input type="text" name="title" placeholder="ব্যানারের নাম (ঐচ্ছিক)" style="background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;font-size:13px;">
        <input type="text" name="image_url" required placeholder="ছবির URL (Cloudinary/অন্য কোথাও আপলোড করে লিংক দাও)" style="background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;font-size:13px;">
        <input type="text" name="link_url" placeholder="ক্লিক করলে কোথায় যাবে (ঐচ্ছিক, যেমন /payment/deposit)" style="background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;font-size:13px;">
        <input type="number" name="position" placeholder="ক্রম (০ = সবার আগে)" style="background:#0f1115;border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;color:#fff;font-size:13px;">
        <button type="submit" style="background:#f59e0b;color:#000;border:none;padding:10px;border-radius:10px;font-weight:800;">যোগ করুন</button>
      </form>
    </div>

    <div class="grid grid-2">
      <% promotions.forEach(function(p) { %>
        <div class="admin-card">
          <img src="<%= p.image_url %>" style="width:100%;height:120px;object-fit:cover;">
          <div style="padding:12px;">
            <div style="color:#fff;font-weight:700;font-size:13px;"><%= p.title || 'শিরোনামহীন' %></div>
            <div style="color:#64748b;font-size:11px;margin-top:4px;">ক্রম: <%= p.position %> · <%= p.link_url || 'লিংক নেই' %></div>
            <div style="display:flex;gap:8px;margin-top:10px;">
              <form method="POST" action="/admin/promotions/<%= p.id %>/toggle">
                <button type="submit" style="background:<%= p.active ? 'rgba(16,185,129,0.15)' : 'rgba(100,116,139,0.15)' %>;color:<%= p.active ? '#10b981' : '#94a3b8' %>;border:none;padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;"><%= p.active ? 'সক্রিয়' : 'নিষ্ক্রিয়' %></button>
              </form>
              <form method="POST" action="/admin/promotions/<%= p.id %>/delete" onsubmit="return confirm('মুছে ফেলবেন?')">
                <button type="submit" style="background:rgba(239,68,68,0.15);color:#ef4444;border:none;padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;">মুছুন</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (!promotions.length) { %><div style="color:#64748b;text-align:center;padding:20px;">কোনো ব্যানার নেই</div><% } %>
    </div>
  </div>
</div>

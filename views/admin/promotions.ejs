<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Promotions</h1>
        <p class="text-gray-400 text-sm mt-1">Manage homepage banners & promotions</p>
      </div>
      <button onclick="document.getElementById('add-promo-modal').classList.remove('hidden')" 
              class="px-5 py-2.5 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl flex items-center gap-2 text-sm">
        <i class="fas fa-plus"></i>
        <span>Add Promotion</span>
      </button>
    </div>

    <!-- Promotions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% promotions.forEach(p => { %>
      <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
        <div class="h-40 bg-[#0f172a] flex items-center justify-center overflow-hidden">
          <% if(p.image_url) { %>
            <img src="<%= p.image_url %>" class="max-h-full object-contain" alt="">
          <% } else { %>
            <i class="fas fa-image text-5xl text-gray-600"></i>
          <% } %>
        </div>
        <div class="p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="font-semibold text-white"><%= p.title || 'Untitled' %></div>
            <span class="px-2 py-0.5 text-xs rounded-full <%= p.active ? 'bg-emerald-500/20 text-emerald-400' : 'bg-gray-500/20 text-gray-400' %>">
              <%= p.active ? 'Active' : 'Inactive' %>
            </span>
          </div>
          
          <div class="text-xs text-gray-500 mb-4">Position: <%= p.position %></div>

          <div class="flex gap-2">
            <form action="/admin/promotions/<%= p.id %>/toggle" method="POST" class="flex-1">
              <button type="submit" class="w-full py-2 text-xs rounded-2xl <%= p.active ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-emerald-600 hover:bg-emerald-700' %> text-white">
                <%= p.active ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
            <form action="/admin/promotions/<%= p.id %>/delete" method="POST" class="flex-1" onsubmit="return confirm('Delete this promotion?')">
              <button type="submit" class="w-full py-2 text-xs bg-red-600 hover:bg-red-700 rounded-2xl text-white">Delete</button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <% if (promotions.length === 0) { %>
      <div class="text-center py-12 text-gray-500">
        No promotions found. Add your first one.
      </div>
    <% } %>

    <!-- Add Promotion Modal -->
    <div id="add-promo-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
      <div class="bg-[#1e2937] rounded-3xl p-8 w-full max-w-md border border-[#334155]">
        <h3 class="text-xl font-bold text-white mb-6">Add New Promotion Banner</h3>
        
        <form action="/admin/promotions/add" method="POST">
          <div class="space-y-4">
            <div>
              <label class="text-sm text-gray-400 block mb-1">Title (Optional)</label>
              <input type="text" name="title" class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Image URL *</label>
              <input type="text" name="image_url" required placeholder="https://..." 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Link URL (Optional)</label>
              <input type="text" name="link_url" placeholder="https://..." 
                     class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
            <div>
              <label class="text-sm text-gray-400 block mb-1">Position (Lower = Higher Priority)</label>
              <input type="number" name="position" value="0" class="w-full bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-white">
            </div>
          </div>

          <div class="flex gap-3 mt-8">
            <button type="button" onclick="document.getElementById('add-promo-modal').classList.add('hidden')"
                    class="flex-1 py-3 bg-[#334155] hover:bg-[#475569] rounded-2xl text-sm">Cancel</button>
            <button type="submit" class="flex-1 py-3 bg-[#f59e0b] hover:bg-[#d97706] text-black font-bold rounded-2xl">Add Promotion</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

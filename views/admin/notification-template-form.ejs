<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const tpl = tmpl || {};
const isEdit = !!tpl.id;
const action = isEdit ? '/admin/notification-templates/' + tpl.id : '/admin/notification-templates';
%>
<%- include('partials/admin-layout', {
    title: isEdit ? t('ntf_edit_title') : t('ntf_new_title'),
    active: 'notification-templates',
    body: `
<div class="max-w-4xl mx-auto space-y-5">
    <div class="flex items-center gap-3">
        <a href="/admin/notification-templates" class="text-slate-400 hover:text-slate-600"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-semibold text-slate-900">${isEdit ? t('ntf_edit_heading') : t('ntf_new_heading')}</h1>
    </div>

    ${error ? '<div class="px-4 py-3 bg-red-50 text-red-700 rounded-2xl text-sm font-medium">❌ ' + escapeHtml(error) + '</div>' : ''}

    <form method="POST" action="${action}" id="tmplForm" class="bg-white rounded-3xl border border-slate-100 p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">Template Key ${isEdit ? t('ntf_immutable') : ''}</label>
                <input type="text" name="template_key" value="${escapeHtml(tpl.template_key)}" placeholder="e.g. otp_verification" pattern="[a-zA-Z0-9_]{2,80}" required ${isEdit ? 'readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500"' : 'class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"'}>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">${t('ntf_channel')} ${isEdit ? t('ntf_immutable') : ''}</label>
                ${isEdit
                  ? '<input type="text" value="' + escapeHtml(tpl.channel) + '" readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500 capitalize">'
                  : '<select name="channel" id="channelSelect" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="email">Email</option><option value="sms">SMS</option><option value="in_app">In-App</option></select>'
                }
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">${t('ntf_language')} ${isEdit ? t('ntf_immutable') : ''}</label>
                ${isEdit
                  ? '<input type="text" value="' + escapeHtml(tpl.lang) + '" readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500 uppercase">'
                  : '<select name="lang" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="bn">' + t("ntf_bengali") + '</option><option value="en">English</option></select>'
                }
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">${t('ntf_name')}</label>
            <input type="text" name="name" value="${escapeHtml(tpl.name)}" placeholder="${t('ntf_name_placeholder')}" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        </div>

        <div id="subjectField">
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">${t('ntf_subject')}</label>
            <input type="text" name="subject" value="${escapeHtml(tpl.subject)}" placeholder="${t('ntf_subject_placeholder')}" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">${t('ntf_body_label')}</label>
            <textarea name="body" id="bodyField" rows="8" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm font-mono">${escapeHtml(tpl.body)}</textarea>
            <p class="text-xs text-slate-400 mt-1">${t('ntf_body_hint')}</p>
        </div>

        <label class="flex items-center gap-2">
            <input type="checkbox" name="is_active" ${tpl.is_active !== false ? 'checked' : ''} class="w-4 h-4 rounded">
            <span class="text-sm text-slate-700">${t('ntf_active')}</span>
        </label>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="px-6 py-2.5 bg-slate-900 text-white rounded-2xl text-sm font-semibold hover:bg-slate-800">
                <i class="fas fa-save mr-1"></i> ${isEdit ? t('ntf_update') : t('ntf_create')}
            </button>
            ${isEdit ? '<button type="button" id="previewBtn" class="px-6 py-2.5 bg-blue-50 text-blue-600 rounded-2xl text-sm font-semibold hover:bg-blue-100"><i class="fas fa-eye mr-1"></i> ' + t("ntf_preview") + '</button>' : ''}
        </div>
    </form>

    ${isEdit ? `
    <!-- প্রিভিউ প্যানেল -->
    <div id="previewPanel" class="bg-white rounded-3xl border border-slate-100 p-6 hidden">
        <h3 class="font-semibold text-slate-800 mb-3 text-sm"><i class="fas fa-eye text-blue-500 mr-2"></i>${t('ntf_preview_heading')}</h3>
        <div id="previewSubject" class="text-sm font-semibold text-slate-700 mb-2"></div>
        <div id="previewBody" class="text-sm bg-slate-50 rounded-2xl p-4 border border-slate-100"></div>
    </div>

    <!-- টেস্ট সেন্ড প্যানেল -->
    <div class="bg-white rounded-3xl border border-slate-100 p-6">
        <h3 class="font-semibold text-slate-800 mb-3 text-sm"><i class="fas fa-paper-plane text-emerald-500 mr-2"></i>${t('ntf_test_send')}</h3>
        <p class="text-xs text-slate-400 mb-3">
            ${tpl.channel === 'email' ? t('ntf_test_email') : (tpl.channel === 'sms' ? t('ntf_test_phone') : t('ntf_test_userid'))} ${t('ntf_test_hint')}
        </p>
        <div class="flex flex-wrap gap-3">
            <input type="text" id="testTarget" placeholder="${tpl.channel === 'email' ? 'you@example.com' : (tpl.channel === 'sms' ? '01700000000' : 'user id')}" class="flex-1 min-w-[220px] border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <button type="button" id="testSendBtn" class="px-6 py-2.5 bg-emerald-600 text-white rounded-2xl text-sm font-semibold hover:bg-emerald-700">${t('ntf_send_test')}</button>
        </div>
        <div id="testResult" class="text-xs mt-3"></div>
    </div>

    <script type="application/json" id="admin-notification-template-formConfig">${JSON.stringify({ templateId: tpl.id }).replace(/</g, "\\u003c")}</script>
<script src="/js/views/admin-notification-template-form.js"></script>
    ` : `
    
    `}
</div>
`
}) %>

<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const tpl = tmpl || {};
const isEdit = !!tpl.id;
const action = isEdit ? '/admin/notification-templates/' + tpl.id : '/admin/notification-templates';
%>
<%- include('partials/admin-layout', {
    title: isEdit ? 'টেমপ্লেট এডিট' : 'নতুন টেমপ্লেট',
    active: 'notification-templates',
    body: `
<div class="max-w-4xl mx-auto space-y-5">
    <div class="flex items-center gap-3">
        <a href="/admin/notification-templates" class="text-slate-400 hover:text-slate-600"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-semibold text-slate-900">${isEdit ? 'টেমপ্লেট এডিট করুন' : 'নতুন নোটিফিকেশন টেমপ্লেট'}</h1>
    </div>

    ${error ? '<div class="px-4 py-3 bg-red-50 text-red-700 rounded-2xl text-sm font-medium">❌ ' + escapeHtml(error) + '</div>' : ''}

    <form method="POST" action="${action}" id="tmplForm" class="bg-white rounded-3xl border border-slate-100 p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">Template Key ${isEdit ? '(পরিবর্তনযোগ্য নয়)' : ''}</label>
                <input type="text" name="template_key" value="${escapeHtml(tpl.template_key)}" placeholder="e.g. otp_verification" pattern="[a-zA-Z0-9_]{2,80}" required ${isEdit ? 'readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500"' : 'class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"'}>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">চ্যানেল ${isEdit ? '(পরিবর্তনযোগ্য নয়)' : ''}</label>
                ${isEdit
                  ? '<input type="text" value="' + escapeHtml(tpl.channel) + '" readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500 capitalize">'
                  : '<select name="channel" id="channelSelect" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="email">Email</option><option value="sms">SMS</option><option value="in_app">In-App</option></select>'
                }
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1.5">ভাষা ${isEdit ? '(পরিবর্তনযোগ্য নয়)' : ''}</label>
                ${isEdit
                  ? '<input type="text" value="' + escapeHtml(tpl.lang) + '" readonly class="w-full border border-slate-200 bg-slate-50 px-4 py-2.5 rounded-2xl text-sm text-slate-500 uppercase">'
                  : '<select name="lang" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm"><option value="bn">বাংলা</option><option value="en">English</option></select>'
                }
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">টেমপ্লেটের নাম</label>
            <input type="text" name="name" value="${escapeHtml(tpl.name)}" placeholder="e.g. OTP ভেরিফিকেশন (ইমেইল)" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        </div>

        <div id="subjectField">
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Subject (শুধু Email-এর জন্য)</label>
            <input type="text" name="subject" value="${escapeHtml(tpl.subject)}" placeholder="e.g. LIVO - আপনার OTP কোড" class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Body — {{variable}} দিয়ে প্লেসহোল্ডার ব্যবহার করুন (যেমন {{name}}, {{otp}}, {{amount}})</label>
            <textarea name="body" id="bodyField" rows="8" required class="w-full border border-slate-200 px-4 py-2.5 rounded-2xl text-sm font-mono">${escapeHtml(tpl.body)}</textarea>
            <p class="text-xs text-slate-400 mt-1">Email চ্যানেলে HTML সমর্থিত। SMS/In-App-এ প্লেইন টেক্সট রাখাই ভালো।</p>
        </div>

        <label class="flex items-center gap-2">
            <input type="checkbox" name="is_active" ${tpl.is_active !== false ? 'checked' : ''} class="w-4 h-4 rounded">
            <span class="text-sm text-slate-700">সক্রিয় (Active)</span>
        </label>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="px-6 py-2.5 bg-slate-900 text-white rounded-2xl text-sm font-semibold hover:bg-slate-800">
                <i class="fas fa-save mr-1"></i> ${isEdit ? 'আপডেট করুন' : 'তৈরি করুন'}
            </button>
            ${isEdit ? '<button type="button" id="previewBtn" class="px-6 py-2.5 bg-blue-50 text-blue-600 rounded-2xl text-sm font-semibold hover:bg-blue-100"><i class="fas fa-eye mr-1"></i> প্রিভিউ</button>' : ''}
        </div>
    </form>

    ${isEdit ? `
    <!-- প্রিভিউ প্যানেল -->
    <div id="previewPanel" class="bg-white rounded-3xl border border-slate-100 p-6 hidden">
        <h3 class="font-semibold text-slate-800 mb-3 text-sm"><i class="fas fa-eye text-blue-500 mr-2"></i>প্রিভিউ (নমুনা ডেটা দিয়ে)</h3>
        <div id="previewSubject" class="text-sm font-semibold text-slate-700 mb-2"></div>
        <div id="previewBody" class="text-sm bg-slate-50 rounded-2xl p-4 border border-slate-100"></div>
    </div>

    <!-- টেস্ট সেন্ড প্যানেল -->
    <div class="bg-white rounded-3xl border border-slate-100 p-6">
        <h3 class="font-semibold text-slate-800 mb-3 text-sm"><i class="fas fa-paper-plane text-emerald-500 mr-2"></i>টেস্ট সেন্ড</h3>
        <p class="text-xs text-slate-400 mb-3">
            ${tpl.channel === 'email' ? 'একটা ইমেইল অ্যাড্রেস দিন' : (tpl.channel === 'sms' ? 'একটা ফোন নম্বর দিন' : 'একটা user ID দিন')} — নমুনা ভ্যারিয়েবল দিয়ে আসল একটা টেস্ট মেসেজ পাঠানো হবে।
        </p>
        <div class="flex flex-wrap gap-3">
            <input type="text" id="testTarget" placeholder="${tpl.channel === 'email' ? 'you@example.com' : (tpl.channel === 'sms' ? '01700000000' : 'user id')}" class="flex-1 min-w-[220px] border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <button type="button" id="testSendBtn" class="px-6 py-2.5 bg-emerald-600 text-white rounded-2xl text-sm font-semibold hover:bg-emerald-700">টেস্ট পাঠান</button>
        </div>
        <div id="testResult" class="text-xs mt-3"></div>
    </div>

    <script>
    (function() {
      const tmplId = ${tpl.id};
      const previewBtn = document.getElementById('previewBtn');
      const previewPanel = document.getElementById('previewPanel');
      const previewSubject = document.getElementById('previewSubject');
      const previewBody = document.getElementById('previewBody');

      previewBtn.addEventListener('click', async () => {
        previewBtn.disabled = true;
        try {
          const res = await fetch('/admin/notification-templates/' + tmplId + '/preview', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({}) });
          const data = await res.json();
          if (!data.success) throw new Error(data.error || 'প্রিভিউ ব্যর্থ');
          previewSubject.textContent = data.subject || '';
          previewBody.innerHTML = data.body || '';
          previewPanel.classList.remove('hidden');
        } catch (e) {
          alert('প্রিভিউ ব্যর্থ: ' + e.message);
        } finally {
          previewBtn.disabled = false;
        }
      });

      const testSendBtn = document.getElementById('testSendBtn');
      const testResult = document.getElementById('testResult');
      testSendBtn.addEventListener('click', async () => {
        const target = document.getElementById('testTarget').value.trim();
        if (!target) { testResult.innerHTML = '<span class="text-red-500">টার্গেট দিন</span>'; return; }
        testSendBtn.disabled = true;
        testResult.innerHTML = '<span class="text-slate-400">পাঠানো হচ্ছে...</span>';
        try {
          const res = await fetch('/admin/notification-templates/' + tmplId + '/test-send', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ target }) });
          const data = await res.json();
          if (!data.success) throw new Error(data.error || 'টেস্ট-সেন্ড ব্যর্থ');
          testResult.innerHTML = '<span class="text-emerald-600 font-medium">✅ ' + (data.message || 'পাঠানো হয়েছে') + (data.simulated ? ' <span class=\\'text-amber-500\\'>(সিমুলেটেড)</span>' : '') + '</span>';
        } catch (e) {
          testResult.innerHTML = '<span class="text-red-500">❌ ' + e.message + '</span>';
        } finally {
          testSendBtn.disabled = false;
        }
      });
    })();
    </script>
    ` : `
    <script>
    (function() {
      const channelSelect = document.getElementById('channelSelect');
      const subjectField = document.getElementById('subjectField');
      function toggleSubject() {
        subjectField.style.display = channelSelect.value === 'email' ? '' : 'none';
      }
      channelSelect.addEventListener('change', toggleSubject);
      toggleSubject();
    })();
    </script>
    `}
</div>
`
}) %>

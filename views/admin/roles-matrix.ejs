<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
const allPerms = [];
Object.values(permissionGroups).forEach(list => list.forEach(p => allPerms.push(p)));
%>
<%- include('partials/admin-layout', {
    title: 'Permission Matrix',
    active: 'roles',
    body: `
<div class="max-w-full mx-auto">
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-xl font-bold text-slate-800">🧮 Permission Matrix</h1>
    <a href="/admin/roles" class="text-sm text-slate-500"><i class="fas fa-arrow-left"></i> Roles-এ ফিরে যান</a>
  </div>

  <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm mb-6">
    <p class="text-sm font-bold text-slate-700 mb-2">⚡ বাল্ক পারমিশন আপডেট</p>
    <form method="POST" action="/admin/roles/bulk-permission-update" class="flex flex-wrap gap-2 items-center">
      <select name="perm_key" required class="border px-3 py-2 rounded-xl text-sm">
        ${allPerms.map(p => `<option value="${p.key}">${escapeHtml(p.label)}</option>`).join('')}
      </select>
      <select name="perm_value" required class="border px-3 py-2 rounded-xl text-sm">
        <option value="true">✅ চালু করুন</option>
        <option value="false">🚫 বন্ধ করুন</option>
      </select>
      <select name="role_ids" multiple required class="border px-3 py-2 rounded-xl text-sm min-w-[220px]" size="4">
        ${roles.filter(r => r.key !== 'super_admin').map(r => `<option value="${r.id}">${escapeHtml(r.name)}</option>`).join('')}
      </select>
      <button type="submit" class="px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-semibold self-start"><i class="fas fa-bolt"></i> প্রয়োগ করুন</button>
      <span class="text-xs text-slate-400 self-center">Ctrl/Cmd চেপে একাধিক Role সিলেক্ট করুন</span>
    </form>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-x-auto">
    <table class="text-sm min-w-full">
      <thead>
        <tr class="text-left border-b border-slate-100">
          <th class="p-3 sticky left-0 bg-white">Permission</th>
          ${roles.map(r => `<th class="p-3 text-center whitespace-nowrap">${escapeHtml(r.name)}</th>`).join('')}
        </tr>
      </thead>
      <tbody>
        ${allPerms.map(p => `
          <tr class="border-t border-slate-50">
            <td class="p-3 font-medium text-slate-700 sticky left-0 bg-white">${escapeHtml(p.label)}</td>
            ${roles.map(r => `<td class="p-3 text-center">${(r.permissions && r.permissions[p.key]) ? '<span class="text-emerald-500 font-bold">✅</span>' : '<span class="text-slate-300">—</span>'}</td>`).join('')}
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>
</div>
`
}) %>

<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function catLabel(c) {
  const map = { feature: 'Feature', maintenance: 'Maintenance', beta: 'Beta', security: 'Security', api: 'API' };
  const color = { feature: 'bg-blue-100 text-blue-700', maintenance: 'bg-amber-100 text-amber-700', beta: 'bg-purple-100 text-purple-700', security: 'bg-red-100 text-red-700', api: 'bg-emerald-100 text-emerald-700' };
  return '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + (color[c] || 'bg-slate-100 text-slate-600') + '">' + (map[c] || c) + '</span>';
}
function flagRow(f) {
  return '<tr class="border-b border-slate-100 align-top">' +
    '<td class="px-6 py-4">' + catLabel(f.category) + '</td>' +
    '<td class="px-6 py-4"><div class="font-semibold text-slate-900 text-sm">' + escapeHtml(f.label) + '</div><div class="text-xs text-slate-400 font-mono">' + escapeHtml(f.key) + '</div>' +
      (f.description ? '<div class="text-xs text-slate-500 mt-1">' + escapeHtml(f.description) + '</div>' : '') + '</td>' +
    '<td class="px-6 py-4">' +
      '<form method="POST" action="/admin/feature-flags/' + f.id + '/toggle" style="display:inline">' +
        '<button type="submit" class="px-4 py-1.5 text-xs font-bold rounded-full ' + (f.enabled ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-600') + '">' + (f.enabled ? 'ON' : 'OFF') + '</button>' +
      '</form>' +
    '</td>' +
    '<td class="px-6 py-4 text-xs text-slate-400">' + (f.updated_by_username ? escapeHtml(f.updated_by_username) : '-') + '<br>' + (f.updated_at ? new Date(f.updated_at).toLocaleString('en-US') : '') + '</td>' +
    '<td class="px-6 py-4 text-right">' +
      '<form method="POST" action="/admin/feature-flags/' + f.id + '/delete" onsubmit="return confirm(\'ডিলিট করবেন?\')" style="display:inline">' +
        '<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-red-50 text-red-600 hover:bg-red-100">Delete</button>' +
      '</form>' +
    '</td>' +
  '</tr>';
}
const rows = (flags || []).map(flagRow).join('') || '<tr><td colspan="5" class="px-6 py-10 text-center text-slate-400">কোনো ফ্ল্যাগ নেই</td></tr>';
%>
<%- include('partials/admin-layout', {
    title: 'Feature Flags',
    active: 'feature-flags',
    body: `
<div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1">Feature Flags &amp; Configuration Management</h1>
    <p class="text-slate-500 text-sm mb-6">Feature / Maintenance / Beta / Security / API — প্রতিটা আলাদাভাবে চালু-বন্ধ করুন (Redis-cached, তাৎক্ষণিক প্রভাব)</p>

    ${created ? '<div class="mb-4 px-4 py-3 bg-emerald-50 text-emerald-700 rounded-2xl text-sm font-medium">✅ ফ্ল্যাগ তৈরি হয়েছে</div>' : ''}
    ${error ? '<div class="mb-4 px-4 py-3 bg-red-50 text-red-700 rounded-2xl text-sm font-medium">❌ ' + escapeHtml(error) + '</div>' : ''}

    <div class="bg-white rounded-3xl border border-slate-100 p-5 mb-6">
        <h2 class="font-semibold text-slate-900 mb-3 text-sm">নতুন ফ্ল্যাগ যোগ করুন</h2>
        <form method="POST" action="/admin/feature-flags/create" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <input type="text" name="key" placeholder="key (e.g. beta_x)" pattern="[a-z0-9_]{3,60}" required class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <input type="text" name="label" placeholder="লেবেল" required class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <select name="category" required class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
                <option value="feature">Feature</option>
                <option value="maintenance">Maintenance</option>
                <option value="beta">Beta</option>
                <option value="security">Security</option>
                <option value="api">API</option>
            </select>
            <input type="text" name="description" placeholder="বর্ণনা (ঐচ্ছিক)" class="border border-slate-200 px-4 py-2.5 rounded-2xl text-sm">
            <button type="submit" class="px-4 py-2.5 bg-blue-600 text-white rounded-2xl text-sm font-semibold">যোগ করুন</button>
        </form>
    </div>

    <div class="bg-white rounded-3xl border border-slate-100 overflow-x-auto">
        <table class="w-full text-sm min-w-[800px]">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Category</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Flag</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Last Updated</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody>${rows}</tbody>
        </table>
    </div>
</div>
`
}) %>

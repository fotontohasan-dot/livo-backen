<%- include('../partials/head') %>
<div class="container mx-auto p-4 flex h-[calc(100vh-100px)] gap-4">
    <!-- Conversations List -->
    <div class="w-1/4 bg-gray-900 border border-gray-800 rounded-lg overflow-y-auto">
        <h2 class="p-4 font-bold border-b border-gray-800 text-yellow-500">কনভারসেশনসমূহ</h2>
        <div id="conversations-list">
            <!-- User list will appear here -->
        </div>
    </div>

    <!-- Chat Area -->
    <div id="chat-area" class="w-3/4 bg-gray-900 border border-gray-800 rounded-lg flex flex-col hidden">
        <div class="p-4 border-b border-gray-800 font-bold" id="chat-header">
            <!-- User name will appear here -->
        </div>
        <div id="messages" class="flex-grow overflow-y-auto p-4 space-y-4">
            <!-- Messages will appear here -->
        </div>
        <div class="p-4 border-t border-gray-800 flex gap-2">
            <input type="text" id="message-input" class="flex-grow bg-gray-800 text-white rounded px-3 py-2 outline-none focus:ring-1 focus:ring-yellow-500" placeholder="উত্তর লিখুন...">
            <button id="send-button" class="bg-yellow-500 text-black px-4 py-2 rounded font-bold">পাঠান</button>
        </div>
    </div>

    <div id="no-chat" class="w-3/4 bg-gray-900 border border-gray-800 rounded-lg flex items-center justify-center text-gray-500">
        একটি কনভারসেশন নির্বাচন করুন
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const adminId = <%= user.id %>;
    const conversationsList = document.getElementById('conversations-list');
    const chatArea = document.getElementById('chat-area');
    const noChat = document.getElementById('no-chat');
    const chatHeader = document.getElementById('chat-header');
    const messagesDiv = document.getElementById('messages');
    const messageInput = document.getElementById('message-input');
    const sendButton = document.getElementById('send-button');

    let currentSelectedUserId = null;

    socket.emit('join_admin');

    // Fetch conversations
    function loadConversations() {
        fetch('/chat/admin/conversations')
            .then(res => res.json())
            .then(users => {
                if (Array.isArray(users)) {
                    conversationsList.innerHTML = '';
                    users.forEach(user => {
                        const div = document.createElement('div');
                        div.className = `p-4 cursor-pointer hover:bg-gray-800 border-b border-gray-800 ${currentSelectedUserId === user.id ? 'bg-gray-800' : ''}`;
                        div.textContent = user.username;
                        div.onclick = () => selectUser(user.id, user.username);
                        conversationsList.appendChild(div);
                    });
                }
            });
    }

    loadConversations();

    function selectUser(userId, username) {
        currentSelectedUserId = userId;
        chatArea.classList.remove('hidden');
        noChat.classList.add('hidden');
        chatHeader.textContent = `Chat with ${username}`;
        messagesDiv.innerHTML = '';

        fetch(`/chat/admin/history/${userId}`)
            .then(res => res.json())
            .then(messages => {
                if (Array.isArray(messages)) {
                    messages.forEach(msg => {
                        appendMessage(msg.message, msg.is_admin, msg.created_at);
                    });
                    scrollToBottom();
                }
            });

        // Update active state in list
        Array.from(conversationsList.children).forEach(child => {
            if (child.textContent === username) {
                child.classList.add('bg-gray-800');
            } else {
                child.classList.remove('bg-gray-800');
            }
        });
    }

    function appendMessage(text, isAdmin, timestamp) {
        const div = document.createElement('div');
        div.className = `flex ${isAdmin ? 'justify-end' : 'justify-start'}`;

        const innerDiv = document.createElement('div');
        innerDiv.className = `max-w-[80%] rounded-lg px-3 py-2 ${isAdmin ? 'bg-yellow-500 text-black' : 'bg-gray-700 text-white'}`;

        const textP = document.createElement('p');
        textP.textContent = text;

        const timeSpan = document.createElement('span');
        timeSpan.className = 'text-[10px] opacity-70 block mt-1';
        timeSpan.textContent = new Date(timestamp).toLocaleTimeString('bn-BD');

        innerDiv.appendChild(textP);
        innerDiv.appendChild(timeSpan);
        div.appendChild(innerDiv);
        messagesDiv.appendChild(div);
    }

    function scrollToBottom() {
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    function sendMessage() {
        const text = messageInput.value.trim();
        if (!text || !currentSelectedUserId) return;

        const data = {
            senderId: adminId,
            receiverId: currentSelectedUserId,
            message: text,
            isAdmin: true
        };

        socket.emit('send_message', data);
        appendMessage(text, true, new Date());
        messageInput.value = '';
        scrollToBottom();
    }

    sendButton.addEventListener('click', sendMessage);
    messageInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    socket.on('new_message', (data) => {
        if (!data.isAdmin) {
            // If message is from a new user, reload conversations list
            loadConversations();

            if (currentSelectedUserId === data.senderId) {
                appendMessage(data.message, false, data.createdAt);
                scrollToBottom();
            }
        }
    });
</script>
<%- include('../partials/navbar') %>

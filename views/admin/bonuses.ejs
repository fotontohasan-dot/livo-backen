<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">Bonuses</h1>
        <p class="text-gray-400 mt-1">Manage user bonuses and rewards</p>
      </div>
      <div class="mt-4 lg:mt-0 flex items-center gap-3">
        <button onclick="exportToCSV()" 
                class="flex items-center gap-2 px-4 py-2.5 bg-[#1e2937] hover:bg-[#334155] text-white rounded-2xl text-sm font-medium border border-[#334155] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Export CSV
        </button>
        <button onclick="showAddBonusModal()" 
                class="flex items-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl text-sm font-semibold transition-all shadow-lg shadow-emerald-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Bonus
        </button>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Total Bonuses</p>
            <p class="text-3xl font-bold text-white mt-1"><%= bonuses.length %></p>
          </div>
          <div class="w-11 h-11 bg-blue-500/10 rounded-2xl flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Active Bonuses</p>
            <p class="text-3xl font-bold text-emerald-400 mt-1"><%= bonuses.filter(b => b.status === 'active').length %></p>
          </div>
          <div class="w-11 h-11 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 01-9 9 9 9 0 01-9-9 9 9 0 019-9 9 9 0 019 9z" />
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">Total Amount Given</p>
            <p class="text-3xl font-bold text-white mt-1">৳<%= bonuses.reduce((sum, b) => sum + (b.amount || 0), 0) %></p>
          </div>
          <div class="w-11 h-11 bg-amber-500/10 rounded-2xl flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 01-2 2m-2-4H9" />
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-[#1e2937] border border-[#334155] rounded-3xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-400 text-sm">This Month</p>
            <p class="text-3xl font-bold text-white mt-1"><%= bonuses.length %></p>
          </div>
          <div class="w-11 h-11 bg-purple-500/10 rounded-2xl flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="flex flex-col lg:flex-row gap-4 mb-6">
      <div class="flex-1">
        <div class="relative">
          <input type="text" id="searchInput" placeholder="Search by username..." 
                 onkeyup="filterBonuses()"
                 class="w-full bg-[#1e2937] border border-[#334155] text-white placeholder-gray-500 rounded-2xl pl-11 py-3 text-sm focus:outline-none focus:border-emerald-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 absolute left-4 top-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 01-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
      
      <select id="typeFilter" onchange="filterBonuses()" 
              class="bg-[#1e2937] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500">
        <option value="">All Types</option>
        <option value="welcome">Welcome</option>
        <option value="deposit">Deposit</option>
        <option value="referral">Referral</option>
        <option value="special">Special</option>
      </select>

      <select id="statusFilter" onchange="filterBonuses()" 
              class="bg-[#1e2937] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>

    <!-- Bonuses Table -->
    <div class="bg-[#1e2937] border border-[#334155] rounded-3xl overflow-hidden">
      <table class="w-full text-sm" id="bonusesTable">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-medium">User</th>
            <th class="text-left px-4 py-4 font-medium">Type</th>
            <th class="text-right px-4 py-4 font-medium">Amount</th>
            <th class="text-center px-4 py-4 font-medium">Status</th>
            <th class="text-center px-6 py-4 font-medium">Date</th>
            <th class="text-center px-6 py-4 font-medium">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% bonuses.forEach((b, index) => { %>
          <tr class="hover:bg-[#0f172a] transition-colors" data-username="<%= b.username.toLowerCase() %>" data-type="<%= b.bonus_type %>" data-status="<%= b.status %>">
            <td class="px-6 py-4 font-medium text-white"><%= b.username %></td>
            <td class="px-4 py-4">
              <span class="px-3 py-1 text-xs rounded-full bg-[#334155] text-gray-300"><%= b.bonus_type %></span>
            </td>
            <td class="px-4 py-4 text-right font-bold text-emerald-400">৳<%= b.amount %></td>
            <td class="px-4 py-4 text-center">
              <% if(b.status === 'active') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400 font-medium">Active</span>
              <% } else if(b.status === 'cancelled') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400 font-medium">Cancelled</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-gray-500/20 text-gray-400"><%= b.status %></span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-center text-gray-400 text-xs">
              <%= b.created_at ? new Date(b.created_at).toLocaleDateString() : '—' %>
            </td>
            <td class="px-6 py-4 text-center">
              <% if(b.status === 'active') { %>
                <form action="/admin/bonuses/<%= b.id %>/cancel" method="POST" onsubmit="return confirm('Cancel this bonus?')">
                  <button type="submit" 
                          class="px-4 py-1.5 text-xs bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium transition-all">
                    Cancel
                  </button>
                </form>
              <% } else { %>
                <span class="text-gray-500 text-xs">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (bonuses.length === 0) { %>
      <div class="text-center py-16 text-gray-500">
        <p>No bonuses found.</p>
      </div>
    <% } %>

  </main>
</div>

<!-- Add Bonus Modal -->
<div id="addBonusModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
  <div class="bg-[#1e2937] border border-[#334155] rounded-3xl w-full max-w-md mx-4 p-6">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-xl font-semibold text-white">Give New Bonus</h3>
      <button onclick="hideAddBonusModal()" class="text-gray-400 hover:text-white">✕</button>
    </div>

    <form action="/admin/bonuses/add" method="POST">
      <div class="space-y-5">
        <div>
          <label class="block text-sm text-gray-400 mb-1.5">Username or User ID</label>
          <input type="text" name="user_identifier" required
                 class="w-full bg-[#0f172a] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-400 mb-1.5">Bonus Type</label>
            <select name="bonus_type" required class="w-full bg-[#0f172a] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm">
              <option value="welcome">Welcome Bonus</option>
              <option value="deposit">Deposit Bonus</option>
              <option value="referral">Referral Bonus</option>
              <option value="special">Special Bonus</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1.5">Amount (৳)</label>
            <input type="number" name="amount" required min="1"
                   class="w-full bg-[#0f172a] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500">
          </div>
        </div>

        <div>
          <label class="block text-sm text-gray-400 mb-1.5">Note / Reason (optional)</label>
          <textarea name="note" rows="2" 
                    class="w-full bg-[#0f172a] border border-[#334155] text-white rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-emerald-500"></textarea>
        </div>
      </div>

      <div class="flex gap-3 mt-8">
        <button type="button" onclick="hideAddBonusModal()"
                class="flex-1 py-3 rounded-2xl bg-[#334155] hover:bg-[#475569] text-white text-sm font-medium transition-all">
          Cancel
        </button>
        <button type="submit"
                class="flex-1 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-all">
          Give Bonus
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function filterBonuses() {
  const search = document.getElementById('searchInput').value.toLowerCase();
  const typeFilter = document.getElementById('typeFilter').value.toLowerCase();
  const statusFilter = document.getElementById('statusFilter').value.toLowerCase();

  const rows = document.querySelectorAll('#bonusesTable tbody tr');

  rows.forEach(row => {
    const username = row.getAttribute('data-username') || '';
    const type = row.getAttribute('data-type') || '';
    const status = row.getAttribute('data-status') || '';

    const matchesSearch = username.includes(search);
    const matchesType = !typeFilter || type === typeFilter;
    const matchesStatus = !statusFilter || status === statusFilter;

    if (matchesSearch && matchesType && matchesStatus) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function exportToCSV() {
  const table = document.getElementById('bonusesTable');
  let csv = [];
  const rows = table.querySelectorAll('tr');

  rows.forEach(row => {
    if (row.style.display === 'none') return;
    const cols = row.querySelectorAll('th, td');
    let rowData = [];
    cols.forEach(col => {
      let text = col.innerText.trim().replace(/"/g, '""');
      rowData.push(`"${text}"`);
    });
    csv.push(rowData.join(','));
  });

  const csvContent = csv.join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  const url = URL.createObjectURL(blob);
  link.setAttribute('href', url);
  link.setAttribute('download', 'bonuses_export.csv');
  link.style.visibility = 'hidden';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

function showAddBonusModal() {
  document.getElementById('addBonusModal').classList.remove('hidden');
  document.getElementById('addBonusModal').classList.add('flex');
}

function hideAddBonusModal() {
  document.getElementById('addBonusModal').classList.remove('flex');
  document.getElementById('addBonusModal').classList.add('hidden');
}
</script>

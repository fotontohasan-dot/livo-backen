<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white">Bonuses</h1>
        <p class="text-gray-400 text-sm mt-1">Manage user bonuses</p>
      </div>
    </div>

    <!-- Bonuses Table -->
    <div class="bg-[#1e2937] rounded-3xl border border-[#334155] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[#0f172a]">
          <tr class="text-gray-400">
            <th class="text-left px-6 py-4 font-normal">User</th>
            <th class="text-left px-4 py-4 font-normal">Type</th>
            <th class="text-right px-4 py-4 font-normal">Amount</th>
            <th class="text-center px-4 py-4 font-normal">Status</th>
            <th class="text-center px-6 py-4 font-normal">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#334155] text-gray-300">
          <% bonuses.forEach(b => { %>
          <tr class="hover:bg-[#0f172a]">
            <td class="px-6 py-4 font-medium text-white"><%= b.username %></td>
            <td class="px-4 py-4">
              <span class="px-3 py-1 text-xs rounded-full bg-[#334155]"><%= b.bonus_type %></span>
            </td>
            <td class="px-4 py-4 text-right font-bold text-emerald-400">৳<%= b.amount %></td>
            <td class="px-4 py-4 text-center">
              <% if(b.status === 'active') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Active</span>
              <% } else if(b.status === 'cancelled') { %>
                <span class="px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">Cancelled</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs rounded-full bg-gray-500/20 text-gray-400"><%= b.status %></span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-center">
              <% if(b.status === 'active') { %>
                <form action="/admin/bonuses/<%= b.id %>/cancel" method="POST">
                  <button type="submit" class="px-4 py-1.5 bg-red-600 hover:bg-red-700 rounded-xl text-xs text-white">Cancel</button>
                </form>
              <% } else { %>
                <span class="text-gray-500 text-xs">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (bonuses.length === 0) { %>
      <div class="text-center py-12 text-gray-500">
        No bonuses found.
      </div>
    <% } %>

  </main>
</div>

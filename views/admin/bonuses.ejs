<%- include('../partials/head') %>
<div class="admin-wrap">
  <%- include('./partials/sidebar', { active: 'bonuses' }) %>
  <div class="admin-content">
    <div class="admin-topbar">
      <button class="admin-hamburger" onclick="toggleAdminSidebar()"><i class="fas fa-bars"></i></button>
      <h1 style="font-size:18px;font-weight:800;color:#fff;">🎁 বোনাস ম্যানেজমেন্ট</h1>
    </div>
    <%- include('../partials/flash') %>

    <div style="display:flex;gap:8px;margin-bottom:16px;">
      <a href="/admin/bonuses" style="padding:8px 16px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;background:<%= type === '' ? '#f59e0b' : '#171b23' %>;color:<%= type === '' ? '#000' : '#fff' %>;">সব</a>
      <a href="/admin/bonuses?type=deposit" style="padding:8px 16px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;background:<%= type === 'deposit' ? '#f59e0b' : '#171b23' %>;color:<%= type === 'deposit' ? '#000' : '#fff' %>;">ডিপোজিট বোনাস</a>
      <a href="/admin/bonuses?type=daily" style="padding:8px 16px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;background:<%= type === 'daily' ? '#f59e0b' : '#171b23' %>;color:<%= type === 'daily' ? '#000' : '#fff' %>;">দৈনিক রিওয়ার্ড</a>
    </div>

    <div class="admin-card">
      <div style="overflow-x:auto;">
        <table class="admin-table">
          <thead><tr><th>ইউজার</th><th>টাইপ</th><th>পরিমাণ</th><th>স্পোর্টস টার্নওভার</th><th>ক্যাসিনো টার্নওভার</th><th>স্ট্যাটাস</th><th>তারিখ</th><th>অ্যাকশন</th></tr></thead>
          <tbody>
            <% bonuses.forEach(function(b) { %>
              <tr>
                <td><%= b.username %></td>
                <td><%= b.bonus_type === 'deposit' ? 'ডিপোজিট' : 'দৈনিক' %></td>
                <td style="color:#f59e0b;">৳<%= b.bonus_amount %></td>
                <td><%= Number(b.sports_done).toFixed(0) %> / <%= Number(b.sports_required).toFixed(0) %></td>
                <td><%= Number(b.casino_done).toFixed(0) %> / <%= Number(b.casino_required).toFixed(0) %></td>
                <td>
                  <% if (b.status === 'active') { %><span class="badge badge-amber">চলমান</span>
                  <% } else if (b.status === 'completed') { %><span class="badge badge-green">সম্পন্ন</span>
                  <% } else { %><span class="badge badge-red">বাতিল</span><% } %>
                </td>
                <td style="font-size:11px;color:#64748b;"><%= new Date(b.created_at).toLocaleDateString('bn-BD') %></td>
                <td>
                  <% if (b.status === 'active') { %>
                    <form method="POST" action="/admin/bonuses/<%= b.id %>/cancel" onsubmit="return confirm('বাতিল করবেন?')">
                      <button type="submit" style="background:rgba(239,68,68,0.15);color:#ef4444;border:none;padding:5px 10px;border-radius:6px;font-size:10px;font-weight:700;">বাতিল করুন</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }) %>
            <% if (!bonuses.length) { %><tr><td colspan="8" style="text-align:center;color:#64748b;">কোনো বোনাস নেই</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

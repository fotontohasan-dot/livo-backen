<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_title_bonuses') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Segoe UI', 'Hind Siliguri', sans-serif; background: #0f1115; }
  </style>
  <%- include('./partials/pwa-head') %>
</head>
<body>
  <div class="admin-wrap">
    <%- include('./partials/sidebar', { active: 'bonuses' }) %>
    <div class="admin-content">
      <%- include('./partials/load-error') %>
      <%- include('./partials/header', { pageTitle: 'বোনাস ম্যানেজমেন্ট', pageSubtitle: 'ইউজারদের ম্যানুয়াল বোনাস দিন ও পরিচালনা করুন' }) %>

      <div class="grid grid-4" style="margin-bottom:14px;">
        <div class="stat-card"><div class="stat-label"><%= t('admin_status_active') %></div><div class="stat-number" style="color:#f59e0b;"><%= stats.active || 0 %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_status_completed') %></div><div class="stat-number" style="color:#10b981;"><%= stats.completed || 0 %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_btn_cancel') %></div><div class="stat-number" style="color:#ef4444;"><%= stats.cancelled || 0 %></div></div>
        <div class="stat-card"><div class="stat-label"><%= t('admin_stat_active_bonus_amount') %></div><div class="stat-number"><%= stats.total_active_amount || 0 %></div></div>
      </div>

      <div class="admin-card" style="padding:16px;margin-bottom:16px;">
        <div style="font-weight:800;color:var(--text-main);font-size:13px;margin-bottom:12px;"><i class="fas fa-gift" style="color:#f59e0b;"></i> <%= t('admin_bonus_grant_heading') %></div>
        <form method="POST" action="/admin/bonuses/add" style="display:grid;grid-template-columns:1fr;gap:10px;">
          <input class="input" type="text" name="username" placeholder="<%= t('admin_col_username') %>" required>
          <select class="select" name="bonus_type" required>
            <option value="deposit"><%= t('admin_bonus_type_deposit') %></option>
            <option value="signup"><%= t('admin_bonus_type_signup') %></option>
            <option value="referral"><%= t('admin_bonus_type_referral') %></option>
            <option value="special"><%= t('admin_bonus_type_special') %></option>
          </select>
          <input class="input" type="number" name="bonus_amount" placeholder="<%= t('admin_field_bonus_amount_coins') %>" required>
          <input class="input" type="number" name="sports_required" placeholder="<%= t('admin_field_sports_turnover_req') %>">
          <input class="input" type="number" name="casino_required" placeholder="<%= t('admin_field_casino_turnover_req') %>">
          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> <%= t('admin_bonus_grant_btn') %></button>
        </form>
      </div>

      <div class="admin-card">
        <div class="admin-card-header"><%= t('admin_bonus_all') %></div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead><tr><th><%= t('admin_col_user') %></th><th><%= t('admin_col_type') %></th><th><%= t('admin_col_amount') %></th><th><%= t('admin_col_turnover_sports_casino') %></th><th><%= t('admin_col_status') %></th><th><%= t('admin_col_date') %></th><th style="text-align:right;"><%= t('admin_col_action') %></th></tr></thead>
            <tbody>
              <% if (bonuses && bonuses.length > 0) { %>
                <% bonuses.forEach(b => { %>
                  <tr>
                    <td style="font-weight:700;">@<%= b.username || 'N/A' %></td>
                    <td><%= b.bonus_type %></td>
                    <td><%= b.bonus_amount %></td>
                    <td><%= b.sports_done || 0 %>/<%= b.sports_required || 0 %> · <%= b.casino_done || 0 %>/<%= b.casino_required || 0 %></td>
                    <td>
                      <% if (b.status === 'active') { %><span class="badge badge-amber"><%= t('admin_status_active') %></span>
                      <% } else if (b.status === 'completed') { %><span class="badge badge-green"><%= t('admin_status_completed') %></span>
                      <% } else { %><span class="badge badge-red"><%= t('admin_btn_cancel') %></span><% } %>
                    </td>
                    <td><%= b.created_at ? new Date(b.created_at).toLocaleDateString('bn-BD') : '—' %></td>
                    <td style="text-align:right;">
                      <% if (b.status === 'active') { %>
                        <form method="POST" action="/admin/bonuses/<%= b.id %>/cancel" data-confirm="বাতিল করবেন?">
                          <button class="btn btn-sm btn-red" type="submit"><%= t('admin_btn_cancel') %></button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7"><div class="empty-state"><%= t('admin_empty_bonuses') %></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<%- include('../partials/head') %>
<%- include('../partials/admin-header') %>

<div class="flex min-h-screen bg-[#0f172a]">
  <%- include('../partials/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-auto">
    
    <!-- Back Button + Header -->
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin/users" class="flex items-center justify-center w-10 h-10 bg-[#1e2937] hover:bg-[#334155] rounded-2xl text-gray-300">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div>
        <h1 class="text-3xl font-bold text-white"><%= u.username %></h1>
        <p class="text-gray-400 text-sm">User ID: <%= u.id %> • Joined <%= new Date(u.created_at).toLocaleDateString() %></p>
      </div>
      <div class="ml-auto">
        <% if(u.is_banned) { %>
          <span class="px-4 py-1.5 bg-red-500/20 text-red-400 text-sm rounded-2xl">Banned</span>
        <% } else { %>
          <span class="px-4 py-1.5 bg-emerald-500/20 text-emerald-400 text-sm rounded-2xl">Active</span>
        <% } %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Left Column: User Info + Actions -->
      <div class="lg:col-span-1 space-y-6">
        
        <!-- Basic Info Card -->
        <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
          <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
            <i class="fas fa-user text-[#f59e0b]"></i> 
            <span>Basic Information</span>
          </h3>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between"><span class="text-gray-400">Username</span> <span class="font-medium text-white"><%= u.username %></span></div>
            <div class="flex justify-between"><span class="text-gray-400">Email</span> <span class="font-medium text-white"><%= u.email || '-' %></span></div>
            <div class="flex justify-between"><span class="text-gray-400">Phone</span> <span class="font-medium text-white"><%= u.phone || '-' %></span></div>
            <div class="flex justify-between"><span class="text-gray-400">Coins</span> <span class="font-bold text-emerald-400">৳<%= u.coins || 0 %></span></div>
            <div class="flex justify-between"><span class="text-gray-400">Total Points</span> <span class="font-medium text-white"><%= u.total_points || 0 %></span></div>
            <div class="flex justify-between"><span class="text-gray-400">KYC Status</span> <span class="font-medium"><%= u.kyc_status || 'Not Submitted' %></span></div>
          </div>
        </div>

        <!-- Financial Summary -->
        <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
          <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
            <i class="fas fa-wallet text-[#f59e0b]"></i> 
            <span>Financial Summary</span>
          </h3>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div class="bg-[#0f172a] rounded-2xl p-4">
              <div class="text-gray-400 text-xs">Total Deposit</div>
              <div class="text-xl font-bold text-emerald-400 mt-1">৳<%= stats.totalDeposit || 0 %></div>
            </div>
            <div class="bg-[#0f172a] rounded-2xl p-4">
              <div class="text-gray-400 text-xs">Total Withdraw</div>
              <div class="text-xl font-bold text-red-400 mt-1">৳<%= stats.totalWithdraw || 0 %></div>
            </div>
            <div class="bg-[#0f172a] rounded-2xl p-4">
              <div class="text-gray-400 text-xs">Total Bet Amount</div>
              <div class="text-xl font-bold text-white mt-1">৳<%= stats.totalBet || 0 %></div>
            </div>
            <div class="bg-[#0f172a] rounded-2xl p-4">
              <div class="text-gray-400 text-xs">Total Bets</div>
              <div class="text-xl font-bold text-white mt-1"><%= stats.betCount || 0 %></div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
          <h3 class="font-semibold text-white mb-4">Quick Actions</h3>
          
          <div class="space-y-3">
            <!-- Ban/Unban -->
            <form action="/admin/users/<%= u.id %>/ban" method="POST">
              <button type="submit" class="w-full py-3 rounded-2xl text-sm font-medium <%= u.is_banned ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-red-600 hover:bg-red-700' %> text-white">
                <%= u.is_banned ? 'Unban User' : 'Ban User' %>
              </button>
            </form>

            <!-- Add Coins -->
            <form action="/admin/users/<%= u.id %>/coins/add" method="POST" class="flex gap-2">
              <input type="number" name="amount" placeholder="Amount" class="flex-1 bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm" required>
              <button type="submit" class="px-5 bg-emerald-600 hover:bg-emerald-700 rounded-2xl text-sm font-medium">Add</button>
            </form>

            <!-- Remove Coins -->
            <form action="/admin/users/<%= u.id %>/coins/remove" method="POST" class="flex gap-2">
              <input type="number" name="amount" placeholder="Amount" class="flex-1 bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm" required>
              <button type="submit" class="px-5 bg-red-600 hover:bg-red-700 rounded-2xl text-sm font-medium">Remove</button>
            </form>

            <!-- Freebet -->
            <form action="/admin/users/<%= u.id %>/freebet" method="POST" class="flex gap-2">
              <input type="number" name="amount" placeholder="Freebet Amount" class="flex-1 bg-[#0f172a] border border-[#475569] rounded-2xl px-4 py-3 text-sm" required>
              <button type="submit" class="px-5 bg-[#f59e0b] hover:bg-[#d97706] text-black rounded-2xl text-sm font-medium">Give Freebet</button>
            </form>
          </div>
        </div>

      </div>

      <!-- Right Column: History Tables -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Recent Bets -->
        <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
          <h3 class="font-semibold text-white mb-4">Recent Bets</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-gray-400 border-b border-[#334155]">
                  <th class="text-left pb-3">Match</th>
                  <th class="text-right pb-3">Stake</th>
                  <th class="text-right pb-3">Odd</th>
                  <th class="text-center pb-3">Status</th>
                </tr>
              </thead>
              <tbody class="text-gray-300">
                <% bets.forEach(b => { %>
                <tr class="border-b border-[#334155] last:border-none">
                  <td class="py-3 text-xs"><%= b.match_title || 'N/A' %></td>
                  <td class="py-3 text-right font-medium">৳<%= b.stake %></td>
                  <td class="py-3 text-right"><%= b.odd %></td>
                  <td class="py-3 text-center">
                    <% if(b.status === 'won') { %>
                      <span class="px-3 py-0.5 text-xs rounded-full bg-emerald-500/20 text-emerald-400">Won</span>
                    <% } else if(b.status === 'lost') { %>
                      <span class="px-3 py-0.5 text-xs rounded-full bg-red-500/20 text-red-400">Lost</span>
                    <% } else { %>
                      <span class="px-3 py-0.5 text-xs rounded-full bg-yellow-500/20 text-yellow-400">Pending</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Coin Transactions -->
        <div class="bg-[#1e2937] rounded-3xl border border-[#334155] p-6">
          <h3 class="font-semibold text-white mb-4">Coin Transactions</h3>
          <div class="overflow-x-auto max-h-[280px]">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-gray-400 border-b border-[#334155]">
                  <th class="text-left pb-3">Type</th>
                  <th class="text-right pb-3">Amount</th>
                  <th class="text-left pb-3">Description</th>
                  <th class="text-right pb-3">Date</th>
                </tr>
              </thead>
              <tbody class="text-gray-300">
                <% transactions.forEach(t => { %>
                <tr class="border-b border-[#334155] last:border-none">
                  <td class="py-2.5"><%= t.type %></td>
                  <td class="py-2.5 text-right font-medium <%= t.amount > 0 ? 'text-emerald-400' : 'text-red-400' %>">
                    <%= t.amount > 0 ? '+' : '' %><%= t.amount %>
                  </td>
                  <td class="py-2.5 text-xs"><%= t.description || '-' %></td>
                  <td class="py-2.5 text-right text-xs text-gray-500"><%= new Date(t.created_at).toLocaleDateString() %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>

  </main>
</div>

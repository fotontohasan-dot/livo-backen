<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details • Livo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-950 text-white">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { activePage: 'users' }) %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            <!-- Header -->
            <%- include('../partials/header', { 
                pageTitle: 'User Details', 
                pageSubtitle: 'View and manage user information' 
            }) %>

            <div class="p-6">
                <!-- Back Button -->
                <a href="/admin/users" class="inline-flex items-center gap-2 text-slate-400 hover:text-white mb-6 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Users</span>
                </a>

                <!-- User Header Card -->
                <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 mb-6">
                    <div class="flex flex-col md:flex-row md:items-center gap-6">
                        <div class="flex-shrink-0">
                            <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center text-3xl font-bold">
                                <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
                            </div>
                        </div>

                        <div class="flex-1">
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-3">
                                        <h1 class="text-3xl font-bold"><%= user.username || 'Unknown User' %></h1>
                                        <button onclick="copyUserId()" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs flex items-center gap-2 transition-colors">
                                            <i class="fas fa-copy"></i>
                                            <span><%= user.id %></span>
                                        </button>
                                    </div>
                                    <p class="text-slate-400 mt-1"><%= user.email || 'No email' %></p>
                                </div>

                                <div class="flex items-center gap-3">
                                    <% if (user.is_banned) { %>
                                        <span class="px-4 py-2 bg-red-500/10 text-red-400 rounded-2xl text-sm font-medium flex items-center gap-2">
                                            <i class="fas fa-ban"></i> Banned
                                        </span>
                                    <% } else { %>
                                        <span class="px-4 py-2 bg-emerald-500/10 text-emerald-400 rounded-2xl text-sm font-medium flex items-center gap-2">
                                            <i class="fas fa-check-circle"></i> Active
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-5">
                        <div class="text-slate-400 text-sm">Current Balance</div>
                        <div class="text-3xl font-bold mt-1 text-emerald-400">৳ <%= (user.balance || 0).toLocaleString() %></div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-5">
                        <div class="text-slate-400 text-sm">Total Deposit</div>
                        <div class="text-3xl font-bold mt-1">৳ <%= (user.total_deposit || 0).toLocaleString() %></div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-5">
                        <div class="text-slate-400 text-sm">Total Bet Volume</div>
                        <div class="text-3xl font-bold mt-1">৳ <%= (user.total_bet_volume || 0).toLocaleString() %></div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-5">
                        <div class="text-slate-400 text-sm">Joined</div>
                        <div class="text-xl font-semibold mt-1"><%= new Date(user.created_at).toLocaleDateString() %></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Profile Information -->
                    <div class="lg:col-span-2 bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <h3 class="font-semibold text-lg mb-5 flex items-center gap-2">
                            <i class="fas fa-user text-blue-400"></i> Profile Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 text-sm">
                            <div><div class="text-slate-400">Full Name</div><div class="font-medium mt-1"><%= user.full_name || 'Not provided' %></div></div>
                            <div><div class="text-slate-400">Phone Number</div><div class="font-medium mt-1"><%= user.phone || 'Not provided' %></div></div>
                            <div><div class="text-slate-400">Username</div><div class="font-medium mt-1"><%= user.username %></div></div>
                            <div><div class="text-slate-400">Email</div><div class="font-medium mt-1"><%= user.email || 'Not provided' %></div></div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6">
                        <h3 class="font-semibold text-lg mb-5 flex items-center gap-2">
                            <i class="fas fa-bolt text-amber-400"></i> Quick Actions
                        </h3>
                        <div class="space-y-3">
                            <button onclick="showAddCoinsModal()" class="w-full flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-700 transition-colors py-3 rounded-2xl font-medium">
                                <i class="fas fa-plus-circle"></i> <span>Add Coins</span>
                            </button>
                            <button onclick="showBanModal()" class="w-full flex items-center justify-center gap-3 bg-red-600 hover:bg-red-700 transition-colors py-3 rounded-2xl font-medium">
                                <i class="fas fa-ban"></i> <span>Ban User</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Simple Add Coins Modal -->
    <div id="addCoinsModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
        <div class="bg-slate-900 border border-slate-700 rounded-3xl w-full max-w-md p-6">
            <h3 class="text-xl font-semibold mb-4">Add Coins</h3>
            <form action="/admin/users/<%= user.id %>/add-coins" method="POST">
                <div class="mb-4">
                    <label class="block text-sm text-slate-400 mb-2">Amount</label>
                    <input type="number" name="amount" class="w-full bg-slate-800 border border-slate-700 rounded-2xl px-4 py-3" placeholder="Enter amount" required>
                </div>
                <div class="flex gap-3">
                    <button type="button" onclick="hideModal('addCoinsModal')" class="flex-1 py-3 rounded-2xl border border-slate-700">Cancel</button>
                    <button type="submit" class="flex-1 py-3 rounded-2xl bg-emerald-600">Add Coins</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function copyUserId() { navigator.clipboard.writeText('<%= user.id %>'); alert('User ID copied!'); }
        function showAddCoinsModal() { document.getElementById('addCoinsModal').classList.remove('hidden'); document.getElementById('addCoinsModal').classList.add('flex'); }
        function hideModal(id) { document.getElementById(id).classList.remove('flex'); document.getElementById(id).classList.add('hidden'); }
        function showBanModal() { if(confirm('Ban this user?')) window.location.href = '/admin/users/<%= user.id %>/ban'; }
    </script>
</body>
</html>

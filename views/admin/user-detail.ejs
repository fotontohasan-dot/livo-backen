<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function fmtDate(d) { return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); }
function betRow(b) {
  const color = b.status === 'won' ? 'text-emerald-600' : b.status === 'lost' ? 'text-red-600' : 'text-amber-600';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm">' + escapeHtml(b.match_title || '-') + '</td>' +
    '<td class="px-4 py-2.5 text-sm">৳ ' + Number(b.stake).toLocaleString('en-US') + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-mono">' + Number(b.odd).toFixed(2) + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-semibold ' + color + '">' + escapeHtml(b.status) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(b.created_at) + '</td></tr>';
}
function paymentRow(p) {
  const color = p.status === 'approved' ? 'text-emerald-600' : p.status === 'rejected' ? 'text-red-600' : 'text-amber-600';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm capitalize">' + escapeHtml(p.type) + '</td>' +
    '<td class="px-4 py-2.5 text-sm">৳ ' + Number(p.amount).toLocaleString('en-US') + '</td>' +
    '<td class="px-4 py-2.5 text-sm">' + escapeHtml(p.method || '-') + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-semibold ' + color + '">' + escapeHtml(p.status) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(p.created_at) + '</td></tr>';
}
function ipRow(s) {
  return '<a href="/admin/users/' + s.id + '" class="block px-4 py-2.5 text-sm border-b border-slate-100 hover:bg-slate-50">' + escapeHtml(s.username) + ' <span class="text-slate-400 text-xs">(' + escapeHtml(s.email || '-') + ')</span></a>';
}
const betsHtml = (bets || []).map(betRow).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">কোনো বেট নেই</td></tr>';
const paymentsHtml = (payments || []).map(paymentRow).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">কোনো পেমেন্ট নেই</td></tr>';
const sameIpHtml = (sameIp || []).map(ipRow).join('') || '<div class="px-4 py-4 text-center text-slate-400 text-xs">একই আইপিতে অন্য কোনো ইউজার নেই</div>';
const banLabel = u.is_banned ? 'Unban ইউজার' : 'Ban ইউজার';
const banColor = u.is_banned ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-red-600 hover:bg-red-700';
%>
<%- include('partials/admin-layout', {
    title: 'User Details',
    active: 'users',
    body: `
<div class="max-w-6xl mx-auto">
    <a href="/admin/users" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-800 mb-5 text-sm">
        <i class="fas fa-arrow-left"></i><span>Back to Users</span>
    </a>

    <div class="bg-white border border-slate-100 rounded-3xl p-6 mb-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center text-3xl font-bold text-white flex-shrink-0">
                ${(u.username || 'U').charAt(0).toUpperCase()}
            </div>
            <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">${escapeHtml(u.username)}</h1>
                        <p class="text-slate-500 mt-1 text-sm">#${u.id} • ${escapeHtml(u.email || u.phone || 'যোগাযোগের তথ্য নেই')}</p>
                    </div>
                    <span class="px-4 py-2 rounded-2xl text-sm font-semibold ${u.is_banned ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-600'}">
                        ${u.is_banned ? '🚫 Banned' : '✅ Active'}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">বর্তমান কয়েন</div><div class="text-2xl font-bold mt-1 text-emerald-600">৳ ${Number(u.coins || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">মোট ডিপোজিট</div><div class="text-2xl font-bold mt-1">৳ ${Number(stats.totalDeposit || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">মোট বেট (${stats.betCount || 0})</div><div class="text-2xl font-bold mt-1">৳ ${Number(stats.totalBet || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">যোগ দিয়েছেন</div><div class="text-lg font-semibold mt-1">${fmtDate(u.created_at)}</div></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white border border-slate-100 rounded-3xl p-6">
                <h3 class="font-semibold text-slate-800 mb-4"><i class="fas fa-user text-blue-500 mr-2"></i>প্রোফাইল তথ্য</h3>
                <div class="grid grid-cols-2 gap-y-4 text-sm">
                    <div><div class="text-slate-400 text-xs">পূর্ণ নাম</div><div class="font-medium mt-0.5">${escapeHtml(u.full_name || 'দেওয়া হয়নি')}</div></div>
                    <div><div class="text-slate-400 text-xs">ফোন</div><div class="font-medium mt-0.5">${escapeHtml(u.phone || 'দেওয়া হয়নি')}</div></div>
                    <div><div class="text-slate-400 text-xs">ইমেইল</div><div class="font-medium mt-0.5">${escapeHtml(u.email || 'দেওয়া হয়নি')}</div></div>
                    <div><div class="text-slate-400 text-xs">রেফারেল</div><div class="font-medium mt-0.5">${referralCount} জনকে রেফার করেছেন</div></div>
                    <div><div class="text-slate-400 text-xs">শেষ লগইন IP</div><div class="font-medium mt-0.5">${escapeHtml(u.last_ip || '-')}</div></div>
                    <div><div class="text-slate-400 text-xs">KYC স্ট্যাটাস</div><div class="font-medium mt-0.5 capitalize">${escapeHtml(u.kyc_status || 'none')}</div></div>
                </div>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-dice text-purple-500 mr-2"></i>সাম্প্রতিক বেট</h3>
                <table class="w-full"><tbody>${betsHtml}</tbody></table>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-wallet text-emerald-500 mr-2"></i>পেমেন্ট হিস্ট্রি</h3>
                <table class="w-full"><tbody>${paymentsHtml}</tbody></table>
            </div>

            ${(sameIp && sameIp.length) ? `
            <div class="bg-white border border-amber-200 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-amber-700 px-6 pt-6 pb-3"><i class="fas fa-exclamation-triangle mr-2"></i>একই IP-তে অন্য অ্যাকাউন্ট (${sameIp.length})</h3>
                <div>${sameIpHtml}</div>
            </div>` : ''}
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl p-6 h-fit">
            <h3 class="font-semibold text-slate-800 mb-4"><i class="fas fa-bolt text-amber-500 mr-2"></i>দ্রুত অ্যাকশন</h3>
            <div class="space-y-3">
                <form method="POST" action="/admin/users/${u.id}/coins/add" class="flex gap-2">
                    <input type="number" name="amount" placeholder="পরিমাণ" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-emerald-600 text-white rounded-xl text-sm font-semibold">+ যোগ</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/coins/remove" class="flex gap-2">
                    <input type="number" name="amount" placeholder="পরিমাণ" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-orange-500 text-white rounded-xl text-sm font-semibold">− কমান</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/freebet" class="flex gap-2">
                    <input type="number" name="amount" placeholder="ফ্রি বেট (৳)" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-blue-600 text-white rounded-xl text-sm font-semibold">🎁</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/ban" onsubmit="return confirm('${banLabel} করবেন?')">
                    <button type="submit" class="w-full py-3 rounded-2xl font-medium text-white ${banColor}">
                        <i class="fas fa-ban mr-1.5"></i>${banLabel}
                    </button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/delete" onsubmit="return confirm('এই ইউজার স্থায়ীভাবে ডিলিট করবেন? এটা আর ফেরত আনা যাবে না!')">
                    <button type="submit" class="w-full py-3 rounded-2xl font-medium text-red-600 bg-red-50 hover:bg-red-100">
                        <i class="fas fa-trash mr-1.5"></i>ইউজার ডিলিট করুন
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
`
}) %>

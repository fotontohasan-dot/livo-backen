<%
function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function fmtDate(d) { return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); }
function betRow(b) {
  const color = b.status === 'won' ? 'text-emerald-600' : b.status === 'lost' ? 'text-red-600' : 'text-amber-600';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm">' + escapeHtml(b.match_title || '-') + '</td>' +
    '<td class="px-4 py-2.5 text-sm">৳ ' + Number(b.stake).toLocaleString('en-US') + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-mono">' + Number(b.odd).toFixed(2) + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-semibold ' + color + '">' + escapeHtml(b.status) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(b.created_at) + '</td></tr>';
}
function paymentRow(p) {
  const color = p.status === 'approved' ? 'text-emerald-600' : p.status === 'rejected' ? 'text-red-600' : 'text-amber-600';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm capitalize">' + escapeHtml(p.type) + '</td>' +
    '<td class="px-4 py-2.5 text-sm">৳ ' + Number(p.amount).toLocaleString('en-US') + '</td>' +
    '<td class="px-4 py-2.5 text-sm">' + escapeHtml(p.method || '-') + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-semibold ' + color + '">' + escapeHtml(p.status) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(p.created_at) + '</td></tr>';
}
function ipRow(s) {
  return '<a href="/admin/users/' + s.id + '" class="block px-4 py-2.5 text-sm border-b border-slate-100 hover:bg-slate-50">' + escapeHtml(s.username) + ' <span class="text-slate-400 text-xs">(' + escapeHtml(s.email || '-') + ')</span></a>';
}
function loginHistRow(l) {
  const newBadge = l.is_new_device ? '<span class="px-2 py-0.5 text-[10px] font-bold rounded bg-amber-50 text-amber-600 border border-amber-200 ml-2">NEW</span>' : '';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm">' + escapeHtml(l.browser) + ' · ' + escapeHtml(l.os) + newBadge + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-mono">' + escapeHtml(l.ip) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(l.created_at) + '</td></tr>';
}
function deviceSessRow(d) {
  const badge = d.is_new_device ? '<span class="px-2 py-0.5 text-[10px] font-bold rounded bg-amber-50 text-amber-600 border border-amber-200 ml-2">NEW</span>' : '';
  return '<tr class="border-b border-slate-100"><td class="px-4 py-2.5 text-sm">' + escapeHtml(d.device_name || '-') + badge + '</td>' +
    '<td class="px-4 py-2.5 text-sm font-mono">' + escapeHtml(d.ip) + '</td>' +
    '<td class="px-4 py-2.5 text-xs text-slate-400">' + fmtDate(d.last_activity) + '</td></tr>';
}
function fraudRow(fl) {
  const riskColor = fl.risk_level === 'high' ? 'bg-red-100 text-red-700' : fl.risk_level === 'medium' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600';
  const statusColor = fl.status === 'open' ? 'bg-blue-100 text-blue-700' : fl.status === 'reviewed' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500';
  const actions = fl.status === 'open'
    ? '<div class="flex gap-1.5 mt-2">' +
        '<form method="POST" action="/admin/fraud-logs/' + fl.id + '/review" style="display:inline"><input type="hidden" name="action" value="reviewed"><button type="submit" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white">Reviewed</button></form>' +
        '<form method="POST" action="/admin/fraud-logs/' + fl.id + '/review" style="display:inline"><input type="hidden" name="action" value="dismiss"><button type="submit" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-400 hover:bg-slate-500 text-white">Dismiss</button></form>' +
      '</div>'
    : '';
  return '<div class="px-6 py-4 border-b border-slate-100">' +
    '<div class="flex items-center gap-2 flex-wrap">' +
      '<span class="px-2.5 py-1 text-xs font-bold rounded-full ' + riskColor + '">' + escapeHtml((fl.risk_level || '').toUpperCase()) + '</span>' +
      '<span class="px-2.5 py-1 text-xs font-semibold rounded-full ' + statusColor + '">' + escapeHtml(fl.status) + '</span>' +
      '<span class="text-xs text-slate-400">' + fmtDate(fl.created_at) + '</span>' +
    '</div>' +
    '<div class="text-sm text-slate-600 mt-1.5">' + escapeHtml(fl.reason) + '</div>' +
    actions +
  '</div>';
}
const betsHtml = (bets || []).map(betRow).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">কোনো বেট নেই</td></tr>';
const paymentsHtml = (payments || []).map(paymentRow).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 text-sm">কোনো পেমেন্ট নেই</td></tr>';
const sameIpHtml = (sameIp || []).map(ipRow).join('') || '<div class="px-4 py-4 text-center text-slate-400 text-xs">একই আইপিতে অন্য কোনো ইউজার নেই</div>';
const fraudFlagsHtml = ((fraudStatus && fraudStatus.flags) || []).map(fraudRow).join('') || '<div class="px-6 py-4 text-center text-slate-400 text-xs">কোনো ফ্রড ফ্ল্যাগ নেই</div>';
const riskLevel = (fraudStatus && fraudStatus.currentRiskLevel) || 'none';
const riskHeaderColor = riskLevel === 'high' ? 'bg-red-100 text-red-700' : riskLevel === 'medium' ? 'bg-amber-100 text-amber-700' : riskLevel === 'low' ? 'bg-slate-100 text-slate-600' : 'bg-emerald-100 text-emerald-700';
const riskHeaderLabel = riskLevel === 'none' ? 'ঝুঁকিমুক্ত' : riskLevel.toUpperCase() + ' ঝুঁকি';

const loginHistRows = ((deviceOverview && deviceOverview.recentLogins) || []).map(loginHistRow).join('') || '<tr><td colspan="3" class="px-4 py-6 text-center text-slate-400 text-xs">কোনো লগইন রেকর্ড নেই</td></tr>';
const deviceSessRows = ((deviceOverview && deviceOverview.activeSessions) || []).map(deviceSessRow).join('') || '<tr><td colspan="3" class="px-4 py-6 text-center text-slate-400 text-xs">কোনো সক্রিয় ডিভাইস নেই</td></tr>';
const banLabel = u.is_banned ? 'Unban ইউজার' : 'Ban ইউজার';
const banColor = u.is_banned ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-red-600 hover:bg-red-700';
%>
<%- include('partials/admin-layout', {
    title: 'User Details',
    active: 'users',
    body: `
<div class="max-w-6xl mx-auto">
    <a href="/admin/users" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-800 mb-5 text-sm">
        <i class="fas fa-arrow-left"></i><span>Back to Users</span>
    </a>

    <div class="bg-white border border-slate-100 rounded-3xl p-6 mb-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center text-3xl font-bold text-white flex-shrink-0">
                ${(u.username || 'U').charAt(0).toUpperCase()}
            </div>
            <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">${escapeHtml(u.username)}</h1>
                        <p class="text-slate-500 mt-1 text-sm">#${u.id} • ${escapeHtml(u.email || u.phone || 'যোগাযোগের তথ্য নেই')}</p>
                    </div>
                    <span class="px-4 py-2 rounded-2xl text-sm font-semibold ${u.is_banned ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-600'}">
                        ${u.is_banned ? '🚫 Banned' : '✅ Active'}
                    </span>
                    <span class="px-4 py-2 rounded-2xl text-sm font-semibold ${riskHeaderColor}">
                        <i class="fas fa-shield-halved mr-1"></i>${riskHeaderLabel}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">বর্তমান কয়েন</div><div class="text-2xl font-bold mt-1 text-emerald-600">৳ ${Number(u.coins || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">মোট ডিপোজিট</div><div class="text-2xl font-bold mt-1">৳ ${Number(stats.totalDeposit || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">মোট বেট (${stats.betCount || 0})</div><div class="text-2xl font-bold mt-1">৳ ${Number(stats.totalBet || 0).toLocaleString('en-US')}</div></div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5"><div class="text-slate-500 text-xs">যোগ দিয়েছেন</div><div class="text-lg font-semibold mt-1">${fmtDate(u.created_at)}</div></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white border border-slate-100 rounded-3xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-semibold text-slate-800"><i class="fas fa-user text-blue-500 mr-2"></i>প্রোফাইল তথ্য</h3>
                    <button type="button" onclick="document.getElementById('editProfileModal').classList.add('show')" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100"><i class="fas fa-pen"></i> এডিট করুন</button>
                </div>
                <div class="grid grid-cols-2 gap-y-4 text-sm">
                    <div><div class="text-slate-400 text-xs">পূর্ণ নাম</div><div class="font-medium mt-0.5">${escapeHtml(u.full_name || 'দেওয়া হয়নি')}</div></div>
                    <div><div class="text-slate-400 text-xs">ফোন</div><div class="font-medium mt-0.5">${escapeHtml(u.phone || 'দেওয়া হয়নি')}</div></div>
                    <div><div class="text-slate-400 text-xs">ইমেইল</div><div class="font-medium mt-0.5">${escapeHtml(u.email || 'দেওয়া হয়নি')} ${u.email ? (u.email_verified ? '<span class="text-emerald-600 text-xs">(ভেরিফায়েড)</span>' : '<span class="text-amber-600 text-xs">(অভেরিফায়েড)</span>') : ''}</div></div>
                    <div><div class="text-slate-400 text-xs">রেফারেল</div><div class="font-medium mt-0.5">${referralCount} জনকে রেফার করেছেন</div></div>
                    <div><div class="text-slate-400 text-xs">শেষ লগইন IP</div><div class="font-medium mt-0.5">${escapeHtml(u.last_ip || '-')}</div></div>
                    <div><div class="text-slate-400 text-xs">KYC স্ট্যাটাস</div><div class="font-medium mt-0.5 capitalize">${escapeHtml(u.kyc_status || 'none')}</div></div>
                    <div>
                        <div class="text-slate-400 text-xs">Withdraw PIN</div>
                        <div class="font-medium mt-0.5">
                            ${pinStatus && pinStatus.configured
                                ? '<span class="text-emerald-600">✅ Configured</span>'
                                : '<span class="text-red-500">❌ Not Configured</span>'}
                            ${pinStatus && pinStatus.locked ? ' <span class="text-amber-600 text-xs">(🔒 Locked)</span>' : ''}
                        </div>
                        ${pinStatus && pinStatus.updatedAt ? `<div class="text-slate-400 text-xs mt-0.5">Last changed: ${fmtDate(pinStatus.updatedAt)}</div>` : ''}
                    </div>
                </div>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-dice text-purple-500 mr-2"></i>সাম্প্রতিক বেট</h3>
                <table class="w-full"><tbody>${betsHtml}</tbody></table>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-wallet text-emerald-500 mr-2"></i>পেমেন্ট হিস্ট্রি</h3>
                <table class="w-full"><tbody>${paymentsHtml}</tbody></table>
            </div>

            ${(sameIp && sameIp.length) ? `
            <div class="bg-white border border-amber-200 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-amber-700 px-6 pt-6 pb-3"><i class="fas fa-exclamation-triangle mr-2"></i>একই IP-তে অন্য অ্যাকাউন্ট (${sameIp.length})</h3>
                <div>${sameIpHtml}</div>
            </div>` : ''}

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <div class="flex items-center justify-between px-6 pt-6 pb-3">
                    <h3 class="font-semibold text-slate-800"><i class="fas fa-shield-halved text-red-500 mr-2"></i>ফ্রড ফ্ল্যাগ (${(fraudStatus && fraudStatus.flags && fraudStatus.flags.length) || 0})</h3>
                    <a href="/admin/fraud-logs?user_id=${u.id}" class="text-xs text-blue-600 hover:underline">সব লগ দেখুন →</a>
                </div>
                <div>${fraudFlagsHtml}</div>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-mobile-screen-button text-indigo-500 mr-2"></i>সক্রিয় ডিভাইস (${(deviceOverview && deviceOverview.activeSessions && deviceOverview.activeSessions.length) || 0})</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead><tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Device</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">IP</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Last Active</th>
                        </tr></thead>
                        <tbody>${deviceSessRows}</tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <h3 class="font-semibold text-slate-800 px-6 pt-6 pb-3"><i class="fas fa-clock-rotate-left text-indigo-500 mr-2"></i>সাম্প্রতিক লগইন হিস্ট্রি</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead><tr class="bg-slate-50 border-b border-slate-100">
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Device</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">IP</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Date</th>
                        </tr></thead>
                        <tbody>${loginHistRows}</tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl p-6 h-fit">
            <h3 class="font-semibold text-slate-800 mb-4"><i class="fas fa-bolt text-amber-500 mr-2"></i>দ্রুত অ্যাকশন</h3>
            <div class="space-y-3">
                <form method="POST" action="/admin/users/${u.id}/coins/add" class="flex gap-2">
                    <input type="number" name="amount" placeholder="পরিমাণ" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-emerald-600 text-white rounded-xl text-sm font-semibold">+ যোগ</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/coins/remove" class="flex gap-2">
                    <input type="number" name="amount" placeholder="পরিমাণ" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-orange-500 text-white rounded-xl text-sm font-semibold">− কমান</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/freebet" class="flex gap-2">
                    <input type="number" name="amount" placeholder="ফ্রি বেট (৳)" required class="flex-1 border px-3 py-2.5 rounded-xl text-sm">
                    <button type="submit" class="px-4 bg-blue-600 text-white rounded-xl text-sm font-semibold">🎁</button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/ban" onsubmit="return confirm('${banLabel} করবেন?')">
                    <button type="submit" class="w-full py-3 rounded-2xl font-medium text-white ${banColor}">
                        <i class="fas fa-ban mr-1.5"></i>${banLabel}
                    </button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/withdraw-pin/reset" onsubmit="return confirm('এই ইউজারের Withdraw PIN রিসেট করবেন? ইউজারকে আবার নতুন PIN সেট করতে হবে।')">
                    <button type="submit" class="w-full py-3 rounded-2xl font-medium text-white bg-purple-600 hover:bg-purple-700">
                        <i class="fas fa-key mr-1.5"></i>Withdraw PIN রিসেট করুন
                    </button>
                </form>
                <form method="POST" action="/admin/users/${u.id}/delete" onsubmit="return confirm('এই ইউজার স্থায়ীভাবে ডিলিট করবেন? এটা আর ফেরত আনা যাবে না!')">
                    <button type="submit" class="w-full py-3 rounded-2xl font-medium text-red-600 bg-red-50 hover:bg-red-100">
                        <i class="fas fa-trash mr-1.5"></i>ইউজার ডিলিট করুন
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="editProfileModal" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);display:none;align-items:center;justify-content:center;z-index:100;padding:16px;">
    <div style="background:#fff;border-radius:20px;width:100%;max-width:420px;">
        <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;">
            <h3 style="font-weight:700;font-size:14px;margin:0;">প্রোফাইল তথ্য এডিট করুন</h3>
            <button type="button" onclick="document.getElementById('editProfileModal').classList.remove('show')" style="background:none;border:none;cursor:pointer;color:#64748b;"><i class="fas fa-times"></i></button>
        </div>
        <form method="POST" action="/admin/users/${u.id}/edit-profile" style="padding:20px;">
            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:600;color:#475569;margin-bottom:5px;">ইউজারনেম</label>
                <input type="text" name="username" value="${escapeHtml(u.username || '')}" required pattern="[A-Za-z0-9_.]{3,20}" title="৩-২০ ক্যারেক্টার, শুধু লেটার/সংখ্যা/আন্ডারস্কোর/ডট" style="width:100%;border:1px solid #e2e8f0;padding:10px 12px;border-radius:10px;font-size:13px;">
            </div>
            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:600;color:#475569;margin-bottom:5px;">ইমেইল</label>
                <input type="email" name="email" value="${escapeHtml(u.email || '')}" style="width:100%;border:1px solid #e2e8f0;padding:10px 12px;border-radius:10px;font-size:13px;">
                <p style="font-size:11px;color:#f59e0b;margin:5px 0 0;">ইমেইল বদলালে সেটা আবার অভেরিফায়েড (unverified) হয়ে যাবে — ইউজারকে নতুন করে ভেরিফাই করতে হবে।</p>
            </div>
            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:12px;font-weight:600;color:#475569;margin-bottom:5px;">ফোন</label>
                <input type="text" name="phone" value="${escapeHtml(u.phone || '')}" pattern="[0-9+\\-\\s]{6,20}" title="৬-২০ ক্যারেক্টার, সংখ্যা/+/-" style="width:100%;border:1px solid #e2e8f0;padding:10px 12px;border-radius:10px;font-size:13px;">
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" onclick="document.getElementById('editProfileModal').classList.remove('show')" style="padding:9px 16px;border-radius:10px;font-size:12px;font-weight:700;background:#f1f5f9;border:none;cursor:pointer;">বাতিল</button>
                <button type="submit" style="padding:9px 16px;border-radius:10px;font-size:12px;font-weight:700;background:#2563eb;color:#fff;border:none;cursor:pointer;">সেভ করুন</button>

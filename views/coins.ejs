<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im85-1 { font-size: .85rem; }
  .im85-2 { margin-bottom: 1.5rem; }
  .im85-3 { text-align: center; }
  .im85-4 { font-size: 3rem; margin-bottom: .5rem; }
  .im85-5 { margin-bottom: .5rem; }
  .im85-6 { width: 100%; justify-content: center; }
</style>

<%- include('partials/navbar') %>
<div class="container page">
  <%- include('partials/flash') %>
  <div class="layout-main">
    <div>
      <div class="card">
        <div class="card-header">💰 <%= t.transaction_history %></div>
        <table class="table">
          <thead><tr><th><%= t.date %></th><th><%= t.type %></th><th><%= t.description %></th><th><%= t.amount %></th></tr></thead>
          <tbody>
            <% if(transactions.length === 0) { %>
              <tr><td colspan="4" style="text-align:center;color:var(--muted)"><%= t.no_transactions_yet %></td></tr>
            <% } %>
            <% transactions.forEach(t => { %>
              <tr>
                <td style="font-size:.8rem;color:var(--muted)"><%= new Date(t.created_at).toLocaleDateString(lang === 'bn' ? 'bn-BD' : 'en-US') %></td>
                <td><span style="font-size:.75rem;background:var(--card2);padding:3px 8px;border-radius:20px"><%= t.type %></span></td>
                <td class="im85-1"><%= t.description %></td>
                <td class="<%= t.amount > 0 ? 'tx-positive' : 'tx-negative' %>" style="font-weight:700">
                  <%= t.amount > 0 ? '+' : '' %><%= t.amount %> 🪙
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div>
      <div class="stat-card im85-2">
        <div style="font-size:.85rem;color:var(--muted);margin-bottom:.5rem;">💰 <%= t.your_balance %></div>
        <div class="stat-number"><%= coins %></div>
        <div class="stat-label"><%= t.coins_label %></div>
      </div>
      <div class="card">
        <div class="card-body im85-3">
          <div class="im85-4">🎁</div>
          <h3 class="im85-5"><%= t.daily_bonus %></h3>
          <p style="color:var(--muted);font-size:.85rem;margin-bottom:1rem;"><%= t.daily_bonus_desc %></p>
          <button data-claim-bonus class="btn btn-gold im85-6"><%= t.claim_bonus_btn %></button>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/views/coins.js"></script>
<%- include('partials/footer') %>
<%- include('partials/bottom-nav', { activePage: 'profile' }) %>
</body></html>

<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz89-1 { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-dark); }
  .dz89-2 { width: 100%; max-width: 400px; padding: 1rem; }
  .dz89-3 { color: var(--text-muted); font-size: .88rem; margin-bottom: 16px; text-align: center; }
  .dz89-4 { width: 100%; justify-content: center; padding: 12px; }
  .dz89-5 { text-align: center; margin-top: 1rem; color: var(--text-muted); font-size: .9rem; }
  .dz89-6 { color: var(--secondary); }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im90-1 { justify-content: center; font-size: 1.2rem; }
  .im90-2 { text-align: center; letter-spacing: 6px; font-size: 1.2rem; }
</style>

<div class="dz89-1">
  <div class="dz89-2">
    <div class="card glass">
      <div class="card-header im90-1">🔐 অতিরিক্ত ভেরিফিকেশন প্রয়োজন</div>
      <div class="card-body">
        <p class="dz89-3">
          নিরাপত্তার কারণে (VPN/Proxy/Tor শনাক্ত হয়েছে) আপনার ইমেইলে পাঠানো ৬ ডিজিটের কোডটি দিন।
        </p>
        <%- include('partials/flash') %>
        <form action="/verify-access" method="POST">
          <div class="form-group">
            <label class="form-label">ভেরিফিকেশন কোড</label>
            <input type="text" name="code" class="form-input im90-2" placeholder="যেমন: 123456" inputmode="numeric" maxlength="6" autofocus required>
          </div>
          <button type="submit" class="btn btn-primary dz89-4">নিশ্চিত করুন ✅</button>
        </form>
        <p class="dz89-5">
          কোডের মেয়াদ ১০ মিনিট। ভুল হলে <a class="dz89-6" href="/login">আবার লগইন করুন</a>।
        </p>
      </div>
    </div>
  </div>
</div>

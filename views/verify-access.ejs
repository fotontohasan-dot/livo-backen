<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-dark);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card glass">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;">🔐 <%= t('va_title') %></div>
      <div class="card-body">
        <p style="color:var(--text-muted);font-size:.88rem;margin-bottom:16px;text-align:center;">
          <%= t('va_desc') %>
        </p>
        <%- include('partials/flash') %>
        <form action="/verify-access" method="POST">
          <div class="form-group">
            <label class="form-label"><%= t('va_code_label') %></label>
            <input type="text" name="code" class="form-input" placeholder="<%= t('va_code_placeholder') %>" inputmode="numeric" maxlength="6" autofocus required style="text-align:center;letter-spacing:6px;font-size:1.2rem;">
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;"><%= t('va_confirm') %> ✅</button>
        </form>
        <p style="text-align:center;margin-top:1rem;color:var(--text-muted);font-size:.9rem;">
          <%= t('va_expiry') %> <a href="/login" style="color:var(--secondary)"><%= t('va_login_again') %></a>
        </p>
      </div>
    </div>
  </div>
</div>

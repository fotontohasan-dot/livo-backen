<%
const _t = (typeof t !== 'undefined' && t) ? t : {
  error_title: 'কিছু একটা সমস্যা হয়েছে',
  server_error: 'সার্ভারে একটি সমস্যা হয়েছে। অনুগ্রহ করে পরে আবার চেষ্টা করুন।',
  go_to_homepage: 'হোমপেজে যান',
  go_back: 'ফিরে যান'
};
%>
<!DOCTYPE html>
<html lang="bn">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><%= _t.error_title %> - <%= siteName %></title>
 <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
 <style nonce="<%= cspNonce %>">
   * { margin:0; padding:0; box-sizing:border-box; }
   body {
     background:#0a0a14;
     color:#e8e8f0;
     font-family:'Hind Siliguri',sans-serif;
     display:flex; align-items:center; justify-content:center;
     min-height:100vh; padding:20px;
   }
   .error-box {
     background:#12121f;
     border:1px solid #1e1e35;
     border-radius:16px;
     padding:40px 30px;
     text-align:center;
     max-width:380px;
     width:100%;
   }
   .error-icon { font-size:60px; margin-bottom:16px; }
   h1 { color:#e8003d; font-size:22px; margin-bottom:12px; }
   p { color:#aaa; font-size:14px; line-height:1.6; margin-bottom:24px; }
   .btn-home {
     display:inline-block;
     background:linear-gradient(135deg,#f5c518,#e6a800);
     color:#000;
     padding:12px 28px;
     border-radius:25px;
     font-weight:700;
     font-size:15px;
     text-decoration:none;
   }
   .btn-back {
     display:inline-block;
     color:#9c9cc8;
     font-size:13px;
     margin-top:12px;
     text-decoration:none;
   }
 </style>
</head>
<body>
 <div class="error-box">
   <div class="error-icon">⚠️</div>
   <h1><%= _t.error_title %></h1>
   <p><%= message || _t.server_error %></p>
   <a href="/" class="btn-home">🏠 <%= _t.go_to_homepage %></a>
   <br>
   <a href="/" data-history-back="1" class="btn-back">← <%= _t.go_back %></a>
 </div>
<script src="/js/views/error.js"></script>
</body>
</html>

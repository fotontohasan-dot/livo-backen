<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im101-1 { margin-bottom: 1.5rem; }
  .im101-2 { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
  .im101-3 { flex: 1; min-width: 100px; }
  .im101-4 { display: flex; align-items: center; gap: .75rem; }
  .im101-5 { display: flex; flex-direction: column; gap: .75rem; font-size: .85rem; }
  .im101-6 { display: flex; justify-content: space-between; }
</style>

<%- include('partials/navbar') %>
<div class="container page">
  <%- include('partials/flash') %>
  <div class="layout-main">
    <div>
      <div class="card im101-1">
        <div class="card-header">
          <%= tournament.name %>
          <span class="status-badge status-<%= tournament.status %>"><%= tournament.status %></span>
        </div>
        <div class="card-body">
          <div class="im101-2">
            <div class="stat-card im101-3">
              <div class="stat-number" style="color: var(--text-accent)"><%= tournament.prize_pool %></div>
              <div class="stat-label">Prize Pool 🏆</div>
            </div>
            <div class="stat-card im101-3">
              <div class="stat-number"><%= tournament.entry_fee || 'Free' %></div>
              <div class="stat-label">Entry Fee</div>
            </div>
            <div class="stat-card im101-3">
              <div class="stat-number"><%= participants.length %></div>
              <div class="stat-label">Participants</div>
            </div>
          </div>
          <p style="color:var(--muted);margin-bottom:1.5rem"><%= tournament.description %></p>
          <% if(locals.user && !joined && tournament.status !== 'completed') { %>
            <button data-join-tournament class="btn btn-primary">🏆 Join Tournament</button>
          <% } else if(joined) { %>
            <div class="alert alert-success">✅ You are in this tournament!</div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <div class="card-header">🥇 Leaderboard</div>
        <table class="table">
          <thead><tr><th>Rank</th><th>Player</th><th>Points</th></tr></thead>
          <tbody>
            <% participants.forEach((p, i) => { %>
              <tr>
                <td><span class="rank-<%= i+1 %>">#<%= i+1 %></span></td>
                <td class="im101-4">
                  <div class="avatar"><%= p.username[0].toUpperCase() %></div>
                  <%= p.username %>
                </td>
                <td style="color: var(--text-accent);font-weight:700"><%= p.points %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-header">ℹ️ Tournament Info</div>
        <div class="card-body">
          <div class="im101-5">
            <div class="im101-6">
              <span style="color:var(--muted)">Sport</span>
              <span><%= tournament.sport %></span>
            </div>
            <div class="im101-6">
              <span style="color:var(--muted)">Start Date</span>
              <span><%= new Date(tournament.start_date).toLocaleDateString() %></span>
            </div>
            <div class="im101-6">
              <span style="color:var(--muted)">End Date</span>
              <span><%= new Date(tournament.end_date).toLocaleDateString() %></span>
            </div>
            <div class="im101-6">
              <span style="color:var(--muted)">Max Players</span>
              <span><%= tournament.max_participants %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="application/json" id="tournament-detailConfig"><%- jsonScriptSafe({ tournamentId: tournament.id }) %></script>
<script src="/js/views/tournament-detail.js"></script>
</body></html>

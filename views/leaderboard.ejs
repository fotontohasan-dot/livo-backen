<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
  .leader-row {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rank {
    font-family: 'Teko', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    width: 30px;
    color: var(--text-muted);
  }
  .rank-1 { color: #facc15; font-size: 1.8rem; }
  .rank-2 { color: #94a3b8; font-size: 1.6rem; }
  .rank-3 { color: #92400e; font-size: 1.5rem; }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--grad-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 0 10px rgba(245,158,11,0.2);
  }
  .pts {
    font-family: 'Teko', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--gold);
    margin-left: auto;
  }
</style>

<div class="container" style="padding-top: 14px; padding-bottom: 90px;">
  <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem;">🏆 <%= t.menu_leaderboard %></h1>

  <% users.forEach((u, i) => { %>
    <div class="leader-row">
      <div class="rank rank-<%= i+1 %>"><%= i+1 %></div>
      <% if (u.avatar) { %>
        <img src="<%= u.avatar %>" class="avatar" alt="">
      <% } else { %>
        <div class="avatar"><%= u.username[0].toUpperCase() %></div>
      <% } %>
      <div style="flex:1;">
        <div style="font-weight:700; color:var(--text-main);"><%= u.username %></div>
        <div style="font-size:11px; color:var(--text-muted);">
          <%= t.wins %>: <%= u.wins %> / <%= t.bets_label %>: <%= u.total_bets %>
        </div>

        <% if (market.type === 'bookmaker') { %>
          <!-- বুকমেকার -->
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[0] : 'Team A' %></div>
            <div class="odds back" data-market-id="<%= market.id %>" data-runner="0" data-odd="<%= market.odds['0'] || 1.85 %>">
              <%= market.odds['0'] || 1.85 %>
            </div>
          </div>
          <div class="market-row">
            <div class="market-team"><%= match.teams ? match.teams[1] : 'Team B' %></div>
            <div class="odds back" data-market-id="<%= market.id %>" data-runner="1" data-odd="<%= market.odds['1'] || 2.10 %>">
              <%= market.odds['1'] || 2.10 %>
            </div>
          </div>
        <% } else { %>
          <!-- ফ্যান্সি -->
          <div class="market-row">
            <div class="market-team">Yes</div>
            <div class="odds back" data-market-id="<%= market.id %>" data-runner="yes" data-odd="<%= market.odds['yes'] || 1.75 %>">
              <%= market.odds['yes'] || 1.75 %>
            </div>
          </div>
        <% } %>
      </div>
      <div class="pts">
        <%= u.total_points %> <span style="font-size:0.7rem; color:var(--text-muted);">PTS</span>
      </div>
    </div>
  <% }) %>

  <% if (users.length === 0) { %>
    <div class="card text-center" style="padding: 40px;">
      <p style="color:var(--text-muted);"><%= t.no_data || 'No data found' %></p>
    </div>
  <% } %>
</div>

<%- include('partials/bottom-nav') %>
</body>
</html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz88-1 { padding-top: 14px; padding-bottom: 90px; }
  .dz88-2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; }
  .dz88-3 { flex: 1; }
  .dz88-4 { font-weight: 700; color: var(--text-main); }
  .dz88-5 { font-size: 11px; color: var(--text-muted); }
  .dz88-6 { font-size: 0.7rem; color: var(--text-muted); }
  .dz88-7 { padding: 40px; }
  .dz88-8 { color: var(--text-muted); }
  .leader-row {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rank {
    font-family: 'Teko', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    width: 30px;
    color: var(--text-muted);
  }
  .rank-1 { color: #facc15; font-size: 1.8rem; }
  .rank-2 { color: var(--text-muted); font-size: 1.6rem; }
  .rank-3 { color: #92400e; font-size: 1.5rem; }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--grad-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color:var(--text-main);
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 0 10px rgba(245,158,11,0.2);
  }
  .pts {
    font-family: 'Teko', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-accent);
    margin-left: auto;
  }
</style>

<div class="container dz88-1">
  <h1 class="dz88-2">🏆 <%= t.menu_leaderboard %></h1>

  <% users.forEach((u, i) => { %>
    <div class="leader-row">
      <div class="rank rank-<%= i+1 %>"><%= i+1 %></div>
      <% if (u.avatar) { %>
        <img src="<%= u.avatar %>" class="avatar" alt="">
      <% } else { %>
        <div class="avatar"><%= u.username[0].toUpperCase() %></div>
      <% } %>
      <div class="dz88-3">
        <div class="dz88-4"><%= u.username %></div>
        <div class="dz88-5">
          <%= t.wins %>: <%= u.wins %> / <%= t.bets_label %>: <%= u.total_bets %>
        </div>
      </div>
      <div class="pts">
        <%= u.total_points %> <span class="dz88-6">PTS</span>
      </div>
    </div>
  <% }) %>

  <% if (users.length === 0) { %>
    <div class="card text-center dz88-7">
      <p class="dz88-8"><%= t.no_data || 'No data found' %></p>
    </div>
  <% } %>
</div>

<%- include('partials/bottom-nav') %>
</body>
</html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    .payment-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin: 20px 0;
    }
    .payment-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        cursor: pointer;
        transition: 0.3s;
    }
    .payment-card:hover { border-color: var(--secondary); }
    .payment-card.active { border-color: var(--secondary); background: rgba(255, 0, 170, 0.1); }
    .payment-name { font-weight: bold; font-size: 14px; }
</style>

<div class="container page">
    <%- include('partials/flash') %>

    <div class="card">
        <div class="card-header">💰 কয়েন ডিপোজিট করুন</div>
        <div class="card-body">
            <p style="color: var(--muted); font-size: 14px; margin-bottom: 20px;">আপনার পছন্দের পেমেন্ট মেথড নির্বাচন করুন</p>

            <div class="payment-grid">
                <div class="payment-card" onclick="selectMethod(this, 'bkash')">
                    <div style="font-size: 40px;">📱</div>
                    <div class="payment-name">bKash</div>
                </div>
                <div class="payment-card" onclick="selectMethod(this, 'nagad')">
                    <div style="font-size: 40px;">💳</div>
                    <div class="payment-name">Nagad</div>
                </div>
                <div class="payment-card" onclick="selectMethod(this, 'rocket')">
                    <div style="font-size: 40px;">🚀</div>
                    <div class="payment-name">Rocket</div>
                </div>
                <div class="payment-card" onclick="selectMethod(this, 'card')">
                    <div style="font-size: 40px;">💳</div>
                    <div class="payment-name">Debit/Credit Card</div>
                </div>
            </div>

            <form action="/coins/deposit" method="POST" id="depositForm">
                <input type="hidden" name="method" id="selectedMethod">
                <div class="form-group">
                    <label class="form-label">ডিপোজিট পরিমাণ (টাকা)</label>
                    <input type="number" name="amount" class="form-input" placeholder="যেমন: ৫০০" required>
                </div>
                <div id="manualFields">
                    <div class="form-group">
                        <label class="form-label">আপনার নম্বর (যেখান থেকে টাকা পাঠিয়েছেন)</label>
                        <input type="text" name="phone" class="form-input" placeholder="০১৭XXXXXXXX">
                    </div>
                    <div class="form-group">
                        <label class="form-label">ট্রানজ্যাকশন আইডি (TxID)</label>
                        <input type="text" name="txid" class="form-input" placeholder="A1B2C3D4">
                    </div>
                </div>
                <button type="submit" id="submitBtn" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 15px;">রিকোয়েস্ট পাঠান</button>
            </form>
        </div>
    </div>
</div>

<script>
function selectMethod(el, method) {
    document.getElementById('selectedMethod').value = method;
    document.querySelectorAll('.payment-card').forEach(c => c.classList.remove('active'));
    el.classList.add('active');

    const manualFields = document.getElementById('manualFields');
    const submitBtn = document.getElementById('submitBtn');

    if (method === 'card') {
        manualFields.style.display = 'none';
        submitBtn.innerText = 'অটোমেটিক পেমেন্ট করুন';
    } else {
        manualFields.style.display = 'block';
        submitBtn.innerText = 'রিকোয়েস্ট পাঠান';
    }
}
</script>

<%- include('partials/bottom-nav', { activePage: 'deposit' }) %>
</body></html>

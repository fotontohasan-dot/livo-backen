<%- include('partials/head') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-dark);">
  <div style="width:100%;max-width:400px;padding:1rem;">
    <div class="card glass">
      <div class="card-header" style="justify-content:center;font-size:1.2rem;"><%= t.set_new_password_title %></div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <form action="/reset-password/<%= token %>" method="POST">
          <div class="form-group">
            <label class="form-label"><%= t.new_password %></label>
            <input type="password" name="password" class="form-input" placeholder="<%= t.min_8_chars %>" required minlength="8">
          </div>
          <div class="form-group">
            <label class="form-label"><%= t.confirm_password_label %></label>
            <input type="password" name="confirmPassword" class="form-input" placeholder="••••••••" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;"><%= t.save_password %></button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz98-1 { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-dark); }
  .dz98-2 { width: 100%; max-width: 400px; padding: 1rem; }
  .dz98-3 { width: 100%; justify-content: center; padding: 12px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im99-1 { justify-content: center; font-size: 1.2rem; }
</style>

<div class="dz98-1">
  <div class="dz98-2">
    <div class="card glass">
      <div class="card-header im99-1"><%= t.set_new_password_title %></div>
      <div class="card-body">
        <%- include('partials/flash') %>
        <form action="/reset-password/<%= token %>" method="POST">
          <div class="form-group">
            <label class="form-label"><%= t.new_password %></label>
            <input type="password" name="password" class="form-input" placeholder="<%= t.min_8_chars %>" required minlength="8">
          </div>
          <div class="form-group">
            <label class="form-label"><%= t.confirm_password_label %></label>
            <input type="password" name="confirmPassword" class="form-input" placeholder="••••••••" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary dz98-3"><%= t.save_password %></button>
        </form>
      </div>
    </div>
  </div>
</div>

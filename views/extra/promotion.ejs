<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container ix53-1">
    <!-- Promotion Header -->
    <div class="ix53-2">
        <div class="im53-1">🎁</div>
        <h1 class="ix53-3"><%= t.promotion_center %></h1>
        <p class="dz53-1"><%= t.best_offers_msg %></p>
    </div>

    <!-- Category Filter -->
    <div class="ix53-4">
        <style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .sp27-1.sp27-1 { display: grid; gap: 20px; }
  .sp27-2.sp27-2 { height: 140px; background: linear-gradient(135deg, #f59e0b, #ef4444); display: flex; align-items: center; justify-content: center; position: relative; }
  .sp27-3.sp27-3 { display: flex; justify-content: space-between; align-items: center; }
  .sp27-4.sp27-4 { display: flex; align-items: center; gap: 5px; }
  .sp27-5.sp27-5 { height: 140px; background: linear-gradient(135deg, #8b5cf6, #3b82f6); display: flex; align-items: center; justify-content: center; position: relative; }
  .sp27-6.sp27-6 { height: 140px; background: linear-gradient(135deg, #10b981, #06b6d4); display: flex; align-items: center; justify-content: center; position: relative; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz53-1 { color: rgba(255,255,255,0.8); font-size: 13px; }
  .dz53-2 { flex: 0 0 auto; padding: 10px 20px; background: var(--grad-gold); color: #000; border-radius: 12px; font-size: 13px; font-weight: 700; cursor: pointer; }
  .dz53-3 { flex: 0 0 auto; padding: 10px 20px; background: rgba(255,255,255,0.05); color: var(--text-main); border-radius: 12px; font-size: 13px; font-weight: 700; cursor: pointer; border: 1px solid var(--border-glass); }
  .dz53-4 { background: var(--bg-card); border-radius: 20px; overflow: hidden; border: 1px solid var(--border-glass); box-shadow: 0 5px 20px rgba(0,0,0,0.2); }
  .dz53-5 { text-align: center; color: var(--text-main); text-shadow: 0 2px 10px rgba(0,0,0,0.3); }
  .dz53-6 { font-size: 40px; font-weight: 900; line-height: 1; }
  .dz53-7 { font-size: 14px; font-weight: 700; margin-top: 5px; text-transform: uppercase; letter-spacing: 1px; }
  .dz53-8 { position: absolute; top: 15px; left: 15px; background: rgba(0,0,0,0.4); padding: 4px 10px; border-radius: 6px; font-size: 10px; font-weight: 700; color: #fff; }
  .dz53-9 { padding: 20px; }
  .dz53-10 { color: var(--text-main); font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .dz53-11 { color: var(--text-muted); font-size: 12px; margin-bottom: 20px; line-height: 1.6; }
  .dz53-12 { color: var(--text-accent); font-size: 11px; }
  .dz53-13 { color: var(--text-muted); font-size: 11px; }
  .dz53-14 { padding: 8px 20px; font-size: 12px; border-radius: 10px; background: var(--grad-gold); color: #000; }
  .dz53-15 { padding: 8px 20px; font-size: 12px; border-radius: 10px; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). A declaration was moved only when no !important rule in
     the site CSS can match this element for that property. */
  .ix53-1 { padding: 15px; padding-bottom: 100px; }
  .ix53-2 { background: linear-gradient(135deg, #009625, #006519); border-radius: 24px; padding: 30px 20px; margin-bottom: 25px; text-align: center; border: 1px solid rgba(255,255,255,0.1); position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .ix53-3 { color: var(--text-main); font-size: 24px; font-weight: 800; margin-bottom: 8px; }
  .ix53-4 { display: flex; gap: 10px; margin-bottom: 25px; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im53-1 { position: absolute; right: -20px; bottom: -20px; font-size: 100px; opacity: 0.1; }div::-webkit-scrollbar { display: none; }</style>
        <div class="promo-cat active dz53-2"><%= t.all %></div>
        <div class="promo-cat dz53-3"><%= t.deposit %></div>
        <div class="promo-cat dz53-3"><%= t.football %></div>
        <div class="promo-cat dz53-3"><%= t.menu_slots %></div>
    </div>

    <!-- Promo Cards -->
    <div class="sp27-1">

        <!-- Welcome Bonus -->
        <div class="promo-card dz53-4">
            <div class="sp27-2">
                <div class="dz53-5">
                    <div class="dz53-6">১০০%</div>
                    <div class="dz53-7">ওয়েলকাম বোনাস</div>
                </div>
                <div class="dz53-8">NEW USER</div>
            </div>
            <div class="dz53-9">
                <h3 class="dz53-10"><%= t.promo_welcome_title %></h3>
                <p class="dz53-11"><%= t.promo_welcome_desc %></p>
                <div class="sp27-3">
                    <div class="sp27-4">
                        <i class="fas fa-clock dz53-12"></i>
                        <span class="dz53-13"><%= t.valid_until %>: <%= t.lifetime %></span>
                    </div>
                    <a href="/payment/deposit" class="btn btn-primary dz53-14"><%= t.get_now %></a>
                </div>
            </div>
        </div>

        <!-- Referral Bonus -->
        <div class="promo-card dz53-4">
            <div class="sp27-5">
                <div class="dz53-5">
                    <div class="dz53-6">৳৩,০০০</div>
                    <div class="dz53-7">রেফারেল বোনাস</div>
                </div>
                <div class="dz53-8">HOT</div>
            </div>
            <div class="dz53-9">
                <h3 class="dz53-10"><%= t.promo_referral_title %></h3>
                <p class="dz53-11"><%= t.promo_referral_desc %></p>
                <div class="sp27-3">
                    <div class="sp27-4">
                        <i class="fas fa-clock dz53-12"></i>
                        <span class="dz53-13"><%= t.valid_until %>: <%= t.lifetime %></span>
                    </div>
                    <a href="/profile/referral" class="btn btn-primary dz53-15"><%= t.invite_friends_title %></a>
                </div>
            </div>
        </div>

        <!-- Cashback Bonus -->
        <div class="promo-card dz53-4">
            <div class="sp27-6">
                <div class="dz53-5">
                    <div class="dz53-6">১০%</div>
                    <div class="dz53-7">ডেইলি ক্যাশব্যাক</div>
                </div>
            </div>
            <div class="dz53-9">
                <h3 class="dz53-10"><%= t.promo_cashback_title %></h3>
                <p class="dz53-11"><%= t.promo_cashback_desc %></p>
                <div class="sp27-3">
                    <div class="sp27-4">
                        <i class="fas fa-clock dz53-12"></i>
                        <span class="dz53-13"><%= t.valid_until %>: <%= t.daily %></span>
                    </div>
                    <button class="btn btn-secondary dz53-15"><%= t.details %></button>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include('../partials/bottom-nav') %>
</body></html>

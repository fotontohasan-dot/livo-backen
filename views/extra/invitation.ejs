<%#
  ⚠️ এটা সম্পূর্ণ ফাইল নয় — শুধু পরিবর্তিত/যোগ হওয়া অংশ (fragment)।
  আসল views/extra/invitation.ejs-এর সঠিক জায়গায় নিচের তিনটা অংশ বসান।
%>

<%# ===== (১) <style> ব্লকের ভেতরে, .im51-* রুলগুলোর পরে যোগ করুন ===== %>
<style>
  /* সোশ্যাল শেয়ার বাটন গ্রিড */
  .sh51-title { margin-top: 30px; font-size: 13px; color: var(--text-muted); text-align: center; }
  .sh51-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 12px; }
  .sh51-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 4px; border-radius: 14px; text-decoration: none; font-size: 12px; color: #fff; border: none; }
  .sh51-btn svg { width: 22px; height: 22px; fill: #fff; }
  .sh51-whatsapp { background: #25D366; }
  .sh51-messenger { background: #0084FF; }
  .sh51-facebook  { background: #1877F2; }
  .sh51-instagram { background: linear-gradient(45deg,#f58529,#dd2a7b,#8134af,#515bd4); }
  .sh51-viber     { background: #7360F2; }
  .sh51-imo       { background: #23A2E1; }
</style>


<%# ===== (২) স্ট্যাটস কার্ড (bonus_earned) দেখানোর div-এর ঠিক পরে, ===== %>
<%#     মূল কন্টেইনার </div></div> বন্ধ হওয়ার আগে যোগ করুন             %>

<p class="sh51-title"><%= t.share %></p>

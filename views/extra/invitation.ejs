<%# ===== (৩) নিচের কনফিগ-স্ক্রিপ্ট লাইনটা সম্পূর্ণ প্রতিস্থাপন করুন ===== %>

<%# আগে ছিল: %>
<%#
<script type="application/json" id="extra-invitationConfig"><%- jsonScriptSafe({ referralCode: referralCode, copied: t.referral_code_copied }) %></script>
%>

<%# এখন হবে: %>
<script type="application/json" id="extra-invitationConfig"><%- jsonScriptSafe({ referralCode: referralCode, referralLink: referralLink, copied: t.referral_code_copied }) %></script>

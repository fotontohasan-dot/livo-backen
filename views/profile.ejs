<%- include('partials/head') %>
<%- include('partials/navbar') %>
<div class="container page">
  <%- include('partials/flash') %>

  <div class="card" style="margin-bottom:1.5rem; background: var(--card2);">
    <div class="card-body" style="display:flex; align-items:center; gap:1.5rem;">
      <div class="avatar" style="width:64px;height:64px;font-size:1.5rem;">
        <%= profileUser.username[0].toUpperCase() %>
      </div>
      <div>
        <h2 style="margin:0;"><%= profileUser.username %></h2>
        <p style="color:var(--muted); font-size: 0.85rem; margin-top: 4px;"><%= profileUser.email %></p>
        <div style="margin-top: 8px; color: var(--gold); font-weight: 700;">🪙 <%= profileUser.coins %></div>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">Member Center</div>

    <% if (locals.user && locals.user.role === 'admin') { %>
      <a href="/admin" class="profile-list-item" style="background: rgba(255, 204, 0, 0.1); border-left: 4px solid var(--gold);">
        <div class="profile-list-icon">🛠️</div>
        <span style="color: var(--gold); font-weight: 700;">অ্যাডমিন প্যানেল (Admin Panel)</span>
        <div class="profile-list-arrow">❯</div>
      </a>
    <% } %>

    <a href="/leaderboard" class="profile-list-item">
      <div class="profile-list-icon">🎁</div>
      <span>Reward Center</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile/history" class="profile-list-item">
      <div class="profile-list-icon">📝</div>
      <span>Betting Record</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile/stats" class="profile-list-item">
      <div class="profile-list-icon">📊</div>
      <span>Profit & Loss</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/payment/history" class="profile-list-item">
      <div class="profile-list-icon">💸</div>
      <span>Deposit Record / Withdrawal Record</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/coins/history" class="profile-list-item">
      <div class="profile-list-icon">💳</div>
      <span>Account Record</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile/security" class="profile-list-item">
      <div class="profile-list-icon">🛡️</div>
      <span>Security Center</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile#invite" class="profile-list-item">
      <div class="profile-list-icon">👥</div>
      <span>Invite Friends</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile/missions" class="profile-list-item">
      <div class="profile-list-icon">🎯</div>
      <span>Mission Record</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/notifications" class="profile-list-item">
      <div class="profile-list-icon">📧</div>
      <span>Mail</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/app/update" class="profile-list-item">
      <div class="profile-list-icon">🆙</div>
      <span>App Update</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/profile#support" class="profile-list-item">
      <div class="profile-list-icon">📞</div>
      <span>Customer Service / Help Center</span>
      <div class="profile-list-arrow">❯</div>
    </a>

    <a href="/logout" class="profile-list-item" style="color: var(--red);">
      <div class="profile-list-icon">🚪</div>
      <span>Logout</span>
      <div class="profile-list-arrow">❯</div>
    </a>
  </div>
</div>

<%- include('partials/bottom-nav') %>
</body></html>

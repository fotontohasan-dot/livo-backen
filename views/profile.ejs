<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="profile-header">
    <div class="avatar" style="width:80px;height:80px;font-size:2rem;margin:0 auto 1rem; border: 2px solid var(--fa-primary);">
        <%= profileUser.username[0].toUpperCase() %>
    </div>
    <h2 style="font-size: 1.5rem; font-weight: bold;"><%= profileUser.username %></h2>
    <p style="color:var(--muted);font-size:.85rem; margin-top: 5px;">ID: <%= profileUser.id %> | <%= profileUser.email %></p>

    <div style="display:flex; justify-content: center; gap: 2rem; margin-top: 1.5rem;">
        <div style="text-align:center;">
            <div style="font-size:1.2rem;font-weight:800;color:var(--fa-primary)">৳ <%= profileUser.coins %></div>
            <div style="font-size:.7rem;color:var(--muted); text-transform: uppercase;">Balance</div>
        </div>
        <div style="text-align:center;">
            <div style="font-size:1.2rem;font-weight:800;color:var(--green)"><%= stats.won %></div>
            <div style="font-size:.7rem;color:var(--muted); text-transform: uppercase;">Wins</div>
        </div>
    </div>
</div>

<div class="member-list">
    <a href="/rewards" class="member-item">
        <div class="member-label"><i class="fa-solid fa-trophy"></i> Reward Center</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/profile/betting-record" class="member-item">
        <div class="member-label"><i class="fa-solid fa-list-check"></i> Betting Record</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/profile/profit-loss" class="member-item">
        <div class="member-label"><i class="fa-solid fa-chart-line"></i> Profit & Loss</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/payment/history" class="member-item">
        <div class="member-label"><i class="fa-solid fa-receipt"></i> Deposit / Withdrawal Record</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/profile/account-record" class="member-item">
        <div class="member-label"><i class="fa-solid fa-wallet"></i> Account Record</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/profile/security" class="member-item">
        <div class="member-label"><i class="fa-solid fa-shield-halved"></i> Security Center</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/invitation" class="member-item">
        <div class="member-label"><i class="fa-solid fa-user-plus"></i> Invite Friends</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/profile/mission-record" class="member-item">
        <div class="member-label"><i class="fa-solid fa-bullseye"></i> Mission Record</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/notifications" class="member-item">
        <div class="member-label"><i class="fa-solid fa-envelope"></i> Mail</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/app-update" class="member-item">
        <div class="member-label"><i class="fa-solid fa-circle-up"></i> App Update</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/support" class="member-item">
        <div class="member-label"><i class="fa-solid fa-headset"></i> Help Center</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
    <a href="/logout" class="member-item" style="margin-top: 1rem; color: var(--red);">
        <div class="member-label"><i class="fa-solid fa-power-off" style="color: var(--red);"></i> Logout</div>
        <div class="member-arrow"><i class="fa-solid fa-chevron-right"></i></div>
    </a>
</div>

<%- include('partials/bottom-nav', { activePage: 'profile' }) %>
</body></html>

<%- include('partials/head') %>
<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz104-1 { border-radius: 24px; padding: 30px 20px; margin-bottom: 20px; text-align: center; position: relative; overflow: hidden; border: 1px solid var(--border-glass); }
  .dz104-2 { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-accent); border: 1px solid var(--border-glass); cursor: pointer; }
  .dz104-3 { width: 100px; height: 100px; font-size: 3rem; background: var(--grad-primary); box-shadow: 0 0 25px var(--primary-glow); margin: 0 auto; border: 4px solid var(--border-glass); display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 700; }
  .dz104-4 { margin-top: 25px; padding: 20px; border-radius: 20px; background: var(--bg-surface); border: 1px solid var(--border-glass); }
  .dz104-5 { color: var(--text-accent); font-weight: 700; font-family: 'Teko',sans-serif; font-size: 2.8rem; line-height: 1; margin-bottom: 5px; }
  .dz104-6 { padding: 12px 5px; font-size: 0.85rem; flex-direction: column; gap: 6px; border-radius: 15px; }
  .dz104-7 { padding: 12px 5px; font-size: 0.85rem; color: var(--text-accent); flex-direction: column; gap: 6px; border: 1px solid rgba(245,158,11,0.3); border-radius: 15px; font-weight: 700; }
  .dz104-8 { padding: 12px 5px; font-size: 0.85rem; color: var(--text-main); flex-direction: column; gap: 6px; border: 1px solid var(--border-glass); border-radius: 15px; }
  .dz104-9 { margin-bottom: 20px; border-radius: 20px; border: 1px solid var(--border-glass); }
  .dz104-10 { padding: 18px; display: flex; align-items: center; justify-content: space-between; }
  .dz104-11 { width: 45px; height: 45px; border-radius: 12px; background: rgba(245, 158, 11, 0.1); display: flex; align-items: center; justify-content: center; color: var(--text-accent); font-size: 1.2rem; }
  .dz104-12 { color: var(--text-muted); font-size: .75rem; margin-bottom: 2px; }
  .dz104-13 { font-size: 1.3rem; font-weight: 700; color: var(--text-accent); font-family: 'Teko',sans-serif; letter-spacing: 2px; }
  .dz104-14 { font-size: .8rem; padding: 8px 16px; color: var(--text-main); border: 1px solid var(--border-glass); border-radius: 10px; }
  .dz104-15 { font-size: .8rem; padding: 8px 16px; border-radius: 10px; }
  .dz104-16 { padding: 20px 15px; border-radius: 20px; text-decoration: none; display: flex; flex-direction: column; align-items: center; gap: 10px; border: 1px solid var(--border-glass); }
  .dz104-17 { width: 50px; height: 50px; border-radius: 15px; background: rgba(139, 92, 246, 0.1); display: flex; align-items: center; justify-content: center; color: var(--text-accent); font-size: 1.4rem; }
  .dz104-18 { color: var(--text-main); font-size: 0.95rem; font-weight: 600; }
  .dz104-19 { width: 50px; height: 50px; border-radius: 15px; background: rgba(6, 182, 212, 0.1); display: flex; align-items: center; justify-content: center; color: var(--text-accent); font-size: 1.4rem; }
  .dz104-20 { width: 50px; height: 50px; border-radius: 15px; background: rgba(245, 158, 11, 0.1); display: flex; align-items: center; justify-content: center; color: var(--text-accent); font-size: 1.4rem; }
  .dz104-21 { width: 50px; height: 50px; border-radius: 15px; background: rgba(16, 185, 129, 0.1); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 1.4rem; }
  .dz104-22 { width: 50px; height: 50px; border-radius: 15px; background: rgba(236, 72, 153, 0.1); display: flex; align-items: center; justify-content: center; color: var(--secondary); font-size: 1.4rem; }
  .dz104-23 { width: 50px; height: 50px; border-radius: 15px; background: rgba(239, 68, 68, 0.1); display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 1.4rem; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Only declarations whose properties are free of any
     !important rule in the site CSS were moved; otherwise such a rule
     would suddenly start winning and change the layout. */
  .im105-1 { padding-top: 15px; }
  .im105-2 { position: absolute; top: 15px; right: 15px; }
  .im105-3 { margin-bottom: 15px; display: inline-block; position: relative; }
  .im105-4 { margin: 0; font-size: 1.6rem; font-weight: 700; }
  .im105-5 { font-size: .85rem; margin-top: 4px; }
  .im105-6 { font-size: 0.85rem; margin-bottom: 8px; }
  .im105-7 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 20px; }
  .im105-8 { font-size: 1.3rem; }
  .im105-9 { display: flex; align-items: center; gap: 15px; }
  .im105-10 { display: flex; gap: 10px; }
  .im105-11 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 40px; }
</style>

<%- include('partials/navbar') %>
<div class="container page im105-1">
  <%- include('partials/flash') %>

  <!-- Profile Header -->
  <div class="profile-header glass dz104-1">
    <div class="im105-2">
        <button id="theme-toggle-profile" class="glass dz104-2">
            <i class="fas fa-moon" id="theme-icon"></i>
        </button>
    </div>

    <div class="avatar-wrapper im105-3">
        <div class="avatar text-white dz104-3">
            <%= profileUser.username[0].toUpperCase() %>
        </div>
    </div>

    <h2 class="text-main im105-4"><%= profileUser.username %></h2>
    <p class="text-muted im105-5"><%= profileUser.email %></p>

    <div class="balance-section glass dz104-4">
        <p class="text-muted im105-6"><%= t('prof_total_balance') %></p>
        <div class="dz104-5">৳ <%= profileUser.coins %></div>
    </div>

    <!-- Action Buttons -->
    <div class="im105-7">
        <a href="/payment/deposit" class="btn btn-primary dz104-6">
            <i class="fas fa-wallet im105-8"></i>
            <span><%= t('prof_deposit') %></span>
        </a>
        <a href="/payment/withdraw" class="btn glass dz104-7">
            <i class="fas fa-money-bill-transfer im105-8"></i>
            <span><%= t('prof_withdraw') %></span>
        </a>
        <a href="/profile/security" class="btn glass dz104-8">
            <i class="fas fa-credit-card im105-8"></i>
            <span><%= t('prof_my_cards') %></span>
        </a>
    </div>
  </div>

  <!-- Referral Section -->
  <% if(profileUser.referral_code) { %>
  <div class="card glass dz104-9">
    <div class="card-body dz104-10">
      <div class="im105-9">
        <div class="dz104-11">
            <i class="fas fa-users"></i>
        </div>
        <div>
            <p class="dz104-12"><%= t('prof_referral_code') %></p>
            <div class="dz104-13">
              <%= profileUser.referral_code %>
            </div>
        </div>
      </div>
      <div class="im105-10">
        <button data-ref-action="copy" class="btn glass dz104-14"><%= t('prof_copy') %></button>
        <button data-ref-action="share" class="btn btn-primary dz104-15"><%= t('prof_share') %></button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Grid Shortcuts -->
  <div class="im105-11">
    <a href="/profile/history" class="glass dz104-16">
        <div class="dz104-17">
            <i class="fas fa-history"></i>
        </div>
        <span class="dz104-18"><%= t('hist_betting_record') %></span>
    </a>
    <a href="/payment/history" class="glass dz104-16">
        <div class="dz104-19">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <span class="dz104-18"><%= t('prof_transactions') %></span>
    </a>
    <a href="/leaderboard" class="glass dz104-16">
        <div class="dz104-20">
            <i class="fas fa-gift"></i>
        </div>
        <span class="dz104-18"><%= t('prof_rewards') %></span>
    </a>
    <a href="/profile/security" class="glass dz104-16">
        <div class="dz104-21">
            <i class="fas fa-shield-alt"></i>
        </div>
        <span class="dz104-18"><%= t('prof_security') %></span>
    </a>
    <a href="/chat" class="glass dz104-16">
        <div class="dz104-22">
            <i class="fas fa-headset"></i>
        </div>
        <span class="dz104-18"><%= t('prof_support') %></span>
    </a>
    <a href="/logout" class="glass dz104-16">
        <div class="dz104-23">
            <i class="fas fa-sign-out-alt"></i>
        </div>
        <span class="dz104-18"><%= t('prof_logout') %></span>
    </a>
  </div>
</div>

<script type="application/json" id="profileConfig"><%- jsonScriptSafe({ referralCode: profileUser.referral_code, siteName: siteName }) %></script>
<script src="/js/views/profile.js"></script>

<%- include('partials/footer') %>
<%- include('partials/bottom-nav') %>
</body></html>

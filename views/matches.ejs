<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head') %>
  <title>Cricket - In Play | <%= siteName %></title>
  <style>
    .live-dot {
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .match-card {
      transition: all 0.2s ease;
    }
    .match-card:hover {
      background-color: #1f2937;
      transform: translateX(4px);
    }
  </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen pb-20">

  <%- include('partials/header') %>

  <!-- Top Bar -->
  <div class="bg-yellow-500 p-4 flex items-center justify-between sticky top-0 z-50 shadow-lg">
    <div class="flex items-center gap-3">
      <div class="bg-black text-yellow-500 px-5 py-1.5 rounded font-bold flex items-center gap-2 text-lg">
        💰 Bets
      </div>
    </div>
    <div class="text-sm font-medium text-right">
      Main BDT 0.00<br>
      <span class="text-xs opacity-75">Exposure 0.00</span>
    </div>
    <div class="flex gap-2">
      <button onclick="location.reload()" class="p-3 bg-zinc-900 rounded-xl text-xl">🔄</button>
      <button class="p-3 bg-zinc-900 rounded-xl text-xl">⚙️</button>
    </div>
  </div>

  <!-- Cricket Header -->
  <div class="bg-zinc-900 p-4 flex items-center justify-between border-b-2 border-yellow-400">
    <div class="flex items-center gap-3 font-bold text-xl">
      🏏 Cricket <span class="bg-green-600 text-white text-xs px-2 py-1 rounded-full">13 Live</span>
    </div>
    <div class="flex items-center gap-2 bg-green-600 px-4 py-1 rounded-full text-sm font-medium">
      <span class="w-3 h-3 bg-white rounded-full live-dot inline-block"></span>
      In Play
    </div>
  </div>

  <!-- Matches List -->
  <div class="divide-y divide-gray-800">
    <% if (matches && matches.length > 0) { %>
      <% matches.forEach(match => { %>
      <a href="/matches/<%= match.id %>" class="match-card block p-4 hover:bg-zinc-900">
        <div class="flex justify-between items-start">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 bg-green-500 rounded-full live-dot"></span>
              <span class="text-emerald-400 font-medium">In-Play</span>
            </div>
            <p class="font-semibold text-lg leading-tight"><%= match.team_a %></p>
            <p class="text-gray-400 mt-1"><%= match.team_b %></p>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold text-yellow-400"><%= match.score_a || '0/0' %></div>
            <div class="text-lg text-gray-300"><%= match.score_b || '0/0' %></div>
            <div class="text-xs text-gray-500 mt-1"><%= match.overs || '0.0' %> overs</div>
          </div>
        </div>
      </a>
      <% }); %>
    <% } else { %>
      <div class="p-8 text-center text-gray-400">
        <p>কোনো লাইভ ম্যাচ নেই। পরে আবার চেক করুন।</p>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</body>
</html>

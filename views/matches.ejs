<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('../partials/head') %>
  <title>Cricket - In Play | <%= siteName %></title>
  <style>
    .live-dot { animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .match-card { transition: all 0.3s; }
    .match-card:hover { background-color: #1f2937; }
  </style>
</head>
<body class="bg-zinc-950 text-white">

  <%- include('../partials/header') %>

  <div class="bg-yellow-500 p-4 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center gap-3">
      <div class="bg-black text-yellow-500 px-5 py-1 rounded font-bold flex items-center gap-2">
        💰 Bets
      </div>
    </div>
    <div class="text-sm font-medium">
      Main BDT 0.00<br>
      <span class="text-xs">Exposure 0.00</span>
    </div>
    <div class="flex gap-3">
      <button class="p-3 bg-zinc-900 rounded-xl">🔄</button>
      <button class="p-3 bg-zinc-900 rounded-xl">⚙️</button>
    </div>
  </div>

  <div class="bg-zinc-900 p-4 flex items-center justify-between border-b border-yellow-400">
    <div class="flex items-center gap-3 font-bold text-lg">
      🏏 Cricket <span class="text-green-500 text-sm">(13)</span>
    </div>
    <div class="flex items-center gap-2 bg-green-600 px-4 py-1 rounded-full text-sm">
      <span class="w-3 h-3 bg-white rounded-full live-dot"></span> In Play
    </div>
  </div>

  <div class="divide-y divide-gray-800">
    <% matches.forEach(match => { %>
    <a href="/matches/<%= match.id %>" class="match-card block p-4 hover:bg-zinc-900">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full live-dot"></span>
            <span class="text-emerald-400 font-medium text-sm">In-Play</span>
          </div>
          <p class="font-semibold"><%= match.team_a %> v <%= match.team_b %></p>
        </div>
        <div class="text-right text-sm">
          <div class="text-yellow-400 font-bold"><%= match.score_a || '0/0' %></div>
          <div class="text-gray-400"><%= match.score_b || '0/0' %></div>
          <div class="text-xs text-gray-500"><%= match.overs || '0.0' %> ovs</div>
        </div>
      </div>
    </a>
    <% }); %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>

<%- include('partials/head') %>

<%- include('partials/navbar') %>

<style>
  @keyframes livedot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.5); }
  }
  .match-card {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    transition: 0.2s;
  }
  .match-card.live { border-left: 3px solid #ef4444; }
  .match-card:hover { border-color: var(--gold); }
  .jersey {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .jersey-a { background: linear-gradient(135deg,#0ea5e9,#0284c7); }
  .jersey-b { background: linear-gradient(135deg,#f97316,#ea580c); }
  .live-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(239,68,68,0.15);
    color: #ef4444;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
  }
  .upcoming-badge {
    background: rgba(245,158,11,0.15);
    color: var(--text-accent);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .predict-btn-card {
    background: var(--grad-gold);
    color: #000;
    border: none;
    border-radius: 10px;
    padding: 10px;
    width: 100%;
    margin-top: 12px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: block;
  }
  .skeleton {
    background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
    background-size: 200% 100%;
    animation: skel 1.5s infinite;
    border-radius: 8px;
    height: 100px;
    margin-bottom: 12px;
  }
  @keyframes skel {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<div class="container" style="padding-top: 14px;">
  <!-- Accumulator Banner -->
  <a href="/accumulator" style="display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:14px;padding:14px 16px;margin-bottom:14px;text-decoration:none;">
    <div>
      <div style="color:var(--text-white);font-size:15px;font-weight:bold;">🎯 <%= t.accumulator_bet %></div>
      <div style="color:rgba(255,255,255,0.85);font-size:12px;margin-top:2px;"><%= t.accumulator_desc %></div>
    </div>
    <span style="color:var(--text-white);font-size:22px;">›</span>
  </a>

  <!-- Sport Tabs -->
  <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:12px;margin-bottom:8px;">
    <a href="/matches" class="cat-item <%= sport === 'all' ? 'active' : '' %>" style="min-width:75px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>🏆</div><%= t.all %>
    </a>
    <a href="/matches/worldcup" class="cat-item <%= currentPage === 'worldcup' ? 'active' : '' %>" style="min-width:90px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>⚽</div><%= t.world_cup %>
    </a>
    <a href="/matches/football" class="cat-item <%= (currentPage === 'football' && sport === 'football') ? 'active' : '' %>" style="min-width:85px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>⚽</div>Football
    </a>
    <a href="/matches/cricket" class="cat-item <%= currentPage === 'cricket' ? 'active' : '' %>" style="min-width:85px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>🏏</div>Cricket
    </a>
  </div>

  <!-- Live connection status -->
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:11px;color:var(--text-muted);">
    <span id="liveDot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#10b981;"></span>
    <span id="liveStatus"><%= t.connection_status %></span>
  </div>

  <!-- Live section -->
  <div id="liveSection" style="display:none;">
    <div class="section-title">
      <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--red);animation:livedot 1.5s infinite;"></span>
      <%= t.live_now %>
      <span id="liveCount" class="badge" style="margin-left:auto;background:var(--red);color:var(--text-white);padding:2px 8px;border-radius:6px;font-size:11px;">0</span>
    </div>
    <div id="liveList"></div>
  </div>

  <!-- Upcoming section -->
  <div id="upcomingSection" style="margin-top:18px;">
    <div class="section-title">
      📅 <%= t.upcoming_matches %>
      <span id="upcomingCount" class="badge" style="margin-left:auto;background:var(--grad-gold);color:#000;padding:2px 8px;border-radius:6px;font-size:11px;">0</span>
    </div>
    <div id="upcomingList">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="card" style="display:none;text-align:center;padding:40px 20px;">
    <div style="font-size:48px;margin-bottom:12px;">⚽🏏</div>
    <div style="font-size:16px;font-weight:600;color:var(--text-main);"><%= t.no_matches_found %></div>
    <div style="font-size:13px;color:var(--text-muted);margin-top:6px;"><%= t.check_back_later %></div>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script type="application/json" id="matchesConfig"><%- jsonScriptSafe({
  sport: sport,
  loggedIn: !!locals.user,
  matchLabel: t.match, teamA: t.team_a, teamB: t.team_b,
  locale: lang === 'bn' ? 'bn-BD' : 'en-US',
  liveLabel: t.live_label, upcoming: t.upcoming_matches,
  predictNow: t.predict_now, loginToPredict: t.login_to_predict,
  lastUpdate: t.last_update_label || 'Last Update',
  statusOk: t.live_status_ok, statusError: t.live_status_error
}) %></script>
<script src="/js/views/matches.js"></script>

<%- include('partials/footer') %>
<%- include('partials/bottom-nav') %>

</body>
</html>

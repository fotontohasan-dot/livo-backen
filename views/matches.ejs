<%- include('partials/head') %>

<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz82-1 { padding-top: 14px; }
  .dz82-2 { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg,#7c3aed,#5b21b6); border-radius: 14px; padding: 14px 16px; margin-bottom: 14px; text-decoration: none; }
  .dz82-3 { color: var(--text-white); font-size: 15px; font-weight: bold; }
  .dz82-4 { color: rgba(255,255,255,0.85); font-size: 12px; margin-top: 2px; }
  .dz82-5 { color: var(--text-white); font-size: 22px; }
  .dz82-6 { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 12px; margin-bottom: 8px; }
  .dz82-7 { min-width: 75px; text-decoration: none; padding: 10px 6px; flex-shrink: 0; }
  .dz82-8 { min-width: 90px; text-decoration: none; padding: 10px 6px; flex-shrink: 0; }
  .dz82-9 { min-width: 85px; text-decoration: none; padding: 10px 6px; flex-shrink: 0; }
  .dz82-10 { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 11px; color: var(--text-muted); }
  .dz82-11 { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; }
  .dz82-12 { display: none; }
  .dz82-13 { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: livedot 1.5s infinite; }
  .dz82-14 { margin-left: auto; background: var(--red); color: var(--text-white); padding: 2px 8px; border-radius: 6px; font-size: 11px; }
  .dz82-15 { margin-top: 18px; }
  .dz82-16 { margin-left: auto; background: var(--grad-gold); color: #000; padding: 2px 8px; border-radius: 6px; font-size: 11px; }
  .dz82-17 { display: none; text-align: center; padding: 40px 20px; }
  .dz82-18 { font-size: 48px; margin-bottom: 12px; }
  .dz82-19 { font-size: 16px; font-weight: 600; color: var(--text-main); }
  .dz82-20 { font-size: 13px; color: var(--text-muted); margin-top: 6px; }
  @keyframes livedot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.5); }
  }
  .match-card {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    transition: 0.2s;
  }
  .match-card.live { border-left: 3px solid #ef4444; }
  .match-card:hover { border-color: var(--gold); }
  .jersey {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .jersey-a { background: linear-gradient(135deg,#0ea5e9,#0284c7); }
  .jersey-b { background: linear-gradient(135deg,#f97316,#ea580c); }
  .live-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(239,68,68,0.15);
    color: #ef4444;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
  }
  .upcoming-badge {
    background: rgba(245,158,11,0.15);
    color: var(--text-accent);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .predict-btn-card {
    background: var(--grad-gold);
    color: #000;
    border: none;
    border-radius: 10px;
    padding: 10px;
    width: 100%;
    margin-top: 12px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: block;
  }
  .skeleton {
    background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
    background-size: 200% 100%;
    animation: skel 1.5s infinite;
    border-radius: 8px;
    height: 100px;
    margin-bottom: 12px;
  }
  @keyframes skel {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<div class="container dz82-1">
  <!-- Accumulator Banner -->
  <a class="dz82-2" href="/accumulator">
    <div>
      <div class="dz82-3">🎯 <%= t.accumulator_bet %></div>
      <div class="dz82-4"><%= t.accumulator_desc %></div>
    </div>
    <span class="dz82-5">›</span>
  </a>

  <!-- Sport Tabs -->
  <div class="dz82-6">
    <a href="/matches" class="cat-item <%= sport === 'all' ? 'active' : '' %> dz82-7">
      <div>🏆</div><%= t.all %>
    </a>
    <a href="/matches/worldcup" class="cat-item <%= currentPage === 'worldcup' ? 'active' : '' %> dz82-8">
      <div>⚽</div><%= t.world_cup %>
    </a>
    <a href="/matches/football" class="cat-item <%= (currentPage === 'football' && sport === 'football') ? 'active' : '' %> dz82-9">
      <div>⚽</div>Football
    </a>
    <a href="/matches/cricket" class="cat-item <%= currentPage === 'cricket' ? 'active' : '' %> dz82-9">
      <div>🏏</div>Cricket
    </a>
  </div>

  <!-- Live connection status -->
  <div class="dz82-10">
    <span class="dz82-11" id="liveDot"></span>
    <span id="liveStatus"><%= t.connection_status %></span>
  </div>

  <!-- Live section -->
  <div class="dz82-12" id="liveSection">
    <div class="section-title">
      <span class="dz82-13"></span>
      <%= t.live_now %>
      <span id="liveCount" class="badge dz82-14">0</span>
    </div>
    <div id="liveList"></div>
  </div>

  <!-- Upcoming section -->
  <div class="dz82-15" id="upcomingSection">
    <div class="section-title">
      📅 <%= t.upcoming_matches %>
      <span id="upcomingCount" class="badge dz82-16">0</span>
    </div>
    <div id="upcomingList">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="card dz82-17">
    <div class="dz82-18">⚽🏏</div>
    <div class="dz82-19"><%= t.no_matches_found %></div>
    <div class="dz82-20"><%= t.check_back_later %></div>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script type="application/json" id="matchesConfig"><%- jsonScriptSafe({
  sport: sport,
  loggedIn: !!locals.user,
  matchLabel: t.match, teamA: t.team_a, teamB: t.team_b,
  locale: lang === 'bn' ? 'bn-BD' : 'en-US',
  liveLabel: t.live_label, upcoming: t.upcoming_matches,
  predictNow: t.predict_now, loginToPredict: t.login_to_predict,
  lastUpdate: t.last_update_label || 'Last Update',
  statusOk: t.live_status_ok, statusError: t.live_status_error
}) %></script>
<script src="/js/views/matches.js"></script>

<%- include('partials/footer') %>
<%- include('partials/bottom-nav') %>

</body>
</html>

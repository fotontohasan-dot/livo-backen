<%- include('partials/head') %>

<%- include('partials/navbar') %>

<div class="container" style="padding-top: 16px;">

  <!-- Tournament Tabs -->
  <div style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 12px; margin-bottom: 12px;">
    <a href="/matches" class="cat-item <%= sport === 'all' ? 'active' : '' %>" style="min-width: 80px; text-decoration:none; padding:10px;">
      <div>🏆</div>সব
    </a>
    <a href="/matches/worldcup" class="cat-item <%= currentPage === 'worldcup' ? 'active' : '' %>" style="min-width: 100px; text-decoration:none; padding:10px;">
      <div>⚽</div>World Cup
    </a>
    <a href="/matches/football" class="cat-item <%= currentPage === 'football' && sport === 'football' ? 'active' : '' %>" style="min-width: 90px; text-decoration:none; padding:10px;">
      <div>⚽</div>Football
    </a>
    <a href="/matches/cricket" class="cat-item <%= currentPage === 'cricket' ? 'active' : '' %>" style="min-width: 90px; text-decoration:none; padding:10px;">
      <div>🏏</div>Cricket
    </a>
  </div>

  <!-- Live Indicator -->
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:12px;color:var(--text-muted);">
    <span id="liveDot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#10b981;"></span>
    <span id="liveStatus">Live connection active — auto-updates every 60s</span>
  </div>

  <!-- Match list container — JS will populate -->
  <div id="matchesContainer">

    <% if (liveMatches && liveMatches.length > 0) { %>
      <div class="section-title">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;animation:livepulse 1.5s infinite;"></span>
        LIVE এখন
        <span class="badge badge-danger" style="margin-left:auto;font-size:11px;background:#ef4444;color:#fff;padding:2px 8px;border-radius:6px;"><%= liveMatches.length %></span>
      </div>

      <% liveMatches.forEach(function(m) { %>
        <div class="card" style="border-left: 3px solid #ef4444; padding: 14px; margin-bottom: 12px;">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">
            <%= m.league || m.name || 'Match' %>
          </div>

          <% if (m.sport === 'cricket') { %>
            <% if (m.score && m.score.length > 0) { %>
              <% m.score.forEach(function(s) { %>
                <div style="font-size:14px;margin-bottom:4px;color:var(--text-main);">
                  <strong><%= s.inning %></strong>: <span style="color:var(--gold);"><%= s.r %>/<%= s.w %></span> (<%= s.o %> ov)
                </div>
              <% }); %>
            <% } else { %>
              <div style="font-size:14px;color:var(--text-main);"><%= (m.teams || []).join(' vs ') %></div>
            <% } %>
            <div style="margin-top:8px;font-size:12px;color:#f59e0b;font-weight:600;">
              <%= m.status %>
            </div>
          <% } else { %>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <div style="flex:1;text-align:right;">
                <div style="font-weight:600;font-size:14px;color:var(--text-main);"><%= m.homeTeam %></div>
              </div>
              <div style="font-family:'Teko',sans-serif;font-size:1.6rem;color:var(--gold);min-width:60px;text-align:center;">
                <%= m.homeScore || 0 %> - <%= m.awayScore || 0 %>
              </div>
              <div style="flex:1;">
                <div style="font-weight:600;font-size:14px;color:var(--text-main);"><%= m.awayTeam %></div>
              </div>
            </div>
            <div style="margin-top:8px;text-align:center;font-size:12px;color:#ef4444;font-weight:600;">
              🔴 <%= m.progress || m.status || 'LIVE' %>
            </div>
          <% } %>

          <% if (user) { %>
            <button class="btn btn-primary" style="margin-top:12px;font-size:13px;padding:10px;width:100%;">
              🎯 Predict এখনি
            </button>
          <% } else { %>
            <a href="/login" class="btn btn-secondary" style="margin-top:12px;font-size:13px;padding:10px;display:block;text-align:center;text-decoration:none;">
              Predict করতে Login করো
            </a>
          <% } %>
        </div>
      <% }); %>
    <% } %>

    <% if (upcomingMatches && upcomingMatches.length > 0) { %>
      <div class="section-title" style="margin-top:20px;">
        📅 আসন্ন ম্যাচ
        <span class="badge badge-gold" style="margin-left:auto;font-size:11px;background:var(--grad-gold);color:#000;padding:2px 8px;border-radius:6px;"><%= upcomingMatches.length %></span>
      </div>

      <% upcomingMatches.slice(0, 20).forEach(function(m) { %>
        <div class="card" style="padding: 14px; margin-bottom: 12px;">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;">
            <%= m.league || m.tournament || m.name || 'Upcoming' %>
          </div>

          <% if (m.sport === 'cricket') { %>
            <div style="font-size:14px;font-weight:600;color:var(--text-main);"><%= (m.teams || []).join(' vs ') || m.name %></div>
            <% if (m.venue) { %><div style="font-size:12px;color:var(--text-muted);margin-top:4px;">📍 <%= m.venue %></div><% } %>
            <% if (m.date) { %><div style="font-size:12px;color:var(--gold);margin-top:4px;">🕒 <%= m.date %></div><% } %>
          <% } else { %>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
              <div style="flex:1;text-align:right;font-weight:600;font-size:14px;color:var(--text-main);"><%= m.homeTeam %></div>
              <div style="color:var(--text-muted);font-size:12px;">vs</div>
              <div style="flex:1;font-weight:600;font-size:14px;color:var(--text-main);"><%= m.awayTeam %></div>
            </div>
            <% if (m.venue) { %><div style="font-size:12px;color:var(--text-muted);margin-top:6px;text-align:center;">📍 <%= m.venue %></div><% } %>
            <% if (m.date) { %><div style="font-size:12px;color:var(--gold);margin-top:4px;text-align:center;">🕒 <%= m.date %> <%= m.time || '' %></div><% } %>
          <% } %>

          <% if (user) { %>
            <button class="btn btn-gold" style="margin-top:12px;font-size:13px;padding:10px;width:100%;">
              🎯 Predict করো
            </button>
          <% } %>
        </div>
      <% }); %>
    <% } %>

    <% if ((!liveMatches || liveMatches.length === 0) && (!upcomingMatches || upcomingMatches.length === 0)) { %>
      <div class="card" style="text-align:center;padding:40px 20px;">
        <div style="font-size:48px;margin-bottom:12px;">⚽🏏</div>
        <div style="font-size:16px;font-weight:600;margin-bottom:6px;color:var(--text-main);">এখন কোনো ম্যাচ নেই</div>
        <div style="font-size:13px;color:var(--text-muted);">কিছুক্ষণ পর আবার চেক করো</div>
      </div>
    <% } %>

  </div>
</div>

<style>
@keyframes livepulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.3); }
}
</style>

<!-- Socket.io client -->
<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
  const socket = io();
  const liveDot = document.getElementById('liveDot');
  const liveStatus = document.getElementById('liveStatus');

  socket.on('connect', () => {
    if (liveDot) liveDot.style.background = '#10b981';
    if (liveStatus) liveStatus.textContent = 'লাইভ — অটো আপডেট চালু (৬০ সেকেন্ড)';
    socket.emit('join_matches');
  });

  socket.on('disconnect', () => {
    if (liveDot) liveDot.style.background = '#94a3b8';
    if (liveStatus) liveStatus.textContent = 'কানেকশন বন্ধ — আবার যুক্ত হওয়ার চেষ্টা চলছে...';
  });

  socket.on('matches_update', (data) => {
    if (liveStatus) {
      const time = new Date(data.timestamp).toLocaleTimeString('bn-BD');
      liveStatus.textContent = `সর্বশেষ আপডেট: ${time}`;
    }
    // For now we just flash the indicator. Full page re-render would require
    // rebuilding the cards here from data.matches array.
    if (liveDot) {
      liveDot.style.transform = 'scale(2)';
      setTimeout(() => liveDot.style.transform = 'scale(1)', 400);
    }
  });

  window.addEventListener('beforeunload', () => {
    socket.emit('leave_matches');
    socket.disconnect();
  });
})();
</script>

<%- include('partials/bottom-nav') %>
</body>
</html>

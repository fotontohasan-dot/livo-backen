<%- include('partials/head') %>

<%- include('partials/navbar') %>

<style>
  @keyframes livedot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.5); }
  }
  .match-card {
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    transition: 0.2s;
  }
  .match-card.live { border-left: 3px solid #ef4444; }
  .match-card:hover { border-color: var(--gold); }
  .jersey {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .jersey-a { background: linear-gradient(135deg,#0ea5e9,#0284c7); }
  .jersey-b { background: linear-gradient(135deg,#f97316,#ea580c); }
  .live-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(239,68,68,0.15);
    color: #ef4444;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
  }
  .upcoming-badge {
    background: rgba(245,158,11,0.15);
    color: var(--gold);
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .predict-btn-card {
    background: var(--grad-gold);
    color: #000;
    border: none;
    border-radius: 10px;
    padding: 10px;
    width: 100%;
    margin-top: 12px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: block;
  }
  .skeleton {
    background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
    background-size: 200% 100%;
    animation: skel 1.5s infinite;
    border-radius: 8px;
    height: 100px;
    margin-bottom: 12px;
  }
  @keyframes skel {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<div class="container" style="padding-top: 14px;">
  <!-- Accumulator Banner -->
  <a href="/accumulator" style="display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:14px;padding:14px 16px;margin-bottom:14px;text-decoration:none;">
    <div>
      <div style="color:#fff;font-size:15px;font-weight:bold;">🎯 অ্যাকুমুলেটর বেট</div>
      <div style="color:rgba(255,255,255,0.85);font-size:12px;margin-top:2px;">একসাথে একাধিক বাজি — ৩০% পর্যন্ত বুস্ট!</div>
    </div>
    <span style="color:#fff;font-size:22px;">›</span>
  </a>

  <!-- Sport Tabs -->
  <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:12px;margin-bottom:8px;">
    <a href="/matches" class="cat-item <%= sport === 'all' ? 'active' : '' %>" style="min-width:75px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>🏆</div>সব
    </a>
    <a href="/matches/worldcup" class="cat-item <%= currentPage === 'worldcup' ? 'active' : '' %>" style="min-width:90px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>⚽</div>World Cup
    </a>
    <a href="/matches/football" class="cat-item <%= (currentPage === 'football' && sport === 'football') ? 'active' : '' %>" style="min-width:85px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>⚽</div>Football
    </a>
    <a href="/matches/cricket" class="cat-item <%= currentPage === 'cricket' ? 'active' : '' %>" style="min-width:85px;text-decoration:none;padding:10px 6px;flex-shrink:0;">
      <div>🏏</div>Cricket
    </a>
  </div>

  <!-- Live connection status -->
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:11px;color:var(--text-muted);">
    <span id="liveDot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#10b981;"></span>
    <span id="liveStatus">কানেকশন চলছে...</span>
  </div>

  <!-- Live section -->
  <div id="liveSection" style="display:none;">
    <div class="section-title">
      <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;animation:livedot 1.5s infinite;"></span>
      LIVE এখন
      <span id="liveCount" class="badge" style="margin-left:auto;background:#ef4444;color:#fff;padding:2px 8px;border-radius:6px;font-size:11px;">0</span>
    </div>
    <div id="liveList"></div>
  </div>

  <!-- Upcoming section -->
  <div id="upcomingSection" style="margin-top:18px;">
    <div class="section-title">
      📅 আসন্ন ম্যাচ
      <span id="upcomingCount" class="badge" style="margin-left:auto;background:var(--grad-gold);color:#000;padding:2px 8px;border-radius:6px;font-size:11px;">0</span>
    </div>
    <div id="upcomingList">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="card" style="display:none;text-align:center;padding:40px 20px;">
    <div style="font-size:48px;margin-bottom:12px;">⚽🏏</div>
    <div style="font-size:16px;font-weight:600;color:var(--text-main);">এখন কোনো ম্যাচ নেই</div>
    <div style="font-size:13px;color:var(--text-muted);margin-top:6px;">কিছুক্ষণ পর আবার চেক করো</div>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const CURRENT_SPORT = '<%= sport %>';
const IS_LOGGED_IN = <%= locals.user ? 'true' : 'false' %>;

// ========== Card builder ==========
function buildMatchCard(m, isLive) {
  const sportIcon = m.sport === 'football' ? '⚽' : '🏏';
  const tournament = m.league || m.name || 'Match';
  const teamA = (m.teams && m.teams[0]) || m.homeTeam || 'Team A';
  const teamB = (m.teams && m.teams[1]) || m.awayTeam || 'Team B';
  const scoreA = m.homeScore != null ? m.homeScore : (m.score && m.score[0] ? `${m.score[0].r}/${m.score[0].w}` : null);
  const scoreB = m.awayScore != null ? m.awayScore : (m.score && m.score[1] ? `${m.score[1].r}/${m.score[1].w}` : null);
  const dateStr = m.date ? new Date(m.date).toLocaleString('bn-BD', {dateStyle:'medium', timeStyle:'short'}) : '';
  
  const badge = isLive 
    ? `<span class="live-badge"><span style="width:7px;height:7px;border-radius:50%;background:#ef4444;animation:livedot 1.5s infinite;"></span>LIVE</span>`
    : `<span class="upcoming-badge">📅 ${dateStr || 'Upcoming'}</span>`;
  
  const scoreHTML = isLive && scoreA != null
    ? `<div style="font-family:'Teko',sans-serif;font-size:1.4rem;color:var(--gold);">${scoreA}</div>`
    : '';
  
  const scoreBHTML = isLive && scoreB != null
    ? `<div style="font-family:'Teko',sans-serif;font-size:1.4rem;color:var(--gold);">${scoreB}</div>`
    : '';
  
  const statusHTML = isLive && m.status
    ? `<div style="margin-top:10px;font-size:12px;color:var(--gold);font-weight:600;text-align:center;">${m.status}</div>`
    : '';
  
  const btnHTML = IS_LOGGED_IN
    ? `<a href="/matches/${m.id}" class="predict-btn-card">🎯 Predict করো</a>`
    : `<a href="/login" class="predict-btn-card" style="background:var(--bg-glass);color:var(--text-main);border:1px solid var(--border-glass);">লগইন করে Predict করুন</a>`;
  
  return `
    <div class="match-card ${isLive ? 'live' : ''}" onclick="event.target.tagName !== 'A' && (window.location.href='/matches/${m.id}')">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:8px;">
          ${sportIcon} ${tournament}
        </div>
        ${badge}
      </div>
      
      <div style="display:flex;align-items:center;gap:10px;padding:6px 0;">
        <div class="jersey jersey-a">👕</div>
        <div style="flex:1;font-weight:600;font-size:14px;color:var(--text-main);">${teamA}</div>
        ${scoreHTML}
      </div>
      
      <div style="display:flex;align-items:center;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,0.05);">
        <div class="jersey jersey-b">👕</div>
        <div style="flex:1;font-weight:600;font-size:14px;color:var(--text-main);">${teamB}</div>
        ${scoreBHTML}
      </div>
      
      ${statusHTML}
      ${btnHTML}
    </div>
  `;
}

// ========== Render ==========
function renderMatches(matches) {
  const live = [];
  const upcoming = [];
  
  matches.forEach(m => {
    const status = (m.status || '').toLowerCase();
    if (status.includes('live') || status === 'live' || status.includes('in play') || status.includes('progress')) {
      live.push(m);
    } else {
      upcoming.push(m);
    }
  });
  
  // Live section
  const liveSection = document.getElementById('liveSection');
  const liveList = document.getElementById('liveList');
  const liveCount = document.getElementById('liveCount');
  
  if (live.length > 0) {
    liveSection.style.display = 'block';
    liveCount.textContent = live.length;
    liveList.innerHTML = live.map(m => buildMatchCard(m, true)).join('');
  } else {
    liveSection.style.display = 'none';
  }
  
  // Upcoming section
  const upcomingList = document.getElementById('upcomingList');
  const upcomingCount = document.getElementById('upcomingCount');
  const upcomingSection = document.getElementById('upcomingSection');
  
  if (upcoming.length > 0) {
    upcomingSection.style.display = 'block';
    upcomingCount.textContent = upcoming.length;
    upcomingList.innerHTML = upcoming.slice(0, 30).map(m => buildMatchCard(m, false)).join('');
  } else {
    upcomingSection.style.display = 'none';
  }
  
  // Empty state
  document.getElementById('emptyState').style.display =
    (live.length === 0 && upcoming.length === 0) ? 'block' : 'none';
}

// ========== Fetch from API ==========
async function fetchMatches() {
  try {
    const res = await fetch('/matches/api/live');
    const data = await res.json();
    if (!data.success) throw new Error('API error');
    
    let all = [];
    if (CURRENT_SPORT === 'all' || CURRENT_SPORT === 'cricket') all = all.concat(data.cricket || []);
    if (CURRENT_SPORT === 'all' || CURRENT_SPORT === 'football') all = all.concat(data.football || []);
    
    renderMatches(all);
    updateStatus('সর্বশেষ আপডেট: ' + new Date().toLocaleTimeString('bn-BD'));
  } catch (err) {
    console.error('Fetch error:', err);
    updateStatus('ডেটা লোড করতে সমস্যা', '#ef4444');
  }
}

function updateStatus(text, color) {
  const dot = document.getElementById('liveDot');
  const status = document.getElementById('liveStatus');
  if (status) status.textContent = text;
  if (dot && color) dot.style.background = color;
}

// ========== Socket.io ==========
const socket = io();

socket.on('connect', () => {
  updateStatus('লাইভ — অটো আপডেট চালু', '#10b981');
  socket.emit('join_matches');
});

socket.on('disconnect', () => {
  updateStatus('কানেকশন বন্ধ — পুনরায় চেষ্টা চলছে...', '#94a3b8');
});

socket.on('matches_update', (data) => {
  // Server sent DB-shaped data; refetch our API endpoint instead for consistency
  fetchMatches();
  
  // Flash the dot
  const dot = document.getElementById('liveDot');
  if (dot) {
    dot.style.transform = 'scale(2)';
    setTimeout(() => dot.style.transform = 'scale(1)', 400);
  }
});

window.addEventListener('beforeunload', () => {
  socket.emit('leave_matches');
  socket.disconnect();
});

// Initial load
fetchMatches();

// Refresh every 30 seconds (backup if socket fails)
setInterval(fetchMatches, 30000);
</script>

<%- include('partials/bottom-nav') %>

</body>
</html>

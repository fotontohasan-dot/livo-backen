<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 15px;
        padding: 20px;
    }
    .game-card {
        background: #1a1433;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s;
        cursor: pointer;
        border: 1px solid #2a2255;
    }
    .game-card:hover {
        transform: translateY(-5px);
        border-color: var(--primary);
    }
    .game-img {
        width: 100%;
        height: 120px;
        background: linear-gradient(135deg, #1a0050, #6b00ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
    }
    .game-info {
        padding: 10px;
        text-align: center;
    }
    .game-name {
        font-weight: bold;
        font-size: 14px;
        color: #fff;
    }
    .category-tabs {
        display: flex;
        overflow-x: auto;
        gap: 10px;
        padding: 10px 20px;
        background: #0a0e1a;
        position: sticky;
        top: 65px;
        z-index: 10;
    }
    .tab {
        padding: 8px 20px;
        background: #1a2235;
        border-radius: 20px;
        white-space: nowrap;
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
    }
    .tab.active {
        background: var(--primary);
        color: #000;
        font-weight: bold;
    }
</style>

<div class="category-tabs">
    <a href="#" class="tab active">All Games</a>
    <a href="#" class="tab">Slots</a>
    <a href="#" class="tab">Live Casino</a>
    <a href="#" class="tab">Fishing</a>
    <a href="#" class="tab">Table</a>
</div>

<div class="container">
    <%- include('partials/flash') %>

    <div class="game-grid" id="gameContainer">
        <!-- Games will be injected here -->
    </div>
</div>

<script>
    const games = [
        {name: "Teen Patti", emoji: "🃏", cat: "table"},
        {name: "Super Ace", emoji: "🂡", cat: "slots"},
        {name: "Crash", emoji: "🚀", cat: "special"},
        {name: "Aviator", emoji: "✈️", cat: "special"},
        {name: "Andar Bahar", emoji: "🎲", cat: "table"},
        {name: "Dragon Tiger", emoji: "🐉", cat: "table"},
        {name: "Roulette", emoji: "🎡", cat: "live"},
        {name: "Blackjack", emoji: "♠️", cat: "table"},
        {name: "Fortune Gems", emoji: "💎", cat: "slots"},
        {name: "Boxing King", emoji: "🥊", cat: "slots"},
        {name: "Golden Empire", emoji: "👑", cat: "slots"},
        {name: "Crazy Time", emoji: "🎪", cat: "live"},
        {name: "Mega Ball", emoji: "🎱", cat: "live"},
        {name: "7 Up Down", emoji: "🎰", cat: "table"},
        {name: "Mines", emoji: "💣", cat: "special"},
        {name: "Plinko", emoji: "🎾", cat: "special"}
    ];

    const container = document.getElementById('gameContainer');
    games.forEach(game => {
        const card = document.createElement('div');
        card.className = 'game-card';
        card.innerHTML = `
            <div class="game-img">${game.emoji}</div>
            <div class="game-info">
                <div class="game-name">${game.name}</div>
            </div>
        `;
        container.appendChild(card);
    });
</script>

<%- include('partials/navbar') %> <!-- Added at bottom too for mobile feel if needed, but navbar.ejs is usually at top -->
</body></html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ===== Sports Quick Links ===== -->
<div style="padding: 12px;">
  <div style="background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(0,150,37,0.05)); border: 1px solid var(--border-glass); border-radius: 16px; padding: 14px;">

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div style="font-size:13px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:0.5px;">
        ⚡ Quick Links
      </div>
      <a href="/matches" style="font-size:11px;color:var(--text-muted);text-decoration:none;">
        সব দেখুন →
      </a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;">
      <a href="/matches/in-play" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#ef4444,#dc2626);border-radius:12px;padding:14px 6px;position:relative;">
          <div style="font-size:22px;">⏱️</div>
          <div style="position:absolute;top:4px;right:4px;width:6px;height:6px;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff;animation:livedot 1.5s infinite;"></div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">In-Play</div>
      </a>

      <a href="/matches/cricket" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#10b981,#059669);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">🏏</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">Cricket</div>
      </a>

      <a href="/matches/football" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">⚽</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">Football</div>
      </a>

      <a href="/matches/worldcup" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:12px;padding:14px 6px;position:relative;">
          <div style="font-size:22px;">🏆</div>
          <div style="position:absolute;top:3px;right:3px;background:#ef4444;color:#fff;font-size:8px;padding:1px 4px;border-radius:6px;font-weight:700;">HOT</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">WC 2026</div>
      </a>

      <a href="/tournaments" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">🎯</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">প্রেডিকশন</div>
      </a>
    </div>
  </div>
</div>

<style>
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }
.cat-item.active { border: 1px solid var(--gold) !important; }
</style>

<!-- ===== Welcome Banner ===== -->
<div class="banner-container">
  <div class="card btn-glow" style="height:160px;background:linear-gradient(135deg, #006519, #004d13);position:relative;display:flex;align-items:center;padding:20px;border: 1px solid var(--gold);">
    <div style="z-index:1;">
      <h2 style="font-family:'Teko',sans-serif;font-size:32px;color:var(--gold);line-height:1;">🎰 ওয়েলকাম বনাস ৫০%</h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.9);margin-top:5px;">পথম ডিপজিটে ৫০% পর্যন্ত বোনাস পন</p>
      <div style="margin-top:5px; font-size: 11px; color: #fff;">প্রতি রেফারেলের জন্য ৩০০০ বোনাস! 🎁</div>
      <a href="/payment/deposit" class="btn btn-primary" style="margin-top:12px;border-radius:25px;padding:8px 24px;background: var(--grad-gold); color: #000;">এখনই নন</a>
    </div>
    <div style="position:absolute;right:10px;font-size:80px;opacity:0.2;">🏆</div>
  </div>
</div>

<!-- ===== News Ticker ===== -->
<div class="glass" style="margin:8px 12px;border-radius:12px;padding:12px;display:flex;align-items:center;gap:12px;position:relative;">
  <div style="background:var(--gold);color:#000;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:bold;">News</div>
  <div style="flex:1;overflow:hidden;">
    <div style="font-size:12px;color:var(--text-muted);white-space:nowrap;animation:marquee-text 15s linear infinite;">
      প্রিয় গ্রাহক, LIVO-ত আপনাকে স্বাগতম! নতুন আমানত বোনাস এবং আকর্ষণীয় পুরস্কার পেতে এখনই খেলা শরু করুন। আমাদের সাথে থকার জন্য ধন্যবাদ।
    </div>
  </div>
</div>

<!-- ===== Stats Grid ===== -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value">৫০০+</div>
    <div class="stat-label">গেমের সংখ্যা</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">২৪/৭</div>
    <div class="stat-label">সাপোর্ট</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">৳৫ম+</div>
    <div class="stat-label">পেমেন্ট</div>
  </div>
</div>

<!-- ===== Category Scrollbar ===== -->
<div style="display:flex;overflow-x:auto;padding:8px 12px;gap:10px;scrollbar-width:none;" id="catNav">
  <style>#catNav::-webkit-scrollbar { display:none; }</style>
  <div class="glass cat-item active" data-cat="all" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;">
    <div style="font-size:22px;">🔥</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">হট</div>
  </div>
  <div class="glass cat-item" data-cat="slots" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;">
    <div style="font-size:22px;">🎰</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">স্লট</div>
  </div>
  <div class="glass cat-item" data-cat="live" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;">
    <div style="font-size:22px;">🎲</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">লাইভ</div>
  </div>
  <div class="glass cat-item" data-cat="crash" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;">
    <div style="font-size:22px;">🚀</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">ক্র্যাশ</div>
  </div>
  <div class="glass cat-item" data-cat="card" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;">
    <div style="font-size:22px;">🃏</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">কার্ড</div>
  </div>
</div>

<%- include('partials/flash') %>

<!-- ===== Hot Games ===== -->
<div class="section-header">
  <h3 class="section-title"><i class="fas fa-fire"></i> <span id="sectionTitle">হট গেমস</span></h3>
  <a href="/games/slots" style="font-size:12px;color:var(--text-muted);text-decoration:none;">সব দেখুন →</a>
</div>
<div class="game-grid" id="gameContainer"></div>

<%- include('partials/bottom-nav') %>
<script>
// ===== হোম পেজের গেম লিস্ট =====
var ALL_GAMES = [
  { slug: 'aviator', name: 'Aviator', icon: '🚀', cat: 'crash', grad: 'linear-gradient(135deg,#ef4444,#b91c1c)' },
  { slug: 'crash-game', name: 'Crash', icon: '📈', cat: 'crash', grad: 'linear-gradient(135deg,#f97316,#c2410c)' },
  { slug: 'spaceman', name: 'Spaceman', icon: '👨‍🚀', cat: 'crash', grad: 'linear-gradient(135deg,#6366f1,#4338ca)' },
  { slug: 'jetx', name: 'JetX', icon: '✈️', cat: 'crash', grad: 'linear-gradient(135deg,#0ea5e9,#0369a1)' },
  { slug: 'slots', name: 'Slots', icon: '🎰', cat: 'slots', grad: 'linear-gradient(135deg,#8b5cf6,#6d28d9)' },
  { slug: 'sweet-bonanza', name: 'Sweet Bonanza', icon: '🍬', cat: 'slots', grad: 'linear-gradient(135deg,#ec4899,#be185d)' },
  { slug: 'gates-of-olympus', name: 'Gates of Olympus', icon: '⚡', cat: 'slots', grad: 'linear-gradient(135deg,#f59e0b,#b45309)' },
  { slug: 'book-of-dead', name: 'Book of Dead', icon: '📖', cat: 'slots', grad: 'linear-gradient(135deg,#eab308,#a16207)' },
  { slug: 'roulette', name: 'Roulette', icon: '🎡', cat: 'live', grad: 'linear-gradient(135deg,#dc2626,#7f1d1d)' },
  { slug: 'crazy-time', name: 'Crazy Time', icon: '🎉', cat: 'live', grad: 'linear-gradient(135deg,#10b981,#047857)' },
  { slug: 'dragon-tiger', name: 'Dragon Tiger', icon: '🐉', cat: 'live', grad: 'linear-gradient(135deg,#f43f5e,#9f1239)' },
  { slug: 'andar-bahar', name: 'Andar Bahar', icon: '🎴', cat: 'card', grad: 'linear-gradient(135deg,#3b82f6,#1d4ed8)' },
  { slug: 'teen-patti', name: 'Teen Patti', icon: '🃏', cat: 'card', grad: 'linear-gradient(135deg,#14b8a6,#0f766e)' },
  { slug: 'blackjack', name: 'Blackjack', icon: '♠️', cat: 'card', grad: 'linear-gradient(135deg,#64748b,#334155)' },
  { slug: 'baccarat', name: 'Baccarat', icon: '💎', cat: 'card', grad: 'linear-gradient(135deg,#a855f7,#7e22ce)' },
  { slug: 'poker', name: 'Poker', icon: '🎰', cat: 'card', grad: 'linear-gradient(135deg,#0891b2,#155e75)' },
  { slug: 'color-prediction', name: 'Color Prediction', icon: '🎨', cat: 'live', grad: 'linear-gradient(135deg,#d946ef,#a21caf)' },
  { slug: 'dice', name: 'Dice', icon: '🎲', cat: 'live', grad: 'linear-gradient(135deg,#22c55e,#15803d)' },
  { slug: 'plinko', name: 'Plinko', icon: '🔵', cat: 'crash', grad: 'linear-gradient(135deg,#06b6d4,#0e7490)' },
  { slug: 'mines', name: 'Mines', icon: '💣', cat: 'crash', grad: 'linear-gradient(135deg,#475569,#1e293b)' }
];

var currentCat = 'all';

function buildCard(g) {
  var a = document.createElement('a');
  a.href = '/games/' + g.slug;
  a.style.textDecoration = 'none';
  a.className = 'game-card';
  a.style.background = g.grad;
  a.innerHTML =
    '<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;">' +
      '<div style="font-size:34px;">' + g.icon + '</div>' +
      '<div style="font-size:11px;color:#fff;font-weight:700;text-align:center;padding:0 4px;">' + g.name + '</div>' +
    '</div>';
  return a;
}

function renderGames() {
  var container = document.getElementById('gameContainer');
  if (!container) return;
  container.innerHTML = '';
  var list = currentCat === 'all' ? ALL_GAMES : ALL_GAMES.filter(function (g) { return g.cat === currentCat; });
  list.forEach(function (g) { container.appendChild(buildCard(g)); });
}

document.addEventListener('DOMContentLoaded', function () {
  renderGames();
  var items = document.querySelectorAll('.cat-item');
  items.forEach(function (el) {
    el.addEventListener('click', function () {
      items.forEach(function (i) { i.classList.remove('active'); });
      el.classList.add('active');
      currentCat = el.getAttribute('data-cat') || 'all';
      var titleMap = { all: 'হট গেমস', slots: 'স্লট গেমস', live: 'লাইভ ক্যাসিনো', crash: 'ক্র্যাশ গেমস', card: 'কার্ড গেমস' };
      var t = document.getElementById('sectionTitle');
      if (t) t.textContent = titleMap[currentCat] || 'গেমস';
      renderGames();
    });
  });
});
</script>

</body>
</html>

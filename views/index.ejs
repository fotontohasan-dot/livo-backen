    <div style="font-size:22px;">🎣</div>
    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);">ফিশিং</div>
  </div>
  <div class="glass cat-item" data-type="sports" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;border: 1px solid var(--border-glass);">

</div>

<div style="display:flex;overflow-x:auto;padding:0 12px 12px;gap:8px;scrollbar-width:none;" id="provNav">
  <div class="glass prov-item active" data-provider="all" style="flex:0 0 auto;padding:4px 15px;border-radius:20px;font-size:11px;color:var(--text-muted);border:1px solid var(--border-glass);cursor:pointer;">সব প্রোভাইডার</div>

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Live Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: #0b0b0c; 
            color: white; 
        }
        .header {
            background: linear-gradient(90deg, #ff2d55, #c8102e);
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { 
            font-size: 28px; 
            font-weight: bold; 
            color: white;
        }
        
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 12px;
            padding: 15px;
            margin-top: 70px;
        }
        .game-card {
            background: #1a1a2e;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
        }
        .game-card img {
            width: 100%;
            height: 120px;
            object-fit: cover;
        }
        .game-name {
            font-size: 14px;
            padding: 10px 0;
            color: #ffd700;
            font-weight: bold;
        }
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            background: #111827;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid #333;
        }
        .nav-item {
            text-align: center;
            color: #aaa;
            font-size: 12px;
        }
        .nav-item.active { 
            color: #ff2d55; 
        }
        .nav-icon { 
            font-size: 24px; 
            display: block; 
            margin-bottom: 3px; 
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">LIVO</div>
        <div>
            <button style="padding:8px 16px; background:white; color:black; border:none; border-radius:6px; margin-right:8px;">লগইন</button>
            <button style="padding:8px 16px; background:#ff2d55; border:none; border-radius:6px;">নিবন্ধন</button>
        </div>
    </div>

    <div class="game-grid">
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/00cc66/fff?text=Teen+Patti" alt="Teen Patti">
            <div class="game-name">Teen Patti</div>
        </div>
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/ff6600/fff?text=Andar+Bahar" alt="Andar Bahar">
            <div class="game-name">Andar Bahar</div>
        </div>
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/9933ff/fff?text=Dragon+Tiger" alt="Dragon Tiger">
            <div class="game-name">Dragon Tiger</div>
        </div>
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/ff3366/fff?text=Crash" alt="Crash">
            <div class="game-name">Crash</div>
        </div>
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/00aaff/fff?text=Roulette" alt="Roulette">
            <div class="game-name">Roulette</div>
        </div>
        <div class="game-card">
            <img src="https://via.placeholder.com/200x120/ff9900/fff?text=Slots" alt="Slots">
            <div class="game-name">Lucky Spin</div>
        </div>
    </div>

    <div class="bottom-nav">
        <div class="nav-item active"><span class="nav-icon">🏠</span>হোম</div>
        <div class="nav-item"><span class="nav-icon">👥</span>আমন্ত্রণ</div>
        <div class="nav-item"><span class="nav-icon">🎁</span>প্রমোশন</div>
        <div class="nav-item"><span class="nav-icon">💬</span>সেবা</div>
        <div class="nav-item"><span class="nav-icon">👤</span>আমি</div>
    </div>

</body>
</html>

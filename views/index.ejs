<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="hero">
  <div class="container">
    <h1>Predict. Win. Dominate.</h1>
    <p>Join thousands of fans making match predictions and winning virtual coins</p>
    <% if(!locals.user) { %>
      <a href="/register" class="btn btn-primary" style="margin-right:1rem;">Get Started 🚀</a>
      <a href="/matches" class="btn btn-outline">View Matches</a>
    <% } else { %>
      <a href="/matches" class="btn btn-primary" style="margin-right:1rem;">Predict Now 🎯</a>
      <a href="/coins" class="btn btn-gold">Claim Daily Bonus 🎁</a>
    <% } %>
  </div>
</div>

<div class="container page">
  <%- include('partials/flash') %>
  <div class="layout-main">
    <div>
      <h2 class="section-title">🔥 Live & Upcoming Matches</h2>
      <% if(matches.length === 0) { %>
        <p style="color:var(--muted)">No matches available right now</p>
      <% } else { %>
        <div class="grid grid-2">
          <% matches.forEach(m => { %>
            <div class="match-card">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;">
                <span style="font-size:.8rem;color:var(--muted)">⚽ <%= m.sport %></span>
                <span class="status-badge status-<%= m.status %>"><%= m.status.toUpperCase() %></span>
              </div>
              <div class="match-teams">
                <div class="team"><div class="team-name"><%= m.team_a %></div></div>
                <div class="vs">VS</div>
                <div class="team"><div class="team-name"><%= m.team_b %></div></div>
              </div>
              <div class="match-meta">
                <span>📅 <%= new Date(m.match_date).toLocaleDateString() %></span>
                <span>🕐 <%= new Date(m.match_date).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></span>
              </div>
              <a href="/matches/<%= m.id %>" class="btn btn-primary btn-sm" style="margin-top:1rem;width:100%;justify-content:center;">Predict Now</a>
            </div>
          <% }) %>
        </div>
      <% } %>

      <h2 class="section-title" style="margin-top:2.5rem;">📰 Latest News</h2>
      <div class="grid grid-2">
        <% news.forEach(n => { %>
          <a href="/news/<%= n.id %>" class="news-card">
            <% if(n.image) { %><img src="<%= n.image %>" class="news-img" alt=""><% } %>
            <div class="news-body">
              <div class="news-title"><%= n.title %></div>
              <div class="news-meta">📝 <%= n.author %> · <%= new Date(n.created_at).toLocaleDateString() %></div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>

    <div>
      <div class="card" style="margin-bottom:1.5rem;">
        <div class="card-header">🏅 Top Players</div>
        <div class="card-body" style="padding:0;">
          <% topUsers.forEach((u, i) => { %>
            <div style="display:flex;align-items:center;gap:1rem;padding:.75rem 1.25rem;border-bottom:1px solid var(--border);">
              <span class="rank-<%= i+1 %>" style="font-weight:700;width:20px;">#<%= i+1 %></span>
              <div class="avatar"><%= u.username[0].toUpperCase() %></div>
              <div style="flex:1;">
                <div style="font-weight:600;font-size:.9rem"><%= u.username %></div>
                <div style="font-size:.75rem;color:var(--muted)"><%= u.total_points %> pts</div>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="card-body" style="padding:1rem;">
          <a href="/leaderboard" class="btn btn-outline btn-sm" style="width:100%;justify-content:center;">Full Leaderboard</a>
        </div>
      </div>

      <% if(locals.user) { %>
      <div class="card">
        <div class="card-header">⚡ Quick Actions</div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:.75rem;">
          <a href="/coins" class="btn btn-gold" style="justify-content:center;">🎁 Daily Bonus</a>
          <a href="/tournaments" class="btn btn-primary" style="justify-content:center;">🏆 Tournaments</a>
          <a href="/profile" class="btn btn-outline" style="justify-content:center;">👤 My Profile</a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
</body></html>

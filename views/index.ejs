<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%
  // ক্যাসিনো-প্রথম হোম। ফিল্টার সার্ভার-সাইডে (সাধারণ GET লিংক) — JS বন্ধ থাকলেও কাজ করে।
  const f = casino.filters;
  const facets = casino.facets;
  function homeHref(o) {
    const p = new URLSearchParams();
    const m = Object.assign({ cat: f.category, provider: f.provider, q: f.q, letter: f.letter }, o || {});
    Object.keys(m).forEach(function (k) { if (m[k]) p.set(k, m[k]); });
    const qs = p.toString();
    return '/' + (qs ? '?' + qs : '') + '#casino';
  }
  function catLabel(name) {
    const k = homeCasino.categoryLabelKey(name);
    return k ? t[k] : name;
  }
  const liveCat = facets.categories.find(function (c) { return /live/i.test(c.name); });
  const liveHref = liveCat ? '/?cat=' + encodeURIComponent(liveCat.name) + '#casino' : '/games';
  const showRails = !casino.filtered && f.page === 1;
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
%>

<style nonce="<%= cspNonce %>">
  @keyframes livedot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .3; transform: scale(1.4); } }
  <%- include('partials/home-shortcut-css') %>
  /* ===== প্রধান ন্যাভ (অনুভূমিক স্ক্রলযোগ্য চিপ) ===== */
  .main-cat-nav { display: flex; gap: 8px; padding: 4px 12px 12px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .main-cat-nav::-webkit-scrollbar { display: none; }
  .main-cat-item { flex: 0 0 auto; min-width: 62px; min-height: 62px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; padding: 9px 10px; border-radius: 14px; text-decoration: none; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: var(--text-muted); font-size: 10.5px; font-weight: 700; line-height: 1.1; text-align: center; transition: background .2s, color .2s, border-color .2s; }
  .main-cat-item i { font-size: 17px; }
  .main-cat-item:active { background: rgba(255,255,255,0.09); }
  .main-cat-item.is-primary { background: var(--grad-gold); color: #1a1a1a; border-color: transparent; }
  .main-cat-item:focus-visible, .cat-chip:focus-visible, .prov-chip:focus-visible, .az-link:focus-visible, .hc-card:focus-visible, .hb-btn:focus-visible, .hc-more:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  @media (min-width: 768px) {
    .main-cat-nav { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
    .main-cat-item { min-width: 88px; font-size: 12px; }
    .main-cat-item i { font-size: 20px; }
  }

  /* ===== শেল: মোবাইলে এক কলাম, ডেস্কটপে বাঁ-সাইডবার | মূল | ডান-সাইডবার ===== */
  .home-shell { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 0 0 84px; }
  .home-cats { min-width: 0; }
  .home-main { min-width: 0; }
  .home-matches { min-width: 0; }
  @media (min-width: 1024px) {
    .home-shell { grid-template-columns: 210px minmax(0, 1fr) 290px; align-items: start; padding: 0 16px 24px; }
    .home-cats, .home-matches { position: sticky; top: 70px; max-height: calc(100vh - 90px); overflow-y: auto; }
    .pub-bottom-nav { display: none; }
  }

  /* ===== ক্যাটাগরি: মোবাইলে অনুভূমিক চিপ, ডেস্কটপে উল্লম্ব তালিকা ===== */
  .home-cat-nav { display: flex; gap: 8px; padding: 0 12px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .home-cat-nav::-webkit-scrollbar { display: none; }
  .cat-chip { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 20px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); color: var(--text-muted); font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .cat-chip small { opacity: .7; font-weight: 600; }
  .cat-chip.active { background: var(--grad-gold); color: #000; border-color: transparent; }
  @media (min-width: 1024px) {
    .home-cat-nav { flex-direction: column; padding: 0; overflow: visible; background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 14px; padding: 8px; }
    .cat-chip { border-radius: 10px; justify-content: space-between; border: 0; background: transparent; }
    .cat-chip.active { background: var(--gold-soft, rgba(201,162,39,.18)); color: var(--text-accent); }
  }

  /* ===== প্রোমো স্লাইডার ===== */
  .hb { position: relative; margin: 0 12px 12px; border-radius: 14px; overflow: hidden; background: var(--bg-card); }
  .hb-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .hb-track::-webkit-scrollbar { display: none; }
  .hb-slide { flex: 0 0 100%; scroll-snap-align: start; display: block; aspect-ratio: 21 / 8; min-height: 110px; }
  .hb-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb-btn { position: absolute; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgba(0,0,0,.55) !important; color: #fff !important; cursor: pointer; z-index: 2; }
  .hb-prev { left: 8px; } .hb-next { right: 8px; }
  .promo-banner { background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%); border: 1px solid rgba(201,162,39,.3); position: relative; overflow: hidden; margin: 0 12px 12px; border-radius: 14px; }
  .promo-banner-content { padding: 16px 14px; min-height: 120px; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
  .promo-banner-badge { background: var(--grad-gold); color: #000; font-size: 10px; font-weight: 900; padding: 4px 10px; border-radius: 20px; align-self: flex-start; text-transform: uppercase; }
  .promo-banner-title { font-family: 'Teko', sans-serif; font-size: 28px; color: var(--gold-hover); line-height: 1.1; margin: 8px 0 3px; text-transform: uppercase; }
  .promo-banner-desc { font-size: 11px; color: var(--text-muted); margin: 0 0 10px; }
  .promo-banner-cta { display: inline-block; background: var(--grad-gold); color: #000; font-weight: 800; font-size: 11px; border-radius: 20px; padding: 7px 18px; text-decoration: none; }
  .promo-banner-art { position: absolute; right: 0; top: 0; height: 100%; width: auto; opacity: .85; }

  /* ===== সার্চ, প্রোভাইডার, A-Z ===== */
  .home-search { display: flex; gap: 8px; padding: 0 12px 10px; }
  .home-search input[type=search] { flex: 1; min-width: 0; padding: 10px 16px; border-radius: 30px; background: rgba(255,255,255,.04); border: 1px solid rgba(201,162,39,.2); color: var(--text-main); }
  .home-search button { border-radius: 30px; padding: 0 18px; font-weight: 800; font-size: 12px; cursor: pointer; }
  .home-chips { display: flex; gap: 8px; padding: 0 12px 10px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .home-chips::-webkit-scrollbar { display: none; }
  .prov-chip { flex: 0 0 auto; padding: 6px 14px; border-radius: 18px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); color: var(--text-muted); font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .prov-chip.active { border-color: var(--gold); color: var(--text-accent); box-shadow: 0 0 0 2px rgba(201,162,39,.2); }
  .az-index { display: flex; flex-wrap: wrap; gap: 4px; padding: 0 12px 12px; }
  .az-link { min-width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 12px; font-weight: 800; text-decoration: none; color: var(--text-main); background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); }
  .az-link.active { background: var(--grad-gold); color: #000; border-color: transparent; }
  .az-link.is-empty { opacity: .3; cursor: default; }
  .home-label { font-size: 11px; font-weight: 700; color: var(--text-muted); padding: 0 12px 6px; text-transform: uppercase; letter-spacing: .4px; }

  /* ===== গেম সারি ও গ্রিড ===== */
  .hc-section { margin: 0 0 14px; }
  .hc-head { display: flex; justify-content: space-between; align-items: center; padding: 0 12px 8px; }
  .hc-head h2 { margin: 0; font-size: 15px; }
  .hc-head a { font-size: 12px; font-weight: 700; color: var(--gold); text-decoration: none; }
  .hc-rail { display: flex; gap: 10px; overflow-x: auto; padding: 0 12px 6px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .hc-rail::-webkit-scrollbar { display: none; }
  .hc-rail .hc-card { flex: 0 0 120px; }
  .hc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 0 12px; }
  @media (min-width: 640px) { .hc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .hc-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 0 12px; } .hc-rail .hc-card { flex-basis: 140px; } }
  .hc-card { display: block; text-decoration: none; color: inherit; border-radius: 12px; overflow: hidden; background: var(--bg-card); border: 1px solid var(--border-glass); }
  .hc-card img, .hc-thumb-fallback { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  .hc-thumb-fallback { display: flex; align-items: center; justify-content: center; font-size: 30px; background: rgba(255,255,255,.04); }
  .hc-meta { padding: 6px 8px 8px; }
  .hc-name { font-size: 12px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hc-prov { font-size: 10px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hc-suspended { opacity: .5; filter: grayscale(.7); pointer-events: none; }
  .hc-empty { padding: 24px 12px; text-align: center; color: var(--text-muted); font-size: 13px; }
  .hc-more { display: block; margin: 14px 12px 0; padding: 11px; text-align: center; border-radius: 12px; background: var(--bg-surface); border: 1px solid var(--border-glass); color: var(--gold); font-weight: 800; font-size: 13px; text-decoration: none; }

  /* ===== লাইভ ম্যাচ: ডেস্কটপে ডান সংকীর্ণ সাইডবার, মোবাইলে ক্যাসিনোর নিচে ছোট সারি ===== */
  <%- include('partials/home-hub-css') %>
  @media (max-width: 1023px) {
    .home-hub .hh-list { display: flex; overflow-x: auto; gap: 8px; scrollbar-width: none; }
    .home-hub .hh-row { flex: 0 0 230px; }
    .home-hub .hh-empty, .home-hub .hh-more { flex: 0 0 100%; }
  }
  @media (min-width: 1024px) { .home-hub { margin: 0; } .hh-list { grid-template-columns: 1fr; } }
</style>
<%- include('partials/announcements') %>

<%- include('partials/flash') %>

<nav class="main-cat-nav" aria-label="<%= t.main_categories %>">
  <a href="/games" class="main-cat-item is-primary"><i class="fas fa-dice"></i><span><%= t.cat_casino %></span></a>
  <a href="<%= liveHref %>" class="main-cat-item"><i class="fas fa-video"></i><span><%= t.cat_live_casino %></span></a>
  <a href="/matches/cricket" class="main-cat-item"><i class="fas fa-baseball"></i><span><%= t.cat_cricket %></span></a>
  <a href="/sports" class="main-cat-item"><i class="fas fa-futbol"></i><span><%= t.cat_sports %></span></a>
  <a href="/matches/football" class="main-cat-item"><i class="fas fa-futbol"></i><span><%= t.cat_football %></span></a>
  <a href="/matches" class="main-cat-item"><i class="fas fa-tower-broadcast"></i><span><%= t.cat_live_matches %></span></a>
  <a href="/tournaments" class="main-cat-item"><i class="fas fa-trophy"></i><span><%= t.cat_tournaments %></span></a>
  <a href="/leaderboard" class="main-cat-item"><i class="fas fa-ranking-star"></i><span><%= t.cat_leaderboard %></span></a>
  <a href="/promotions" class="main-cat-item"><i class="fas fa-gift"></i><span><%= t.cat_promotions %></span></a>
</nav>

<div class="home-shell" id="casino">
  <aside class="home-cats">
    <nav class="home-cat-nav" id="categoryTabs" aria-label="<%= t.home_casino_categories %>">
      <a class="cat-chip <%= !f.category ? 'active' : '' %>" href="<%= homeHref({ cat: '', provider: '', q: '', letter: '' }) %>"><%= t.all %></a>
      <% facets.categories.forEach(function (c) { %>
        <a class="cat-chip <%= f.category === c.name ? 'active' : '' %>" href="<%= homeHref({ cat: c.name, provider: '', q: '', letter: '' }) %>" aria-label="<%= catLabel(c.name) %> (<%= c.count %>)"><span><%= catLabel(c.name) %></span> <small><%= c.count %></small></a>
      <% }); %>
    </nav>
  </aside>

  <main class="home-main">
    <% if (banners && banners.length) { %>
    <section class="hb" aria-roledescription="carousel" aria-label="<%= t.home_banners %>">
      <div class="hb-track" id="homeBanners" tabindex="0">
        <% banners.forEach(function (b, i) { %>
          <% if (b.link_url) { %><a class="hb-slide" href="<%= b.link_url %>"><img src="<%= b.image_url %>" alt="<%= b.title %>" <%= i === 0 ? 'loading=eager fetchpriority=high' : 'loading=lazy' %> decoding="async"></a>
          <% } else { %><div class="hb-slide"><img src="<%= b.image_url %>" alt="<%= b.title %>" <%= i === 0 ? 'loading=eager' : 'loading=lazy' %> decoding="async"></div><% } %>
        <% }); %>
      </div>
      <% if (banners.length > 1) { %>
      <button type="button" class="hb-btn hb-prev" id="hbPrev" aria-label="<%= t.home_banner_prev %>"><i class="fas fa-chevron-left"></i></button>
      <button type="button" class="hb-btn hb-next" id="hbNext" aria-label="<%= t.home_banner_next %>"><i class="fas fa-chevron-right"></i></button>
      <% } %>
    </section>
    <% } else { %>
    <div class="promo-banner">
      <div class="promo-banner-content">
        <div class="promo-banner-badge"><%= t.welcome_bonus %></div>
        <h1 class="promo-banner-title">100% Welcome Bonus</h1>
        <p class="promo-banner-desc"><%= t.welcome_bonus_desc %> - Up to 50,000 BDT match bonus on first deposit.</p>
        <div><a href="/payment/deposit" class="promo-banner-cta"><%= t.get_now %></a></div>
      </div>
      <img class="promo-banner-art" src="/images/hero/welcome-bonus.svg" alt="" aria-hidden="true" loading="eager" decoding="async" width="420" height="260">
    </div>
    <% } %>

    <%- include('partials/home-shortcuts') %>

    <form class="home-search" role="search" method="get" action="/#casino">
      <% if (f.category) { %><input type="hidden" name="cat" value="<%= f.category %>"><% } %>
      <% if (f.provider) { %><input type="hidden" name="provider" value="<%= f.provider %>"><% } %>
      <% if (f.letter) { %><input type="hidden" name="letter" value="<%= f.letter %>"><% } %>
      <input type="search" id="gameSearch" name="q" value="<%= f.q %>" maxlength="60" placeholder="<%= t.search_placeholder %>" aria-label="<%= t.home_search_label %>">
      <button type="submit"><%= t.home_search_button %></button>
    </form>

    <% if (facets.providers.length) { %>
    <div class="home-label"><%= t.home_providers %></div>
    <nav class="home-chips" id="providerChips" aria-label="<%= t.home_providers %>">
      <a class="prov-chip <%= !f.provider ? 'active' : '' %>" href="<%= homeHref({ provider: '' }) %>"><%= t.all %></a>
      <% facets.providers.forEach(function (p) { %>
        <a class="prov-chip <%= f.provider === p.name ? 'active' : '' %>" href="<%= homeHref({ provider: f.provider === p.name ? '' : p.name }) %>" aria-label="<%= p.name %> (<%= p.count %>)"><%= p.name %></a>
      <% }); %>
    </nav>
    <% } %>

    <div class="home-label"><%= t.home_az_index %></div>
    <nav class="az-index" id="azIndex" aria-label="<%= t.home_az_index %>">
      <% letters.forEach(function (L) { %>
        <% if (facets.letters.indexOf(L) === -1) { %><span class="az-link is-empty" aria-disabled="true"><%= L %></span>
        <% } else { %><a class="az-link <%= f.letter === L ? 'active' : '' %>" href="<%= homeHref({ letter: f.letter === L ? '' : L }) %>" aria-label="<%= L %>"<%- f.letter === L ? ' aria-current="true"' : '' %>><%= L %></a><% } %>
      <% }); %>
    </nav>
    <% if (casino.filtered) { %><div class="home-label"><a class="hc-more" href="/#casino"><%= t.home_clear_filters %></a></div><% } %>

    <% if (showRails) { %>
      <% [['popular', t.home_popular, casino.rails.popular], ['new', t.home_new, casino.rails.new]].forEach(function (r) { if (r[2].length) { %>
      <section class="hc-section" aria-label="<%= r[1] %>">
        <div class="hc-head"><h2><%= r[1] %></h2><a href="#allGames"><%= t.home_see_all %></a></div>
        <div class="hc-rail"><% r[2].forEach(function (g) { %><%- include('partials/home-game-card', { g: g, t: t }) %><% }); %></div>
      </section>
      <% } }); %>
      <% facets.categories.forEach(function (c) { const list = casino.rails.byCategory[c.name] || []; if (!list.length) return; %>
      <section class="hc-section" aria-label="<%= catLabel(c.name) %>">
        <div class="hc-head"><h2><%= catLabel(c.name) %></h2><a href="<%= homeHref({ cat: c.name }) %>"><%= t.home_see_all %></a></div>
        <div class="hc-rail"><% list.forEach(function (g) { %><%- include('partials/home-game-card', { g: g, t: t }) %><% }); %></div>
      </section>
      <% }); %>
    <% } %>

    <section class="hc-section" id="allGames" aria-label="<%= t.home_all_games %>">
      <div class="hc-head"><h2><%= t.home_all_games %></h2></div>
      <div class="hc-grid" id="gameContainer">
        <% casino.page.games.forEach(function (g) { %><%- include('partials/home-game-card', { g: g, t: t }) %><% }); %>
      </div>
      <% if (!casino.page.games.length) { %><div class="hc-empty"><%= t.no_games_found %></div><% } %>
      <% if (casino.page.hasMore) { %><a class="hc-more" rel="next" href="<%= homeHref({}).replace('#casino', '') + (homeHref({}).indexOf('?') === -1 ? '?' : '&') %>page=<%= f.page + 1 %>#allGames"><%= t.load_more %></a><% } %>
    </section>
  </main>

  <aside class="home-matches" aria-label="<%= t.home_live_matches %>">
    <section class="home-hub" id="homeHub" data-max="8"
         data-empty="<%= t.hub_no_matches || 'No matches in this view' %>"
         data-more="<%= t.hub_view_all || 'View all matches' %>"
         data-competitions="<%= t.hub_competitions || 'Competitions' %>">
      <div class="hh-head"><h3><%= t.home_live_matches %></h3><a href="/matches"><%= t.hub_view_all || 'View all matches' %></a></div>
      <div class="hh-tabs" id="hhTabs">
        <button type="button" class="hh-tab" data-filter="live"><%= t.hub_inplay || 'In-Play' %></button>
        <button type="button" class="hh-tab" data-filter="today"><%= t.hub_today || 'Today' %></button>
        <button type="button" class="hh-tab" data-filter="tomorrow"><%= t.hub_tomorrow || 'Tomorrow' %></button>
        <select class="hh-select" id="hhLeague" aria-label="<%= t.hub_competitions || 'Competitions' %>"><option value=""><%= t.hub_competitions || 'Competitions' %></option></select>
      </div>
      <div class="hh-list" id="hhList"></div>
    </section>
  </aside>
</div>
<script src="/js/views/home-matches.js" defer></script>

<!-- ===== Mega Jackpot + Recent Big Wins ===== -->
<style nonce="<%= cspNonce %>">
/* Mega Jackpot */
.mega-jackpot {
  margin: 20px 0 15px;
}
.jackpot-container {
  background: linear-gradient(90deg, #c8102e, #f5c400, #c8102e);
  border-radius: 0;
  padding: 18px 20px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  border-top: 4px solid #ffd700;
  border-bottom: 4px solid #ffd700;
  box-shadow: 0 0 25px rgba(255, 215, 0, 0.8);
  min-height: 145px;
}
.jackpot-container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 60%;
  height: 200%;
  background: linear-gradient(transparent, rgba(255,255,255,0.5), transparent);
  transform: rotate(25deg);
  animation: shine 4s linear infinite;
}
@keyframes shine {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(300%) rotate(25deg); }
}
.jackpot-text h2 {
  color: white;
  font-size: 27px;
  font-weight: 900;
  margin: 0 0 8px 0;
  text-shadow: 0 0 12px gold;
}
.jackpot-amount {
  color: white;
  font-size: 31px;
  font-weight: bold;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.6);
}
/* Recent Big Wins */
.recent-wins {
  margin: 0 0 20px;
  background: var(--bg-card);
  border-radius: 0;
  padding: 12px;
  border-top: 2px solid var(--gold);
  border-bottom: 2px solid var(--gold);
}
.recent-wins h3 {
  color: var(--text-accent);
  margin: 0 0 12px 0;
  font-size: 18px;
  text-align: center;
}
.wins-container {
  height: 220px;
  overflow: hidden;
  position: relative;
}
.win-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-main);
  padding: 9px 8px;
  border-bottom: 1px solid var(--border-glass);
  font-size: 14px;
}
.win-item:last-child { border-bottom: none; }
.game-name { color: var(--gold-hover); font-weight: 500; }
.win-amount { color: var(--green); font-weight: bold; }
.win-empty { padding: 14px 4px; text-align: center; color: var(--text-muted); font-size: 12.5px; }
.jackpot-tagline { color: #fff; font-size: 13px; font-weight: 700; margin-top: 6px; text-shadow: 0 2px 6px rgba(0,0,0,.5); }
</style>
<!-- Mega Jackpot -->
<!--
  আগে এখানে একটা স্থির, বানানো আট-অঙ্কের টাকার অঙ্ক লেখা ছিল যা কোনো ব্যাকএন্ড
  ডেটার সাথে যুক্ত ছিল না। ব্যাকএন্ডে কোনো জ্যাকপট পুল টেবিল নেই, তাই বানানো
  সংখ্যার বদলে ব্র্যান্ডিং ব্যানার হিসেবে রাখা হলো — কোনো আর্থিক দাবি ছাড়া।
-->
<div class="mega-jackpot">

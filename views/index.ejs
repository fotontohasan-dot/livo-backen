<!-- ===== Mega Jackpot + Recent Big Wins ===== -->
<style nonce="<%= cspNonce %>">
/* Mega Jackpot */
.mega-jackpot {
  margin: 20px 0 15px;
}
.jackpot-container {
  background: linear-gradient(90deg, #c8102e, #f5c400, #c8102e);
  border-radius: 0;
  padding: 18px 20px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  border-top: 4px solid #ffd700;
  border-bottom: 4px solid #ffd700;
  box-shadow: 0 0 25px rgba(255, 215, 0, 0.8);
  min-height: 145px;
}
.jackpot-container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 60%;
  height: 200%;
  background: linear-gradient(transparent, rgba(255,255,255,0.5), transparent);
  transform: rotate(25deg);
  animation: shine 4s linear infinite;
}
@keyframes shine {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(300%) rotate(25deg); }
}
.jackpot-text h2 {
  color: white;
  font-size: 27px;
  font-weight: 900;
  margin: 0 0 8px 0;
  text-shadow: 0 0 12px gold;
}
.jackpot-amount {
  color: white;
  font-size: 31px;
  font-weight: bold;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.6);
}
/* Recent Big Wins */
.recent-wins {
  margin: 0 0 20px;
  background: var(--bg-card);
  border-radius: 0;
  padding: 12px;
  border-top: 2px solid var(--gold);
  border-bottom: 2px solid var(--gold);
}
.recent-wins h3 {
  color: var(--text-accent);
  margin: 0 0 12px 0;
  font-size: 18px;
  text-align: center;
}
.wins-container {
  height: 220px;
  overflow: hidden;
  position: relative;
}
.win-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-main);
  padding: 9px 8px;
  border-bottom: 1px solid var(--border-glass);
  font-size: 14px;
}
.win-item:last-child { border-bottom: none; }
.game-name { color: var(--gold-hover); font-weight: 500; }
.win-amount { color: var(--green); font-weight: bold; }
.win-empty { padding: 14px 4px; text-align: center; color: var(--text-muted); font-size: 12.5px; }
.jackpot-tagline { color: #fff; font-size: 13px; font-weight: 700; margin-top: 6px; text-shadow: 0 2px 6px rgba(0,0,0,.5); }
</style>
<!-- Mega Jackpot -->
<!--
  আগে এখানে একটা স্থির, বানানো আট-অঙ্কের টাকার অঙ্ক লেখা ছিল যা কোনো ব্যাকএন্ড
  ডেটার সাথে যুক্ত ছিল না। ব্যাকএন্ডে কোনো জ্যাকপট পুল টেবিল নেই, তাই বানানো
  সংখ্যার বদলে ব্র্যান্ডিং ব্যানার হিসেবে রাখা হলো — কোনো আর্থিক দাবি ছাড়া।
-->
<div class="mega-jackpot">
  <div class="jackpot-container">
    <div class="jackpot-text">
      <h2>MEGA JACKPOT</h2>
      <div class="jackpot-tagline"><%= t.jackpot_tagline %></div>
    </div>
    <div class="jackpot-girl">
      <video src="/videos/jackpot-girl.mp4" poster="/images/hero/mega-jackpot.svg" style="width:130px; border-radius:8px; display:block;" autoplay loop muted playsinline></video>
    </div>
  </div>
</div>
<!-- Recent Big Wins — আসল ডেটা /games/api/recent-wins থেকে -->
<div class="recent-wins">
  <h3>Recent Big Wins</h3>
  <div class="wins-container" id="winsContainer">
    <div class="win-empty" id="winsState"><%= t.loading %></div>
  </div>
</div>
<script src="/js/views/index.js"></script>

<!-- ===== Why Choose Us / Benefits ===== -->
<style nonce="<%= cspNonce %>">
.why-us-section { padding: 34px 14px 12px; }
.why-us-heading { text-align: center; margin-bottom: 24px; }
.why-us-heading h2 {
  font-family: 'Teko', sans-serif; font-size: 30px; font-weight: 700; letter-spacing: 0.4px;
  background: linear-gradient(135deg, var(--text-main) 40%, var(--gold-hover) 90%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  margin: 0 0 6px;
}
.why-us-heading p { font-size: 12.5px; color: var(--text-muted); margin: 0; }
.why-us-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
.why-us-card {
  position: relative;
  background: var(--grad-surface);
  background-color: var(--bg-card);
  border: 1px solid var(--border-glass); border-radius: 18px; padding: 22px 16px; text-align: center;
  overflow: hidden;
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}
.why-us-card::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--grad-gold);
  opacity: 0; transition: opacity 0.25s ease;
}
.why-us-card:hover {
  transform: translateY(-4px);
  border-color: rgba(201, 162, 39,0.5);
  box-shadow: 0 12px 28px rgba(0,0,0,0.35), 0 0 0 1px rgba(201, 162, 39,0.08);
}
.why-us-card:hover::before { opacity: 1; }
.why-us-icon {
  width: 54px; height: 54px; border-radius: 16px; margin: 0 auto 14px;
  display: flex; align-items: center; justify-content: center; font-size: 22px;
  background: linear-gradient(135deg, rgba(201, 162, 39,0.22) 0%, rgba(201, 162, 39,0.06) 100%);
  border: 1px solid rgba(201, 162, 39,0.25);
  color: var(--gold-hover);
}
.why-us-card h3 { font-size: 14.5px; font-weight: 800; color: var(--text-main); margin: 0 0 7px; letter-spacing: 0.2px; }
.why-us-card p { font-size: 11.5px; color: var(--text-muted); line-height: 1.6; margin: 0; }

@media (min-width: 640px) {
  .why-us-grid { grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .why-us-card { padding: 28px 18px; }
}
</style>
<div class="why-us-section">

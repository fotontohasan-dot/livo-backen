  <div class="glass prov-item" data-provider="PP" style="flex:0 0 auto;padding:4px 15px;border-radius:20px;font-size:11px;color:var(--text-muted);border:1px solid var(--border-glass);cursor:pointer;">Pragmatic</div>
  <div class="glass prov-item" data-provider="EVO" style="flex:0 0 auto;padding:4px 15px;border-radius:20px;font-size:11px;color:var(--text-muted);border:1px solid var(--border-glass);cursor:pointer;">Evolution</div>
  <div class="glass prov-item" data-provider="JL" style="flex:0 0 auto;padding:4px 15px;border-radius:20px;font-size:11px;color:var(--text-muted);border:1px solid var(--border-glass);cursor:pointer;">Jili</div>

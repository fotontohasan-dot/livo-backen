<%- include('partials/head') %>

<style>
:root {
  --gold: #f5c518;
  --gold2: #e6a800;
  --red: #e8003d;
  --dark: #0a0a14;
  --card-bg: #12121f;
  --card-border: #1e1e35;
  --text: #e8e8f0;
  --muted: #7070a0;
  --green: #00d26a;
  --purple: #6b00ff;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#0a0a14; color:var(--text); font-family:'Hind Siliguri',sans-serif; max-width:480px; margin:0 auto;
overflow-x:hidden; margin-bottom:70px; }

.topbar { background:#0d0d1e; display:flex; align-items:center; justify-content:space-between; padding:8px 12px; border-bottom:1px solid #1a1a30; position:sticky; top:0; z-index:100; }
.logo { font-family:'Teko',sans-serif; font-size:28px;
font-weight:700; color:var(--gold); text-shadow:0 0 20px rgba(245,197,24,0.5); }
.logo span { color:#fff; }
.topbar-right { display:flex; align-items:center; gap:8px; }
.coin-box { background:linear-gradient(135deg,#1a1a30,#0d0d1e);
border:1px solid var(--gold2); border-radius:20px; padding:4px 10px; font-size:13px; color:var(--gold); display:flex; align-items:center; gap:4px; }
.btn-auth { border:none; border-radius:20px; padding:6px 14px; font-size:13px; font-weight:700; cursor:pointer;
text-decoration:none; }
.btn-login { background:linear-gradient(135deg,var(--gold),var(--gold2)); color:#000; }
.btn-reg   { background:linear-gradient(135deg,var(--red),#b00030); color:#fff; }
.topbar-icons { display:flex; gap:10px; }
.topbar-icons a { color:#ccc; font-size:18px;
text-decoration:none; }

.balance-bar { background:#0d0d1e; border-bottom:1px solid #1a1a30; padding:6px 12px; display:flex; align-items:center; justify-content:space-between; }
.balance-left { display:flex; align-items:center; gap:6px;
}
.balance-left span { font-size:13px; color:var(--muted); }
.balance-amount { font-family:'Teko',sans-serif; font-size:20px; color:var(--gold); }
.bal-btns { display:flex; gap:6px; }
.bal-btn { padding:5px 12px; border-radius:8px; font-size:12px;
font-weight:700; border:none; cursor:pointer; text-decoration:none; }
.bal-btn.dep { background:linear-gradient(135deg,var(--green),#009950); color:#fff; }
.bal-btn.wit { background:linear-gradient(135deg,#1a6bff,#0044cc); color:#fff; }

.marquee-bar { background:#060610; border-bottom:1px solid #1a1a30; padding:5px 0;
overflow:hidden; }
.marquee-inner { display:flex; white-space:nowrap; animation:marquee 28s linear infinite; }
.marquee-inner span { font-size:12px; color:var(--gold); padding:0 28px;
}
.marquee-inner span em { color:#fff; font-style:normal; }
@keyframes marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

.banner { position:relative; overflow:hidden; height:155px; }
.banner-slide { position:absolute; width:100%;
height:100%; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity 0.8s; }
.banner-slide.active { opacity:1; }
.bs1 { background:linear-gradient(135deg,#0a0a20,#1a0040,#0a0a20); }
.bs2 { background:linear-gradient(135deg,#0a1a00,#003020,#0a0a20); }
.bs3 { background:linear-gradient(135deg,#1a0a00,#300010,#0a0a20);
}
.banner-content { text-align:center; padding:20px; }
.banner-content h2 { font-family:'Teko',sans-serif; font-size:30px; color:var(--gold); line-height:1; text-shadow:0 0 30px rgba(245,197,24,0.8); }
.banner-content p { font-size:13px; color:#ccc;
margin-top:5px; }
.banner-btn { display:inline-block; margin-top:10px; background:linear-gradient(135deg,var(--gold),var(--gold2)); color:#000; padding:7px 22px; border-radius:25px; font-weight:700; font-size:13px; cursor:pointer; border:none; text-decoration:none; }
.banner-dots { position:absolute; bottom:8px; left:50%;
transform:translateX(-50%); display:flex; gap:5px; }
.dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.3); cursor:pointer; transition:all 0.3s; }
.dot.active { background:var(--gold); width:16px; border-radius:3px; }

.notice { margin:8px;
background:rgba(245,197,24,0.07); border:1px solid rgba(245,197,24,0.2); border-radius:8px; padding:8px 12px; display:flex; align-items:center; gap:8px; }
.notice p { font-size:12px; color:var(--gold); }
.aff-banner { background:linear-gradient(135deg,#1a0020,#300050);
margin:0 8px 8px; border-radius:10px; padding:10px 14px; display:flex; align-items:center; justify-content:space-between; border:1px solid #3a0070; }
.aff-banner h4 { font-size:13px; color:var(--gold);
}
.aff-banner p  { font-size:11px; color:#aaa; margin-top:2px; }
.aff-btn { background:linear-gradient(135deg,#7000ff,#4000cc); color:#fff; border:none; border-radius:15px; padding:6px 14px; font-size:12px; cursor:pointer; white-space:nowrap; text-decoration:none;
}

.stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:0 8px 8px; }
.stat-box { background:var(--card-bg); border:1px solid var(--card-border); border-radius:10px; padding:10px; text-align:center;
}
.stat-box h4 { font-family:'Teko',sans-serif; font-size:20px; color:var(--gold); }
.stat-box p  { font-size:10px; color:var(--muted); margin-top:2px; }

.cats { display:flex; overflow-x:auto; padding:8px; scrollbar-width:none;
}
.cats::-webkit-scrollbar { display:none; }
.cat { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:3px; padding:7px 12px; border-radius:10px; cursor:pointer; transition:all 0.2s;
border-bottom:2px solid transparent; }
.cat.active { border-bottom-color:var(--gold); background:rgba(245,197,24,0.08); }
.cat-icon  { font-size:20px; }
.cat-label { font-size:11px; color:var(--muted); white-space:nowrap; }
.cat.active .cat-label { color:var(--gold);
}

.search-wrap { padding:0 8px 8px; }
.search-inner { position:relative; }
.search-inner input { width:100%; padding:9px 40px 9px 14px; border-radius:25px; border:1px solid var(--card-border);
background:var(--card-bg); color:#fff; font-size:13px; outline:none; }
.search-inner span { position:absolute; right:14px; top:50%; transform:translateY(-50%); }

.sec-header { display:flex; align-items:center; justify-content:space-between; padding:8px 12px 5px;
}
.sec-header h3 { font-family:'Teko',sans-serif; font-size:19px; color:#fff; display:flex; align-items:center; gap:5px; }
.see-all { font-size:12px; color:var(--gold); background:rgba(245,197,24,0.1); border:1px solid rgba(245,197,24,0.2); border-radius:12px; padding:3px 10px;
cursor:pointer; text-decoration:none; }

.game-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:0 8px; }
.game-card { background:var(--card-bg); border:1px solid var(--card-border); border-radius:10px; overflow:hidden; cursor:pointer; transition:transform 0.2s;
}
.game-card:active { transform:scale(0.96); }
.game-thumb { width:100%; aspect-ratio:1; display:flex; align-items:center; justify-content:center; font-size:34px; position:relative; overflow:hidden; }
.game-thumb::after { content:''; position:absolute; inset:0;
background:linear-gradient(to bottom,transparent 50%,rgba(0,0,0,0.65) 100%); }
.g-badge { position:absolute; top:5px; left:5px; font-size:9px; font-weight:700; padding:2px 6px; border-radius:4px; z-index:2; }
.badge-hot { background:var(--red); color:#fff;
}
.badge-new { background:var(--green); color:#fff; }
.badge-pop { background:var(--gold); color:#000; }
.g-provider { position:absolute; bottom:5px; right:5px; font-size:9px; background:rgba(0,0,0,0.7); color:#aaa; padding:2px 5px; border-radius:4px; z-index:2;
}
.game-info { padding:6px 8px; }
.game-info h4 { font-size:11px; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.game-info p  { font-size:10px; color:var(--muted); margin-top:1px;
}
.no-games { grid-column:1/-1; text-align:center; padding:40px; color:var(--muted); }

.jackpot-sec { margin:12px 8px; background:linear-gradient(135deg,#1a0a00,#3d1a00,#1a0a00); border:1px solid #6d3000; border-radius:12px; padding:16px; text-align:center; position:relative; overflow:hidden;
}
.jackpot-sec::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at center,rgba(245,197,24,0.07) 0%,transparent 70%); }
.jackpot-label { font-size:11px; color:#f90; letter-spacing:3px; text-transform:uppercase; font-weight:700; }
.jackpot-amount { font-family:'Teko',sans-serif;
font-size:42px; color:var(--gold); text-shadow:0 0 30px rgba(245,197,24,0.6); line-height:1; margin:4px 0; }
.jackpot-sub { font-size:11px; color:#aaa; }
.jackpot-btn { margin-top:10px; background:linear-gradient(135deg,var(--gold),var(--gold2)); color:#000; border:none; border-radius:25px;
padding:10px 28px; font-size:14px; font-weight:700; cursor:pointer; }

.leader-table { margin:0 8px; background:var(--card-bg); border:1px solid var(--card-border); border-radius:10px; overflow:hidden; }
.leader-head { display:grid;
grid-template-columns:40px 1fr 1fr; padding:8px 12px; background:#0d0d1e; font-size:11px; color:var(--muted); font-weight:600; }
.leader-row { display:grid; grid-template-columns:40px 1fr 1fr; padding:8px 12px; border-top:1px solid var(--card-border);
align-items:center; }
.l-rank { font-family:'Teko',sans-serif; font-size:18px; color:var(--muted); }
.l-rank.r1{color:var(--gold)} .l-rank.r2{color:#c0c0c0} .l-rank.r3{color:#cd7f32}
.l-user { font-size:12px; color:var(--text); }
.l-amt  { font-size:13px; color:var(--green); font-family:'Teko',sans-serif; text-align:right;
}

.promo-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:0 8px; }
.promo-card { border-radius:10px; padding:14px; cursor:pointer;
}
.pc1{background:linear-gradient(135deg,#1a0050,#4000a0);border:1px solid #5000c0}
.pc2{background:linear-gradient(135deg,#003020,#006040);border:1px solid #008060}
.pc3{background:linear-gradient(135deg,#300010,#700030);border:1px solid #900040}
.pc4{background:linear-gradient(135deg,#1a1000,#403000);border:1px solid #605000}
.promo-card h4 { font-size:13px; color:#fff; font-weight:700; }
.promo-card p  { font-size:11px; color:rgba(255,255,255,0.6);
margin-top:3px; }
.promo-card .pval { font-family:'Teko',sans-serif; font-size:26px; color:var(--gold); margin-top:4px; }

.pay-row { display:flex; gap:8px; overflow-x:auto; padding:0 8px 8px; scrollbar-width:none;
}
.pay-row::-webkit-scrollbar{display:none}
.pay-chip { flex:0 0 auto; background:var(--card-bg); border:1px solid var(--card-border); border-radius:8px; padding:6px 12px; font-size:12px; color:var(--muted); }

.site-footer { background:#06060e; border-top:1px solid #1a1a30;
padding:16px 12px; text-align:center; }
.footer-logo { font-family:'Teko',sans-serif; font-size:22px; color:var(--gold); margin-bottom:8px; }
.footer-links { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:10px; }
.footer-links a { font-size:11px;
color:var(--muted); text-decoration:none; }
.footer-text { font-size:10px; color:#404060; line-height:1.6; }
.lic-badges { display:flex; gap:10px; justify-content:center; margin-bottom:10px; }
.lic-badge { background:var(--card-bg); border:1px solid var(--card-border); border-radius:6px;
padding:4px 10px; font-size:10px; color:var(--muted); }

.bottom-nav { position:fixed; bottom:0; left:50%; transform:translateX(-50%); width:100%; max-width:480px; background:#0d0d1e; border-top:1px solid #1a1a30; display:flex; z-index:100;
}
.nav-link { flex:1; display:flex; flex-direction:column; align-items:center; padding:8px 4px; text-decoration:none; }
.nav-link .nav-icon { font-size:20px; color:var(--muted); }
.nav-link span:last-child { font-size:10px; color:var(--muted); margin-top:2px;
}
.nav-link.active .nav-icon, .nav-link.active span:last-child { color:var(--gold); }
.nav-center-wrap { flex:1; display:flex; flex-direction:column; align-items:center; padding:4px; }
.nav-center-btn { width:50px; height:50px; background:linear-gradient(135deg,var(--gold),var(--gold2)); border-radius:50%; display:flex;
align-items:center; justify-content:center; font-size:22px; margin-top:-14px; border:3px solid #0d0d1e; box-shadow:0 0 20px rgba(245,197,24,0.4); text-decoration:none; }
.nav-center-label { font-size:10px; color:var(--gold); margin-top:1px; }

.divider { height:1px;
background:linear-gradient(to right,transparent,#1a1a30,transparent); margin:10px 0; }
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
.live-dot{display:inline-block;width:7px;height:7px;background:var(--red);border-radius:50%;animation:pulse 1.5s infinite;margin-right:4px;}

.gc1{background:linear-gradient(135deg,#1a0050,#400080)}
.gc2{background:linear-gradient(135deg,#002040,#005090)}
.gc3{background:linear-gradient(135deg,#300010,#800030)}
.gc4{background:linear-gradient(135deg,#0a2000,#205000)}
.gc5{background:linear-gradient(135deg,#201000,#604000)}
.gc6{background:linear-gradient(135deg,#001020,#003060)}
.gc7{background:linear-gradient(135deg,#200030,#600090)}
.gc8{background:linear-gradient(135deg,#101010,#303030)}
.gc9{background:linear-gradient(135deg,#300000,#900020)}
.gc10{background:linear-gradient(135deg,#001a30,#004070)}
.gc11{background:linear-gradient(135deg,#0a0020,#200050)}
.gc12{background:linear-gradient(135deg,#200010,#500030)}

/* Side Menu */
.side-menu { position:fixed; top:0; left:-280px; width:280px; height:100%; background:#0d0d1e; z-index:9999;
transition:left 0.3s; border-right:1px solid rgba(245,197,24,0.2); overflow-y:auto; }
.side-menu.open { left:0; }
.menu-overlay { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9998;
}
.menu-overlay.open { display:block; }
.menu-item { display:flex; align-items:center; gap:12px; padding:13px 20px; color:#fff; text-decoration:none; border-bottom:1px solid rgba(255,255,255,0.05); font-size:14px; }
.menu-item:hover { background:rgba(245,197,24,0.05);
}
</style>

<link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="side-menu" id="sideMenu">
  <div style="padding:20px;border-bottom:1px solid rgba(245,197,24,0.15);display:flex;align-items:center;justify-content:space-between;">
    <span style="font-family:'Teko',sans-serif;font-size:1.8rem;font-weight:900;color:var(--gold);">LIVO</span>
    <button onclick="toggleMenu()" style="background:none;border:none;color:#fff;font-size:22px;cursor:pointer;">✕</button>
  </div>
  <% if(locals.user) { %>
  <div style="padding:15px 20px;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:12px;">
    <div style="width:45px;height:45px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold2));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;color:#000;">
      <%= user.username[0].toUpperCase() %>
    </div>
    <div>
      <div style="font-weight:700;color:#fff;"><%= user.username %></div>
      <div style="color:var(--gold);font-size:.85rem;">🪙 <%= user.coins %></div>
    </div>
  </div>
  <% } %>
  <a href="/" class="menu-item">🏠 হোম</a>
  <a href="/games/aviator" class="menu-item">🚀 Aviator</a>
  <a href="/games/slots" class="menu-item">🎰 Slots</a>
  <a href="/games/color-prediction" class="menu-item">🌈 Color Prediction</a>
  <a href="/games/dragon-tiger" class="menu-item">🐉 Dragon Tiger</a>
  <a href="/games/mine" class="menu-item">💣 Mine Game</a>
  <a href="/matches" class="menu-item">⚽ স্পোর্টস</a>
  <a href="/tournaments" class="menu-item">🏆 টুর্নামেন্ট</a>
  <a href="/payment/deposit" class="menu-item">💰 ডিপোজিট</a>
  <a href="/payment/withdraw" class="menu-item">💸 উইথড্র</a>
  <a href="/leaderboard" class="menu-item">🏅 লিডারবোর্ড</a>
  <a href="/news" class="menu-item">📰 নিউজ</a>
  <a href="/profile" class="menu-item">👤 প্রোফাইল</a>
  <% if(locals.user && user.role === 'admin') { %>
  <a href="/admin" class="menu-item" style="color:var(--gold);">⚙️ এডমিন প্যানেল</a>
  <% } %>
  <% if(locals.user) { %>
  <a href="/logout" class="menu-item" style="color:#ff4444;">🚪 লগআউট</a>
  <% } else { %>
  <a href="/login" class="menu-item" style="color:var(--green);">🔑 লগইন</a>
  <a href="/register" class="menu-item" style="color:var(--gold);">📝 রেজিস্টার</a>
  <% } %>
</div>
<div class="menu-overlay" id="menuOverlay" onclick="toggleMenu()"></div>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:10px;">
    <button onclick="toggleMenu()" style="background:none;border:none;color:#fff;font-size:24px;cursor:pointer;padding:0;line-height:1;">☰</button>
    <div class="logo">LI<span>VO</span></div>
  </div>
  <div class="topbar-right">
    <% if(locals.user) { %>
      <div class="coin-box">🪙 <%= user.coins %></div>
      <div class="topbar-icons">
        <a href="/notifications">🔔</a>
        <a href="/news">✉️</a>
      </div>
    <% } else { %>
      <a href="/login" class="btn-auth btn-login">লগইন</a>
      <a href="/register" class="btn-auth btn-reg">রেজিস্টার</a>
    <% } %>
  </div>
</div>

<% if(locals.user) { %>
<div class="balance-bar">
  <div class="balance-left">
    <span>ব্যালেন্স:</span>
    <div class="balance-amount">৳ <%= user.coins %></div>
  </div>
  <div class="bal-btns">
    <a href="/payment/deposit" class="bal-btn dep">ডিপোজিট</a>
    <a href="/payment/withdraw" class="bal-btn wit">উইথড্র</a>
  </div>
</div>
<% } %>

<div class="marquee-bar">
  <div class="marquee-inner">
    <span>🏆 <em>***৮৮২</em> জিতেছেন ৳১৫,৬৮,৫২৩!</span>
    <span>🎰 <em>***৯৫৫</em> স্লটে জিতেছেন ৳১০,১২,৮৯৮!</span>
    <span>🎯 <em>***১১৮</em> লাইভে জিতেছেন ৳৯,৯৮,৫৪১!</span>
    <span>⚽ <em>***৭৮৯</em> স্পোর্টসে জিতেছেন ৳৩,৮২,০০২!</span>
    <span>🏆 <em>***৮৮২</em> জিতেছেন ৳১৫,৬৮,৫২৩!</span>
    <span>🎰 <em>***৯৫৫</em> স্লটে জিতেছেন ৳১০,১২,৮৯৮!</span>
    <span>🎯 <em>***১১৮</em> লাইভে জিতেছেন ৳৯,৯৮,৫৪১!</span>
    <span>⚽ <em>***৭৮৯</em> স্পোর্টসে জিতেছেন ৳৩,৮২,০০২!</span>
  </div>
</div>

<div class="banner" id="banner">
  <div class="banner-slide bs1 active">
    <div class="banner-content">
      <h2>🎰 ওয়েলকাম বোনাস</h2>
      <p>প্রথম ডিপোজিটে ১০০% বোনাস পান</p>
      <a href="/payment/deposit" class="banner-btn">এখনই নিন</a>
    </div>
  </div>
  <div class="banner-slide bs2">
    <div class="banner-content">
      <h2>⚽ স্পোর্টস বেটিং</h2>
      <p>লাইভ মাচে বেট করুন এবং জিতুন</p>
      <a href="/matches" class="banner-btn">বেট করুন</a>
    </div>
  </div>
  <div class="banner-slide bs3">
    <div class="banner-content">
      <h2>🏆 টুর্নামেন্ট</h2>
      <p>প্রতিদিন অংশ নিন, বড় পুরস্কার জিতুন</p>
      <a href="/tournaments" class="banner-btn">যোগ দিন</a>
    </div>
  </div>
  <div class="banner-dots">
    <div class="dot active" onclick="goSlide(0)"></div>
    <div class="dot" onclick="goSlide(1)"></div>
    <div class="dot" onclick="goSlide(2)"></div>
  </div>
</div>


<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .sp26-1.sp26-1 { display: none; }
  /* Inline style attributes migrated to classes (CSP style-src-attr
     hardening). Every migrated declaration was proved cascade-equivalent:
     see tools/cascade-check.js. */
  .dz48-1 { flex: 1; overflow: hidden; }
  .dz48-2 { font-size: 12px; color: var(--text-muted); white-space: nowrap; animation: marquee-text 18s linear infinite; }
  .dz48-3 { font-family: 'Teko', sans-serif; font-size: 30px; color: var(--gold-hover); line-height: 1.1; margin: 8px 0 3px 0; text-transform: uppercase; }
  .dz48-4 { font-size: 11px; color: var(--text-muted); margin-bottom: 10px; font-weight: 500; }
  .dz48-5 { background: var(--grad-gold); color: #000; font-weight: 800; font-size: 11px; border-radius: 20px; padding: 7px 18px; }
  .dz48-6 { font-size: 9px; margin-left: 4px; }
  .dz48-7 { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 0 12px 10px; }
  .dz48-8 { font-size: 11px; color: var(--text-muted); margin-right: 2px; }
  .dz48-9 { padding: 0 12px 15px 12px; }
  .dz48-10 { position: relative; }
  .dz48-11 { padding-right: 45px; border-radius: 30px; background: rgba(255,255,255,0.04); border-color: rgba(201, 162, 39,0.2); }
  .dz48-12 { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
  .dz48-13 { width: 130px; border-radius: 8px; display: block; }
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }

/* এই সেকশনের সব var(--fa-gold*)/var(--fa-*) রেফারেন্স নিচের গ্লোবাল থিম টোকেনে
   (public/css/style.css) সরাসরি পয়েন্ট করা হয়েছে, যাতে body.light-mode টগলে হোমপেজের
   হিরো ব্যাজ/ক্যাটাগরি/প্রোভাইডার বাটন ইত্যাদিও বাকি সাইটের মতো থিম-অ্যাওয়্যার থাকে। */

.promo-banner {
  background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%);
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-left: none;
  border-right: none;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  border-radius: 0;
  overflow: hidden;
  position: relative;
  margin: 0 0 12px 0;
}

.promo-banner-content {
  background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
  padding: 16px 14px;
  min-height: 130px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.promo-banner-badge {
  background: var(--grad-gold);
  color: #000;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 20px;
  align-self: flex-start;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 10px rgba(201, 162, 39, 0.5);
}

/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  margin: 0 0 12px 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border-glass);
  border-bottom: 1px solid var(--border-glass);
  border-radius: 0;
  padding: 7px 0;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
}

.shortcut-item:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}

.shortcut-icon-wrapper {
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--text-accent);
  margin-bottom: 3px;
  box-shadow: none;
}

.shortcut-label {
  font-size: 10px;
  font-weight: 500;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 0.1px;
}

/* Horizontal Navigation Tabs */
.horizontal-nav-container {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  padding: 5px 12px 15px 12px;
  scrollbar-width: none;
}
.horizontal-nav-container::-webkit-scrollbar {
  display: none;
}

.nav-tab-item {
  flex: 0 0 auto;
  padding: 10px 20px;
  border-radius: 30px;
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.nav-tab-item.active {
  background: var(--grad-gold);
  color: var(--text-inverse) !important;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(201, 162, 39, 0.4);
}

.nav-tab-item.active i {
  color: var(--text-inverse);
}

.game-grid-premium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding: 0 12px;
}

/* এখনো চালু হয়নি এমন গেম — দেখা যায়, কিন্তু খেলা যায় না।
   সার্ভারে লজিক নেই বলে ক্লিক নিষ্ক্রিয়; ব্যাজে "শীঘ্রই" লেখা থাকে। */
.game-card-soon { opacity: .55; cursor: not-allowed; filter: grayscale(.6); }
.game-card-soon:hover { transform: none; }
.badge-soon { background: #6b7280; color: #fff; }

.game-card-premium {
  background: var(--grad-surface);
  background-color: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.game-card-premium:hover {
  transform: scale(1.02);
  border-color: var(--gold);
}

.game-thumb-wrapper {
  aspect-ratio: 16/10;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  position: relative;
  border-bottom: 1px solid var(--border-glass);
}

.game-info-premium {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.game-title-premium {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-provider-premium {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-accent);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.game-badge-premium {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 3px 8px 3px 6px;
  border-radius: 6px;
  font-size: 8px;
  font-weight: 800;
  color: #1a1200;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: var(--grad-gold);
  box-shadow: 0 2px 8px rgba(201, 162, 39,0.45);
}
.game-badge-premium.badge-new { background: linear-gradient(135deg, #34d399 0%, var(--primary) 100%); color: var(--text-inverse); box-shadow: 0 2px 8px var(--primary-glow); }
.game-badge-premium.badge-hot::before { content: "\f06d"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 7px; }
.game-badge-premium.badge-new::before { content: "\f005"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 7px; }

.marquee-container-premium {
  background: rgba(201, 162, 39, 0.08);
  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 8px;
  margin: 10px 12px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.marquee-label-premium {
  color: var(--text-accent);
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}

/* ===== Golden Shimmer / Glow — Welcome Banner + Jackpot (dark & light mode) ===== */
@keyframes goldShimmerSweep {
  0%   { transform: translateX(-150%) skewX(-20deg); }
  100% { transform: translateX(250%) skewX(-20deg); }
}
@keyframes goldGlowPulse {
  0%, 100% { text-shadow: 0 0 8px rgba(255,215,0,0.35), 0 0 18px rgba(201, 162, 39,0.25), 0 2px 4px rgba(0,0,0,0.6); }
  50%      { text-shadow: 0 0 16px rgba(255,215,0,0.65), 0 0 32px rgba(201, 162, 39,0.5), 0 2px 4px rgba(0,0,0,0.6); }
}

.promo-banner {
  background:
    radial-gradient(circle at 15% 15%, rgba(255,215,0,0.16) 0%, transparent 45%),
    radial-gradient(circle at 90% 85%, rgba(201, 162, 39,0.14) 0%, transparent 50%),
    linear-gradient(135deg, #1C1E22 0%, #0F1012 100%) !important;
  border: 1px solid rgba(201, 162, 39, 0.4) !important;
  box-shadow: 0 4px 25px rgba(0,0,0,0.5), inset 0 0 25px rgba(201, 162, 39,0.08) !important;
}

.promo-banner::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 55%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.16) 45%, rgba(255,215,0,0.3) 50%, rgba(255,235,160,0.16) 55%, transparent 100%);
  animation: goldShimmerSweep 5s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.promo-banner-title {
  animation: goldGlowPulse 3s ease-in-out infinite;
}

.jackpot-board {
  background:
    radial-gradient(circle at center, rgba(255,215,0,0.10) 0%, transparent 60%),
    radial-gradient(circle at center, #1F2226 0%, #0D0E10 100%) !important;
}

.jackpot-board::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.09) 45%, rgba(255,215,0,0.18) 50%, rgba(255,235,160,0.09) 55%, transparent 100%);
  animation: goldShimmerSweep 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.jackpot-title, #jp-num {
  animation: goldGlowPulse 3s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

.promo-banner-content, .promo-banner > div:last-child {
  position: relative;
  z-index: 2;
}

/* Light mode: keep the same rich dark gold card, but frame it so it visibly floats off a white page */
body.light-mode .promo-banner {
  border: 1.5px solid var(--gold) !important;
  box-shadow: 0 10px 30px rgba(201, 162, 39,0.3), 0 2px 10px rgba(0,0,0,0.12) !important;
}
</style>

<!-- HERO SECTION সরানো হয়েছে (ইউজারের অনুরোধে) —
     বড় প্রোমোশনাল হেডলাইন ব্যানার এবং
     তার CTA/স্ট্যাট ব্লকসহ সম্পূর্ণ সেকশনটা বাদ দেওয়া হয়েছে। সংশ্লিষ্ট .hero-* CSS
     শুধু এই সেকশনেই ব্যবহৃত হতো, তাই সেটাও একসাথে সরানো হলো। -->

<!-- ===== টিকার বার (bk666-স্টাইল), হেডার/নেভবারের ঠিক নিচে =====
     পুরনো স্ট্যাটিক মার্কি (t.home_marquee) সরিয়ে partials/announcements.ejs-এর
     ডায়নামিক 'scrolling' টিকার ব্যবহার করা হলো, যাতে একই জায়গায় দুটো টিকার
     না দেখায় এবং অ্যাডমিন প্যানেল থেকে তৈরি নোটিশ এখানে রিয়েল-টাইমে আসে। -->
<%- include('partials/announcements') %>

<%
  const c = casino;
  const f = c.filters;
  const url = function (over) {
    const p = Object.assign({ q: f.q, category: f.category, provider: f.provider, letter: f.letter }, over || {});
    const parts = [];
    ['q', 'category', 'provider', 'letter', 'page'].forEach(function (k) { if (p[k]) parts.push(k + '=' + encodeURIComponent(p[k])); });
    return '/' + (parts.length ? '?' + parts.join('&') : '');
  };
  const catLabel = function (x) { return (x.key && t['hc_cat_' + x.key]) || x.name; };
%>

<!-- ===== মূল ন্যাভিগেশন: ক্যাসিনো, লাইভ ক্যাসিনো, ক্রিকেট, স্পোর্টস, তারপর বাকি ট্যাব ===== -->
<style nonce="<%= cspNonce %>">
  .main-cat-nav {
    display: flex; gap: 8px; padding: 4px 12px 14px;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .main-cat-nav::-webkit-scrollbar { display: none; }
  .main-cat-item {
    flex: 0 0 auto; min-width: 62px; min-height: 62px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    padding: 9px 10px; border-radius: 14px; text-decoration: none;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    color: var(--text-muted); font-size: 10.5px; font-weight: 700; line-height: 1.1;
    text-align: center; transition: background .2s, color .2s, border-color .2s;
  }
  .main-cat-item i { font-size: 17px; }
  .main-cat-item:active { background: rgba(255,255,255,0.09); }
  .main-cat-item.is-primary {
    background: var(--grad-gold); color: #1a1a1a; border-color: transparent;
  }
  @media (min-width: 768px) {
    .main-cat-nav { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
    .main-cat-item { min-width: 88px; font-size: 12px; }

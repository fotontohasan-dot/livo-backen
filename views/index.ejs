<%- include('partials/bottom-nav', { activePage: 'home' }) %>

<script>
    const games = [
        {name:"Aviator",           emoji:"✈️", type:"pvp", slug: "aviator"},
        {name:"Teen Patti",        emoji:"🃏", type:"pvp", slug: "teen-patti"},
        {name:"Andar Bahar",       emoji:"🎴", type:"pvp", slug: "andar-bahar"},
        {name:"Blackjack",         emoji:"♠️", type:"table", slug: "blackjack"},
        {name:"Poker",             emoji:"🃏", type:"pvp", slug: "poker"},
        {name:"Baccarat",          emoji:"🎰", type:"table", slug: "baccarat"},
        {name:"Roulette",          emoji:"🎡", type:"table", slug: "roulette"},
        {name:"Slots",             emoji:"🎰", type:"slots", slug: "slots"},
        {name:"Online Ludo",       emoji:"🎲", type:"pvp", slug: "ludo"},
        {name:"Dragon Tiger",      emoji:"🐉", type:"pvp"},
        {name:"Super Ace",         emoji:"🂡", type:"slots"},
        {name:"Fortune Gems",      emoji:"💎", type:"slots"},
        {name:"Golden Empire",     emoji:"👑", type:"slots"},
        {name:"Sweet Bonanza",     emoji:"🍭", type:"slots"},
        {name:"Gates of Olympus",  emoji:"⚡", type:"slots"},
        {name:"Starlight Princess",emoji:"⭐", type:"slots"},
        {name:"Fruit Party",       emoji:"🍎", type:"slots"},
        {name:"Boxing King",       emoji:"🥊", type:"slots"},
        {name:"Sugar Rush",        emoji:"🍬", type:"slots"},
        {name:"Wolf Gold",         emoji:"🐺", type:"slots"},
        {name:"Joker's Jewels",    emoji:"🤡", type:"slots"},
        {name:"Crash",             emoji:"🚀", type:"pvp"},
        {name:"Lucky Spin",        emoji:"🎰", type:"slots"},
        {name:"Color Prediction",  emoji:"🌈", type:"pvp"},
        {name:"Blackjack Live",    emoji:"♠️", type:"live"},
        {name:"Baccarat Live",     emoji:"🎰", type:"live"},
        {name:"Roulette Live",     emoji:"🎡", type:"live"},
        {name:"Dragon Tiger Live", emoji:"🐯", type:"live"},
        {name:"Crazy Time",        emoji:"🎪", type:"live"},
        {name:"Mega Ball",         emoji:"🎱", type:"live"},
        {name:"Monopoly Live",     emoji:"🎩", type:"live"},
        {name:"Cricket Live",      emoji:"🏏", type:"sports"},
        {name:"Football Match",    emoji:"⚽", type:"sports"}
    ];

    const bgColors = [
        "linear-gradient(135deg,#1a0050,#6b00ff)",
        "linear-gradient(135deg,#500030,#ff00aa)",
        "linear-gradient(135deg,#003050,#00aaff)",
        "linear-gradient(135deg,#502000,#ff6600)",
        "linear-gradient(135deg,#005030,#00cc66)",
        "linear-gradient(135deg,#500010,#ff3366)",
        "linear-gradient(135deg,#300050,#9900ff)",
        "linear-gradient(135deg,#503000,#ff9900)",
        "linear-gradient(135deg,#004040,#00ffcc)",
        "linear-gradient(135deg,#500020,#ff0066)",
        "linear-gradient(135deg,#001050,#3366ff)",
        "linear-gradient(135deg,#502010,#ff6633)"
    ];

    let currentType = 'all';
    let searchQuery = '';

    function renderGames() {
        const container = document.getElementById('gameContainer');
        container.innerHTML = '';

        const filtered = games.filter(g => {
            const matchesType = currentType === 'all' || g.type === currentType;
            const matchesSearch = g.name.toLowerCase().includes(searchQuery.toLowerCase());
            return matchesType && matchesSearch;
        });

        filtered.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'game-card';
            card.style.animationDelay = `${index * 0.05}s`;
            const bg = bgColors[index % bgColors.length];
            const playUrl = item.slug ? `/games/${item.slug}` : '/login';

            card.innerHTML = `
                <div class="game-thumb" style="background: ${bg}">${item.emoji}</div>
                <h3 class="game-name">${item.name}</h3>
                <button class="play-btn" onclick="location.href='${playUrl}'">খেলুন</button>
            `;
            container.appendChild(card);
        });

        if (filtered.length === 0) {
            container.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-muted);">কোনো গেম পাওয়া যায়নি</div>';
        }
    }

    // Category Filter
    document.querySelectorAll('.category-item').forEach(item => {
        item.addEventListener('click', (e) => {
            document.querySelectorAll('.category-item').forEach(i => i.classList.remove('active'));
            item.classList.add('active');
            currentType = item.getAttribute('data-type');
            document.getElementById('sectionTitle').innerText = item.innerText;
            renderGames();
        });
    });

    // Search Filter
    document.getElementById('gameSearch').addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderGames();
    });

    // Initial render
    renderGames();
</script>

</body></html>

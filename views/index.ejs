    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);"><%= t.support %></div>
  </div>
</div>

<!-- ===== Search ===== -->
<div style="padding:0 12px 10px;">
  <div style="position:relative;">
    <input type="text" id="gameSearch" class="form-input" placeholder="<%= t.search_placeholder %>" style="padding-right:45px;">
    <i class="fas fa-search" style="position:absolute;right:15px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>

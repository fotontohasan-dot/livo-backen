<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style nonce="<%= cspNonce %>">
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }

/* এই সেকশনের সব var(--fa-gold*)/var(--fa-*) রেফারেন্স নিচের গ্লোবাল থিম টোকেনে
   (public/css/style.css) সরাসরি পয়েন্ট করা হয়েছে, যাতে body.light-mode টগলে হোমপেজের
   হিরো ব্যাজ/ক্যাটাগরি/প্রোভাইডার বাটন ইত্যাদিও বাকি সাইটের মতো থিম-অ্যাওয়্যার থাকে। */

.promo-banner {
  background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%);
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-left: none;
  border-right: none;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  border-radius: 0;
  overflow: hidden;
  position: relative;
  margin: 0 0 12px 0;
}

.promo-banner-content {
  background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
  padding: 16px 14px;
  min-height: 130px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.promo-banner-badge {
  background: var(--grad-gold);
  color: #000;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 20px;
  align-self: flex-start;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 10px rgba(201, 162, 39, 0.5);
}

/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  margin: 0 0 12px 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border-glass);
  border-bottom: 1px solid var(--border-glass);
  border-radius: 0;
  padding: 7px 0;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
}

.shortcut-item:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}

.shortcut-icon-wrapper {
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--text-accent);
  margin-bottom: 3px;
  box-shadow: none;
}

.shortcut-label {
  font-size: 10px;
  font-weight: 500;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 0.1px;
}

/* Horizontal Navigation Tabs */
.horizontal-nav-container {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  padding: 5px 12px 15px 12px;
  scrollbar-width: none;
}
.horizontal-nav-container::-webkit-scrollbar {
  display: none;
}

.nav-tab-item {
  flex: 0 0 auto;
  padding: 10px 20px;
  border-radius: 30px;
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.nav-tab-item.active {
  background: var(--grad-gold);
  color: var(--text-inverse) !important;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(201, 162, 39, 0.4);
}

.nav-tab-item.active i {
  color: var(--text-inverse);
}

.game-grid-premium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding: 0 12px;
}

/* এখনো চালু হয়নি এমন গেম — দেখা যায়, কিন্তু খেলা যায় না।
   সার্ভারে লজিক নেই বলে ক্লিক নিষ্ক্রিয়; ব্যাজে "শীঘ্রই" লেখা থাকে। */
.game-card-soon { opacity: .55; cursor: not-allowed; filter: grayscale(.6); }
.game-card-soon:hover { transform: none; }
.badge-soon { background: #6b7280; color: #fff; }

.game-card-premium {
  background: var(--grad-surface);
  background-color: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.game-card-premium:hover {
  transform: scale(1.02);
  border-color: var(--gold);
}

.game-thumb-wrapper {
  aspect-ratio: 16/10;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  position: relative;
  border-bottom: 1px solid var(--border-glass);
}

.game-info-premium {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.game-title-premium {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-provider-premium {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-accent);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.game-badge-premium {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 3px 8px 3px 6px;
  border-radius: 6px;
  font-size: 8px;
  font-weight: 800;
  color: #1a1200;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: var(--grad-gold);
  box-shadow: 0 2px 8px rgba(201, 162, 39,0.45);
}
.game-badge-premium.badge-new { background: linear-gradient(135deg, #6ee7ff 0%, #3b82f6 100%); color: #04121f; box-shadow: 0 2px 8px rgba(59,130,246,0.4); }
.game-badge-premium.badge-hot::before { content: "\f06d"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 7px; }
.game-badge-premium.badge-new::before { content: "\f005"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 7px; }

.marquee-container-premium {
  background: rgba(201, 162, 39, 0.08);
  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 8px;
  margin: 10px 12px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.marquee-label-premium {
  color: var(--text-accent);
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}

/* ===== Golden Shimmer / Glow — Welcome Banner + Jackpot (dark & light mode) ===== */
@keyframes goldShimmerSweep {
  0%   { transform: translateX(-150%) skewX(-20deg); }
  100% { transform: translateX(250%) skewX(-20deg); }
}
@keyframes goldGlowPulse {
  0%, 100% { text-shadow: 0 0 8px rgba(255,215,0,0.35), 0 0 18px rgba(201, 162, 39,0.25), 0 2px 4px rgba(0,0,0,0.6); }
  50%      { text-shadow: 0 0 16px rgba(255,215,0,0.65), 0 0 32px rgba(201, 162, 39,0.5), 0 2px 4px rgba(0,0,0,0.6); }
}

.promo-banner {
  background:
    radial-gradient(circle at 15% 15%, rgba(255,215,0,0.16) 0%, transparent 45%),
    radial-gradient(circle at 90% 85%, rgba(201, 162, 39,0.14) 0%, transparent 50%),
    linear-gradient(135deg, #1C1E22 0%, #0F1012 100%) !important;
  border: 1px solid rgba(201, 162, 39, 0.4) !important;
  box-shadow: 0 4px 25px rgba(0,0,0,0.5), inset 0 0 25px rgba(201, 162, 39,0.08) !important;
}

.promo-banner::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 55%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.16) 45%, rgba(255,215,0,0.3) 50%, rgba(255,235,160,0.16) 55%, transparent 100%);
  animation: goldShimmerSweep 5s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.promo-banner-title {
  animation: goldGlowPulse 3s ease-in-out infinite;
}

.jackpot-board {
  background:
    radial-gradient(circle at center, rgba(255,215,0,0.10) 0%, transparent 60%),
    radial-gradient(circle at center, #1F2226 0%, #0D0E10 100%) !important;
}

.jackpot-board::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.09) 45%, rgba(255,215,0,0.18) 50%, rgba(255,235,160,0.09) 55%, transparent 100%);
  animation: goldShimmerSweep 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.jackpot-title, #jp-num {
  animation: goldGlowPulse 3s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

.promo-banner-content, .promo-banner > div:last-child {
  position: relative;
  z-index: 2;
}

/* Light mode: keep the same rich dark gold card, but frame it so it visibly floats off a white page */
body.light-mode .promo-banner {
  border: 1.5px solid var(--gold) !important;
  box-shadow: 0 10px 30px rgba(201, 162, 39,0.3), 0 2px 10px rgba(0,0,0,0.12) !important;
}
</style>

<!-- HERO SECTION সরানো হয়েছে (ইউজারের অনুরোধে) —
     বড় প্রোমোশনাল হেডলাইন ব্যানার এবং
     তার CTA/স্ট্যাট ব্লকসহ সম্পূর্ণ সেকশনটা বাদ দেওয়া হয়েছে। সংশ্লিষ্ট .hero-* CSS
     শুধু এই সেকশনেই ব্যবহৃত হতো, তাই সেটাও একসাথে সরানো হলো। -->

<!-- ===== Marquee Ticker ===== -->
<div class="marquee-container-premium">
  <div class="marquee-label-premium">
    <i class="fas fa-bullhorn"></i> Announcement:
  </div>
  <div style="flex:1; overflow:hidden;">
    <div style="font-size:12px; color:var(--text-muted); white-space:nowrap; animation:marquee-text 18s linear infinite;">
      <%= t.home_marquee %>
    </div>
  </div>
</div>

<!-- ===== Large FA999-style Promotional Welcome Banner ===== -->
<div class="promo-banner">
  <div class="promo-banner-content">
    <div class="promo-banner-badge"><%= t.welcome_bonus %></div>
    <h1 class="promo-banner-title" style="font-family:'Teko', sans-serif; font-size: 30px; color: var(--gold-hover); line-height: 1.1; margin: 8px 0 3px 0; text-transform: uppercase;">
      100% Welcome Bonus
    </h1>
    <p style="font-size: 11px; color: var(--text-muted); margin-bottom: 10px; font-weight: 500;">
      <%= t.welcome_bonus_desc %> - Up to 50,000 BDT match bonus on first deposit.
    </p>
    <div>
      <a href="/payment/deposit" class="btn" style="background: var(--grad-gold); color: #000; font-weight: 800; font-size: 11px; border-radius: 20px; padding: 7px 18px;">
        <%= t.get_now %> <i class="fas fa-chevron-right" style="font-size: 9px; margin-left: 4px;"></i>
      </a>
    </div>
  </div>
  <img class="promo-banner-art" src="/images/hero/welcome-bonus.svg"
       alt="" aria-hidden="true" loading="eager" decoding="async" width="420" height="260">
</div>

<!-- ===== Deposit, Withdrawal, Reward, Rebate Highlighted Shortcuts ===== -->
<div class="shortcut-bar">
  <a href="/payment/deposit" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-wallet"></i>
    </div>
    <div class="shortcut-label"><%= t.deposit %></div>
  </a>
  <a href="/payment/withdraw" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-hand-holding-dollar"></i>
    </div>
    <div class="shortcut-label"><%= t.withdrawal %></div>
  </a>
  <a href="/profile/rewards" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-trophy"></i>
    </div>
    <div class="shortcut-label"><%= t.reward %></div>
  </a>
  <a href="/profile/cashback" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-coins"></i>
    </div>
    <div class="shortcut-label"><%= t.rebate %></div>
  </a>
</div>

<!-- ===== Main Category Navigation (সাইটের প্রধান বিভাগ) ===== -->
<!--
  কেন যোগ করা হলো: হোমপেজে আগে শুধু গেম-গ্রিড ফিল্টার করার ট্যাব ছিল (Hot/Slots/Live/
  Sports/Poker) — ওগুলো ক্যাসিনো গেমের ক্যাটাগরি, আসল স্পোর্টস নয়। ফলে ফুটবল, ক্রিকেট,
  লাইভ ম্যাচ, টুর্নামেন্ট বা বেটিং — কোনোটাই হোমপেজ থেকে খুঁজে পাওয়া যেত না।
  এখানে প্রতিটা লিংক বাস্তবে বিদ্যমান রুটে যায় (সবগুলো যাচাই করা হয়েছে); কোনো ডেড
  বাটন নেই এবং আইকনের পাশাপাশি টেক্সট লেবেলও আছে।
-->
<style nonce="<%= cspNonce %>">
  .main-cat-nav {
    display: flex; gap: 8px; padding: 4px 12px 14px;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .main-cat-nav::-webkit-scrollbar { display: none; }
  .main-cat-item {
    flex: 0 0 auto; min-width: 62px; min-height: 62px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    padding: 9px 10px; border-radius: 14px; text-decoration: none;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    color: var(--text-muted); font-size: 10.5px; font-weight: 700; line-height: 1.1;
    text-align: center; transition: background .2s, color .2s, border-color .2s;
  }
  .main-cat-item i { font-size: 17px; }
  .main-cat-item:active { background: rgba(255,255,255,0.09); }
  .main-cat-item.is-primary {
    background: var(--grad-gold); color: #1a1a1a; border-color: transparent;
  }
  @media (min-width: 768px) {
    .main-cat-nav { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
    .main-cat-item { min-width: 88px; font-size: 12px; }
    .main-cat-item i { font-size: 20px; }
  }
</style>
<nav class="main-cat-nav" aria-label="<%= t.main_categories %>">
  <a href="/sports" class="main-cat-item is-primary"><i class="fas fa-futbol"></i><span><%= t.cat_sports %></span></a>
  <a href="/matches/football" class="main-cat-item"><i class="fas fa-futbol"></i><span><%= t.cat_football %></span></a>
  <a href="/matches/cricket" class="main-cat-item"><i class="fas fa-baseball"></i><span><%= t.cat_cricket %></span></a>
  <a href="/matches" class="main-cat-item"><i class="fas fa-tower-broadcast"></i><span><%= t.cat_live_matches %></span></a>
  <a href="#mainGridWrap" class="main-cat-item"><i class="fas fa-dice"></i><span><%= t.cat_casino %></span></a>
  <a href="/tournaments" class="main-cat-item"><i class="fas fa-trophy"></i><span><%= t.cat_tournaments %></span></a>
  <a href="/leaderboard" class="main-cat-item"><i class="fas fa-ranking-star"></i><span><%= t.cat_leaderboard %></span></a>
  <a href="/promotions" class="main-cat-item"><i class="fas fa-gift"></i><span><%= t.cat_promotions %></span></a>
</nav>

<!-- হোমপেজ থেকে লাইভ/আসন্ন ম্যাচের তালিকা সরানো হয়েছে।
     নতুন UX: ইউজার প্রথমে খেলা বেছে নেয় (উপরের ক্যাটাগরি ন্যাভ থেকে Football/Cricket),
     তারপর সেই খেলার Live ও Upcoming ম্যাচ দেখে। ম্যাচ রেন্ডার করার কোড এখন শুধু
     views/matches.ejs-এ, যেটা /matches/football ও /matches/cricket দুটোই সার্ভ করে। -->

<!-- জনপ্রিয় গেমের হাইলাইট স্ট্রিপ সরানো হয়েছে (ইউজারের অনুরোধে)।
     নিচের ক্যাটাগরি ট্যাব + গেম গ্রিড থেকে একই গেমগুলো এখনো পাওয়া যায়,
     তাই কোনো গেম দুর্গম হয়ে যায়নি। -->

<!-- ===== Horizontal Navigation Tabs (Hot, Slots, Live, Sports, Poker, Favorites, Recent) ===== -->
<div class="horizontal-nav-container" id="categoryTabs">
  <div class="nav-tab-item active" data-category="all">
    <i class="fas fa-border-all"></i> <%= t.all %>
  </div>
  <div class="nav-tab-item" data-category="hot">
    <i class="fas fa-fire"></i> <%= t.cat_hot %>
  </div>
  <div class="nav-tab-item" data-category="slots">
    <i class="fas fa-gamepad"></i> <%= t.cat_slots %>
  </div>
  <div class="nav-tab-item" data-category="live">
    <i class="fas fa-video"></i> <%= t.cat_live %>
  </div>
  <div class="nav-tab-item" data-category="sports">
    <i class="fas fa-running"></i> <%= t.cat_sports %>
  </div>
  <div class="nav-tab-item" data-category="poker">
    <i class="fas fa-heart"></i> <%= t.cat_poker %>
  </div>
  <div class="nav-tab-item" data-category="favorites">
    <i class="fas fa-star"></i> <%= t.cat_favorites %>
  </div>
  <div class="nav-tab-item" data-category="recent">
    <i class="fas fa-clock-rotate-left"></i> <%= t.cat_recent %>
  </div>
</div>

<!-- ===== Layout Switcher ===== -->
<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:0 12px 10px;">
  <span style="font-size:11px;color:var(--text-muted);margin-right:2px;"><%= t.layout_label %></span>
  <button type="button" class="layout-btn" data-layout="compact" title="<%= t.layout_compact %>"><i class="fas fa-table-cells"></i></button>
  <button type="button" class="layout-btn active" data-layout="standard" title="<%= t.layout_standard %>"><i class="fas fa-table-cells-large"></i></button>
  <button type="button" class="layout-btn" data-layout="list" title="<%= t.layout_list %>"><i class="fas fa-list"></i></button>
</div>

<style nonce="<%= cspNonce %>">
  .layout-btn {
    width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border-glass);
    background: var(--bg-surface); color: var(--text-muted); cursor: pointer; font-size: 13px;
  }
  .layout-btn.active { background: var(--gold); color: #1a1a1a; border-color: var(--gold); }

  /* ===== Secondary Filter Pills (All/Hot/Favorites/Recent) — Slots/Live/Sports/Poker ক্যাটাগরির ভেতরে ===== */
  .secondary-tabs-container {
    display: flex; gap: 8px; padding: 0 12px 12px 12px; overflow-x: auto; scrollbar-width: none;
  }
  .secondary-tabs-container::-webkit-scrollbar { display: none; }
  .secondary-tab-item {
    flex: 0 0 auto; padding: 7px 16px; border-radius: 20px;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    color: var(--text-muted); font-weight: 700; font-size: 12px; cursor: pointer;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;
  }
  .secondary-tab-item.active {
    background: var(--grad-gold); color: #000 !important; border-color: transparent;
    box-shadow: 0 3px 10px rgba(201, 162, 39,0.35);
  }
  .secondary-tab-item.active i { color: #000; }

  /* ===== Catalog Mode: বাম পাশে প্রোভাইডার কলাম, ডান পাশে গেম গ্রিড ===== */
  #mainGridWrap { display: flex; gap: 10px; padding: 0 12px; }
  #providerSidebar {
    display: none; flex-direction: column; width: 78px; flex-shrink: 0; gap: 6px;
  }
  .provider-scroll-btn {
    width: 100%; padding: 6px 0; border: none; border-radius: 8px; cursor: pointer;
    background: rgba(255,255,255,0.08); color: var(--text-muted); font-size: 13px;
    display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;
  }
  .provider-scroll-btn:active { background: var(--grad-gold); color: #000; }
  #catalogProviderList {
    display: flex; flex-direction: column; gap: 8px;
    height: 420px; overflow-y: scroll; scrollbar-width: none; scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch; overscroll-behavior: contain; touch-action: pan-y;
  }
  #catalogProviderList::-webkit-scrollbar { display: none; }
  .catalog-provider-item {
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    border-radius: 12px; padding: 8px 4px; display: flex; flex-direction: column;
    align-items: center; gap: 6px; cursor: pointer; transition: all 0.15s ease; flex-shrink: 0;
  }
  .catalog-provider-item.active { border-color: var(--gold); box-shadow: 0 0 0 2px rgba(201, 162, 39,0.25); }
  .catalog-provider-item img { width: 100%; max-height: 28px; object-fit: contain; border-radius: 4px; }
  .catalog-provider-item .fallback {
    width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center;
    justify-content: center; color: #fff; font-size: 9px; font-weight: 900;
  }
  .catalog-provider-item .name { font-size: 9.5px; font-weight: 700; color: var(--text-main); text-align: center; line-height: 1.15; }
  #gameContainer { padding: 0 !important; flex: 1; min-width: 0; }

  .game-grid-premium.layout-compact { grid-template-columns: repeat(4, 1fr) !important; gap: 8px !important; }
  .game-grid-premium.layout-compact .game-thumb-wrapper { font-size: 28px !important; }
  .game-grid-premium.layout-compact .game-title-premium { font-size: 11px !important; }

  .game-grid-premium.layout-list { display: flex !important; flex-direction: column; gap: 8px; }
  .game-grid-premium.layout-list .game-card-premium { flex-direction: row !important; align-items: center; }
  .game-grid-premium.layout-list .game-thumb-wrapper { width: 70px; aspect-ratio: 1/1 !important; flex: 0 0 70px; }
  .game-grid-premium.layout-list .game-info-premium { flex: 1; }

  .fav-star {
    position: absolute; top: 6px; left: 6px; z-index: 3; font-size: 15px;
    color: rgba(255,255,255,0.55); text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }
  .fav-star.active { color: #FFD700; }
</style>

<!-- ===== Search Bar ===== -->

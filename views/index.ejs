<script>
// Side Menu
function toggleMenu() {
  document.getElementById('sideMenu').classList.toggle('open');
  document.getElementById('menuOverlay').classList.toggle('open');
}

// Games
const games = [
  {name:"Aviator",           emoji:"✈️",  type:"pvp",    slug:"aviator",           badge:"hot", provider:"SPRIBE", color:"gc1"},
  {name:"Teen Patti",        emoji:"🃏",  type:"pvp",    slug:"teen-patti",        badge:"pop", provider:"JL",     color:"gc2"},
  {name:"Andar Bahar",       emoji:"🎴",  type:"pvp",    slug:"andar-bahar",       badge:"hot", provider:"JL",     color:"gc3"},
  {name:"Blackjack",         emoji:"♠️",  type:"table",  slug:"blackjack",         badge:"",    provider:"EVO",    color:"gc4"},
  {name:"Poker",             emoji:"🃏",  type:"pvp",    slug:"poker",             badge:"",    provider:"JL",     color:"gc5"},
  {name:"Baccarat",          emoji:"🎰",  type:"table",  slug:"baccarat",          badge:"pop", provider:"EVO",    color:"gc6"},
  {name:"Roulette",          emoji:"🎡",  type:"table",  slug:"roulette",          badge:"",    provider:"EVO",    color:"gc7"},
  {name:"Slots",             emoji:"🎰",  type:"slots",  slug:"slots",             badge:"hot", provider:"PG",     color:"gc8"},
  {name:"Online Ludo",       emoji:"🎲",  type:"pvp",    slug:"ludo",              badge:"new", provider:"JL",     color:"gc9"},
  {name:"Dragon Tiger",      emoji:"🐉",  type:"pvp",    slug:"dragon-tiger",      badge:"pop", provider:"JL",     color:"gc10"},
  {name:"Color Prediction",  emoji:"🌈",  type:"pvp",    slug:"color-prediction",  badge:"new", provider:"JL",     color:"gc11"},
  {name:"Mine Game",         emoji:"💣",  type:"pvp",    slug:"mine",              badge:"hot", provider:"JL",     color:"gc12"},
  {name:"Coin Flip",         emoji:"🪙",  type:"pvp",    slug:"coin-flip",         badge:"",    provider:"JL",     color:"gc1"},
  {name:"Dice Roll",         emoji:"🎲",  type:"pvp",    slug:"dice",              badge:"",    provider:"JL",     color:"gc2"},
  {name:"Hi-Lo",             emoji:"🃏",  type:"pvp",    slug:"hilo",              badge:"new", provider:"JL",     color:"gc3"},
  {name:"Card War",          emoji:"⚔️",  type:"pvp",    slug:"card-war",          badge:"",    provider:"JL",     color:"gc4"},
  {name:"Lucky Spin",        emoji:"🎡",  type:"pvp",    slug:"lucky-spin",        badge:"pop", provider:"JL",     color:"gc5"},
  {name:"Number Guess",      emoji:"🎯",  type:"pvp",    slug:"number-guess",      badge:"",    provider:"JL",     color:"gc6"},
  {name:"Fortune Gems",      emoji:"💎",  type:"slots",  slug:"fortune-gems",      badge:"hot", provider:"JDB",    color:"gc7"},
  {name:"Golden Empire",     emoji:"👑",  type:"slots",  slug:"golden-empire",     badge:"",    provider:"JDB",    color:"gc8"},
  {name:"Sweet Bonanza",     emoji:"🍭",  type:"slots",  slug:"sweet-bonanza",     badge:"pop", provider:"PP",     color:"gc9"},
  {name:"Sugar Rush",        emoji:"🍬",  type:"slots",  slug:"sugar-rush",        badge:"",    provider:"PP",     color:"gc10"},
  {name:"Win Go",            emoji:"🎯",  type:"pvp",    slug:"win-go",            badge:"hot", provider:"JL",     color:"gc11"},
  {name:"Plinko",            emoji:"⚪",  type:"pvp",    slug:"plinko",            badge:"new", provider:"SPRIBE", color:"gc12"},
  {name:"Mahjong Ways",      emoji:"🀄",  type:"slots",  slug:"mahjong-ways",      badge:"pop", provider:"PG",     color:"gc1"},
  {name:"Ocean King",        emoji:"🐠",  type:"slots",  slug:"ocean-king",        badge:"hot", provider:"JDB",    color:"gc2"},
];
const badgeClass = {hot:'badge-hot', pop:'badge-pop', new:'badge-new'};
const badgeText  = {hot:'HOT', pop:'জনপ্রিয়', new:'নতুন'};
let currentType = 'all', searchQ = '';
function renderGames() {
  const c = document.getElementById('gameContainer');
  c.innerHTML = '';
  const filtered = games.filter(g =>
    (currentType === 'all' || g.type === currentType) &&
    g.name.toLowerCase().includes(searchQ.toLowerCase())
  );
  if (!filtered.length) { c.innerHTML = '<div class="no-games">কোনো গেম পাওয়া যায়নি</div>'; return;
  }
  filtered.forEach(g => {
    const url = g.slug ? `/games/${g.slug}` : '/login';
    const bHTML = g.badge ? `<div class="g-badge ${badgeClass[g.badge]}">${badgeText[g.badge]}</div>` : '';
    c.innerHTML += `
      <div class="game-card" onclick="location.href='${url}'">
        <div class="game-thumb ${g.color}">
          <span>${g.emoji}</span>${bHTML}
          <div class="g-provider">${g.provider}</div>
        </div>
        <div class="game-info"><h4>${g.name}</h4><p>${g.provider}</p></div>
      </div>`;
  });
}

document.querySelectorAll('.cat').forEach(c => {
  c.addEventListener('click', () => {
    document.querySelectorAll('.cat').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    currentType = c.dataset.type;
    const t = {all:'হট গেমস',pvp:'PVP গেমস',slots:'স্লট গেমস',live:'লাইভ ক্যাসিনো',table:'টেবিল গেমস',sports:'স্পোর্টস'};
    document.getElementById('sectionTitle').textContent = t[currentType] || 'সবগুলো গেম';
    renderGames();
  });
});
document.getElementById('gameSearch').addEventListener('input', e => { searchQ = e.target.value; renderGames(); });

let slide = 0;
const slides = document.querySelectorAll('.banner-slide');
const dots   = document.querySelectorAll('.dot');
function goSlide(n) {
  slides[slide].classList.remove('active'); dots[slide].classList.remove('active');
  slide = n;
  slides[slide].classList.add('active'); dots[slide].classList.add('active');
}
setInterval(() => goSlide((slide + 1) % slides.length), 3500);

let jp = 88617517;
setInterval(() => {
  jp += Math.floor(Math.random() * 600 + 100);
  document.getElementById('jp-num').textContent = jp.toLocaleString('bn-BD');
}, 2000);

renderGames();
</script>

</body></html>

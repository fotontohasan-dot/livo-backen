    </div>
  </div>
  <div style="position: absolute; right: 15px; bottom: 10px; font-size: 110px; opacity: 0.12; pointer-events: none; color: #FFF;">
    🎰
  </div>
</div>

<!-- ===== Deposit, Withdrawal, Reward, Rebate Highlighted Shortcuts ===== -->
<div class="shortcut-bar">
  <a href="/payment/deposit" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-wallet"></i>
    </div>
    <div class="shortcut-label"><%= t.deposit %></div>
  </a>
  <a href="/payment/withdraw" class="shortcut-item">
    <div class="shortcut-icon-wrapper" style="background: linear-gradient(135deg, #FFF, #E0E0E0);">
      <i class="fas fa-money-bill-wave" style="color: #111;"></i>
    </div>
    <div class="shortcut-label"><%= t.withdrawal %></div>
  </a>
  <a href="/extra/missions" class="shortcut-item">
    <div class="shortcut-icon-wrapper" style="background: linear-gradient(135deg, #FF9900, #FF5E00);">
      <i class="fas fa-gift" style="color: #FFF;"></i>
    </div>
    <div class="shortcut-label"><%= t.reward %></div>
  </a>
  <a href="/profile" class="shortcut-item">
    <div class="shortcut-icon-wrapper" style="background: linear-gradient(135deg, #00FFCC, #0099FF);">
      <i class="fas fa-percentage" style="color: #FFF;"></i>
    </div>
    <div class="shortcut-label"><%= t.rebate %></div>
  </a>
</div>

<!-- ===== Horizontal Navigation Tabs (Hot, Slots, Live, Sports, Poker) ===== -->
<div class="horizontal-nav-container" id="categoryTabs">
  <div class="nav-tab-item active" data-category="all">
    <i class="fas fa-border-all"></i> <%= t.all %>
  </div>
  <div class="nav-tab-item" data-category="hot">
    <i class="fas fa-fire"></i> <%= t.cat_hot %>
  </div>
  <div class="nav-tab-item" data-category="slots">
    <i class="fas fa-gamepad"></i> <%= t.cat_slots %>
  </div>
  <div class="nav-tab-item" data-category="live">
    <i class="fas fa-video"></i> <%= t.cat_live %>
  </div>
  <div class="nav-tab-item" data-category="sports">
    <i class="fas fa-running"></i> <%= t.cat_sports %>
  </div>
  <div class="nav-tab-item" data-category="poker">
    <i class="fas fa-heart"></i> <%= t.cat_poker %>
  </div>
</div>

<!-- ===== Search Bar ===== -->
<div style="padding: 0 12px 15px 12px;">
  <div style="position:relative;">
    <input type="text" id="gameSearch" class="form-input" placeholder="<%= t.search_placeholder %>" style="padding-right:45px; border-radius: 30px; background: rgba(255,255,255,0.04); border-color: rgba(212,175,55,0.2);">
    <i class="fas fa-search" style="position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>
  </div>
</div>

<%- include('partials/flash') %>

<!-- ===== High-Fidelity Premium Game Grid ===== -->
<div class="game-grid-premium" id="gameContainer"></div>

<!-- ===== Progressive Jackpot Board ===== -->
<div class="banner-container" style="margin-top:20px;">
  <div class="card" style="padding:25px 20px; text-align:center; border: 1.5px solid var(--fa-gold); background: radial-gradient(circle at center, #1F2226 0%, #0D0E10 100%); position: relative; overflow: hidden; border-radius: 20px;">
    <div style="font-size:12px; color:var(--fa-gold); letter-spacing:4px; text-transform:uppercase; font-weight:800; text-shadow: 0 0 10px rgba(212,175,55,0.4);">✨ MEGA JACKPOT ✨</div>
    <div style="font-family:'Teko',sans-serif; font-size:52px; color:#FFF; line-height:1; margin:12px 0; text-shadow: 0 0 15px rgba(255, 215, 0, 0.4); display: flex; align-items: center; justify-content: center; gap: 8px;">
      <span style="font-size: 28px; color: var(--fa-gold);">৳</span>
      <span id="jp-num" style="background: linear-gradient(180deg, #FFF 0%, #E2E2E2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">88,617,517</span>
    </div>
    <div style="font-size:11px; color:var(--text-muted);"><%= t.lucky_draw_msg %></div>
  </div>
</div>

<!-- ===== Winners List ===== -->
<div class="section-header" style="padding-top: 15px;">
  <h3 class="section-title"><i class="fas fa-trophy" style="color:var(--fa-gold);"></i> <%= t.winners_list %></h3>
</div>
<div style="padding:0 12px;">
  <div class="card" style="background: rgba(255,255,255,0.02); border-color: rgba(212,175,55,0.15);">
    <div style="display:grid;grid-template-columns:40px 1fr 1fr;padding:12px;border-bottom:1px solid rgba(255,255,255,0.05);font-size:11px;color:var(--text-muted);font-weight:600;">
      <div>#</div><div><%= t.player %></div><div style="text-align:right"><%= t.win_amount %></div>
    </div>
    <div style="display:grid;grid-template-columns:40px 1fr 1fr;padding:12px;align-items:center;border-bottom:1px solid rgba(255,255,255,0.05);">
      <div style="color:var(--fa-gold);font-family:'Teko',sans-serif;font-size:18px;">🥇</div><div style="font-size:13px; font-weight:600;">***৮৮২</div><div style="text-align:right;color:#10b981;font-family:'Teko',sans-serif;font-size:16px;">৳১৫,৬৮,৫২৩</div>
    </div>
    <div style="display:grid;grid-template-columns:40px 1fr 1fr;padding:12px;align-items:center;border-bottom:1px solid rgba(255,255,255,0.05);">
      <div style="color:#94a3b8;font-family:'Teko',sans-serif;font-size:18px;">🥈</div><div style="font-size:13px; font-weight:600;">***৭৪২</div><div style="text-align:right;color:#10b981;font-family:'Teko',sans-serif;font-size:16px;">৳১১,৪৪,৫৫৬</div>
    </div>
  </div>
</div>

<!-- ===== Footer ===== -->
<div class="site-footer" style="margin-top:40px;background:var(--bg-surface);padding:40px 20px;text-align:center;border-top:1px solid rgba(212,175,55,0.15);">
  <div class="nav-brand text-main" style="font-size:2.5rem;margin-bottom:15px;font-family:'Teko',sans-serif;color:var(--fa-gold) !important;"><%= siteName %></div>
  <div style="display:flex;flex-wrap:wrap;gap:15px;justify-content:center;margin-bottom:20px;">
    <a href="/privacy" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.privacy_policy %></a>
    <a href="/terms" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.terms_conditions %></a>
    <a href="/rules" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.rules_regulation %></a>
    <a href="/kyc" style="color:var(--text-muted);font-size:12px;text-decoration:none;"><%= t.kyc %></a>
  </div>
  <div style="display:flex;gap:15px;justify-content:center;margin-bottom:20px;">
    <div class="glass" style="padding:5px 15px;border-radius:8px;font-size:12px;color:#ef4444;font-weight:700;">🔞 18+</div>
    <div class="glass text-muted" style="padding:5px 15px;border-radius:8px;font-size:12px;">Curacao Licensed</div>
  </div>
  <p class="text-muted" style="font-size:11px;line-height:1.6;">
    © 2024 <%= siteName %> Gaming. All Rights Reserved.<br>
    <%= t.responsible_gaming_msg %>
  </p>
</div>

<%- include('partials/bottom-nav') %>
<%- include('partials/floating-promo') %>

<script>
// Mock list of rich games under specific categories matching FA999
const gamesList = [
  {name:"Aviator", emoji:"🚀", type:"hot", slug:"aviator", badge:"hot", provider:"SPRIBE"},
  {name:"Fortune Gems", emoji:"💎", type:"slots", slug:"fortune-gems", badge:"hot", provider:"JDB"},
  {name:"Crazy Time", emoji:"🎡", type:"live", slug:"crazy-time", badge:"hot", provider:"EVO"},
  {name:"Teen Patti", emoji:"🃏", type:"poker", slug:"teen-patti", badge:"pop", provider:"JL"},
  {name:"Gates of Olympus", emoji:"⚡", type:"slots", slug:"gates-of-olympus", badge:"hot", provider:"PP"},
  {name:"Sweet Bonanza", emoji:"🍭", type:"slots", slug:"sweet-bonanza", badge:"pop", provider:"PP"},
  {name:"Baccarat", emoji:"🃏", type:"live", slug:"baccarat", badge:"pop", provider:"EVO"},
  {name:"Lightning Roulette", emoji:"🎡", type:"live", slug:"lightning-roulette", badge:"hot", provider:"EVO"},
  {name:"Dragon Tiger", emoji:"🐉", type:"live", slug:"dragon-tiger", badge:"pop", provider:"JL"},
  {name:"Andar Bahar", emoji:"🎴", type:"poker", slug:"andar-bahar", badge:"hot", provider:"JL"},
  {name:"Virtual Cricket", emoji:"🏏", type:"sports", slug:"cricket", badge:"live", provider:"LIVO"},
  {name:"Pro Football", emoji:"⚽", type:"sports", slug:"football", badge:"hot", provider:"LIVO"},
  {name:"Texas Holdem", emoji:"♠️", type:"poker", slug:"poker", badge:"pro", provider:"JL"},
  {name:"Omaha Poker", emoji:"♦️", type:"poker", slug:"poker", badge:"new", provider:"EVO"}
];

let selectedCategory = 'all';

function renderGames() {
  const c = document.getElementById('gameContainer');
  if(!c) return;
  c.innerHTML = '';

  const searchQ = document.getElementById('gameSearch') ? document.getElementById('gameSearch').value.toLowerCase() : '';

  const filtered = gamesList.filter(g => {
    const matchesSearch = g.name.toLowerCase().includes(searchQ);
    const matchesCategory = selectedCategory === 'all' || g.type === selectedCategory;
    return matchesSearch && matchesCategory;
  });

  if (filtered.length === 0) {
    c.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-muted); font-size: 13px;"><%= t.no_games_found %></div>`;
    return;
  }

  filtered.forEach(g => {
    const badgeHTML = g.badge ? `<div class="game-badge-premium">${g.badge}</div>` : '';
    c.innerHTML += `
      <a href="/games/${g.slug}" class="game-card-premium">
        <div class="game-thumb-wrapper">
          <span class="game-emoji">${g.emoji}</span>
          ${badgeHTML}
        </div>
        <div class="game-info-premium">
          <div class="game-title-premium">${g.name}</div>
          <div class="game-provider-premium">${g.provider}</div>
        </div>
      </a>`;
  });
}

// Category Tab Filtering Handler
document.querySelectorAll('.nav-tab-item').forEach(el => {
  el.addEventListener('click', () => {
    document.querySelectorAll('.nav-tab-item').forEach(item => item.classList.remove('active'));
    el.classList.add('active');
    selectedCategory = el.dataset.category;
    renderGames();
  });
});

var gs = document.getElementById('gameSearch');
if (gs) {
  gs.addEventListener('input', renderGames);
}

// Multi-currency Jackpot Ticker
let jpValue = 88617517;
setInterval(() => {
  jpValue += Math.floor(Math.random() * 500 + 50);
  const jpNumEl = document.getElementById('jp-num');
  if(jpNumEl) jpNumEl.textContent = jpValue.toLocaleString('<%= lang === 'bn' ? 'bn-BD' : 'en-US' %>');
}, 1500);

document.addEventListener('DOMContentLoaded', renderGames);
</script>

</body></html>

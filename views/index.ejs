<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Live Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0b0b0c; color: white; }
        .header {
            background: linear-gradient(90deg, #ff2d55, #c8102e);
            padding: 12px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { font-size: 26px; font-weight: bold; }
        .logo span { color: #ffd700; }
        .balance { background: rgba(0,0,0,0.4); padding: 6px 12px; border-radius: 20px; font-weight: bold; }

        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 10px;
            padding: 75px 10px 90px;
        }
        .game-card {
            background: #1a1a2e;
            border-radius: 10px;
            overflow: hidden;
            text-align: center;
        }
        .game-card img { width: 100%; height: 105px; object-fit: cover; }
        .game-name { font-size: 13px; padding: 8px 4px; color: #ffd700; font-weight: bold; }

        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            background: #111827;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
        }
        .nav-item { text-align: center; color: #aaa; font-size: 11px; }
        .nav-item.active { color: #ff2d55; }
        .nav-icon { font-size: 24px; display: block; margin-bottom: 2px; }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">LIVO</div>
        <div class="balance">💰 ৳ <span id="balance">12480</span></div>
        <div><button style="padding:8px 14px; background:#fff; color:#000; border:none; border-radius:6px;">ডিপোজিট</button></div>
    </div>

    <div class="game-grid" id="gameGrid"></div>

    <div class="bottom-nav">
        <div class="nav-item active"><span class="nav-icon">🏠</span>হোম</div>
        <div class="nav-item"><span class="nav-icon">🎮</span>গেমস</div>
        <div class="nav-item"><span class="nav-icon">👥</span>আমন্ত্রণ</div>
        <div class="nav-item"><span class="nav-icon">🎁</span>বোনাস</div>
        <div class="nav-item"><span class="nav-icon">👤</span>আমি</div>
    </div>

    <script>
        const baseGames = ["Teen Patti", "Andar Bahar", "Dragon Tiger", "Crash", "Roulette", "Aviator", "Super Ace", "Poker", "Fortune Gems", "Boxing King", "FlyX", "Tai Xiu", "Color Prediction", "Baccarat", "Blackjack", "Mines", "Plinko", "Jackpot", "Mega Slots", "Coin Toss"];

        const gameGrid = document.getElementById('gameGrid');
        
        for(let i = 1; i <= 10000; i++) {
            const gameName = baseGames[i % baseGames.length] + " " + i;
            const card = document.createElement('div');
            card.className = 'game-card';
            card.innerHTML = `
                <img src="https://via.placeholder.com/300x180/00cc66/ffffff?text=${gameName.replace(/ /g, '+')}" alt="${gameName}">
                <div class="game-name">${gameName}</div>
            `;
            gameGrid.appendChild(card);
        }
    </script>

</body>
</html>

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Online Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f0b1f; color: white; }
        .header {
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { font-size: 26px; font-weight: bold; color: #ffd700; }
        .category { margin-top: 70px; padding: 15px; }
        h2 { color: #ffd700; margin-bottom: 12px; font-size: 19px; }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 12px;
        }
        .game-card {
            background: #1a1433;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
        }
        .game-card img { width: 100%; height: 115px; object-fit: cover; }
        .game-name { font-size: 13px; padding: 10px 5px; color: #ffccff; font-weight: bold; }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">LIVO</div>
    </div>

    <div class="category">
        <h2>🎮 All Games</h2>
        <div class="game-grid" id="allGames"></div>
    </div>

    <div class="category">
        <h2>🎰 Slots</h2>
        <div class="game-grid" id="slots"></div>
    </div>

    <div class="category">
        <h2>🎥 Live Casino</h2>
        <div class="game-grid" id="liveCasino"></div>
    </div>

    <div class="category">
        <h2>🃏 Table Games</h2>
        <div class="game-grid" id="tableGames"></div>
    </div>

    <script>
        let imgIndex = 10;

        function addGames(id, list) {
            const container = document.getElementById(id);
            list.forEach(name => {
                const card = document.createElement('div');
                card.className = 'game-card';
                card.innerHTML = `
                    <img src="https://picsum.photos/id/${imgIndex}/300/180" alt="${name}">
                    <div class="game-name">${name}</div>
                `;
                imgIndex++;
                container.appendChild(card);
            });
        }

        addGames('allGames', [
            "Teen Patti", "Super Ace", "Crash", "Aviator", "Andar Bahar",
            "Dragon Tiger", "Roulette", "Blackjack", "Fortune Gems", "Boxing King",
            "Lucky Spin", "Color Prediction", "Golden Empire", "Sweet Bonanza",
            "Gates of Olympus", "Starlight Princess", "Fruit Party",
            "Blackjack Live", "Baccarat Live", "Roulette Live",
            "Dragon Tiger Live", "Crazy Time"
        ]);

        addGames('slots', [
            "Fortune Gems", "Golden Empire", "Sweet Bonanza",
            "Gates of Olympus", "Starlight Princess", "Fruit Party"
        ]);

        addGames('liveCasino', [
            "Blackjack Live", "Baccarat Live", "Roulette Live",
            "Dragon Tiger Live", "Crazy Time"
        ]);

        addGames('tableGames', [
            "Blackjack", "Baccarat", "Roulette",
            "Teen Patti", "Andar Bahar", "Dragon Tiger"
        ]);
    </script>

</body>
</html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }

/* FA999 Gold Theme Styles */
:root {
  --fa-gold-light: #FFEFA6;
  --fa-gold: #D4AF37;
  --fa-gold-dark: #AA7C11;
  --fa-gold-gradient: linear-gradient(135deg, #FFF3C4 0%, #FFD700 50%, #B8860B 100%);
  --fa-dark-gradient: linear-gradient(180deg, #1A1C20 0%, #0F1012 100%);
  --fa-card-bg: rgba(255, 255, 255, 0.05);
}

.promo-banner {
  background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  margin: 12px;
}

.promo-banner-content {
  background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
  padding: 24px;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.promo-banner-badge {
  background: var(--fa-gold-gradient);
  color: #000;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 20px;
  align-self: flex-start;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
}

/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin: 0 12px 15px 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(212, 175, 55, 0.15);
  border-radius: 14px;
  padding: 12px;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
  padding: 10px 4px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.05) 100%);
  border: 1px solid rgba(255,255,255,0.05);
}

.shortcut-item:hover {
  transform: translateY(-2px);
  border-color: var(--fa-gold);
  background: linear-gradient(135deg, rgba(212,175,55,0.1) 0%, rgba(0,0,0,0.2) 100%);
}

.shortcut-icon-wrapper {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: var(--fa-gold-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #000;
  margin-bottom: 6px;
  box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3);
}

.shortcut-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--text-main);
  text-align: center;
}

/* Horizontal Navigation Tabs */
.horizontal-nav-container {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  padding: 5px 12px 15px 12px;
  scrollbar-width: none;
}
.horizontal-nav-container::-webkit-scrollbar {
  display: none;
}

.nav-tab-item {
  flex: 0 0 auto;
  padding: 10px 20px;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.nav-tab-item.active {
  background: var(--fa-gold-gradient);
  color: #000 !important;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
}

.nav-tab-item.active i {
  color: #000;
}

.game-grid-premium {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 0 12px;
}

.game-card-premium {
  background: linear-gradient(135deg, rgba(30, 32, 38, 0.8) 0%, rgba(15, 16, 18, 0.9) 100%);
  border: 1px solid rgba(212, 175, 55, 0.1);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.game-card-premium:hover {
  transform: scale(1.02);
  border-color: var(--fa-gold);
}

.game-thumb-wrapper {
  aspect-ratio: 16/10;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  position: relative;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.game-info-premium {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.game-title-premium {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-provider-premium {
  font-size: 10px;
  font-weight: 600;
  color: var(--fa-gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.game-badge-premium {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 8px;
  font-weight: 800;
  background: #ff4d4f;
  color: #fff;
  text-transform: uppercase;
}

.marquee-container-premium {
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 8px;
  margin: 10px 12px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.marquee-label-premium {
  color: var(--fa-gold);
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}
</style>

<!-- ===== Marquee Ticker ===== -->

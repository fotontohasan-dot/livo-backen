<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    :root {
        --bg-color: #050505;
        --card-bg: #1a1a1a;
        --primary-gradient: linear-gradient(90deg, #6b00ff, #ff00aa);
        --accent-color: #ffcc00;
        --text-color: #ffffff;
        --text-muted: #ffccff;
        --nav-bg: #151029;
        --border-color: #333;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: Arial, sans-serif;
        margin: 0;
        margin-bottom: 70px;
    }

    .promo-banner {
        width: calc(100% - 30px);
        margin: 15px;
        height: 140px;
        background: linear-gradient(45deg, #3b006e, #7e22ce);
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        padding: 20px;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .category-nav {
        background: var(--nav-bg);
        padding: 10px 0;
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: none;
        position: sticky;
        top: 65px;
        z-index: 99;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .category-nav::-webkit-scrollbar { display: none; }
    .category-item {
        padding: 8px 20px;
        margin: 0 5px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .category-item.active {
        background: var(--primary-gradient);
        color: white;
        border-color: transparent;
    }

    .content-area { padding: 0 20px; }
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-top: 15px;
    }
    .section-header h2 { font-size: 18px; color: var(--accent-color); }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 20px;
        padding-bottom: 20px;
    }

    .game-card {
        background: var(--card-bg);
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid var(--border-color);
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        gap: 10px;
        animation: fadeIn 0.3s ease forwards;
    }

    .game-card:hover {
        border-color: var(--accent-color);
        transform: translateY(-5px);
    }

    .game-thumb {
        width: 100%;
        aspect-ratio: 1/1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 50px;
        border-radius: 8px;
    }

    .game-name {
        font-size: 16px;
        font-weight: bold;
        color: var(--text-color);
        margin: 5px 0;
    }

    .play-btn {
        background: var(--accent-color);
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
        color: #000;
        width: 100%;
        transition: 0.2s;
    }
    .play-btn:active {
        transform: scale(0.95);
    }

    .search-container {
        padding: 10px 15px;
    }
    .search-box {
        position: relative;
        width: 100%;
    }
    .search-box input {
        width: 100%;
        padding: 10px 40px 10px 15px;
        border-radius: 25px;
        border: 1px solid rgba(255,255,255,0.1);
        background: var(--card-bg);
        color: white;
        font-size: 14px;
        outline: none;
    }
    .search-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 16px;
        opacity: 0.8;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="promo-banner">
    🎰 LIVO-তে স্বাগতম <br>
    <span style="font-size: 14px; color: #fbbf24;">৫০০ ওয়েলকাম কয়েন পান!</span>
    <% if(locals.user) { %>
        <a href="/payment/deposit" class="btn btn-primary btn-sm" style="margin-top: 10px; background: #fbbf24; color: #000;">রিচার্জ করুন</a>
    <% } %>
</div>

<div class="search-container">
    <div class="search-box">
        <input type="text" id="gameSearch" placeholder="গেম খুঁজুন...">
        <span class="search-icon">🔍</span>
    </div>
</div>

<div class="category-nav" id="categoryNav">
    <div class="category-item active" data-type="all">সবগুলো</div>
    <div class="category-item" data-type="pvp">PVP</div>
    <div class="category-item" data-type="slots">স্লট</div>
    <div class="category-item" data-type="live">লাইভ ক্যাসিনো</div>
    <div class="category-item" data-type="table">টেবিল গেম</div>
    <div class="category-item" data-type="sports">স্পোর্টস</div>
</div>

<div class="content-area">
    <div class="section-header">
        <h2 id="sectionTitle">সবগুলো গেম</h2>
    </div>
    <%- include('partials/flash') %>
    <div class="game-grid" id="gameContainer"></div>
</div>


  border-top: 2px solid var(--gold);
  border-bottom: 2px solid var(--gold);
}
.recent-wins h3 {
  color: var(--text-accent);
  margin: 0 0 12px 0;
  font-size: 18px;
  text-align: center;
}
.wins-container {
  height: 220px;
  overflow: hidden;
  position: relative;
}

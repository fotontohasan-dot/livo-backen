<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }

/* FA999 Gold Theme Styles */
:root {
  --fa-gold-light: #FFEFA6;
  --fa-gold: #D4AF37;
  --fa-gold-dark: #AA7C11;
  --fa-gold-gradient: linear-gradient(135deg, #FFF3C4 0%, #FFD700 50%, #B8860B 100%);
  --fa-dark-gradient: linear-gradient(180deg, #1A1C20 0%, #0F1012 100%);
  --fa-card-bg: rgba(255, 255, 255, 0.05);
}

.promo-banner {
  background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  margin: 12px;
}

.promo-banner-content {
  background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
  padding: 24px;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.promo-banner-badge {
  background: var(--fa-gold-gradient);
  color: #000;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 20px;
  align-self: flex-start;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
}

/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin: 0 0 15px 0;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(212, 175, 55, 0.12);
  border-bottom: 1px solid rgba(212, 175, 55, 0.12);
  border-radius: 0;
  padding: 12px 0;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
  padding: 2px 2px;
  border-radius: 0;
  background: transparent;
  border: none;
}

.shortcut-item:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}

.shortcut-icon-wrapper {
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  color: var(--fa-gold);
  margin-bottom: 6px;
  box-shadow: none;
}

.shortcut-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 0.2px;
}

/* Horizontal Navigation Tabs */
.horizontal-nav-container {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  padding: 5px 12px 15px 12px;
  scrollbar-width: none;
}
.horizontal-nav-container::-webkit-scrollbar {
  display: none;
}

.nav-tab-item {
  flex: 0 0 auto;
  padding: 10px 20px;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.nav-tab-item.active {
  background: var(--fa-gold-gradient);
  color: #000 !important;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
}

.nav-tab-item.active i {
  color: #000;
}

.game-grid-premium {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 0 12px;
}

.game-card-premium {
  background: linear-gradient(135deg, rgba(30, 32, 38, 0.8) 0%, rgba(15, 16, 18, 0.9) 100%);
  border: 1px solid rgba(212, 175, 55, 0.1);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.game-card-premium:hover {
  transform: scale(1.02);
  border-color: var(--fa-gold);
}

.game-thumb-wrapper {
  aspect-ratio: 16/10;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  position: relative;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.game-info-premium {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.game-title-premium {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-provider-premium {
  font-size: 10px;
  font-weight: 600;
  color: var(--fa-gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.game-badge-premium {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 8px;
  font-weight: 800;
  background: #ff4d4f;
  color: #fff;
  text-transform: uppercase;
}

.marquee-container-premium {
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 8px;
  margin: 10px 12px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.marquee-label-premium {
  color: var(--fa-gold);
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}

/* ===== Golden Shimmer / Glow — Welcome Banner + Jackpot (dark & light mode) ===== */
@keyframes goldShimmerSweep {
  0%   { transform: translateX(-150%) skewX(-20deg); }
  100% { transform: translateX(250%) skewX(-20deg); }
}
@keyframes goldGlowPulse {
  0%, 100% { text-shadow: 0 0 8px rgba(255,215,0,0.35), 0 0 18px rgba(212,175,55,0.25), 0 2px 4px rgba(0,0,0,0.6); }
  50%      { text-shadow: 0 0 16px rgba(255,215,0,0.65), 0 0 32px rgba(212,175,55,0.5), 0 2px 4px rgba(0,0,0,0.6); }
}

.promo-banner {
  background:
    radial-gradient(circle at 15% 15%, rgba(255,215,0,0.16) 0%, transparent 45%),
    radial-gradient(circle at 90% 85%, rgba(212,175,55,0.14) 0%, transparent 50%),
    linear-gradient(135deg, #1C1E22 0%, #0F1012 100%) !important;
  border: 1px solid rgba(212, 175, 55, 0.4) !important;
  box-shadow: 0 4px 25px rgba(0,0,0,0.5), inset 0 0 25px rgba(212,175,55,0.08) !important;
}

.promo-banner::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 55%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.16) 45%, rgba(255,215,0,0.3) 50%, rgba(255,235,160,0.16) 55%, transparent 100%);
  animation: goldShimmerSweep 5s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.promo-banner-title {
  animation: goldGlowPulse 3s ease-in-out infinite;
}

.jackpot-board {
  background:
    radial-gradient(circle at center, rgba(255,215,0,0.10) 0%, transparent 60%),
    radial-gradient(circle at center, #1F2226 0%, #0D0E10 100%) !important;
}

.jackpot-board::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.09) 45%, rgba(255,215,0,0.18) 50%, rgba(255,235,160,0.09) 55%, transparent 100%);
  animation: goldShimmerSweep 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.jackpot-title, #jp-num {
  animation: goldGlowPulse 3s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

.promo-banner-content, .promo-banner > div:last-child {
  position: relative;
  z-index: 2;
}

/* Light mode: keep the same rich dark gold card, but frame it so it visibly floats off a white page */
body.light-mode .promo-banner {
  border: 1.5px solid var(--fa-gold) !important;
  box-shadow: 0 10px 30px rgba(212,175,55,0.3), 0 2px 10px rgba(0,0,0,0.12) !important;
}
body.light-mode .jackpot-board {
  border: 1.5px solid var(--fa-gold) !important;
  box-shadow: 0 10px 30px rgba(212,175,55,0.3), 0 2px 10px rgba(0,0,0,0.12) !important;
}
</style>

<!-- ===== Marquee Ticker ===== -->
<div class="marquee-container-premium">
  <div class="marquee-label-premium">
    <i class="fas fa-bullhorn"></i> Announcement:
  </div>
  <div style="flex:1; overflow:hidden;">
    <div style="font-size:12px; color:var(--text-muted); white-space:nowrap; animation:marquee-text 18s linear infinite;">
      📢 প্রিয় গ্রাহক, LIVO-তে আপনাকে স্বাগতম! 🌟 Deposit, Withdrawal, Reward, এবং Rebate-এর চমৎকার সুবিধা উপভোগ করুন। প্রতিদিন ১ লক্ষ টাকা পর্যন্ত Rebate বোনাস জেতার সুযোগ! 💰
    </div>
  </div>
</div>

<!-- ===== Large FA999-style Promotional Welcome Banner ===== -->
<div class="promo-banner">
  <div class="promo-banner-content">
    <div class="promo-banner-badge"><%= t.welcome_bonus %></div>
    <h1 class="promo-banner-title" style="font-family:'Teko', sans-serif; font-size: 38px; color: var(--fa-gold-light); line-height: 1.1; margin: 10px 0 4px 0; text-transform: uppercase;">
      100% Welcome Bonus
    </h1>
    <p style="font-size: 12px; color: #E0E2E5; margin-bottom: 15px; font-weight: 500;">
      <%= t.welcome_bonus_desc %> - Up to 50,000 BDT match bonus on first deposit.
    </p>
    <div>
      <a href="/payment/deposit" class="btn" style="background: var(--fa-gold-gradient); color: #000; font-weight: 800; font-size: 12px; border-radius: 20px; padding: 8px 20px;">
        <%= t.get_now %> <i class="fas fa-chevron-right" style="font-size: 9px; margin-left: 4px;"></i>
      </a>
    </div>
  </div>
  <div style="position: absolute; right: 15px; bottom: 10px; font-size: 110px; opacity: 0.12; pointer-events: none; color: #FFF;">
    🎰
  </div>
</div>

<!-- ===== Deposit, Withdrawal, Reward, Rebate Highlighted Shortcuts ===== -->
<div class="shortcut-bar">
  <a href="/payment/deposit" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-wallet"></i>
    </div>
    <div class="shortcut-label"><%= t.deposit %></div>
  </a>
  <a href="/payment/withdraw" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-hand-holding-dollar"></i>
    </div>
    <div class="shortcut-label"><%= t.withdrawal %></div>
  </a>
  <a href="/extra/missions" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-trophy"></i>
    </div>
    <div class="shortcut-label"><%= t.reward %></div>
  </a>
  <a href="/profile" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-coins"></i>
    </div>
    <div class="shortcut-label"><%= t.rebate %></div>
  </a>
</div>

<!-- ===== Horizontal Navigation Tabs (Hot, Slots, Live, Sports, Poker, Favorites, Recent) ===== -->
<div class="horizontal-nav-container" id="categoryTabs">
  <div class="nav-tab-item active" data-category="all">
    <i class="fas fa-border-all"></i> <%= t.all %>
  </div>
  <div class="nav-tab-item" data-category="hot">
    <i class="fas fa-fire"></i> <%= t.cat_hot %>
  </div>
  <div class="nav-tab-item" data-category="slots">
    <i class="fas fa-gamepad"></i> <%= t.cat_slots %>
  </div>
  <div class="nav-tab-item" data-category="live">
    <i class="fas fa-video"></i> <%= t.cat_live %>
  </div>
  <div class="nav-tab-item" data-category="sports">
    <i class="fas fa-running"></i> <%= t.cat_sports %>
  </div>
  <div class="nav-tab-item" data-category="poker">
    <i class="fas fa-heart"></i> <%= t.cat_poker %>
  </div>
  <div class="nav-tab-item" data-category="favorites">
    <i class="fas fa-star"></i> ফেভারিটস
  </div>
  <div class="nav-tab-item" data-category="recent">
    <i class="fas fa-clock-rotate-left"></i> রিসেন্ট
  </div>
</div>

<!-- ===== Provider Grid (শুধু 'সব' ট্যাবে দেখাবে, কোলাপসিবল) ===== -->
<div id="providerSection" style="padding:0 12px 10px;">
  <div id="providerGrid" class="provider-grid"></div>
  <button type="button" id="providerToggleBtn" class="provider-toggle-btn">
    <i class="fas fa-chevron-down"></i>
  </button>
</div>

<!-- ===== Layout Switcher ===== -->
<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:0 12px 10px;">
  <span style="font-size:11px;color:var(--text-muted);margin-right:2px;">লেআউট:</span>
  <button type="button" class="layout-btn" data-layout="compact" title="কমপ্যাক্ট"><i class="fas fa-table-cells"></i></button>
  <button type="button" class="layout-btn active" data-layout="standard" title="স্ট্যান্ডার্ড"><i class="fas fa-table-cells-large"></i></button>
  <button type="button" class="layout-btn" data-layout="list" title="লিস্ট"><i class="fas fa-list"></i></button>
</div>

<style>
  .provider-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
    max-height: 340px; overflow: hidden; transition: max-height 0.3s ease;
  }
  .provider-grid.expanded { max-height: 3000px; }
  .provider-card {
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    border-radius: 14px; padding: 14px 10px; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 10px; cursor: pointer;
    transition: all 0.15s ease; min-height: 110px;
  }
  .provider-card.active { border-color: var(--fa-gold); box-shadow: 0 0 0 2px rgba(212,175,55,0.25); }
  .provider-card .provider-logo-img {
    max-width: 100%; max-height: 42px; object-fit: contain; border-radius: 6px;
  }
  .provider-card .provider-logo-fallback {
    width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center;
    justify-content: center; color: #fff; font-size: 11px; font-weight: 900;
  }
  .provider-card .provider-name { font-size: 12.5px; font-weight: 700; color: var(--text-main); text-align: center; }
  .provider-toggle-btn {
    width: 100%; margin-top: 10px; padding: 8px; border-radius: 10px; border: none;
    background: var(--bg-surface); color: var(--text-muted); cursor: pointer; font-size: 13px;
  }
  .layout-btn {
    width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border-glass);
    background: var(--bg-surface); color: var(--text-muted); cursor: pointer; font-size: 13px;
  }
  .layout-btn.active { background: var(--fa-gold); color: #1a1a1a; border-color: var(--fa-gold); }

  /* ===== Secondary Filter Pills (All/Hot/Favorites/Recent) — Slots/Live/Sports/Poker ক্যাটাগরির ভেতরে ===== */
  .secondary-tabs-container {
    display: flex; gap: 8px; padding: 0 12px 12px 12px; overflow-x: auto; scrollbar-width: none;
  }
  .secondary-tabs-container::-webkit-scrollbar { display: none; }
  .secondary-tab-item {
    flex: 0 0 auto; padding: 7px 16px; border-radius: 20px;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    color: var(--text-muted); font-weight: 700; font-size: 12px; cursor: pointer;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;
  }
  .secondary-tab-item.active {
    background: var(--fa-gold-gradient); color: #000 !important; border-color: transparent;
    box-shadow: 0 3px 10px rgba(212,175,55,0.35);
  }
  .secondary-tab-item.active i { color: #000; }

  /* ===== Catalog Mode: বাম পাশে প্রোভাইডার কলাম, ডান পাশে গেম গ্রিড ===== */
  #mainGridWrap { display: flex; gap: 10px; padding: 0 12px; }
  #catalogProviderList {
    display: none; flex-direction: column; gap: 8px; width: 78px; flex-shrink: 0;
    max-height: 640px; overflow-y: auto; scrollbar-width: none;
  }
  #catalogProviderList::-webkit-scrollbar { display: none; }
  .catalog-provider-item {
    background: var(--bg-surface); border: 1px solid var(--border-glass);
    border-radius: 12px; padding: 8px 4px; display: flex; flex-direction: column;
    align-items: center; gap: 6px; cursor: pointer; transition: all 0.15s ease;
  }
  .catalog-provider-item.active { border-color: var(--fa-gold); box-shadow: 0 0 0 2px rgba(212,175,55,0.25); }
  .catalog-provider-item img { width: 100%; max-height: 28px; object-fit: contain; border-radius: 4px; }
  .catalog-provider-item .fallback {
    width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center;
    justify-content: center; color: #fff; font-size: 9px; font-weight: 900;
  }
  .catalog-provider-item .name { font-size: 9.5px; font-weight: 700; color: var(--text-main); text-align: center; line-height: 1.15; }
  #gameContainer { padding: 0 !important; flex: 1; min-width: 0; }

  .game-grid-premium.layout-compact { grid-template-columns: repeat(4, 1fr) !important; gap: 8px !important; }
  .game-grid-premium.layout-compact .game-thumb-wrapper { font-size: 28px !important; }
  .game-grid-premium.layout-compact .game-title-premium { font-size: 11px !important; }

  .game-grid-premium.layout-list { display: flex !important; flex-direction: column; gap: 8px; }
  .game-grid-premium.layout-list .game-card-premium { flex-direction: row !important; align-items: center; }
  .game-grid-premium.layout-list .game-thumb-wrapper { width: 70px; aspect-ratio: 1/1 !important; flex: 0 0 70px; }
  .game-grid-premium.layout-list .game-info-premium { flex: 1; }

  .fav-star {
    position: absolute; top: 6px; left: 6px; z-index: 3; font-size: 15px;
    color: rgba(255,255,255,0.55); text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }
  .fav-star.active { color: #FFD700; }
</style>

<!-- ===== Search Bar ===== -->
<div style="padding: 0 12px 15px 12px;">
  <div style="position:relative;">
    <input type="text" id="gameSearch" class="form-input" placeholder="<%= t.search_placeholder %>" style="padding-right:45px; border-radius: 30px; background: rgba(255,255,255,0.04); border-color: rgba(212,175,55,0.2);">
    <i class="fas fa-search" style="position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--text-muted);"></i>
  </div>
</div>

<%- include('partials/flash') %>

<!-- ===== Secondary Filter Pills (শুধু Slots/Live/Sports/Poker ক্যাটাগরিতে দেখাবে) ===== -->
<div class="secondary-tabs-container" id="secondaryTabs" style="display:none;">
  <div class="secondary-tab-item active" data-secondary="hot"><i class="fas fa-fire"></i> <%= t.cat_hot %></div>
  <div class="secondary-tab-item" data-secondary="favorites"><i class="fas fa-star"></i> ফেভারিটস</div>
  <div class="secondary-tab-item" data-secondary="recent"><i class="fas fa-clock-rotate-left"></i> রিসেন্ট</div>
</div>

<!-- ===== High-Fidelity Premium Game Grid (বাম পাশে প্রোভাইডার কলাম সহ, Slots/Live/Sports/Poker-এ) ===== -->
<div id="mainGridWrap">
  <div id="catalogProviderList"></div>
  <div class="game-grid-premium" id="gameContainer"></div>
</div>

<!-- ===== Progressive Jackpot Board ===== -->
<div class="banner-container" style="margin-top:20px;">
  <div class="card jackpot-board" style="padding:25px 20px; text-align:center; border: 1.5px solid var(--fa-gold); position: relative; overflow: hidden; border-radius: 20px;">
    <div class="jackpot-title" style="font-size:12px; color:var(--fa-gold); letter-spacing:4px; text-transform:uppercase; font-weight:800;">✨ MEGA JACKPOT ✨</div>
    <div style="font-family:'Teko',sans-serif; font-size:52px; color:#FFF; line-height:1; margin:12px 0; text-shadow: 0 0 15px rgba(255, 215, 0, 0.4); display: flex; align-items: center; justify-content: center; gap: 8px;">
      <span style="font-size: 28px; color: var(--fa-gold);">৳</span>
      <span id="jp-num" style="background: linear-gradient(180deg, #FFF 0%, #E2E2E2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">88,617,517</span>
    </div>
    <div style="font-size:11px; color:var(--text-muted);"><%= t.lucky_draw_msg %></div>
  </div>
</div>

<!-- ===== Winners List ===== -->
<div class="section-header" style="padding-top: 15px;">
  <h3 class="section-title"><i class="fas fa-trophy" style="color:var(--fa-gold);"></i> <%= t.winners_list %></h3>
</div>
<div style="padding:0 12px;">

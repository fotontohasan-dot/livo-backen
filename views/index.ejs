<%- include('partials/flash') %>

<style nonce="<%= cspNonce %>">
  /* ===== ক্যাসিনো-প্রথম লেআউট: মোবাইল = এক কলাম, ডেস্কটপ = বাম ক্যাটাগরি | মূল | ডান ম্যাচ ===== */
  .cs-layout { display: grid; gap: 12px; padding: 0 12px 16px; grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "cats" "top" "matches" "all"; }
  @media (min-width: 1024px) {
    .cs-layout { grid-template-columns: 210px minmax(0, 1fr) 290px; align-items: start;
      grid-template-areas: "cats top matches" "cats all matches"; max-width: 1480px; margin: 0 auto; }
  }
  .cs-cats { grid-area: cats; }
  .cs-top { grid-area: top; min-width: 0; }
  .cs-matches { grid-area: matches; min-width: 0; }
  .cs-all { grid-area: all; min-width: 0; }
  .cs-matches .home-hub { margin: 0; }
  @media (min-width: 1024px) { .cs-matches { position: sticky; top: 8px; } }

  /* ক্যাটাগরি: মোবাইলে অনুভূমিক চিপ, ডেস্কটপে উল্লম্ব তালিকা */
  .cs-cat-list { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; margin: 0; padding: 0; list-style: none; }
  .cs-cat-list::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    .cs-cats { background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 14px; padding: 8px; position: sticky; top: 8px; }
    .cs-cat-list { flex-direction: column; overflow: visible; gap: 4px; }
  }
  .cs-chip { display: inline-flex; align-items: center; justify-content: space-between; gap: 8px; flex: 0 0 auto; box-sizing: border-box;
    min-height: 36px; padding: 7px 14px; border-radius: 20px; text-decoration: none; font-size: 12.5px; font-weight: 700;
    color: var(--text-muted); background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); white-space: nowrap; }
  .cs-chip small { opacity: .7; font-weight: 600; }
  .cs-chip:hover { color: var(--text-main); }
  .cs-chip:focus-visible, .cs-card:focus-visible, .cs-az a:focus-visible, .cs-btn:focus-visible, .cs-search input:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .cs-chip.active { background: var(--grad-gold); color: #000; border-color: transparent; }
  @media (min-width: 1024px) { .cs-cats .cs-chip { border-radius: 10px; width: 100%; } }

  /* ব্যানার স্লাইডার (শুধু CSS scroll-snap, কোনো JS লাইব্রেরি নয়) */
  .cs-banners { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; border-radius: 14px; }
  .cs-banners::-webkit-scrollbar { display: none; }
  .cs-banner { flex: 0 0 100%; scroll-snap-align: start; display: block; border-radius: 14px; overflow: hidden; background: var(--bg-surface); }
  .cs-banner img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 6; object-fit: cover; }

  .cs-search { display: flex; gap: 8px; margin: 12px 0; }
  .cs-search input { flex: 1; min-width: 0; padding: 11px 14px; border-radius: 12px; border: 1px solid var(--border-glass); background: var(--bg-surface); color: var(--text-main); font-size: 14px; }
  .cs-btn { padding: 10px 16px; border-radius: 12px; border: none; cursor: pointer; font-weight: 800; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center;
    background: var(--grad-gold) !important; color: #000 !important; }
  .cs-btn.ghost { background: rgba(255,255,255,.06) !important; color: var(--text-main) !important; border: 1px solid var(--border-glass); }
  .cs-sec-title { display: flex; justify-content: space-between; align-items: center; margin: 14px 0 8px; font-size: 15px; font-weight: 800; }
  .cs-sec-title a { font-size: 12px; color: var(--gold); text-decoration: none; font-weight: 700; }
  .cs-h-scroll { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
  .cs-h-scroll::-webkit-scrollbar { display: none; }
  .cs-h-scroll .cs-card { flex: 0 0 132px; }
  .cs-az { display: flex; flex-wrap: nowrap; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 0; padding: 0; list-style: none; }
  .cs-az::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { .cs-az { flex-wrap: wrap; overflow-x: visible; } }
  .cs-az a { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; border-radius: 8px; text-decoration: none; font-size: 12px; font-weight: 800;
    color: var(--text-muted); background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); }
  .cs-az a.active { background: var(--grad-gold); color: #000; border-color: transparent; }
  .cs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
  .cs-card { display: block; text-decoration: none; color: var(--text-main); background: var(--bg-card, var(--bg-surface)); border: 1px solid var(--border-glass); border-radius: 12px; overflow: hidden; }
  .cs-card img, .cs-thumb-fallback { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: flex; align-items: center; justify-content: center; font-size: 28px; background: rgba(255,255,255,.04); }
  .cs-meta { padding: 7px 9px 9px; }
  .cs-name { font-size: 12px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cs-prov { font-size: 10.5px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cs-suspended { opacity: .55; cursor: not-allowed; filter: grayscale(.7); }
  .cs-empty { grid-column: 1 / -1; text-align: center; padding: 24px; color: var(--text-muted); font-size: 13px; }
  .cs-pager { display: flex; justify-content: center; gap: 10px; margin-top: 14px; }
  .cs-block { margin-top: 12px; }
</style>

<div class="cs-layout" id="casinoHome">
  <!-- ক্যাসিনো ক্যাটাগরি: ডেস্কটপে বাঁ সাইডবার, মোবাইলে অনুভূমিক চিপ (শুধু DB-তে থাকা, খালি ক্যাটাগরি আসে না) -->
  <nav class="cs-cats" aria-label="<%= t.hc_categories %>">
    <ul class="cs-cat-list">
      <li><a class="cs-chip <%= !f.category ? 'active' : '' %>" href="<%= url({ category: '', page: '' }) %>#allGames" <%- !f.category ? 'aria-current="true"' : '' %> aria-label="<%= t.all %>"><span><%= t.all %></span></a></li>
      <% c.categories.forEach(function (cat) { %>
      <li><a class="cs-chip <%= f.category === cat.name ? 'active' : '' %>" href="<%= url({ category: cat.name, page: '' }) %>#allGames" <%- f.category === cat.name ? 'aria-current="true"' : '' %> aria-label="<%= catLabel(cat) %>"><span><%= catLabel(cat) %></span> <small><%= cat.count %></small></a></li>
      <% }); %>
    </ul>
  </nav>

  <div class="cs-top">
    <!-- (১) প্রোমো ব্যানার স্লাইডার: বিদ্যমান promotions টেবিল; না থাকলে আগের স্ট্যাটিক ওয়েলকাম ব্যানার -->
    <% if (c.banners.length) { %>
    <div class="cs-banners" role="region" aria-label="<%= t.hc_promo_banners %>" tabindex="0">
      <% c.banners.forEach(function (b, i) { %>
      <% if (b.link) { %><a class="cs-banner" href="<%= b.link %>" aria-label="<%= b.title || t.hc_promo_banners %>"><img src="<%= b.image %>" alt="<%= b.title %>" <%- i === 0 ? 'loading="eager"' : 'loading="lazy"' %> decoding="async" width="960" height="360"></a>
      <% } else { %><div class="cs-banner"><img src="<%= b.image %>" alt="<%= b.title %>" <%- i === 0 ? 'loading="eager"' : 'loading="lazy"' %> decoding="async" width="960" height="360"></div><% } %>
      <% }); %>
    </div>
    <% } else { %>
<div class="promo-banner">
  <div class="promo-banner-content">
    <div class="promo-banner-badge"><%= t.welcome_bonus %></div>
    <h1 class="promo-banner-title dz48-3">
      100% Welcome Bonus
    </h1>
    <p class="dz48-4">
      <%= t.welcome_bonus_desc %> - Up to 50,000 BDT match bonus on first deposit.
    </p>
    <div>
      <a href="/payment/deposit" class="btn dz48-5">
        <%= t.get_now %> <i class="fas fa-chevron-right dz48-6"></i>
      </a>
    </div>
  </div>
  <img class="promo-banner-art" src="/images/hero/welcome-bonus.svg"
       alt="" aria-hidden="true" loading="eager" decoding="async" width="420" height="260">
</div>
    <% } %>

    <!-- (২) গেম সার্চ -->
    <form class="cs-search" method="get" action="/" role="search" aria-label="<%= t.hc_search_label %>">
      <% if (f.category) { %><input type="hidden" name="category" value="<%= f.category %>"><% } %>
      <% if (f.provider) { %><input type="hidden" name="provider" value="<%= f.provider %>"><% } %>
      <% if (f.letter) { %><input type="hidden" name="letter" value="<%= f.letter %>"><% } %>
      <input type="search" name="q" value="<%= f.q %>" maxlength="60" placeholder="<%= t.hc_search_ph %>" aria-label="<%= t.hc_search_label %>">
      <button type="submit" class="cs-btn"><%= t.hc_search_btn %></button>
    </form>

    <!-- (৩) প্রোভাইডার ফিল্টার -->
    <% if (c.providers.length) { %>
    <div class="cs-block">
      <ul class="cs-cat-list" aria-label="<%= t.hc_providers %>">
        <li><a class="cs-chip <%= !f.provider ? 'active' : '' %>" href="<%= url({ provider: '', page: '' }) %>#allGames" aria-label="<%= t.hc_providers %>: <%= t.all %>"><span><%= t.all %></span></a></li>
        <% c.providers.forEach(function (p) { %>
        <li><a class="cs-chip <%= f.provider === p.name ? 'active' : '' %>" href="<%= url({ provider: p.name, page: '' }) %>#allGames" <%- f.provider === p.name ? 'aria-current="true"' : '' %> aria-label="<%= t.hc_providers %>: <%= p.name %>"><span><%= p.name %></span></a></li>
        <% }); %>
      </ul>
    </div>
    <% } %>

    <!-- (৪) A-Z ইনডেক্স (শুধু ইংরেজি নামের প্রথম অক্ষর; যে অক্ষরে গেম আছে সেগুলোই) -->
    <% if (c.letters.length) { %>
    <div class="cs-block">
      <ul class="cs-az" aria-label="<%= t.hc_az %>">
        <% c.letters.forEach(function (l) { %>
        <li><a class="<%= f.letter === l ? 'active' : '' %>" href="<%= url({ letter: f.letter === l ? '' : l, page: '' }) %>#allGames" <%- f.letter === l ? 'aria-current="true"' : '' %> aria-label="<%= t.hc_letter_label.replace('{l}', l) %>"><%= l %></a></li>
        <% }); %>
      </ul>
    </div>
    <% } %>

    <!-- (৫) জনপ্রিয়, নতুন, প্রতি ক্যাটাগরির সারি (ফিল্টার সক্রিয় থাকলে লুকানো — নিচের গ্রিডে ফল) -->
    <% if (!c.filtered) { %>
      <% if (c.popular.length) { %>
      <div class="cs-sec-title"><span><%= t.hc_popular %></span><a href="/#allGames" aria-label="<%= t.hc_popular %>: <%= t.hc_see_all %>"><%= t.hc_see_all %></a></div>
      <div class="cs-h-scroll"><% c.popular.forEach(function (g) { %><%- include('partials/home-game-card', { g: g }) %><% }); %></div>
      <% } %>
      <% if (c.fresh.length) { %>
      <div class="cs-sec-title"><span><%= t.hc_new %></span><a href="/#allGames" aria-label="<%= t.hc_new %>: <%= t.hc_see_all %>"><%= t.hc_see_all %></a></div>
      <div class="cs-h-scroll"><% c.fresh.forEach(function (g) { %><%- include('partials/home-game-card', { g: g }) %><% }); %></div>
      <% } %>
      <% c.rowsByCat.forEach(function (row) { %>
      <div class="cs-sec-title"><span><%= catLabel(row) %></span><a href="<%= url({ category: row.name, q: '', provider: '', letter: '', page: '' }) %>#allGames" aria-label="<%= catLabel(row) %>: <%= t.hc_see_all %>"><%= t.hc_see_all %></a></div>
      <div class="cs-h-scroll"><% row.games.forEach(function (g) { %><%- include('partials/home-game-card', { g: g }) %><% }); %></div>
      <% }); %>
    <% } %>
  </div>

  <!-- লাইভ ম্যাচ: ডেস্কটপে ডান সংকীর্ণ সাইডবার (সর্বোচ্চ ৮), মোবাইলে ক্যাসিনো সেকশনের নিচে ছোট সারি (সর্বোচ্চ ৫)।
       ক্লিক-পথ (/matches/:id) ও বাজি আচরণ অপরিবর্তিত; ডেটা আগের মতোই /matches/api/live। -->
  <aside class="cs-matches" aria-label="<%= t.hc_live_matches %>">
<section class="home-hub" id="homeHub"
         data-max-desktop="<%= c.matchCaps.sidebar %>" data-max-mobile="<%= c.matchCaps.mobile %>"
         data-empty="<%= t.hub_no_matches || 'No matches in this view' %>"
         data-more="<%= t.hub_view_all || 'View all matches' %>"
         data-competitions="<%= t.hub_competitions || 'Competitions' %>">
  <div class="hh-head"><h3><%= t.hc_live_matches %></h3><a href="/matches"><%= t.hub_view_all || 'View all matches' %></a></div>
  <div class="hh-tabs" id="hhTabs">
    <button type="button" class="hh-tab" data-filter="live"><%= t.hub_inplay || 'In-Play' %></button>
    <button type="button" class="hh-tab" data-filter="today"><%= t.hub_today || 'Today' %></button>
    <button type="button" class="hh-tab" data-filter="tomorrow"><%= t.hub_tomorrow || 'Tomorrow' %></button>
    <select class="hh-select" id="hhLeague" aria-label="<%= t.hub_competitions || 'Competitions' %>"><option value=""><%= t.hub_competitions || 'Competitions' %></option></select>
  </div>
  <div class="hh-list" id="hhList"></div>
</section>
  </aside>

  <!-- (৬) সব গেম — A-Z ক্রম, আইডেম্পোটেন্ট পেজিনেশন (একই URL = একই ফল) -->
  <section class="cs-all" id="allGames" aria-label="<%= t.hc_all_games %>">
    <div class="cs-sec-title">
      <span><%= c.filtered ? t.hc_results : t.hc_all_games %></span>
      <% if (c.filtered) { %><a href="/#allGames"><%= t.hc_clear %></a><% } %>
    </div>
    <div class="cs-grid">
      <% if (!c.grid.games.length) { %><div class="cs-empty"><%= t.no_games_found %></div><% } %>
      <% c.grid.games.forEach(function (g) { %><%- include('partials/home-game-card', { g: g }) %><% }); %>
    </div>
    <% if (c.grid.page > 1 || c.grid.hasMore) { %>
    <div class="cs-pager">
      <% if (c.grid.page > 1) { %><a class="cs-btn ghost" rel="prev" href="<%= url({ page: c.grid.page > 2 ? c.grid.page - 1 : '' }) %>#allGames"><%= t.hc_prev %></a><% } %>
      <% if (c.grid.hasMore) { %><a class="cs-btn" rel="next" href="<%= url({ page: c.grid.page + 1 }) %>#allGames"><%= t.hc_more %></a><% } %>
    </div>
    <% } %>
  </section>
</div>
<style nonce="<%= cspNonce %>">
  .home-hub { margin: 4px 12px 14px; padding: 12px; border-radius: 14px; background: var(--bg-surface); border: 1px solid var(--border-glass); }
  .hh-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px 12px; margin-bottom: 8px; }
  .hh-head h3 { margin: 0; font-size: 15px; line-height: 1.3; min-width: 0; overflow-wrap: anywhere; }
  .hh-head a { font-size: 12px; color: var(--gold); text-decoration: none; font-weight: 700; white-space: nowrap; }
  .hh-tabs { display: flex; flex-wrap: nowrap; align-items: center; gap: 8px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; margin-bottom: 10px; padding-bottom: 2px; }
  .hh-tabs::-webkit-scrollbar { display: none; }
  /* style.css-এর গ্লোবাল `button { background:#f42a41 !important; color:#fff !important }` এই ট্যাবগুলোকে
     লাল করে active অবস্থা মুছে দিত; তাই বেশি specificity + !important দিয়ে হাবের নিজস্ব রং ফেরানো হলো। */
  .home-hub .hh-tab, .home-hub .hh-select { flex: 0 0 auto; box-sizing: border-box; min-height: 34px; padding: 7px 16px; border-radius: 20px; font-family: inherit; font-weight: 700; font-size: 12px; line-height: 1.2; white-space: nowrap; cursor: pointer; background: rgba(255,255,255,.04) !important; border: 1px solid rgba(255,255,255,.08) !important; color: var(--text-muted) !important; }
  .home-hub .hh-tab:hover { background: rgba(255,255,255,.09) !important; color: var(--text-main, #fff) !important; }
  .home-hub .hh-tab.active, .home-hub .hh-tab.active:hover { background: var(--grad-gold) !important; color: #000 !important; border-color: transparent !important; }
  .home-hub .hh-select { max-width: 200px; text-overflow: ellipsis; }
  @media (max-width: 480px) {
    .home-hub { margin: 4px 8px 12px; padding: 10px; }
    .home-hub .hh-tab, .home-hub .hh-select { padding: 7px 12px; }
    .home-hub .hh-select { max-width: 150px; }
  }
  .hh-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; }
  .hh-row { display: block; padding: 10px; border-radius: 10px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06); text-decoration: none; color: inherit; }
  .hh-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 10px; color: var(--text-muted); }
  .hh-league { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: uppercase; letter-spacing: .4px; font-weight: 700; }
  .hh-live { background: #dc2626; color: #fff; font-weight: 800; padding: 1px 8px; border-radius: 8px; animation: livedot 1.4s infinite; }
  .hh-team { display: flex; align-items: center; gap: 8px; padding: 2px 0; font-size: 13px; font-weight: 700; }
  .hh-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hh-score { color: var(--gold); }
  .hh-logo { width: 22px; height: 22px; border-radius: 50%; object-fit: contain; flex-shrink: 0; }
  .hh-logo-ph { display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
  .hh-empty, .hh-more { grid-column: 1 / -1; text-align: center; padding: 14px; font-size: 12px; color: var(--text-muted); text-decoration: none; }
</style>
<script src="/js/views/home-matches.js" defer></script>

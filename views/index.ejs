<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    body {
        background-color: #0a0e1a;
        margin-bottom: 60px; /* Space for bottom nav if added */
    }
    .category-tabs {
        display: flex;
        overflow-x: auto;
        gap: 10px;
        padding: 15px;
        background: #111827;
        position: sticky;
        top: 65px;
        z-index: 100;
        scrollbar-width: none;
    }
    .category-tabs::-webkit-scrollbar { display: none; }
    .tab {
        padding: 10px 22px;
        background: #1f2937;
        border-radius: 25px;
        white-space: nowrap;
        color: #9ca3af;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        border: 1px solid #374151;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .tab:hover {
        background: #374151;
        color: #fff;
    }
    .tab.active {
        background: linear-gradient(90deg, #6b00ff, #ff00aa);
        color: #fff;
        font-weight: bold;
        border-color: #ff00aa;
    }
    .game-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        padding: 15px;
    }
    @media (min-width: 640px) {
        .game-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (min-width: 1024px) {
        .game-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .game-card {
        background: linear-gradient(145deg, #1a1433, #241b45);
        border-radius: 15px;
        overflow: hidden;
        position: relative;
        border: 1px solid #3b2d7d;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .game-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        border-color: #6b00ff;
    }
    .game-img {
        aspect-ratio: 16/10;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 54px;
        background: rgba(255,255,255,0.05);
        position: relative;
    }
    .game-img::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
        background: linear-gradient(to top, rgba(26,20,51,0.8), transparent);
    }
    .game-info {
        padding: 10px;
        background: #111827;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .game-name {
        font-size: 13px;
        font-weight: 600;
        color: #e5e7eb;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .play-btn {
        background: #00d4aa;
        color: #000;
        border: none;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
    }
    .promo-banner {
        width: calc(100% - 30px);
        margin: 15px;
        height: 140px;
        background: linear-gradient(45deg, #3b006e, #7e22ce);
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        padding: 20px;
        gap: 8px;
    }
</style>

<div class="promo-banner">
    🎰 Welcome to LIVO <br>
    <span style="font-size: 14px; color: #fbbf24;">Get 500 Welcome Coins!</span>
</div>

<div class="category-tabs" id="tabs">
    <div class="tab active" data-filter="all">All</div>
    <div class="tab" data-filter="slots">Slots</div>
    <div class="tab" data-filter="java">Java</div>
    <div class="tab" data-filter="live">Live</div>
    <div class="tab" data-filter="sports">Sports</div>
</div>

<div class="container">
    <%- include('partials/flash') %>
    <div class="game-grid" id="gameContainer"></div>
</div>

<script>
    const games = [
        {name: "Super Ace", emoji: "🂡", cat: "slots"},
        {name: "Fortune Gems", emoji: "💎", cat: "slots"},
        {name: "Boxing King", emoji: "🥊", cat: "slots"},
        {name: "Golden Empire", emoji: "👑", cat: "slots"},
        {name: "Doodle Jump", emoji: "🦎", cat: "java"},
        {name: "Diamond Rush", emoji: "💎", cat: "java"},
        {name: "Bounce Tales", emoji: "🔴", cat: "java"},
        {name: "Tower Bloxx", emoji: "🏗️", cat: "java"},
        {name: "Roulette", emoji: "🎡", cat: "live"},
        {name: "Crazy Time", emoji: "🎪", cat: "live"},
        {name: "Mega Ball", emoji: "🎱", cat: "live"},
        {name: "Baccarat", emoji: "🎴", cat: "live"},
        {name: "Cricket Live", emoji: "🏏", cat: "sports"},
        {name: "Football Match", emoji: "⚽", cat: "sports"},
        {name: "Tennis Open", emoji: "🎾", cat: "sports"},
        {name: "Horse Racing", emoji: "🏇", cat: "sports"}
    ];

    const container = document.getElementById('gameContainer');
    const tabs = document.querySelectorAll('.tab');

    function renderGames(filter = 'all') {
        container.innerHTML = '';
        const filtered = filter === 'all' ? games : games.filter(g => g.cat === filter);
        filtered.forEach(game => {
            const card = document.createElement('div');
            card.className = 'game-card';
            card.innerHTML = `
                <div class="game-img">${game.emoji}</div>
                <div class="game-info">
                    <div class="game-name">${game.name}</div>
                    <button class="play-btn" onclick="location.href='/login'">Play</button>
                </div>
            `;
            container.appendChild(card);
        });
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            renderGames(tab.dataset.filter);
        });
    });

    renderGames();
</script>

</body></html>

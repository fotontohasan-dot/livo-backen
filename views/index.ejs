<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }

/* FA999 Gold Theme Styles */
:root {
  --fa-gold-light: #FFEFA6;
  --fa-gold: #D4AF37;
  --fa-gold-dark: #AA7C11;
  --fa-gold-gradient: linear-gradient(135deg, #FFF3C4 0%, #FFD700 50%, #B8860B 100%);
  --fa-dark-gradient: linear-gradient(180deg, #1A1C20 0%, #0F1012 100%);
  --fa-card-bg: rgba(255, 255, 255, 0.05);
}

.promo-banner {
  background: linear-gradient(135deg, #1C1E22 0%, #0F1012 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-left: none;
  border-right: none;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  border-radius: 0;
  overflow: hidden;
  position: relative;
  margin: 0 0 12px 0;
}

.promo-banner-content {
  background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
  padding: 16px 14px;
  min-height: 130px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.promo-banner-badge {
  background: var(--fa-gold-gradient);
  color: #000;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 20px;
  align-self: flex-start;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
}

/* Shortcuts Menu Bar */
.shortcut-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  margin: 0 0 12px 0;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(212, 175, 55, 0.1);
  border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  border-radius: 0;
  padding: 7px 0;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
}

.shortcut-item:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}

.shortcut-icon-wrapper {
  width: auto;
  height: auto;
  border-radius: 0;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--fa-gold);
  margin-bottom: 3px;
  box-shadow: none;
}

.shortcut-label {
  font-size: 10px;
  font-weight: 500;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 0.1px;
}

/* Horizontal Navigation Tabs */
.horizontal-nav-container {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  padding: 5px 12px 15px 12px;
  scrollbar-width: none;
}
.horizontal-nav-container::-webkit-scrollbar {
  display: none;
}

.nav-tab-item {
  flex: 0 0 auto;
  padding: 10px 20px;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.nav-tab-item.active {
  background: var(--fa-gold-gradient);
  color: #000 !important;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
}

.nav-tab-item.active i {
  color: #000;
}

.game-grid-premium {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding: 0 12px;
}

.game-card-premium {
  background: linear-gradient(135deg, rgba(30, 32, 38, 0.8) 0%, rgba(15, 16, 18, 0.9) 100%);
  border: 1px solid rgba(212, 175, 55, 0.1);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.game-card-premium:hover {
  transform: scale(1.02);
  border-color: var(--fa-gold);
}

.game-thumb-wrapper {
  aspect-ratio: 16/10;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  position: relative;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.game-info-premium {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.game-title-premium {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-provider-premium {
  font-size: 10px;
  font-weight: 600;
  color: var(--fa-gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.game-badge-premium {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 8px;
  font-weight: 800;
  background: #ff4d4f;
  color: #fff;
  text-transform: uppercase;
}

.marquee-container-premium {
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 8px;
  margin: 10px 12px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.marquee-label-premium {
  color: var(--fa-gold);
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
}

/* ===== Golden Shimmer / Glow — Welcome Banner + Jackpot (dark & light mode) ===== */
@keyframes goldShimmerSweep {
  0%   { transform: translateX(-150%) skewX(-20deg); }
  100% { transform: translateX(250%) skewX(-20deg); }
}
@keyframes goldGlowPulse {
  0%, 100% { text-shadow: 0 0 8px rgba(255,215,0,0.35), 0 0 18px rgba(212,175,55,0.25), 0 2px 4px rgba(0,0,0,0.6); }
  50%      { text-shadow: 0 0 16px rgba(255,215,0,0.65), 0 0 32px rgba(212,175,55,0.5), 0 2px 4px rgba(0,0,0,0.6); }
}

.promo-banner {
  background:
    radial-gradient(circle at 15% 15%, rgba(255,215,0,0.16) 0%, transparent 45%),
    radial-gradient(circle at 90% 85%, rgba(212,175,55,0.14) 0%, transparent 50%),
    linear-gradient(135deg, #1C1E22 0%, #0F1012 100%) !important;
  border: 1px solid rgba(212, 175, 55, 0.4) !important;
  box-shadow: 0 4px 25px rgba(0,0,0,0.5), inset 0 0 25px rgba(212,175,55,0.08) !important;
}

.promo-banner::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 55%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.16) 45%, rgba(255,215,0,0.3) 50%, rgba(255,235,160,0.16) 55%, transparent 100%);
  animation: goldShimmerSweep 5s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.promo-banner-title {
  animation: goldGlowPulse 3s ease-in-out infinite;
}

.jackpot-board {
  background:
    radial-gradient(circle at center, rgba(255,215,0,0.10) 0%, transparent 60%),
    radial-gradient(circle at center, #1F2226 0%, #0D0E10 100%) !important;
}

.jackpot-board::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.09) 45%, rgba(255,215,0,0.18) 50%, rgba(255,235,160,0.09) 55%, transparent 100%);
  animation: goldShimmerSweep 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.jackpot-title, #jp-num {
  animation: goldGlowPulse 3s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

.promo-banner-content, .promo-banner > div:last-child {
  position: relative;
  z-index: 2;
}

/* Light mode: keep the same rich dark gold card, but frame it so it visibly floats off a white page */
body.light-mode .promo-banner {
  border: 1.5px solid var(--fa-gold) !important;
  box-shadow: 0 10px 30px rgba(212,175,55,0.3), 0 2px 10px rgba(0,0,0,0.12) !important;
}
</style>

<!-- ===== HERO SECTION ===== -->
<style>
@keyframes heroSweep {
  0%   { transform: translateX(-120%) skewX(-15deg); }
  100% { transform: translateX(220%) skewX(-15deg); }
}
@keyframes heroFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

.hero-section {
  position: relative;
  overflow: hidden;
  padding: 52px 18px 40px;
  min-height: 400px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 15% 10%, rgba(200,16,46,0.32) 0%, transparent 45%),
    radial-gradient(circle at 88% 20%, rgba(234,179,8,0.22) 0%, transparent 42%),
    radial-gradient(circle at 50% 100%, rgba(234,179,8,0.10) 0%, transparent 55%),
    linear-gradient(180deg, #0c0c12 0%, #050505 100%);
  border-bottom: 1px solid rgba(212,175,55,0.18);
  text-align: center;
}
/* মৃদু ডট-গ্রিড টেক্সচার — কার্ড-টেবিলের মতো গভীরতা দেয় */
.hero-section::before {
  content: "";
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
  background-size: 22px 22px;
  mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 0%, transparent 75%);
  pointer-events: none;
}
/* সিগনেচার — ধীরে চলমান সোনালি আলোর ঝলক */
.hero-section::after {
  content: "";
  position: absolute; top: 0; left: 0; width: 45%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,235,160,0.10) 45%, rgba(255,215,0,0.16) 50%, rgba(255,235,160,0.10) 55%, transparent 100%);
  animation: heroSweep 7s ease-in-out infinite;
  pointer-events: none;
}
.hero-inner { position: relative; z-index: 2; }

.hero-live-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(212,175,55,0.35);
  padding: 7px 16px; border-radius: 22px; font-size: 12px; font-weight: 700;
  color: var(--fa-gold-light); margin-bottom: 18px;
  box-shadow: 0 4px 14px rgba(0,0,0,0.3);
  animation: heroFloat 4s ease-in-out infinite;
}
.hero-live-dot { width:8px; height:8px; border-radius:50%; background:#22c55e; box-shadow: 0 0 8px #22c55e; animation: livedot 1.5s infinite; }

.hero-heading {
  font-family: 'Teko', sans-serif; font-weight: 700; text-transform: uppercase;
  font-size: 44px; line-height: 1.02; letter-spacing: 0.5px; margin: 0 0 14px;
  background: linear-gradient(135deg, #ffffff 25%, var(--fa-gold-light) 60%, var(--fa-gold) 85%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  filter: drop-shadow(0 2px 18px rgba(212,175,55,0.25));
}
.hero-heading .accent { color: var(--primary); -webkit-text-fill-color: var(--primary); }

.hero-sub {
  font-size: 14px; color: #d3d5dc; max-width: 440px; margin: 0 auto 26px; line-height: 1.7;
  font-weight: 500;
}

.hero-cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
.hero-btn {
  padding: 15px 30px; border-radius: 32px; font-weight: 800; font-size: 14.5px;
  text-decoration: none; display: inline-flex; align-items: center; gap: 9px;
  transition: transform .15s ease, box-shadow .15s ease;
}
.hero-btn:hover { transform: translateY(-2px); }
.hero-btn:active { transform: scale(0.96); }
.hero-btn-primary {
  background: var(--fa-gold-gradient); color: #000;
  box-shadow: 0 8px 24px rgba(212,175,55,0.4);
}
.hero-btn-primary:hover { box-shadow: 0 10px 30px rgba(212,175,55,0.55); }
.hero-btn-secondary {
  background: rgba(255,255,255,0.07); color: #fff; border: 1.5px solid rgba(255,255,255,0.2);
}
.hero-btn-secondary:hover { background: rgba(255,255,255,0.12); border-color: rgba(212,175,55,0.4); }

.hero-stats-row { display: flex; justify-content: center; gap: 30px; flex-wrap: wrap; }
.hero-stat { text-align: center; }
.hero-stat-num { font-family: 'Teko', sans-serif; font-size: 25px; font-weight: 700; color: var(--fa-gold); line-height: 1; }
.hero-stat-label { font-size: 10.5px; color: var(--text-muted); margin-top: 4px; letter-spacing: 0.2px; }

@media (min-width: 640px) {
  .hero-section { padding: 72px 24px 52px; min-height: 480px; }
  .hero-heading { font-size: 64px; }
  .hero-sub { font-size: 16.5px; max-width: 580px; }
  .hero-btn { padding: 17px 36px; font-size: 15.5px; }
}
</style>

<div class="hero-section">
  <div class="hero-inner">
    <div class="hero-live-badge"><span class="hero-live-dot"></span> ২,৮৪০+ জন এখন অনলাইনে খেলছেন</div>
    <h1 class="hero-heading">বাংলাদেশের <span class="accent">#১</span><br>প্রেডিকশন ও ক্যাসিনো প্ল্যাটফর্ম</h1>
    <p class="hero-sub">লাইভ ম্যাচ প্রেডিক্ট করুন, প্রিমিয়াম ক্যাসিনো গেম খেলুন এবং সেকেন্ডেই জিতুন রিয়েল রিওয়ার্ড — নিরাপদ, দ্রুত ও সম্পূর্ণ লাইসেন্সপ্রাপ্ত।</p>
    <div class="hero-cta-row">
      <a href="#categoryTabs" class="hero-btn hero-btn-primary"><i class="fas fa-play"></i> এখনই খেলুন</a>
      <% if (!locals.user) { %>
        <a href="/register" class="hero-btn hero-btn-secondary"><i class="fas fa-user-plus"></i> ফ্রি অ্যাকাউন্ট খুলুন</a>
      <% } else { %>
        <a href="/payment/deposit" class="hero-btn hero-btn-secondary"><i class="fas fa-wallet"></i> ডিপোজিট করুন</a>
      <% } %>
    </div>
    <div class="hero-stats-row">
      <div class="hero-stat"><div class="hero-stat-num">১১৮+</div><div class="hero-stat-label">গেমস</div></div>
      <div class="hero-stat"><div class="hero-stat-num">২৪/৭</div><div class="hero-stat-label">সাপোর্ট</div></div>
      <div class="hero-stat"><div class="hero-stat-num">৫ মিনিট</div><div class="hero-stat-label">উইথড্র</div></div>
    </div>
  </div>
</div>

<!-- ===== Marquee Ticker ===== -->
<div class="marquee-container-premium">
  <div class="marquee-label-premium">
    <i class="fas fa-bullhorn"></i> Announcement:
  </div>
  <div style="flex:1; overflow:hidden;">
    <div style="font-size:12px; color:var(--text-muted); white-space:nowrap; animation:marquee-text 18s linear infinite;">
      📢 প্রিয় গ্রাহক, LIVO-তে আপনাকে স্বাগতম! 🌟 Deposit, Withdrawal, Reward, এবং Rebate-এর চমৎকার সুবিধা উপভোগ করুন। প্রতিদিন ১ লক্ষ টাকা পর্যন্ত Rebate বোনাস জেতার সুযোগ! 💰
    </div>
  </div>
</div>

<!-- ===== Large FA999-style Promotional Welcome Banner ===== -->
<div class="promo-banner">
  <div class="promo-banner-content">
    <div class="promo-banner-badge"><%= t.welcome_bonus %></div>
    <h1 class="promo-banner-title" style="font-family:'Teko', sans-serif; font-size: 30px; color: var(--fa-gold-light); line-height: 1.1; margin: 8px 0 3px 0; text-transform: uppercase;">
      100% Welcome Bonus
    </h1>
    <p style="font-size: 11px; color: #E0E2E5; margin-bottom: 10px; font-weight: 500;">
      <%= t.welcome_bonus_desc %> - Up to 50,000 BDT match bonus on first deposit.
    </p>
    <div>
      <a href="/payment/deposit" class="btn" style="background: var(--fa-gold-gradient); color: #000; font-weight: 800; font-size: 11px; border-radius: 20px; padding: 7px 18px;">
        <%= t.get_now %> <i class="fas fa-chevron-right" style="font-size: 9px; margin-left: 4px;"></i>
      </a>
    </div>
  </div>
  <div style="position: absolute; right: 12px; bottom: 8px; font-size: 80px; opacity: 0.12; pointer-events: none; color: #FFF;">
    🎰
  </div>
</div>

<!-- ===== Deposit, Withdrawal, Reward, Rebate Highlighted Shortcuts ===== -->
<div class="shortcut-bar">
  <a href="/payment/deposit" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-wallet"></i>
    </div>
    <div class="shortcut-label"><%= t.deposit %></div>
  </a>
  <a href="/payment/withdraw" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-hand-holding-dollar"></i>
    </div>
    <div class="shortcut-label"><%= t.withdrawal %></div>
  </a>
  <a href="/extra/missions" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-trophy"></i>
    </div>
    <div class="shortcut-label"><%= t.reward %></div>
  </a>
  <a href="/profile" class="shortcut-item">
    <div class="shortcut-icon-wrapper">
      <i class="fas fa-coins"></i>
    </div>
    <div class="shortcut-label"><%= t.rebate %></div>
  </a>
</div>

<!-- ===== Popular Games (কিউরেটেড হাইলাইট স্ট্রিপ) ===== -->
<style>
.popular-games-section { padding: 4px 0 16px; }
.popular-games-heading {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 12px 10px;
}
.popular-games-heading h2 {
  font-family: 'Teko', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 0.4px;
  color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 8px;
}
.popular-games-heading h2 i { color: #ff5b3d; font-size: 17px; }
.popular-games-heading a { font-size: 11px; font-weight: 700; color: var(--fa-gold); text-decoration: none; }
.popular-games-scroll {
  display: flex; gap: 12px; overflow-x: auto; padding: 2px 12px 6px; scrollbar-width: none;
}
.popular-games-scroll::-webkit-scrollbar { display: none; }
.popular-games-scroll .game-card-premium { flex: 0 0 128px; }
</style>
<div class="popular-games-section">
  <div class="popular-games-heading">
    <h2><i class="fas fa-fire"></i> Popular Games</h2>
    <a href="#categoryTabs">সব দেখুন <i class="fas fa-chevron-right" style="font-size:9px;"></i></a>
  </div>
  <div class="popular-games-scroll" id="popularGamesRow"></div>
</div>

<!-- ===== Horizontal Navigation Tabs (Hot, Slots, Live, Sports, Poker, Favorites, Recent) ===== -->
<div class="horizontal-nav-container" id="categoryTabs">
  <div class="nav-tab-item active" data-category="all">
    <i class="fas fa-border-all"></i> <%= t.all %>
  </div>
  <div class="nav-tab-item" data-category="hot">
    <i class="fas fa-fire"></i> <%= t.cat_hot %>
  </div>
  <div class="nav-tab-item" data-category="slots">
    <i class="fas fa-gamepad"></i> <%= t.cat_slots %>
  </div>
  <div class="nav-tab-item" data-category="live">
    <i class="fas fa-video"></i> <%= t.cat_live %>
  </div>
  <div class="nav-tab-item" data-category="sports">
    <i class="fas fa-running"></i> <%= t.cat_sports %>
  </div>
  <div class="nav-tab-item" data-category="poker">
    <i class="fas fa-heart"></i> <%= t.cat_poker %>
  </div>
  <div class="nav-tab-item" data-category="favorites">
    <i class="fas fa-star"></i> ফেভারিটস
  </div>
  <div class="nav-tab-item" data-category="recent">
    <i class="fas fa-clock-rotate-left"></i> রিসেন্ট
  </div>
</div>

<!-- ===== Layout Switcher ===== -->
<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:0 12px 10px;">
  <span style="font-size:11px;color:var(--text-muted);margin-right:2px;">লেআউট:</span>
  <button type="button" class="layout-btn" data-layout="compact" title="কমপ্যাক্ট"><i class="fas fa-table-cells"></i></button>
  <button type="button" class="layout-btn active" data-layout="standard" title="স্ট্যান্ডার্ড"><i class="fas fa-table-cells-large"></i></button>
  <button type="button" class="layout-btn" data-layout="list" title="লিস্ট"><i class="fas fa-list"></i></button>
</div>

<style>
  .layout-btn {

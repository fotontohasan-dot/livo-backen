<!-- ===== Trust Badges ===== -->
<style nonce="<%= cspNonce %>">
.trust-badges-section { padding: 30px 14px 14px; }
.trust-badges-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.trust-badge-item {

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    body {
        background-color: #050505;
        color: #fff;
        font-family: Arial, sans-serif;
        margin: 0;
        margin-bottom: 70px;
    }

    .promo-banner {
        width: calc(100% - 30px);
        margin: 15px;
        height: 140px;
        background: linear-gradient(45deg, #3b006e, #7e22ce);
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        padding: 20px;
        gap: 8px;
    }

    .search-container { padding: 10px 20px; }
    .search-box { position: relative; }
    .search-box input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #333;
        background: #1a1a1a;
        color: #fff;
        outline: none;
    }

    .category-nav {
        padding: 10px 20px;
        display: flex;
        overflow-x: auto;
        gap: 10px;
        scrollbar-width: none;
    }
    .category-nav::-webkit-scrollbar { display: none; }
    .category-item {
        padding: 8px 15px;
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 5px;
        white-space: nowrap;
        cursor: pointer;
        font-size: 14px;
    }
    .category-item.active {
        background: #ffcc00;
        color: #000;
        border-color: #ffcc00;
        font-weight: bold;
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 20px;
        padding: 20px;
    }

    .game-card {
        background: #1a1a1a;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid #333;
        transition: 0.3s;
    }

    .game-card:hover {
        border-color: #ffcc00;
        transform: translateY(-5px);
    }

    .game-card img {
        width: 80px;
        height: 80px;
        margin-bottom: 10px;
        object-fit: contain;
    }

    .game-card h3 {
        margin: 10px 0;
        font-size: 16px;
    }

    .play-btn {
        background: #ffcc00;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
        color: #000;
        width: 100%;
    }

    /* License Section */
    .footer-license {
        padding: 30px 20px 50px;
        text-align: center;
        background: #0a0a0a;
        border-top: 1px solid #333;
        margin-top: 20px;
    }
</style>

<div class="promo-banner">
    🎰 LIVO-তে স্বাগতম <br>
    <span style="font-size: 14px; color: #fbbf24;">৫০০ ওয়েলকাম কয়েন পান!</span>
</div>

<div class="search-container">
    <div class="search-box">
        <input type="text" id="gameSearch" placeholder="গেম খুঁজুন...">
    </div>
</div>

<div class="category-nav" id="categoryNav">
    <div class="category-item active" data-type="all">সবগুলো</div>
    <div class="category-item" data-type="pvp">PVP</div>
    <div class="category-item" data-type="slots">স্লট</div>
    <div class="category-item" data-type="live">লাইভ ক্যাসিনো</div>
    <div class="category-item" data-type="table">টেবিল গেম</div>
    <div class="category-item" data-type="sports">স্পোর্টস</div>
</div>

<div class="game-grid" id="gameContainer"></div>

<div class="footer-license">
    <div style="display: flex; justify-content: center; gap: 20px; margin-bottom: 15px;">
        <span style="font-size: 24px;">🔞</span>
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Curacao_eGaming_logo.svg/1200px-Curacao_eGaming_logo.svg.png" alt="License" style="height: 30px;">
    </div>
    <p style="font-size: 12px; color: #888; line-height: 1.6;">
        © 2024 LIVO Gaming. All Rights Reserved. <br>
        License No. 8048/JAZ issued to Antillephone, Authorized and Regulated by the Government of Curacao. <br>
        দয়া করে দায়িত্বশীলভাবে খেলুন।
    </p>
</div>

<%- include('partials/bottom-nav', { activePage: 'home' }) %>

<script>
    const games = [
        {name:"Aviator",           emoji:"✈️", type:"pvp", slug: "aviator"},
        {name:"Teen Patti",        emoji:"🃏", type:"pvp", slug: "teen-patti"},
        {name:"Andar Bahar",       emoji:"🎴", type:"pvp", slug: "andar-bahar"},
        {name:"Blackjack",         emoji:"♠️", type:"table", slug: "blackjack"},
        {name:"Poker",             emoji:"🃏", type:"pvp", slug: "poker"},
        {name:"Baccarat",          emoji:"🎰", type:"table", slug: "baccarat"},
        {name:"Roulette",          emoji:"🎡", type:"table", slug: "roulette"},
        {name:"Slots",             emoji:"🎰", type:"slots", slug: "slots"},
        {name:"Online Ludo",       emoji:"🎲", type:"pvp", slug: "ludo"}
    ];

    let currentType = 'all';
    let searchQuery = '';

    function renderGames() {
        const container = document.getElementById('gameContainer');
        container.innerHTML = '';

        const filtered = games.filter(g => {
            const matchesType = currentType === 'all' || g.type === currentType;
            const matchesSearch = g.name.toLowerCase().includes(searchQuery.toLowerCase());
            return matchesType && matchesSearch;
        });

        filtered.forEach(item => {
            const card = document.createElement('div');
            card.className = 'game-card';
            const playUrl = item.slug ? `/games/${item.slug}` : '/login';

            card.innerHTML = `
                <div style="font-size: 50px; margin-bottom: 10px;">${item.emoji}</div>
                <h3>${item.name}</h3>
                <button class="play-btn" onclick="location.href='${playUrl}'">খেলুন</button>
            `;
            container.appendChild(card);
        });
    }

    document.querySelectorAll('.category-item').forEach(item => {
        item.addEventListener('click', () => {
            document.querySelectorAll('.category-item').forEach(i => i.classList.remove('active'));
            item.classList.add('active');
            currentType = item.getAttribute('data-type');
            renderGames();
        });
    });

    document.getElementById('gameSearch').addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderGames();
    });

    renderGames();
</script>
</body></html>

<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ===== Sports Quick Links ===== -->
<div style="padding: 12px;">
  <div style="background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(0,150,37,0.05)); border: 1px solid var(--border-glass); border-radius: 16px; padding: 14px;">

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div style="font-size:13px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:0.5px;">
        ⚡ <%= t.quick_links %>
      </div>
      <a href="/matches" style="font-size:11px;color:var(--text-muted);text-decoration:none;">
        <%= t.see_all %> →
      </a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;">
      <a href="/matches" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#ef4444,#dc2626);border-radius:12px;padding:14px 6px;position:relative;">
          <div style="font-size:22px;">⏱️</div>
          <div style="position:absolute;top:4px;right:4px;width:6px;height:6px;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff;animation:livedot 1.5s infinite;"></div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;"><%= t.in_play %></div>
      </a>

      <a href="/matches/cricket" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#10b981,#059669);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">🏏</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;"><%= t.cricket %></div>
      </a>

      <a href="/matches/football" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">⚽</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;"><%= t.football %></div>
      </a>

      <a href="/matches/worldcup" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:12px;padding:14px 6px;position:relative;">
          <div style="font-size:22px;">🏆</div>
          <div style="position:absolute;top:3px;right:3px;background:#ef4444;color:#fff;font-size:8px;padding:1px 4px;border-radius:6px;font-weight:700;">HOT</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;">WC 2026</div>
      </a>

      <a href="/tournaments" style="text-decoration:none;text-align:center;">
        <div style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);border-radius:12px;padding:14px 6px;">
          <div style="font-size:22px;">🎯</div>
        </div>
        <div style="font-size:11px;color:var(--text-main);margin-top:6px;font-weight:600;"><%= t.prediction %></div>
      </a>
    </div>
  </div>
</div>

<style>
@keyframes livedot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.4); }
}
@keyframes marquee-text { 0%{transform:translateX(100%)} 100%{transform:translateX(-100%)} }
</style>

<!-- ===== Welcome Banner ===== -->
<div class="banner-container">
  <div class="card btn-glow" style="height:160px;background:linear-gradient(135deg, #006519, #004d13);position:relative;display:flex;align-items:center;padding:20px;border: 1px solid var(--gold);">
    <div style="z-index:1;">
      <h2 style="font-family:'Teko',sans-serif;font-size:32px;color:var(--gold);line-height:1;">🎰 <%= t.welcome_bonus %></h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.9);margin-top:5px;"><%= t.welcome_bonus_desc %></p>
      <div style="margin-top:5px; font-size: 11px; color: #fff;"><%= t.referral_bonus %> 🎁</div>
      <a href="/payment/deposit" class="btn btn-primary" style="margin-top:12px;border-radius:25px;padding:8px 24px;background: var(--grad-gold); color: #000;"><%= t.get_now %></a>
    </div>
    <div style="position:absolute;right:10px;font-size:80px;opacity:0.2;">🏆</div>
  </div>
</div>

<!-- ===== News Ticker ===== -->
<div class="glass" style="margin:8px 12px;border-radius:12px;padding:12px;display:flex;align-items:center;gap:12px;position:relative;">
  <div style="background:var(--gold);color:#000;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:bold;">News</div>

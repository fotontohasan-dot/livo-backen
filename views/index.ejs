<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Online Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f0b1f; color: white; }
        .header {
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            padding: 15px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { font-size: 26px; font-weight: bold; color: #ffd700; }
        .category { margin-top: 70px; padding: 15px; }
        h2 { color: #ffd700; margin-bottom: 12px; font-size: 19px; }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 12px;
        }
        .game-card {
            background: #1a1433;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            cursor: pointer;
        }
        .game-thumb {
            width: 100%;
            height: 115px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: bold;
        }
        .game-name { font-size: 13px; padding: 10px 5px; color: #ffccff; font-weight: bold; }
    </style>
</head>
<body>

<div class="header">
    <div class="logo">LIVO</div>
</div>

<div class="category">
    <h2>🎮 All Games</h2>
    <div class="game-grid" id="allGames"></div>
</div>

<div class="category">
    <h2>🎰 Slots</h2>
    <div class="game-grid" id="slots"></div>
</div>

<div class="category">
    <h2>🎥 Live Casino</h2>
    <div class="game-grid" id="liveCasino"></div>
</div>

<div class="category">
    <h2>🃏 Table Games</h2>
    <div class="game-grid" id="tableGames"></div>
</div>

<script>
    const bgColors = [
        "linear-gradient(135deg,#1a0050,#6b00ff)",
        "linear-gradient(135deg,#500030,#ff00aa)",
        "linear-gradient(135deg,#003050,#00aaff)",
        "linear-gradient(135deg,#502000,#ff6600)",
        "linear-gradient(135deg,#005030,#00cc66)",
        "linear-gradient(135deg,#500010,#ff3366)",
        "linear-gradient(135deg,#300050,#9900ff)",
        "linear-gradient(135deg,#503000,#ff9900)",
        "linear-gradient(135deg,#004040,#00ffcc)",
        "linear-gradient(135deg,#500020,#ff0066)",
        "linear-gradient(135deg,#001050,#3366ff)",
        "linear-gradient(135deg,#502010,#ff6633)"
    ];
    let ci = 0;

    function addGames(id, list) {
        const container = document.getElementById(id);
        list.forEach(item => {
            const card = document.createElement('div');
            card.className = 'game-card';
            const bg = bgColors[ci % bgColors.length];
            ci++;
            card.innerHTML = `
                <div class="game-thumb" style="background:${bg}">
                    ${item.emoji}
                </div>
                <div class="game-name">${item.name}</div>
            `;
            container.appendChild(card);
        });
    }

    addGames('allGames', [
        {name:"Teen Patti",        emoji:"🃏"},
        {name:"Super Ace",         emoji:"🂡"},
        {name:"Crash",             emoji:"🚀"},
        {name:"Aviator",           emoji:"✈️"},
        {name:"Andar Bahar",       emoji:"🎴"},
        {name:"Dragon Tiger",      emoji:"🐉"},
        {name:"Roulette",          emoji:"🎡"},
        {name:"Blackjack",         emoji:"♠️"},
        {name:"Fortune Gems",      emoji:"💎"},
        {name:"Boxing King",       emoji:"🥊"},
        {name:"Lucky Spin",        emoji:"🎰"},
        {name:"Color Prediction",  emoji:"🌈"},
        {name:"Golden Empire",     emoji:"👑"},
        {name:"Sweet Bonanza",     emoji:"🍭"},
        {name:"Gates of Olympus",  emoji:"⚡"},
        {name:"Starlight Princess",emoji:"⭐"},
        {name:"Fruit Party",       emoji:"🍎"},
        {name:"Blackjack Live",    emoji:"♠️"},
        {name:"Baccarat Live",     emoji:"🎰"},
        {name:"Roulette Live",     emoji:"🎡"},
        {name:"Dragon Tiger Live", emoji:"🐯"},
        {name:"Crazy Time",        emoji:"🎪"}
    ]);

    addGames('slots', [
        {name:"Fortune Gems",      emoji:"💎"},
        {name:"Golden Empire",     emoji:"👑"},
        {name:"Sweet Bonanza",     emoji:"🍭"},
        {name:"Gates of Olympus",  emoji:"⚡"},
        {name:"Starlight Princess",emoji:"⭐"},
        {name:"Fruit Party",       emoji:"🍎"}
    ]);

    addGames('liveCasino', [
        {name:"Blackjack Live",    emoji:"♠️"},
        {name:"Baccarat Live",     emoji:"🎰"},
        {name:"Roulette Live",     emoji:"🎡"},
        {name:"Dragon Tiger Live", emoji:"🐯"},
        {name:"Crazy Time",        emoji:"🎪"}
    ]);

    addGames('tableGames', [
        {name:"Blackjack",   emoji:"♠️"},
        {name:"Baccarat",    emoji:"🎴"},
        {name:"Roulette",    emoji:"🎡"},
        {name:"Teen Patti",  emoji:"🃏"},
        {name:"Andar Bahar", emoji:"🎲"},
        {name:"Dragon Tiger",emoji:"🐉"}
    ]);
</script>

</body>
</html>

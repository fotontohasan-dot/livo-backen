    <div style="font-size:10px;margin-top:4px;color:var(--text-muted);"><%= t.menu_news %></div>
  </div>
  <div class="glass cat-item" data-link="/payment/deposit" style="flex:0 0 auto;width:70px;height:70px;border-radius:15px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:0.3s;border: 1px solid var(--border-glass);">

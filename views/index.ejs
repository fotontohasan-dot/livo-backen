<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Livo - Online Casino</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f0b1f; color: white; }
        .header {
            background: linear-gradient(90deg, #6b00ff, #ff00aa);
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 100;
        }
        .logo { font-size: 26px; font-weight: bold; color: #ffd700; }

        .category { margin-top: 70px; padding: 15px; }
        h2 { 
            color: #ffd700; 
            margin-bottom: 15px; 
            font-size: 20px;
        }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 12px;
        }
        .game-card {
            background: #1a1433;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
        }
        .game-card img { width: 100%; height: 115px; object-fit: cover; }
        .game-name { 
            font-size: 13.5px; 
            padding: 10px 5px; 
            color: #ffccff; 
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">LIVO</div>
    </div>

    <!-- All Games -->
    <div class="category">
        <h2>🎮 All Games</h2>
        <div class="game-grid" id="allGames"></div>
    </div>

    <!-- Slots -->
    <div class="category">
        <h2>🎰 Slots</h2>
        <div class="game-grid" id="slots"></div>
    </div>

    <!-- Live Casino -->
    <div class="category">
        <h2>🎥 Live Casino</h2>
        <div class="game-grid" id="liveCasino"></div>
    </div>

    <!-- Table Games -->
    <div class="category">
        <h2>🃏 Table Games</h2>
        <div class="game-grid" id="tableGames"></div>
    </div>

    <script>
        function addGames(id, games) {
            const container = document.getElementById(id);
            games.forEach(name => {
                const card = document.createElement('div');
                card.className = 'game-card';
                card.innerHTML = `
                    <img src="https://via.placeholder.com/300x180/6b00ff/ffffff?text=${name.replace(/ /g, '+')}" alt="${name}">
                    <div class="game-name">${name}</div>
                `;
                container.appendChild(card);
            });
        }

        // All Games
        addGames('allGames', ["Teen Patti", "Super Ace", "Crash", "Aviator", "Andar Bahar", "Dragon Tiger", "Roulette", "Blackjack", "Fortune Gems", "Boxing King"]);

        // Slots
        addGames('slots', ["Super Ace", "Fortune Gems", "Boxing King", "Golden Empire", "Leprechaun", "Fruit Party", "Sweet Bonanza", "Gates of Olympus", "Starlight Princess", "Wild West"]);

        // Live Casino
        addGames('liveCasino', ["Blackjack Live", "Baccarat Live", "Roulette Live", "Dragon Tiger Live", "Sic Bo Live", "Crazy Time Live"]);

        // Table Games
        addGames('tableGames', ["Roulette", "Blackjack", "Poker", "Sic Bo", "Baccarat", "Teen Patti Pro"]);
    </script>

</body>
</html>

<!-- Recent Big Wins -->
<div class="recent-wins">
  <h3>Recent Big Wins</h3>
  <div class="wins-container" id="winsContainer">
    <!-- JS দিয়ে এখানে আইটেম যোগ হবে -->
  </div>
</div>
<script>
const wins = [
  { user: "******119", game: "Super Ace II", amount: "৳ 11,892,652" },
  { user: "******642", game: "Mega Fishing", amount: "৳ 10,663,489" },
  { user: "******458", game: "Fortune King", amount: "৳ 10,592,349" },
  { user: "******622", game: "Bombing Fishing", amount: "৳ 9,739,137" },
  { user: "******778", game: "Boxing King", amount: "৳ 11,258,690" }
];
let winsIndex = 0;
const winsContainerEl = document.getElementById('winsContainer');
function addWin() {
  const w = wins[winsIndex];
  const item = document.createElement('div');
  item.className = 'win-item';
  item.innerHTML = `
    <div>
      <span>${w.user}</span><br>
      <span class="game-name">${w.game}</span>
    </div>
    <div class="win-amount">${w.amount}</div>
  `;
  winsContainerEl.appendChild(item);
  if (winsContainerEl.children.length > 5) {
    winsContainerEl.removeChild(winsContainerEl.children[0]);
  }
  winsIndex = (winsIndex + 1) % wins.length;
}
// প্রথমে ৪টা আইটেম যোগ করি
for (let i = 0; i < 4; i++) addWin();
// প্রতি ২.৫ সেকেন্ডে নতুন আইটেম যোগ হবে
setInterval(addWin, 2500);
</script>


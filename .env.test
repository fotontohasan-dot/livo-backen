# .env.test
# ---------------------------------------------------------------------------
# শুধু Automated Test চালানোর জন্য — এখানে কোনো আসল/গোপন মান নেই, তাই এই
# ফাইল কমিট করা নিরাপদ। CI (GitHub Actions)-এ এই মানগুলো workflow-এর env
# ব্লক দিয়ে override হয় (সেখানে নিজস্ব ephemeral Postgres service থাকে)।
#
# লোকালি চালানোর জন্য আগে টেস্ট ডাটাবেজ চালু করুন:
#   docker compose -f docker-compose.test.yml up -d
# ---------------------------------------------------------------------------

NODE_ENV=test
PORT=0
DATABASE_URL=postgresql://livo_test:livo_test@127.0.0.1:5433/livo_test
DB_SSL=false
SESSION_SECRET=test-session-secret-do-not-use-in-production
REDIS_ENABLED=false
SSLCZ_IS_LIVE=false
SSLCZ_STORE_ID=test-store
SSLCZ_STORE_PASSWD=test-pass

<%- include('partials/admin-layout', { title: 'Deposits Management', currentPage: 'deposits', body: `
<div class="max-w-7xl mx-auto">
    <h2 class="section-header mb-6">Deposits Management</h2>
    
    <div class="bg-white rounded-3xl p-6 border mb-6">
        <h4 class="font-semibold mb-4">Pending Deposits (42)</h4>
        <div class="space-y-3">
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl">
                <div>
                    <span class="font-semibold">Rahim Khan</span> <span class="text-xs text-slate-500">#28491</span><br>
                    <span class="text-emerald-600 font-bold">৳25,000</span> via bKash • 12 min ago
                </div>
                <div class="flex gap-x-2">
                    <button onclick="approveDeposit(this)" class="px-5 py-2 bg-emerald-600 text-white text-sm rounded-2xl">Approve</button>
                    <button onclick="rejectDeposit(this)" class="px-5 py-2 bg-red-100 text-red-600 text-sm rounded-2xl">Reject</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center text-sm text-slate-400">History available in full version. All actions logged.</div>
</div>

<script>
function approveDeposit(el) { el.closest('.flex').innerHTML = '<span class="text-emerald-600 font-bold">✓ Approved</span>'; }
function rejectDeposit(el) { el.closest('.flex').innerHTML = '<span class="text-red-600">✗ Rejected</span>'; }
</script>
` }) %>
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: 'Arial', sans-serif; background-color: #0b0b0c; color: #fff; margin: 0; padding-bottom: 70px; }
        .header { background: #16171a; padding: 15px; text-align: center; font-size: 20px; font-weight: bold; color: #ff4d6d; position: fixed; top: 0; width: 100%; z-index: 100; }
        .container { padding: 75px 12px 20px 12px; max-width: 450px; margin: 0 auto; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .card { background: #16171a; border-radius: 15px; padding: 15px; margin-bottom: 15px; border: 1px solid #292a2d; }
        .title { font-size: 16px; font-weight: bold; color: #ff4d6d; margin-bottom: 8px; }
        .btn { background: #ff4d6d; color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 8px; }
        .game-btn { background: #28a745; color: white; padding: 10px; border-radius: 8px; border: none; margin: 5px 0; width: 100%; font-size: 15px; }
        .stream-box { background: #000; height: 320px; border-radius: 12px; position: relative; overflow: hidden; border: 1px solid #333; }
        .stream-overlay { position: absolute; top: 10px; right: 10px; background: red; padding: 4px 10px; border-radius: 5px; font-size: 12px; font-weight: bold; }
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 10px; }
        .stat-card { background: #22242a; border: 1px solid #292a2d; padding: 12px; border-radius: 8px; text-align: center; }
        .stat-card h3 { margin: 0; font-size: 12px; color: #aaa; }
        .stat-card p { margin: 5px 0 0 0; font-size: 18px; font-weight: bold; color: #ffc107; }
        .section-title { font-size: 14px; color: #ff4d6d; margin: 10px 0 5px 0; font-weight: bold; border-bottom: 1px solid #292a2d; padding-bottom: 3px; }
        .nav-bar { background: #16171a; position: fixed; bottom: 0; width: 100%; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #292a2d; }
        .nav-item { color: #888; text-align: center; background: none; border: none; font-size: 11px; }
        .nav-item.active { color: #ff4d6d; font-weight: bold; }
        .nav-icon { font-size: 22px; display: block; margin-bottom: 3px; }
    </style>
</head>
<body>

    <div class="header" id="pageHeader">🏅 স্পোর্টস লাইভ</div>

    <div class="container">
        <div id="sports" class="tab-content active">
            <div class="card">
                <div class="title">⚽ রিয়াল মাদ্রিদ vs বার্সেলোনা</div>
                <button class="game-btn">মাদ্রিদ জিতবে (1.65)</button>
                <button class="game-btn">বার্সেলোনা জিতবে (2.80)</button>
            </div>
        </div>

        <div id="casino" class="tab-content">
            <div class="card">
                <div class="title">🎰 Teen Patti</div>
                <button class="btn" onclick="playGame('teenpatti')">খেলুন</button>
            </div>
            <div class="card">
                <div class="title">🃏 Andar Bahar</div>
                <button class="btn" onclick="playGame('andarbahar')">খেলুন</button>
            </div>
            <div class="card">
                <div class="title">🐉 Dragon Tiger</div>
                <button class="btn" onclick="playGame('dragontiger')">খেলুন</button>
            </div>
            <div class="card">
                <div class="title">🎰 Lucky Spin</div>
                <button class="btn" onclick="playGame('luckyspin')">স্পিন করুন</button>
            </div>
            <div class="card">
                <div class="title">🔥 Crash Game</div>
                <button class="btn" onclick="playGame('crash')">Crash খেলুন</button>
            </div>
            <div class="card">
                <div class="title">🎲 Roulette</div>
                <button class="btn" onclick="playGame('roulette')">রুলেট খেলুন</button>
            </div>
        </div>

        <div id="livestream" class="tab-content">
            <div class="stream-box">
                <div class="stream-overlay">LIVE</div>
                <div style="padding:20px; text-align:center;">
                    <h3>🔥 Neha_Live</h3>
                    <p>এখন লাইভ আছেন</p>
                </div>
            </div>
        </div>

        <div id="foryou" class="tab-content">
            <div class="card">
                <h4 style="text-align:center; margin: 0 0 10px 0;">📊 প্ল্যাটফর্ম লাইভ স্ট্যাটাস</h4>
                
                <div class="section-title">🎰 ক্যাসিনো ও বেटिंग</div>
                <div class="stats-grid">
                    <div class="stat-card"><h3>মোট ইউজার</h3><p><%= user_count %></p></div>
                    <div class="stat-card"><h3>চলমান লাইভ</h3><p><%= live_stream_count %></p></div>
                    <div class="stat-card"><h3>পেন্ডিং বেট</h3><p><%= pending_bet_count %></p></div>
                    <div class="stat-card"><h3>মোট গেম</h3><p><%= game_count %></p></div>
                </div>

                <div class="section-title">📚 লাইব্রেরি বুক তথ্য</div>
                <div class="stats-grid">
                    <div class="stat-card"><h3>মোট বই</h3><p><%= book_count %></p></div>
                    <div class="stat-card"><h3>সহজলভ্য বই</h3><p><%= book_instance_available_count %></p></div>
                </div>
            </div>
        </div>

        <div id="profile" class="tab-content">
            <div class="card" style="text-align:center;">
                <h2 id="userName">ইউজার</h2>
                <p>ব্যালেন্স: <span id="userBalance" style="color:#28a745; font-weight:bold;">12480</span> কয়েন</p>
                <button class="btn" onclick="window.location.href='https://wa.me/966535743416'">💵 রিচার্জ করুন</button>
            </div>
        </div>
    </div>

    <div class="nav-bar">
        <button class="nav-item active" onclick="switchTab('sports', '🏅 স্পোর্টস লাইভ', this)"><span class="nav-icon">⚽</span>স্পোর্টস</button>
        <button class="nav-item" onclick="switchTab('casino', '🎰 ক্যাসিনো', this)"><span class="nav-icon">🎰</span>ক্যাসিনো</button>
        <button class="nav-item" onclick="switchTab('livestream', '🔥 লাইভ স্ট্রিম', this)"><span class="nav-icon">🎥</span>লাইভ</button>
        <button class="nav-item" onclick="switchTab('foryou', '📊 ড্যাশবোর্ড', this)"><span class="nav-icon">📱</span>ফর ইউ</button>
        <button class="nav-item" onclick="switchTab('profile', '👤 প্রোফাইল', this)"><span class="nav-icon">👤</span>আমি</button>
    </div>

    <script>
        function switchTab(tabId, headerTitle, element) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            document.getElementById('pageHeader').innerText = headerTitle;
            element.classList.add('active');
        }
        function playGame(game) {
            alert(game.toUpperCase() + " গেম শুরু হচ্ছে...\n\n(এখনো ডেমো মোডে আছে)");
        }
    </script>
</body>
</html>

+    // টেকনিক্যাল টার্ম/কোড-জাতীয় ছোট মানই দুই ভাষায় এক থাকা স্বাভাবিক।
+    const identical = Object.keys(bn).filter((k) => bn[k] === en[k] && String(bn[k]).length > 24);
+    expect(identical).toEqual([]);

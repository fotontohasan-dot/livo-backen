+
+  test('en.json-এ বাংলা লিক করেনি (৳ বাদে)', () => {
+    const leaked = Object.keys(en).filter((k) => BENGALI.test(String(en[k]).replace(/৳/g, '')));
+    expect(leaked).toEqual([]);

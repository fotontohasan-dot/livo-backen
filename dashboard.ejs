<%- include('partials/admin-layout', { 
    title: 'Dashboard', 
    currentPage: 'dashboard',
    body: `
<div class="max-w-7xl mx-auto">
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600 rounded-3xl p-8 mb-8 text-white shadow-xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <h2 class="text-4xl font-bold tracking-tighter">Good evening, Admin 👋</h2>
                <p class="mt-2 text-blue-100 text-lg">Here's what's happening with Livo today.</p>
            </div>
            <div class="flex items-center gap-x-3">
                <button onclick="window.location.reload()" 
                        class="px-5 py-2.5 bg-white/20 hover:bg-white/30 transition-colors rounded-2xl text-sm font-semibold flex items-center gap-x-2 backdrop-blur-lg">
                    <i class="fa-solid fa-sync-alt"></i>
                    <span>Refresh Data</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
        <!-- Total Users -->
        <div class="stat-card bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Users</p>
                    <p class="text-4xl font-bold text-slate-900 mt-1 tracking-tighter">48,291</p>
                </div>
                <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-users text-emerald-600 text-2xl"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center text-emerald-600 text-sm font-semibold">
                <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                <span>+1,842 today</span>
            </div>
        </div>

        <!-- Total Deposits -->
        <div class="stat-card bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Deposits</p>
                    <p class="text-4xl font-bold text-slate-900 mt-1 tracking-tighter">৳ 124.8M</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-arrow-down text-blue-600 text-2xl"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center text-emerald-600 text-sm font-semibold">
                <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                <span>+৳ 4.2M today</span>
            </div>
        </div>

        <!-- Total Withdrawals -->
        <div class="stat-card bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Withdrawals</p>
                    <p class="text-4xl font-bold text-slate-900 mt-1 tracking-tighter">৳ 89.3M</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-arrow-up text-orange-600 text-2xl"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center text-emerald-600 text-sm font-semibold">
                <i class="fa-solid fa-arrow-trend-up mr-1.5"></i>
                <span>+৳ 2.1M today</span>
            </div>
        </div>

        <!-- GGR Today -->
        <div class="stat-card bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">GGR (Today)</p>
                    <p class="text-4xl font-bold text-emerald-600 mt-1 tracking-tighter">৳ 312k</p>
                </div>
                <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-chart-line text-emerald-600 text-2xl"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center text-emerald-600 text-sm font-semibold">
                <span class="text-emerald-500">+18% from yesterday</span>
            </div>
        </div>

        <!-- Pending Actions -->
        <div class="stat-card bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-sm font-medium text-slate-500">Pending Actions</p>
                    <p class="text-4xl font-bold text-amber-600 mt-1 tracking-tighter">184</p>
                </div>
                <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-clock text-amber-600 text-2xl"></i>
                </div>
            </div>
            <div class="mt-4">
                <div class="flex items-center gap-x-2 text-sm">
                    <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-bold">42 Deposits</span>
                    <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold">19 Withdrawals</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions + Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Quick Actions -->
        <div class="lg:col-span-1 bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-x-2">
                <i class="fa-solid fa-bolt text-blue-600"></i> 
                <span>Quick Actions</span>
            </h3>
            
            <div class="space-y-3">
                <button onclick="showCoinAdjustModal()" 
                        class="w-full flex items-center justify-between px-4 py-3.5 bg-slate-50 hover:bg-blue-50 rounded-2xl text-left transition-all group">
                    <div class="flex items-center gap-x-3">
                        <i class="fa-solid fa-coins text-blue-600 group-hover:scale-110 transition-transform"></i>
                        <span class="font-medium">Adjust User Coins</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-400"></i>
                </button>
                
                <button onclick="window.location.href='/admin/deposits'" 
                        class="w-full flex items-center justify-between px-4 py-3.5 bg-slate-50 hover:bg-emerald-50 rounded-2xl text-left transition-all group">
                    <div class="flex items-center gap-x-3">
                        <i class="fa-solid fa-check-double text-emerald-600"></i>
                        <span class="font-medium">Approve Pending Deposits</span>
                    </div>
                    <span class="text-xs bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full font-bold">42</span>
                </button>
                
                <button onclick="window.location.href='/admin/support'" 
                        class="w-full flex items-center justify-between px-4 py-3.5 bg-slate-50 hover:bg-violet-50 rounded-2xl text-left transition-all group">
                    <div class="flex items-center gap-x-3">
                        <i class="fa-solid fa-headset text-violet-600"></i>
                        <span class="font-medium">Reply to Tickets</span>
                    </div>
                    <span class="text-xs bg-violet-100 text-violet-700 px-2.5 py-1 rounded-full font-bold">31</span>
                </button>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-lg">Recent Activity</h3>
                <a href="/admin/transactions" class="text-sm text-blue-600 hover:underline font-medium">View all →</a>
            </div>
            
            <div class="space-y-1 text-sm">
                <div class="flex items-center justify-between py-3 px-4 hover:bg-slate-50 rounded-2xl">
                    <div class="flex items-center gap-x-3">
                        <div class="w-8 h-8 bg-emerald-100 rounded-xl flex items-center justify-center"><i class="fa-solid fa-arrow-down text-emerald-600 text-xs"></i></div>
                        <div>
                            <span class="font-medium">Rahim Khan</span> deposited <span class="font-semibold text-emerald-600">৳25,000</span>
                        </div>
                    </div>
                    <span class="text-xs text-slate-500">2 min ago</span>
                </div>
                
                <div class="flex items-center justify-between py-3 px-4 hover:bg-slate-50 rounded-2xl">
                    <div class="flex items-center gap-x-3">
                        <div class="w-8 h-8 bg-red-100 rounded-xl flex items-center justify-center"><i class="fa-solid fa-arrow-up text-red-600 text-xs"></i></div>
                        <div>
                            <span class="font-medium">Sadia Islam</span> withdrew <span class="font-semibold text-red-600">৳40,000</span>
                        </div>
                    </div>
                    <span class="text-xs text-slate-500">14 min ago</span>
                </div>
                
                <div class="flex items-center justify-between py-3 px-4 hover:bg-slate-50 rounded-2xl">
                    <div class="flex items-center gap-x-3">
                        <div class="w-8 h-8 bg-amber-100 rounded-xl flex items-center justify-center"><i class="fa-solid fa-ticket text-amber-600 text-xs"></i></div>
                        <div>
                            <span class="font-medium">#B-28491</span> settled as <span class="font-semibold text-emerald-600">WIN</span>
                        </div>
                    </div>
                    <span class="text-xs text-slate-500">37 min ago</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <h3 class="font-semibold mb-4">Daily GGR (Last 7 Days)</h3>
            <canvas id="ggrChart" height="120"></canvas>
        </div>
        
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <h3 class="font-semibold mb-4">User Registrations</h3>
            <canvas id="usersChart" height="120"></canvas>
        </div>
    </div>
</div>

<script>
// GGR Chart
const ggrCtx = document.getElementById('ggrChart');
new Chart(ggrCtx, {
    type: 'line',
    data: {
        labels: ['Jan 31', 'Feb 1', 'Feb 2', 'Feb 3', 'Feb 4', 'Feb 5', 'Feb 6'],
        datasets: [{
            label: 'GGR (৳)',
            data: [245000, 312000, 289000, 378000, 412000, 356000, 398000],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, grid: { color: '#f1e7ff' } } }
    }
});

// Users Chart
const usersCtx = document.getElementById('usersChart');
new Chart(usersCtx, {
    type: 'bar',
    data: {
        labels: ['Jan 31', 'Feb 1', 'Feb 2', 'Feb 3', 'Feb 4', 'Feb 5', 'Feb 6'],
        datasets: [{
            label: 'New Users',
            data: [1240, 980, 1450, 1320, 1680, 1120, 1890],
            backgroundColor: '#6366f1',
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, grid: { color: '#f1e7ff' } } }
    }
});

function showCoinAdjustModal() {
    alert('Coin Adjust Modal would open here (connect to your backend route)');
}
</script>
` 
}) %>
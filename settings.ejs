<%- include('partials/admin-layout', { title: 'Settings', currentPage: 'settings', body: `
<div class="max-w-3xl mx-auto">
    <h2 class="section-header mb-6">Admin Settings</h2>
    
    <div class="bg-white rounded-3xl p-8 border space-y-8">
        <div>
            <label class="font-medium text-sm">Platform Name</label>
            <input value="Livo" class="w-full mt-1 px-4 py-3 border rounded-2xl">
        </div>
        
        <div>
            <label class="font-medium text-sm">Minimum Withdrawal</label>
            <input type="number" value="500" class="w-full mt-1 px-4 py-3 border rounded-2xl">
        </div>
        
        <div class="pt-4 border-t">

# সব আসল মান .env ফাইলে দাও (.gitignore-এ আছে, কখনো কমিট কোরো না)।
# বিস্তারিত ব্যাখ্যা README.md-এর "Environment Variables" সেকশনে।

# ---- আবশ্যক ----
DATABASE_URL=
SESSION_SECRET=
PORT=3000
NODE_ENV=production

# ---- Payment (SSLCommerz) ----
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_IS_LIVE=false

# ---- ইমেইল ----
EMAIL_USER=
EMAIL_PASS=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Web Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Sports Data API ----
API_FOOTBALL_KEY=
FOOTBALL_API_KEY=
CRICKET_API_KEY=
RAPIDAPI_KEY=
POLL_INTERVAL_FOOTBALL=60000
POLL_INTERVAL_CRICKET=60000

# ---- Telegram Bot (AI assistant, GitHub write access সহ) ----
# নিচের তিনটা ছাড়া বট ইচ্ছাকৃতভাবে fail-closed থাকে (চালু হয় না)।
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# উপরের TELEGRAM_ADMIN_CHAT_ID না থাকলে এটা ফলব্যাক (ডিপোজিট/উইথড্র/সাপোর্ট নোটিফিকেশনের জন্য)
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
RENDER_EXTERNAL_URL=

# ---- Backup & Restore System ----
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULE_HOURS=24
BACKUP_DIR=

# ---- অন্যান্য ----
FRONTEND_URL=
SAMBANOVA_API_KEY=
VERIFICATION_DIR=

# ---- Redis Cache (ঐচ্ছিক — কনফিগার না করলে বা Redis ডাউন থাকলেও সিস্টেম সরাসরি DB দিয়ে চলবে, কোনো এরর হবে না) ----
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=livo:
REDIS_CONNECT_TIMEOUT_MS=3000

# ---- Prometheus Metrics (/metrics) — শুধু Admin/Internal অ্যাক্সেস ----
# Docker/internal network থেকে scrape করতে টোকেন সেট করুন (খালি রাখলে শুধু লগইন-করা অ্যাডমিন সেশন দিয়ে অ্যাক্সেস করা যাবে)
METRICS_TOKEN=

# ---- Grafana + Prometheus (Docker Compose monitoring stack, ঐচ্ছিক) ----
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

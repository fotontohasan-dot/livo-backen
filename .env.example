# সব আসল মান .env ফাইলে দাও (.gitignore-এ আছে, কখনো কমিট কোরো না)।
# বিস্তারিত ব্যাখ্যা README.md-এর "Environment Variables" সেকশনে।

# ---- আবশ্যক ----
DATABASE_URL=
SESSION_SECRET=
PORT=3000
NODE_ENV=production

# ---- Payment (SSLCommerz) ----
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_IS_LIVE=false

# ---- ইমেইল ----
EMAIL_USER=
EMAIL_PASS=

# ---- Google Sign-In (OAuth 2.0 / OpenID Connect) ----
# খালি রাখলে "Continue with Google" বাটন/রুট নিষ্ক্রিয় থাকে (isConfigured() false দেয়),
# বাকি ইমেইল/ফোন+পাসওয়ার্ড লগইন-রেজিস্ট্রেশন স্বাভাবিকভাবে চলবে।
# Google Cloud Console-এ OAuth Client তৈরি করে এই দুটো বসাও — Authorized redirect URI
# হতে হবে: <তোমার ডোমেইন>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Web Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Sports Data API ----
API_FOOTBALL_KEY=
FOOTBALL_API_KEY=
CRICKET_API_KEY=
RAPIDAPI_KEY=
POLL_INTERVAL_FOOTBALL=60000
POLL_INTERVAL_CRICKET=60000

# ---- Telegram Bot (AI assistant, GitHub write access সহ) ----
# নিচের তিনটা ছাড়া বট ইচ্ছাকৃতভাবে fail-closed থাকে (চালু হয় না)।
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# উপরের TELEGRAM_ADMIN_CHAT_ID না থাকলে এটা ফলব্যাক (ডিপোজিট/উইথড্র/সাপোর্ট নোটিফিকেশনের জন্য)
TELEGRAM_CHAT_ID=
# Admin প্যানেল (/admin/telegram) থেকে সেভ করা bot token এই কী দিয়ে AES-256-GCM
# এনক্রিপ্ট করে DB-তে রাখা হয়। সেট না থাকলে ধাপে ধাপে SETTINGS_ENCRYPTION_KEY →
# BACKUP_ENCRYPTION_KEY → SESSION_SECRET ফলব্যাক হয়। কী বদলালে সেভ করা টোকেন আর
# ডিক্রিপ্ট হবে না — তখন প্যানেল থেকে আবার টোকেন বসাতে হবে (openssl rand -hex 32)।
TELEGRAM_SETTINGS_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
RENDER_EXTERNAL_URL=

# ---- অন্যান্য ----
FRONTEND_URL=
SAMBANOVA_API_KEY=
VERIFICATION_DIR=

# ---- Redis Cache (ঐচ্ছিক — কনফিগার না করলে বা Redis ডাউন থাকলেও সিস্টেম সরাসরি DB দিয়ে চলবে, কোনো এরর হবে না) ----
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=livo:
REDIS_CONNECT_TIMEOUT_MS=3000

# ---------------- ব্যাকগ্রাউন্ড জব কিউ (services/queue.js — Postgres job_queue টেবিল) ----------------
# ওয়ার্কার app.js-এর ভেতরেই চলে (আলাদা কন্টেইনার লাগে না)। false দিলে জব শুধু জমা হবে, প্রসেস হবে না।
QUEUE_ENABLED=true
# কত মিলিসেকেন্ড পরপর নতুন জব খোঁজা হবে
QUEUE_POLL_INTERVAL_MS=2000
# এক টিকে সর্বোচ্চ কতগুলো জব নেওয়া হবে
QUEUE_BATCH_SIZE=5
# একটা জব সর্বোচ্চ কতবার চেষ্টা করা হবে
QUEUE_MAX_ATTEMPTS=3
# 'processing'-এ এর চেয়ে বেশি সময় আটকে থাকলে জব stalled ধরে আবার pending করা হয়
# (কন্টেইনার রিস্টার্ট/ক্র্যাশ রিকভারি)। জবের সর্বোচ্চ রান-টাইমের চেয়ে বেশি রাখুন।
QUEUE_STALLED_THRESHOLD_MS=300000

# ---------------- Monitoring — Prometheus + Grafana (docker-compose.yml) ----------------
# /metrics এন্ডপয়েন্ট অ্যাডমিন-সুরক্ষিত। Prometheus স্ক্র্যাপার কুকি/সেশন পাঠাতে পারে না, তাই
# এই টোকেন দিয়েই সে স্ক্র্যাপ করে (docker/prometheus/prometheus.yml.template-এ বসে যায়)।
# ⚠️ খালি রাখলে Prometheus /metrics থেকে 401 পাবে এবং livo-app টার্গেট স্থায়ীভাবে DOWN দেখাবে।
# একটা লম্বা র‍্যান্ডম স্ট্রিং দিন, যেমন: openssl rand -hex 32
METRICS_TOKEN=

# Grafana অ্যাডমিন লগইন ও পোর্ট (http://localhost:${GRAFANA_PORT})
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------- docker-compose.yml-এর Postgres কন্টেইনার পাসওয়ার্ড ----------------
# compose-এ DATABASE_URL এই পাসওয়ার্ড দিয়েই তৈরি হয়, তাই db ও app-এ একই মান ব্যবহৃত হয়।
DB_PASSWORD=

# ---------------- Sentry — Error + Performance Monitoring (সম্পূর্ণ ঐচ্ছিক) ----------------
# SENTRY_DSN খালি রাখলে (বা SENTRY_ENABLED=false দিলে) পুরো মডিউল no-op হয়ে যায়,
# অ্যাপ স্বাভাবিকভাবেই চলে — কোনো এরর হয় না।
SENTRY_DSN=
# স্পষ্টভাবে বন্ধ করতে false দিন (DSN সেট থাকলেও)
SENTRY_ENABLED=true
# না দিলে NODE_ENV ব্যবহৃত হয়
SENTRY_ENVIRONMENT=
# না দিলে RENDER_GIT_COMMIT, তাও না থাকলে package.json-এর version
SENTRY_RELEASE=
# ট্রেস স্যাম্পলিং হার (0–1)। ডিফল্ট 0.1 = ১০% রিকোয়েস্ট
SENTRY_TRACES_SAMPLE_RATE=0.1
# প্রোফাইলিং স্যাম্পলিং হার (0–1)। ডিফল্ট 0 = বন্ধ
SENTRY_PROFILES_SAMPLE_RATE=0
# Render প্রতিটা ডিপ্লয়ে নিজেই সেট করে দেয় — সাধারণত ম্যানুয়ালি দেওয়ার দরকার নেই
RENDER_GIT_COMMIT=

# ---------------- ব্যাকআপ (services/backupManager.js) ----------------
# ব্যাকআপ ফাইল কোথায় রাখা হবে। না দিলে প্রজেক্টের ./backups ফোল্ডার।
BACKUP_DIR=
# ⚠️ দিলে ব্যাকআপ ফাইল AES-256 দিয়ে এনক্রিপ্ট হয় (যেকোনো length-এর পাসফ্রেজ চলবে)।
# এই কী হারালে পুরোনো এনক্রিপ্টেড ব্যাকআপ আর কখনো restore করা যাবে না — নিরাপদে সংরক্ষণ করুন।
# খালি রাখলে ব্যাকআপ প্লেইন থাকে (এনক্রিপশন বন্ধ)।
BACKUP_ENCRYPTION_KEY=
# কত ঘণ্টা পরপর অটো-ব্যাকআপ চলবে। ডিফল্ট 24। 0 বা negative দিলে অটো-ব্যাকআপ বন্ধ।
BACKUP_SCHEDULE_HOURS=24

# ---------------- SMS গেটওয়ে (ঐচ্ছিক, জেনেরিক HTTP গেটওয়ে) ----------------
# দুইটাই সেট না করলে SMS আসলে পাঠানো হয় না — স্পষ্টভাবে "সিমুলেটেড" ফলাফল রিটার্ন করে।
SMS_API_URL=
SMS_API_KEY=

# ---------------- অন্যান্য টিউনিং (সবগুলোর নিরাপদ ডিফল্ট আছে) ----------------
# Swagger API ডকুমেন্টেশনে দেখানো বেস URL। না দিলে প্রোডাকশন URL ব্যবহৃত হয়।
BASE_URL=
# নতুন ডিভাইস থেকে এর চেয়ে বেশি টাকা উইথড্র হলে fraud হিসেবে ফ্ল্যাগ হয়। ডিফল্ট 10000।
FRAUD_LARGE_WITHDRAW_THRESHOLD=10000
# Redis-এ কতবার রিকানেক্ট চেষ্টা করার পর থামবে (লগ স্প্যাম আটকাতে)। ডিফল্ট 5।
REDIS_MAX_RETRIES=5

# ---------------- পাবলিক URL (বাধ্যতামূলক, প্রোডাকশন) ----------------
# ইমেইলের রিসেট/ভেরিফিকেশন লিংক এই ঠিকানা থেকে বানানো হয়।
# আগে ক্লায়েন্টের পাঠানো Host হেডার ব্যবহার হতো — অ্যাটাকার Host বদলে দিয়ে
# ভিক্টিমের ইমেইলে নিজের ডোমেইনের রিসেট লিংক পাঠাতে পারত (টোকেন চুরি)।
# প্রোডাকশনে না দিলে অ্যাপ বুট হওয়ার সময়ই থেমে যাবে। https বাধ্যতামূলক।
PUBLIC_APP_URL=

# ---------------- ব্যাকআপ এনক্রিপশন (বাধ্যতামূলক, প্রোডাকশন) ----------------
# ব্যাকআপে users, payment_requests, kyc_requests, coin_transactions থাকে।
# কী না দিলে প্রোডাকশনে ব্যাকআপ নেওয়াই হবে না — প্লেইনটেক্সট ডাম্প ডিস্কে
# পড়ে থাকার চেয়ে ব্যাকআপ ব্যর্থ হওয়া নিরাপদ। অন্তত ১৬ অক্ষর।
# কী বদলালে পুরনো ব্যাকআপ আর খোলা যাবে না — বদলানোর আগে রিস্টোর করে নিন।
BACKUP_ENCRYPTION_KEY=

# ---------------- ডাটাবেস TLS ----------------
# প্রোডাকশনে সার্টিফিকেট যাচাই ডিফল্টে চালু। ম্যানেজড হোস্ট self-signed
# সার্টিফিকেট দিলে এখানে CA সার্টিফিকেট (PEM) দিন।
DATABASE_CA_CERT=
# একান্ত প্রয়োজনে যাচাই বন্ধ করা যায়, কিন্তু তখন MITM ঝুঁকি থাকে এবং
# স্টার্টআপে সতর্কবার্তা লগ হয়। ডিফল্ট false।
DATABASE_SSL_INSECURE=
